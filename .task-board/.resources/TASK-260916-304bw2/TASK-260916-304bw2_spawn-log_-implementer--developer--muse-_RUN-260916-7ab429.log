{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7a9","stream":{"kind":"session","id":"01a0a986-16d4-7923-b79d-f784beb66015"},"sequence":559,"recorded_at":1780531400001113,"record_type":"event","durability":"durable","causation_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","run_stream":{"kind":"run","id":"f870b610-f41f-4227-a805-61cb8ebcb67d"},"call_id":"call_01a0a987537a776d8f0a960b98d42416","text":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n1|import Foundation\n2|import Relux\n3|extension Runners {\n4|    public protocol IFlow: Relux.Flow {}\n5|    public actor Flow {\n6|        public let dispatcher: Relux.Dispatcher\n7|        private let service: any RunnerServicing\n8|        private let catalog: RunnerCatalogStore\n9|        private let installer: RunnerInstallerService\n10|        private let api: GitHubRunnerAPIClient\n11|        private let userStore: any GitHubCredentialStoring\n12|        private let identities: any GitHubSessionIdentityStoring\n13|        private let refresher: GitHubTokenRefresh\n14|        private let configProvider: @Sendable (String?) throws -> GitHubAuth.AppConfig\n15|        private let now: @Sendable () -> Date\n16|        private let home: URL\n17|        private var working: Set<String> = []\n18|        private var refreshing = false\n19|        private var revision = 0\n20|        private var pendingOp: [String: OperationPhase] = [:]\n21|        private var unregisterWorking: Set<String> = []\n22|        private var catalogGeneration = 0\n23|        public init(service: any RunnerServicing, dispatcher: Relux.Dispatcher? = nil) async {\n24|            self.service = service\n25|            self.catalog = RunnerCatalogStore()\n26|            self.installer = RunnerInstallerService()\n27|            let transport = URLSessionGitHubTransport()\n28|            let store: any GitHubCredentialStoring = GitHubKeychainStore()\n29|            self.api = GitHubRunnerAPIClient(transport: transport)\n30|            self.userStore = store\n31|            self.identities = UserDefaultsGitHubSessionIdentityStore()\n32|            self.refresher = GitHubTokenRefresh(transport: transport, store: store)\n33|            self.configProvider = { host in try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\") }\n34|            self.now = Date.init\n35|            self.home = FileManager.default.homeDirectoryForCurrentUser\n36|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n37|        }\n38|        /// Testable init with explicit catalog, installer and auth dependencies.\n39|        /// Production passes the shared installer so unregister/recovery and\n40|        /// registration cannot overlap.\n41|        public init(\n42|            service: any RunnerServicing,\n43|            catalog: RunnerCatalogStore,\n44|            installer: RunnerInstallerService,\n45|            api: GitHubRunnerAPIClient,\n46|            userStore: any GitHubCredentialStoring,\n47|            identities: any GitHubSessionIdentityStoring,\n48|            refresher: GitHubTokenRefresh,\n49|            configProvider: (@Sendable (String?) throws -> GitHubAuth.AppConfig)? = nil,\n50|            now: (@Sendable () -> Date)? = nil,\n51|            home: URL? = nil,\n52|            dispatcher: Relux.Dispatcher? = nil\n53|        ) async {\n54|            self.service = service\n55|            self.catalog = catalog\n56|            self.installer = installer\n57|            self.api = api\n58|            self.userStore = userStore\n59|            self.identities = identities\n60|            self.refresher = refresher\n61|            self.configProvider = configProvider ?? { host in try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\") }\n62|            self.now = now ?? Date.init\n63|            self.home = home ?? FileManager.default.homeDirectoryForCurrentUser\n64|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n65|        }\n66|    }\n67|}\n68|extension Runners.Flow: Runners.IFlow {\n69|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n70|        guard let effect = effect as? Runners.Effect else { return .success }\n71|        switch effect {\n72|        case .refresh: await refresh()\n73|        case .setEnabled(let id, let enabled): await setEnabled(id: id, enabled: enabled)\n74|        case .setEnabledMany(let ids, let enabled): await setEnabledMany(ids: ids, enabled: enabled)\n75|        case .loadCatalog: await loadCatalog()\n76|        case .discover: await discover()\n77|        case .importCandidate(let candidate): await importCandidate(candidate)\n78|        case .importFolder(let url): await importFolder(url)\n79|        case .removeFromApp(let id): await removeFromApp(id: id)\n80|        case .unregister(let id, let confirmation): await unregister(id: id, confirmation: confirmation)\n81|        case .refreshRemote: await refreshRemote()\n82|        case .setRunAtLoad(let id, let value): await setRunAtLoad(id: id, value: value)\n83|        case .setAlias(let id, let alias): await setAlias(id: id, alias: alias)\n84|        case .relinkDirectory(let id, let url): await relink(id: id, url: url)\n85|        case .selectRunner(let id): await action { Runners.Action.selected(id) }\n86|        case .loadLog(let id): await loadLog(id: id)\n87|        case .clearLog: await action { Runners.Action.logCleared }\n88|        case .loadGroupAccess(let id): await loadGroupAccess(id: id)\n89|        case .applyGroupAccess(let id, let groupID, let repos, let allowTakeover):\n90|            await applyGroupAccess(id: id, groupID: groupID, repos: repos, allowTakeover: allowTakeover)\n91|        }\n92|        return .success\n93|    }\n94|\n95|    private func isCatalogStale(_ gen: Int) -> Bool { catalogGeneration != gen }\n96|\n97|    // MARK: - Local refresh and power\n98|\n99|    private func refresh() async {\n100|        guard !refreshing, working.isEmpty else { return }\n101|        refreshing = true\n102|        let startedAt = revision\n103|        let snapshots = await service.snapshots()\n104|        // Do not publish a stale read if a command started during this await.\n105|        if working.isEmpty && revision == startedAt {\n106|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n107|            await action { Runners.Action.refreshed(mapped_snapshots) }\n108|        }\n109|        refreshing = false\n110|    }\n111|\n112|    private func withPendingOp(_ snapshots: [Runners.Snapshot]) -> [Runners.Snapshot] {\n113|        Self.applyPending(snapshots, pending: pendingOp)\n114|    }\n115|\n116|    private nonisolated static func applyPending(_ snapshots: [Runners.Snapshot], pending: [String: Runners.OperationPhase]) -> [Runners.Snapshot] {\n117|        snapshots.map { snapshot in\n118|            var next = snapshot\n119|            next.operation = pending[snapshot.id] ?? .idle\n120|            // Reflect the operation in the local status so the row shows\n121|            // starting/stopping instead of jumping ahead to running/stopped.\n122|            if next.operation == .starting, next.status == .stopped || next.status == .failed {\n123|                next.status = .starting\n124|            } else if next.operation == .stopping, next.status == .running {\n125|                next.status = .stopping\n126|            }\n127|            return next\n128|        }\n129|    }\n130|\n131|    private func setEnabled(id: String, enabled: Bool) async {\n132|        guard !working.contains(id), !unregisterWorking.contains(id) else { return }\n133|        working.insert(id)\n134|        revision += 1\n135|        pendingOp[id] = enabled ? .starting : .stopping\n136|        await action { Runners.Action.changing(id, true) }\n137|        do { try await service.setEnabled(enabled, id: id) }\n138|        catch { await action { Runners.Action.failed(error.localizedDescription) } }\n139|        pendingOp.removeValue(forKey: id)\n140|        let snapshots = await service.snapshots()\n141|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n142|        await action { Runners.Action.refreshed(mapped_snapshots) }\n143|        working.remove(id)\n144|        await action { Runners.Action.changing(id, false) }\n145|    }\n146|\n147|    /// Bulk power with per-row errors. Every row is attempted; failures are\n148|    /// reported per row in the refreshed snapshots plus one summary failure.\n149|    /// A single-row error never blocks the rest of the list.\n150|    private func setEnabledMany(ids: [String], enabled: Bool) async {\n151|        let targets = ids.filter { !working.contains($0) && !unregisterWorking.contains($0) }\n152|        guard !targets.isEmpty else { return }\n153|        for id in targets {\n154|            working.insert(id)\n155|            pendingOp[id] = enabled ? .starting : .stopping\n156|            await action { Runners.Action.changing(id, true) }\n157|        }\n158|        revision += 1\n159|        var failures: [(String, String)] = []\n160|        for id in targets {\n161|            do { try await service.setEnabled(enabled, id: id) }\n162|            catch { failures.append((id, error.localizedDescription)) }\n163|        }\n164|        for id in targets { pendingOp.removeValue(forKey: id) }\n165|        var snapshots = await service.snapshots()\n166|        if !failures.isEmpty {\n167|            let table = Dictionary(uniqueKeysWithValues: failures)\n168|            snapshots = snapshots.map { snapshot in\n169|                var next = snapshot\n170|                if let message = table[snapshot.id] {\n171|                    next.message = message\n172|                }\n173|                return next\n174|            }\n175|            let summary = failures.map { id, message in \"\\(id): \\(message)\" }.joined(separator: \"; \")\n176|            let failureCount = failures.count\n177|            let targetCount = targets.count\n178|            let bulkMessage = \"Partial failure (\\(failureCount) of \\(targetCount)): \\(summary)\"\n179|            await action { Runners.Action.failed(bulkMessage) }\n180|        }\n181|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n182|        await action { Runners.Action.refreshed(mapped_snapshots) }\n183|        for id in targets {\n184|            working.remove(id)\n185|            await action { Runners.Action.changing(id, false) }\n186|        }\n187|    }\n188|\n189|    // MARK: - Catalog\n190|\n191|    /// One-time migration plus refresh. Never starts or stops CI and never\n192|    /// modifies services; discovery only reads.\n193|    private func loadCatalog() async {\n194|        do {\n195|            _ = try await catalog.migrateIfNeeded()\n196|            await action { Runners.Action.catalogCleared }\n197|        } catch {\n198|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n199|        }\n200|        let snapshots = await service.snapshots()\n201|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n202|        await action { Runners.Action.refreshed(mapped_snapshots) }\n203|    }\n204|\n205|    private func discover() async {\n206|        let entries = await catalog.load()\n207|        let known = Set(entries.map(\\.canonicalPath))\n208|        let extra = entries.map { RunnerCatalogStore.resolve(entry: $0) }\n209|        let candidates = RunnerDiscovery.discoverCandidates(knownCanonicals: known, extraDirectories: extra)\n210|            .filter { candidate in\n211|                let canonical = RunnerCatalogStore.canonical(candidate.directory)\n212|                return !known.contains(canonical)\n213|            }\n214|        await action { Runners.Action.candidatesLoaded(candidates) }\n215|    }\n216|\n217|    private func importCandidate(_ candidate: RunnerDiscovery.Candidate) async {\n218|        let gen = catalogGeneration\n219|        // Refuse mutations for an entry already under unregister.\n220|        if let label = candidate.label, unregisterWorking.contains(label) {\n221|            await action { Runners.Action.catalogFailed(RunnerRegistration.RegistrationError.installerBusy(path: candidate.directory.path).localizedDescription) }\n222|            return\n223|        }\n224|        do {\n225|            try RunnersCatalogGates.validateImportable(candidate)\n226|            let canonical = RunnerCatalogStore.canonical(candidate.directory)\n227|            let entries = await catalog.load()\n228|            if entries.contains(where: { $0.canonicalPath == canonical }) {\n229|                throw RunnerCatalogStore.CatalogError.duplicateDirectory(path: candidate.directory.path)\n230|            }\n231|            guard !isCatalogStale(gen) else { return }\n232|            let label: String\n233|            let plist: URL\n234|            let kind = candidate.controllerKind\n235|            if let manifest = candidate.manifest, let existing = candidate.label {\n236|                // Import without changing the existing service: never\n237|                // re-registers and never flips the preserved RunAtLoad policy.\n238|                label = existing\n239|                plist = manifest\n240|            } else {\n241|                // No manifest: create a manual service (RunAtLoad off for new\n242|                // runners). Never bootstraps; enabling is a separate action.\n243|                let base = (candidate.agentName ?? candidate.directory.lastPathComponent)\n244|                    .lowercased().replacingOccurrences(of: \" \", with: \"-\")\n245|                label = \"actions.runner.imported.\\(base)\"\n246|                plist = try await installer.setupService(directory: candidate.directory, label: label)\n247|            }\n248|            guard !isCatalogStale(gen) else { return }\n249|            let info = RunnerRegistrationReader.read(directory: candidate.directory)\n250|            let entry = RunnerCatalogStore.Entry(\n251|                directoryPath: candidate.directory.path,\n252|                canonicalPath: canonical,\n253|                bookmarkBase64: RunnerCatalogStore.bookmark(for: candidate.directory),\n254|                serviceLabel: label,\n255|                servicePlistPath: plist.path,\n256|                controllerKind: kind,\n257|                runAtLoad: candidate.runAtLoad,\n258|                serverHost: info?.serverHost ?? candidate.serverHost,\n259|                scopeKind: info?.scopeKind,\n260|                scope: info?.scopeDetail ?? candidate.scope,\n261|                remoteAgentID: info?.agentID ?? candidate.agentID,\n262|                agentName: info?.agentName ?? candidate.agentName,\n263|                workFolder: info?.workFolder ?? candidate.workFolder\n264|            )\n265|            try await catalog.add(entry)\n266|            await action { Runners.Action.catalogCleared }\n267|            let snapshots = await service.snapshots()\n268|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n269|            await action { Runners.Action.refreshed(mapped_snapshots) }\n270|            await discover()\n271|        } catch {\n272|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n273|        }\n274|    }\n275|\n276|    private func importFolder(_ url: URL) async {\n277|        var isDir: ObjCBool = false\n278|        guard FileManager.default.fileExists(atPath: url.path, isDirectory: &isDir), isDir.boolValue else {\n279|            await action { Runners.Action.catalogFailed(\"Selected folder does not exist.\") }\n280|            return\n281|        }\n282|        let candidate = RunnerDiscovery.validateFolder(url)\n283|        if candidate.needsRelocation {\n284|            await action { Runners.Action.catalogFailed(\"Path contains a space; choose a location without spaces. Running runners are never moved automatically.\") }\n285|            return\n286|        }\n287|        await importCandidate(candidate)\n288|    }\n289|\n290|    /// Removes only the catalog record. Deletes no files, no GitHub\n291|    /// registration and no certificates, and never stops a running service.\n292|    /// Warns when the service keeps running.\n293|    private func removeFromApp(id: String) async {\n294|        if unregisterWorking.contains(id) {\n295|            await action { Runners.Action.catalogFailed(\"Runner is unregistering; retry after it settles.\") }\n296|            return\n297|        }\n298|        let entries = await catalog.load()\n299|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n300|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7ab","stream":{"kind":"session","id":"01a0a986-16d4-7923-b79d-f784beb66015"},"sequence":560,"recorded_at":1780531400001115,"record_type":"event","durability":"durable","causation_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","run_stream":{"kind":"run","id":"f870b610-f41f-4227-a805-61cb8ebcb67d"},"call_id":"call_01a0a98755e7722a8b38cec946451fce","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerCatalog.swift`.\n1|import Foundation\n2|\n3|extension Runners {\n4|    /// How a catalog entry is controlled. Managed kinds use launchctl;\n5|    /// unsupported entries are read-only (no fake toggle, no second process).\n6|    public enum ControllerKind: String, Sendable, Equatable, Codable {\n7|        case manualManaged\n8|        case standardLaunchAgent\n9|        case unsupported\n10|\n11|        public var title: String {\n12|            switch self {\n13|            case .manualManaged: \"Ручная служба\"\n14|            case .standardLaunchAgent: \"LaunchAgent\"\n15|            case .unsupported: \"Неподдерживаемое управление\"\n16|            }\n17|        }\n18|\n19|        public var canControl: Bool { self != .unsupported }\n20|    }\n21|}\n22|\n23|/// Versioned persistent catalog of user-managed runner installations.\n24|///\n25|/// Stored as JSON in Application Support/RunnerControl/catalog.json. Holds\n26|/// identity, paths, display overrides, controller kind and preferences.\n27|/// Never holds secrets, tokens, or credentials.\n28|public actor RunnerCatalogStore {\n29|    public static let currentVersion = 1\n30|    public static let fileName = \"catalog.json\"\n31|\n32|    public struct Entry: Sendable, Equatable, Codable, Identifiable {\n33|        public var localID: String\n34|        public var directoryPath: String\n35|        public var canonicalPath: String\n36|        public var bookmarkBase64: String?\n37|        public var displayName: String?\n38|        public var serviceLabel: String\n39|        public var servicePlistPath: String\n40|        public var controllerKind: Runners.ControllerKind\n41|        public var runAtLoad: Bool?\n42|        public var serverHost: String?\n43|        public var scopeKind: String?\n44|        public var scope: String?\n45|        public var remoteAgentID: Int64?\n46|        public var agentName: String?\n47|        public var workFolder: String?\n48|        public var addedAt: Date\n49|        public var lastSeenAt: Date?\n50|\n51|        public var id: String { localID }\n52|\n53|        public init(\n54|            localID: String = UUID().uuidString,\n55|            directoryPath: String,\n56|            canonicalPath: String,\n57|            bookmarkBase64: String? = nil,\n58|            displayName: String? = nil,\n59|            serviceLabel: String,\n60|            servicePlistPath: String,\n61|            controllerKind: Runners.ControllerKind,\n62|            runAtLoad: Bool? = nil,\n63|            serverHost: String? = nil,\n64|            scopeKind: String? = nil,\n65|            scope: String? = nil,\n66|            remoteAgentID: Int64? = nil,\n67|            agentName: String? = nil,\n68|            workFolder: String? = nil,\n69|            addedAt: Date = Date(),\n70|            lastSeenAt: Date? = nil\n71|        ) {\n72|            self.localID = localID\n73|            self.directoryPath = directoryPath\n74|            self.canonicalPath = canonicalPath\n75|            self.bookmarkBase64 = bookmarkBase64\n76|            self.displayName = displayName\n77|            self.serviceLabel = serviceLabel\n78|            self.servicePlistPath = servicePlistPath\n79|            self.controllerKind = controllerKind\n80|            self.runAtLoad = runAtLoad\n81|            self.serverHost = serverHost\n82|            self.scopeKind = scopeKind\n83|            self.scope = scope\n84|            self.remoteAgentID = remoteAgentID\n85|            self.agentName = agentName\n86|            self.workFolder = workFolder\n87|            self.addedAt = addedAt\n88|            self.lastSeenAt = lastSeenAt\n89|        }\n90|    }\n91|\n92|    struct File: Codable, Sendable, Equatable {\n93|        var version: Int\n94|        var entries: [Entry]\n95|    }\n96|\n97|    public enum CatalogError: LocalizedError, Sendable, Equatable {\n98|        case duplicateDirectory(path: String)\n99|        case unknownEntry(id: String)\n100|\n101|        public var errorDescription: String? {\n102|            switch self {\n103|            case .duplicateDirectory(let path):\n104|                \"Runner directory is already in the catalog: \\(path). One directory cannot be imported twice.\"\n105|            case .unknownEntry(let id):\n106|                \"Unknown catalog entry: \\(id).\"\n107|            }\n108|        }\n109|    }\n110|\n111|    private let fileURL: URL\n112|\n113|    public init(fileURL: URL? = nil) {\n114|        if let fileURL {\n115|            self.fileURL = fileURL\n116|        } else {\n117|            let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first\n118|                ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/Application Support\")\n119|            self.fileURL = base.appendingPathComponent(\"RunnerControl/\\(Self.fileName)\")\n120|        }\n121|    }\n122|\n123|    public nonisolated var url: URL { fileURL }\n124|\n125|    /// Canonical directory identity. Symlink spellings collapse to one key,\n126|    /// so the same installation cannot be imported twice via an alias path.\n127|    public nonisolated static func canonical(_ url: URL) -> String {\n128|        url.resolvingSymlinksInPath().standardizedFileURL.path\n129|    }\n130|\n131|    public func load() -> [Entry] {\n132|        guard let data = try? Data(contentsOf: fileURL),\n133|              let file = try? JSONDecoder().decode(File.self, from: data),\n134|              file.version == Self.currentVersion else { return [] }\n135|        return file.entries\n136|    }\n137|\n138|    public func save(_ entries: [Entry]) throws {\n139|        let file = File(version: Self.currentVersion, entries: entries)\n140|        let data = try JSONEncoder().encode(file)\n141|        try FileManager.default.createDirectory(at: fileURL.deletingLastPathComponent(), withIntermediateDirectories: true)\n142|        try data.write(to: fileURL, options: .atomic)\n143|    }\n144|\n145|    /// Adds an entry. Refuses a second entry for the same canonical directory,\n146|    /// including symlink spellings. Two identical agent names on different\n147|    /// scopes stay two entries; only the directory is deduplicated.\n148|    public func add(_ entry: Entry) throws {\n149|        var entries = load()\n150|        let want = entry.canonicalPath\n151|        if entries.contains(where: { $0.canonicalPath == want }) {\n152|            throw CatalogError.duplicateDirectory(path: entry.directoryPath)\n153|        }\n154|        entries.append(entry)\n155|        try save(entries)\n156|    }\n157|\n158|    /// Removes only the catalog record. Deletes no files, no GitHub\n159|    /// registration, no certificates, and never stops a running service.\n160|    /// Returns the removed entry so the caller can warn when the service\n161|    /// keeps running.\n162|    @discardableResult\n163|    public func remove(localID: String) throws -> Entry {\n164|        var entries = load()\n165|        guard let index = entries.firstIndex(where: { $0.localID == localID }) else {\n166|            throw CatalogError.unknownEntry(id: localID)\n167|        }\n168|        let removed = entries.remove(at: index)\n169|        try save(entries)\n170|        return removed\n171|    }\n172|\n173|    public func update(_ entry: Entry) throws {\n174|        var entries = load()\n175|        guard let index = entries.firstIndex(where: { $0.localID == entry.localID }) else {\n176|            throw CatalogError.unknownEntry(id: entry.localID)\n177|        }\n178|        // Directory moves must not collide with another entry's canonical path.\n179|        if entries.enumerated().contains(where: { $0.offset != index && $0.element.canonicalPath == entry.canonicalPath }) {\n180|            throw CatalogError.duplicateDirectory(path: entry.directoryPath)\n181|        }\n182|        entries[index] = entry\n183|        try save(entries)\n184|    }\n185|\n186|    /// One-time migration: when the catalog file is missing or empty, import\n187|    /// every discovered installation with its real directory, scope, label\n188|    /// and preserved RunAtLoad policy. Never stops, renames, re-registers or\n189|    /// changes autostart; discovery only reads. Returns the migrated entries.\n190|    public func migrateIfNeeded(home: URL = FileManager.default.homeDirectoryForCurrentUser) throws -> [Entry] {\n191|        if !load().isEmpty { return load() }\n192|        let definitions = RunnerDiscovery.installed(home: home)\n193|        var entries: [Entry] = []\n194|        for definition in definitions {\n195|            let url = definition.directory\n196|            let canonical = Self.canonical(url)\n197|            if entries.contains(where: { $0.canonicalPath == canonical }) { continue }\n198|            let info = RunnerRegistrationReader.read(directory: url)\n199|            let runAtLoad = Self.readRunAtLoad(plist: definition.plist)\n200|            let kind: Runners.ControllerKind = definition.plist.path.contains(\"/Library/LaunchAgents/\")\n201|                ? .standardLaunchAgent : .manualManaged\n202|            let entry = Entry(\n203|                directoryPath: url.path,\n204|                canonicalPath: canonical,\n205|                bookmarkBase64: Self.bookmark(for: url),\n206|                serviceLabel: definition.id,\n207|                servicePlistPath: definition.plist.path,\n208|                controllerKind: kind,\n209|                runAtLoad: runAtLoad,\n210|                serverHost: info?.serverHost,\n211|                scopeKind: info?.scopeKind,\n212|                scope: info?.scopeDetail,\n213|                remoteAgentID: info?.agentID,\n214|                agentName: info?.agentName,\n215|                workFolder: info?.workFolder\n216|            )\n217|            entries.append(entry)\n218|        }\n219|        if !entries.isEmpty {\n220|            try save(entries)\n221|        }\n222|        return entries\n223|    }\n224|\n225|    nonisolated static func readRunAtLoad(plist: URL) -> Bool? {\n226|        guard let data = try? Data(contentsOf: plist),\n227|              let object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else { return nil }\n228|        return object[\"RunAtLoad\"] as? Bool\n229|    }\n230|\n231|    nonisolated static func bookmark(for url: URL) -> String? {\n232|        guard let data = try? url.bookmarkData(options: .withSecurityScope, includingResourceValuesForKeys: nil, relativeTo: nil) else { return nil }\n233|        return data.base64EncodedString()\n234|    }\n235|\n236|    /// Resolves the stored bookmark, falling back to the recorded path when\n237|    /// no bookmark exists or resolution fails. Never synthesizes a different\n238|    /// directory.\n239|    nonisolated public static func resolve(entry: Entry) -> URL {\n240|        if let base64 = entry.bookmarkBase64,\n241|           let data = Data(base64Encoded: base64) {\n242|            var stale = false\n243|            if let url = try? URL(resolvingBookmarkData: data, options: .withSecurityScope, relativeTo: nil, bookmarkDataIsStale: &stale) {\n244|                return url\n245|            }\n246|        }\n247|        return URL(fileURLWithPath: entry.directoryPath)\n248|    }\n249|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
