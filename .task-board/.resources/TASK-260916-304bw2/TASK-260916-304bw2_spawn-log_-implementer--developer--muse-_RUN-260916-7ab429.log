{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c96d","stream":{"kind":"session","id":"01a0a986-16d4-7923-b79d-f784beb66015"},"sequence":785,"recorded_at":1780531400001565,"record_type":"event","durability":"durable","causation_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","run_stream":{"kind":"run","id":"f870b610-f41f-4227-a805-61cb8ebcb67d"},"call_id":"call_01a0a987b15075f3a2c31b0815aa876c","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n(1039 line(s) above)\n1040|\n1041|// MARK: - Group access uses fresh API membership (imported drift)\n1042|\n1043|private func groupsPayload(_ groups: [(Int64, String)]) -> GitHubHTTPResponse {\n1044|    jsonResponse([\"runner_groups\": groups.map { id, name in\n1045|        [\"id\": id, \"name\": name, \"visibility\": \"selected\", \"allows_public_repositories\": true] as [String: Any]\n1046|    }])\n1047|}\n1048|\n1049|private func groupRunnersPayload(_ runners: [(Int64, String, Bool)]) -> GitHubHTTPResponse {\n1050|    jsonResponse([\"runners\": runners.map { id, name, busy in\n1051|        [\"id\": id, \"name\": name, \"labels\": [], \"status\": \"online\", \"busy\": busy] as [String: Any]\n1052|    }])\n1053|}\n1054|\n1055|private func groupReposPayload(_ ids: [Int64]) -> GitHubHTTPResponse {\n1056|    jsonResponse([\"repositories\": ids.map { [\"id\": $0] }])\n1057|}\n1058|\n1059|private func loadedGroupAccess(_ logger: Relux.Testing.Logger, id: String) -> Runners.GroupAccess? {\n1060|    for action in runnersActions(logger).reversed() {\n1061|        if case .groupAccessLoaded(let loadedID, let access) = action, loadedID == id {\n1062|            return access\n1063|        }\n1064|    }\n1065|    return nil\n1066|}\n1067|\n1068|private func groupAccessError(_ logger: Relux.Testing.Logger, id: String) -> String? {\n1069|    for action in runnersActions(logger).reversed() {\n1070|        if case .groupAccessFailed(let failedID, let message) = action, failedID == id {\n1071|            return message\n1072|        }\n1073|    }\n1074|    return nil\n1075|}\n1076|\n1077|@Test func groupAccessUsesFreshAPIMembershipNotStalePool() async throws {\n1078|    // Local .runner carries stale pool3 fields; fresh API puts ID39 in group4.\n1079|    // Same-name foreign ID99 sits in group3 and must never be adopted.\n1080|    let harness = await catalogHarness(transportResponses: [\n1081|        groupsPayload([(3, \"old-group\"), (4, \"current-group\")]),\n1082|        groupRunnersPayload([(99, \"macbook-iv\", false)]),\n1083|        groupRunnersPayload([(39, \"macbook-iv\", true)]),\n1084|        groupReposPayload([101, 102])\n1085|    ])\n1086|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1087|    let dir = harness.home.appendingPathComponent(\"r\")\n1088|    try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)\n1089|    let stale: [String: Any] = [\n1090|        \"agentId\": 39, \"agentName\": \"macbook-iv\",\n1091|        \"poolId\": 3, \"poolName\": \"rose-air-projects\",\n1092|        \"gitHubUrl\": \"https://github.com/acme\", \"workFolder\": \"_work\"\n1093|    ]\n1094|    try JSONSerialization.data(withJSONObject: stale).write(to: dir.appendingPathComponent(\".runner\"))\n1095|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"runsvc.sh\"), atomically: true, encoding: .utf8)\n1096|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n1097|    let manifest: [String: Any] = [\n1098|        \"Label\": \"actions.runner.test.drift\",\n1099|        \"ProgramArguments\": [dir.appendingPathComponent(\"runsvc.sh\").path],\n1100|        \"WorkingDirectory\": dir.path, \"RunAtLoad\": false\n1101|    ]\n1102|    try PropertyListSerialization.data(fromPropertyList: manifest, format: .xml, options: 0)\n1103|        .write(to: dir.appendingPathComponent(\"manual-service.plist\"))\n1104|    let entry = RunnerCatalogStore.Entry(\n1105|        directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n1106|        serviceLabel: \"actions.runner.test.drift\",\n1107|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n1108|        controllerKind: .manualManaged, serverHost: \"github.com\",\n1109|        scopeKind: \"org\", scope: \"acme\", remoteAgentID: 39,\n1110|        agentName: \"macbook-iv\", workFolder: \"_work\"\n1111|    )\n1112|    try await harness.catalog.add(entry)\n1113|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.drift\"))\n1114|    let access = loadedGroupAccess(harness.logger, id: \"actions.runner.test.drift\")\n1115|    #expect(access?.group?.id == 4)\n1116|    #expect(access?.group?.name == \"current-group\")\n1117|    #expect(access?.repoIDs == [101, 102])\n1118|    #expect(access?.owned == false)\n1119|    #expect(groupAccessError(harness.logger, id: \"actions.runner.test.drift\") == nil)\n1120|}\n1121|\n1122|@Test func groupAccessRefusesRepoScope() async throws {\n1123|    let harness = await catalogHarness()\n1124|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1125|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme/app\", label: \"actions.runner.test.repo\")\n1126|    let entry = RunnerCatalogStore.Entry(\n1127|        directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n1128|        serviceLabel: \"actions.runner.test.repo\",\n1129|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n1130|        controllerKind: .manualManaged, serverHost: \"github.com\",\n1131|        scopeKind: \"repo\", scope: \"acme/app\", remoteAgentID: 42, agentName: \"r\", workFolder: \"_work\"\n1132|    )\n1133|    try await harness.catalog.add(entry)\n1134|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.repo\"))\n1135|    let err = groupAccessError(harness.logger, id: \"actions.runner.test.repo\") ?? \"\"\n1136|    #expect(err.contains(\"organization runners only\"))\n1137|    #expect(await harness.transport.requests.isEmpty)\n1138|}\n1139|\n1140|@Test func applyGroupAccessRequiresTakeoverForShared() async throws {\n1141|    let harness = await catalogHarness(transportResponses: [\n1142|        groupsPayload([(4, \"team-group\")]),\n1143|        groupRunnersPayload([(42, \"r\", false)]),\n1144|        groupReposPayload([1])\n1145|    ])\n1146|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1147|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.shared\")\n1148|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.shared\"))\n1149|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.shared\"))\n1150|    #expect(loadedGroupAccess(harness.logger, id: \"actions.runner.test.shared\")?.owned == false)\n1151|    // Without takeover: refused before any PUT.\n1152|    await harness.transport.append(groupsPayload([(4, \"team-group\")]))\n1153|    await harness.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1154|    let _: Relux.ActionResult = await harness.flow.apply(\n1155|        Runners.Effect.applyGroupAccess(\"actions.runner.test.shared\", groupID: 4, repositories: [1, 2], allowTakeover: false)\n1156|    )\n1157|    let refused = groupAccessError(harness.logger, id: \"actions.runner.test.shared\") ?? \"\"\n1158|    #expect(refused.contains(\"team-group\"))\n1159|    #expect(await harness.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1160|    // With explicit takeover: ownership recorded, PUT applied, confirmation re-fetched.\n1161|    await harness.transport.append(groupsPayload([(4, \"team-group\")]))\n1162|    await harness.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1163|    await harness.transport.append(GitHubHTTPResponse(status: 204, body: Data()))\n1164|    await harness.transport.append(groupReposPayload([1, 2]))\n1165|    let _: Relux.ActionResult = await harness.flow.apply(\n1166|        Runners.Effect.applyGroupAccess(\"actions.runner.test.shared\", groupID: 4, repositories: [1, 2], allowTakeover: true)\n1167|    )\n1168|    // Success is proven by the fresh loaded access below; the action log\n1169|    // retains the earlier refusal by design.\n1170|    let access = loadedGroupAccess(harness.logger, id: \"actions.runner.test.shared\")\n1171|    #expect(access?.repoIDs == [1, 2])\n1172|    #expect(access?.owned == true)\n1173|    #expect(await harness.transport.requests.filter { $0.method == \"PUT\" }.count == 1)\n1174|}\n1175|\n1176|@Test func applyGroupAccessRefusesStaleGroup() async throws {\n1177|    let harness = await catalogHarness(transportResponses: [\n1178|        groupsPayload([(4, \"g4\")]),\n1179|        groupRunnersPayload([(42, \"r\", false)]),\n1180|        groupReposPayload([1])\n1181|    ])\n1182|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1183|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.stalegroup\")\n1184|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.stalegroup\"))\n1185|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.stalegroup\"))\n1186|    #expect(loadedGroupAccess(harness.logger, id: \"actions.runner.test.stalegroup\")?.group?.id == 4)\n1187|    // Fresh membership now shows the runner in group5: the UI group4 is stale.\n1188|    await harness.transport.append(groupsPayload([(4, \"g4\"), (5, \"g5\")]))\n1189|    await harness.transport.append(groupRunnersPayload([]))\n1190|    await harness.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1191|    let _: Relux.ActionResult = await harness.flow.apply(\n1192|        Runners.Effect.applyGroupAccess(\"actions.runner.test.stalegroup\", groupID: 4, repositories: [1, 2], allowTakeover: true)\n1193|    )\n1194|    let err = groupAccessError(harness.logger, id: \"actions.runner.test.stalegroup\") ?? \"\"\n1195|    #expect(err.contains(\"moved from group 4\"))\n1196|    #expect(await harness.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1197|}\n1198|\n1199|@Test func applyGroupAccessConfirmsExactRepos() async throws {\n1200|    let harness = await catalogHarness(transportResponses: [\n1201|        groupsPayload([(4, \"g4\")]),\n1202|        groupRunnersPayload([(42, \"r\", false)]),\n1203|        groupReposPayload([1])\n1204|    ])\n1205|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1206|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.confirm\")\n1207|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.confirm\"))\n1208|    try await harness.installer.saveOwnedGroupID(serverHost: \"github.com\", org: \"acme\", name: \"g4\", groupID: 4)\n1209|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.confirm\"))\n1210|    #expect(loadedGroupAccess(harness.logger, id: \"actions.runner.test.confirm\")?.owned == true)\n1211|    await harness.transport.append(groupsPayload([(4, \"g4\")]))\n1212|    await harness.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1213|    await harness.transport.append(GitHubHTTPResponse(status: 204, body: Data()))\n1214|    await harness.transport.append(groupReposPayload([1]))\n1215|    let _: Relux.ActionResult = awai