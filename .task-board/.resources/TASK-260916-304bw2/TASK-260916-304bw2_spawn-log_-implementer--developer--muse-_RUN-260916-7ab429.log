{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d1","stream":{"kind":"session","id":"01a0a986-16d4-7923-b79d-f784beb66015"},"sequence":579,"recorded_at":1780531400001153,"record_type":"event","durability":"durable","causation_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","run_stream":{"kind":"run","id":"f870b610-f41f-4227-a805-61cb8ebcb67d"},"task_stream":{"kind":"task","id":"01a0a987-6173-7883-abc8-7f2a8354316f"},"task_id":"01a0a987-6173-7883-abc8-7f2a8354316f","event":{"kind":"output","task_id":"01a0a987-6173-7883-abc8-7f2a8354316f","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n(299 line(s) above)\n300|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n301|            return\n302|        }\n303|        catalogGeneration += 1\n304|        let snapshots = await service.snapshots()\n305|        let wasRunning = snapshots.first(where: { $0.id == entry.serviceLabel })?.status == .running\n306|        do {\n307|            _ = try await catalog.remove(localID: entry.localID)\n308|        } catch {\n309|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n310|            return\n311|        }\n312|        let refreshed = await service.snapshots()\n313|        let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n314|        await action { Runners.Action.refreshed(mapped_refreshed) }\n315|        if wasRunning {\n316|            await action { Runners.Action.catalogFailed(\"Removed «\\(entry.agentName ?? entry.serviceLabel)» from the app. Its service keeps running.\") }\n317|        } else {\n318|            await action { Runners.Action.catalogCleared }\n319|        }\n320|        await discover()\n321|    }\n322|\n323|    // MARK: - Unregister (explicit remote removal)\n324|\n325|    /// Explicit remote unregister, distinct from catalog removal and file\n326|    /// deletion. Binds the local verified `.runner` server/scope/agentId and\n327|    /// the service path, never a remote name alone. Requires a stopped\n328|    /// service and a typed confirmation matching the agent name. Holds the\n329|    /// shared installer lease across `config.sh remove` so no registration,\n330|    /// install, recovery or second unregister can overlap. Files and the\n331|    /// service manifest stay for re-registration.\n332|    private func unregister(id: String, confirmation: String) async {\n333|        guard !unregisterWorking.contains(id), !working.contains(id) else { return }\n334|        unregisterWorking.insert(id)\n335|        await action { Runners.Action.unregistering(id, true) }\n336|        let gen = catalogGeneration\n337|        do {\n338|            let entries = await catalog.load()\n339|            guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n340|                throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n341|            }\n342|            let directory = RunnerCatalogStore.resolve(entry: entry)\n343|            // Mutation authority: local verified identity plus the service\n344|            // path. A remote name match alone never authorizes removal.\n345|            guard let local = await installer.readLocalRegistration(directory: directory),\n346|                  let agentID = local.agentID,\n347|                  let agentName = local.agentName, !agentName.isEmpty,\n348|                  let address = local.gitHubURL,\n349|                  let scope = unregisterScope(address: address) else {\n350|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n351|                    \"No verified local registration for '\\(entry.serviceLabel)'. Refusing to unregister another runner by name.\"\n352|                )\n353|            }\n354|            // Service-path binding: the catalog entry must still point at the\n355|            // verified directory; a relink mid-flight invalidates the evidence.\n356|            let canonical = RunnerCatalogStore.canonical(directory)\n357|            guard canonical == entry.canonicalPath else {\n358|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n359|                    \"Service path changed during unregister. Re-verify instead of removing another directory's registration.\"\n360|                )\n361|            }\n362|            // Agent-ID binding: a stored ID that disagrees with disk fails\n363|            // closed instead of removing a foreign registration.\n364|            if let stored = entry.remoteAgentID, stored != agentID {\n365|                throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n366|                    \"Catalog expects agent \\(stored) but disk shows agent \\(agentID) for '\\(agentName)'. Refusing to unregister a mismatched registration.\"\n367|                )\n368|            }\n369|            guard confirmation == agentName else {\n370|                throw RunnerRegistration.RegistrationError.confirmationMismatch(\n371|                    \"Type '\\(agentName)' to confirm unregister of agent \\(agentID) in \\(scope.detail).\"\n372|                )\n373|            }\n374|            guard !isCatalogStale(gen) else { return }\n375|            // Require a stopped service so unregister cannot interrupt a job\n376|            // without the explicit stop confirmation that stop carries.\n377|            let snapshots = await service.snapshots()\n378|            if snapshots.first(where: { $0.id == entry.serviceLabel })?.status == .running {\n379|                throw RunnerRegistration.RegistrationError.invalidDraft(\n380|                    \"Stop the runner first; unregister refuses to interrupt a running service.\"\n381|                )\n382|            }\n383|            guard !isCatalogStale(gen) else { return }\n384|            let auth = try await currentUserToken()\n385|            guard !isCatalogStale(gen) else { return }\n386|            // Server binding: the verified host must equal the authenticated\n387|            // server; a same-path foreign host never authorizes removal here.\n388|            let verifiedHost = URL(string: address)?.host ?? \"\"\n389|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n390|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n391|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n392|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost). Refusing cross-server unregister.\"\n393|                )\n394|            }\n395|            let created = try await api.createRemoveToken(config: auth.config, token: auth.token, scope: scope)\n396|            guard !isCatalogStale(gen) else { return }\n397|            // Re-verify after the network: scope/path edits invalidate stale\n398|            // evidence instead of removing a re-targeted registration.\n399|            guard let reread = await installer.readLocalRegistration(directory: directory),\n400|                  reread.agentID == agentID, reread.agentName == agentName,\n401|                  reread.gitHubURL == address else {\n402|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n403|                    \"Local registration changed during unregister. Re-verify instead of removing a re-targeted registration.\"\n404|                )\n405|            }\n406|            let currentEntries = await catalog.load()\n407|            guard currentEntries.contains(where: { $0.localID == entry.localID && $0.canonicalPath == canonical }) else {\n408|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n409|                    \"Catalog entry changed during unregister. Re-verify instead of removing another entry.\"\n410|                )\n411|            }\n412|            try await installer.unregister(directory: directory, removeToken: created.token)\n413|            guard !isCatalogStale(gen) else { return }\n414|            // Remote registration is gone; the catalog entry stays so the\n415|            // user can re-register or remove it from the app. Files stay.\n416|            var updated = entry\n417|            updated.remoteAgentID = nil\n418|            updated.lastSeenAt = now()\n419|            try await catalog.update(updated)\n420|            await action { Runners.Action.catalogCleared }\n421|            let refreshed = await service.snapshots()\n422|            let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n423|            await action { Runners.Action.refreshed(mapped_refreshed) }\n424|        } catch {\n425|            if !isCatalogStale(gen) {\n426|                await action { Runners.Action.catalogFailed(error.localizedDescription) }\n427|            }\n428|        }\n429|        unregisterWorking.remove(id)\n430|        await action { Runners.Action.unregistering(id, false) }\n431|    }\n432|\n433|    private func unregisterScope(address: String) -> RunnerRegistration.Scope? {\n434|        guard let url = URL(string: address), url.scheme == \"https\" else { return nil }\n435|        let components = url.pathComponents.filter { $0 != \"/\" }\n436|        if components.count == 1 { return .organization(org: components[0]) }\n437|        if components.count == 2 { return .repository(owner: components[0], name: components[1]) }\n438|        return nil\n439|    }\n440|\n441|    private struct CatalogUserToken: Sendable {\n442|        let config: GitHubAuth.AppConfig\n443|        let token: String\n444|        let identity: GitHubSessionIdentity\n445|    }\n446|\n447|    private func currentUserToken() async throws -> CatalogUserToken {\n448|        guard let identity = await identities.load() else {\n449|            throw RunnerRegistration.RegistrationError.notAuthenticated\n450|        }\n451|        let config = try configProvider(identity.serverHost)\n452|        guard var record = await userStore.load(serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID) else {\n453|            throw RunnerRegistration.RegistrationError.notAuthenticated\n454|        }\n455|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n456|            do {\n457|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n458|            } catch is CancellationError {\n459|                throw CancellationError()\n460|            } catch let error as GitHubAuth.AuthError {\n461|                switch error {\n462|                case .revoked, .unauthorized, .tokenRefreshFailed:\n463|                    throw RunnerRegistration.RegistrationError.unauthorized\n464|                default: break\n465|                }\n466|            }\n467|        }\n468|        return CatalogUserToken(config: config, token: record.accessToken, identity: identity)\n469|    }\n470|\n471|    // MARK: - Remote observation\n472|\n473|    /// Best-effort GitHub sync. Offline, 401/403 and rate limits mark data\n474|    /// stale and never change local power state. Follows full pagination\n475|    /// before matching; matches by server + scope + ID, never by name.\n476|    private func refreshRemote() async {\n477|        let startedIdentity = await identities.load()\n478|        let entries = await catalog.load()\n479|        if entries.isEmpty {\n480|            await action { Runners.Action.remoteSyncFinished(self.now()) }\n481|            return\n482|        }\n483|        let auth: CatalogUserToken\n484|        do {\n485|            auth = try await currentUserToken()\n486|        } catch {\n487|            // Disconnected: local control stays fully available.\n488|            await action { Runners.Action.remoteSyncFailed(error.localizedDescription) }\n489|            return\n490|        }\n491|        // Group definitions by scope so one paginated list serves every\n492|        // runner in that scope.\n493|        var scopes: [String: (scope: RunnerRegistration.Scope, ids: [String])] = [:]\n494|        var definitions: [String: Runners.Definition] = [:]\n495|        for entry in entries {\n496|            let directory = RunnerCatalogStore.resolve(entry: entry)\n497|            let info = RunnerRegistrationReader.read(directory: directory)\n498|            guard let address = info?.gitHubURL ?? entry.serverHost.map({ \"https://\\($0)/\\(entry.scope ?? \"\")\" }),\n499|                  let scope = unregisterScope(address: address) else { continue }\n500|            // Observe only registrations on the authenticated server.\n501|            let host = URL(string: address)?.host ?? entry.serverHost ?? \"\"\n502|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(host)\n503|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else { continue }\n504|            let key = scope.scopeKey\n505|            scopes[key, default: (scope, [])].ids.append(entry.serviceLabel)\n506|            definitions[entry.serviceLabel] = LaunchAgentService.definition(from: entry)\n507|        }\n508|        var failures: [String] = []\n509|        for (_, group) in scopes {\n510|            // A logout mid-sync stops silently: no writes into a logged-out session.\n511|            let current = await identities.load()\n512|            if current == nil || current?.userID != startedIdentity?.userID\n513|                || current?.serverHost != startedIdentity?.serverHost {\n514|                return\n515|            }\n516|            do {\n517|                let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: group.scope)\n518|                for id in group.ids {\n519|                    guard let definition = definitions[id] else { continue }\n520|                    if let observation = GitHubRunnerObserver.match(definition: definition, runners: runners, now: now()) {\n521|                        await action { Runners.Action.remoteUpdated(id, GitHubRunnerObserver.withFreshness(observation, now: self.now())) }\n522|                    } else {\n523|                        await action { Runners.Action.remoteUpdated(id, Runners.RemoteObservation(\n524|                            busyKnown: false, updatedAt: self.now(), stale: false,\n525|                            syncError: \"Identity mismatch\"\n526|                        )) }\n527|                    }\n528|                }\n529|            } catch let error as RunnerRegistration.RegistrationError {\n530|                switch error {\n531|                case .unauthorized:\n532|                    await action { Runners.Action.remoteSyncFailed(RunnerRegistration.RegistrationError.unauthorized.localizedDescription) }\n533|                    return\n534|                case .rateLimited:\n535|                    failures.append(\"Rate limited; will retry.\")\n536|                case .missingPermission(let text):\n537|                    failures.append(text)\n538|                default:\n539|                    failures.append(error.localizedDescription)\n540|                }\n541|            } catch {\n542|                failures.append(error.localizedDescription)\n543|            }\n544|        }\n545|        if failures.isEmpty {\n546|            await action { Runners.Action.remoteSyncFinished(self.now()) }\n547|        } else {\n548|            let joinedFailures = failures.joined(separator: \"; \")\n549|            await action { Runners.Action.remoteSyncFailed(joinedFailures) }\n550|        }\n551|    }\n552|\n553|    // MARK: - Preferences and relink\n554|\n555|    /// Changes only the login-startup policy. Never bootstraps or bootouts;\n556|    /// the policy applies at next login. Refuses while an installer mutation\n557|    /// is live.\n558|    /// Changes only the login-start behavior. Standard manifests edit\n559|    /// their own RunAtLoad. External manual plists gain or lose a matching\n560|    /// registration in `~/Library/LaunchAgents` (RunAtLoad outside\n561|    /// LaunchAgents never persists login start). Never bootstraps or\n562|    /// bootouts: live runner state is preserved. Refuses while an installer\n563|    /// mutation is live, and never touches a foreign same-label plist.\n564|    private func setRunAtLoad(id: String, value: Bool) async {\n565|        if unregisterWorking.contains(id) || working.contains(id) {\n566|            await action { Runners.Action.catalogFailed(\"Runner is busy; retry after it settles.\") }\n567|            return\n568|        }\n569|        let entries = await catalog.load()\n570|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n571|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n572|            return\n573|        }\n574|        if entry.controllerKind == .unsupported {\n575|            await action { Runners.Action.catalogFailed(\"Unsupported runners have no Runner Control login policy.\") }\n576|            return\n577|        }\n578|        do {\n579|            let directory = RunnerCatalogStore.resolve(entry: entry)\n580|            try await installer.requireIdle(for: directory)\n581|            if entry.controllerKind == .standardLaunchAgent {\n582|                let plist = URL(fileURLWithPath: entry.servicePlistPath)\n583|                guard let data = try? Data(contentsOf: plist),\n584|                      var object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {\n585|                    throw RunnerError.message(\"Service manifest is unreadable.\")\n586|                }\n587|                object[\"RunAtLoad\"] = value\n588|                let out = try PropertyListSerialization.data(fromPropertyList: object, format: .xml, options: 0)\n589|                try out.write(to: plist, options: .atomic)\n590|                entry.runAtLoad = value\n591|                try await catalog.update(entry)\n592|            } else {\n593|                try setManualLogin(entry: entry, directory: directory, enabled: value)\n594|            }\n595|            await action { Runners.Action.catalogCleared }\n596|            let snapshots = await service.snapshots()\n597|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n598|            await action { Runners.Action.refreshed(mapped_snapshots) }\n599|        } catch {\n600|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n601|        }\n602|    }\n603|\n604|    /// Enables or disables login start for an external manual service by\n605|    /// managing its `~/Library/LaunchAgents` registration. The external\n606|    /// service file itself is never modified, so the imported policy stays\n607|    /// byte-identical; live launchd state is untouched.\n608|    private func setManualLogin(entry: RunnerCatalogStore.Entry, directory: URL, enabled: Bool) throws {\n609|        let external = URL(fileURLWithPath: entry.servicePlistPath)\n610|        guard let data = try? Data(contentsOf: external),\n611|              let object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {\n612|            throw RunnerError.message(\"Service manifest is unreadable.\")\n613|        }\n614|        let definition = LaunchAgentService.definition(from: entry)\n615|        let copy = RunnerControllers.loginRegistrationURL(label: entry.serviceLabel, home: home)\n616|        if enabled {\n617|            if let existing = try? Data(contentsOf: copy),\n618|               let current = try? PropertyListSerialization.propertyList(from: existing, format: nil) as? [String: Any] {\n619|                guard RunnerControllers.references(current, definition: definition) else {\n620|                    throw RunnerError.message(\"Login slot '\\(copy.lastPathComponent)' belongs to another service. Remove it by hand instead of overwriting.\")\n621|                }\n622|                var updated = current\n623|                updated[\"RunAtLoad\"] = true\n624|                let out = try PropertyListSerialization.data(fromPropertyList: updated, format: .xml, options: 0)\n625|                try out.write(to: copy, options: .atomic)\n626|                return\n627|            }\n628|            var registration = object\n629|            registration[\"Label\"] = entry.serviceLabel\n630|            registration[\"WorkingDirectory\"] = directory.path\n631|            registration[\"ProgramArguments\"] = [directory.appendingPathComponent(\"runsvc.sh\").path]\n632|            registration[\"RunAtLoad\"] = true\n633|            let out = try PropertyListSerialization.data(fromPropertyList: registration, format: .xml, options: 0)\n634|            try FileManager.default.createDirectory(at: copy.deletingLastPathComponent(), withIntermediateDirectories: true)\n635|            try out.write(to: copy, options: .atomic)\n636|            return\n637|        }\n638|        guard FileManager.default.fileExists(atPath: copy.path) else { return }\n639|        guard let existing = try? Data(contentsOf: copy),\n640|              let current = try? PropertyListSerialization.propertyList(from: existing, format: nil) as? [String: Any],\n641|              RunnerControllers.references(current, definition: definition) else {\n642|            throw RunnerError.message(\"Login slot '\\(copy.lastPathComponent)' belongs to another service. Remove it by hand instead of deleting.\")\n643|        }\n644|        try FileManager.default.removeItem(at: copy)\n645|    }\n646|\n647|    private func setAlias(id: String, alias: String?) async {\n648|        let entries = await catalog.load()\n649|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d3","stream":{"kind":"session","id":"01a0a986-16d4-7923-b79d-f784beb66015"},"sequence":580,"recorded_at":1780531400001155,"record_type":"event","durability":"durable","causation_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","run_stream":{"kind":"run","id":"f870b610-f41f-4227-a805-61cb8ebcb67d"},"task_stream":{"kind":"task","id":"01a0a987-6173-7883-abc8-7f2a8354316f"},"task_id":"01a0a987-6173-7883-abc8-7f2a8354316f","event":{"kind":"completed","task_id":"01a0a987-6173-7883-abc8-7f2a8354316f"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d5","stream":{"kind":"session","id":"01a0a986-16d4-7923-b79d-f784beb66015"},"sequence":581,"recorded_at":1780531400001157,"record_type":"event","durability":"durable","causation_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","run_stream":{"kind":"run","id":"f870b610-f41f-4227-a805-61cb8ebcb67d"},"call_id":"call_01a0a9875db97753be786020cc05d849","text":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n(299 line(s) above)\n300|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n301|            return\n302|        }\n303|        catalogGeneration += 1\n304|        let snapshots = await service.snapshots()\n305|        let wasRunning = snapshots.first(where: { $0.id == entry.serviceLabel })?.status == .running\n306|        do {\n307|            _ = try await catalog.remove(localID: entry.localID)\n308|        } catch {\n309|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n310|            return\n311|        }\n312|        let refreshed = await service.snapshots()\n313|        let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n314|        await action { Runners.Action.refreshed(mapped_refreshed) }\n315|        if wasRunning {\n316|            await action { Runners.Action.catalogFailed(\"Removed «\\(entry.agentName ?? entry.serviceLabel)» from the app. Its service keeps running.\") }\n317|        } else {\n318|            await action { Runners.Action.catalogCleared }\n319|        }\n320|        await discover()\n321|    }\n322|\n323|    // MARK: - Unregister (explicit remote removal)\n324|\n325|    /// Explicit remote unregister, distinct from catalog removal and file\n326|    /// deletion. Binds the local verified `.runner` server/scope/agentId and\n327|    /// the service path, never a remote name alone. Requires a stopped\n328|    /// service and a typed confirmation matching the agent name. Holds the\n329|    /// shared installer lease across `config.sh remove` so no registration,\n330|    /// install, recovery or second unregister can overlap. Files and the\n331|    /// service manifest stay for re-registration.\n332|    private func unregister(id: String, confirmation: String) async {\n333|        guard !unregisterWorking.contains(id), !working.contains(id) else { return }\n334|        unregisterWorking.insert(id)\n335|        await action { Runners.Action.unregistering(id, true) }\n336|        let gen = catalogGeneration\n337|        do {\n338|            let entries = await catalog.load()\n339|            guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n340|                throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n341|            }\n342|            let directory = RunnerCatalogStore.resolve(entry: entry)\n343|            // Mutation authority: local verified identity plus the service\n344|            // path. A remote name match alone never authorizes removal.\n345|            guard let local = await installer.readLocalRegistration(directory: directory),\n346|                  let agentID = local.agentID,\n347|                  let agentName = local.agentName, !agentName.isEmpty,\n348|                  let address = local.gitHubURL,\n349|                  let scope = unregisterScope(address: address) else {\n350|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n351|                    \"No verified local registration for '\\(entry.serviceLabel)'. Refusing to unregister another runner by name.\"\n352|                )\n353|            }\n354|            // Service-path binding: the catalog entry must still point at the\n355|            // verified directory; a relink mid-flight invalidates the evidence.\n356|            let canonical = RunnerCatalogStore.canonical(directory)\n357|            guard canonical == entry.canonicalPath else {\n358|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n359|                    \"Service path changed during unregister. Re-verify instead of removing another directory's registration.\"\n360|                )\n361|            }\n362|            // Agent-ID binding: a stored ID that disagrees with disk fails\n363|            // closed instead of removing a foreign registration.\n364|            if let stored = entry.remoteAgentID, stored != agentID {\n365|                throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n366|                    \"Catalog expects agent \\(stored) but disk shows agent \\(agentID) for '\\(agentName)'. Refusing to unregister a mismatched registration.\"\n367|                )\n368|            }\n369|            guard confirmation == agentName else {\n370|                throw RunnerRegistration.RegistrationError.confirmationMismatch(\n371|                    \"Type '\\(agentName)' to confirm unregister of agent \\(agentID) in \\(scope.detail).\"\n372|                )\n373|            }\n374|            guard !isCatalogStale(gen) else { return }\n375|            // Require a stopped service so unregister cannot interrupt a job\n376|            // without the explicit stop confirmation that stop carries.\n377|            let snapshots = await service.snapshots()\n378|            if snapshots.first(where: { $0.id == entry.serviceLabel })?.status == .running {\n379|                throw RunnerRegistration.RegistrationError.invalidDraft(\n380|                    \"Stop the runner first; unregister refuses to interrupt a running service.\"\n381|                )\n382|            }\n383|            guard !isCatalogStale(gen) else { return }\n384|            let auth = try await currentUserToken()\n385|            guard !isCatalogStale(gen) else { return }\n386|            // Server binding: the verified host must equal the authenticated\n387|            // server; a same-path foreign host never authorizes removal here.\n388|            let verifiedHost = URL(string: address)?.host ?? \"\"\n389|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n390|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n391|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n392|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost). Refusing cross-server unregister.\"\n393|                )\n394|            }\n395|            let created = try await api.createRemoveToken(config: auth.config, token: auth.token, scope: scope)\n396|            guard !isCatalogStale(gen) else { return }\n397|            // Re-verify after the network: scope/path edits invalidate stale\n398|            // evidence instead of removing a re-targeted registration.\n399|            guard let reread = await installer.readLocalRegistration(directory: directory),\n400|                  reread.agentID == agentID, reread.agentName == agentName,\n401|                  reread.gitHubURL == address else {\n402|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n403|                    \"Local registration changed during unregister. Re-verify instead of removing a re-targeted registration.\"\n404|                )\n405|            }\n406|            let currentEntries = await catalog.load()\n407|            guard currentEntries.contains(where: { $0.localID == entry.localID && $0.canonicalPath == canonical }) else {\n408|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n409|                    \"Catalog entry changed during unregister. Re-verify instead of removing another entry.\"\n410|                )\n411|            }\n412|            try await installer.unregister(directory: directory, removeToken: created.token)\n413|            guard !isCatalogStale(gen) else { return }\n414|            // Remote registration is gone; the catalog entry stays so the\n415|            // user can re-register or remove it from the app. Files stay.\n416|            var updated = entry\n417|            updated.remoteAgentID = nil\n418|            updated.lastSeenAt = now()\n419|            try await catalog.update(updated)\n420|            await action { Runners.Action.catalogCleared }\n421|            let refreshed = await service.snapshots()\n422|            let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n423|            await action { Runners.Action.refreshed(mapped_refreshed) }\n424|        } catch {\n425|            if !isCatalogStale(gen) {\n426|                await action { Runners.Action.catalogFailed(error.localizedDescription) }\n427|            }\n428|        }\n429|        unregisterWorking.remove(id)\n430|        await action { Runners.Action.unregistering(id, false) }\n431|    }\n432|\n433|    private func unregisterScope(address: String) -> RunnerRegistration.Scope? {\n434|        guard let url = URL(string: address), url.scheme == \"https\" else { return nil }\n435|        let components = url.pathComponents.filter { $0 != \"/\" }\n436|        if components.count == 1 { return .organization(org: components[0]) }\n437|        if components.count == 2 { return .repository(owner: components[0], name: components[1]) }\n438|        return nil\n439|    }\n440|\n441|    private struct CatalogUserToken: Sendable {\n442|        let config: GitHubAuth.AppConfig\n443|        let token: String\n444|        let identity: GitHubSessionIdentity\n445|    }\n446|\n447|    private func currentUserToken() async throws -> CatalogUserToken {\n448|        guard let identity = await identities.load() else {\n449|            throw RunnerRegistration.RegistrationError.notAuthenticated\n450|        }\n451|        let config = try configProvider(identity.serverHost)\n452|        guard var record = await userStore.load(serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID) else {\n453|            throw RunnerRegistration.RegistrationError.notAuthenticated\n454|        }\n455|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n456|            do {\n457|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n458|            } catch is CancellationError {\n459|                throw CancellationError()\n460|            } catch let error as GitHubAuth.AuthError {\n461|                switch error {\n462|                case .revoked, .unauthorized, .tokenRefreshFailed:\n463|                    throw RunnerRegistration.RegistrationError.unauthorized\n464|                default: break\n465|                }\n466|            }\n467|        }\n468|        return CatalogUserToken(config: config, token: record.accessToken, identity: identity)\n469|    }\n470|\n471|    // MARK: - Remote observation\n472|\n473|    /// Best-effort GitHub sync. Offline, 401/403 and rate limits mark data\n474|    /// stale and never change local power state. Follows full pagination\n475|    /// before matching; matches by server + scope + ID, never by name.\n476|    private func refreshRemote() async {\n477|        let startedIdentity = await identities.load()\n478|        let entries = await catalog.load()\n479|        if entries.isEmpty {\n480|            await action { Runners.Action.remoteSyncFinished(self.now()) }\n481|            return\n482|        }\n483|        let auth: CatalogUserToken\n484|        do {\n485|            auth = try await currentUserToken()\n486|        } catch {\n487|            // Disconnected: local control stays fully available.\n488|            await action { Runners.Action.remoteSyncFailed(error.localizedDescription) }\n489|            return\n490|        }\n491|        // Group definitions by scope so one paginated list serves every\n492|        // runner in that scope.\n493|        var scopes: [String: (scope: RunnerRegistration.Scope, ids: [String])] = [:]\n494|        var definitions: [String: Runners.Definition] = [:]\n495|        for entry in entries {\n496|            let directory = RunnerCatalogStore.resolve(entry: entry)\n497|            let info = RunnerRegistrationReader.read(directory: directory)\n498|            guard let address = info?.gitHubURL ?? entry.serverHost.map({ \"https://\\($0)/\\(entry.scope ?? \"\")\" }),\n499|                  let scope = unregisterScope(address: address) else { continue }\n500|            // Observe only registrations on the authenticated server.\n501|            let host = URL(string: address)?.host ?? entry.serverHost ?? \"\"\n502|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(host)\n503|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else { continue }\n504|            let key = scope.scopeKey\n505|            scopes[key, default: (scope, [])].ids.append(entry.serviceLabel)\n506|            definitions[entry.serviceLabel] = LaunchAgentService.definition(from: entry)\n507|        }\n508|        var failures: [String] = []\n509|        for (_, group) in scopes {\n510|            // A logout mid-sync stops silently: no writes into a logged-out session.\n511|            let current = await identities.load()\n512|            if current == nil || current?.userID != startedIdentity?.userID\n513|                || current?.serverHost != startedIdentity?.serverHost {\n514|                return\n515|            }\n516|            do {\n517|                let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: group.scope)\n518|                for id in group.ids {\n519|                    guard let definition = definitions[id] else { continue }\n520|                    if let observation = GitHubRunnerObserver.match(definition: definition, runners: runners, now: now()) {\n521|                        await action { Runners.Action.remoteUpdated(id, GitHubRunnerObserver.withFreshness(observation, now: self.now())) }\n522|                    } else {\n523|                        await action { Runners.Action.remoteUpdated(id, Runners.RemoteObservation(\n524|                            busyKnown: false, updatedAt: self.now(), stale: false,\n525|                            syncError: \"Identity mismatch\"\n526|                        )) }\n527|                    }\n528|                }\n529|            } catch let error as RunnerRegistration.RegistrationError {\n530|                switch error {\n531|                case .unauthorized:\n532|                    await action { Runners.Action.remoteSyncFailed(RunnerRegistration.RegistrationError.unauthorized.localizedDescription) }\n533|                    return\n534|                case .rateLimited:\n535|                    failures.append(\"Rate limited; will retry.\")\n536|                case .missingPermission(let text):\n537|                    failures.append(text)\n538|                default:\n539|                    failures.append(error.localizedDescription)\n540|                }\n541|            } catch {\n542|                failures.append(error.localizedDescription)\n543|            }\n544|        }\n545|        if failures.isEmpty {\n546|            await action { Runners.Action.remoteSyncFinished(self.now()) }\n547|        } else {\n548|            let joinedFailures = failures.joined(separator: \"; \")\n549|            await action { Runners.Action.remoteSyncFailed(joinedFailures) }\n550|        }\n551|    }\n552|\n553|    // MARK: - Preferences and relink\n554|\n555|    /// Changes only the login-startup policy. Never bootstraps or bootouts;\n556|    /// the policy applies at next login. Refuses while an installer mutation\n557|    /// is live.\n558|    /// Changes only the login-start behavior. Standard manifests edit\n559|    /// their own RunAtLoad. External manual plists gain or lose a matching\n560|    /// registration in `~/Library/LaunchAgents` (RunAtLoad outside\n561|    /// LaunchAgents never persists login start). Never bootstraps or\n562|    /// bootouts: live runner state is preserved. Refuses while an installer\n563|    /// mutation is live, and never touches a foreign same-label plist.\n564|    private func setRunAtLoad(id: String, value: Bool) async {\n565|        if unregisterWorking.contains(id) || working.contains(id) {\n566|            await action { Runners.Action.catalogFailed(\"Runner is busy; retry after it settles.\") }\n567|            return\n568|        }\n569|        let entries = await catalog.load()\n570|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n571|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n572|            return\n573|        }\n574|        if entry.controllerKind == .unsupported {\n575|            await action { Runners.Action.catalogFailed(\"Unsupported runners have no Runner Control login policy.\") }\n576|            return\n577|        }\n578|        do {\n579|            let directory = RunnerCatalogStore.resolve(entry: entry)\n580|            try await installer.requireIdle(for: directory)\n581|            if entry.controllerKind == .standardLaunchAgent {\n582|                let plist = URL(fileURLWithPath: entry.servicePlistPath)\n583|                guard let data = try? Data(contentsOf: plist),\n584|                      var object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {\n585|                    throw RunnerError.message(\"Service manifest is unreadable.\")\n586|                }\n587|                object[\"RunAtLoad\"] = value\n588|                let out = try PropertyListSerialization.data(fromPropertyList: object, format: .xml, options: 0)\n589|                try out.write(to: plist, options: .atomic)\n590|                entry.runAtLoad = value\n591|                try await catalog.update(entry)\n592|            } else {\n593|                try setManualLogin(entry: entry, directory: directory, enabled: value)\n594|            }\n595|            await action { Runners.Action.catalogCleared }\n596|            let snapshots = await service.snapshots()\n597|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n598|            await action { Runners.Action.refreshed(mapped_snapshots) }\n599|        } catch {\n600|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n601|        }\n602|    }\n603|\n604|    /// Enables or disables login start for an external manual service by\n605|    /// managing its `~/Library/LaunchAgents` registration. The external\n606|    /// service file itself is never modified, so the imported policy stays\n607|    /// byte-identical; live launchd state is untouched.\n608|    private func setManualLogin(entry: RunnerCatalogStore.Entry, directory: URL, enabled: Bool) throws {\n609|        let external = URL(fileURLWithPath: entry.servicePlistPath)\n610|        guard let data = try? Data(contentsOf: external),\n611|              let object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {\n612|            throw RunnerError.message(\"Service manifest is unreadable.\")\n613|        }\n614|        let definition = LaunchAgentService.definition(from: entry)\n615|        let copy = RunnerControllers.loginRegistrationURL(label: entry.serviceLabel, home: home)\n616|        if enabled {\n617|            if let existing = try? Data(contentsOf: copy),\n618|               let current = try? PropertyListSerialization.propertyList(from: existing, format: nil) as? [String: Any] {\n619|                guard RunnerControllers.references(current, definition: definition) else {\n620|                    throw RunnerError.message(\"Login slot '\\(copy.lastPathComponent)' belongs to another service. Remove it by hand instead of overwriting.\")\n621|                }\n622|                var updated = current\n623|                updated[\"RunAtLoad\"] = true\n624|                let out = try PropertyListSerialization.data(fromPropertyList: updated, format: .xml, options: 0)\n625|                try out.write(to: copy, options: .atomic)\n626|                return\n627|            }\n628|            var registration = object\n629|            registration[\"Label\"] = entry.serviceLabel\n630|            registration[\"WorkingDirectory\"] = directory.path\n631|            registration[\"ProgramArguments\"] = [directory.appendingPathComponent(\"runsvc.sh\").path]\n632|            registration[\"RunAtLoad\"] = true\n633|            let out = try PropertyListSerialization.data(fromPropertyList: registration, format: .xml, options: 0)\n634|            try FileManager.default.createDirectory(at: copy.deletingLastPathComponent(), withIntermediateDirectories: true)\n635|            try out.write(to: copy, options: .atomic)\n636|            return\n637|        }\n638|        guard FileManager.default.fileExists(atPath: copy.path) else { return }\n639|        guard let existing = try? Data(contentsOf: copy),\n640|              let current = try? PropertyListSerialization.propertyList(from: existing, format: nil) as? [String: Any],\n641|              RunnerControllers.references(current, definition: definition) else {\n642|            throw RunnerError.message(\"Login slot '\\(copy.lastPathComponent)' belongs to another service. Remove it by hand instead of deleting.\")\n643|        }\n644|        try FileManager.default.removeItem(at: copy)\n645|    }\n646|\n647|    private func setAlias(id: String, alias: String?) async {\n648|        let entries = await catalog.load()\n649|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
