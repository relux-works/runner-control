 Update whichever manifest this entry owns.\n705|            if plist.path.hasPrefix(entry.directoryPath) {\n706|                let moved = url.appendingPathComponent(\"manual-service.plist\")\n707|                if FileManager.default.fileExists(atPath: moved.path) {\n708|                    try await installer.updateServicePaths(plist: moved, directory: url)\n709|                    entry.servicePlistPath = moved.path\n710|                }\n711|            } else {\n712|                try await installer.updateServicePaths(plist: plist, directory: url)\n713|            }\n714|            let oldPath = entry.directoryPath\n715|            entry.directoryPath = url.path\n716|            entry.canonicalPath = canonical\n717|            entry.bookmarkBase64 = RunnerCatalogStore.bookmark(for: url)\n718|            entry.agentName = info.agentName ?? entry.agentName\n719|            entry.serverHost = info.serverHost ?? entry.serverHost\n720|            entry.scope = info.scopeDetail ?? entry.scope\n721|            entry.scopeKind = info.scopeKind ?? entry.scopeKind\n722|            entry.remoteAgentID = info.agentID ?? entry.remoteAgentID\n723|            entry.workFolder = info.workFolder ?? entry.workFolder\n724|            // Keep a managed login registration pointing at the new\n725|            // directory so relink preserves effective login. Foreign\n726|            // same-label plists are never touched.\n727|            if entry.controllerKind == .manualManaged {\n728|                let copy = RunnerControllers.loginRegistrationURL(label: entry.serviceLabel, home: home)\n729|                if let data = try? Data(contentsOf: copy),\n730|                   var current = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],\n731|                   current[\"Label\"] as? String == entry.serviceLabel,\n732|                   current[\"WorkingDirectory\"] as? String == oldPath {\n733|                    try await installer.requireIdle(for: url)\n734|                    current[\"WorkingDirectory\"] = url.path\n735|                    current[\"ProgramArguments\"] = [url.appendingPathComponent(\"runsvc.sh\").path]\n736|                    let out = try PropertyListSerialization.data(fromPropertyList: current, format: .xml, options: 0)\n737|                    try out.write(to: copy, options: .atomic)\n738|                }\n739|            }\n740|            try await catalog.update(entry)\n741|            await action { Runners.Action.catalogCleared }\n742|            let snapshots = await service.snapshots()\n743|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n744|            await action { Runners.Action.refreshed(mapped_snapshots) }\n745|        } catch {\n746|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n747|        }\n748|    }\n749|\n750|    // MARK: - Diagnostics\n751|\n752|    private func loadLog(id: String) async {\n753|        let snapshots = await service.snapshots()\n754|        guard let snapshot = snapshots.first(where: { $0.id == id }) else {\n755|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n756|            return\n757|        }\n758|        let excerpt = RunnerDiagnostics.tail(definition: snapshot.definition)\n759|        await action { Runners.Action.logLoaded(title: snapshot.definition.displayTitle, excerpt: excerpt) }\n760|    }\n761|\n762|    // MARK: - Group access (fresh API membership)\n763|\n764|    private struct VerifiedOrgRunner: Sendable {\n765|        let entry: RunnerCatalogStore.Entry\n766|        let directory: URL\n767|        let org: String\n768|        let agentID: Int64\n769|        let agentName: String\n770|    }\n771|\n772|    /// Verifies the local `.runner` identity for group reads/writes: agent\n773|    /// ID, name, server and org scope must all be present and bound to the\n774| 