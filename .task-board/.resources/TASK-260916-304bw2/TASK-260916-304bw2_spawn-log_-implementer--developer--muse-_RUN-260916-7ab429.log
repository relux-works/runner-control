{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9db","stream":{"kind":"session","id":"01a0a986-16d4-7923-b79d-f784beb66015"},"sequence":840,"recorded_at":1780531400001675,"record_type":"event","durability":"durable","causation_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","run_stream":{"kind":"run","id":"f870b610-f41f-4227-a805-61cb8ebcb67d"},"call_id":"call_01a0a987cf777482a18b41a76c83befe","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n(419 line(s) above)\n420|    private func ownershipFile() -> URL {\n421|        installRoot.appendingPathComponent(Self.ownershipFileName)\n422|    }\n423|\n424|    private static func ownershipKey(serverHost: String, org: String, name: String) -> String {\n425|        \"\\(RunnerRegistration.OperationIdentity.normalizeServerHost(serverHost))\\u{0}\\(org.lowercased())\\u{0}\\(name)\"\n426|    }\n427|\n428|    /// Returns the locally recorded dedicated-group ID for\n429|    /// `server` + `org` + `name`, or nil when this Mac never created (or\n430|    /// took over) that group on that server. Name matches on GitHub alone\n431|    /// never count as ownership, and ownership on one server never\n432|    /// authorizes adoption on another.\n433|    public func loadOwnedGroupID(serverHost: String, org: String, name: String) -> Int64? {\n434|        guard let data = try? Data(contentsOf: ownershipFile()),\n435|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n436|        return table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)]\n437|    }\n438|\n439|    public func saveOwnedGroupID(serverHost: String, org: String, name: String, groupID: Int64) throws {\n440|        let file = ownershipFile()\n441|        var table: [String: Int64] = [:]\n442|        if let data = try? Data(contentsOf: file),\n443|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n444|            table = decoded\n445|        }\n446|        table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)] = groupID\n447|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n448|        let data = try JSONEncoder().encode(table)\n449|        try data.write(to: file, options: .atomic)\n450|    }\n451|\n452|    /// Reads the local `.runner` identity without touching credentials.\n453|    /// Returns nil only when the file is missing or unparseable; a present\n454|    /// but incomplete file returns a partial struct so verification can name\n455|    /// the exact missing field instead of crashing.\n456|    public func readLocalRegistration(directory: URL) -> RunnerRegistration.LocalRegistration? {\n457|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n458|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n459|        var agentID: Int64?\n460|        if let id = object[\"agentId\"] as? Int64 { agentID = id }\n461|        else if let id = object[\"agentId\"] as? Int { agentID = Int64(id) }\n462|        else if let id = object[\"agentId\"] as? NSNumber { agentID = id.int64Value }\n463|        return RunnerRegistration.LocalRegistration(\n464|            agentID: agentID,\n465|            agentName: object[\"agentName\"] as? String,\n466|            gitHubURL: object[\"gitHubUrl\"] as? String,\n467|            workFolder: object[\"workFolder\"] as? String\n468|        )\n469|    }\n470|\n471|    /// Reads the local agent ID from `.runner` without touching credentials.\n472|    public func readAgentID(directory: URL) -> Int64? {\n473|        readLocalRegistration(directory: directory)?.agentID\n474|    }\n475|\n476|    // MARK: - Manual LaunchAgent\n477|\n478|    /// Writes the manual service plist (RunAtLoad off for new runners) and\n479|    /// validates it matches the directory. Never bootstraps the service:\n480|    /// enabling is the user's separate action.\n481|    @discardableResult\n482|    public func setupService(directory: URL, label: String) throws -> URL {\n483|        guard !directory.path.contains(\" \") else {\n484|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n485|        }\n486|        // Never rewrite the service while the installer lease is held by a\n487|        // live install/config; the caller retries after that operation\n488|        // settles.\n489|        try requireIdleInstaller(directory)\n490|        let files = FileManager.default\n491|        guard files.fileExists(atPath: directory.appendingPathComponent(\"runsvc.sh\").path) else {\n492|            throw RunnerRegistration.RegistrationError.network(\n493|                \"runsvc.sh is missing; reinstall before setting up the service.\"\n494|            )\n495|        }\n496|        let plist = directory.appendingPathComponent(\"manual-service.plist\")\n497|        let payload: [String: Any] = [\n498|            \"Label\": label,\n499|            \"ProgramArguments\": [directory.appendingPathComponent(\"runsvc.sh\").path],\n500|            \"WorkingDirectory\": directory.path,\n501|            \"RunAtLoad\": false\n502|        ]\n503|        let data = try PropertyListSerialization.data(fromPropertyList: payload, format: .xml, options: 0)\n504|        try data.write(to: plist, options: .atomic)\n505|        let scopeKey = loadMarker(directory: directory)?.scopeKey ?? \"\"\n506|        try markCompleted(Self.stepServiceReady, directory: directory, scopeKey: scopeKey)\n507|        return plist\n508|    }\n509|\n510|    /// Removes a failed partial install so retries start clean. Refuses to\n511|    /// touch directories that already hold a registration (`.runner`) or an\n512|    /// unknown marker scope: recovery never deletes a working runner.\n513|    public func recoverPartialInstall(directory: URL, scopeKey: String) throws {\n514|        let files = FileManager.default\n515|        guard files.fileExists(atPath: directory.path) else { return }\n516|        // Never delete while the installer lease is held by a live\n517|        // operation; the caller retries after that operation settles.\n518|        try requireIdleInstaller(directory)\n519|        guard !files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n520|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: directory.lastPathComponent)\n521|        }\n522|        if let marker = loadMarker(directory: directory), marker.scopeKey != scopeKey {\n523|            throw RunnerRegistration.RegistrationError.alreadyInstalled(path: directory.path)\n524|        }\n525|        try files.removeItem(at: directory)\n526|    }\n527|\n528|    // MARK: - Catalog operations (shared lease)\n529|\n530|    /// Public idle check for catalog file mutations (RunAtLoad edits,\n531|    /// relink path updates). Refuses while ANY installer mutation is live,\n532|    /// for ANY directory. Retry after the owner settles.\n533|    public func requireIdle(for directory: URL) throws {\n534|        try requireIdleInstaller(directory)\n535|    }\n536|\n537|    /// Runs the exact `config.sh remove` invocation to unregister a runner\n538|    /// from GitHub. Holds the app-wide installer lease across the process so\n539|    /// no registration, install, recovery or second unregister can overlap,\n540|    /// including alias spellings of the same directory. Never deletes the\n541|    /// working directory or the service manifest: files stay for re-registration\n542|    /// or explicit file deletion. The remove token is scrubbed from errors.\n543|    public func unregister(directory: URL, removeToken: String) async throws {\n544|        let lease = try acquireMutationLease(for: directory)\n545|        defer { releaseMutationLease(lease) }\n546|        let files = FileManager.default\n547|        let executable = directory.appendingPathComponent(\"config.sh\").path\n548|        guard files.fileExists(atPath: executable) else {\n549|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n550|        }\n551|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n552|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n553|                \"No local registration at '\\(directory.path)'. Nothing to unregister.\"\n554|            )\n555|        }\n556|        let result = try await executor.run(executable, [\"remove\", \"--token\", removeToken, \"--unattended\"])\n557|        guard result.code == 0 else {\n558|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [removeToken])\n559|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n560|        }\n561|    }\n562|\n563|    /// Updates an existing service manifest to a new directory after the user\n564|    /// explicitly relinks a moved folder. Preserves every other key,\n565|    /// including the imported RunAtLoad policy. Refuses while the installer\n566|    /// lease is held by a live mutation.\n567|    public func updateServicePaths(plist: URL, directory: URL) throws {\n568|        guard !directory.path.contains(\" \") else {\n569|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9dd","stream":{"kind":"session","id":"01a0a986-16d4-7923-b79d-f784beb66015"},"sequence":841,"recorded_at":1780531400001677,"record_type":"event","durability":"durable","causation_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","run_stream":{"kind":"run","id":"f870b610-f41f-4227-a805-61cb8ebcb67d"},"call_id":"call_01a0a987d20271be9763502ef29ce46c","text":"Read text file `Packages/RunnerControlCore/Sources/Runners+Models.swift`.\n1|import Foundation\n2|extension Runners {\n3|    public struct Definition: Identifiable, Sendable, Equatable {\n4|        public let id: String\n5|        public let title: String\n6|        public let detail: String\n7|        public let directory: URL\n8|        public let githubURL: URL\n9|        private let servicePlist: URL?\n10|        /// Catalog identity. Nil for legacy discovery-only rows.\n11|        public let localID: String?\n12|        public let controllerKind: ControllerKind\n13|        /// Preserved launch-at-login policy of the imported service.\n14|        /// Nil means unknown (e.g. unsupported control).\n15|        public let runAtLoad: Bool?\n16|        /// User display override. Renaming on GitHub never changes identity.\n17|        public let displayName: String?\n18|        public let serverHost: String?\n19|        public let remoteAgentID: Int64?\n20|        public let workFolder: String?\n21|        public init(\n22|            id: String, title: String, detail: String, directory: URL, githubURL: URL,\n23|            servicePlist: URL? = nil, localID: String? = nil,\n24|            controllerKind: ControllerKind? = nil, runAtLoad: Bool? = nil,\n25|            displayName: String? = nil, serverHost: String? = nil,\n26|            remoteAgentID: Int64? = nil, workFolder: String? = nil,\n27|            loginEnabled: Bool? = nil\n28|        ) {\n29|            self.id = id; self.title = title; self.detail = detail\n30|            self.directory = directory; self.githubURL = githubURL; self.servicePlist = servicePlist\n31|            self.localID = localID\n32|            if let controllerKind {\n33|                self.controllerKind = controllerKind\n34|            } else {\n35|                let path = (servicePlist ?? directory.appendingPathComponent(\"manual-service.plist\")).path\n36|                self.controllerKind = path.contains(\"/Library/LaunchAgents/\") ? .standardLaunchAgent : .manualManaged\n37|            }\n38|            self.runAtLoad = runAtLoad\n39|            self.displayName = displayName\n40|            self.serverHost = serverHost\n41|            self.remoteAgentID = remoteAgentID\n42|            self.workFolder = workFolder\n43|            self.loginEnabled = loginEnabled\n44|        }\n45|        public var plist: URL { servicePlist ?? directory.appendingPathComponent(\"manual-service.plist\") }\n46|        /// Effective login-start behavior. Standard manifests use their own\n47|        /// RunAtLoad; external manual plists are ON only when a matching\n48|        /// registration exists in `~/Library/LaunchAgents` with RunAtLoad\n49|        /// true — RunAtLoad outside LaunchAgents never persists login start.\n50|        /// Nil means unknown (e.g. unsupported control).\n51|        public let loginEnabled: Bool?\n52|        public func withLoginEnabled(_ value: Bool?) -> Definition {\n53|            Definition(\n54|                id: id, title: title, detail: detail, directory: directory,\n55|                githubURL: githubURL, servicePlist: servicePlist, localID: localID,\n56|                controllerKind: controllerKind, runAtLoad: runAtLoad,\n57|                displayName: displayName, serverHost: serverHost,\n58|                remoteAgentID: remoteAgentID, workFolder: workFolder,\n59|                loginEnabled: value\n60|            )\n61|        }\n62|        /// Display title: user alias wins, otherwise the registration name.\n63|        public var displayTitle: String {\n64|            if let displayName, !displayName.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {\n65|                return displayName\n66|            }\n67|            return title\n68|        }\n69|        /// Legacy log directory fallback. Production log access resolves the\n70|        /// actual StandardOutPath/StandardErrorPath from the manifest plus\n71|        /// `_diag` via `RunnerDiagnostics`; this path is only a fallback.\n72|        public var logs: URL { FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/Logs/\" + id) }\n73|        public static func installed(home: URL = FileManager.default.homeDirectoryForCurrentUser) -> [Self] {\n74|            RunnerDiscovery.installed(home: home)\n75|        }\n76|    }\n77|    public enum Status: String, Sendable, Equatable {\n78|        case checking, stopped, starting, running, stopping, failed, missing, needsSetup, unknown\n79|        public var title: String {\n80|            switch self {\n81|            case .checking: \"Проверяем…\"\n82|            case .stopped: \"Выключен\"\n83|            case .starting: \"Запускается\"\n84|            case .running: \"Служба включена\"\n85|            case .stopping: \"Выключается\"\n86|            case .failed: \"Ошибка службы\"\n87|            case .missing: \"Раннер не найден\"\n88|            case .needsSetup: \"Требуется настройка\"\n89|            case .unknown: \"Статус недоступен\"\n90|            }\n91|        }\n92|    }\n93|    /// Operation phase for one row. Only the affected row is locked.\n94|    public enum OperationPhase: String, Sendable, Equatable {\n95|        case idle, starting, stopping\n96|    }\n97|    /// GitHub observation kept separate from the local service state.\n98|    /// Loss of network never turns a running service into a stopped one.\n99|    public struct RemoteObservation: Sendable, Equatable {\n100|        public var online: Bool?\n101|        public var busy: Bool?\n102|        /// False when GitHub is disconnected, stale, or the runner is absent.\n103|        public var busyKnown: Bool\n104|        public var labels: [String]\n105|        public var group: String?\n106|        public var updatedAt: Date?\n107|        public var stale: Bool\n108|        public var syncError: String?\n109|        public init(\n110|            online: Bool? = nil, busy: Bool? = nil, busyKnown: Bool = false,\n111|            labels: [String] = [], group: String? = nil,\n112|            updatedAt: Date? = nil, stale: Bool = true, syncError: String? = nil\n113|        ) {\n114|            self.online = online; self.busy = busy; self.busyKnown = busyKnown\n115|            self.labels = labels; self.group = group\n116|            self.updatedAt = updatedAt; self.stale = stale; self.syncError = syncError\n117|        }\n118|        /// Truthful GitHub signature. Stale `busy=false` is never presented\n119|        /// as proof of an idle runner.\n120|        public var signature: String {\n121|            if stale { return \"GitHub: данные устарели\" }\n122|            if let error = syncError, !error.isEmpty { return \"GitHub: \\(error)\" }\n123|            guard let online else { return \"GitHub: не подключён\" }\n124|            if !online { return \"GitHub: не в сети\" }\n125|            if !busyKnown { return \"GitHub: занятость неизвестна\" }\n126|            return (busy == true) ? \"GitHub: занят\" : \"GitHub: готов\"\n127|        }\n128|    }\n129|    public struct Snapshot: Identifiable, Sendable, Equatable {\n130|        public let definition: Definition\n131|        public var status: Status\n132|        public var message: String?\n133|        public var remote: RemoteObservation?\n134|        public var operation: OperationPhase\n135|        public var observedAt: Date?\n136|        public var id: String { definition.id }\n137|        public init(\n138|            definition: Definition, status: Status = .checking, message: String? = nil,\n139|            remote: RemoteObservation? = nil, operation: OperationPhase = .idle,\n140|            observedAt: Date? = nil\n141|        ) {\n142|            self.definition = definition; self.status = status; self.message = message\n143|            self.remote = remote; self.operation = operation; self.observedAt = observedAt\n144|        }\n145|    }\n146|\n147|    /// Fresh API group membership for one org runner. Local `.runner`\n148|    /// pool fields can lag server-side moves, so display and access editing\n149|    /// always use this API answer, matched by agent ID, never by name.\n150|    public struct GroupAccess: Sendable, Equatable {\n151|        public var group: RunnerRegistration.RunnerGroup?\n152|        public var repoIDs: [Int64]\n153|        public var updatedAt: Date?\n154|        /// True when this Mac created or explicitly took over the group on\n155|        /// this server (locally recorded ownership). Shared/imported groups\n156|        /// require explicit takeover before any edit.\n157|        public var owned: Bool\n158|        public var loading: Bool\n159|        public var error: String?\n160|        public init(\n161|            group: RunnerRegistration.RunnerGroup? = nil,\n162|            repoIDs: [Int64] = [],\n163|            updatedAt: Date? = nil,\n164|            owned: Bool = false,\n165|            loading: Bool = false,\n166|            error: String? = nil\n167|        ) {\n168|            self.group = group; self.repoIDs = repoIDs; self.updatedAt = updatedAt\n169|            self.owned = owned; self.loading = loading; self.error = error\n170|        }\n171|    }\n172|    /// Stop-confirmation copy. Busy, unknown and stale states are never\n173|    /// silently treated as idle; the first universal version always confirms\n174|    /// stopping a running service.\n175|    public enum StopConfirmation {\n176|        /// True when stopping may interrupt a job: busy, unknown, stale,\n177|        /// disconnected, or error. Only a fresh idle observation returns false,\n178|        /// and even that still confirms (race with new job assignment).\n179|        public static func mayInterrupt(remote: RemoteObservation?) -> Bool {\n180|            guard let remote, !remote.stale, remote.syncError == nil else { return true }\n181|            guard remote.busyKnown, let busy = remote.busy else { return true }\n182|            return busy\n183|        }\n184|\n185|        public static func message(remote: RemoteObservation?, runnerTitle: String) -> String {\n186|            if let remote, !remote.stale, remote.syncError == nil, remote.busyKnown, remote.busy == true {\n187|                return \"На раннере «\\(runnerTitle)» выполняется задача. Выключение прервёт её.\"\n188|            }\n189|            if let remote, !remote.stale, remote.syncError == nil, remote.busyKnown, remote.busy == false {\n190|                return \"Раннер «\\(runnerTitle)» сейчас свободен, но новая задача может быть назначена в любой момент. Остановить службу?\"\n191|            }\n192|            return \"Занятость раннера «\\(runnerTitle)» неизвестна (GitHub не подключён, данные устарели или runner не найден). Выключение может прервать задачу.\"\n193|        }\n194|    }\n195|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
