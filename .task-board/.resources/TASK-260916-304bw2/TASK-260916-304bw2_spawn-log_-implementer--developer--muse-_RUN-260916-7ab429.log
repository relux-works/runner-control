    let base = raw.isEmpty ? \"runner\" : raw\n+        let digest = SHA256.hash(data: Data(canonical(directory).utf8))\n+        let suffix = digest.prefix(4).map { String(format: \"%02x\", $0) }.joined()\n+        return \"actions.runner.imported.\\(base)-\\(suffix)\"\n+    }\n","final_result":true}}}
