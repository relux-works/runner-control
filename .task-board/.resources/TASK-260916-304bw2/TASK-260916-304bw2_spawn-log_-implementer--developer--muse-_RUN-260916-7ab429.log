|    /// (and exact name on the matched ID). Never reads `.runner` pool\n806|    /// fields and never adopts a same-name foreign runner or group.\n807|    private func resolveFreshGroup(\n808|        org: String, agentID: Int64, agentName: String,\n809|        auth: CatalogUserToken, generation gen: Int\n810|    ) async throws -> RunnerRegistration.RunnerGroup {\n811|        let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n812|        for group in groups {\n813|            if isCatalogStale(gen) { throw CancellationError() }\n814|            let members = try await api.fetchGroupRunners(config: auth.config, token: auth.token, org: org, groupID: group.id)\n815|            if let exact = members.first(where: { $0.id == agentID }) {\n816|                guard exact.name == agentName else {\n817|                    throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n818|                        \"Group '\\(group.name)' lists agent \\(agentID) as '\\(exact.name)', not '\\(agentName)'. Refusing a mismatched group.\"\n819|                    )\n820|                }\n821|                return group\n822|            }\n823|            // A same-name foreign member in this group is ignored: only the\n824|            // exact agent ID binds membership.\n825|        }\n826|        throw RunnerRegistration.RegistrationError.remoteRunnerNotFound(\n827|            \"Agent \\(agentID) is not in any visible group for '\\(org)'. It may have been moved or the App lacks group access.\"\n828|        )\n829|    }\n830|\n831|    /// Loads fresh group + repository access for one org runner. Display and\n832|    /// later edits use this API answer, never stale `.runner` pool fields.\n833|    private func loadGroupAccess(id: String) async {\n834|        let gen = catalogGeneration\n835|        let startedIdentity = await identities.load()\n836|        await action { Runners.Action.groupAccessLoading(id) }\n837|        do {\n838|            let verified = try await verifiedOrgRunner(id: id)\n839|            let auth = try await currentUserToken()\n840|            if isCatalogStale(gen) { return }\n841|            guard let started = startedIdentity, await identities.load()?.userID == started.userID else { return }\n842|            let verifiedHost = URL(string: (await installer.readLocalRegistration(directory: verified.directory))?.gitHubURL ?? \"\")?.host ?? \"\"\n843|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n844|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n845|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n846|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost).\"\n847|                )\n848|            }\n849|            let group = try await resolveFreshGroup(\n850|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n851|                auth: auth, generation: gen\n852|            )\n853|            if isCatalogStale(gen) { return }\n854|            let repoIDs = try await api.fetchGroupRepositories(\n855|                config: auth.config, token: auth.token, org: verified.org, groupID: group.id\n856|            )\n857|            if isCatalogStale(gen) { return }\n858|            let owned = await installer.loadOwnedGroupID(\n859|                serverHost: auth.identity.serverHost, org: verified.org, name: group.name\n860|            ) == group.id\n861|            let access = Runners.GroupAccess(\n862|                group: group, repoIDs: repoIDs.sorted(), updatedAt: now(),\n863|                owned: owned, loading: false\n864|            )\n865|            await action { Runners.Action.groupAccessLoaded(id, access) }\n866|        } catch is CancellationError {\n867|            return\n868|        } catch {\n869|            if !isCatalogStale(gen) {\n870|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n871|                await action { Runners.Action.groupAccessFailed(id, message) }\n872|            }\n873|        }\n874|    }\n875|\n876|    /// Applies edited repository access to the runner's fresh group. Rejects\n877|    /// stale UI (group moved since load), shared groups without explicit\n878|    /// takeover, and partial confirmations. Reuses the registration\n879|    /// ownership and confirmation gates; API-only, no installer lease.\n880|    private func applyGroupAccess(id: String, groupID: Int64, repos: Set<Int64>, allowTakeover: Bool) async {\n881|        let gen = catalogGeneration\n882|        await action { Runners.Action.groupAccessLoading(id) }\n883|        do {\n884|            let verified = try await verifiedOrgRunner(id: id)\n885|            let auth = try await currentUserToken()\n886|            if isCatalogStale(gen) { return }\n887|            // Fresh membership re-verified at write time: a move since the\n888|            // UI loaded fails instead of editing the wrong group.\n889|            let fresh = try await resolveFreshGroup(\n890|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n891|                auth: auth, generation: gen\n892|            )\n893|            guard fresh.id == groupID else {\n894|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n895|                    \"Runner moved from group \\(groupID) to '\\(fresh.name)' (\\(fresh.id)) since loading. Reload instead of editing a stale group.\"\n896|                )\n897|            }\n898|            if isCatalogStale(gen) { return }\n899|            let owned = await installer.loadOwnedGroupID(\n900|                serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name\n901|            )\n902|            try RunnerRegistration.Gates.authorizeGroupTakeover(\n903|                groupName: fresh.name, existingID: fresh.id,\n904|                ownedID: owned, allowTakeover: allowTakeover\n905|            )\n906|            if owned != fresh.id {\n907|                try await installer.saveOwnedGroupID(\n908|                    serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name, groupID: fresh.id\n909|                )\n910|            }\n911|            if isCatalogStale(gen) { return }\n912|            try await api.setGroupRepositories(\n913|                config: auth.config, token: auth.token, org: verified.org,\n914|                groupID: fresh.id, selectedRepositoryIDs: repos\n915|            )\n916|            if isCatalogStale(gen) { return }\n917|            let confirmed = try await api.fetchGroupRepositories(\n918|                config: auth.config, token: auth.token, org: verified.org, groupID: fresh.id\n919|            )\n920|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: repos, confirmed: confirmed)\n921|            if isCatalogStale(gen) { return }\n922|            let access = Runners.GroupAccess(\n923|                group: fresh, repoIDs: confirmed.sorted(), updatedAt: now(),\n924|                owned: true, loading: false\n925|            )\n926|            await action { Runners.Action.groupAccessLoaded(id, access) }\n927|            await action { Runners.Action.catalogCleared }\n928|        } catch is CancellationError {\n929|            return\n930|        } catch {\n931|            if !isCatalogStale(gen) {\n932|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n933|                await action { Runners.Action.groupAccessFailed(id, message) }\n934|            }\n935|        }\n936|    }\n937|}\n938|\n939|/// Import gates. Each gate refuses a concrete invalid class; negative tests\n940|/// narrow every one of them.\n941|public enum RunnersCatalogGates {\n942|    public static func validateImportable(_ candidate: RunnerDiscovery.Candidate) throws {\n943|        if candidate.controllerKind == .unsupported || candidate.unsupportedReason != nil {\n944|            throw RunnerError.unsupported(candidate.unsupportedReason ?? \"Unsupported management.\")\n945|        }\n946|        if !candidate.registrationReadable {\n947|            throw RunnerError.message(\"Cannot read .runner registration.\")\n948|        }\n949|        if candidate.agentName == nil || candidate.agentName?.isEmpty == true {\n950|            throw RunnerError.message(\"Registration name is missing.\")\n951|        }\n952|        if candidate.serverHost == nil || candidate.scope == nil {\n953|            throw RunnerError.message(\"Server or scope is undefined.\")\n954|        }\n955|        if !candidate.noSpacePath || !candidate.noSpaceWork {\n956|            throw RunnerError.noSpacePath(\"Path or work folder contains a space; relocation is required.\")\n957|        }\n958|        if !candidate.runsvcExists || !candidate.binaryExists {\n959|            throw RunnerError.message(\"Runner binaries are missing (run.sh / runsvc.sh).\")\n960|        }\n961|        if candidate.manifest == nil {\n962|            // Folder imports without a manifest create a service; every other\n963|            // check above must already have passed.\n964|            return\n965|        }\n966|        if !candidate.manifestMatches {\n967|            throw RunnerError.manifestMismatch(\"Service manifest does not match the runner directory.\")\n968|        }\n969|        if !candidate.issues.isEmpty {\n970|            // Issues beyond the manifest notice (folder imports) refuse.\n971|            let blocking = candidate.issues.filter { !$0.contains(\"No service manifest\") }\n972|            if !blocking.isEmpty {\n973|                throw RunnerError.message(blocking.joined(separator: \" \"))\n974|            }\n975|        }\n976|    }\n977|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
