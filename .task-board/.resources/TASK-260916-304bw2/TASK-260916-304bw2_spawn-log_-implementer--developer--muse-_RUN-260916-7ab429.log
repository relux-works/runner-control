{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9d3","stream":{"kind":"session","id":"01a0a986-16d4-7923-b79d-f784beb66015"},"sequence":836,"recorded_at":1780531400001667,"record_type":"event","durability":"durable","causation_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","run_stream":{"kind":"run","id":"f870b610-f41f-4227-a805-61cb8ebcb67d"},"task_stream":{"kind":"task","id":"01a0a987-dc83-72c2-8139-fa2b73a00f13"},"task_id":"01a0a987-dc83-72c2-8139-fa2b73a00f13","event":{"kind":"output","task_id":"01a0a987-dc83-72c2-8139-fa2b73a00f13","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n(419 line(s) above)\n420|    private func ownershipFile() -> URL {\n421|        installRoot.appendingPathComponent(Self.ownershipFileName)\n422|    }\n423|\n424|    private static func ownershipKey(serverHost: String, org: String, name: String) -> String {\n425|        \"\\(RunnerRegistration.OperationIdentity.normalizeServerHost(serverHost))\\u{0}\\(org.lowercased())\\u{0}\\(name)\"\n426|    }\n427|\n428|    /// Returns the locally recorded dedicated-group ID for\n429|    /// `server` + `org` + `name`, or nil when this Mac never created (or\n430|    /// took over) that group on that server. Name matches on GitHub alone\n431|    /// never count as ownership, and ownership on one server never\n432|    /// authorizes adoption on another.\n433|    public func loadOwnedGroupID(serverHost: String, org: String, name: String) -> Int64? {\n434|        guard let data = try? Data(contentsOf: ownershipFile()),\n435|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n436|        return table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)]\n437|    }\n438|\n439|    public func saveOwnedGroupID(serverHost: String, org: String, name: String, groupID: Int64) throws {\n440|        let file = ownershipFile()\n441|        var table: [String: Int64] = [:]\n442|        if let data = try? Data(contentsOf: file),\n443|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n444|            table = decoded\n445|        }\n446|        table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)] = groupID\n447|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n448|        let data = try JSONEncoder().encode(table)\n449|        try data.write(to: file, options: .atomic)\n450|    }\n451|\n452|    /// Reads the local `.runner` identity without touching credentials.\n453|    /// Returns nil only when the file is missing or unparseable; a present\n454|    /// but incomplete file returns a partial struct so verification can name\n455|    /// the exact missing field instead of crashing.\n456|    public func readLocalRegistration(directory: URL) -> RunnerRegistration.LocalRegistration? {\n457|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n458|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n459|        var agentID: Int64?\n460|        if let id = object[\"agentId\"] as? Int64 { agentID = id }\n461|        else if let id = object[\"agentId\"] as? Int { agentID = Int64(id) }\n462|        else if let id = object[\"agentId\"] as? NSNumber { agentID = id.int64Value }\n463|        return RunnerRegistration.LocalRegistration(\n464|            agentID: agentID,\n465|            agentName: object[\"agentName\"] as? String,\n466|            gitHubURL: object[\"gitHubUrl\"] as? String,\n467|            workFolder: object[\"workFolder\"] as? String\n468|        )\n469|    }\n470|\n471|    /// Reads the local agent ID from `.runner` without touching credentials.\n472|    public func readAgentID(directory: URL) -> Int64? {\n473|        readLocalRegistration(directory: directory)?.agentID\n474|    }\n475|\n476|    // MARK: - Manual LaunchAgent\n477|\n478|    /// Writes the manual service plist (RunAtLoad off for new runners) and\n479|    /// validates it matches the directory. Never bootstraps the service:\n480|    /// enabling is the user's separate action.\n481|    @discardableResult\n482|    public func setupService(directory: URL, label: String) throws -> URL {\n483|        guard !directory.path.contains(\" \") else {\n484|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n485|        }\n486|        // Never rewrite the service while the installer lease is held by a\n487|        // live install/config; the caller retries after that operation\n488|        // settles.\n489|        try requireIdleInstaller(directory)\n490|        let files = FileManager.default\n491|        guard files.fileExists(atPath: directory.appendingPathComponent(\"runsvc.sh\").path) else {\n492|            throw RunnerRegistration.RegistrationError.network(\n493|                \"runsvc.sh is missing; reinstall before setting up the service.\"\n494|            )\n495|        }\n496|        let plist = directory.appendingPathComponent(\"manual-service.plist\")\n497|        let payload: [String: Any] = [\n498|            \"Label\": label,\n499|            \"ProgramArguments\": [directory.appendingPathComponent(\"runsvc.sh\").path],\n500|            \"WorkingDirectory\": directory.path,\n501|            \"RunAtLoad\": false\n502|        ]\n503|        let data = try PropertyListSerialization.data(fromPropertyList: payload, format: .xml, options: 0)\n504|        try data.write(to: plist, options: .atomic)\n505|        let scopeKey = loadMarker(directory: directory)?.scopeKey ?? \"\"\n506|        try markCompleted(Self.stepServiceReady, directory: directory, scopeKey: scopeKey)\n507|        return plist\n508|    }\n509|\n510|    /// Removes a failed partial install so retries start clean. Refuses to\n511|    /// touch directories that already hold a registration (`.runner`) or an\n512|    /// unknown marker scope: recovery never deletes a working runner.\n513|    public func recoverPartialInstall(directory: URL, scopeKey: String) throws {\n514|        let files = FileManager.default\n515|        guard files.fileExists(atPath: directory.path) else { return }\n516|        // Never delete while the installer lease is held by a live\n517|        // operation; the caller retries after that operation settles.\n518|        try requireIdleInstaller(directory)\n519|        guard !files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n520|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: directory.lastPathComponent)\n521|        }\n522|        if let marker = loadMarker(directory: directory), marker.scopeKey != scopeKey {\n523|            throw RunnerRegistration.RegistrationError.alreadyInstalled(path: directory.path)\n524|        }\n525|        try files.removeItem(at: directory)\n526|    }\n527|\n528|    // MARK: - Catalog operations (shared lease)\n529|\n530|    /// Public idle check for catalog file mutations (RunAtLoad edits,\n531|    /// relink path updates). Refuses while ANY installer mutation is live,\n532|    /// for ANY directory. Retry after the owner settles.\n533|    public func requireIdle(for directory: URL) throws {\n534|        try requireIdleInstaller(directory)\n535|    }\n536|\n537|    /// Runs the exact `config.sh remove` invocation to unregister a runner\n538|    /// from GitHub. Holds the app-wide installer lease across the process so\n539|    /// no registration, install, recovery or second unregister can overlap,\n540|    /// including alias spellings of the same directory. Never deletes the\n541|    /// working directory or the service manifest: files stay for re-registration\n542|    /// or explicit file deletion. The remove token is scrubbed from errors.\n543|    public func unregister(directory: URL, removeToken: String) async throws {\n544|        let lease = try acquireMutationLease(for: directory)\n545|        defer { releaseMutationLease(lease) }\n546|        let files = FileManager.default\n547|        let executable = directory.appendingPathComponent(\"config.sh\").path\n548|        guard files.fileExists(atPath: executable) else {\n549|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n550|        }\n551|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n552|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n553|                \"No local registration at '\\(directory.path)'. Nothing to unregister.\"\n554|            )\n555|        }\n556|        let result = try await executor.run(executable, [\"remove\", \"--token\", removeToken, \"--unattended\"])\n557|        guard result.code == 0 else {\n558|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [removeToken])\n559|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n560|        }\n561|    }\n562|\n563|    /// Updates an existing service manifest to a new directory after the user\n564|    /// explicitly relinks a moved folder. Preserves every other key,\n565|    /// including the imported RunAtLoad policy. Refuses while the installer\n566|    /// lease is held by a live mutation.\n567|    public func updateServicePaths(plist: URL, directory: URL) throws {\n568|        guard !directory.path.contains(\" \") else {\n569|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n(more lines below)","final_result":true}}}
