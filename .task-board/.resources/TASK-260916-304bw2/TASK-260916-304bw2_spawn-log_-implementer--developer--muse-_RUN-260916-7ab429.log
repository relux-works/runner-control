{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c925","stream":{"kind":"session","id":"01a0a986-16d4-7923-b79d-f784beb66015"},"sequence":749,"recorded_at":1780531400001493,"record_type":"event","durability":"durable","causation_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","run_stream":{"kind":"run","id":"f870b610-f41f-4227-a805-61cb8ebcb67d"},"task_stream":{"kind":"task","id":"01a0a987-aa08-7931-bbe3-a5737d06f585"},"task_id":"01a0a987-aa08-7931-bbe3-a5737d06f585","event":{"kind":"output","task_id":"01a0a987-aa08-7931-bbe3-a5737d06f585","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n(616 line(s) above)\n617|@Test func removeDeletesOnlyEntryAndWarnsWhenRunning() async throws {\n618|    let harness = await catalogHarness(launchResults: [\n619|        CommandResult(code: 0, output: \"state = running\"),\n620|        CommandResult(code: 0, output: \"state = running\")\n621|    ])\n622|    defer { try? FileManager.default.removeItem(at: harness.home) }\n623|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", label: \"actions.runner.test.rm\")\n624|    let entry = RunnerCatalogStore.Entry(\n625|        directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n626|        serviceLabel: \"actions.runner.test.rm\",\n627|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n628|        controllerKind: .manualManaged, agentName: \"r\"\n629|    )\n630|    try await harness.catalog.add(entry)\n631|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.removeFromApp(\"actions.runner.test.rm\"))\n632|    #expect(await harness.catalog.load().isEmpty)\n633|    // Files, registration and manifest untouched.\n634|    #expect(FileManager.default.fileExists(atPath: dir.appendingPathComponent(\".runner\").path))\n635|    #expect(FileManager.default.fileExists(atPath: dir.appendingPathComponent(\"manual-service.plist\").path))\n636|    #expect(catalogErr(harness.logger).contains(\"keeps running\"))\n637|}\n638|\n639|// MARK: - Unregister binds local identity (AC row 11)\n640|\n641|private func unregisterEntry(dir: URL, label: String, agentID: Int64 = 42, agentName: String = \"r\") -> RunnerCatalogStore.Entry {\n642|    RunnerCatalogStore.Entry(\n643|        directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n644|        serviceLabel: label,\n645|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n646|        controllerKind: .manualManaged, serverHost: \"github.com\",\n647|        scopeKind: \"org\", scope: \"acme\", remoteAgentID: agentID, agentName: agentName, workFolder: \"_work\"\n648|    )\n649|}\n650|\n651|@Test func unregisterRefusesWrongConfirmationWithoutAPICall() async throws {\n652|    let harness = await catalogHarness(launchResults: [\n653|        CommandResult(code: 113, output: \"Could not find service x\")\n654|    ])\n655|    defer { try? FileManager.default.removeItem(at: harness.home) }\n656|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"my-runner\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.unreg\")\n657|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.unreg\", agentName: \"my-runner\"))\n658|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.unregister(\"actions.runner.test.unreg\", confirmation: \"wrong\"))\n659|    #expect(catalogErr(harness.logger).contains(\"Type 'my-runner'\"))\n660|    #expect(await harness.transport.requests.isEmpty)\n661|    #expect(await harness.installerExecutor.calls.isEmpty)\n662|}\n663|\n664|@Test func unregisterRefusesRunningService() async throws {\n665|    let harness = await catalogHarness(launchResults: [\n666|        CommandResult(code: 0, output: \"state = running\")\n667|    ])\n668|    defer { try? FileManager.default.removeItem(at: harness.home) }\n669|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", label: \"actions.runner.test.running\")\n670|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.running\"))\n671|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.unregister(\"actions.runner.test.running\", confirmation: \"r\"))\n672|    #expect(catalogErr(harness.logger).contains(\"Stop the runner first\"))\n673|    #expect(await harness.transport.requests.isEmpty)\n674|}\n675|\n676|@Test func unregisterRefusesNameWithoutVerifiedAgentID() async throws {\n677|    let harness = await catalogHarness()\n678|    defer { try? FileManager.default.removeItem(at: harness.home) }\n679|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", label: \"actions.runner.test.noname\")\n680|    // Strip the agent ID: a bare name must never authorize removal.\n681|    let config: [String: Any] = [\"agentName\": \"r\", \"gitHubUrl\": \"https://github.com/acme\", \"workFolder\": \"_work\"]\n682|    try JSONSerialization.data(withJSONObject: config).write(to: dir.appendingPathComponent(\".runner\"))\n683|    var entry = unregisterEntry(dir: dir, label: \"actions.runner.test.noname\")\n684|    entry.remoteAgentID = nil\n685|    try await harness.catalog.add(entry)\n686|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.unregister(\"actions.runner.test.noname\", confirmation: \"r\"))\n687|    #expect(catalogErr(harness.logger).contains(\"verified local registration\"))\n688|    #expect(await harness.transport.requests.isEmpty)\n689|}\n690|\n691|@Test func unregisterRefusesStoredIDMismatchAndCrossServer() async throws {\n692|    // Stored-vs-disk mismatch.\n693|    let mismatch = await catalogHarness()\n694|    defer { try? FileManager.default.removeItem(at: mismatch.home) }\n695|    let mismatchDir = try makeRunnerDir(parent: mismatch.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.mismatch\")\n696|    var entry = unregisterEntry(dir: mismatchDir, label: \"actions.runner.test.mismatch\")\n697|    entry.remoteAgentID = 99\n698|    try await mismatch.catalog.add(entry)\n699|    let _: Relux.ActionResult = await mismatch.flow.apply(Runners.Effect.unregister(\"actions.runner.test.mismatch\", confirmation: \"r\"))\n700|    #expect(catalogErr(mismatch.logger).contains(\"mismatched registration\"))\n701|    #expect(await mismatch.transport.requests.isEmpty)\n702|    // Cross-server: disk points at another host, auth is github.com.\n703|    let cross = await catalogHarness()\n704|    defer { try? FileManager.default.removeItem(at: cross.home) }\n705|    let crossDir = try makeRunnerDir(parent: cross.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.cross\")\n706|    let foreign: [String: Any] = [\"agentId\": 42, \"agentName\": \"r\", \"gitHubUrl\": \"https://ghe.example.com/acme\", \"workFolder\": \"_work\"]\n707|    try JSONSerialization.data(withJSONObject: foreign).write(to: crossDir.appendingPathComponent(\".runner\"))\n708|    // Need stopped status before the server check runs.\n709|    let stoppedHarness = await catalogHarness(launchResults: [CommandResult(code: 113, output: \"Could not find service x\")])\n710|    defer { try? FileManager.default.removeItem(at: stoppedHarness.home) }\n711|    // Reuse the cross dir files by copying .runner content into the stopped harness entry.\n712|    let stoppedDir = try makeRunnerDir(parent: stoppedHarness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.cross\")\n713|    try JSONSerialization.data(withJSONObject: foreign).write(to: stoppedDir.appendingPathComponent(\".runner\"))\n714|    try await stoppedHarness.catalog.add(unregisterEntry(dir: stoppedDir, label: \"actions.runner.test.cross\"))\n715|    let _: Relux.ActionResult = await stoppedHarness.flow.apply(Runners.Effect.unregister(\"actions.runner.test.cross\", confirmation: \"r\"))\n716|    #expect(catalogErr(stoppedHarness.logger).contains(\"not the signed-in server\"))\n717|}\n718|\n719|@Test func unregisterRemovesRemoteKeepsFilesAndEntry() async throws {\n720|    let harness = await catalogHarness(\n721|        launchResults: [\n722|            CommandResult(code: 113, output: \"Could not find service x\"),\n723|            CommandResult(code: 113, output: \"Could not find service x\")\n724|        ],\n725|        installerResults: [CommandResult(code: 0, output: \"remove ok\")],\n726|        transportResponses: [removeTokenPayload()]\n727|    )\n728|    defer { try? FileManager.default.removeItem(at: harness.home) }\n729|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.ok\")\n730|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.ok\"))\n731|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.unregister(\"actions.runner.test.ok\", confirmation: \"r\"))\n732|    #expect(lastCatalogFailure(harness.logger) == nil)\n733|    // Remove token minted for the verified scope, config.sh remove ran with it.\n734|    let requests = await harness.transport.requests\n735|    #expect(requests.count == 1)\n736|    #expect(requests.first?.url.path.contains(\"/orgs/acme/actions/runners/remove-token\") == true)\n737|    let installerCalls = await harness.installerExecutor.calls\n738|    #expect(installerCalls.count == 1)\n739|    #expect(installerCalls.first?.contains(\"remove\") == true)\n740|    // Token never leaks into the catalog or the success path.\n741|    let entries = await harness.catalog.load()\n742|    #expect(entries.count == 1)\n743|    #expect(entries.first?.remoteAgentID == nil)\n744|    #expect(FileManager.default.fileE