{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c86d","stream":{"kind":"session","id":"01a0a986-16d4-7923-b79d-f784beb66015"},"sequence":657,"recorded_at":1780531400001309,"record_type":"event","durability":"durable","causation_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","run_stream":{"kind":"run","id":"f870b610-f41f-4227-a805-61cb8ebcb67d"},"call_id":"call_01a0a9877b617730839e8b5d8c4f83fc","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n1|import Foundation\n2|import Testing\n3|import Relux\n4|@testable import RunnerControlCore\n5|\n6|// MARK: - Catalog lifecycle harness (production entry points, controlled IO)\n7|\n8|// TestTransport, jsonResponse, testConfig shared from GitHubTransportTests.\n9|// FakeExecutor, stopped, running shared from RunnerControlCoreTests.\n10|\n11|private struct CatalogHarness {\n12|    let flow: Runners.Flow\n13|    let logger: Relux.Testing.Logger\n14|    let transport: TestTransport\n15|    let launchExecutor: FakeExecutor\n16|    let installerExecutor: FakeExecutor\n17|    let userStore: GitHubKeychainStore\n18|    let identities: InMemoryGitHubSessionIdentityStore\n19|    let installer: RunnerInstallerService\n20|    let catalog: RunnerCatalogStore\n21|    let service: LaunchAgentService\n22|    let home: URL\n23|    let catalogFile: URL\n24|}\n25|\n26|private func catalogHarness(\n27|    launchResults: [CommandResult] = [],\n28|    installerResults: [CommandResult] = [],\n29|    transportResponses: [GitHubHTTPResponse] = [],\n30|    seedAuth: Bool = true\n31|) async -> CatalogHarness {\n32|    let logger = Relux.Testing.Logger()\n33|    let dispatcher = Relux.Dispatcher(logger: logger)\n34|    let launchExecutor = FakeExecutor(launchResults)\n35|    let installerExecutor = FakeExecutor(installerResults)\n36|    let transport = TestTransport(transportResponses)\n37|    let userStore = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n38|    let identities = InMemoryGitHubSessionIdentityStore()\n39|    if seedAuth {\n40|        await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n41|        try? await userStore.save(\n42|            GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n43|            serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n44|        )\n45|    }\n46|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"CatalogHome-\" + UUID().uuidString)\n47|    try? FileManager.default.createDirectory(at: home, withIntermediateDirectories: true)\n48|    let catalogFile = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n49|    let catalog = RunnerCatalogStore(fileURL: catalogFile)\n50|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n51|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n52|    let installer = RunnerInstallerService(installRoot: installRoot, executor: installerExecutor)\n53|    let service = LaunchAgentService(catalog: catalog, executor: launchExecutor, userID: 501, home: home)\n54|    let api = GitHubRunnerAPIClient(transport: transport)\n55|    let refresher = GitHubTokenRefresh(transport: transport, store: userStore)\n56|    let flow = await Runners.Flow(\n57|        service: service, catalog: catalog, installer: installer,\n58|        api: api, userStore: userStore, identities: identities,\n59|        refresher: refresher, configProvider: { _ in testConfig },\n60|        home: home, dispatcher: dispatcher\n61|    )\n62|    return CatalogHarness(\n63|        flow: flow, logger: logger, transport: transport,\n64|        launchExecutor: launchExecutor, installerExecutor: installerExecutor,\n65|        userStore: userStore, identities: identities,\n66|        installer: installer, catalog: catalog, service: service,\n67|        home: home, catalogFile: catalogFile\n68|    )\n69|}\n70|\n71|private func runnersActions(_ logger: Relux.Testing.Logger) -> [Runners.Action] {\n72|    logger.actions.compactMap { $0 as? Runners.Action }\n73|}\n74|\n75|private func lastCatalogFailure(_ logger: Relux.Testing.Logger) -> String? {\n76|    for action in runnersActions(logger).reversed() {\n77|        if case .catalogFailed(let message) = action { return message }\n78|    }\n79|    return nil\n80|}\n81|\n82|\n83|private func catalogErr(_ logger: Relux.Testing.Logger) -> String {\n84|    lastCatalogFailure(logger) ?? \"\"\n85|}\n86|\n87|private func failErr(_ logger: Relux.Testing.Logger) -> String {\n88|    lastFailureMessage(logger) ?? \"\"\n89|}\n90|\n91|private func lastFailureMessage(_ logger: Relux.Testing.Logger) -> String? {\n92|    for action in runnersActions(logger).reversed() {\n93|        if case .failed(let message) = action { return message }\n94|    }\n95|    return nil\n96|}\n97|\n98|/// Creates a runner directory with `.runner`, `runsvc.sh`, `run.sh` and an\n99|/// optional manual-service plist. Returns the directory.\n100|@discardableResult\n101|private func makeRunnerDir(\n102|    parent: URL, name: String,\n103|    agentName: String = \"test-runner\", scope: String = \"acme/app\",\n104|    agentID: Int64 = 42, workFolder: String = \"_work\",\n105|    runAtLoad: Bool? = true, withPlist: Bool = true,\n106|    label: String? = nil\n107|) throws -> URL {\n108|    let dir = parent.appendingPathComponent(name)\n109|    try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)\n110|    let config: [String: Any] = [\n111|        \"agentId\": agentID, \"agentName\": agentName,\n112|        \"gitHubUrl\": \"https://github.com/\" + scope, \"workFolder\": workFolder\n113|    ]\n114|    try JSONSerialization.data(withJSONObject: config).write(to: dir.appendingPathComponent(\".runner\"))\n115|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"runsvc.sh\"), atomically: true, encoding: .utf8)\n116|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n117|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n118|    if withPlist {\n119|        let resolvedLabel = label ?? \"actions.runner.test.\\(name)\"\n120|        var plist: [String: Any] = [\n121|            \"Label\": resolvedLabel,\n122|            \"ProgramArguments\": [dir.appendingPathComponent(\"runsvc.sh\").path],\n123|            \"WorkingDirectory\": dir.path\n124|        ]\n125|        if let runAtLoad { plist[\"RunAtLoad\"] = runAtLoad }\n126|        try PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0)\n127|            .write(to: dir.appendingPathComponent(\"manual-service.plist\"))\n128|    }\n129|    return dir\n130|}\n131|\n132|private func runnersListPayload(_ runners: [[String: Any]]) -> GitHubHTTPResponse {\n133|    jsonResponse([\"runners\": runners])\n134|}\n135|\n136|private func removeTokenPayload(token: String = \"remove-token-1\") -> GitHubHTTPResponse {\n137|    jsonResponse([\"token\": token, \"expires_at\": \"2030-01-01T00:00:00Z\"])\n138|}\n139|\n140|// MARK: - Catalog persistence and dedupe (AC rows 1, 3)\n141|\n142|@Test func catalogPersistsAndDedupesCanonicalViaSymlink() async throws {\n143|    let file = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n144|    defer { try? FileManager.default.removeItem(at: file) }\n145|    let store = RunnerCatalogStore(fileURL: file)\n146|    let root = FileManager.default.temporaryDirectory.appendingPathComponent(\"Dedupe-\" + UUID().uuidString)\n147|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n148|    defer { try? FileManager.default.removeItem(at: root) }\n149|    let dir = try makeRunnerDir(parent: root, name: \"runner-a\")\n150|    let canonical = RunnerCatalogStore.canonical(dir)\n151|    let entry = RunnerCatalogStore.Entry(\n152|        directoryPath: dir.path, canonicalPath: canonical,\n153|        serviceLabel: \"actions.runner.test.a\",\n154|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n155|        controllerKind: .manualManaged, runAtLoad: true,\n156|        serverHost: \"github.com\", scopeKind: \"repo\", scope: \"acme/app\",\n157|        remoteAgentID: 42, agentName: \"runner\", workFolder: \"_work\"\n158|    )\n159|    try await store.add(entry)\n160|    #expect(await store.load().count == 1)\n161|    // Same directory via a symlink spelling must be refused.\n162|    let link = root.appendingPathComponent(\"link-a\")\n163|    try FileManager.default.createSymbolicLink(at: link, withDestinationURL: dir)\n164|    let alias = RunnerCatalogStore.Entry(\n165|        directoryPath: link.path, canonicalPath: RunnerCatalogStore.canonical(link),\n166|        serviceLabel: \"actions.runner.test.alias\",\n167|        servicePlistPath: link.appendingPathComponent(\"manual-service.plist\").path,\n168|        controllerKind: .manualManaged\n169|    )\n170|    do {\n171|        try await store.add(alias)\n172|        Issue.record(\"Catalog admitted the same directory twice via symlink\")\n173|    } catch let error as RunnerCatalogStore.CatalogError {\n174|        guard case .duplicateDirectory = error else {\n175|            Issue.record(\"Wrong dedupe error: \\(error)\"); return\n176|        }\n177|    }\n178|    #expect(await store.load().count == 1)\n179|}\n180|\n181|@Test func catalogKeepsSameNameDifferentScopesAsTwoRunners() async throws {\n182|    let file = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n183|    defer { try? FileManager.default.removeItem(at: file) }\n184|    let store = RunnerCatalogStore(fileURL: file)\n185|    let root = FileManager.default.temporaryDirectory.appendingPathComponent(\"Scopes-\" + UUID().uuidString)\n186|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n187|    defer { try? FileManager.default.removeItem(at: root) }\n188|    let orgDir = try makeRunnerDir(parent: root, name: \"org-runner\", agentName: \"mac\", scope: \"acme\", agentID: 1)\n189|    let repoDir = try makeRunnerDir(parent: root, name: \"repo-runner\", agentName: \"mac\", scope: \"acme/app\", agentID: 2)\n190|    for (dir, label, kind, scope) in [\n191|        (orgDir, \"actions.runner.test.org\", \"org\", \"acme\"),\n192|        (repoDir, \"actions.runner.test.repo\", \"repo\", \"acme/app\")\n193|    ] {\n194|        let entry = RunnerCatalogStore.Entry(\n195|            directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n196|            serviceLabel: label,\n197|            servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n198|            controllerKind: .manualManaged, serverHost: \"github.com\",\n199|            scopeKind: kind, scope: scope, agentName: \"mac\"\n200|        )\n201|        try await store.add(entry)\n202|    }\n203|    let loaded = await store.load()\n204|    #expect(loaded.count == 2)\n205|    #expect(Set(loaded.map(\\.scope)) == [\"acme\", \"acme/app\"])\n206|}\n207|\n208|// MARK: - Migration preserves production (AC rows 12, 13)\n209|\n210|@Test func migrationPreservesPoliciesWithoutTouchingServices() async throws {\n211|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"MigHome-\" + UUID().uuidString)\n212|    defer { try? FileManager.default.removeItem(at: home) }\n213|    let root = home.appendingPathComponent(\"Library/GitHubActions\")\n214|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n215|    let a = try makeRunnerDir(parent: root, name: \"a\", agentName: \"mac\", scope: \"acme\", agentID: 11, runAtLoad: true, label: \"actions.runner.test.a\")\n216|    let b = try makeRunnerDir(parent: root, name: \"b\", agentName: \"mac\", scope: \"acme/app\", agentID: 22, runAtLoad: false, label: \"actions.runner.test.b\")\n217|    try \"#!/bin/sh\\nexit 0\\n\".write(to: a.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n218|    try \"#!/bin/sh\\nexit 0\\n\".write(to: b.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n219|    let beforeA = try Data(contentsOf: a.appendingPathComponent(\"manual-service.plist\"))\n220|    let beforeB = try Data(contentsOf: b.appendingPathComponent(\"manual-service.plist\"))\n221|    let file = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n222|    defer { try? FileManager.default.removeItem(at: file) }\n223|    let store = RunnerCatalogStore(fileURL: file)\n224|    let migrated = try await store.migrateIfNeeded(home: home)\n225|    #expect(migrated.count == 2)\n226|    #expect(Set(migrated.map(\\.serviceLabel)) == [\"actions.runner.test.a\", \"actions.runner.test.b\"])\n227|    #expect(migrated.first { $0.serviceLabel == \"actions.runner.test.a\" }?.runAtLoad == true)\n228|    #expect(migrated.first { $0.serviceLabel == \"actions.runner.test.b\" }?.runAtLoad == false)\n229|    #expect(migrated.first { $0.serviceLabel == \"actions.runner.test.a\" }?.scope == \"acme\")\n230|    #expect(migrated.first { $0.serviceLabel == \"actions.runner.test.b\" }?.scope == \"acme/app\")\n231|    // Services untouched: byte-identical plists, no relaunch.\n232|    #expect(try Data(contentsOf: a.appendingPathComponent(\"manual-service.plist\")) == beforeA)\n233|    #expect(try Data(contentsOf: b.appendingPathComponent(\"manual-service.plist\")) == beforeB)\n234|    // Second migration is a no-op (no duplicates).\n235|    let again = try await store.migrateIfNeeded(home: home)\n236|    #expect(again.count == 2)\n237|}\n238|\n239|// MARK: - Discovery candidates (AC row 2)\n240|\n241|@Test func discoveryFindsManualAndStandardWithoutLaunching() throws {\n242|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"DiscHome-\" + UUID().uuidString)\n243|    defer { try? FileManager.default.removeItem(at: home) }\n244|    let fm = FileManager.default\n245|    let agents = home.appendingPathComponent(\"Library/LaunchAgents\")\n246|    let root = home.appendingPathComponent(\"Library/GitHubActions\")\n247|    try fm.createDirectory(at: agents, withIntermediateDirectories: true)\n248|    try fm.createDirectory(at: root, withIntermediateDirectories: true)\n249|    let manual = try makeRunnerDir(parent: root, name: \"manual\", agentName: \"mac\", scope: \"acme/app\", label: \"actions.runner.test.manual\")\n250|    let custom = home.appendingPathComponent(\"custom-install\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
