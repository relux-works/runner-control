try await h.catalog.migrateIfNeeded(home: h.home)\n17|    #expect(entries.count == 1)\n18|    _ = try await h.catalog.remove(localID: entries[0].localID)\n19|    #expect(await h.catalog.load().isEmpty)\n20|    #expect(try await h.catalog.migrateIfNeeded(home: h.home).isEmpty)\n21|}\n22|\n23|@Test func reviewSameNameFolderImportsMustHaveDistinctServiceIDs() async throws {\n24|    let h = await catalogHarness()\n25|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n26|    let a = try makeRunnerDir(parent: h.home, name: \"a\", agentName: \"same\", scope: \"acme/a\", withPlist: false)\n27|    let b = try makeRunnerDir(parent: h.home, name: \"b\", agentName: \"same\", scope: \"acme/b\", withPlist: false)\n28|    _ = await h.flow.apply(Runners.Effect.importFolder(a))\n29|    _ = await h.flow.apply(Runners.Effect.importFolder(b))\n30|    let entries = await h.catalog.load()\n31|    #expect(entries.count == 2)\n32|    #expect(Set(entries.map(\\.serviceLabel)).count == 2)\n33|}\n34|\n35|@Test func reviewCrossServerGroupApplyMustRefuse() async throws {\n36|    let h = await catalogHarness(transportResponses: [groupsPayload([(4, \"g\")]), groupRunnersPayload([(42,\"r\",false)]), .init(status:204,body:Data()), groupReposPayload([1])])\n37|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n38|    let d = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", label: \"actions.runner.review.cross\")\n39|    let foreign: [String: Any] = [\"agentId\":42,\"agentName\":\"r\",\"gitHubUrl\":\"https://ghe.example.com/acme\",\"workFolder\":\"_work\"]\n40|    try JSONSerialization.data(withJSONObject:foreign).write(to:d.appendingPathComponent(\".runner\"))\n41|    var entry = unregisterEntry(dir:d,label:\"actions.runner.review.cross\")\n42|    entry.serverHost = \"ghe.example.com\"\n43|    try await h.catalog.add(entry)\n44|    _ = await h.flow.apply(Runners.Effect.applyGroupAccess(\"actions.runner.review.cross\",groupID:4,repositories:[1],allowTakeover:true))\n45|    #expect(await h.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n46|    #expect(loadedGroupAccess(h.logger,id:\"actions.runner.review.cross\") == nil)\n47|}","final_result":true}}}
