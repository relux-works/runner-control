{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb49","stream":{"kind":"session","id":"01a0a986-16d4-7923-b79d-f784beb66015"},"sequence":1023,"recorded_at":1780531400002041,"record_type":"event","durability":"durable","causation_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","run_stream":{"kind":"run","id":"f870b610-f41f-4227-a805-61cb8ebcb67d"},"task_stream":{"kind":"task","id":"01a0a98c-bda8-7921-8834-cfaebba175db"},"task_id":"01a0a98c-bda8-7921-8834-cfaebba175db","event":{"kind":"output","task_id":"01a0a98c-bda8-7921-8834-cfaebba175db","chunk":"{\n  \"chunk_id\": \"exec-22-1\",\n  \"command\": \"sed -n '466,508p' Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift\\necho \\\"===bulk check done===\\\"\\ngrep -n \\\"serviceLabel:\\\" Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift | head -n 40\",\n  \"description\": \"Verify multi-entry tests use distinct labels\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"@Test func bulkPowerReportsPartialFailuresPerRow() async throws {\\n    let root = FileManager.default.temporaryDirectory.appendingPathComponent(\\\"Bulk-\\\" + UUID().uuidString)\\n    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\\n    defer { try? FileManager.default.removeItem(at: root) }\\n    let good = try makeRunnerDir(parent: root, name: \\\"good\\\", label: \\\"actions.runner.test.good\\\")\\n    let bad = try makeRunnerDir(parent: root, name: \\\"bad\\\", label: \\\"actions.runner.test.bad\\\")\\n    // Break the bad manifest so its start is refused without launchctl.\\n    let badPlist = bad.appendingPathComponent(\\\"manual-service.plist\\\")\\n    let broken: [String: Any] = [\\\"Label\\\": \\\"actions.runner.test.bad\\\", \\\"WorkingDirectory\\\": \\\"/elsewhere\\\", \\\"ProgramArgument