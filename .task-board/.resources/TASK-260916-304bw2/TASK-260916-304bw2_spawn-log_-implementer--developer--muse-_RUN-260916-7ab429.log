{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7fb","stream":{"kind":"session","id":"01a0a986-16d4-7923-b79d-f784beb66015"},"sequence":600,"recorded_at":1780531400001195,"record_type":"event","durability":"durable","causation_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f870b610-f41f-4227-a805-61cb8ebcb67d","run_stream":{"kind":"run","id":"f870b610-f41f-4227-a805-61cb8ebcb67d"},"task_stream":{"kind":"task","id":"01a0a987-697d-7b90-880d-b8bee393bf64"},"task_id":"01a0a987-697d-7b90-880d-b8bee393bf64","event":{"kind":"output","task_id":"01a0a987-697d-7b90-880d-b8bee393bf64","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n(647 line(s) above)\n648|        let entries = await catalog.load()\n649|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n650|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n651|            return\n652|        }\n653|        let trimmed = alias?.trimmingCharacters(in: .whitespacesAndNewlines)\n654|        entry.displayName = (trimmed?.isEmpty == true) ? nil : trimmed\n655|        do {\n656|            try await catalog.update(entry)\n657|            await action { Runners.Action.catalogCleared }\n658|            let snapshots = await service.snapshots()\n659|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n660|            await action { Runners.Action.refreshed(mapped_snapshots) }\n661|        } catch {\n662|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n663|        }\n664|    }\n665|\n666|    /// Relinks a moved folder. Requires the new folder to hold the same\n667|    /// agent ID so a foreign installation can never steal this entry.\n668|    /// Updates the service manifest paths, preserving RunAtLoad.\n669|    private func relink(id: String, url: URL) async {\n670|        if unregisterWorking.contains(id) || working.contains(id) {\n671|            await action { Runners.Action.catalogFailed(\"Runner is busy; retry after it settles.\") }\n672|            return\n673|        }\n674|        let entries = await catalog.load()\n675|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n676|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n677|            return\n678|        }\n679|        guard url.path != entry.directoryPath else {\n680|            await action { Runners.Action.catalogCleared }\n681|            return\n682|        }\n683|        if url.path.contains(\" \") {\n684|            await action { Runners.Action.catalogFailed(\"Path contains a space; choose a location without spaces.\") }\n685|            return\n686|        }\n687|        let canonical = RunnerCatalogStore.canonical(url)\n688|        if entries.contains(where: { $0.localID != entry.localID && $0.canonicalPath == canonical }) {\n689|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.duplicateDirectory(path: url.path).localizedDescription) }\n690|            return\n691|        }\n692|        guard let info = RunnerRegistrationReader.read(directory: url) else {\n693|            await action { Runners.Action.catalogFailed(\"Cannot read .runner in the selected folder.\") }\n694|            return\n695|        }\n696|        if let stored = entry.remoteAgentID, info.agentID != stored {\n697|            await action { Runners.Action.catalogFailed(\"Selected folder is agent \\(info.agentID.map(String.init) ?? \"unknown\"), not \\(stored). Refusing to relink a foreign installation.\") }\n698|            return\n699|        }\n700|        catalogGeneration += 1\n701|        do {\n702|            let plist = URL(fileURLWithPath: entry.servicePlistPath)\n703|            // Manual manifests move with the directory; standard manifests\n704|            // stay in LaunchAgents. Update whichever manifest this entry owns.\n705|            if plist.path.hasPrefix(entry.directoryPath) {\n706|                let moved = url.appendingPathComponent(\"manual-service.plist\")\n707|                if FileManager.default.fileExists(atPath: moved.path) {\n708|                    try await installer.updateServicePaths(plist: moved, directory: url)\n709|                    entry.servicePlistPath = moved.path\n710|                }\n711|            } else {\n712|                try await installer.updateServicePaths(plist: plist, directory: url)\n713|            }\n714|            let oldPath = entry.directoryPath\n715|            entry.directoryPath = url.path\n716|            entry.canonicalPath = canonical\n717|            entry.bookmarkBase64 = RunnerCatalogStore.bookmark(for: url)\n718|            entry.agentName = info.agentName ?? entry.agentName\n719|            entry.serverHost = info.serverHost ?? entry.serverHost\n720|            entry.scope = info.scopeDetail ?? entry.scope\n721|            entry.scopeKind = info.scopeKind ?? entry.scopeKind\n722|            entry.remoteAgentID = info.agentID ?? entry.remoteAgentID\n723|            entry.workFolder = info.workFolder ?? entry.workFolder\n724|            // Keep a managed login registration pointing at the new\n725|            // directory so relink preserves effective login. Foreign\n726|            // same-label plists are never touched.\n727|            if entry.controllerKind == .manualManaged {\n728|                let copy = RunnerControllers.loginRegistrationURL(label: entry.serviceLabel, home: home)\n729|                if let data = try? Data(contentsOf: copy),\n730|                   var current = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],\n731|                   current[\"Label\"] as? String == entry.serviceLabel,\n732|                   current[\"WorkingDirectory\"] as? String == oldPath {\n733|                    try await installer.requireIdle(for: url)\n734|                    current[\"WorkingDirectory\"] = url.path\n735|                    current[\"ProgramArguments\"] = [url.appendingPathComponent(\"runsvc.sh\").path]\n736|                    let out = try PropertyListSerialization.data(fromPropertyList: current, format: .xml, options: 0)\n737|                    try out.write(to: copy, options: .atomic)\n738|                }\n739|            }\n740|            try await catalog.update(entry)\n741|            await action { Runners.Action.catalogCleared }\n742|            let snapshots = await service.snapshots()\n743|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n744|            await action { Runners.Action.refreshed(mapped_snapshots) }\n745|        } catch {\n746|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n747|        }\n748|    }\n749|\n750|    // MARK: - Diagnostics\n751|\n752|    private func loadLog(id: String) async {\n753|        let snapshots = await service.snapshots()\n754|        guard let snapshot = snapshots.first(where: { $0.id == id }) else {\n755|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n756|            return\n757|        }\n758|        let excerpt = RunnerDiagnostics.tail(definition: snapshot.definition)\n759|        await action { Runners.Action.logLoaded(title: snapshot.definition.displayTitle, excerpt: excerpt) }\n760|    }\n761|\n762|    // MARK: - Group access (fresh API membership)\n763|\n764|    private struct VerifiedOrgRunner: Sendable {\n765|        let entry: RunnerCatalogStore.Entry\n766|        let directory: URL\n767|        let org: String\n768|        let agentID: Int64\n769|        let agentName: String\n770|    }\n771|\n772|    /// Verifies the local `.runner` identity for group reads/writes: agent\n773|    /// ID, name, server and org scope must all be present and bound to the\n774|    /// catalog entry. Local pool fields are ignored (they can lag); the\n775|    /// group answer always comes from fresh API membership below.\n776|    private func verifiedOrgRunner(id: String) async throws -> VerifiedOrgRunner {\n777|        let entries = await catalog.load()\n778|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n779|            throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n780|        }\n781|        let directory = RunnerCatalogStore.resolve(entry: entry)\n782|        guard let local = await installer.readLocalRegistration(directory: directory),\n783|              let agentID = local.agentID,\n784|              let agentName = local.agentName, !agentName.isEmpty,\n785|              let address = local.gitHubURL,\n786|              let url = URL(string: address), url.scheme == \"https\" else {\n787|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n788|                \"No verified local registration for '\\(entry.serviceLabel)'. Refusing group access for another runner.\"\n789|            )\n790|        }\n791|        let components = url.pathComponents.filter { $0 != \"/\" }\n792|        guard components.count == 1 else {\n793|            throw RunnerRegistration.RegistrationError.groupNotApplicable\n794|        }\n795|        if let stored = entry.remoteAgentID, stored != agentID {\n796|            throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n797|                \"Catalog expects agent \\(stored) but disk shows agent \\(agentID). Refusing group access for a mismatched registration.\"\n798|            )\n799|        }\n800|        return VerifiedOrgRunner(entry: entry, directory: directory, org: components[0], agentID: agentID, agentName: agentName)\n801|    }\n802|\n803|    /// Resolves the runner's current GitHub group by fresh API membership:\n804|    /// lists every group, then each group's runners, matching by agent ID\n805|    /// (and exact name on the matched ID). Never reads `.runner` pool\n806|    /// fields and never adopts a same-name foreign runner or group.\n807|    private func resolveFreshGroup(\n808|        org: String, agentID: Int64, agentName: String,\n809|        auth: CatalogUserToken, generation gen: Int\n810|    ) async throws -> RunnerRegistration.RunnerGroup {\n811|        let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n812|        for group in groups {\n813|            if isCatalogStale(gen) { throw CancellationError() }\n814|            let members = try await api.fetchGroupRunners(config: auth.config, token: auth.token, org: org, groupID: group.id)\n815|            if let exact = members.first(where: { $0.id == agentID }) {\n816|                guard exact.name == agentName else {\n817|                    throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n818|                        \"Group '\\(group.name)' lists agent \\(agentID) as '\\(exact.name)', not '\\(agentName)'. Refusing a mismatched group.\"\n819|                    )\n820|                }\n821|                return group\n822|            }\n823|            // A same-name foreign member in this group is ignored: only the\n824|            // exact agent ID binds membership.\n825|        }\n826|        throw RunnerRegistration.RegistrationError.remoteRunnerNotFound(\n827|            \"Agent \\(agentID) is not in any visible group for '\\(org)'. It may have been moved or the App lacks group access.\"\n828|        )\n829|    }\n830|\n831|    /// Loads fresh group + repository access for one org runner. Display and\n832|    /// later edits use this API answer, never stale `.runner` pool fields.\n833|    private func loadGroupAccess(id: String) async {\n834|        let gen = catalogGeneration\n835|        let startedIdentity = await identities.load()\n836|        await action { Runners.Action.groupAccessLoading(id) }\n837|        do {\n838|            let verified = try await verifiedOrgRunner(id: id)\n839|            let auth = try await currentUserToken()\n840|            if isCatalogStale(gen) { return }\n841|            guard let started = startedIdentity, await identities.load()?.userID == started.userID else { return }\n842|            let verifiedHost = URL(string: (await installer.readLocalRegistration(directory: verified.directory))?.gitHubURL ?? \"\")?.host ?? \"\"\n843|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n844|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n845|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n846|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost).\"\n847|                )\n848|            }\n849|            let group = try await resolveFreshGroup(\n850|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n851|                auth: auth, generation: gen\n852|            )\n853|            if isCatalogStale(gen) { return }\n854|            let repoIDs = try await api.fetchGroupRepositories(\n855|                config: auth.config, token: auth.token, org: verified.org, groupID: group.id\n856|            )\n857|            if isCatalogStale(gen) { return }\n858|            let owned = await installer.loadOwnedGroupID(\n859|                serverHost: auth.identity.serverHost, org: verified.org, name: group.name\n860|            ) == group.id\n861|            let access = Runners.GroupAccess(\n862|                group: group, repoIDs: repoIDs.sorted(), updatedAt: now(),\n863|                owned: owned, loading: false\n864|            )\n865|            await action { Runners.Action.groupAccessLoaded(id, access) }\n866|        } catch is CancellationError {\n867|            return\n868|        } catch {\n869|            if !isCatalogStale(gen) {\n870|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n871|                await action { Runners.Action.groupAccessFailed(id, message) }\n872|            }\n873|        }\n874|    }\n875|\n876|    /// Applies edited repository access to the runner's fresh group. Rejects\n877|    /// stale UI (group moved since load), shared groups without explicit\n878|    /// takeover, and partial confirmations. Reuses the registration\n879|    /// ownership and confirmation gates; API-only, no installer lease.\n880|    private func applyGroupAccess(id: String, groupID: Int64, repos: Set<Int64>, allowTakeover: Bool) async {\n881|        let gen = catalogGeneration\n882|        await action { Runners.Action.groupAccessLoading(id) }\n883|        do {\n884|            let verified = try await verifiedOrgRunner(id: id)\n885|            let auth = try await currentUserToken()\n886|            if isCatalogStale(gen) { return }\n887|            // Fresh membership re-verified at write time: a move since the\n888|            // UI loaded fails instead of editing the wrong group.\n889|            let fresh = try await resolveFreshGroup(\n890|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n891|                auth: auth, generation: gen\n892|            )\n893|            guard fresh.id == groupID else {\n894|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n895|                    \"Runner moved from group \\(groupID) to '\\(fresh.name)' (\\(fresh.id)) since loading. Reload instead of editing a stale group.\"\n896|                )\n897|            }\n898|            if isCatalogStale(gen) { return }\n899|            let owned = await installer.loadOwnedGroupID(\n900|                serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name\n901|            )\n902|            try RunnerRegistration.Gates.authorizeGroupTakeover(\n903|                groupName: fresh.name, existingID: fresh.id,\n904|                ownedID: owned, allowTakeover: allowTakeover\n905|            )\n906|            if owned != fresh.id {\n907|                try await installer.saveOwnedGroupID(\n908|                    serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name, groupID: fresh.id\n909|                )\n910|            }\n911|            if isCatalogStale(gen) { return }\n912|            try await api.setGroupRepositories(\n913|                config: auth.config, token: auth.token, org: verified.org,\n914|                groupID: fresh.id, selectedRepositoryIDs: repos\n915|            )\n916|            if isCatalogStale(gen) { return }\n917|            let confirmed = try await api.fetchGroupRepositories(\n918|                config: auth.config, token: auth.token, org: verified.org, groupID: fresh.id\n919|            )\n920|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: repos, confirmed: confirmed)\n921|            if isCatalogStale(gen) { return }\n922|            let access = Runners.GroupAccess(\n923|                group: fresh, repoIDs: confirmed.sorted(), updatedAt: now(),\n924|                owned: true, loading: false\n925|            )\n926|            await action { Runners.Action.groupAccessLoaded(id, access) }\n927|            await action { Runners.Action.catalogCleared }\n928|        } catch is CancellationError {\n929|            return\n930|        } catch {\n931|            if !isCatalogStale(gen) {\n932|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n933|                await action { Runners.Action.groupAccessFailed(id, message) }\n934|            }\n935|        }\n936|    }\n937|}\n938|\n939|/// Import gates. Each gate refuses a concrete invalid class; negative tests\n940|/// narrow every one of them.\n941|public enum RunnersCatalogGates {\n942|    public static func validateImportable(_ candidate: RunnerDiscovery.Candidate) throws {\n943|        if candidate.controllerKind == .unsupported || candidate.unsupportedReason != nil {\n944|            throw RunnerError.unsupported(candidate.unsupportedReason ?? \"Unsupported management.\")\n945|        }\n946|        if !candidate.registrationReadable {\n947|            throw RunnerError.message(\"Cannot read .runner registration.\")\n948|        }\n949|        if candidate.agentName == nil || candidate.agentName?.isEmpty == true {\n950|            throw RunnerError.message(\"Registration name is missing.\")\n951|        }\n952|        if candidate.serverHost == nil || candidate.scope == nil {\n953|            throw RunnerError.message(\"Server or scope is undefined.\")\n954|        }\n955|        if !candidate.noSpacePath || !candidate.noSpaceWork {\n956|            throw RunnerError.noSpacePath(\"Path or work folder contains a space; relocation is required.\")\n957|        }\n958|        if !candidate.runsvcExists || !candidate.binaryExists {\n959|            throw RunnerError.message(\"Runner binaries are missing (run.sh / runsvc.sh).\")\n960|        }\n961|        if candidate.manifest == nil {\n962|            // Folder imports without a manifest create a service; every other\n963|            // check above must already have passed.\n964|            return\n965|        }\n966|        if !candidate.manifestMatches {\n967|            throw RunnerError.manifestMismatch(\"Service manifest does not match the runner directory.\")\n968|        }\n969|        if !candidate.issues.isEmpty {\n970|            // Issues beyond the manifest notice (folder imports) refuse.\n971|            let blocking = candidate.issues.filter { !$0.contains(\"No service manifest\") }\n972|            if !blocking.isEmpty {\n973|                throw RunnerError.message(blocking.joined(separator: \" \"))\n974|            }\n975|        }\n976|    }\n977|}","final_result":true}}}
