{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c729","stream":{"kind":"session","id":"01a0a9ec-c2bb-7943-8be0-a404f5b08a54"},"sequence":495,"recorded_at":1780531400000985,"record_type":"event","durability":"durable","causation_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","run_stream":{"kind":"run","id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b"},"call_id":"call_01a0a9ee409071bb9f614966b96afd69","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n(639 line(s) above)\n640|}\n641|\n642|// MARK: - Unregister binds local identity (AC row 11)\n643|\n644|private func unregisterEntry(dir: URL, label: String, agentID: Int64 = 42, agentName: String = \"r\") -> RunnerCatalogStore.Entry {\n645|    RunnerCatalogStore.Entry(\n646|        directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n647|        serviceLabel: label,\n648|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n649|        controllerKind: .manualManaged, serverHost: \"github.com\",\n650|        scopeKind: \"org\", scope: \"acme\", remoteAgentID: agentID, agentName: agentName, workFolder: \"_work\"\n651|    )\n652|}\n653|\n654|@Test func unregisterRefusesWrongConfirmationWithoutAPICall() async throws {\n655|    let harness = await catalogHarness(launchResults: [\n656|        CommandResult(code: 113, output: \"Could not find service x\")\n657|    ])\n658|    defer { try? FileManager.default.removeItem(at: harness.home) }\n659|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"my-runner\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.unreg\")\n660|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.unreg\", agentName: \"my-runner\"))\n661|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.unregister(\"actions.runner.test.unreg\", confirmation: \"wrong\"))\n662|    #expect(catalogErr(harness.logger).contains(\"Type 'my-runner'\"))\n663|    #expect(await harness.transport.requests.isEmpty)\n664|    #expect(await harness.installerExecutor.calls.isEmpty)\n665|}\n666|\n667|@Test func unregisterRefusesRunningService() async throws {\n668|    let harness = await catalogHarness(launchResults: [\n669|        CommandResult(code: 0, output: \"state = running\")\n670|    ])\n671|    defer { try? FileManager.default.removeItem(at: harness.home) }\n672|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", label: \"actions.runner.test.running\")\n673|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.running\"))\n674|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.unregister(\"actions.runner.test.running\", confirmation: \"r\"))\n675|    #expect(catalogErr(harness.logger).contains(\"Stop the runner first\"))\n676|    #expect(await harness.transport.requests.isEmpty)\n677|}\n678|\n679|@Test func unregisterRefusesNameWithoutVerifiedAgentID() async throws {\n680|    let harness = await catalogHarness()\n681|    defer { try? FileManager.default.removeItem(at: harness.home) }\n682|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", label: \"actions.runner.test.noname\")\n683|    // Strip the agent ID: a bare name must never authorize removal.\n684|    let config: [String: Any] = [\"agentName\": \"r\", \"gitHubUrl\": \"https://github.com/acme\", \"workFolder\": \"_work\"]\n685|    try JSONSerialization.data(withJSONObject: config).write(to: dir.appendingPathComponent(\".runner\"))\n686|    var entry = unregisterEntry(dir: dir, label: \"actions.runner.test.noname\")\n687|    entry.remoteAgentID = nil\n688|    try await harness.catalog.add(entry)\n689|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.unregister(\"actions.runner.test.noname\", confirmation: \"r\"))\n690|    #expect(catalogErr(harness.logger).contains(\"verified local registration\"))\n691|    #expect(await harness.transport.requests.isEmpty)\n692|}\n693|\n694|@Test func unregisterRefusesStoredIDMismatchAndCrossServer() async throws {\n695|    // Stored-vs-disk mismatch.\n696|    let mismatch = await catalogHarness()\n697|    defer { try? FileManager.default.removeItem(at: mismatch.home) }\n698|    let mismatchDir = try makeRunnerDir(parent: mismatch.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.mismatch\")\n699|    var entry = unregisterEntry(dir: mismatchDir, label: \"actions.runner.test.mismatch\")\n700|    entry.remoteAgentID = 99\n701|    try await mismatch.catalog.add(entry)\n702|    let _: Relux.ActionResult = await mismatch.flow.apply(Runners.Effect.unregister(\"actions.runner.test.mismatch\", confirmation: \"r\"))\n703|    #expect(catalogErr(mismatch.logger).contains(\"mismatched registration\"))\n704|    #expect(await mismatch.transport.requests.isEmpty)\n705|    // Cross-server: disk points at another host, auth is github.com.\n706|    let cross = await catalogHarness()\n707|    defer { try? FileManager.default.removeItem(at: cross.home) }\n708|    let crossDir = try makeRunnerDir(parent: cross.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.cross\")\n709|    let foreign: [String: Any] = [\"agentId\": 42, \"agentName\": \"r\", \"gitHubUrl\": \"https://ghe.example.com/acme\", \"workFolder\": \"_work\"]\n710|    try JSONSerialization.data(withJSONObject: foreign).write(to: crossDir.appendingPathComponent(\".runner\"))\n711|    // Need stopped status before the server check runs.\n712|    let stoppedHarness = await catalogHarness(launchResults: [CommandResult(code: 113, output: \"Could not find service x\")])\n713|    defer { try? FileManager.default.removeItem(at: stoppedHarness.home) }\n714|    // Reuse the cross dir files by copying .runner content into the stopped harness entry.\n715|    let stoppedDir = try makeRunnerDir(parent: stoppedHarness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.cross\")\n716|    try JSONSerialization.data(withJSONObject: foreign).write(to: stoppedDir.appendingPathComponent(\".runner\"))\n717|    try await stoppedHarness.catalog.add(unregisterEntry(dir: stoppedDir, label: \"actions.runner.test.cross\"))\n718|    let _: Relux.ActionResult = await stoppedHarness.flow.apply(Runners.Effect.unregister(\"actions.runner.test.cross\", confirmation: \"r\"))\n719|    #expect(catalogErr(stoppedHarness.logger).contains(\"not the signed-in server\"))\n720|}\n721|\n722|@Test func unregisterRemovesRemoteKeepsFilesAndEntry() async throws {\n723|    let harness = await catalogHarness(\n724|        launchResults: [\n725|            // Pre-check stopped, boundary revalidation stopped, post-op refresh.\n726|            CommandResult(code: 113, output: \"Could not find service x\"),\n727|            CommandResult(code: 113, output: \"Could not find service x\"),\n728|            CommandResult(code: 113, output: \"Could not find service x\")\n729|        ],\n730|        installerResults: [CommandResult(code: 0, output: \"remove ok\")],\n731|        transportResponses: [removeTokenPayload()]\n732|    )\n733|    defer { try? FileManager.default.removeItem(at: harness.home) }\n734|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.ok\")\n735|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.ok\"))\n736|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.unregister(\"actions.runner.test.ok\", confirmation: \"r\"))\n737|    #expect(lastCatalogFailure(harness.logger) == nil)\n738|    // Remove token minted for the verified scope, config.sh remove ran with it.\n739|    let requests = await harness.transport.requests\n740|    #expect(requests.count == 1)\n741|    #expect(requests.first?.url.path.contains(\"/orgs/acme/actions/runners/remove-token\") == true)\n742|    let installerCalls = await harness.installerExecutor.calls\n743|    #expect(installerCalls.count == 1)\n744|    #expect(installerCalls.first?.contains(\"remove\") == true)\n745|    // Token never leaks into the catalog or the success path.\n746|    let entries = await harness.catalog.load()\n747|    #expect(entries.count == 1)\n748|    #expect(entries.first?.remoteAgentID == nil)\n749|    #expect(FileManager.default.fileExists(atPath: dir.path))\n750|    #expect(FileManager.default.fileExists(atPath: dir.appendingPathComponent(\"manual-service.plist\").path))\n751|}\n752|\n753|// MARK: - Installer lease (AC row 11)\n754|\n755|@Test func installerLeaseSerializesUnregisterAndInstall() async throws {\n756|    let root = FileManager.default.temporaryDirectory.appendingPathComponent(\"Lease-\" + UUID().uuidString)\n757|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n758|    defer { try? FileManager.default.removeItem(at: root) }\n759|    let installer = RunnerInstallerService(\n760|        installRoot: root,\n761|        downloader: { _ in\n762|            try await Task.sleep(for: .seconds(2))\n763|            return Data()\n764|        },\n765|        executor: FakeExecutor([])\n766|    )\n767|    let draft = RunnerRegistration.Draft(scope: .organization(org: \"acme\"), runnerName: \"r\", installDirName: \"a\", groupName: \"g\")\n768|    let asset = RunnerRegistration.DownloadAsset(\n769|        osName: RunnerInstallerService.installOS, architecture: installer.architecture,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
