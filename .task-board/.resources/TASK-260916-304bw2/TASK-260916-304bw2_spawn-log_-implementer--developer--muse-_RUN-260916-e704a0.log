()\n1120|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n1121|            throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n1122|        }\n1123|        let directory = RunnerCatalogStore.resolve(entry: entry)\n1124|        let canonical = RunnerCatalogStore.canonical(directory)\n1125|        guard let local = await installer.readLocalRegistration(directory: directory),\n1126|              let agentID = local.agentID,\n1127|              let agentName = local.agentName, !agentName.isEmpty,\n1128|              let address = local.gitHubURL,\n1129|              let url = URL(string: address), url.scheme == \"https\" else {\n1130|            editorAuthorities.removeValue(forKey: entry.serviceLabel)\n1131|            editorInvalidated.insert(entry.serviceLabel)\n1132|            let message = \"Runner identity changed since loading (registration unreadable for '\\(entry.serviceLabel)'). Reload group access before applying.\"\n1133|            await action { Runners.Action.groupAccessInvalidated(id, message) }\n1134|            return nil\n1135|        }\n1136|        let components = url.pathComponents.filter { $0 != \"/\" }\n1137|        let diskHost = url.host ?? \"\"\n1138|        let matches = components.count == 1\n1139|            && components[0] == stored.org\n1140|            && RunnerRegistration.OperationIdentity.normalizeServerHost(diskHost)\n1141|                == RunnerRegistration.OperationIdentity.normalizeServerHost(stored.serverHost)\n1142|            && agentID == stored.agentID\n1143|            && agentName == stored.agentName\n1144|            && canonical == stored.canonicalPath\n1145|            && entry.localID == stored.localID\n1146|        guard matches else {\n(more lines below)","final_result":true}}}
