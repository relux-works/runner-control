y from the mutable current catalog. A direct Apply without a\n1163|    /// prior Load establishes its own start authority for that single write.\n1164|    /// Preserves the binding plus the starting login incarnation over every\n1165|    /// asynchronous boundary through confirmation and publication. Reuses the\n1166|    /// registration ownership and confirmation gates; API-only, no\n1167|    /// installer lease.\n1168|    private func applyGroupAccess(id: String, groupID: Int64, repos: Set<Int64>, allowTakeover: Bool) async {\n1169|        let gen = catalogGeneration\n1170|        let startedIdentity = await identities.load()\n1171|        await action { Runners.Action.groupAccessLoading(id) }\n1172|        do {\n1173|            if await editorRequiresReload(id: id) {\n1174|                await action { Runners.Action.groupAccessInvalidated(id, \"Runner editor was invalidated (folder moved or identity changed). Reload group access before applying.\") }\n1175|                return\n1176|            }\n1177|            let verified: VerifiedOrgRunner\n1178|            if let stored = await storedEditorAuthority(id: id) {\n1179|                guard let consumed = try await consumeStoredEditorAuthority(stored, id: id) else { return }\n1180|                verified = consumed\n1181|            } else {\n1182|                verified = try await verifiedOrgRunner(id: id)\n1183|            }\n1184|            let auth = try await currentUserToken()\n1185|            if isCatalogStale(gen) { return }\n1186|            guard await sessionStill(startedIdentity) else { return }\n1187|            try await bindApplyIdentity(verified: verified, auth: auth)\n1188|            // Fresh membership re-verified at write time: a move since the\n1189|            // UI loaded fails instead of editing the wrong group.\n1190|            let fresh = try await resolveFreshGroup(\n1191|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n1192|                auth: auth, generation: gen\n1193|            )\n1194|            guard fresh.id == groupID else {\n1195|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1196|                    \"Runner moved from group \\(groupID) to '\\(fresh.name)' (\\(fresh.id)) since loading. Reload instead of editing a stale group.\"\n1197|                )\n1198|            }\n1199|            if isCatalogStale(gen) { return }\n1200|            let owned = await installer.loadOwnedGroupID(\n1201|                serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name\n1202|            )\n1203|            try RunnerRegistration.Gates.authorizeGroupTakeover(\n1204|                groupName: fresh.name, existingID: fresh.id,\n1205|                ownedID: owned, allowTakeover: allowTakeover\n1206|            )\n1207|            if owned != fresh.id {\n1208|                try await installer.saveOwnedGroupID(\n1209|                    serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name, groupID: fresh.id\n1210|                )\n1211|            }\n1212|            if isCatalogStale(gen) { return }\n1213|            // Re-bind at the PUT boundary: the membership and ownership\n1214|            // awaits above must not carry stale identity into the write.\n1215|            guard await sessionStill(startedIdentity) else { return }\n1216|            try await bindApplyIdentity(verified: verified, auth: auth)\n1217|            try await api.setGroupRepositories(\n1218|                config: auth.config, token: auth.token, org: verified.org,\n1219|                groupID: fresh.id, selectedRepositoryIDs: repos\n1220|            )\n1221|            if isCatalogStale(gen) { return }\n1222|            // Completion ownership: the issued PUT cannot be undone, but a\n1223|            // logout, account/server switch, or same-account re-login after\n1224|            // it refuses the confirmation read and any state publication\n1225|            // into the changed session incarnation.\n1226|            guard await sessionStill(startedIdentity) else { return }\n1227|            let confirmed = try await api.fetchGroupRepositories(\n1228|                config: auth.config, token: auth.token, org: verified.org, groupID: fresh.id\n1229|            )\n1230|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: repos, confirmed: confirmed)\n1231|            if isCatalogStale(gen) { return }\n1232|            guard await sessionStill(startedIdentity) else { return }\n1233|            let authority = Runners.EditorAuthority(\n1234|                serverHost: URL(string: (await installer.readLocalRegistration(directory: verified.directory))?.gitHubURL ?? \"\")?.host ?? verified.entry.serverHost ?? auth.identity.serverHost,\n1235|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n1236|                canonicalPath: RunnerCatalogStore.canonical(verified.directory),\n1237|                localID: verified.entry.localID\n1238|            )\n1239|            editorAuthorities[verified.entry.serviceLabel] = authority\n1240|            editorInvalidated.remove(verified.entry.serviceLabel)\n1241|            let access = Runners.GroupAccess(\n1242|                group: fresh, repoIDs: confirmed.sorted(), updatedAt: now(),\n1243|                owned: true, loading: false, authority: authority\n1244|            )\n1245|            await action { Runners.Action.groupAccessLoaded(id, access) }\n1246|            await action { Runners.Action.catalogCleared }\n1247|        } catch is CancellationError {\n1248|            return\n1249|        } catch {\n1250|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n1251|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n1252|                await action { Runners.Action.groupAccessFailed(id, message) }\n1253|            }\n1254|        }\n1255|    }\n1256|\n1257|    // MARK: - Group-access operation ownership\n1258|\n1259|    /// Takes the next operation number for this editor. Every Load/Apply\n1260|    /// calls this before publishing its loading state.\n1261|    private func beginGroupAccessOperation(id: String) -> Int {\n1262|        let next = (groupAccessGeneration[id] ?? 0) + 1\n1263|        groupAccessGeneration[id] = next\n1264|        return next\n1265|    }\n1266|\n1267|    /// True when this operation is still the newest one for the editor.\n1268|    private func ownsGroupAccess(id: String, operation: Int) -> Bool {\n1269|        groupAccessGeneration[id] == operation\n1270|    }\n1271|\n1272|    /// Drops the operation ownership for both id spellings of an entry, so\n1273|    /// an in-flight Load/Apply can neither publish into nor release the\n1274|    /// editor after the entry is removed or relinked.\n1275|    private func dropGroupAccessOwnership(serviceLabel: String, localID: String) {\n1276|        groupAccessGeneration.removeValue(forKey: serviceLabel)\n1277|        groupAccessGeneration.removeValue(forKey: localID)\n1278|    }\n1279|\n1280|    /// Publishes only when this operation still owns the editor. A stale\n1281|    /// completion — superseded by a newer Load/Apply on the same runner —\n1282|    /// publishes nothing: no cleared busy state, no stale data.\n1283|    private func publishGroupAccessIfCurrent(\n1284|        id: String, operation: Int, makeAction: @Sendable () -> Runners.Action\n1285|    ) async {\n1286|        guard ownsGroupAccess(id: id, operation: operation) else { return }\n1287|        await action { makeAction() }\n1288|    }\n1289|\n1290|    /// Releases the busy state after a session invalidation, but only when\n1291|    /// this operation still owns the editor. Publishes an explicit retry\n1292|    /// message instead of stale data, so the UI returns to Load/refresh\n1293|    /// instead of wedging on a spinner.\n1294|    private func releaseGroupAccessAfterSessionChange(id: String, operation: Int) async {\n1295|        guard ownsGroupAccess(id: id, operation: operation) else { return }\n1296|        await action {\n1297|            Runners.Action.groupAccessFailed(\n1298|                id,\n1299|                \"GitHub session changed during group access. Reload group access to retry in the current session.\"\n1300|            )\n1301|        }\n1302|    }\n1303|\n1304|    /// Releases the busy state after the catalog changed under this\n1305|    /// operation, but only when this operation still owns the editor and the\n1306|    /// entry still exists. A removed entry needs no publication: its removal\n1307|    /// already pruned the editor state. A relinked entry was already\n1308|    /// released by its explicit invalidation.\n1309|    private func abandonGroupAccessAfterCatalogChange(id: String, operation: Int) async {\n1310|        guard ownsGroupAccess(id: id, operation: operation) else { return }\n1311|        let entries = await catalog.load()\n1312|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else { return }\n1313|        guard !editorInvalidated.contains(entry.serviceLabel) else { return }\n1314|        await action {\n1315|            Runners.Action.groupAccessFailed(\n1316|                id,\n1317|                \"Runner catalog changed during group access. Reload group access to retry.\"\n1318|            )\n1319|        }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
