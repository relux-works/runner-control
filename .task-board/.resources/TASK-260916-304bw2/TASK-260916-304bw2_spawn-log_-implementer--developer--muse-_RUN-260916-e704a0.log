irectory.appendingPathComponent(\".runner\").path) else {\n520|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: directory.lastPathComponent)\n521|        }\n522|        if let marker = loadMarker(directory: directory), marker.scopeKey != scopeKey {\n523|            throw RunnerRegistration.RegistrationError.alreadyInstalled(path: directory.path)\n524|        }\n525|        try files.removeItem(at: directory)\n526|    }\n527|\n528|    // MARK: - Catalog operations (shared lease)\n529|\n530|    /// Public idle check for catalog file mutations (RunAtLoad edits,\n531|    /// relink path updates). Refuses while ANY installer mutation is live,\n532|    /// for ANY directory. Retry after the owner settles.\n533|    public func requireIdle(for directory: URL) throws {\n534|        try requireIdleInstaller(directory)\n535|    }\n536|\n537|    /// Runs the exact `config.sh remove` invocation to unregister a runner\n538|    /// from GitHub. Holds the app-wide installer lease across the process so\n539|    /// no registration, install, recovery or second unregister can overlap,\n540|    /// including alias spellings of the same directory. Never deletes the\n541|    /// working directory or the service manifest: files stay for re-registration\n542|    /// or explicit file deletion. The remove token is scrubbed from errors.\n543|    public func unregister(directory: URL, removeToken: String) async throws {\n544|        let lease = try acquireMutationLease(for: directory)\n545|        defer { releaseMutationLease(lease) }\n546|        let files = FileManager.default\n547|        let executable = directory.appendingPathComponent(\"config.sh\").path\n548|        guard files.fileExists(atPath: executable) else {\n549|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n550|        }\n551|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n552|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n553|                \"No local registration at '\\(directory.path)'. Nothing to unregister.\"\n554|            )\n555|        }\n556|        let result = try await executor.run(executable, [\"remove\", \"--token\", removeToken, \"--unattended\"])\n557|        guard result.code == 0 else {\n558|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [removeToken])\n559|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n560|        }\n561|    }\n562|\n563|    /// Updates an existing service manifest to a new directory after the user\n564|    /// explicitly relinks a moved folder. Preserves every other key,\n565|    /// including the imported RunAtLoad policy. Refuses while the installer\n566|    /// lease is held by a live mutation.\n567|    public func updateServicePaths(plist: URL, directory: URL) throws {\n568|        guard !directory.path.contains(\" \") else {\n569|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n570|        }\n571|        try requireIdleInstaller(directory)\n572|        guard let data = try? Data(contentsOf: plist),\n573|              var object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {\n574|            throw RunnerRegistration.RegistrationError.network(\"Service manifest is unreadable.\")\n575|        }\n576|        object[\"WorkingDirectory\"] = directory.path\n577|        object[\"ProgramArguments\"] = [directory.appendingPathComponent(\"runsvc.sh\").path]\n578|        let out = try PropertyListSerialization.data(fromPropertyList: object, format: .xml, options: 0)\n579|        try out.write(to: plist, options: .atomic)\n580|    }\n581|}","final_result":true}}}
