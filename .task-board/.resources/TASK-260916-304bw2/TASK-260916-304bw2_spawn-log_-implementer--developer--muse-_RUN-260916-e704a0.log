{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62f","stream":{"kind":"session","id":"01a0a9ec-c2bb-7943-8be0-a404f5b08a54"},"sequence":370,"recorded_at":1780531400000735,"record_type":"event","durability":"durable","causation_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","run_stream":{"kind":"run","id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b"},"task_stream":{"kind":"task","id":"01a0a9ee-0a3e-7831-8d9d-328ceb8a4824"},"task_id":"01a0a9ee-0a3e-7831-8d9d-328ceb8a4824","event":{"kind":"output","task_id":"01a0a9ee-0a3e-7831-8d9d-328ceb8a4824","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n1|import CryptoKit\n2|import Foundation\n3|\n4|/// Filesystem installer for downloaded GitHub Actions runners.\n5|///\n6|/// Production path: download bytes → SHA-256 verify → tar extract →\n7|/// `bin/runsvc.sh` copied into the root and chmodded (as official `svc.sh`\n8|/// would) → exact `config.sh` invocation → manual LaunchAgent plist.\n9|/// All side effects stay below `installRoot`; tests inject a temporary root,\n10|/// a fake downloader, and fixtures instead of touching production runners.\n11|public actor RunnerInstallerService {\n12|    public static let markerFileName = \".runnercontrol-install.json\"\n13|    public static let installOS = \"osx\"\n14|\n15|    private let installRoot: URL\n16|    private let downloader: @Sendable (URL) async throws -> Data\n17|    private let executor: any CommandExecuting\n18|    private let currentArch: @Sendable () -> String\n19|    private let hasher: @Sendable (Data) -> String\n20|\n21|    public init(\n22|        installRoot: URL? = nil,\n23|        downloader: (@Sendable (URL) async throws -> Data)? = nil,\n24|        executor: (any CommandExecuting)? = nil,\n25|        currentArch: (@Sendable () -> String)? = nil,\n26|        hasher: (@Sendable (Data) -> String)? = nil\n27|    ) {\n28|        self.installRoot = installRoot\n29|            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/GitHubActions\")\n30|        self.downloader = downloader ?? { url in\n31|            let (data, _) = try await URLSession.shared.data(from: url)\n32|            return data\n33|        }\n34|        self.executor = executor ?? CommandExecutor()\n35|        self.currentArch = currentArch ?? {\n36|            #if arch(arm64)\n37|            return \"arm64\"\n38|            #else\n39|            return \"x64\"\n40|            #endif\n41|        }\n42|        self.hasher = hasher ?? { data in\n43|            SHA256.hash(data: data).map { String(format: \"%02x\", $0) }.joined()\n44|        }\n45|    }\n46|\n47|    public nonisolated var root: URL { installRoot }\n48|    public nonisolated var architecture: String { currentArch() }\n49|\n50|    /// Single installer-wide mutation lease. The registration wizard runs\n51|    /// ONE active mutating installer operation per app instance\n52|    /// (download/extract, config.sh, service setup, partial recovery),\n53|    /// for ANY directory. Acquired synchronously before the first await and\n54|    /// released only when the owning operation settles, so actor reentrancy\n55|    /// can never admit two concurrent mutations — no path-identity\n56|    /// comparison, and therefore no filesystem-alias bypass class\n57|    /// (symlinks, case variants, Unicode equivalences). Abandoning a UI\n58|    /// generation does not release this resource; only the settling side\n59|    /// effect does. Ordinary start/stop of already-installed runners and\n60|    /// multiple installed CI runners are unaffected: they never take this\n61|    /// lease.\n62|    private var activeOperation: UUID?\n63|    /// Directory the lease owner is mutating. Diagnostic only: refusal never\n64|    /// compares paths, it refuses whenever a lease is held.\n65|    private var activePath: String?\n66|\n67|    public func directory(for installDirName: String) -> URL {\n68|        installRoot.appendingPathComponent(installDirName)\n69|    }\n70|\n71|    private nonisolated static func isSymlink(atPath path: String) -> Bool {\n72|        (try? FileManager.default.destinationOfSymbolicLink(atPath: path)) != nil\n73|    }\n74|\n75|    /// Refuses Finder-alias installation paths before any side effect. A\n76|    /// Finder alias is not a transparent directory like a symlink: operating\n77|    /// through its spelling would not operate on the target, so alias\n78|    /// spellings are rejected instead of being followed. Symlinks are not\n79|    /// refused here — and must be excluded explicitly because\n80|    /// `isAliasFileKey` is also true for symlinks such as the system `/var`\n81|    /// and `/tmp` links every temporary path resolves through. Concurrent\n82|    /// symlink-alias mutations are serialized by the installer-wide lease,\n83|    /// which compares nothing about paths.\n84|    nonisolated static func ensureNoAlias(at directory: URL) throws {\n85|        var current = URL(fileURLWithPath: directory.path).standardizedFileURL\n86|        while true {\n87|            if FileManager.default.fileExists(atPath: current.path),\n88|               !isSymlink(atPath: current.path),\n89|               (try? current.resourceValues(forKeys: [.isAliasFileKey]))?.isAliasFile == true {\n90|                throw RunnerRegistration.RegistrationError.invalidDraft(\n91|                    \"Installation path '\\(directory.path)' resolves through a Finder alias at '\\(current.path)'. Choose a direct folder path instead of an alias.\"\n92|                )\n93|            }\n94|            let parent = current.deletingLastPathComponent()\n95|            if parent.path == current.path { break }\n96|            current = parent\n97|        }\n98|    }\n99|\n100|    /// Acquires the installer-wide mutation lease for `directory`.\n101|    /// Synchronous: callers must invoke it before their first await so the\n102|    /// check-and-set is atomic under actor isolation. Throws a retryable\n103|    /// `installerBusy` whenever ANY live operation holds the lease,\n104|    /// regardless of directory — there is no path comparison to bypass.\n105|    /// Returns the owner token; the caller must hold it across awaits and\n106|    /// release that exact token when the operation settles.\n107|    private func acquireMutationLease(for directory: URL) throws -> UUID {\n108|        try Self.ensureNoAlias(at: directory)\n109|        guard activeOperation == nil else {\n110|            throw RunnerRegistration.RegistrationError.installerBusy(path: directory.path)\n111|        }\n112|        let token = UUID()\n113|        activeOperation = token\n114|        activePath = directory.path\n115|        return token\n116|    }\n117|\n118|    /// Releases the installer-wide lease, but only for its exact owner. A\n119|    /// token that does not match the current owner releases nothing, so a\n120|    /// stale or foreign completion can never unlock a newer operation.\n121|    private func releaseMutationLease(_ token: UUID) {\n122|        guard activeOperation == token else { return }\n123|        activeOperation = nil\n124|        activePath = nil\n125|    }\n126|\n127|    /// Refuses a synchronous mutation (service setup, recovery) while the\n128|    /// installer lease is held by a live async side effect. No insert:\n129|    /// without an await the caller itself cannot interleave, it only needs\n130|    /// to respect the lease held by another operation. Refuses for ANY\n131|    /// directory while ANY mutation is live.\n132|    private func requireIdleInstaller(_ directory: URL) throws {\n133|        try Self.ensureNoAlias(at: directory)\n134|        guard activeOperation == nil else {\n135|            throw RunnerRegistration.RegistrationError.installerBusy(path: directory.path)\n136|        }\n137|    }\n138|\n139|    // MARK: - Idempotency markers\n140|\n141|    public struct Marker: Codable, Sendable, Equatable {\n142|        public var scopeKey: String\n143|        public var completedSteps: Set<String>\n144|        /// Server the directory was configured against (`.runner` host is\n145|        /// authoritative; this records the config-time expectation so a\n146|        /// group/server change cannot reuse an old configured marker).\n147|        public var serverHost: String?\n148|        /// Dedicated group passed to `config.sh --runnergroup` (org scope).\n149|        /// `.runner` does not record it, so the marker must: a group-name\n150|        /// edit never claims the old group's configuration as its own.\n151|        public var groupName: String?\n152|        public init(\n153|            scopeKey: String, completedSteps: Set<String> = [],\n154|            serverHost: String? = nil, groupName: String? = nil\n155|        ) {\n156|            self.scopeKey = scopeKey; self.completedSteps = completedSteps\n157|            self.serverHost = serverHost; self.groupName = groupName\n158|        }\n159|    }\n160|\n161|    public static let stepDownloaded = \"downloaded\"\n162|    public static let stepInstalled = \"installed\"\n163|    public static let stepConfigured = \"configured\"\n164|    public static let stepServiceReady = \"serviceReady\"\n165|\n166|    public func loadMarker(directory: URL) -> Marker? {\n167|        let url = directory.appendingPathComponent(Self.markerFileName)\n168|        guard let data = try? Data(contentsOf: url) else { return nil }\n169|        return try? JSONDecoder().decode(Marker.self, from: data)\n170|    }\n171|\n172|    private func storeMarker(_ marker: Marker, directory: URL) throws {\n173|        let data = try JSONEncoder().encode(marker)\n174|        try data.write(to: directory.appendingPathComponent(Self.markerFileName), options: .atomic)\n175|    }\n176|\n177|    public func markCompleted(\n178|        _ step: String, directory: URL, scopeKey: String,\n179|        serverHost: String? = nil, groupName: String? = nil\n180|    ) throws {\n181|        var marker = loadMarker(directory: directory) ?? Marker(scopeKey: scopeKey)\n182|        marker.completedSteps.insert(step)\n183|        if let serverHost { marker.serverHost = serverHost }\n184|        if let groupName { marker.groupName = groupName }\n185|        try storeMarker(marker, directory: directory)\n186|    }\n187|\n188|    public func hasCompleted(_ step: String, directory: URL) -> Bool {\n189|        loadMarker(directory: directory)?.completedSteps.contains(step) == true\n190|    }\n191|\n192|    // MARK: - Install\n193|\n194|    /// Downloads, verifies, and extracts the official package. Idempotent:\n195|    /// a completed `installed` marker with matching scope and server skips\n196|    /// the work. Refuses to overwrite an already-registered directory (no\n197|    /// duplicates).\n198|    public func downloadAndInstall(\n199|        asset: RunnerRegistration.DownloadAsset,\n200|        draft: RunnerRegistration.Draft,\n201|        serverHost: String? = nil\n202|    ) async throws -> URL {\n203|        try RunnerRegistration.Gates.validateNoSpace(\n204|            installDirName: draft.installDirName, workFolder: draft.workFolder\n205|        )\n206|        let directory = self.directory(for: draft.installDirName)\n207|        if directory.path.contains(\" \") {\n208|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n209|        }\n210|        // Installer-wide ownership for the whole mutation, acquired before\n211|        // the first await (reuse check included): any second mutation while\n212|        // this install is live — same directory or not — is refused\n213|        // retryably instead of starting a second download/extract. The owner\n214|        // token is held across awaits and only that exact token releases.\n215|        let lease = try acquireMutationLease(for: directory)\n216|        defer { releaseMutationLease(lease) }\n217|        let files = FileManager.default\n218|        if let marker = loadMarker(directory: directory),\n219|           marker.completedSteps.contains(Self.stepInstalled),\n220|           marker.scopeKey == draft.scope.scopeKey,\n221|           Self.markerServerMatches(marker: marker, serverHost: serverHost),\n222|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n223|            return directory\n224|        }\n225|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n226|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: draft.runnerName)\n227|        }\n228|        let bytes: Data\n229|        do {\n230|            bytes = try await downloader(asset.downloadURL)\n231|        } catch {\n232|            throw RunnerRegistration.RegistrationError.network(\"Runner download failed: \\(error.localizedDescription)\")\n233|        }\n234|        // Fail closed: the official downloads endpoint documents\n235|        // `sha256_checksum`, and an install without a verified digest is\n236|        // refused rather than trusted on TLS alone.\n237|        guard let expected = asset.sha256Checksum, !expected.isEmpty else {\n238|            throw RunnerRegistration.RegistrationError.integrityMismatch\n239|        }\n240|        let actual = hasher(bytes)\n241|        guard actual.lowercased() == expected.lowercased() else {\n242|            throw RunnerRegistration.RegistrationError.integrityMismatch\n243|        }\n244|        try files.createDirectory(at: directory, withIntermediateDirectories: true)\n245|        let archive = files.temporaryDirectory.appendingPathComponent(UUID().uuidString + \"-\" + asset.filename)\n246|        defer { try? files.removeItem(at: archive) }\n247|        try bytes.write(to: archive, options: .atomic)\n248|        let result = try await executor.run(\"/usr/bin/tar\", [\"-xzf\", archive.path, \"-C\", directory.path])\n249|        guard result.code == 0 else {\n250|            throw RunnerRegistration.RegistrationError.network(\n251|                \"Runner archive extraction failed: \\(String(result.output.prefix(300)))\"\n252|            )\n253|        }\n254|        // Official packages keep runsvc.sh under bin/ until svc.sh installs it;\n255|        // a bare extraction leaves the root copy absent, so install it here.\n256|        try installRunsvc(directory: directory)\n257|        try markCompleted(\n258|            Self.stepDownloaded, directory: directory,\n259|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n260|        )\n261|        try markCompleted(\n262|            Self.stepInstalled, directory: directory,\n263|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n264|        )\n265|        return directory\n266|    }\n267|\n268|    /// Server binding for install reuse. A marker written without a server\n269|    /// (pre-revision-4) never satisfies a server-bound request: the next\n270|    /// install re-verifies instead of reusing unknown provenance. Direct\n271|    /// installer calls without a server (unit fixtures) keep the legacy\n272|    /// scope-only reuse.\n273|    static func markerServerMatches(marker: Marker, serverHost: String?) -> Bool {\n274|        guard let want = serverHost else { return true }\n275|        guard let have = marker.serverHost else { return false }\n276|        return RunnerRegistration.OperationIdentity.normalizeServerHost(have)\n277|            == RunnerRegistration.OperationIdentity.normalizeServerHost(want)\n278|    }\n279|\n280|    /// Copies official `bin/runsvc.sh` into the installation root and makes\n281|    /// it executable, mirroring what official `svc.sh install` would do.\n282|    public func installRunsvc(directory: URL) throws {\n283|        let files = FileManager.default\n284|        let source = directory.appendingPathComponent(\"bin/runsvc.sh\")\n285|        let target = directory.appendingPathComponent(\"runsvc.sh\")\n286|        guard files.fileExists(atPath: source.path) else {\n287|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing bin/runsvc.sh.\")\n288|        }\n289|        if files.fileExists(atPath: target.path) {\n290|            try files.removeItem(at: target)\n291|        }\n292|        try files.copyItem(at: source, to: target)\n293|        try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: target.path)\n294|    }\n295|\n296|    // MARK: - Configure\n297|\n298|    /// Runs the exact `config.sh` invocation. Skips when a previous attempt\n299|    /// already registered this directory (marker + `.runner` present), so\n300|    /// retries never create orphan or duplicate GitHub registrations.\n301|    /// Returns the local agent ID read back from `.runner`.\n302|    @discardableResult\n303|    public func runConfig(\n304|        directory: URL,\n305|        scopeURL: String,\n306|        token: String,\n307|        draft: RunnerRegistration.Draft,\n308|        runnerGroup: String?\n309|    ) async throws -> Int64? {\n310|        try await runConfig(\n311|            directory: directory, scopeURL: scopeURL, token: token,\n312|            draft: draft, runnerGroup: runnerGroup, replace: draft.allowReplace\n313|        )\n314|    }\n315|\n316|    /// Explicit-`replace` variant. Production callers pass\n317|    /// `draft.allowReplace`; tests drive both values.\n318|    @discardableResult\n319|    public func runConfig(\n320|        directory: URL,\n321|        scopeURL: String,\n322|        token: String,\n323|        draft: RunnerRegistration.Draft,\n324|        runnerGroup: String?,\n325|        replace: Bool\n326|    ) async throws -> Int64? {\n327|        let files = FileManager.default\n328|        let scopeHost = URL(string: scopeURL)?.host ?? \"\"\n329|        // Installer-wide ownership for the whole config, acquired before the\n330|        // first await (resume checks included): any second mutation while\n331|        // this config.sh is live is refused retryably instead of invoking\n332|        // another config.sh. The lease is released only when this operation\n333|        // settles; an abandoned UI generation never releases it. The owner\n334|        // token is held across awaits and only that exact token releases.\n335|        let lease = try acquireMutationLease(for: directory)\n336|        defer { releaseMutationLease(lease) }\n337|        if hasCompleted(Self.stepConfigured, directory: directory),\n338|           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n339|            // Idempotent resume never returns a stale ID: the existing\n340|            // configuration must still match this draft on this server.\n341|            let local = readLocalRegistration(directory: directory)\n342|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n343|                local: local, configured: true, draft: draft, serverHost: scopeHost\n344|            )\n345|            try Self.verifyConfiguredGroup(\n346|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n347|            )\n348|            return verified\n349|        }\n350|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n351|           hasCompleted(Self.stepConfigured, directory: directory) {\n352|            let local = readLocalRegistration(directory: directory)\n353|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n354|                local: local, configured: true, draft: draft, serverHost: scopeHost\n355|            )\n356|            try Self.verifyConfiguredGroup(\n357|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n358|            )\n359|            return verified\n360|        }\n361|        let spec = RunnerRegistration.ConfigSpec(\n362|            scopeURL: scopeURL, token: token, name: draft.runnerName,\n363|            workFolder: draft.workFolder, labels: draft.labels,\n364|            runnerGroup: runnerGroup, replace: replace\n365|        )\n366|        let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n367|        let executable = directory.appendingPathComponent(\"config.sh\").path\n368|        guard files.fileExists(atPath: executable) else {\n369|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n370|        }\n371|        let result = try await executor.run(executable, args)\n372|        guard result.code == 0 else {\n373|            // Never echo the token: config output may repeat arguments.\n374|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [token])\n375|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n376|        }\n377|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n378|            throw RunnerRegistration.RegistrationError.configFailed(\n379|                \"config.sh reported success but .runner is missing.\"\n380|            )\n381|        }\n382|        try markCompleted(\n383|            Self.stepConfigured, directory: directory, scopeKey: draft.scope.scopeKey,\n384|            serverHost: scopeHost, groupName: runnerGroup\n385|        )\n386|        return readAgentID(directory: directory)\n387|    }\n388|\n389|    /// `.runner` does not record the org group, so the configured marker\n390|    /// does. A resume whose marker names another group (or predates group\n391|    /// recording) refuses instead of claiming the old group's configuration\n392|    /// as the new draft's. Repository scope never configures a group.\n393|    static func verifyConfiguredGroup(\n394|        marker: Marker?, runnerGroup: String?, draft: RunnerRegistration.Draft\n395|    ) throws {\n396|        switch draft.scope {\n397|        case .repository:\n398|            return\n399|        case .organization:\n400|            break\n401|        }\n402|        let wanted = (runnerGroup ?? draft.groupName).trimmingCharacters(in: .whitespacesAndNewlines)\n403|        guard let have = marker?.groupName?.trimmingCharacters(in: .whitespacesAndNewlines),\n404|              !have.isEmpty else {\n405|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n406|                \"Directory '\\(draft.installDirName)' was configured before group recording. Reconfigure for group '\\(wanted)' instead of reusing the old configuration.\"\n407|            )\n408|        }\n409|        guard have == wanted else {\n410|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n411|                \"Local registration was configured for group '\\(have)', not '\\(wanted)'. Reconfigure instead of reusing the old group's configuration.\"\n412|            )\n413|        }\n414|    }\n415|\n416|    // MARK: - Dedicated-group ownership\n417|\n418|    public static let ownershipFileName = \".runnercontrol-groups.json\"\n419|\n420|    private func ownershipFile() -> URL {\n421|        installRoot.appendingPathComponent(Self.ownershipFileName)\n422|    }\n423|\n424|    private static func ownershipKey(serverHost: String, org: String, name: String) -> String {\n425|        \"\\(RunnerRegistration.OperationIdentity.normalizeServerHost(serverHost))\\u{0}\\(org.lowercased())\\u{0}\\(name)\"\n426|    }\n427|\n428|    /// Returns the locally recorded dedicated-group ID for\n429|    /// `server` + `org` + `name`, or nil when this Mac never created (or\n430|    /// took over) that group on that server. Name matches on GitHub alone\n431|    /// never count as ownership, and ownership on one server never\n432|    /// authorizes adoption on another.\n433|    public func loadOwnedGroupID(serverHost: String, org: String, name: String) -> Int64? {\n434|        guard let data = try? Data(contentsOf: ownershipFile()),\n435|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n436|        return table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)]\n437|    }\n438|\n439|    public func saveOwnedGroupID(serverHost: String, org: String, name: String, groupID: Int64) throws {\n440|        let file = ownershipFile()\n441|        var table: [String: Int64] = [:]\n442|        if let data = try? Data(contentsOf: file),\n443|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n444|            table = decoded\n445|        }\n446|        table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)] = groupID\n447|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n448|        let data = try JSONEncoder().encode(table)\n449|        try data.write(to: file, options: .atomic)\n450|    }\n451|\n452|    /// Reads the local `.runner` identity without touching credentials.\n453|    /// Returns nil only when the file is missing or unparseable; a present\n454|    /// but incomplete file returns a partial struct so verification can name\n455|    /// the exact missing field instead of crashing.\n456|    public func readLocalRegistration(directory: URL) -> RunnerRegistration.LocalRegistration? {\n457|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n458|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n459|        var agentID: Int64?\n460|        if let id = object[\"agentId\"] as? Int64 { agentID = id }\n461|        else if let id = object[\"agentId\"] as? Int { agentID = Int64(id) }\n462|        else if let id = object[\"agentId\"] as? NSNumber { agentID = id.int64Value }\n463|        return RunnerRegistration.LocalRegistration(\n464|            agentID: agentID,\n465|            agentName: object[\"agentName\"] as? String,\n466|            gitHubURL: object[\"gitHubUrl\"] as? String,\n467|            workFolder: object[\"workFolder\"] as? String\n468|        )\n469|    }\n470|\n471|    /// Reads the local agent ID from `.runner` without touching credentials.\n472|    public func readAgentID(directory: URL) -> Int64? {\n473|        readLocalRegistration(directory: directory)?.agentID\n474|    }\n475|\n476|    // MARK: - Manual LaunchAgent\n477|\n478|    /// Writes the manual service plist (RunAtLoad off for new runners) and\n479|    /// validates it matches the directory. Never bootstraps the service:\n480|    /// enabling is the user's separate action.\n481|    @discardableResult\n482|    public func setupService(directory: URL, label: String) throws -> URL {\n483|        guard !directory.path.contains(\" \") else {\n484|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n485|        }\n486|        // Never rewrite the service while the installer lease is held by a\n487|        // live install/config; the caller retries after that operation\n488|        // settles.\n489|        try requireIdleInstaller(directory)\n490|        let files = FileManager.default\n491|        guard files.fileExists(atPath: directory.appendingPathComponent(\"runsvc.sh\").path) else {\n492|            throw RunnerRegistration.RegistrationError.network(\n493|                \"runsvc.sh is missing; reinstall before setting up the service.\"\n494|            )\n495|        }\n496|        let plist = directory.appendingPathComponent(\"manual-service.plist\")\n497|        let payload: [String: Any] = [\n498|            \"Label\": label,\n499|            \"ProgramArguments\": [directory.appendingPathComponent(\"runsvc.sh\").path],\n500|            \"WorkingDirectory\": directory.path,\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c631","stream":{"kind":"session","id":"01a0a9ec-c2bb-7943-8be0-a404f5b08a54"},"sequence":371,"recorded_at":1780531400000737,"record_type":"event","durability":"durable","causation_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","run_stream":{"kind":"run","id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b"},"task_stream":{"kind":"task","id":"01a0a9ee-0a3e-7831-8d9d-328ceb8a4824"},"task_id":"01a0a9ee-0a3e-7831-8d9d-328ceb8a4824","event":{"kind":"completed","task_id":"01a0a9ee-0a3e-7831-8d9d-328ceb8a4824"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c633","stream":{"kind":"session","id":"01a0a9ec-c2bb-7943-8be0-a404f5b08a54"},"sequence":372,"recorded_at":1780531400000739,"record_type":"event","durability":"durable","causation_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","run_stream":{"kind":"run","id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b"},"call_id":"call_01a0a9ee04977531bdbf2006f1884259","text":"Read text file `Packages/RunnerControlCore/Sources/Runners+Models.swift`.\n1|import Foundation\n2|extension Runners {\n3|    public struct Definition: Identifiable, Sendable, Equatable {\n4|        public let id: String\n5|        public let title: String\n6|        public let detail: String\n7|        public let directory: URL\n8|        public let githubURL: URL\n9|        private let servicePlist: URL?\n10|        /// Catalog identity. Nil for legacy discovery-only rows.\n11|        public let localID: String?\n12|        public let controllerKind: ControllerKind\n13|        /// Preserved launch-at-login policy of the imported service.\n14|        /// Nil means unknown (e.g. unsupported control).\n15|        public let runAtLoad: Bool?\n16|        /// User display override. Renaming on GitHub never changes identity.\n17|        public let displayName: String?\n18|        public let serverHost: String?\n19|        public let remoteAgentID: Int64?\n20|        public let workFolder: String?\n21|        public init(\n22|            id: String, title: String, detail: String, directory: URL, githubURL: URL,\n23|            servicePlist: URL? = nil, localID: String? = nil,\n24|            controllerKind: ControllerKind? = nil, runAtLoad: Bool? = nil,\n25|            displayName: String? = nil, serverHost: String? = nil,\n26|            remoteAgentID: Int64? = nil, workFolder: String? = nil,\n27|            loginEnabled: Bool? = nil\n28|        ) {\n29|            self.id = id; self.title = title; self.detail = detail\n30|            self.directory = directory; self.githubURL = githubURL; self.servicePlist = servicePlist\n31|            self.localID = localID\n32|            if let controllerKind {\n33|                self.controllerKind = controllerKind\n34|            } else {\n35|                let path = (servicePlist ?? directory.appendingPathComponent(\"manual-service.plist\")).path\n36|                self.controllerKind = path.contains(\"/Library/LaunchAgents/\") ? .standardLaunchAgent : .manualManaged\n37|            }\n38|            self.runAtLoad = runAtLoad\n39|            self.displayName = displayName\n40|            self.serverHost = serverHost\n41|            self.remoteAgentID = remoteAgentID\n42|            self.workFolder = workFolder\n43|            self.loginEnabled = loginEnabled\n44|        }\n45|        public var plist: URL { servicePlist ?? directory.appendingPathComponent(\"manual-service.plist\") }\n46|        /// Effective login-start behavior. Standard manifests use their own\n47|        /// RunAtLoad; external manual plists are ON only when a matching\n48|        /// registration exists in `~/Library/LaunchAgents` with RunAtLoad\n49|        /// true — RunAtLoad outside LaunchAgents never persists login start.\n50|        /// Nil means unknown (e.g. unsupported control).\n51|        public let loginEnabled: Bool?\n52|        public func withLoginEnabled(_ value: Bool?) -> Definition {\n53|            Definition(\n54|                id: id, title: title, detail: detail, directory: directory,\n55|                githubURL: githubURL, servicePlist: servicePlist, localID: localID,\n56|                controllerKind: controllerKind, runAtLoad: runAtLoad,\n57|                displayName: displayName, serverHost: serverHost,\n58|                remoteAgentID: remoteAgentID, workFolder: workFolder,\n59|                loginEnabled: value\n60|            )\n61|        }\n62|        /// Display title: user alias wins, otherwise the registration name.\n63|        public var displayTitle: String {\n64|            if let displayName, !displayName.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {\n65|                return displayName\n66|            }\n67|            return title\n68|        }\n69|        /// Legacy log directory fallback. Production log access resolves the\n70|        /// actual StandardOutPath/StandardErrorPath from the manifest plus\n71|        /// `_diag` via `RunnerDiagnostics`; this path is only a fallback.\n72|        public var logs: URL { FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/Logs/\" + id) }\n73|        public static func installed(home: URL = FileManager.default.homeDirectoryForCurrentUser) -> [Self] {\n74|            RunnerDiscovery.installed(home: home)\n75|        }\n76|    }\n77|    public enum Status: String, Sendable, Equatable {\n78|        case checking, stopped, starting, running, stopping, failed, missing, needsSetup, unknown\n79|        public var title: String {\n80|            switch self {\n81|            case .checking: \"Проверяем…\"\n82|            case .stopped: \"Выключен\"\n83|            case .starting: \"Запускается\"\n84|            case .running: \"Служба включена\"\n85|            case .stopping: \"Выключается\"\n86|            case .failed: \"Ошибка службы\"\n87|            case .missing: \"Раннер не найден\"\n88|            case .needsSetup: \"Требуется настройка\"\n89|            case .unknown: \"Статус недоступен\"\n90|            }\n91|        }\n92|    }\n93|    /// Operation phase for one row. Only the affected row is locked.\n94|    public enum OperationPhase: String, Sendable, Equatable {\n95|        case idle, starting, stopping\n96|    }\n97|    /// GitHub observation kept separate from the local service state.\n98|    /// Loss of network never turns a running service into a stopped one.\n99|    public struct RemoteObservation: Sendable, Equatable {\n100|        public var online: Bool?\n101|        public var busy: Bool?\n102|        /// False when GitHub is disconnected, stale, or the runner is absent.\n103|        public var busyKnown: Bool\n104|        public var labels: [String]\n105|        public var group: String?\n106|        public var updatedAt: Date?\n107|        public var stale: Bool\n108|        public var syncError: String?\n109|        public init(\n110|            online: Bool? = nil, busy: Bool? = nil, busyKnown: Bool = false,\n111|            labels: [String] = [], group: String? = nil,\n112|            updatedAt: Date? = nil, stale: Bool = true, syncError: String? = nil\n113|        ) {\n114|            self.online = online; self.busy = busy; self.busyKnown = busyKnown\n115|            self.labels = labels; self.group = group\n116|            self.updatedAt = updatedAt; self.stale = stale; self.syncError = syncError\n117|        }\n118|        /// Truthful GitHub signature. Stale `busy=false` is never presented\n119|        /// as proof of an idle runner.\n120|        public var signature: String {\n121|            if stale { return \"GitHub: данные устарели\" }\n122|            if let error = syncError, !error.isEmpty { return \"GitHub: \\(error)\" }\n123|            guard let online else { return \"GitHub: не подключён\" }\n124|            if !online { return \"GitHub: не в сети\" }\n125|            if !busyKnown { return \"GitHub: занятость неизвестна\" }\n126|            return (busy == true) ? \"GitHub: занят\" : \"GitHub: готов\"\n127|        }\n128|    }\n129|    public struct Snapshot: Identifiable, Sendable, Equatable {\n130|        public let definition: Definition\n131|        public var status: Status\n132|        public var message: String?\n133|        public var remote: RemoteObservation?\n134|        public var operation: OperationPhase\n135|        public var observedAt: Date?\n136|        public var id: String { definition.id }\n137|        public init(\n138|            definition: Definition, status: Status = .checking, message: String? = nil,\n139|            remote: RemoteObservation? = nil, operation: OperationPhase = .idle,\n140|            observedAt: Date? = nil\n141|        ) {\n142|            self.definition = definition; self.status = status; self.message = message\n143|            self.remote = remote; self.operation = operation; self.observedAt = observedAt\n144|        }\n145|    }\n146|\n147|    /// Immutable verified registration tuple captured when group access is\n148|    /// loaded. Apply consumes this tuple and refuses when the current\n149|    /// disk/catalog identity no longer matches it, instead of reconstructing\n150|    /// authority from mutable current inputs. A relocation or scope/server\n151|    /// change invalidates the editor and requires an explicit Load.\n152|    public struct EditorAuthority: Sendable, Equatable {\n153|        public let serverHost: String\n154|        public let org: String\n155|        public let agentID: Int64\n156|        public let agentName: String\n157|        public let canonicalPath: String\n158|        public let localID: String\n159|        public init(serverHost: String, org: String, agentID: Int64, agentName: String, canonicalPath: String, localID: String) {\n160|            self.serverHost = serverHost; self.org = org\n161|            self.agentID = agentID; self.agentName = agentName\n162|            self.canonicalPath = canonicalPath; self.localID = localID\n163|        }\n164|    }\n165|\n166|    /// Fresh API group membership for one org runner. Local `.runner`\n167|    /// pool fields can lag server-side moves, so display and access editing\n168|    /// always use this API answer, matched by agent ID, never by name.\n169|    public struct GroupAccess: Sendable, Equatable {\n170|        public var group: RunnerRegistration.RunnerGroup?\n171|        public var repoIDs: [Int64]\n172|        public var updatedAt: Date?\n173|        /// True when this Mac created or explicitly took over the group on\n174|        /// this server (locally recorded ownership). Shared/imported groups\n175|        /// require explicit takeover before any edit.\n176|        public var owned: Bool\n177|        public var loading: Bool\n178|        public var error: String?\n179|        /// Immutable authority this editor was verified against. Nil for\n180|        /// legacy/loading states without a verified load.\n181|        public var authority: EditorAuthority?\n182|        public init(\n183|            group: RunnerRegistration.RunnerGroup? = nil,\n184|            repoIDs: [Int64] = [],\n185|            updatedAt: Date? = nil,\n186|            owned: Bool = false,\n187|            loading: Bool = false,\n188|            error: String? = nil,\n189|            authority: EditorAuthority? = nil\n190|        ) {\n191|            self.group = group; self.repoIDs = repoIDs; self.updatedAt = updatedAt\n192|            self.owned = owned; self.loading = loading; self.error = error\n193|            self.authority = authority\n194|        }\n195|    }\n196|    /// Stop-confirmation copy. Busy, unknown and stale states are never\n197|    /// silently treated as idle; the first universal version always confirms\n198|    /// stopping a running service.\n199|    public enum StopConfirmation {\n200|        /// True when stopping may interrupt a job: busy, unknown, stale,\n201|        /// disconnected, or error. Only a fresh idle observation returns false,\n202|        /// and even that still confirms (race with new job assignment).\n203|        public static func mayInterrupt(remote: RemoteObservation?) -> Bool {\n204|            guard let remote, !remote.stale, remote.syncError == nil else { return true }\n205|            guard remote.busyKnown, let busy = remote.busy else { return true }\n206|            return busy\n207|        }\n208|\n209|        public static func message(remote: RemoteObservation?, runnerTitle: String) -> String {\n210|            if let remote, !remote.stale, remote.syncError == nil, remote.busyKnown, remote.busy == true {\n211|                return \"На раннере «\\(runnerTitle)» выполняется задача. Выключение прервёт её.\"\n212|            }\n213|            if let remote, !remote.stale, remote.syncError == nil, remote.busyKnown, remote.busy == false {\n214|                return \"Раннер «\\(runnerTitle)» сейчас свободен, но новая задача может быть назначена в любой момент. Остановить службу?\"\n215|            }\n216|            return \"Занятость раннера «\\(runnerTitle)» неизвестна (GitHub не подключён, данные устарели или runner не найден). Выключение может прервать задачу.\"\n217|        }\n218|    }\n219|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c635","stream":{"kind":"session","id":"01a0a9ec-c2bb-7943-8be0-a404f5b08a54"},"sequence":373,"recorded_at":1780531400000741,"record_type":"event","durability":"durable","causation_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","run_stream":{"kind":"run","id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b"},"call_id":"call_01a0a9ee057f722c8e8eb9eacc6a9615","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n1|import CryptoKit\n2|import Foundation\n3|\n4|/// Filesystem installer for downloaded GitHub Actions runners.\n5|///\n6|/// Production path: download bytes → SHA-256 verify → tar extract →\n7|/// `bin/runsvc.sh` copied into the root and chmodded (as official `svc.sh`\n8|/// would) → exact `config.sh` invocation → manual LaunchAgent plist.\n9|/// All side effects stay below `installRoot`; tests inject a temporary root,\n10|/// a fake downloader, and fixtures instead of touching production runners.\n11|public actor RunnerInstallerService {\n12|    public static let markerFileName = \".runnercontrol-install.json\"\n13|    public static let installOS = \"osx\"\n14|\n15|    private let installRoot: URL\n16|    private let downloader: @Sendable (URL) async throws -> Data\n17|    private let executor: any CommandExecuting\n18|    private let currentArch: @Sendable () -> String\n19|    private let hasher: @Sendable (Data) -> String\n20|\n21|    public init(\n22|        installRoot: URL? = nil,\n23|        downloader: (@Sendable (URL) async throws -> Data)? = nil,\n24|        executor: (any CommandExecuting)? = nil,\n25|        currentArch: (@Sendable () -> String)? = nil,\n26|        hasher: (@Sendable (Data) -> String)? = nil\n27|    ) {\n28|        self.installRoot = installRoot\n29|            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/GitHubActions\")\n30|        self.downloader = downloader ?? { url in\n31|            let (data, _) = try await URLSession.shared.data(from: url)\n32|            return data\n33|        }\n34|        self.executor = executor ?? CommandExecutor()\n35|        self.currentArch = currentArch ?? {\n36|            #if arch(arm64)\n37|            return \"arm64\"\n38|            #else\n39|            return \"x64\"\n40|            #endif\n41|        }\n42|        self.hasher = hasher ?? { data in\n43|            SHA256.hash(data: data).map { String(format: \"%02x\", $0) }.joined()\n44|        }\n45|    }\n46|\n47|    public nonisolated var root: URL { installRoot }\n48|    public nonisolated var architecture: String { currentArch() }\n49|\n50|    /// Single installer-wide mutation lease. The registration wizard runs\n51|    /// ONE active mutating installer operation per app instance\n52|    /// (download/extract, config.sh, service setup, partial recovery),\n53|    /// for ANY directory. Acquired synchronously before the first await and\n54|    /// released only when the owning operation settles, so actor reentrancy\n55|    /// can never admit two concurrent mutations — no path-identity\n56|    /// comparison, and therefore no filesystem-alias bypass class\n57|    /// (symlinks, case variants, Unicode equivalences). Abandoning a UI\n58|    /// generation does not release this resource; only the settling side\n59|    /// effect does. Ordinary start/stop of already-installed runners and\n60|    /// multiple installed CI runners are unaffected: they never take this\n61|    /// lease.\n62|    private var activeOperation: UUID?\n63|    /// Directory the lease owner is mutating. Diagnostic only: refusal never\n64|    /// compares paths, it refuses whenever a lease is held.\n65|    private var activePath: String?\n66|\n67|    public func directory(for installDirName: String) -> URL {\n68|        installRoot.appendingPathComponent(installDirName)\n69|    }\n70|\n71|    private nonisolated static func isSymlink(atPath path: String) -> Bool {\n72|        (try? FileManager.default.destinationOfSymbolicLink(atPath: path)) != nil\n73|    }\n74|\n75|    /// Refuses Finder-alias installation paths before any side effect. A\n76|    /// Finder alias is not a transparent directory like a symlink: operating\n77|    /// through its spelling would not operate on the target, so alias\n78|    /// spellings are rejected instead of being followed. Symlinks are not\n79|    /// refused here — and must be excluded explicitly because\n80|    /// `isAliasFileKey` is also true for symlinks such as the system `/var`\n81|    /// and `/tmp` links every temporary path resolves through. Concurrent\n82|    /// symlink-alias mutations are serialized by the installer-wide lease,\n83|    /// which compares nothing about paths.\n84|    nonisolated static func ensureNoAlias(at directory: URL) throws {\n85|        var current = URL(fileURLWithPath: directory.path).standardizedFileURL\n86|        while true {\n87|            if FileManager.default.fileExists(atPath: current.path),\n88|               !isSymlink(atPath: current.path),\n89|               (try? current.resourceValues(forKeys: [.isAliasFileKey]))?.isAliasFile == true {\n90|                throw RunnerRegistration.RegistrationError.invalidDraft(\n91|                    \"Installation path '\\(directory.path)' resolves through a Finder alias at '\\(current.path)'. Choose a direct folder path instead of an alias.\"\n92|                )\n93|            }\n94|            let parent = current.deletingLastPathComponent()\n95|            if parent.path == current.path { break }\n96|            current = parent\n97|        }\n98|    }\n99|\n100|    /// Acquires the installer-wide mutation lease for `directory`.\n101|    /// Synchronous: callers must invoke it before their first await so the\n102|    /// check-and-set is atomic under actor isolation. Throws a retryable\n103|    /// `installerBusy` whenever ANY live operation holds the lease,\n104|    /// regardless of directory — there is no path comparison to bypass.\n105|    /// Returns the owner token; the caller must hold it across awaits and\n106|    /// release that exact token when the operation settles.\n107|    private func acquireMutationLease(for directory: URL) throws -> UUID {\n108|        try Self.ensureNoAlias(at: directory)\n109|        guard activeOperation == nil else {\n110|            throw RunnerRegistration.RegistrationError.installerBusy(path: directory.path)\n111|        }\n112|        let token = UUID()\n113|        activeOperation = token\n114|        activePath = directory.path\n115|        return token\n116|    }\n117|\n118|    /// Releases the installer-wide lease, but only for its exact owner. A\n119|    /// token that does not match the current owner releases nothing, so a\n120|    /// stale or foreign completion can never unlock a newer operation.\n121|    private func releaseMutationLease(_ token: UUID) {\n122|        guard activeOperation == token else { return }\n123|        activeOperation = nil\n124|        activePath = nil\n125|    }\n126|\n127|    /// Refuses a synchronous mutation (service setup, recovery) while the\n128|    /// installer lease is held by a live async side effect. No insert:\n129|    /// without an await the caller itself cannot interleave, it only needs\n130|    /// to respect the lease held by another operation. Refuses for ANY\n131|    /// directory while ANY mutation is live.\n132|    private func requireIdleInstaller(_ directory: URL) throws {\n133|        try Self.ensureNoAlias(at: directory)\n134|        guard activeOperation == nil else {\n135|            throw RunnerRegistration.RegistrationError.installerBusy(path: directory.path)\n136|        }\n137|    }\n138|\n139|    // MARK: - Idempotency markers\n140|\n141|    public struct Marker: Codable, Sendable, Equatable {\n142|        public var scopeKey: String\n143|        public var completedSteps: Set<String>\n144|        /// Server the directory was configured against (`.runner` host is\n145|        /// authoritative; this records the config-time expectation so a\n146|        /// group/server change cannot reuse an old configured marker).\n147|        public var serverHost: String?\n148|        /// Dedicated group passed to `config.sh --runnergroup` (org scope).\n149|        /// `.runner` does not record it, so the marker must: a group-name\n150|        /// edit never claims the old group's configuration as its own.\n151|        public var groupName: String?\n152|        public init(\n153|            scopeKey: String, completedSteps: Set<String> = [],\n154|            serverHost: String? = nil, groupName: String? = nil\n155|        ) {\n156|            self.scopeKey = scopeKey; self.completedSteps = completedSteps\n157|            self.serverHost = serverHost; self.groupName = groupName\n158|        }\n159|    }\n160|\n161|    public static let stepDownloaded = \"downloaded\"\n162|    public static let stepInstalled = \"installed\"\n163|    public static let stepConfigured = \"configured\"\n164|    public static let stepServiceReady = \"serviceReady\"\n165|\n166|    public func loadMarker(directory: URL) -> Marker? {\n167|        let url = directory.appendingPathComponent(Self.markerFileName)\n168|        guard let data = try? Data(contentsOf: url) else { return nil }\n169|        return try? JSONDecoder().decode(Marker.self, from: data)\n170|    }\n171|\n172|    private func storeMarker(_ marker: Marker, directory: URL) throws {\n173|        let data = try JSONEncoder().encode(marker)\n174|        try data.write(to: directory.appendingPathComponent(Self.markerFileName), options: .atomic)\n175|    }\n176|\n177|    public func markCompleted(\n178|        _ step: String, directory: URL, scopeKey: String,\n179|        serverHost: String? = nil, groupName: String? = nil\n180|    ) throws {\n181|        var marker = loadMarker(directory: directory) ?? Marker(scopeKey: scopeKey)\n182|        marker.completedSteps.insert(step)\n183|        if let serverHost { marker.serverHost = serverHost }\n184|        if let groupName { marker.groupName = groupName }\n185|        try storeMarker(marker, directory: directory)\n186|    }\n187|\n188|    public func hasCompleted(_ step: String, directory: URL) -> Bool {\n189|        loadMarker(directory: directory)?.completedSteps.contains(step) == true\n190|    }\n191|\n192|    // MARK: - Install\n193|\n194|    /// Downloads, verifies, and extracts the official package. Idempotent:\n195|    /// a completed `installed` marker with matching scope and server skips\n196|    /// the work. Refuses to overwrite an already-registered directory (no\n197|    /// duplicates).\n198|    public func downloadAndInstall(\n199|        asset: RunnerRegistration.DownloadAsset,\n200|        draft: RunnerRegistration.Draft,\n201|        serverHost: String? = nil\n202|    ) async throws -> URL {\n203|        try RunnerRegistration.Gates.validateNoSpace(\n204|            installDirName: draft.installDirName, workFolder: draft.workFolder\n205|        )\n206|        let directory = self.directory(for: draft.installDirName)\n207|        if directory.path.contains(\" \") {\n208|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n209|        }\n210|        // Installer-wide ownership for the whole mutation, acquired before\n211|        // the first await (reuse check included): any second mutation while\n212|        // this install is live — same directory or not — is refused\n213|        // retryably instead of starting a second download/extract. The owner\n214|        // token is held across awaits and only that exact token releases.\n215|        let lease = try acquireMutationLease(for: directory)\n216|        defer { releaseMutationLease(lease) }\n217|        let files = FileManager.default\n218|        if let marker = loadMarker(directory: directory),\n219|           marker.completedSteps.contains(Self.stepInstalled),\n220|           marker.scopeKey == draft.scope.scopeKey,\n221|           Self.markerServerMatches(marker: marker, serverHost: serverHost),\n222|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n223|            return directory\n224|        }\n225|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n226|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: draft.runnerName)\n227|        }\n228|        let bytes: Data\n229|        do {\n230|            bytes = try await downloader(asset.downloadURL)\n231|        } catch {\n232|            throw RunnerRegistration.RegistrationError.network(\"Runner download failed: \\(error.localizedDescription)\")\n233|        }\n234|        // Fail closed: the official downloads endpoint documents\n235|        // `sha256_checksum`, and an install without a verified digest is\n236|        // refused rather than trusted on TLS alone.\n237|        guard let expected = asset.sha256Checksum, !expected.isEmpty else {\n238|            throw RunnerRegistration.RegistrationError.integrityMismatch\n239|        }\n240|        let actual = hasher(bytes)\n241|        guard actual.lowercased() == expected.lowercased() else {\n242|            throw RunnerRegistration.RegistrationError.integrityMismatch\n243|        }\n244|        try files.createDirectory(at: directory, withIntermediateDirectories: true)\n245|        let archive = files.temporaryDirectory.appendingPathComponent(UUID().uuidString + \"-\" + asset.filename)\n246|        defer { try? files.removeItem(at: archive) }\n247|        try bytes.write(to: archive, options: .atomic)\n248|        let result = try await executor.run(\"/usr/bin/tar\", [\"-xzf\", archive.path, \"-C\", directory.path])\n249|        guard result.code == 0 else {\n250|            throw RunnerRegistration.RegistrationError.network(\n251|                \"Runner archive extraction failed: \\(String(result.output.prefix(300)))\"\n252|            )\n253|        }\n254|        // Official packages keep runsvc.sh under bin/ until svc.sh installs it;\n255|        // a bare extraction leaves the root copy absent, so install it here.\n256|        try installRunsvc(directory: directory)\n257|        try markCompleted(\n258|            Self.stepDownloaded, directory: directory,\n259|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n260|        )\n261|        try markCompleted(\n262|            Self.stepInstalled, directory: directory,\n263|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n264|        )\n265|        return directory\n266|    }\n267|\n268|    /// Server binding for install reuse. A marker written without a server\n269|    /// (pre-revision-4) never satisfies a server-bound request: the next\n270|    /// install re-verifies instead of reusing unknown provenance. Direct\n271|    /// installer calls without a server (unit fixtures) keep the legacy\n272|    /// scope-only reuse.\n273|    static func markerServerMatches(marker: Marker, serverHost: String?) -> Bool {\n274|        guard let want = serverHost else { return true }\n275|        guard let have = marker.serverHost else { return false }\n276|        return RunnerRegistration.OperationIdentity.normalizeServerHost(have)\n277|            == RunnerRegistration.OperationIdentity.normalizeServerHost(want)\n278|    }\n279|\n280|    /// Copies official `bin/runsvc.sh` into the installation root and makes\n281|    /// it executable, mirroring what official `svc.sh install` would do.\n282|    public func installRunsvc(directory: URL) throws {\n283|        let files = FileManager.default\n284|        let source = directory.appendingPathComponent(\"bin/runsvc.sh\")\n285|        let target = directory.appendingPathComponent(\"runsvc.sh\")\n286|        guard files.fileExists(atPath: source.path) else {\n287|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing bin/runsvc.sh.\")\n288|        }\n289|        if files.fileExists(atPath: target.path) {\n290|            try files.removeItem(at: target)\n291|        }\n292|        try files.copyItem(at: source, to: target)\n293|        try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: target.path)\n294|    }\n295|\n296|    // MARK: - Configure\n297|\n298|    /// Runs the exact `config.sh` invocation. Skips when a previous attempt\n299|    /// already registered this directory (marker + `.runner` present), so\n300|    /// retries never create orphan or duplicate GitHub registrations.\n301|    /// Returns the local agent ID read back from `.runner`.\n302|    @discardableResult\n303|    public func runConfig(\n304|        directory: URL,\n305|        scopeURL: String,\n306|        token: String,\n307|        draft: RunnerRegistration.Draft,\n308|        runnerGroup: String?\n309|    ) async throws -> Int64? {\n310|        try await runConfig(\n311|            directory: directory, scopeURL: scopeURL, token: token,\n312|            draft: draft, runnerGroup: runnerGroup, replace: draft.allowReplace\n313|        )\n314|    }\n315|\n316|    /// Explicit-`replace` variant. Production callers pass\n317|    /// `draft.allowReplace`; tests drive both values.\n318|    @discardableResult\n319|    public func runConfig(\n320|        directory: URL,\n321|        scopeURL: String,\n322|        token: String,\n323|        draft: RunnerRegistration.Draft,\n324|        runnerGroup: String?,\n325|        replace: Bool\n326|    ) async throws -> Int64? {\n327|        let files = FileManager.default\n328|        let scopeHost = URL(string: scopeURL)?.host ?? \"\"\n329|        // Installer-wide ownership for the whole config, acquired before the\n330|        // first await (resume checks included): any second mutation while\n331|        // this config.sh is live is refused retryably instead of invoking\n332|        // another config.sh. The lease is released only when this operation\n333|        // settles; an abandoned UI generation never releases it. The owner\n334|        // token is held across awaits and only that exact token releases.\n335|        let lease = try acquireMutationLease(for: directory)\n336|        defer { releaseMutationLease(lease) }\n337|        if hasCompleted(Self.stepConfigured, directory: directory),\n338|           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n339|            // Idempotent resume never returns a stale ID: the existing\n340|            // configuration must still match this draft on this server.\n341|            let local = readLocalRegistration(directory: directory)\n342|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n343|                local: local, configured: true, draft: draft, serverHost: scopeHost\n344|            )\n345|            try Self.verifyConfiguredGroup(\n346|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n347|            )\n348|            return verified\n349|        }\n350|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n351|           hasCompleted(Self.stepConfigured, directory: directory) {\n352|            let local = readLocalRegistration(directory: directory)\n353|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n354|                local: local, configured: true, draft: draft, serverHost: scopeHost\n355|            )\n356|            try Self.verifyConfiguredGroup(\n357|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n358|            )\n359|            return verified\n360|        }\n361|        let spec = RunnerRegistration.ConfigSpec(\n362|            scopeURL: scopeURL, token: token, name: draft.runnerName,\n363|            workFolder: draft.workFolder, labels: draft.labels,\n364|            runnerGroup: runnerGroup, replace: replace\n365|        )\n366|        let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n367|        let executable = directory.appendingPathComponent(\"config.sh\").path\n368|        guard files.fileExists(atPath: executable) else {\n369|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n370|        }\n371|        let result = try await executor.run(executable, args)\n372|        guard result.code == 0 else {\n373|            // Never echo the token: config output may repeat arguments.\n374|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [token])\n375|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n376|        }\n377|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n378|            throw RunnerRegistration.RegistrationError.configFailed(\n379|                \"config.sh reported success but .runner is missing.\"\n380|            )\n381|        }\n382|        try markCompleted(\n383|            Self.stepConfigured, directory: directory, scopeKey: draft.scope.scopeKey,\n384|            serverHost: scopeHost, groupName: runnerGroup\n385|        )\n386|        return readAgentID(directory: directory)\n387|    }\n388|\n389|    /// `.runner` does not record the org group, so the configured marker\n390|    /// does. A resume whose marker names another group (or predates group\n391|    /// recording) refuses instead of claiming the old group's configuration\n392|    /// as the new draft's. Repository scope never configures a group.\n393|    static func verifyConfiguredGroup(\n394|        marker: Marker?, runnerGroup: String?, draft: RunnerRegistration.Draft\n395|    ) throws {\n396|        switch draft.scope {\n397|        case .repository:\n398|            return\n399|        case .organization:\n400|            break\n401|        }\n402|        let wanted = (runnerGroup ?? draft.groupName).trimmingCharacters(in: .whitespacesAndNewlines)\n403|        guard let have = marker?.groupName?.trimmingCharacters(in: .whitespacesAndNewlines),\n404|              !have.isEmpty else {\n405|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n406|                \"Directory '\\(draft.installDirName)' was configured before group recording. Reconfigure for group '\\(wanted)' instead of reusing the old configuration.\"\n407|            )\n408|        }\n409|        guard have == wanted else {\n410|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n411|                \"Local registration was configured for group '\\(have)', not '\\(wanted)'. Reconfigure instead of reusing the old group's configuration.\"\n412|            )\n413|        }\n414|    }\n415|\n416|    // MARK: - Dedicated-group ownership\n417|\n418|    public static let ownershipFileName = \".runnercontrol-groups.json\"\n419|\n420|    private func ownershipFile() -> URL {\n421|        installRoot.appendingPathComponent(Self.ownershipFileName)\n422|    }\n423|\n424|    private static func ownershipKey(serverHost: String, org: String, name: String) -> String {\n425|        \"\\(RunnerRegistration.OperationIdentity.normalizeServerHost(serverHost))\\u{0}\\(org.lowercased())\\u{0}\\(name)\"\n426|    }\n427|\n428|    /// Returns the locally recorded dedicated-group ID for\n429|    /// `server` + `org` + `name`, or nil when this Mac never created (or\n430|    /// took over) that group on that server. Name matches on GitHub alone\n431|    /// never count as ownership, and ownership on one server never\n432|    /// authorizes adoption on another.\n433|    public func loadOwnedGroupID(serverHost: String, org: String, name: String) -> Int64? {\n434|        guard let data = try? Data(contentsOf: ownershipFile()),\n435|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n436|        return table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)]\n437|    }\n438|\n439|    public func saveOwnedGroupID(serverHost: String, org: String, name: String, groupID: Int64) throws {\n440|        let file = ownershipFile()\n441|        var table: [String: Int64] = [:]\n442|        if let data = try? Data(contentsOf: file),\n443|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n444|            table = decoded\n445|        }\n446|        table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)] = groupID\n447|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n448|        let data = try JSONEncoder().encode(table)\n449|        try data.write(to: file, options: .atomic)\n450|    }\n451|\n452|    /// Reads the local `.runner` identity without touching credentials.\n453|    /// Returns nil only when the file is missing or unparseable; a present\n454|    /// but incomplete file returns a partial struct so verification can name\n455|    /// the exact missing field instead of crashing.\n456|    public func readLocalRegistration(directory: URL) -> RunnerRegistration.LocalRegistration? {\n457|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n458|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n459|        var agentID: Int64?\n460|        if let id = object[\"agentId\"] as? Int64 { agentID = id }\n461|        else if let id = object[\"agentId\"] as? Int { agentID = Int64(id) }\n462|        else if let id = object[\"agentId\"] as? NSNumber { agentID = id.int64Value }\n463|        return RunnerRegistration.LocalRegistration(\n464|            agentID: agentID,\n465|            agentName: object[\"agentName\"] as? String,\n466|            gitHubURL: object[\"gitHubUrl\"] as? String,\n467|            workFolder: object[\"workFolder\"] as? String\n468|        )\n469|    }\n470|\n471|    /// Reads the local agent ID from `.runner` without touching credentials.\n472|    public func readAgentID(directory: URL) -> Int64? {\n473|        readLocalRegistration(directory: directory)?.agentID\n474|    }\n475|\n476|    // MARK: - Manual LaunchAgent\n477|\n478|    /// Writes the manual service plist (RunAtLoad off for new runners) and\n479|    /// validates it matches the directory. Never bootstraps the service:\n480|    /// enabling is the user's separate action.\n481|    @discardableResult\n482|    public func setupService(directory: URL, label: String) throws -> URL {\n483|        guard !directory.path.contains(\" \") else {\n484|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n485|        }\n486|        // Never rewrite the service while the installer lease is held by a\n487|        // live install/config; the caller retries after that operation\n488|        // settles.\n489|        try requireIdleInstaller(directory)\n490|        let files = FileManager.default\n491|        guard files.fileExists(atPath: directory.appendingPathComponent(\"runsvc.sh\").path) else {\n492|            throw RunnerRegistration.RegistrationError.network(\n493|                \"runsvc.sh is missing; reinstall before setting up the service.\"\n494|            )\n495|        }\n496|        let plist = directory.appendingPathComponent(\"manual-service.plist\")\n497|        let payload: [String: Any] = [\n498|            \"Label\": label,\n499|            \"ProgramArguments\": [directory.appendingPathComponent(\"runsvc.sh\").path],\n500|            \"WorkingDirectory\": directory.path,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
