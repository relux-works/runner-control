sport.append(.init(status: 204, body: Data()))\n1937|    await h.transport.append(groupReposPayload([2]))\n1938|    _ = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true))\n1939|    let puts = await h.transport.requests.filter { $0.method == \"PUT\" }\n1940|    #expect(puts.count == 1)\n1941|    #expect(puts.first?.url.path.contains(\"orgs/acme/\") == true)\n1942|}\n1943|\n1944|/// R3-F1 bound: a legitimate same-identity move still changes the canonical\n1945|/// path, so it invalidates the editor and requires an explicit Load; the\n1946|/// reloaded editor then applies to the moved folder.\n1947|@Test func relinkSameIdentityMoveRequiresReload() async throws {\n1948|    let h = await catalogHarness(transportResponses: [\n1949|        groupsPayload([(4, \"g\")]), groupRunnersPayload([(42, \"r\", false)]), groupReposPayload([1])\n1950|    ])\n1951|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1952|    let label = \"actions.runner.test.relinkmove\"\n1953|    let a = try makeRunnerDir(parent: h.home, name: \"a\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1954|    try await h.catalog.add(unregisterEntry(dir: a, label: label))\n1955|    _ = await h.flow.apply(Runners.Effect.loadGroupAccess(label))\n1956|    #expect(loadedGroupAccess(h.logger, id: label)?.group?.id == 4)\n1957|    let b = try makeRunnerDir(parent: h.home, name: \"b\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1958|    _ = await h.flow.apply(Runners.Effect.relinkDirectory(label, b))\n1959|    #expect(await h.catalog.load().first?.directoryPath == b.path)\n1960|    #expect((groupAccessError(h.logger, id: label) ?? \"\").contains(\"Reload group access\"))\n1961|    _ = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true))\n1962|    #expect(await h.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1963|    await h.transport.append(groupsPayload([(4, \"g\")]))\n1964|    await h.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1965|    await h.transport.append(groupReposPayload([1]))\n1966|    _ = await h.flow.apply(Runners.Effect.loadGroupAccess(label))\n1967|    #expect(loadedGroupAccess(h.logger, id: label)?.group?.id == 4)\n1968|    await h.transport.append(groupsPayload([(4, \"g\")]))\n1969|    await h.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1970|    await h.transport.append(.init(status: 204, body: Data()))\n1971|    await h.transport.append(groupReposPayload([2]))\n1972|    _ = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true))\n1973|    #expect(await h.transport.requests.filter { $0.method == \"PUT\" }.count == 1)\n1974|    #expect(loadedGroupAccess(h.logger, id: label)?.repoIDs == [2])\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
