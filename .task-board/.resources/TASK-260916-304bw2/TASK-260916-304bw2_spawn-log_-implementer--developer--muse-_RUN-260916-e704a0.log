{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c86f","stream":{"kind":"session","id":"01a0a9ec-c2bb-7943-8be0-a404f5b08a54"},"sequence":658,"recorded_at":1780531400001311,"record_type":"event","durability":"durable","causation_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","run_stream":{"kind":"run","id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b"},"task_stream":{"kind":"task","id":"01a0a9ef-f002-7321-8a43-6d97c7e1ed8f"},"task_id":"01a0a9ef-f002-7321-8a43-6d97c7e1ed8f","event":{"kind":"output","task_id":"01a0a9ef-f002-7321-8a43-6d97c7e1ed8f","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n(1639 line(s) above)\n1640|@Test func loadGroupAccessStopsPublishingAfterMidLoadLogout() async throws {\n1641|    let h = await catalogHarness(transportResponses: [groupsPayload([(4, \"g\")]),\n1642|        groupRunnersPayload([(42, \"r\", false)]), groupReposPayload([1])])\n1643|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1644|    let label = \"actions.runner.test.loadlogout\"\n1645|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1646|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1647|    let flow = await reviewLogoutFlow(h, method: \"GET\")\n1648|    let _: Relux.ActionResult = await flow.apply(Runners.Effect.loadGroupAccess(label))\n1649|    #expect(await h.identities.load() == nil)\n1650|    #expect(loadedGroupAccess(h.logger, id: label) == nil)\n1651|    #expect(groupAccessError(h.logger, id: label) == nil)\n1652|    // Groups + runners reads happened; the repos fetch after the logout did not.\n1653|    #expect(await h.transport.requests.count == 2)\n1654|}\n1655|\n1656|private func lastUnregistering(_ logger: Relux.Testing.Logger, id: String) -> Bool? {\n1657|    for action in runnersActions(logger).reversed() {\n1658|        if case .unregistering(let target, let value) = action, target == id {\n1659|            return value\n1660|        }\n1661|    }\n1662|    return nil\n1663|}\n1664|\n1665|/// R2-F3 bound: a session-invalidated unregister releases the UI operation\n1666|/// state, so re-authenticating and retrying proceeds instead of wedging on\n1667|/// a stuck \"unregistering\" flag.\n1668|@Test func unregisterReleasesOperationStateAfterSessionLoss() async throws {\n1669|    let h = await catalogHarness(launchResults: [stopped, stopped, stopped, stopped],\n1670|        installerResults: [.init(code: 0, output: \"ok\")], transportResponses: [removeTokenPayload()])\n1671|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1672|    let label = \"actions.runner.test.unregretry\"\n1673|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1674|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1675|    let loggedOut = await reviewLogoutFlow(h, method: \"POST\")\n1676|    let _: Relux.ActionResult = await loggedOut.apply(Runners.Effect.unregister(label, confirmation: \"r\"))\n1677|    #expect(await h.identities.load() == nil)\n1678|    #expect(await h.installerExecutor.calls.isEmpty)\n1679|    #expect(lastUnregistering(h.logger, id: label) == false)\n1680|    // Re-authenticate and retry through the normal entry: the side effect proceeds.\n1681|    await h.identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n1682|    await h.transport.append(removeTokenPayload())\n1683|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.unregister(label, confirmation: \"r\"))\n1684|    #expect(await h.installerExecutor.calls.count == 1)\n1685|    #expect(await h.catalog.load().first?.remoteAgentID == nil)\n1686|}\n1687|\n1688|/// R2-F1 bound: the scope-change refusal names the drift and is recoverable\n1689|/// through explicit re-verification — remove and re-add rebinds the catalog\n1690|/// original, after which Apply targets the new org (and only it).\n1691|@Test func scopeEditThenReAddReverifiesGroupApply() async throws {\n1692|    let h = await catalogHarness(\n1693|        launchResults: [stopped, stopped],\n1694|        transportResponses: [\n1695|            groupsPayload([(4, \"g\")]),\n1696|            groupRunnersPayload([(42, \"r\", false)]),\n1697|            groupReposPayload([1])\n1698|        ]\n1699|    )\n1700|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1701|    let label = \"actions.runner.test.scopeverify\"\n1702|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1703|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1704|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.loadGroupAccess(label))\n1705|    #expect(loadedGroupAccess(h.logger, id: label)?.group?.id == 4)\n1706|    // Same-host scope edit without re-verification: refused, no PUT.\n1707|    let runner = dir.appendingPathComponent(\".runner\")\n1708|    var object = try JSONSerialization.jsonObject(with: Data(contentsOf: runner)) as! [String: Any]\n1709|    object[\"gitHubUrl\"] = \"https://github.com/other-org\"\n1710|    try JSONSerialization.data(withJSONObject: object).write(to: runner)\n1711|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true))\n1712|    #expect(await h.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1713|    let refusal = groupAccessError(h.logger, id: label) ?? \"\"\n1714|    #expect(refusal.contains(\"acme\") && refusal.contains(\"other-org\"))\n1715|    // Explicit re-verification: remove and re-add rebinds the original.\n1716|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.removeFromApp(label))\n1717|    #expect(await h.catalog.load().isEmpty)\n1718|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.importFolder(dir))\n1719|    #expect(await h.catalog.load().count == 1)\n1720|    #expect(await h.catalog.load().first?.scope == \"other-org\")\n1721|    await h.transport.append(groupsPayload([(4, \"g\")]))\n1722|    await h.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1723|    await h.transport.append(groupReposPayload([1]))\n1724|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.loadGroupAccess(label))\n1725|    #expect(loadedGroupAccess(h.logger, id: label)?.group?.id == 4)\n1726|    await h.transport.append(groupsPayload([(4, \"g\")]))\n1727|    await h.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1728|    await h.transport.append(.init(status: 204, body: Data()))\n1729|    await h.transport.append(groupReposPayload([2]))\n1730|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true))\n1731|    let puts = await h.transport.requests.filter { $0.method == \"PUT\" }\n1732|    #expect(puts.count == 1)\n1733|    #expect(puts.first?.url.path.contains(\"orgs/other-org/\") == true)\n1734|    #expect(loadedGroupAccess(h.logger, id: label)?.repoIDs == [2])\n1735|}\n1736|\n1737|// MARK: - R4 reviewer regressions (rev3 verdict, adopted probes + bounds)\n1738|\n1739|// The three exact rev3 reviewer probes, adopted as maintained\n1740|// production-entry regressions. Each failed on the rev3 candidate (exit 1,\n1741|// 5 assertion failures) and passes now. The session probes drive the real\n1742|// GitHubAuth.Flow logout + Device Flow re-login (same account/server) while\n1743|// the catalog operation awaits; only HTTP/Keychain are fake.\n1744|\n1745|private actor ReviewR3ReloginTransport: GitHubHTTPTransport {\n1746|    let base: TestTransport\n1747|    let auth: GitHubAuth.Flow\n1748|    let authLogger: Relux.Testing.Logger\n1749|    let method: String\n1750|    private var fired = false\n1751|    init(base: TestTransport, auth: GitHubAuth.Flow, logger: Relux.Testing.Logger, method: String) {\n1752|        self.base = base; self.auth = auth; self.authLogger = logger; self.method = method\n1753|    }\n1754|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n(more lines below)","final_result":true}}}
