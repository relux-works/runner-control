{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7fd","stream":{"kind":"session","id":"01a0a9ec-c2bb-7943-8be0-a404f5b08a54"},"sequence":601,"recorded_at":1780531400001197,"record_type":"event","durability":"durable","causation_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","run_stream":{"kind":"run","id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b"},"task_stream":{"kind":"task","id":"01a0a9ef-a3fc-77f2-8ddb-f33c296d6366"},"task_id":"01a0a9ef-a3fc-77f2-8ddb-f33c296d6366","event":{"kind":"output","task_id":"01a0a9ef-a3fc-77f2-8ddb-f33c296d6366","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRuntime.swift`.\n1|import Foundation\n2|import Relux\n3|import OSLog\n4|@MainActor public enum RunnerRuntime {\n5|    public static func make(state: Runners.State, service: any RunnerServicing = LaunchAgentService()) async -> Relux {\n6|        let runtime = await Relux(logger: RuntimeLogger())\n7|        let flow = await Runners.Flow(service: service, dispatcher: runtime.dispatcher)\n8|        runtime.register(Runners.Module(state: state, flow: flow))\n9|        return runtime\n10|    }\n11|\n12|    public static func make(\n13|        state: Runners.State,\n14|        githubState: GitHubAuth.State,\n15|        service: (any RunnerServicing)? = nil,\n16|        transport: any GitHubHTTPTransport = URLSessionGitHubTransport(),\n17|        store: any GitHubCredentialStoring = GitHubKeychainStore()\n18|    ) async -> Relux {\n19|        let registrationState = await MainActor.run { RunnerRegistration.State() }\n20|        return await make(state: state, githubState: githubState, registrationState: registrationState, service: service, transport: transport, store: store)\n21|    }\n22|\n23|    public static func make(\n24|        state: Runners.State,\n25|        githubState: GitHubAuth.State,\n26|        registrationState: RunnerRegistration.State,\n27|        service: (any RunnerServicing)? = nil,\n28|        transport: any GitHubHTTPTransport = URLSessionGitHubTransport(),\n29|        store: any GitHubCredentialStoring = GitHubKeychainStore()\n30|    ) async -> Relux {\n31|        let runtime = await Relux(logger: RuntimeLogger())\n32|        // One shared installer for registration and catalog unregister/recovery:\n33|        // installer mutations serialize app-wide until side effects settle.\n34|        // Ordinary start/stop of installed runners never takes this lease.\n35|        let installer = RunnerInstallerService()\n36|        let catalog = RunnerCatalogStore()\n37|        let resolvedService: any RunnerServicing = service ?? LaunchAgentService(catalog: catalog)\n38|        let identities = UserDefaultsGitHubSessionIdentityStore()\n39|        let runnerAPI = GitHubRunnerAPIClient(transport: transport)\n40|        let refresher = GitHubTokenRefresh(transport: transport, store: store)\n41|        let flow = await Runners.Flow(\n42|            service: resolvedService, catalog: catalog, installer: installer,\n43|            api: runnerAPI, userStore: store, identities: identities,\n44|            refresher: refresher, dispatcher: runtime.dispatcher\n45|        )\n46|        runtime.register(Runners.Module(state: state, flow: flow))\n47|        let deviceFlow = GitHubDeviceFlow(transport: transport)\n48|        let api = GitHubAPIClient(transport: transport)\n49|        let githubFlow = await GitHubAuth.Flow(deviceFlow: deviceFlow, api: api, refresher: refresher, store: store, identityStore: identities, dispatcher: runtime.dispatcher)\n50|        runtime.register(GitHubAuth.Module(state: githubState, flow: githubFlow))\n51|        let registrationTokens = RunnerRegistrationTokenStore()\n52|        let registrationFlow = await RunnerRegistration.Flow(\n53|            api: runnerAPI, installer: installer, registrationTokens: registrationTokens,\n54|            userStore: store, identityStore: identities,\n55|            refresher: refresher, dispatcher: runtime.dispatcher\n56|        )\n57|        runtime.register(RunnerRegistration.Module(state: registrationState, flow: registrationFlow))\n58|        return runtime\n59|    }\n60|}\n61|struct RuntimeLogger: Relux.Logger {\n62|    func logAction(_ action: Relux.EnumReflectable, result: Relux.ActionResult?, startTimeInMillis: Int, privacy: Relux.OSLogPrivacy, fileID: String, functionName: String, lineNumber: Int) {\n63|        Logger(subsystem: \"works.relux.runnercontrol\", category: \"state\").debug(\"State event: \\(String(describing: type(of: action)), privacy: .public)\")\n64|    }\n65|}","final_result":true}}}
