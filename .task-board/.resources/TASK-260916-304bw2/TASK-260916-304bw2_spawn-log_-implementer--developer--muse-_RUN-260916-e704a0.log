{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c629","stream":{"kind":"session","id":"01a0a9ec-c2bb-7943-8be0-a404f5b08a54"},"sequence":367,"recorded_at":1780531400000729,"record_type":"event","durability":"durable","causation_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","payload_type":"task.lifecycle.started","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","run_stream":{"kind":"run","id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b"},"task_stream":{"kind":"task","id":"01a0a9ee-0a3e-7831-8d9d-328ceb8a4824"},"task_id":"01a0a9ee-0a3e-7831-8d9d-328ceb8a4824","event":{"kind":"started","task_id":"01a0a9ee-0a3e-7831-8d9d-328ceb8a4824","span_id":"4e623c09fce6de9e"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62b","stream":{"kind":"session","id":"01a0a9ec-c2bb-7943-8be0-a404f5b08a54"},"sequence":368,"recorded_at":1780531400000731,"record_type":"event","durability":"durable","causation_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","run_stream":{"kind":"run","id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b"},"task_stream":{"kind":"task","id":"01a0a9ee-09cd-7520-9d0a-0de94b4772bd"},"task_id":"01a0a9ee-09cd-7520-9d0a-0de94b4772bd","event":{"kind":"output","task_id":"01a0a9ee-09cd-7520-9d0a-0de94b4772bd","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+Models.swift`.\n1|import Foundation\n2|extension Runners {\n3|    public struct Definition: Identifiable, Sendable, Equatable {\n4|        public let id: String\n5|        public let title: String\n6|        public let detail: String\n7|        public let directory: URL\n8|        public let githubURL: URL\n9|        private let servicePlist: URL?\n10|        /// Catalog identity. Nil for legacy discovery-only rows.\n11|        public let localID: String?\n12|        public let controllerKind: ControllerKind\n13|        /// Preserved launch-at-login policy of the imported service.\n14|        /// Nil means unknown (e.g. unsupported control).\n15|        public let runAtLoad: Bool?\n16|        /// User display override. Renaming on GitHub never changes identity.\n17|        public let displayName: String?\n18|        public let serverHost: String?\n19|        public let remoteAgentID: Int64?\n20|        public let workFolder: String?\n21|        public init(\n22|            id: String, title: String, detail: String, directory: URL, githubURL: URL,\n23|            servicePlist: URL? = nil, localID: String? = nil,\n24|            controllerKind: ControllerKind? = nil, runAtLoad: Bool? = nil,\n25|            displayName: String? = nil, serverHost: String? = nil,\n26|            remoteAgentID: Int64? = nil, workFolder: String? = nil,\n27|            loginEnabled: Bool? = nil\n28|        ) {\n29|            self.id = id; self.title = title; self.detail = detail\n30|            self.directory = directory; self.githubURL = githubURL; self.servicePlist = servicePlist\n31|            self.localID = localID\n32|            if let controllerKind {\n33|                self.controllerKind = controllerKind\n34|            } else {\n35|                let path = (servicePlist ?? directory.appendingPathComponent(\"manual-service.plist\")).path\n36|                self.controllerKind = path.contains(\"/Library/LaunchAgents/\") ? .standardLaunchAgent : .manualManaged\n37|            }\n38|            self.runAtLoad = runAtLoad\n39|            self.displayName = displayName\n40|            self.serverHost = serverHost\n41|            self.remoteAgentID = remoteAgentID\n42|            self.workFolder = workFolder\n43|            self.loginEnabled = loginEnabled\n44|        }\n45|        public var plist: URL { servicePlist ?? directory.appendingPathComponent(\"manual-service.plist\") }\n46|        /// Effective login-start behavior. Standard manifests use their own\n47|        /// RunAtLoad; external manual plists are ON only when a matching\n48|        /// registration exists in `~/Library/LaunchAgents` with RunAtLoad\n49|        /// true — RunAtLoad outside LaunchAgents never persists login start.\n50|        /// Nil means unknown (e.g. unsupported control).\n51|        public let loginEnabled: Bool?\n52|        public func withLoginEnabled(_ value: Bool?) -> Definition {\n53|            Definition(\n54|                id: id, title: title, detail: detail, directory: directory,\n55|                githubURL: githubURL, servicePlist: servicePlist, localID: localID,\n56|                controllerKind: controllerKind, runAtLoad: runAtLoad,\n57|                displayName: displayName, serverHost: serverHost,\n58|                remoteAgentID: remoteAgentID, workFolder: workFolder,\n59|                loginEnabled: value\n60|            )\n61|        }\n62|        /// Display title: user alias wins, otherwise the registration name.\n63|        public var displayTitle: String {\n64|            if let displayName, !displayName.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {\n65|                return displayName\n66|            }\n67|            return title\n68|        }\n69|        /// Legacy log directory fallback. Production log access resolves the\n70|        /// actual StandardOutPath/StandardErrorPath from the manifest plus\n71|        /// `_diag` via `RunnerDiagnostics`; this path is only a fallback.\n72|        public var logs: URL { FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/Logs/\" + id) }\n73|        public static func installed(home: URL = FileManager.default.homeDirectoryForCurrentUser) -> [Self] {\n74|            RunnerDiscovery.installed(home: home)\n75|        }\n76|    }\n77|    public enum Status: String, Sendable, Equatable {\n78|        case checking, stopped, starting, running, stopping, failed, missing, needsSetup, unknown\n79|        public var title: String {\n80|            switch self {\n81|            case .checking: \"Проверяем…\"\n82|            case .stopped: \"Выключен\"\n83|            case .starting: \"Запускается\"\n84|            case .running: \"Служба включена\"\n85|            case .stopping: \"Выключается\"\n86|            case .failed: \"Ошибка службы\"\n87|            case .missing: \"Раннер не найден\"\n88|            case .needsSetup: \"Требуется настройка\"\n89|            case .unknown: \"Статус недоступен\"\n90|            }\n91|        }\n92|    }\n93|    /// Operation phase for one row. Only the affected row is locked.\n94|    public enum OperationPhase: String, Sendable, Equatable {\n95|        case idle, starting, stopping\n96|    }\n97|    /// GitHub observation kept separate from the local service state.\n98|    /// Loss of network never turns a running service into a stopped one.\n99|    public struct RemoteObservation: Sendable, Equatable {\n100|        public var online: Bool?\n101|        public var busy: Bool?\n102|        /// False when GitHub is disconnected, stale, or the runner is absent.\n103|        public var busyKnown: Bool\n104|        public var labels: [String]\n105|        public var group: String?\n106|        public var updatedAt: Date?\n107|        public var stale: Bool\n108|        public var syncError: String?\n109|        public init(\n110|            online: Bool? = nil, busy: Bool? = nil, busyKnown: Bool = false,\n111|            labels: [String] = [], group: String? = nil,\n112|            updatedAt: Date? = nil, stale: Bool = true, syncError: String? = nil\n113|        ) {\n114|            self.online = online; self.busy = busy; self.busyKnown = busyKnown\n115|            self.labels = labels; self.group = group\n116|            self.updatedAt = updatedAt; self.stale = stale; self.syncError = syncError\n117|        }\n118|        /// Truthful GitHub signature. Stale `busy=false` is never presented\n119|        /// as proof of an idle runner.\n120|        public var signature: String {\n121|            if stale { return \"GitHub: данные устарели\" }\n122|            if let error = syncError, !error.isEmpty { return \"GitHub: \\(error)\" }\n123|            guard let online else { return \"GitHub: не подключён\" }\n124|            if !online { return \"GitHub: не в сети\" }\n125|            if !busyKnown { return \"GitHub: занятость неизвестна\" }\n126|            return (busy == true) ? \"GitHub: занят\" : \"GitHub: готов\"\n127|        }\n128|    }\n129|    public struct Snapshot: Identifiable, Sendable, Equatable {\n130|        public let definition: Definition\n131|        public var status: Status\n132|        public var message: String?\n133|        public var remote: RemoteObservation?\n134|        public var operation: OperationPhase\n135|        public var observedAt: Date?\n136|        public var id: String { definition.id }\n137|        public init(\n138|            definition: Definition, status: Status = .checking, message: String? = nil,\n139|            remote: RemoteObservation? = nil, operation: OperationPhase = .idle,\n140|            observedAt: Date? = nil\n141|        ) {\n142|            self.definition = definition; self.status = status; self.message = message\n143|            self.remote = remote; self.operation = operation; self.observedAt = observedAt\n144|        }\n145|    }\n146|\n147|    /// Immutable verified registration tuple captured when group access is\n148|    /// loaded. Apply consumes this tuple and refuses when the current\n149|    /// disk/catalog identity no longer matches it, instead of reconstructing\n150|    /// authority from mutable current inputs. A relocation or scope/server\n151|    /// change invalidates the editor and requires an explicit Load.\n152|    public struct EditorAuthority: Sendable, Equatable {\n153|        public let serverHost: String\n154|        public let org: String\n155|        public let agentID: Int64\n156|        public let agentName: String\n157|        public let canonicalPath: String\n158|        public let localID: String\n159|        public init(serverHost: String, org: String, agentID: Int64, agentName: String, canonicalPath: String, localID: String) {\n160|            self.serverHost = serverHost; self.org = org\n161|            self.agentID = agentID; self.agentName = agentName\n162|            self.canonicalPath = canonicalPath; self.localID = localID\n163|        }\n164|    }\n165|\n166|    /// Fresh API group membership for one org runner. Local `.runner`\n167|    /// pool fields can lag server-side moves, so display and access editing\n168|    /// always use this API answer, matched by agent ID, never by name.\n169|    public struct GroupAccess: Sendable, Equatable {\n170|        public var group: RunnerRegistration.RunnerGroup?\n171|        public var repoIDs: [Int64]\n172|        public var updatedAt: Date?\n173|        /// True when this Mac created or explicitly took over the group on\n174|        /// this server (locally recorded ownership). Shared/imported groups\n175|        /// require explicit takeover before any edit.\n176|        public var owned: Bool\n177|        public var loading: Bool\n178|        public var error: String?\n179|        /// Immutable authority this editor was verified against. Nil for\n180|        /// legacy/loading states without a verified load.\n181|        public var authority: EditorAuthority?\n182|        public init(\n183|            group: RunnerRegistration.RunnerGroup? = nil,\n184|            repoIDs: [Int64] = [],\n185|            updatedAt: Date? = nil,\n186|            owned: Bool = false,\n187|            loading: Bool = false,\n188|            error: String? = nil,\n189|            authority: EditorAuthority? = nil\n190|        ) {\n191|            self.group = group; self.repoIDs = repoIDs; self.updatedAt = updatedAt\n192|            self.owned = owned; self.loading = loading; self.error = error\n193|            self.authority = authority\n194|        }\n195|    }\n196|    /// Stop-confirmation copy. Busy, unknown and stale states are never\n197|    /// silently treated as idle; the first universal version always confirms\n198|    /// stopping a running service.\n199|    public enum StopConfirmation {\n200|        /// True when stopping may interrupt a job: busy, unknown, stale,\n201|        /// disconnected, or error. Only a fresh idle observation returns false,\n202|        /// and even that still confirms (race with new job assignment).\n203|        public static func mayInterrupt(remote: RemoteObservation?) -> Bool {\n204|            guard let remote, !remote.stale, remote.syncError == nil else { return true }\n205|            guard remote.busyKnown, let busy = remote.busy else { return true }\n206|            return busy\n207|        }\n208|\n209|        public static func message(remote: RemoteObservation?, runnerTitle: String) -> String {\n210|            if let remote, !remote.stale, remote.syncError == nil, remote.busyKnown, remote.busy == true {\n211|                return \"На раннере «\\(runnerTitle)» выполняется задача. Выключение прервёт её.\"\n212|            }\n213|            if let remote, !remote.stale, remote.syncError == nil, remote.busyKnown, remote.busy == false {\n214|                return \"Раннер «\\(runnerTitle)» сейчас свободен, но новая задача может быть назначена в любой момент. Остановить службу?\"\n215|            }\n216|            return \"Занятость раннера «\\(runnerTitle)» неизвестна (GitHub не подключён, данные устарели или runner не найден). Выключение может прервать задачу.\"\n217|        }\n218|    }\n219|}","final_result":true}}}
