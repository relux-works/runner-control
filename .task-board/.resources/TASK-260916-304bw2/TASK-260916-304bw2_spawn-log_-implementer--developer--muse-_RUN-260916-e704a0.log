        .disabled(access.loading || draft == loaded)\n340|                        Button(\"Обновить\") { reactions.loadGroupAccess(definition.id) }\n341|                            .buttonStyle(.bordered).controlSize(.small)\n342|                            .disabled(access.loading)\n343|                        if access.loading { ProgressView().controlSize(.small) }\n344|                    }\n345|                    .onChange(of: access.repoIDs) { accessDrafts.removeValue(forKey: definition.id) }\n346|                }\n347|            } else if access?.loading == true {\n348|                HStack(spacing: 8) {\n349|                    ProgressView().controlSize(.small)\n350|                    Text(\"Загружаем текущую группу из GitHub…\").font(.callout).foregroundStyle(.secondary)\n351|                }\n352|            } else {\n353|                if let error = access?.error {\n354|                    Text(error).font(.caption).foregroundStyle(.orange).textSelection(.enabled).lineLimit(4)\n355|                } else {\n356|                    Text(\"Группа определяется свежим составом GitHub, а не локальным .runner.\")\n357|                        .font(.system(size: 11)).foregroundStyle(.secondary)\n358|                }\n359|                Button(\"Загрузить текущий доступ\") { reactions.loadGroupAccess(definition.id) }\n360|                    .buttonStyle(.bordered).controlSize(.small)\n361|            }\n362|        }\n363|    }\n364|\n365|    private func detailRow(_ title: String, _ value: String) -> some View {\n366|        VStack(alignment: .leading, spacing: 2) {\n367|            Text(title).font(.system(size: 10)).foregroundStyle(.secondary)\n368|            Text(value).font(.system(size: 11)).textSelection(.enabled).lineLimit(3)\n369|        }\n(more lines below)","final_result":true}}}
