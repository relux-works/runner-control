{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8e1","stream":{"kind":"session","id":"01a0a9ec-c2bb-7943-8be0-a404f5b08a54"},"sequence":715,"recorded_at":1780531400001425,"record_type":"event","durability":"durable","causation_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","run_stream":{"kind":"run","id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b"},"task_stream":{"kind":"task","id":"01a0a9f0-1a3e-77f0-97e6-068ff7e5a625"},"task_id":"01a0a9f0-1a3e-77f0-97e6-068ff7e5a625","event":{"kind":"output","task_id":"01a0a9f0-1a3e-77f0-97e6-068ff7e5a625","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n(1299 line(s) above)\n1300|    #expect(catalogErr(harness.logger).contains(\"Stop the runner first\"))\n1301|    #expect(await harness.installerExecutor.calls.isEmpty)\n1302|    #expect(await harness.catalog.load().first?.remoteAgentID == 42)\n1303|}\n1304|\n1305|/// Session double that returns `first` for the first `flipAfter` loads and\n1306|/// `later` afterwards: a deterministic mid-operation logout.\n1307|private final class FlippingSessionStore: GitHubSessionIdentityStoring, @unchecked Sendable {\n1308|    private let lock = NSLock()\n1309|    private var loads = 0\n1310|    private let flipAfter: Int\n1311|    private var first: GitHubSessionIdentity?\n1312|    private var later: GitHubSessionIdentity?\n1313|    init(first: GitHubSessionIdentity?, later: GitHubSessionIdentity?, flipAfter: Int) {\n1314|        self.first = first\n1315|        self.later = later\n1316|        self.flipAfter = flipAfter\n1317|    }\n1318|    func save(_ identity: GitHubSessionIdentity) async {\n1319|        lock.withLock { first = identity; later = identity }\n1320|    }\n1321|    func load() async -> GitHubSessionIdentity? {\n1322|        lock.withLock {\n1323|            loads += 1\n1324|            return loads <= flipAfter ? first : later\n1325|        }\n1326|    }\n1327|    func delete() async {\n1328|        lock.withLock { first = nil; later = nil }\n1329|    }\n1330|}\n1331|\n1332|/// F2 bound: a logout between the membership reads and the PUT stops\n1333|/// silently — reads happened, the write never fires into a dead session.\n1334|/// Identity load order in apply: started(1), auth(2), post-auth check(3),\n1335|/// pre-PUT check(4); the flip lands on the pre-PUT check.\n1336|@Test func applyGroupAccessStopsWhenSessionChangesMidApply() async throws {\n1337|    let session = GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\")\n1338|    let flipping = FlippingSessionStore(first: session, later: nil, flipAfter: 3)\n1339|    let harness = await catalogHarness(\n1340|        transportResponses: [\n1341|            groupsPayload([(4, \"g4\")]),\n1342|            groupRunnersPayload([(42, \"r\", false)])\n1343|        ],\n1344|        identitiesOverride: flipping\n1345|    )\n1346|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1347|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.sessionflip\")\n1348|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.sessionflip\"))\n1349|    let _: Relux.ActionResult = await harness.flow.apply(\n1350|        Runners.Effect.applyGroupAccess(\"actions.runner.test.sessionflip\", groupID: 4, repositories: [1, 2], allowTakeover: true)\n1351|    )\n1352|    let requests = await harness.transport.requests\n1353|    #expect(requests.count == 2)\n1354|    #expect(requests.filter { $0.method == \"PUT\" }.isEmpty)\n1355|    #expect(loadedGroupAccess(harness.logger, id: \"actions.runner.test.sessionflip\") == nil)\n1356|    #expect(groupAccessError(harness.logger, id: \"actions.runner.test.sessionflip\") == nil)\n1357|}\n1358|\n1359|/// F2 bound: a server switch between the membership reads and the PUT\n1360|/// also stops silently, even when the user ID is unchanged.\n1361|@Test func applyGroupAccessStopsWhenServerSwitchesMidApply() async throws {\n1362|    let first = GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\")\n1363|    let switched = GitHubSessionIdentity(serverHost: \"ghe.example.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\")\n1364|    let flipping = FlippingSessionStore(first: first, later: switched, flipAfter: 3)\n1365|    let harness = await catalogHarness(\n1366|        transportResponses: [\n1367|            groupsPayload([(4, \"g4\")]),\n1368|            groupRunnersPayload([(42, \"r\", false)])\n1369|        ],\n1370|        identitiesOverride: flipping\n1371|    )\n1372|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1373|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.serverswitch\")\n1374|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.serverswitch\"))\n1375|    let _: Relux.ActionResult = await harness.flow.apply(\n1376|        Runners.Effect.applyGroupAccess(\"actions.runner.test.serverswitch\", groupID: 4, repositories: [1, 2], allowTakeover: true)\n1377|    )\n1378|    let requests = await harness.transport.requests\n1379|    #expect(requests.count == 2)\n(more lines below)","final_result":true}}}
