{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c591","stream":{"kind":"session","id":"01a0a9ec-c2bb-7943-8be0-a404f5b08a54"},"sequence":291,"recorded_at":1780531400000577,"record_type":"event","durability":"durable","causation_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","run_stream":{"kind":"run","id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b"},"call_id":"call_01a0a9ed9a0574ceb60b413c402ca843","text":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n1|import Foundation\n2|import Relux\n3|extension Runners {\n4|    public protocol IFlow: Relux.Flow {}\n5|    public actor Flow {\n6|        public let dispatcher: Relux.Dispatcher\n7|        private let service: any RunnerServicing\n8|        private let catalog: RunnerCatalogStore\n9|        private let installer: RunnerInstallerService\n10|        private let api: GitHubRunnerAPIClient\n11|        private let userStore: any GitHubCredentialStoring\n12|        private let identities: any GitHubSessionIdentityStoring\n13|        private let refresher: GitHubTokenRefresh\n14|        private let configProvider: @Sendable (String?) throws -> GitHubAuth.AppConfig\n15|        private let now: @Sendable () -> Date\n16|        private let home: URL\n17|        private var working: Set<String> = []\n18|        private var refreshing = false\n19|        private var revision = 0\n20|        private var pendingOp: [String: OperationPhase] = [:]\n21|        private var unregisterWorking: Set<String> = []\n22|        private var catalogGeneration = 0\n23|        private var editorAuthorities: [String: Runners.EditorAuthority] = [:]\n24|        private var editorInvalidated: Set<String> = []\n25|        public init(service: any RunnerServicing, dispatcher: Relux.Dispatcher? = nil) async {\n26|            self.service = service\n27|            self.catalog = RunnerCatalogStore()\n28|            self.installer = RunnerInstallerService()\n29|            let transport = URLSessionGitHubTransport()\n30|            let store: any GitHubCredentialStoring = GitHubKeychainStore()\n31|            self.api = GitHubRunnerAPIClient(transport: transport)\n32|            self.userStore = store\n33|            self.identities = UserDefaultsGitHubSessionIdentityStore()\n34|            self.refresher = GitHubTokenRefresh(transport: transport, store: store)\n35|            self.configProvider = { host in try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\") }\n36|            self.now = Date.init\n37|            self.home = FileManager.default.homeDirectoryForCurrentUser\n38|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n39|        }\n40|        /// Testable init with explicit catalog, installer and auth dependencies.\n41|        /// Production passes the shared installer so unregister/recovery and\n42|        /// registration cannot overlap.\n43|        public init(\n44|            service: any RunnerServicing,\n45|            catalog: RunnerCatalogStore,\n46|            installer: RunnerInstallerService,\n47|            api: GitHubRunnerAPIClient,\n48|            userStore: any GitHubCredentialStoring,\n49|            identities: any GitHubSessionIdentityStoring,\n50|            refresher: GitHubTokenRefresh,\n51|            configProvider: (@Sendable (String?) throws -> GitHubAuth.AppConfig)? = nil,\n52|            now: (@Sendable () -> Date)? = nil,\n53|            home: URL? = nil,\n54|            dispatcher: Relux.Dispatcher? = nil\n55|        ) async {\n56|            self.service = service\n57|            self.catalog = catalog\n58|            self.installer = installer\n59|            self.api = api\n60|            self.userStore = userStore\n61|            self.identities = identities\n62|            self.refresher = refresher\n63|            self.configProvider = configProvider ?? { host in try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\") }\n64|            self.now = now ?? Date.init\n65|            self.home = home ?? FileManager.default.homeDirectoryForCurrentUser\n66|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n67|        }\n68|    }\n69|}\n70|extension Runners.Flow: Runners.IFlow {\n71|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n72|        guard let effect = effect as? Runners.Effect else { return .success }\n73|        switch effect {\n74|        case .refresh: await refresh()\n75|        case .setEnabled(let id, let enabled): await setEnabled(id: id, enabled: enabled)\n76|        case .setEnabledMany(let ids, let enabled): await setEnabledMany(ids: ids, enabled: enabled)\n77|        case .loadCatalog: await loadCatalog()\n78|        case .discover: await discover()\n79|        case .importCandidate(let candidate): await importCandidate(candidate)\n80|        case .importFolder(let url): await importFolder(url)\n81|        case .removeFromApp(let id): await removeFromApp(id: id)\n82|        case .unregister(let id, let confirmation): await unregister(id: id, confirmation: confirmation)\n83|        case .refreshRemote: await refreshRemote()\n84|        case .setRunAtLoad(let id, let value): await setRunAtLoad(id: id, value: value)\n85|        case .setAlias(let id, let alias): await setAlias(id: id, alias: alias)\n86|        case .relinkDirectory(let id, let url): await relink(id: id, url: url)\n87|        case .selectRunner(let id): await action { Runners.Action.selected(id) }\n88|        case .loadLog(let id): await loadLog(id: id)\n89|        case .clearLog: await action { Runners.Action.logCleared }\n90|        case .loadGroupAccess(let id): await loadGroupAccess(id: id)\n91|        case .applyGroupAccess(let id, let groupID, let repos, let allowTakeover):\n92|            await applyGroupAccess(id: id, groupID: groupID, repos: repos, allowTakeover: allowTakeover)\n93|        }\n94|        return .success\n95|    }\n96|\n97|    private func isCatalogStale(_ gen: Int) -> Bool { catalogGeneration != gen }\n98|\n99|    // MARK: - Local refresh and power\n100|\n101|    private func refresh() async {\n102|        guard !refreshing, working.isEmpty else { return }\n103|        refreshing = true\n104|        let startedAt = revision\n105|        let snapshots = await service.snapshots()\n106|        // Do not publish a stale read if a command started during this await.\n107|        if working.isEmpty && revision == startedAt {\n108|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n109|            await action { Runners.Action.refreshed(mapped_snapshots) }\n110|        }\n111|        refreshing = false\n112|    }\n113|\n114|    private func withPendingOp(_ snapshots: [Runners.Snapshot]) -> [Runners.Snapshot] {\n115|        Self.applyPending(snapshots, pending: pendingOp)\n116|    }\n117|\n118|    private nonisolated static func applyPending(_ snapshots: [Runners.Snapshot], pending: [String: Runners.OperationPhase]) -> [Runners.Snapshot] {\n119|        snapshots.map { snapshot in\n120|            var next = snapshot\n121|            next.operation = pending[snapshot.id] ?? .idle\n122|            // Reflect the operation in the local status so the row shows\n123|            // starting/stopping instead of jumping ahead to running/stopped.\n124|            if next.operation == .starting, next.status == .stopped || next.status == .failed {\n125|                next.status = .starting\n126|            } else if next.operation == .stopping, next.status == .running {\n127|                next.status = .stopping\n128|            }\n129|            return next\n130|        }\n131|    }\n132|\n133|    private func setEnabled(id: String, enabled: Bool) async {\n134|        guard !working.contains(id), !unregisterWorking.contains(id) else { return }\n135|        working.insert(id)\n136|        revision += 1\n137|        pendingOp[id] = enabled ? .starting : .stopping\n138|        await action { Runners.Action.changing(id, true) }\n139|        do { try await service.setEnabled(enabled, id: id) }\n140|        catch { await action { Runners.Action.failed(error.localizedDescription) } }\n141|        pendingOp.removeValue(forKey: id)\n142|        let snapshots = await service.snapshots()\n143|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n144|        await action { Runners.Action.refreshed(mapped_snapshots) }\n145|        working.remove(id)\n146|        await action { Runners.Action.changing(id, false) }\n147|    }\n148|\n149|    /// Bulk power with per-row errors. Every row is attempted; failures are\n150|    /// reported per row in the refreshed snapshots plus one summary failure.\n151|    /// A single-row error never blocks the rest of the list.\n152|    private func setEnabledMany(ids: [String], enabled: Bool) async {\n153|        let targets = ids.filter { !working.contains($0) && !unregisterWorking.contains($0) }\n154|        guard !targets.isEmpty else { return }\n155|        for id in targets {\n156|            working.insert(id)\n157|            pendingOp[id] = enabled ? .starting : .stopping\n158|            await action { Runners.Action.changing(id, true) }\n159|        }\n160|        revision += 1\n161|        var failures: [(String, String)] = []\n162|        for id in targets {\n163|            do { try await service.setEnabled(enabled, id: id) }\n164|            catch { failures.append((id, error.localizedDescription)) }\n165|        }\n166|        for id in targets { pendingOp.removeValue(forKey: id) }\n167|        var snapshots = await service.snapshots()\n168|        if !failures.isEmpty {\n169|            let table = Dictionary(uniqueKeysWithValues: failures)\n170|            snapshots = snapshots.map { snapshot in\n171|                var next = snapshot\n172|                if let message = table[snapshot.id] {\n173|                    next.message = message\n174|                }\n175|                return next\n176|            }\n177|            let summary = failures.map { id, message in \"\\(id): \\(message)\" }.joined(separator: \"; \")\n178|            let failureCount = failures.count\n179|            let targetCount = targets.count\n180|            let bulkMessage = \"Partial failure (\\(failureCount) of \\(targetCount)): \\(summary)\"\n181|            await action { Runners.Action.failed(bulkMessage) }\n182|        }\n183|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n184|        await action { Runners.Action.refreshed(mapped_snapshots) }\n185|        for id in targets {\n186|            working.remove(id)\n187|            await action { Runners.Action.changing(id, false) }\n188|        }\n189|    }\n190|\n191|    // MARK: - Catalog\n192|\n193|    /// One-time migration plus refresh. Never starts or stops CI and never\n194|    /// modifies services; discovery only reads.\n195|    private func loadCatalog() async {\n196|        do {\n197|            _ = try await catalog.migrateIfNeeded()\n198|            await action { Runners.Action.catalogCleared }\n199|        } catch {\n200|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n201|        }\n202|        let snapshots = await service.snapshots()\n203|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n204|        await action { Runners.Action.refreshed(mapped_snapshots) }\n205|    }\n206|\n207|    private func discover() async {\n208|        let entries = await catalog.load()\n209|        let known = Set(entries.map(\\.canonicalPath))\n210|        let extra = entries.map { RunnerCatalogStore.resolve(entry: $0) }\n211|        let candidates = RunnerDiscovery.discoverCandidates(knownCanonicals: known, extraDirectories: extra)\n212|            .filter { candidate in\n213|                let canonical = RunnerCatalogStore.canonical(candidate.directory)\n214|                return !known.contains(canonical)\n215|            }\n216|        await action { Runners.Action.candidatesLoaded(candidates) }\n217|    }\n218|\n219|    private func importCandidate(_ candidate: RunnerDiscovery.Candidate) async {\n220|        let gen = catalogGeneration\n221|        // Refuse mutations for an entry already under unregister.\n222|        if let label = candidate.label, unregisterWorking.contains(label) {\n223|            await action { Runners.Action.catalogFailed(RunnerRegistration.RegistrationError.installerBusy(path: candidate.directory.path).localizedDescription) }\n224|            return\n225|        }\n226|        do {\n227|            try RunnersCatalogGates.validateImportable(candidate)\n228|            let canonical = RunnerCatalogStore.canonical(candidate.directory)\n229|            let entries = await catalog.load()\n230|            if entries.contains(where: { $0.canonicalPath == canonical }) {\n231|                throw RunnerCatalogStore.CatalogError.duplicateDirectory(path: candidate.directory.path)\n232|            }\n233|            guard !isCatalogStale(gen) else { return }\n234|            let label: String\n235|            let plist: URL\n236|            let kind = candidate.controllerKind\n237|            if let manifest = candidate.manifest, let existing = candidate.label {\n238|                // Import without changing the existing service: never\n239|                // re-registers and never flips the preserved RunAtLoad policy.\n240|                // A manifest label already owned by another entry refuses:\n241|                // two entries must never share one control identity.\n242|                if entries.contains(where: { $0.serviceLabel == existing }) {\n243|                    throw RunnerCatalogStore.CatalogError.duplicateLabel(label: existing)\n244|                }\n245|                label = existing\n246|                plist = manifest\n247|            } else {\n248|                // No manifest: create a manual service (RunAtLoad off for new\n249|                // runners). Never bootstraps; enabling is a separate action.\n250|                // The label binds agent name plus canonical path, so two\n251|                // same-name folders never share one control identity.\n252|                label = RunnerCatalogStore.importedServiceLabel(\n253|                    agentName: candidate.agentName, directory: candidate.directory\n254|                )\n255|                if entries.contains(where: { $0.serviceLabel == label }) {\n256|                    throw RunnerCatalogStore.CatalogError.duplicateLabel(label: label)\n257|                }\n258|                plist = try await installer.setupService(directory: candidate.directory, label: label)\n259|            }\n260|            guard !isCatalogStale(gen) else { return }\n261|            let info = RunnerRegistrationReader.read(directory: candidate.directory)\n262|            let entry = RunnerCatalogStore.Entry(\n263|                directoryPath: candidate.directory.path,\n264|                canonicalPath: canonical,\n265|                bookmarkBase64: RunnerCatalogStore.bookmark(for: candidate.directory),\n266|                serviceLabel: label,\n267|                servicePlistPath: plist.path,\n268|                controllerKind: kind,\n269|                runAtLoad: candidate.runAtLoad,\n270|                serverHost: info?.serverHost ?? candidate.serverHost,\n271|                scopeKind: info?.scopeKind,\n272|                scope: info?.scopeDetail ?? candidate.scope,\n273|                remoteAgentID: info?.agentID ?? candidate.agentID,\n274|                agentName: info?.agentName ?? candidate.agentName,\n275|                workFolder: info?.workFolder ?? candidate.workFolder\n276|            )\n277|            try await catalog.add(entry)\n278|            await action { Runners.Action.catalogCleared }\n279|            let snapshots = await service.snapshots()\n280|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n281|            await action { Runners.Action.refreshed(mapped_snapshots) }\n282|            await discover()\n283|        } catch {\n284|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n285|        }\n286|    }\n287|\n288|    private func importFolder(_ url: URL) async {\n289|        var isDir: ObjCBool = false\n290|        guard FileManager.default.fileExists(atPath: url.path, isDirectory: &isDir), isDir.boolValue else {\n291|            await action { Runners.Action.catalogFailed(\"Selected folder does not exist.\") }\n292|            return\n293|        }\n294|        let candidate = RunnerDiscovery.validateFolder(url)\n295|        if candidate.needsRelocation {\n296|            await action { Runners.Action.catalogFailed(\"Path contains a space; choose a location without spaces. Running runners are never moved automatically.\") }\n297|            return\n298|        }\n299|        await importCandidate(candidate)\n300|    }\n301|\n302|    /// Removes only the catalog record. Deletes no files, no GitHub\n303|    /// registration and no certificates, and never stops a running service.\n304|    /// Warns when the service keeps running.\n305|    private func removeFromApp(id: String) async {\n306|        if unregisterWorking.contains(id) {\n307|            await action { Runners.Action.catalogFailed(\"Runner is unregistering; retry after it settles.\") }\n308|            return\n309|        }\n310|        let entries = await catalog.load()\n311|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n312|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n313|            return\n314|        }\n315|        catalogGeneration += 1\n316|        editorAuthorities.removeValue(forKey: entry.serviceLabel)\n317|        editorInvalidated.remove(entry.serviceLabel)\n318|        let snapshots = await service.snapshots()\n319|        let wasRunning = snapshots.first(where: { $0.id == entry.serviceLabel })?.status == .running\n320|        do {\n321|            _ = try await catalog.remove(localID: entry.localID)\n322|        } catch {\n323|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n324|            return\n325|        }\n326|        let refreshed = await service.snapshots()\n327|        let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n328|        await action { Runners.Action.refreshed(mapped_refreshed) }\n329|        if wasRunning {\n330|            await action { Runners.Action.catalogFailed(\"Removed «\\(entry.agentName ?? entry.serviceLabel)» from the app. Its service keeps running.\") }\n331|        } else {\n332|            await action { Runners.Action.catalogCleared }\n333|        }\n334|        await discover()\n335|    }\n336|\n337|    // MARK: - Unregister (explicit remote removal)\n338|\n339|    /// Explicit remote unregister, distinct from catalog removal and file\n340|    /// deletion. Binds the local verified `.runner` server/scope/agentId and\n341|    /// the service path, never a remote name alone. Stopped-only: requires a\n342|    /// positive confirmed `.stopped` observation (unknown or missing state\n343|    /// refuses) both before minting the remove token and at the `config.sh\n344|    /// remove` boundary, plus a typed confirmation matching the agent name.\n345|    /// Bound to the session it started with: a logout, account or server\n346|    /// switch invalidates unstarted side effects instead of unregistering\n347|    /// under stale authority. Holds the shared installer lease across\n348|    /// `config.sh remove` so no registration, install, recovery or second\n349|    /// unregister can overlap. Files and the service manifest stay for\n350|    /// re-registration.\n351|    private func unregister(id: String, confirmation: String) async {\n352|        guard !unregisterWorking.contains(id), !working.contains(id) else { return }\n353|        unregisterWorking.insert(id)\n354|        await action { Runners.Action.unregistering(id, true) }\n355|        await runUnregister(id: id, confirmation: confirmation)\n356|        unregisterWorking.remove(id)\n357|        await action { Runners.Action.unregistering(id, false) }\n358|    }\n359|\n360|    /// Unregister body with guaranteed operation-state release: every early\n361|    /// return below still runs the caller's epilogue, so a refused or\n362|    /// session-invalidated attempt never wedges the UI \"unregistering\"\n363|    /// state and a retry stays possible.\n364|    private func runUnregister(id: String, confirmation: String) async {\n365|        let gen = catalogGeneration\n366|        // Session ownership: the initiating session is captured once and\n367|        // re-checked at every asynchronous boundary below.\n368|        let startedIdentity = await identities.load()\n369|        do {\n370|            let entries = await catalog.load()\n371|            guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n372|                throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n373|            }\n374|            let directory = RunnerCatalogStore.resolve(entry: entry)\n375|            // Mutation authority: local verified identity plus the service\n376|            // path. A remote name match alone never authorizes removal.\n377|            guard let local = await installer.readLocalRegistration(directory: directory),\n378|                  let agentID = local.agentID,\n379|                  let agentName = local.agentName, !agentName.isEmpty,\n380|                  let address = local.gitHubURL,\n381|                  let scope = unregisterScope(address: address) else {\n382|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n383|                    \"No verified local registration for '\\(entry.serviceLabel)'. Refusing to unregister another runner by name.\"\n384|                )\n385|            }\n386|            // Service-path binding: the catalog entry must still point at the\n387|            // verified directory; a relink mid-flight invalidates the evidence.\n388|            let canonical = RunnerCatalogStore.canonical(directory)\n389|            guard canonical == entry.canonicalPath else {\n390|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n391|                    \"Service path changed during unregister. Re-verify instead of removing another directory's registration.\"\n392|                )\n393|            }\n394|            // Agent-ID binding: a stored ID that disagrees with disk fails\n395|            // closed instead of removing a foreign registration.\n396|            if let stored = entry.remoteAgentID, stored != agentID {\n397|                throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n398|                    \"Catalog expects agent \\(stored) but disk shows agent \\(agentID) for '\\(agentName)'. Refusing to unregister a mismatched registration.\"\n399|                )\n400|            }\n401|            guard confirmation == agentName else {\n402|                throw RunnerRegistration.RegistrationError.confirmationMismatch(\n403|                    \"Type '\\(agentName)' to confirm unregister of agent \\(agentID) in \\(scope.detail).\"\n404|                )\n405|            }\n406|            guard !isCatalogStale(gen) else { return }\n407|            // Stopped-only gate: a positive confirmed `.stopped` observation\n408|            // is required before minting the remove token, so unregister\n409|            // cannot interrupt a job — or a service whose state is unknown.\n410|            try await requireConfirmedStopped(entry: entry)\n411|            guard !isCatalogStale(gen) else { return }\n412|            let auth = try await currentUserToken()\n413|            guard !isCatalogStale(gen) else { return }\n414|            // Server binding: the verified host must equal the authenticated\n415|            // server; a same-path foreign host never authorizes removal here.\n416|            let verifiedHost = URL(string: address)?.host ?? \"\"\n417|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n418|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n419|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n420|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost). Refusing cross-server unregister.\"\n421|                )\n422|            }\n423|            let created = try await api.createRemoveToken(config: auth.config, token: auth.token, scope: scope)\n424|            guard !isCatalogStale(gen) else { return }\n425|            // A logout, account or server switch during token acquisition\n426|            // invalidates the unstarted side effect; the minted token\n427|            // simply expires unused.\n428|            guard await sessionStill(startedIdentity) else { return }\n429|            // Re-verify after the network: scope/path edits invalidate stale\n430|            // evidence instead of removing a re-targeted registration.\n431|            guard let reread = await installer.readLocalRegistration(directory: directory),\n432|                  reread.agentID == agentID, reread.agentName == agentName,\n433|                  reread.gitHubURL == address else {\n434|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n435|                    \"Local registration changed during unregister. Re-verify instead of removing a re-targeted registration.\"\n436|                )\n437|            }\n438|            let currentEntries = await catalog.load()\n439|            guard currentEntries.contains(where: { $0.localID == entry.localID && $0.canonicalPath == canonical }) else {\n440|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n441|                    \"Catalog entry changed during unregister. Re-verify instead of removing another entry.\"\n442|                )\n443|            }\n444|            // Revalidate the stopped evidence at the side-effect boundary: a\n445|            // service started (or lost to inspection) after the token mint\n446|            // must not be unregistered.\n447|            guard !isCatalogStale(gen) else { return }\n448|            guard await sessionStill(startedIdentity) else { return }\n449|            try await requireConfirmedStopped(entry: entry)\n450|            try await installer.unregister(directory: directory, removeToken: created.token)\n451|            guard !isCatalogStale(gen) else { return }\n452|            // Remote registration is gone; the catalog entry stays so the\n453|            // user can re-register or remove it from the app. Files stay.\n454|            // This local bookkeeping follows a completed side effect: the\n455|            // remote removal is real even if the session changed while the\n456|            // installer lease was held, and no cancellation can undo it.\n457|            var updated = entry\n458|            updated.remoteAgentID = nil\n459|            updated.lastSeenAt = now()\n460|            try await catalog.update(updated)\n461|            await action { Runners.Action.catalogCleared }\n462|            let refreshed = await service.snapshots()\n463|            let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n464|            await action { Runners.Action.refreshed(mapped_refreshed) }\n465|        } catch {\n466|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n467|                await action { Runners.Action.catalogFailed(error.localizedDescription) }\n468|            }\n469|        }\n470|    }\n471|\n472|    /// Stopped-only gate for unregister. Only a positive confirmed `.stopped`\n473|    /// observation authorizes removal. `.running` refuses with a stop-first\n474|    /// message; a missing observation and every other state (unknown, failed,\n475|    /// missing, transitional, ...) refuse as unconfirmed instead of being\n476|    /// treated as stopped. A launchctl permission error (`.unknown`) therefore\n477|    /// never authorizes `config.sh remove` on a possibly live runner.\n478|    private func requireConfirmedStopped(entry: RunnerCatalogStore.Entry) async throws {\n479|        let snapshots = await service.snapshots()\n480|        guard let observation = snapshots.first(where: { $0.id == entry.serviceLabel }) else {\n481|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n482|                \"Cannot confirm the service '\\(entry.serviceLabel)' is stopped (no observation). Refusing to unregister while the service state is unconfirmed.\"\n483|            )\n484|        }\n485|        switch observation.status {\n486|        case .stopped:\n487|            return\n488|        case .running:\n489|            throw RunnerRegistration.RegistrationError.invalidDraft(\n490|                \"Stop the runner first; unregister refuses to interrupt a running service.\"\n491|            )\n492|        default:\n493|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n494|                \"Cannot confirm the service '\\(entry.serviceLabel)' is stopped (observed: \\(observation.status.rawValue)). Refusing to unregister while the service state is unconfirmed.\"\n495|            )\n496|        }\n497|    }\n498|\n499|    private func unregisterScope(address: String) -> RunnerRegistration.Scope? {\n500|        guard let url = URL(string: address), url.scheme == \"https\" else { return nil }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
