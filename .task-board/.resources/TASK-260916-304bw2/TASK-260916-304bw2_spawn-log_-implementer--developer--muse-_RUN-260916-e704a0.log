{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bf","stream":{"kind":"session","id":"01a0a9ec-c2bb-7943-8be0-a404f5b08a54"},"sequence":314,"recorded_at":1780531400000623,"record_type":"event","durability":"durable","causation_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b","run_stream":{"kind":"run","id":"eeaf8872-3b6a-4c54-9252-9d526f344e1b"},"call_id":"call_01a0a9edaa88759a8e8e3cfe706d865d","text":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n(499 line(s) above)\n500|        guard let url = URL(string: address), url.scheme == \"https\" else { return nil }\n501|        let components = url.pathComponents.filter { $0 != \"/\" }\n502|        if components.count == 1 { return .organization(org: components[0]) }\n503|        if components.count == 2 { return .repository(owner: components[0], name: components[1]) }\n504|        return nil\n505|    }\n506|\n507|    private struct CatalogUserToken: Sendable {\n508|        let config: GitHubAuth.AppConfig\n509|        let token: String\n510|        let identity: GitHubSessionIdentity\n511|    }\n512|\n513|    private func currentUserToken() async throws -> CatalogUserToken {\n514|        guard let identity = await identities.load() else {\n515|            throw RunnerRegistration.RegistrationError.notAuthenticated\n516|        }\n517|        let config = try configProvider(identity.serverHost)\n518|        guard var record = await userStore.load(serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID) else {\n519|            throw RunnerRegistration.RegistrationError.notAuthenticated\n520|        }\n521|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n522|            do {\n523|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n524|            } catch is CancellationError {\n525|                throw CancellationError()\n526|            } catch let error as GitHubAuth.AuthError {\n527|                switch error {\n528|                case .revoked, .unauthorized, .tokenRefreshFailed:\n529|                    throw RunnerRegistration.RegistrationError.unauthorized\n530|                default: break\n531|                }\n532|            }\n533|        }\n534|        return CatalogUserToken(config: config, token: record.accessToken, identity: identity)\n535|    }\n536|\n537|    // MARK: - Remote observation\n538|\n539|    /// Best-effort GitHub sync. Offline, 401/403 and rate limits mark data\n540|    /// stale and never change local power state. Follows full pagination\n541|    /// before matching; matches by server + scope + ID, never by name.\n542|    private func refreshRemote() async {\n543|        let startedIdentity = await identities.load()\n544|        let entries = await catalog.load()\n545|        if entries.isEmpty {\n546|            await action { Runners.Action.remoteSyncFinished(self.now()) }\n547|            return\n548|        }\n549|        let auth: CatalogUserToken\n550|        do {\n551|            auth = try await currentUserToken()\n552|        } catch {\n553|            // Disconnected: local control stays fully available.\n554|            await action { Runners.Action.remoteSyncFailed(error.localizedDescription) }\n555|            return\n556|        }\n557|        // Group definitions by scope so one paginated list serves every\n558|        // runner in that scope.\n559|        var scopes: [String: (scope: RunnerRegistration.Scope, ids: [String])] = [:]\n560|        var definitions: [String: Runners.Definition] = [:]\n561|        for entry in entries {\n562|            let directory = RunnerCatalogStore.resolve(entry: entry)\n563|            let info = RunnerRegistrationReader.read(directory: directory)\n564|            guard let address = info?.gitHubURL ?? entry.serverHost.map({ \"https://\\($0)/\\(entry.scope ?? \"\")\" }),\n565|                  let scope = unregisterScope(address: address) else { continue }\n566|            // Observe only registrations on the authenticated server.\n567|            let host = URL(string: address)?.host ?? entry.serverHost ?? \"\"\n568|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(host)\n569|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else { continue }\n570|            let key = scope.scopeKey\n571|            scopes[key, default: (scope, [])].ids.append(entry.serviceLabel)\n572|            definitions[entry.serviceLabel] = LaunchAgentService.definition(from: entry)\n573|        }\n574|        var failures: [String] = []\n575|        for (_, group) in scopes {\n576|            // A logout or login replacement mid-sync stops silently: no writes\n577|            // into a changed session incarnation.\n578|            guard await sessionStill(startedIdentity) else { return }\n579|            do {\n580|                let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: group.scope)\n581|                for id in group.ids {\n582|                    guard let definition = definitions[id] else { continue }\n583|                    if let observation = GitHubRunnerObserver.match(definition: definition, runners: runners, now: now()) {\n584|                        await action { Runners.Action.remoteUpdated(id, GitHubRunnerObserver.withFreshness(observation, now: self.now())) }\n585|                    } else {\n586|                        await action { Runners.Action.remoteUpdated(id, Runners.RemoteObservation(\n587|                            busyKnown: false, updatedAt: self.now(), stale: false,\n588|                            syncError: \"Identity mismatch\"\n589|                        )) }\n590|                    }\n591|                }\n592|            } catch let error as RunnerRegistration.RegistrationError {\n593|                switch error {\n594|                case .unauthorized:\n595|                    await action { Runners.Action.remoteSyncFailed(RunnerRegistration.RegistrationError.unauthorized.localizedDescription) }\n596|                    return\n597|                case .rateLimited:\n598|                    failures.append(\"Rate limited; will retry.\")\n599|                case .missingPermission(let text):\n600|                    failures.append(text)\n601|                default:\n602|                    failures.append(error.localizedDescription)\n603|                }\n604|            } catch {\n605|                failures.append(error.localizedDescription)\n606|            }\n607|        }\n608|        if failures.isEmpty {\n609|            await action { Runners.Action.remoteSyncFinished(self.now()) }\n610|        } else {\n611|            let joinedFailures = failures.joined(separator: \"; \")\n612|            await action { Runners.Action.remoteSyncFailed(joinedFailures) }\n613|        }\n614|    }\n615|\n616|    // MARK: - Preferences and relink\n617|\n618|    /// Changes only the login-startup policy. Never bootstraps or bootouts;\n619|    /// the policy applies at next login. Refuses while an installer mutation\n620|    /// is live.\n621|    /// Changes only the login-start behavior. Standard manifests edit\n622|    /// their own RunAtLoad. External manual plists gain or lose a matching\n623|    /// registration in `~/Library/LaunchAgents` (RunAtLoad outside\n624|    /// LaunchAgents never persists login start). Never bootstraps or\n625|    /// bootouts: live runner state is preserved. Refuses while an installer\n626|    /// mutation is live, and never touches a foreign same-label plist.\n627|    private func setRunAtLoad(id: String, value: Bool) async {\n628|        if unregisterWorking.contains(id) || working.contains(id) {\n629|            await action { Runners.Action.catalogFailed(\"Runner is busy; retry after it settles.\") }\n630|            return\n631|        }\n632|        let entries = await catalog.load()\n633|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n634|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n635|            return\n636|        }\n637|        if entry.controllerKind == .unsupported {\n638|            await action { Runners.Action.catalogFailed(\"Unsupported runners have no Runner Control login policy.\") }\n639|            return\n640|        }\n641|        do {\n642|            let directory = RunnerCatalogStore.resolve(entry: entry)\n643|            try await installer.requireIdle(for: directory)\n644|            if entry.controllerKind == .standardLaunchAgent {\n645|                let plist = URL(fileURLWithPath: entry.servicePlistPath)\n646|                guard let data = try? Data(contentsOf: plist),\n647|                      var object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {\n648|                    throw RunnerError.message(\"Service manifest is unreadable.\")\n649|                }\n650|                object[\"RunAtLoad\"] = value\n651|                let out = try PropertyListSerialization.data(fromPropertyList: object, format: .xml, options: 0)\n652|                try out.write(to: plist, options: .atomic)\n653|                entry.runAtLoad = value\n654|                try await catalog.update(entry)\n655|            } else {\n656|                try setManualLogin(entry: entry, directory: directory, enabled: value)\n657|            }\n658|            await action { Runners.Action.catalogCleared }\n659|            let snapshots = await service.snapshots()\n660|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n661|            await action { Runners.Action.refreshed(mapped_snapshots) }\n662|        } catch {\n663|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n664|        }\n665|    }\n666|\n667|    /// Enables or disables login start for an external manual service by\n668|    /// managing its `~/Library/LaunchAgents` registration. The external\n669|    /// service file itself is never modified, so the imported policy stays\n670|    /// byte-identical; live launchd state is untouched.\n671|    private func setManualLogin(entry: RunnerCatalogStore.Entry, directory: URL, enabled: Bool) throws {\n672|        let external = URL(fileURLWithPath: entry.servicePlistPath)\n673|        guard let data = try? Data(contentsOf: external),\n674|              let object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {\n675|            throw RunnerError.message(\"Service manifest is unreadable.\")\n676|        }\n677|        let definition = LaunchAgentService.definition(from: entry)\n678|        let copy = RunnerControllers.loginRegistrationURL(label: entry.serviceLabel, home: home)\n679|        if enabled {\n680|            if let existing = try? Data(contentsOf: copy),\n681|               let current = try? PropertyListSerialization.propertyList(from: existing, format: nil) as? [String: Any] {\n682|                guard RunnerControllers.references(current, definition: definition) else {\n683|                    throw RunnerError.message(\"Login slot '\\(copy.lastPathComponent)' belongs to another service. Remove it by hand instead of overwriting.\")\n684|                }\n685|                var updated = current\n686|                updated[\"RunAtLoad\"] = true\n687|                let out = try PropertyListSerialization.data(fromPropertyList: updated, format: .xml, options: 0)\n688|                try out.write(to: copy, options: .atomic)\n689|                return\n690|            }\n691|            var registration = object\n692|            registration[\"Label\"] = entry.serviceLabel\n693|            registration[\"WorkingDirectory\"] = directory.path\n694|            registration[\"ProgramArguments\"] = [directory.appendingPathComponent(\"runsvc.sh\").path]\n695|            registration[\"RunAtLoad\"] = true\n696|            let out = try PropertyListSerialization.data(fromPropertyList: registration, format: .xml, options: 0)\n697|            try FileManager.default.createDirectory(at: copy.deletingLastPathComponent(), withIntermediateDirectories: true)\n698|            try out.write(to: copy, options: .atomic)\n699|            return\n700|        }\n701|        guard FileManager.default.fileExists(atPath: copy.path) else { return }\n702|        guard let existing = try? Data(contentsOf: copy),\n703|              let current = try? PropertyListSerialization.propertyList(from: existing, format: nil) as? [String: Any],\n704|              RunnerControllers.references(current, definition: definition) else {\n705|            throw RunnerError.message(\"Login slot '\\(copy.lastPathComponent)' belongs to another service. Remove it by hand instead of deleting.\")\n706|        }\n707|        try FileManager.default.removeItem(at: copy)\n708|    }\n709|\n710|    private func setAlias(id: String, alias: String?) async {\n711|        let entries = await catalog.load()\n712|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n713|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n714|            return\n715|        }\n716|        let trimmed = alias?.trimmingCharacters(in: .whitespacesAndNewlines)\n717|        entry.displayName = (trimmed?.isEmpty == true) ? nil : trimmed\n718|        do {\n719|            try await catalog.update(entry)\n720|            await action { Runners.Action.catalogCleared }\n721|            let snapshots = await service.snapshots()\n722|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n723|            await action { Runners.Action.refreshed(mapped_snapshots) }\n724|        } catch {\n725|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n726|        }\n727|    }\n728|\n729|    /// Relinks a moved folder. Requires the new folder to hold the same full\n730|    /// registration identity (server host, scope, agent ID) so a foreign\n731|    /// installation can never steal this entry. Any successful relocation\n732|    /// changes the canonical path and therefore invalidates the loaded group\n733|    /// editor, which must be reloaded explicitly. Updates the service\n734|    /// manifest paths, preserving RunAtLoad.\n735|    private func relink(id: String, url: URL) async {\n736|        if unregisterWorking.contains(id) || working.contains(id) {\n737|            await action { Runners.Action.catalogFailed(\"Runner is busy; retry after it settles.\") }\n738|            return\n739|        }\n740|        let entries = await catalog.load()\n741|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n742|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n743|            return\n744|        }\n745|        guard url.path != entry.directoryPath else {\n746|            await action { Runners.Action.catalogCleared }\n747|            return\n748|        }\n749|        if url.path.contains(\" \") {\n750|            await action { Runners.Action.catalogFailed(\"Path contains a space; choose a location without spaces.\") }\n751|            return\n752|        }\n753|        let canonical = RunnerCatalogStore.canonical(url)\n754|        if entries.contains(where: { $0.localID != entry.localID && $0.canonicalPath == canonical }) {\n755|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.duplicateDirectory(path: url.path).localizedDescription) }\n756|            return\n757|        }\n758|        guard let info = RunnerRegistrationReader.read(directory: url) else {\n759|            await action { Runners.Action.catalogFailed(\"Cannot read .runner in the selected folder.\") }\n760|            return\n761|        }\n762|        if let stored = entry.remoteAgentID, info.agentID != stored {\n763|            await action { Runners.Action.catalogFailed(\"Selected folder is agent \\(info.agentID.map(String.init) ?? \"unknown\"), not \\(stored). Refusing to relink a foreign installation.\") }\n764|            return\n765|        }\n766|        if let recordedHost = entry.serverHost, let folderHost = info.serverHost,\n767|           RunnerRegistration.OperationIdentity.normalizeServerHost(recordedHost)\n768|            != RunnerRegistration.OperationIdentity.normalizeServerHost(folderHost) {\n769|            await invalidateEditor(id: id, serviceLabel: entry.serviceLabel, message: \"Selected folder points at '\\(folderHost)', not '\\(recordedHost)'. Reload group access before applying.\")\n770|            await action { Runners.Action.catalogFailed(\"Selected folder points at '\\(folderHost)', not '\\(recordedHost)'. Refusing to relink a foreign installation.\") }\n771|            return\n772|        }\n773|        if let recordedScope = entry.scope, let folderScope = info.scopeDetail, recordedScope != folderScope {\n774|            await invalidateEditor(id: id, serviceLabel: entry.serviceLabel, message: \"Selected folder scope is '\\(folderScope)', not '\\(recordedScope)'. Reload group access before applying.\")\n775|            await action { Runners.Action.catalogFailed(\"Selected folder scope is '\\(folderScope)', not '\\(recordedScope)'. Refusing to relink a foreign installation.\") }\n776|            return\n777|        }\n778|        catalogGeneration += 1\n779|        do {\n780|            let plist = URL(fileURLWithPath: entry.servicePlistPath)\n781|            // Manual manifests move with the directory; standard manifests\n782|            // stay in LaunchAgents. Update whichever manifest this entry owns.\n783|            if plist.path.hasPrefix(entry.directoryPath) {\n784|                let moved = url.appendingPathComponent(\"manual-service.plist\")\n785|                if FileManager.default.fileExists(atPath: moved.path) {\n786|                    try await installer.updateServicePaths(plist: moved, directory: url)\n787|                    entry.servicePlistPath = moved.path\n788|                }\n789|            } else {\n790|                try await installer.updateServicePaths(plist: plist, directory: url)\n791|            }\n792|            let oldPath = entry.directoryPath\n793|            entry.directoryPath = url.path\n794|            entry.canonicalPath = canonical\n795|            entry.bookmarkBase64 = RunnerCatalogStore.bookmark(for: url)\n796|            entry.agentName = info.agentName ?? entry.agentName\n797|            entry.serverHost = info.serverHost ?? entry.serverHost\n798|            entry.scope = info.scopeDetail ?? entry.scope\n799|            entry.scopeKind = info.scopeKind ?? entry.scopeKind\n800|            entry.remoteAgentID = info.agentID ?? entry.remoteAgentID\n801|            entry.workFolder = info.workFolder ?? entry.workFolder\n802|            // Keep a managed login registration pointing at the new\n803|            // directory so relink preserves effective login. Foreign\n804|            // same-label plists are never touched.\n805|            if entry.controllerKind == .manualManaged {\n806|                let copy = RunnerControllers.loginRegistrationURL(label: entry.serviceLabel, home: home)\n807|                if let data = try? Data(contentsOf: copy),\n808|                   var current = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],\n809|                   current[\"Label\"] as? String == entry.serviceLabel,\n810|                   current[\"WorkingDirectory\"] as? String == oldPath {\n811|                    try await installer.requireIdle(for: url)\n812|                    current[\"WorkingDirectory\"] = url.path\n813|                    current[\"ProgramArguments\"] = [url.appendingPathComponent(\"runsvc.sh\").path]\n814|                    let out = try PropertyListSerialization.data(fromPropertyList: current, format: .xml, options: 0)\n815|                    try out.write(to: copy, options: .atomic)\n816|                }\n817|            }\n818|            try await catalog.update(entry)\n819|            await action { Runners.Action.catalogCleared }\n820|            await invalidateEditor(id: id, serviceLabel: entry.serviceLabel, message: \"Runner folder moved. Reload group access before applying.\")\n821|            let snapshots = await service.snapshots()\n822|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n823|            await action { Runners.Action.refreshed(mapped_snapshots) }\n824|        } catch {\n825|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n826|        }\n827|    }\n828|\n829|    /// Clears the immutable Load-time editor authority for this runner,\n830|    /// marks it as requiring an explicit Load, and publishes an explicit\n831|    /// invalidation so the UI returns to a Load instead of submitting a\n832|    /// stale group ID. A later Apply without a fresh Load refuses even\n833|    /// when the current disk/catalog happens to match the old values.\n834|    private func invalidateEditor(id: String, serviceLabel: String, message: String) async {\n835|        editorAuthorities.removeValue(forKey: serviceLabel)\n836|        editorInvalidated.insert(serviceLabel)\n837|        await action { Runners.Action.groupAccessInvalidated(id, message) }\n838|    }\n839|\n840|    // MARK: - Diagnostics\n841|\n842|    private func loadLog(id: String) async {\n843|        let snapshots = await service.snapshots()\n844|        guard let snapshot = snapshots.first(where: { $0.id == id }) else {\n845|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n846|            return\n847|        }\n848|        let excerpt = RunnerDiagnostics.tail(definition: snapshot.definition)\n849|        await action { Runners.Action.logLoaded(title: snapshot.definition.displayTitle, excerpt: excerpt) }\n850|    }\n851|\n852|    // MARK: - Group access (fresh API membership)\n853|\n854|    private struct VerifiedOrgRunner: Sendable {\n855|        let entry: RunnerCatalogStore.Entry\n856|        let directory: URL\n857|        let org: String\n858|        let agentID: Int64\n859|        let agentName: String\n860|    }\n861|\n862|    /// Verifies the local `.runner` identity for group reads/writes: agent\n863|    /// ID, name, server and org scope must all be present and bound to the\n864|    /// catalog entry's recorded original. Local pool fields are ignored\n865|    /// (they can lag); the group answer always comes from fresh API\n866|    /// membership below.\n867|    private func verifiedOrgRunner(id: String) async throws -> VerifiedOrgRunner {\n868|        let entries = await catalog.load()\n869|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n870|            throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n871|        }\n872|        let directory = RunnerCatalogStore.resolve(entry: entry)\n873|        guard let local = await installer.readLocalRegistration(directory: directory),\n874|              let agentID = local.agentID,\n875|              let agentName = local.agentName, !agentName.isEmpty,\n876|              let address = local.gitHubURL,\n877|              let url = URL(string: address), url.scheme == \"https\" else {\n878|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n879|                \"No verified local registration for '\\(entry.serviceLabel)'. Refusing group access for another runner.\"\n880|            )\n881|        }\n882|        let components = url.pathComponents.filter { $0 != \"/\" }\n883|        guard components.count == 1 else {\n884|            throw RunnerRegistration.RegistrationError.groupNotApplicable\n885|        }\n886|        if let stored = entry.remoteAgentID, stored != agentID {\n887|            throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n888|                \"Catalog expects agent \\(stored) but disk shows agent \\(agentID). Refusing group access for a mismatched registration.\"\n889|            )\n890|        }\n891|        // Catalog-original binding: the mutable on-disk registration must\n892|        // still agree with the server and scope recorded at import (or\n893|        // explicit relink). A scope or server edit on disk — without\n894|        // re-verification — refuses here instead of silently retargeting\n895|        // another org's group. Load and Apply both verify here, so neither\n896|        // path can drift off the catalog original between Load and Apply.\n897|        // Entries without a recorded server/scope predate this binding and\n898|        // fall through to the disk-vs-session checks below.\n899|        let diskHost = url.host ?? \"\"\n900|        if let storedHost = entry.serverHost,\n901|           RunnerRegistration.OperationIdentity.normalizeServerHost(storedHost)\n902|               != RunnerRegistration.OperationIdentity.normalizeServerHost(diskHost) {\n903|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n904|                \"Local registration server changed from '\\(storedHost)' to '\\(diskHost)' since import. Re-add the runner (or relink its moved folder) to re-verify instead of editing with stale identity.\"\n905|            )\n906|        }\n907|        if let storedScope = entry.scope, storedScope != components[0] {\n908|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n909|                \"Local registration scope changed from '\\(storedScope)' to '\\(components[0])' since import. Re-add the runner (or relink its moved folder) to re-verify instead of editing with stale identity.\"\n910|            )\n911|        }\n912|        return VerifiedOrgRunner(entry: entry, directory: directory, org: components[0], agentID: agentID, agentName: agentName)\n913|    }\n914|\n915|    /// Resolves the runner's current GitHub group by fresh API membership:\n916|    /// lists every group, then each group's runners, matching by agent ID\n917|    /// (and exact name on the matched ID). Never reads `.runner` pool\n918|    /// fields and never adopts a same-name foreign runner or group.\n919|    private func resolveFreshGroup(\n920|        org: String, agentID: Int64, agentName: String,\n921|        auth: CatalogUserToken, generation gen: Int\n922|    ) async throws -> RunnerRegistration.RunnerGroup {\n923|        let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n924|        for group in groups {\n925|            if isCatalogStale(gen) { throw CancellationError() }\n926|            let members = try await api.fetchGroupRunners(config: auth.config, token: auth.token, org: org, groupID: group.id)\n927|            if let exact = members.first(where: { $0.id == agentID }) {\n928|                guard exact.name == agentName else {\n929|                    throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n930|                        \"Group '\\(group.name)' lists agent \\(agentID) as '\\(exact.name)', not '\\(agentName)'. Refusing a mismatched group.\"\n931|                    )\n932|                }\n933|                return group\n934|            }\n935|            // A same-name foreign member in this group is ignored: only the\n936|            // exact agent ID binds membership.\n937|        }\n938|        throw RunnerRegistration.RegistrationError.remoteRunnerNotFound(\n939|            \"Agent \\(agentID) is not in any visible group for '\\(org)'. It may have been moved or the App lacks group access.\"\n940|        )\n941|    }\n942|\n943|    /// Loads fresh group + repository access for one org runner. Display and\n944|    /// later edits use this API answer, never stale `.runner` pool fields.\n945|    private func loadGroupAccess(id: String) async {\n946|        let gen = catalogGeneration\n947|        let startedIdentity = await identities.load()\n948|        await action { Runners.Action.groupAccessLoading(id) }\n949|        do {\n950|            let verified = try await verifiedOrgRunner(id: id)\n951|            let auth = try await currentUserToken()\n952|            if isCatalogStale(gen) { return }\n953|            guard await sessionStill(startedIdentity) else { return }\n954|            let verifiedHost = URL(string: (await installer.readLocalRegistration(directory: verified.directory))?.gitHubURL ?? \"\")?.host ?? \"\"\n955|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n956|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n957|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n958|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost).\"\n959|                )\n960|            }\n961|            let group = try await resolveFreshGroup(\n962|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n963|                auth: auth, generation: gen\n964|            )\n965|            if isCatalogStale(gen) { return }\n966|            // Completion ownership: a logout, account/server switch, or\n967|            // same-account re-login during the membership reads refuses\n968|            // further authenticated work and any state publication into the\n969|            // changed session incarnation.\n970|            guard await sessionStill(startedIdentity) else { return }\n971|            let repoIDs = try await api.fetchGroupRepositories(\n972|                config: auth.config, token: auth.token, org: verified.org, groupID: group.id\n973|            )\n974|            if isCatalogStale(gen) { return }\n975|            guard await sessionStill(startedIdentity) else { return }\n976|            let owned = await installer.loadOwnedGroupID(\n977|                serverHost: auth.identity.serverHost, org: verified.org, name: group.name\n978|            ) == group.id\n979|            let authority = Runners.EditorAuthority(\n980|                serverHost: verifiedHost, org: verified.org,\n981|                agentID: verified.agentID, agentName: verified.agentName,\n982|                canonicalPath: RunnerCatalogStore.canonical(verified.directory),\n983|                localID: verified.entry.localID\n984|            )\n985|            editorAuthorities[verified.entry.serviceLabel] = authority\n986|            editorInvalidated.remove(verified.entry.serviceLabel)\n987|            let access = Runners.GroupAccess(\n988|                group: group, repoIDs: repoIDs.sorted(), updatedAt: now(),\n989|                owned: owned, loading: false, authority: authority\n990|            )\n991|            await action { Runners.Action.groupAccessLoaded(id, access) }\n992|        } catch is CancellationError {\n993|            return\n994|        } catch {\n995|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n996|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n997|                await action { Runners.Action.groupAccessFailed(id, message) }\n998|            }\n999|        }\n1000|    }\n1001|\n1002|    /// True when the GitHub session still matches the login incarnation this\n1003|    /// operation started with. A logout, account/server switch, or logout +\n1004|    /// same-account re-login mid-operation stops silently: no writes into a\n1005|    /// changed session. Ordinary token refresh keeps the same incarnation and\n1006|    /// stays valid. Legacy identities without an incarnation compare as nil.\n1007|    private func sessionStill(_ started: GitHubSessionIdentity?) async -> Bool {\n1008|        let current = await identities.load()\n1009|        guard let started else { return current == nil }\n1010|        guard let current else { return false }\n1011|        guard current.userID == started.userID,\n1012|              RunnerRegistration.OperationIdentity.normalizeServerHost(current.serverHost)\n1013|                == RunnerRegistration.OperationIdentity.normalizeServerHost(started.serverHost) else { return false }\n1014|        return current.sessionIncarnation == started.sessionIncarnation\n1015|    }\n1016|\n1017|    /// Write-path identity binding for group edits. Re-reads the mutable\n1018|    /// local registration and requires it to still match the verified\n1019|    /// server host, org scope, agent ID and name, and requires the catalog\n1020|    /// entry to still point at the verified canonical directory. A\n1021|    /// same-path foreign host, a scope edit, or a relink mid-flight fails\n1022|    /// instead of writing another server's group. Called after\n1023|    /// authentication and re-called at the PUT boundary.\n1024|    private func bindApplyIdentity(verified: VerifiedOrgRunner, auth: CatalogUserToken) async throws {\n1025|        guard let reread = await installer.readLocalRegistration(directory: verified.directory),\n1026|              reread.agentID == verified.agentID,\n1027|              reread.agentName == verified.agentName,\n1028|              let address = reread.gitHubURL,\n1029|              let url = URL(string: address), url.scheme == \"https\" else {\n1030|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1031|                \"Local registration changed during group apply. Reload instead of editing with stale identity.\"\n1032|            )\n1033|        }\n1034|        let components = url.pathComponents.filter { $0 != \"/\" }\n1035|        guard components.count == 1, components[0] == verified.org else {\n1036|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1037|                \"Local registration scope changed during group apply. Reload instead of editing with stale identity.\"\n1038|            )\n1039|        }\n1040|        let verifiedHost = url.host ?? \"\"\n1041|        guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n1042|            == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n1043|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1044|                \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost). Refusing cross-server group apply.\"\n1045|            )\n1046|        }\n1047|        let canonical = RunnerCatalogStore.canonical(verified.directory)\n1048|        let current = await catalog.load()\n1049|        guard current.contains(where: { $0.localID == verified.entry.localID && $0.canonicalPath == canonical }) else {\n1050|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1051|                \"Catalog entry changed during group apply. Reload instead of editing another entry's group.\"\n1052|            )\n1053|        }\n1054|    }\n1055|\n1056|    /// Consumes the immutable Load-time editor authority for this runner.\n1057|    /// Returns the verified tuple when the current disk/catalog identity\n1058|    /// still matches the stored server/scope/agent/canonical/localID; when it\n1059|    /// no longer matches, clears the stored editor, publishes an explicit\n1060|    /// invalidation requiring a new Load, and returns nil without throwing.\n1061|    /// A missing entry throws unknownEntry like the verified path.\n1062|    private func consumeStoredEditorAuthority(_ stored: Runners.EditorAuthority, id: String) async throws -> VerifiedOrgRunner? {\n1063|        let entries = await catalog.load()\n1064|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n1065|            throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n1066|        }\n1067|        let directory = RunnerCatalogStore.resolve(entry: entry)\n1068|        let canonical = RunnerCatalogStore.canonical(directory)\n1069|        guard let local = await installer.readLocalRegistration(directory: directory),\n1070|              let agentID = local.agentID,\n1071|              let agentName = local.agentName, !agentName.isEmpty,\n1072|              let address = local.gitHubURL,\n1073|              let url = URL(string: address), url.scheme == \"https\" else {\n1074|            editorAuthorities.removeValue(forKey: entry.serviceLabel)\n1075|            editorInvalidated.insert(entry.serviceLabel)\n1076|            let message = \"Runner identity changed since loading (registration unreadable for '\\(entry.serviceLabel)'). Reload group access before applying.\"\n1077|            await action { Runners.Action.groupAccessInvalidated(id, message) }\n1078|            return nil\n1079|        }\n1080|        let components = url.pathComponents.filter { $0 != \"/\" }\n1081|        let diskHost = url.host ?? \"\"\n1082|        let matches = components.count == 1\n1083|            && components[0] == stored.org\n1084|            && RunnerRegistration.OperationIdentity.normalizeServerHost(diskHost)\n1085|                == RunnerRegistration.OperationIdentity.normalizeServerHost(stored.serverHost)\n1086|            && agentID == stored.agentID\n1087|            && agentName == stored.agentName\n1088|            && canonical == stored.canonicalPath\n1089|            && entry.localID == stored.localID\n1090|        guard matches else {\n1091|            editorAuthorities.removeValue(forKey: entry.serviceLabel)\n1092|            editorInvalidated.insert(entry.serviceLabel)\n1093|            let foundScope = components.count == 1 ? components[0] : (components.joined(separator: \"/\").isEmpty ? \"?\" : components.joined(separator: \"/\"))\n1094|            let message = \"Runner identity changed since loading (expected \\(stored.serverHost)/\\(stored.org)/agent\\(stored.agentID), found \\(diskHost)/\\(foundScope)/agent\\(agentID)). Reload group access before applying.\"\n1095|            await action { Runners.Action.groupAccessInvalidated(id, message) }\n1096|            return nil\n1097|        }\n1098|        return VerifiedOrgRunner(entry: entry, directory: directory, org: stored.org, agentID: stored.agentID, agentName: stored.agentName)\n1099|    }\n1100|\n1101|    /// Applies edited repository access to the runner's fresh group. Rejects\n1102|    /// stale UI (group moved since load), shared groups without explicit\n1103|    /// takeover, and partial confirmations. When a Load established an\n1104|    /// immutable editor authority, Apply consumes that tuple and refuses when\n1105|    /// the current identity no longer matches it — never reconstructing\n1106|    /// authority from the mutable current catalog. A direct Apply without a\n1107|    /// prior Load establishes its own start authority for that single write.\n1108|    /// Preserves the binding plus the starting login incarnation over every\n1109|    /// asynchronous boundary through confirmation and publication. Reuses the\n1110|    /// registration ownership and confirmation gates; API-only, no\n1111|    /// installer lease.\n1112|    private func applyGroupAccess(id: String, groupID: Int64, repos: Set<Int64>, allowTakeover: Bool) async {\n1113|        let gen = catalogGeneration\n1114|        let startedIdentity = await identities.load()\n1115|        await action { Runners.Action.groupAccessLoading(id) }\n1116|        do {\n1117|            if await editorRequiresReload(id: id) {\n1118|                await action { Runners.Action.groupAccessInvalidated(id, \"Runner editor was invalidated (folder moved or identity changed). Reload group access before applying.\") }\n1119|                return\n1120|            }\n1121|            let verified: VerifiedOrgRunner\n1122|            if let stored = await storedEditorAuthority(id: id) {\n1123|                guard let consumed = try await consumeStoredEditorAuthority(stored, id: id) else { return }\n1124|                verified = consumed\n1125|            } else {\n1126|                verified = try await verifiedOrgRunner(id: id)\n1127|            }\n1128|            let auth = try await currentUserToken()\n1129|            if isCatalogStale(gen) { return }\n1130|            guard await sessionStill(startedIdentity) else { return }\n1131|            try await bindApplyIdentity(verified: verified, auth: auth)\n1132|            // Fresh membership re-verified at write time: a move since the\n1133|            // UI loaded fails instead of editing the wrong group.\n1134|            let fresh = try await resolveFreshGroup(\n1135|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n1136|                auth: auth, generation: gen\n1137|            )\n1138|            guard fresh.id == groupID else {\n1139|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1140|                    \"Runner moved from group \\(groupID) to '\\(fresh.name)' (\\(fresh.id)) since loading. Reload instead of editing a stale group.\"\n1141|                )\n1142|            }\n1143|            if isCatalogStale(gen) { return }\n1144|            let owned = await installer.loadOwnedGroupID(\n1145|                serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name\n1146|            )\n1147|            try RunnerRegistration.Gates.authorizeGroupTakeover(\n1148|                groupName: fresh.name, existingID: fresh.id,\n1149|                ownedID: owned, allowTakeover: allowTakeover\n1150|            )\n1151|            if owned != fresh.id {\n1152|                try await installer.saveOwnedGroupID(\n1153|                    serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name, groupID: fresh.id\n1154|                )\n1155|            }\n1156|            if isCatalogStale(gen) { return }\n1157|            // Re-bind at the PUT boundary: the membership and ownership\n1158|            // awaits above must not carry stale identity into the write.\n1159|            guard await sessionStill(startedIdentity) else { return }\n1160|            try await bindApplyIdentity(verified: verified, auth: auth)\n1161|            try await api.setGroupRepositories(\n1162|                config: auth.config, token: auth.token, org: verified.org,\n1163|                groupID: fresh.id, selectedRepositoryIDs: repos\n1164|            )\n1165|            if isCatalogStale(gen) { return }\n1166|            // Completion ownership: the issued PUT cannot be undone, but a\n1167|            // logout, account/server switch, or same-account re-login after\n1168|            // it refuses the confirmation read and any state publication\n1169|            // into the changed session incarnation.\n1170|            guard await sessionStill(startedIdentity) else { return }\n1171|            let confirmed = try await api.fetchGroupRepositories(\n1172|                config: auth.config, token: auth.token, org: verified.org, groupID: fresh.id\n1173|            )\n1174|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: repos, confirmed: confirmed)\n1175|            if isCatalogStale(gen) { return }\n1176|            guard await sessionStill(startedIdentity) else { return }\n1177|            let authority = Runners.EditorAuthority(\n1178|                serverHost: URL(string: (await installer.readLocalRegistration(directory: verified.directory))?.gitHubURL ?? \"\")?.host ?? verified.entry.serverHost ?? auth.identity.serverHost,\n1179|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n1180|                canonicalPath: RunnerCatalogStore.canonical(verified.directory),\n1181|                localID: verified.entry.localID\n1182|            )\n1183|            editorAuthorities[verified.entry.serviceLabel] = authority\n1184|            editorInvalidated.remove(verified.entry.serviceLabel)\n1185|            let access = Runners.GroupAccess(\n1186|                group: fresh, repoIDs: confirmed.sorted(), updatedAt: now(),\n1187|                owned: true, loading: false, authority: authority\n1188|            )\n1189|            await action { Runners.Action.groupAccessLoaded(id, access) }\n1190|            await action { Runners.Action.catalogCleared }\n1191|        } catch is CancellationError {\n1192|            return\n1193|        } catch {\n1194|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n1195|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n1196|                await action { Runners.Action.groupAccessFailed(id, message) }\n1197|            }\n1198|        }\n1199|    }\n1200|\n1201|    /// Looks up the immutable Load-time editor authority for this runner, if\n1202|    /// a Load established one. Keyed by the stable service label.\n1203|    private func storedEditorAuthority(id: String) async -> Runners.EditorAuthority? {\n1204|        let entries = await catalog.load()\n1205|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else { return nil }\n1206|        return editorAuthorities[entry.serviceLabel]\n1207|    }\n1208|\n1209|    /// True when a relocation or identity change invalidated the editor and\n1210|    /// an explicit Load is required before the next Apply.\n1211|    private func editorRequiresReload(id: String) async -> Bool {\n1212|        let entries = await catalog.load()\n1213|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else { return false }\n1214|        return editorInvalidated.contains(entry.serviceLabel)\n1215|    }\n1216|}\n1217|\n1218|/// Import gates. Each gate refuses a concrete invalid class; negative tests\n1219|/// narrow every one of them.\n1220|public enum RunnersCatalogGates {\n1221|    public static func validateImportable(_ candidate: RunnerDiscovery.Candidate) throws {\n1222|        if candidate.controllerKind == .unsupported || candidate.unsupportedReason != nil {\n1223|            throw RunnerError.unsupported(candidate.unsupportedReason ?? \"Unsupported management.\")\n1224|        }\n1225|        if !candidate.registrationReadable {\n1226|            throw RunnerError.message(\"Cannot read .runner registration.\")\n1227|        }\n1228|        if candidate.agentName == nil || candidate.agentName?.isEmpty == true {\n1229|            throw RunnerError.message(\"Registration name is missing.\")\n1230|        }\n1231|        if candidate.serverHost == nil || candidate.scope == nil {\n1232|            throw RunnerError.message(\"Server or scope is undefined.\")\n1233|        }\n1234|        if !candidate.noSpacePath || !candidate.noSpaceWork {\n1235|            throw RunnerError.noSpacePath(\"Path or work folder contains a space; relocation is required.\")\n1236|        }\n1237|        if !candidate.runsvcExists || !candidate.binaryExists {\n1238|            throw RunnerError.message(\"Runner binaries are missing (run.sh / runsvc.sh).\")\n1239|        }\n1240|        if candidate.manifest == nil {\n1241|            // Folder imports without a manifest create a service; every other\n1242|            // check above must already have passed.\n1243|            return\n1244|        }\n1245|        if !candidate.manifestMatches {\n1246|            throw RunnerError.manifestMismatch(\"Service manifest does not match the runner directory.\")\n1247|        }\n1248|        if !candidate.issues.isEmpty {\n1249|            // Issues beyond the manifest notice (folder imports) refuse.\n1250|            let blocking = candidate.issues.filter { !$0.contains(\"No service manifest\") }\n1251|            if !blocking.isEmpty {\n1252|                throw RunnerError.message(blocking.joined(separator: \" \"))\n1253|            }\n1254|        }\n1255|    }\n1256|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
