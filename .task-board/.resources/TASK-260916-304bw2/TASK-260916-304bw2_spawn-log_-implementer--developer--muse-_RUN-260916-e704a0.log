nerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n974|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n975|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost).\"\n976|                )\n977|            }\n978|            let group = try await resolveFreshGroup(\n979|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n980|                auth: auth, generation: gen\n981|            )\n982|            if isCatalogStale(gen) { return }\n983|            // Completion ownership: a logout, account/server switch, or\n984|            // same-account re-login during the membership reads refuses\n985|            // further authenticated work and any state publication into the\n986|            // changed session incarnation.\n987|            guard await sessionStill(startedIdentity) else { return }\n988|            let repoIDs = try await api.fetchGroupRepositories(\n989|                config: auth.config, token: auth.token, org: verified.org, groupID: group.id\n990|            )\n991|            if isCatalogStale(gen) { return }\n992|            guard await sessionStill(startedIdentity) else { return }\n993|            let owned = await installer.loadOwnedGroupID(\n994|                serverHost: auth.identity.serverHost, org: verified.org, name: group.name\n995|            ) == group.id\n996|            let authority = Runners.EditorAuthority(\n997|                serverHost: verifiedHost, org: verified.org,\n998|                agentID: verified.agentID, agentName: verified.agentName,\n999|                canonicalPath: RunnerCatalogStore.canonical(verified.directory),\n1000|                localID: verified.entry.localID\n1001|            )\n1002|            editorAuthorities[verified.entry.serviceLabel] = authority\n1003|            editorInvalidated.remove(verified.entry.serviceLabel)\n1004|            let access = Runners.GroupAccess(\n1005|                group: group, repoIDs: repoIDs.sorted(), updatedAt: now(),\n1006|                owned: owned, loading: false, authority: authority\n1007|            )\n1008|            await action { Runners.Action.groupAccessLoaded(id, access) }\n1009|        } catch is CancellationError {\n1010|            return\n1011|        } catch {\n1012|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n1013|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n1014|                await action { Runners.Action.groupAccessFailed(id, message) }\n1015|            }\n1016|        }\n1017|    }\n1018|\n1019|    /// True when the GitHub session still matches the login incarnation this\n1020|    /// operation started with. A logout, account/server switch, or logout +\n1021|    /// same-account re-login mid-operation stops silently: no writes into a\n1022|    /// changed session. Ordinary token refresh keeps the same incarnation and\n1023|    /// stays valid. Legacy identities without an incarnation compare as nil.\n1024|    private func sessionStill(_ started: GitHubSessionIdentity?) async -> Bool {\n1025|        Self.sessionMatches(started, await identities.load())\n1026|    }\n1027|\n1028|    /// Pure incarnation comparison shared by `sessionStill` and by the\n(more lines below)","final_result":true}}}
