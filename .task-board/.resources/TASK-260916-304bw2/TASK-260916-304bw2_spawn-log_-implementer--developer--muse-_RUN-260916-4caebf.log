{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c679","stream":{"kind":"session","id":"01a0a9ad-5350-7732-bcf8-b01012a6b1d2"},"sequence":407,"recorded_at":1780531400000809,"record_type":"event","durability":"durable","causation_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","run_stream":{"kind":"run","id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc"},"task_stream":{"kind":"task","id":"01a0a9b0-3931-7303-ab58-c394e5851396"},"task_id":"01a0a9b0-3931-7303-ab58-c394e5851396","event":{"kind":"output","task_id":"01a0a9b0-3931-7303-ab58-c394e5851396","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n(1039 line(s) above)\n1040|        }\n1041|    } catch {\n1042|        Issue.record(\"Unexpected error: \\(error)\")\n1043|    }\n1044|}\n1045|\n1046|// MARK: - Group access uses fresh API membership (imported drift)\n1047|\n1048|private func groupsPayload(_ groups: [(Int64, String)]) -> GitHubHTTPResponse {\n1049|    jsonResponse([\"runner_groups\": groups.map { id, name in\n1050|        [\"id\": id, \"name\": name, \"visibility\": \"selected\", \"allows_public_repositories\": true] as [String: Any]\n1051|    }])\n1052|}\n1053|\n1054|private func groupRunnersPayload(_ runners: [(Int64, String, Bool)]) -> GitHubHTTPResponse {\n1055|    jsonResponse([\"runners\": runners.map { id, name, busy in\n1056|        [\"id\": id, \"name\": name, \"labels\": [], \"status\": \"online\", \"busy\": busy] as [String: Any]\n1057|    }])\n1058|}\n1059|\n1060|private func groupReposPayload(_ ids: [Int64]) -> GitHubHTTPResponse {\n1061|    jsonResponse([\"repositories\": ids.map { [\"id\": $0] }])\n1062|}\n1063|\n1064|private func loadedGroupAccess(_ logger: Relux.Testing.Logger, id: String) -> Runners.GroupAccess? {\n1065|    for action in runnersActions(logger).reversed() {\n1066|        if case .groupAccessLoaded(let loadedID, let access) = action, loadedID == id {\n1067|            return access\n1068|        }\n1069|    }\n1070|    return nil\n1071|}\n1072|\n1073|private func groupAccessError(_ logger: Relux.Testing.Logger, id: String) -> String? {\n1074|    for action in runnersActions(logger).reversed() {\n1075|        if case .groupAccessFailed(let failedID, let message) = action, failedID == id {\n1076|            return message\n1077|        }\n1078|    }\n1079|    return nil\n1080|}\n1081|\n1082|@Test func groupAccessUsesFreshAPIMembershipNotStalePool() async throws {\n1083|    // Local .runner carries stale pool3 fields; fresh API puts ID39 in group4.\n1084|    // Same-name foreign ID99 sits in group3 and must never be adopted.\n1085|    let harness = await catalogHarness(transportResponses: [\n1086|        groupsPayload([(3, \"old-group\"), (4, \"current-group\")]),\n1087|        groupRunnersPayload([(99, \"macbook-iv\", false)]),\n1088|        groupRunnersPayload([(39, \"macbook-iv\", true)]),\n1089|        groupReposPayload([101, 102])\n1090|    ])\n1091|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1092|    let dir = harness.home.appendingPathComponent(\"r\")\n1093|    try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)\n1094|    let stale: [String: Any] = [\n1095|        \"agentId\": 39, \"agentName\": \"macbook-iv\",\n1096|        \"poolId\": 3, \"poolName\": \"rose-air-projects\",\n1097|        \"gitHubUrl\": \"https://github.com/acme\", \"workFolder\": \"_work\"\n1098|    ]\n1099|    try JSONSerialization.data(withJSONObject: stale).write(to: dir.appendingPathComponent(\".runner\"))\n1100|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"runsvc.sh\"), atomically: true, encoding: .utf8)\n1101|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n1102|    let manifest: [String: Any] = [\n1103|        \"Label\": \"actions.runner.test.drift\",\n1104|        \"ProgramArguments\": [dir.appendingPathComponent(\"runsvc.sh\").path],\n1105|        \"WorkingDirectory\": dir.path, \"RunAtLoad\": false\n1106|    ]\n1107|    try PropertyListSerialization.data(fromPropertyList: manifest, format: .xml, options: 0)\n1108|        .write(to: dir.appendingPathComponent(\"manual-service.plist\"))\n1109|    let entry = RunnerCatalogStore.Entry(\n1110|        directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n1111|        serviceLabel: \"actions.runner.test.drift\",\n1112|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n1113|        controllerKind: .manualManaged, serverHost: \"github.com\",\n1114|        scopeKind: \"org\", scope: \"acme\", remoteAgentID: 39,\n1115|        agentName: \"macbook-iv\", workFolder: \"_work\"\n1116|    )\n1117|    try await harness.catalog.add(entry)\n1118|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.drift\"))\n1119|    let access = loadedGroupAccess(harness.logger, id: \"actions.runner.test.drift\")\n1120|    #expect(access?.group?.id == 4)\n1121|    #expect(access?.group?.name == \"current-group\")\n1122|    #expect(access?.repoIDs == [101, 102])\n1123|    #expect(access?.owned == false)\n1124|    #expect(groupAccessError(harness.logger, id: \"actions.runner.test.drift\") == nil)\n1125|}\n1126|\n1127|@Test func groupAccessRefusesRepoScope() async throws {\n1128|    let harness = await catalogHarness()\n1129|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1130|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme/app\", label: \"actions.runner.test.repo\")\n1131|    let entry = RunnerCatalogStore.Entry(\n1132|        directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n1133|        serviceLabel: \"actions.runner.test.repo\",\n1134|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n1135|        controllerKind: .manualManaged, serverHost: \"github.com\",\n1136|        scopeKind: \"repo\", scope: \"acme/app\", remoteAgentID: 42, agentName: \"r\", workFolder: \"_work\"\n1137|    )\n1138|    try await harness.catalog.add(entry)\n1139|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.repo\"))\n1140|    let err = groupAccessError(harness.logger, id: \"actions.runner.test.repo\") ?? \"\"\n1141|    #expect(err.contains(\"organization runners only\"))\n1142|    #expect(await harness.transport.requests.isEmpty)\n1143|}\n1144|\n1145|@Test func applyGroupAccessRequiresTakeoverForShared() async throws {\n1146|    let harness = await catalogHarness(transportResponses: [\n1147|        groupsPayload([(4, \"team-group\")]),\n1148|        groupRunnersPayload([(42, \"r\", false)]),\n1149|        groupReposPayload([1])\n1150|    ])\n1151|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1152|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.shared\")\n1153|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.shared\"))\n1154|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.shared\"))\n1155|    #expect(loadedGroupAccess(harness.logger, id: \"actions.runner.test.shared\")?.owned == false)\n1156|    // Without takeover: refused before any PUT.\n1157|    await harness.transport.append(groupsPayload([(4, \"team-group\")]))\n1158|    await harness.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1159|    let _: Relux.ActionResult = await harness.flow.apply(\n1160|        Runners.Effect.applyGroupAccess(\"actions.runner.test.shared\", groupID: 4, repositories: [1, 2], allowTakeover: false)\n1161|    )\n1162|    let refused = groupAccessError(harness.logger, id: \"actions.runner.test.shared\") ?? \"\"\n1163|    #expect(refused.contains(\"team-group\"))\n1164|    #expect(await harness.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1165|    // With explicit takeover: ownership recorded, PUT applied, confirmation re-fetched.\n1166|    await harness.transport.append(groupsPayload([(4, \"team-group\")]))\n1167|    await harness.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1168|    await harness.transport.append(GitHubHTTPResponse(status: 204, body: Data()))\n1169|    await harness.transport.append(groupReposPayload([1, 2]))\n1170|    let _: Relux.ActionResult = await harness.flow.apply(\n1171|        Runners.Effect.applyGroupAccess(\"actions.runner.test.shared\", groupID: 4, repositories: [1, 2], allowTakeover: true)\n1172|    )\n1173|    // Success is proven by the fresh loaded access below; the action log\n1174|    // retains the earlier refusal by design.\n1175|    let access = loadedGroupAccess(harness.logger, id: \"actions.runner.test.shared\")\n1176|    #expect(access?.repoIDs == [1, 2])\n1177|    #expect(access?.owned == true)\n1178|    #expect(await harness.transport.requests.filter { $0.method == \"PUT\" }.count == 1)\n1179|}\n1180|\n1181|@Test func applyGroupAccessRefusesStaleGroup() async throws {\n1182|    let harness = await catalogHarness(transportResponses: [\n1183|        groupsPayload([(4, \"g4\")]),\n1184|        groupRunnersPayload([(42, \"r\", false)]),\n1185|        groupReposPayload([1])\n1186|    ])\n1187|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1188|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.stalegroup\")\n1189|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.stalegroup\"))\n1190|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"