remoteAgentID == 42)\n52|}\n53|\n54|@Test func reviewR2ScopeEditAfterLoadMustNotRetargetApply() async throws {\n55|    let h = await catalogHarness(transportResponses: [groupsPayload([(4, \"g\")]),\n56|        groupRunnersPayload([(42, \"r\", false)]), groupReposPayload([1]),\n57|        groupsPayload([(4, \"g\")]), groupRunnersPayload([(42, \"r\", false)]),\n58|        .init(status: 204), groupReposPayload([2])])\n59|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n60|    let label = \"actions.runner.test.scoperetarget\"\n61|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n62|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n63|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.loadGroupAccess(label))\n64|    #expect(loadedGroupAccess(h.logger, id: label)?.group?.id == 4)\n65|    let runner = dir.appendingPathComponent(\".runner\")\n66|    var object = try JSONSerialization.jsonObject(with: Data(contentsOf: runner)) as! [String: Any]\n67|    object[\"gitHubUrl\"] = \"https://github.com/other-org\"\n68|    try JSONSerialization.data(withJSONObject: object).write(to: runner)\n69|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true))\n70|    #expect(await h.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n71|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
