{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c651","stream":{"kind":"session","id":"01a0a9ad-5350-7732-bcf8-b01012a6b1d2"},"sequence":387,"recorded_at":1780531400000769,"record_type":"event","durability":"durable","causation_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","run_stream":{"kind":"run","id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc"},"call_id":"call_01a0a9b02128719f9af6b3b2f4a50e01","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n1|import Foundation\n2|import Testing\n3|import Relux\n4|@testable import RunnerControlCore\n5|\n6|// MARK: - Catalog lifecycle harness (production entry points, controlled IO)\n7|\n8|// TestTransport, jsonResponse, testConfig shared from GitHubTransportTests.\n9|// FakeExecutor, stopped, running shared from RunnerControlCoreTests.\n10|\n11|private struct CatalogHarness {\n12|    let flow: Runners.Flow\n13|    let logger: Relux.Testing.Logger\n14|    let transport: TestTransport\n15|    let launchExecutor: FakeExecutor\n16|    let installerExecutor: FakeExecutor\n17|    let userStore: GitHubKeychainStore\n18|    let identities: any GitHubSessionIdentityStoring\n19|    let installer: RunnerInstallerService\n20|    let catalog: RunnerCatalogStore\n21|    let service: LaunchAgentService\n22|    let home: URL\n23|    let catalogFile: URL\n24|}\n25|\n26|private func catalogHarness(\n27|    launchResults: [CommandResult] = [],\n28|    installerResults: [CommandResult] = [],\n29|    transportResponses: [GitHubHTTPResponse] = [],\n30|    seedAuth: Bool = true,\n31|    identitiesOverride: (any GitHubSessionIdentityStoring)? = nil\n32|) async -> CatalogHarness {\n33|    let logger = Relux.Testing.Logger()\n34|    let dispatcher = Relux.Dispatcher(logger: logger)\n35|    let launchExecutor = FakeExecutor(launchResults)\n36|    let installerExecutor = FakeExecutor(installerResults)\n37|    let transport = TestTransport(transportResponses)\n38|    let userStore = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n39|    let identities: any GitHubSessionIdentityStoring = identitiesOverride ?? InMemoryGitHubSessionIdentityStore()\n40|    if seedAuth {\n41|        if identitiesOverride == nil {\n42|            await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n43|        }\n44|        try? await userStore.save(\n45|            GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n46|            serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n47|        )\n48|    }\n49|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"CatalogHome-\" + UUID().uuidString)\n50|    try? FileManager.default.createDirectory(at: home, withIntermediateDirectories: true)\n51|    let catalogFile = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n52|    let catalog = RunnerCatalogStore(fileURL: catalogFile)\n53|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n54|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n55|    let installer = RunnerInstallerService(installRoot: installRoot, executor: installerExecutor)\n56|    let service = LaunchAgentService(catalog: catalog, executor: launchExecutor, userID: 501, home: home)\n57|    let api = GitHubRunnerAPIClient(transport: transport)\n58|    let refresher = GitHubTokenRefresh(transport: transport, store: userStore)\n59|    let flow = await Runners.Flow(\n60|        service: service, catalog: catalog, installer: installer,\n61|        api: api, userStore: userStore, identities: identities,\n62|        refresher: refresher, configProvider: { _ in testConfig },\n63|        home: home, dispatcher: dispatcher\n64|    )\n65|    return CatalogHarness(\n66|        flow: flow, logger: logger, transport: transport,\n67|        launchExecutor: launchExecutor, installerExecutor: installerExecutor,\n68|        userStore: userStore, identities: identities,\n69|        installer: installer, catalog: catalog, service: service,\n70|        home: home, catalogFile: catalogFile\n71|    )\n72|}\n73|\n74|private func runnersActions(_ logger: Relux.Testing.Logger) -> [Runners.Action] {\n75|    logger.actions.compactMap { $0 as? Runners.Action }\n76|}\n77|\n78|private func lastCatalogFailure(_ logger: Relux.Testing.Logger) -> String? {\n79|    for action in runnersActions(logger).reversed() {\n80|        if case .catalogFailed(let message) = action { return message }\n81|    }\n82|    return nil\n83|}\n84|\n85|\n86|private func catalogErr(_ logger: Relux.Testing.Logger) -> String {\n87|    lastCatalogFailure(logger) ?? \"\"\n88|}\n89|\n90|private func failErr(_ logger: Relux.Testing.Logger) -> String {\n91|    lastFailureMessage(logger) ?? \"\"\n92|}\n93|\n94|private func lastFailureMessage(_ logger: Relux.Testing.Logger) -> String? {\n95|    for action in runnersActions(logger).reversed() {\n96|        if case .failed(let message) = action { return message }\n97|    }\n98|    return nil\n99|}\n100|\n101|/// Creates a runner directory with `.runner`, `runsvc.sh`, `run.sh` and an\n102|/// optional manual-service plist. Returns the directory.\n103|@discardableResult\n104|private func makeRunnerDir(\n105|    parent: URL, name: String,\n106|    agentName: String = \"test-runner\", scope: String = \"acme/app\",\n107|    agentID: Int64 = 42, workFolder: String = \"_work\",\n108|    runAtLoad: Bool? = true, withPlist: Bool = true,\n109|    label: String? = nil\n110|) throws -> URL {\n111|    let dir = parent.appendingPathComponent(name)\n112|    try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)\n113|    let config: [String: Any] = [\n114|        \"agentId\": agentID, \"agentName\": agentName,\n115|        \"gitHubUrl\": \"https://github.com/\" + scope, \"workFolder\": workFolder\n116|    ]\n117|    try JSONSerialization.data(withJSONObject: config).write(to: dir.appendingPathComponent(\".runner\"))\n118|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"runsvc.sh\"), atomically: true, encoding: .utf8)\n119|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n120|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n121|    if withPlist {\n122|        let resolvedLabel = label ?? \"actions.runner.test.\\(name)\"\n123|        var plist: [String: Any] = [\n124|            \"Label\": resolvedLabel,\n125|            \"ProgramArguments\": [dir.appendingPathComponent(\"runsvc.sh\").path],\n126|            \"WorkingDirectory\": dir.path\n127|        ]\n128|        if let runAtLoad { plist[\"RunAtLoad\"] = runAtLoad }\n129|        try PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0)\n130|            .write(to: dir.appendingPathComponent(\"manual-service.plist\"))\n131|    }\n132|    return dir\n133|}\n134|\n135|private func runnersListPayload(_ runners: [[String: Any]]) -> GitHubHTTPResponse {\n136|    jsonResponse([\"runners\": runners])\n137|}\n138|\n139|private func removeTokenPayload(token: String = \"remove-token-1\") -> GitHubHTTPResponse {\n140|    jsonResponse([\"token\": token, \"expires_at\": \"2030-01-01T00:00:00Z\"])\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
