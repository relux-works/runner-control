       }\n114|        return values\n115|    }\n116|    public func setEnabled(_ enabled: Bool, id: String) async throws {\n117|        let definitions = await currentDefinitions()\n118|        guard let d = definitions.first(where: { $0.id == id }) else { throw RunnerError.message(\"Неизвестный раннер.\") }\n119|        if d.controllerKind == .unsupported {\n120|            throw RunnerError.unsupported(\"Runner «\\(d.displayTitle)» uses unsupported management. Control it with its own supervisor instead of Runner Control.\")\n121|        }\n122|        // Stop must remain possible even if someone damages registration/plist.\n123|        if enabled { try validate(d) }\n124|        let key = domain + \"/\" + d.id\n125|        let current = try await executor.run(\"/bin/launchctl\", [\"print\", key])\n126|        let state = Self.status(from: current)\n127|        if !enabled && state == .stopped || enabled && state == .running { return }\n128|        guard state != .unknown else { throw RunnerError.message(String(current.output.prefix(500))) }\n129|        if enabled && state == .failed {\n130|            let removed = try await executor.run(\"/bin/launchctl\", [\"bootout\", key])\n131|            guard removed.code == 0 else { throw RunnerError.message(removed.output) }\n132|        }\n133|        let result = try await executor.run(\"/bin/launchctl\", enabled ? [\"bootstrap\", domain, d.plist.path] : [\"bootout\", key])\n134|        guard result.code == 0 else { throw RunnerError.message(String(result.output.prefix(700))) }\n135|        for _ in 0..<30 {\n136|            let result = try await executor.run(\"/bin/launchctl\", [\"print\", key])\n137|            if Self.status(from: result) == (enabled ? .running : .stopped) { return }\n138|            try await Task.sleep(for: .milliseconds(100))\n139|        }\n140|        throw RunnerError.message(\"Не удалось подтвердить остановку. Проверьте журнал раннера и повторите проверку.\")\n141|    }\n142|}","final_result":true}}}
