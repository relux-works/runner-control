{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c59d","stream":{"kind":"session","id":"01a0a9ad-5350-7732-bcf8-b01012a6b1d2"},"sequence":297,"recorded_at":1780531400000589,"record_type":"event","durability":"durable","causation_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","run_stream":{"kind":"run","id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc"},"call_id":"call_01a0a9ae0fc573c7b0302fd378f5eed4","text":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n(699 line(s) above)\n700|            await action { Runners.Action.refreshed(mapped_snapshots) }\n701|        } catch {\n702|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n703|        }\n704|    }\n705|\n706|    /// Relinks a moved folder. Requires the new folder to hold the same\n707|    /// agent ID so a foreign installation can never steal this entry.\n708|    /// Updates the service manifest paths, preserving RunAtLoad.\n709|    private func relink(id: String, url: URL) async {\n710|        if unregisterWorking.contains(id) || working.contains(id) {\n711|            await action { Runners.Action.catalogFailed(\"Runner is busy; retry after it settles.\") }\n712|            return\n713|        }\n714|        let entries = await catalog.load()\n715|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n716|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n717|            return\n718|        }\n719|        guard url.path != entry.directoryPath else {\n720|            await action { Runners.Action.catalogCleared }\n721|            return\n722|        }\n723|        if url.path.contains(\" \") {\n724|            await action { Runners.Action.catalogFailed(\"Path contains a space; choose a location without spaces.\") }\n725|            return\n726|        }\n727|        let canonical = RunnerCatalogStore.canonical(url)\n728|        if entries.contains(where: { $0.localID != entry.localID && $0.canonicalPath == canonical }) {\n729|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.duplicateDirectory(path: url.path).localizedDescription) }\n730|            return\n731|        }\n732|        guard let info = RunnerRegistrationReader.read(directory: url) else {\n733|            await action { Runners.Action.catalogFailed(\"Cannot read .runner in the selected folder.\") }\n734|            return\n735|        }\n736|        if let stored = entry.remoteAgentID, info.agentID != stored {\n737|            await action { Runners.Action.catalogFailed(\"Selected folder is agent \\(info.agentID.map(String.init) ?? \"unknown\"), not \\(stored). Refusing to relink a foreign installation.\") }\n738|            return\n739|        }\n740|        catalogGeneration += 1\n741|        do {\n742|            let plist = URL(fileURLWithPath: entry.servicePlistPath)\n743|            // Manual manifests move with the directory; standard manifests\n744|            // stay in LaunchAgents. Update whichever manifest this entry owns.\n745|            if plist.path.hasPrefix(entry.directoryPath) {\n746|                let moved = url.appendingPathComponent(\"manual-service.plist\")\n747|                if FileManager.default.fileExists(atPath: moved.path) {\n748|                    try await installer.updateServicePaths(plist: moved, directory: url)\n749|                    entry.servicePlistPath = moved.path\n750|                }\n751|            } else {\n752|                try await installer.updateServicePaths(plist: plist, directory: url)\n753|            }\n754|            let oldPath = entry.directoryPath\n755|            entry.directoryPath = url.path\n756|            entry.canonicalPath = canonical\n757|            entry.bookmarkBase64 = RunnerCatalogStore.bookmark(for: url)\n758|            entry.agentName = info.agentName ?? entry.agentName\n759|            entry.serverHost = info.serverHost ?? entry.serverHost\n760|            entry.scope = info.scopeDetail ?? entry.scope\n761|            entry.scopeKind = info.scopeKind ?? entry.scopeKind\n762|            entry.remoteAgentID = info.agentID ?? entry.remoteAgentID\n763|            entry.workFolder = info.workFolder ?? entry.workFolder\n764|            // Keep a managed login registration pointing at the new\n765|            // directory so relink preserves effective login. Foreign\n766|            // same-label plists are never touched.\n767|            if entry.controllerKind == .manualManaged {\n768|                let copy = RunnerControllers.loginRegistrationURL(label: entry.serviceLabel, home: home)\n769|                if let data = try? Data(contentsOf: copy),\n770|                   var current = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],\n771|                   current[\"Label\"] as? String == entry.serviceLabel,\n772|                   current[\"WorkingDirectory\"] as? String == oldPath {\n773|                    try await installer.requireIdle(for: url)\n774|                    current[\"WorkingDirectory\"] = url.path\n775|                    current[\"ProgramArguments\"] = [url.appendingPathComponent(\"runsvc.sh\").path]\n776|                    let out = try PropertyListSerialization.data(fromPropertyList: current, format: .xml, options: 0)\n777|                    try out.write(to: copy, options: .atomic)\n778|                }\n779|            }\n780|            try await catalog.update(entry)\n781|            await action { Runners.Action.catalogCleared }\n782|            let snapshots = await service.snapshots()\n783|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n784|            await action { Runners.Action.refreshed(mapped_snapshots) }\n785|        } catch {\n786|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n787|        }\n788|    }\n789|\n790|    // MARK: - Diagnostics\n791|\n792|    private func loadLog(id: String) async {\n793|        let snapshots = await service.snapshots()\n794|        guard let snapshot = snapshots.first(where: { $0.id == id }) else {\n795|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n796|            return\n797|        }\n798|        let excerpt = RunnerDiagnostics.tail(definition: snapshot.definition)\n799|        await action { Runners.Action.logLoaded(title: snapshot.definition.displayTitle, excerpt: excerpt) }\n800|    }\n801|\n802|    // MARK: - Group access (fresh API membership)\n803|\n804|    private struct VerifiedOrgRunner: Sendable {\n805|        let entry: RunnerCatalogStore.Entry\n806|        let directory: URL\n807|        let org: String\n808|        let agentID: Int64\n809|        let agentName: String\n810|    }\n811|\n812|    /// Verifies the local `.runner` identity for group reads/writes: agent\n813|    /// ID, name, server and org scope must all be present and bound to the\n814|    /// catalog entry. Local pool fields are ignored (they can lag); the\n815|    /// group answer always comes from fresh API membership below.\n816|    private func verifiedOrgRunner(id: String) async throws -> VerifiedOrgRunner {\n817|        let entries = await catalog.load()\n818|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n819|            throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n820|        }\n821|        let directory = RunnerCatalogStore.resolve(entry: entry)\n822|        guard let local = await installer.readLocalRegistration(directory: directory),\n823|              let agentID = local.agentID,\n824|              let agentName = local.agentName, !agentName.isEmpty,\n825|              let address = local.gitHubURL,\n826|              let url = URL(string: address), url.scheme == \"https\" else {\n827|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n828|                \"No verified local registration for '\\(entry.serviceLabel)'. Refusing group access for another runner.\"\n829|            )\n830|        }\n831|        let components = url.pathComponents.filter { $0 != \"/\" }\n832|        guard components.count == 1 else {\n833|            throw RunnerRegistration.RegistrationError.groupNotApplicable\n834|        }\n835|        if let stored = entry.remoteAgentID, stored != agentID {\n836|            throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n837|                \"Catalog expects agent \\(stored) but disk shows agent \\(agentID). Refusing group access for a mismatched registration.\"\n838|            )\n839|        }\n840|        return VerifiedOrgRunner(entry: entry, directory: directory, org: components[0], agentID: agentID, agentName: agentName)\n841|    }\n842|\n843|    /// Resolves the runner's current GitHub group by fresh API membership:\n844|    /// lists every group, then each group's runners, matching by agent ID\n845|    /// (and exact name on the matched ID). Never reads `.runner` pool\n846|    /// fields and never adopts a same-name foreign runner or group.\n847|    private func resolveFreshGroup(\n848|        org: String, agentID: Int64, agentName: String,\n849|        auth: CatalogUserToken, generation gen: Int\n850|    ) async throws -> RunnerRegistration.RunnerGroup {\n851|        let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n852|        for group in groups {\n853|            if isCatalogStale(gen) { throw CancellationError() }\n854|            let members = try await api.fetchGroupRunners(config: auth.config, token: auth.token, org: org, groupID: group.id)\n855|            if let exact = members.first(where: { $0.id == agentID }) {\n856|                guard exact.name == agentName else {\n857|                    throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n858|                        \"Group '\\(group.name)' lists agent \\(agentID) as '\\(exact.name)', not '\\(agentName)'. Refusing a mismatched group.\"\n859|                    )\n860|                }\n861|                return group\n862|            }\n863|            // A same-name foreign member in this group is ignored: only the\n864|            // exact agent ID binds membership.\n865|        }\n866|        throw RunnerRegistration.RegistrationError.remoteRunnerNotFound(\n867|            \"Agent \\(agentID) is not in any visible group for '\\(org)'. It may have been moved or the App lacks group access.\"\n868|        )\n869|    }\n870|\n871|    /// Loads fresh group + repository access for one org runner. Display and\n872|    /// later edits use this API answer, never stale `.runner` pool fields.\n873|    private func loadGroupAccess(id: String) async {\n874|        let gen = catalogGeneration\n875|        let startedIdentity = await identities.load()\n876|        await action { Runners.Action.groupAccessLoading(id) }\n877|        do {\n878|            let verified = try await verifiedOrgRunner(id: id)\n879|            let auth = try await currentUserToken()\n880|            if isCatalogStale(gen) { return }\n881|            guard let started = startedIdentity, await identities.load()?.userID == started.userID else { return }\n882|            let verifiedHost = URL(string: (await installer.readLocalRegistration(directory: verified.directory))?.gitHubURL ?? \"\")?.host ?? \"\"\n883|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n884|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n885|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n886|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost).\"\n887|                )\n888|            }\n889|            let group = try await resolveFreshGroup(\n890|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n891|                auth: auth, generation: gen\n892|            )\n893|            if isCatalogStale(gen) { return }\n894|            let repoIDs = try await api.fetchGroupRepositories(\n895|                config: auth.config, token: auth.token, org: verified.org, groupID: group.id\n896|            )\n897|            if isCatalogStale(gen) { return }\n898|            let owned = await installer.loadOwnedGroupID(\n899|                serverHost: auth.identity.serverHost, org: verified.org, name: group.name\n900|            ) == group.id\n901|            let access = Runners.GroupAccess(\n902|                group: group, repoIDs: repoIDs.sorted(), updatedAt: now(),\n903|                owned: owned, loading: false\n904|            )\n905|            await action { Runners.Action.groupAccessLoaded(id, access) }\n906|        } catch is CancellationError {\n907|            return\n908|        } catch {\n909|            if !isCatalogStale(gen) {\n910|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n911|                await action { Runners.Action.groupAccessFailed(id, message) }\n912|            }\n913|        }\n914|    }\n915|\n916|    /// True when the GitHub session still matches the session this operation\n917|    /// started with. A logout, account or server switch mid-operation stops\n918|    /// silently: no writes into a changed session.\n919|    private func sessionStill(_ started: GitHubSessionIdentity?) async -> Bool {\n920|        let current = await identities.load()\n921|        guard let started else { return current == nil }\n922|        guard let current else { return false }\n923|        return current.userID == started.userID\n924|            && RunnerRegistration.OperationIdentity.normalizeServerHost(current.serverHost)\n925|                == RunnerRegistration.OperationIdentity.normalizeServerHost(started.serverHost)\n926|    }\n927|\n928|    /// Write-path identity binding for group edits. Re-reads the mutable\n929|    /// local registration and requires it to still match the verified\n930|    /// server host, org scope, agent ID and name, and requires the catalog\n931|    /// entry to still point at the verified canonical directory. A\n932|    /// same-path foreign host, a scope edit, or a relink mid-flight fails\n933|    /// instead of writing another server's group. Called after\n934|    /// authentication and re-called at the PUT boundary.\n935|    private func bindApplyIdentity(verified: VerifiedOrgRunner, auth: CatalogUserToken) async throws {\n936|        guard let reread = await installer.readLocalRegistration(directory: verified.directory),\n937|              reread.agentID == verified.agentID,\n938|              reread.agentName == verified.agentName,\n939|              let address = reread.gitHubURL,\n940|              let url = URL(string: address), url.scheme == \"https\" else {\n941|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n942|                \"Local registration changed during group apply. Reload instead of editing with stale identity.\"\n943|            )\n944|        }\n945|        let components = url.pathComponents.filter { $0 != \"/\" }\n946|        guard components.count == 1, components[0] == verified.org else {\n947|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n948|                \"Local registration scope changed during group apply. Reload instead of editing with stale identity.\"\n949|            )\n950|        }\n951|        let verifiedHost = url.host ?? \"\"\n952|        guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n953|            == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n954|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n955|                \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost). Refusing cross-server group apply.\"\n956|            )\n957|        }\n958|        let canonical = RunnerCatalogStore.canonical(verified.directory)\n959|        let current = await catalog.load()\n960|        guard current.contains(where: { $0.localID == verified.entry.localID && $0.canonicalPath == canonical }) else {\n961|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n962|                \"Catalog entry changed during group apply. Reload instead of editing another entry's group.\"\n963|            )\n964|        }\n965|    }\n966|\n967|    /// Applies edited repository access to the runner's fresh group. Rejects\n968|    /// stale UI (group moved since load), shared groups without explicit\n969|    /// takeover, and partial confirmations. Binds server+scope+agentID+\n970|    /// canonical service identity on this write path — never assumed from an\n971|    /// earlier Load — and preserves that binding over every asynchronous\n972|    /// boundary and session change up to the PUT. Reuses the registration\n973|    /// ownership and confirmation gates; API-only, no installer lease.\n974|    private func applyGroupAccess(id: String, groupID: Int64, repos: Set<Int64>, allowTakeover: Bool) async {\n975|        let gen = catalogGeneration\n976|        let startedIdentity = await identities.load()\n977|        await action { Runners.Action.groupAccessLoading(id) }\n978|        do {\n979|            let verified = try await verifiedOrgRunner(id: id)\n980|            let auth = try await currentUserToken()\n981|            if isCatalogStale(gen) { return }\n982|            guard await sessionStill(startedIdentity) else { return }\n983|            try await bindApplyIdentity(verified: verified, auth: auth)\n984|            // Fresh membership re-verified at write time: a move since the\n985|            // UI loaded fails instead of editing the wrong group.\n986|            let fresh = try await resolveFreshGroup(\n987|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n988|                auth: auth, generation: gen\n989|            )\n990|            guard fresh.id == groupID else {\n991|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n992|                    \"Runner moved from group \\(groupID) to '\\(fresh.name)' (\\(fresh.id)) since loading. Reload instead of editing a stale group.\"\n993|                )\n994|            }\n995|            if isCatalogStale(gen) { return }\n996|            let owned = await installer.loadOwnedGroupID(\n997|                serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name\n998|            )\n999|            try RunnerRegistration.Gates.authorizeGroupTakeover(\n1000|                groupName: fresh.name, existingID: fresh.id,\n1001|                ownedID: owned, allowTakeover: allowTakeover\n1002|            )\n1003|            if owned != fresh.id {\n1004|                try await installer.saveOwnedGroupID(\n1005|                    serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name, groupID: fresh.id\n1006|                )\n1007|            }\n1008|            if isCatalogStale(gen) { return }\n1009|            // Re-bind at the PUT boundary: the membership and ownership\n1010|            // awaits above must not carry stale identity into the write.\n1011|            guard await sessionStill(startedIdentity) else { return }\n1012|            try await bindApplyIdentity(verified: verified, auth: auth)\n1013|            try await api.setGroupRepositories(\n1014|                config: auth.config, token: auth.token, org: verified.org,\n1015|                groupID: fresh.id, selectedRepositoryIDs: repos\n1016|            )\n1017|            if isCatalogStale(gen) { return }\n1018|            let confirmed = try await api.fetchGroupRepositories(\n1019|                config: auth.config, token: auth.token, org: verified.org, groupID: fresh.id\n1020|            )\n1021|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: repos, confirmed: confirmed)\n1022|            if isCatalogStale(gen) { return }\n1023|            let access = Runners.GroupAccess(\n1024|                group: fresh, repoIDs: confirmed.sorted(), updatedAt: now(),\n1025|                owned: true, loading: false\n1026|            )\n1027|            await action { Runners.Action.groupAccessLoaded(id, access) }\n1028|            await action { Runners.Action.catalogCleared }\n1029|        } catch is CancellationError {\n1030|            return\n1031|        } catch {\n1032|            if !isCatalogStale(gen) {\n1033|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n1034|                await action { Runners.Action.groupAccessFailed(id, message) }\n1035|            }\n1036|        }\n1037|    }\n1038|}\n1039|\n1040|/// Import gates. Each gate refuses a concrete invalid class; negative tests\n1041|/// narrow every one of them.\n1042|public enum RunnersCatalogGates {\n1043|    public static func validateImportable(_ candidate: RunnerDiscovery.Candidate) throws {\n1044|        if candidate.controllerKind == .unsupported || candidate.unsupportedReason != nil {\n1045|            throw RunnerError.unsupported(candidate.unsupportedReason ?? \"Unsupported management.\")\n1046|        }\n1047|        if !candidate.registrationReadable {\n1048|            throw RunnerError.message(\"Cannot read .runner registration.\")\n1049|        }\n1050|        if candidate.agentName == nil || candidate.agentName?.isEmpty == true {\n1051|            throw RunnerError.message(\"Registration name is missing.\")\n1052|        }\n1053|        if candidate.serverHost == nil || candidate.scope == nil {\n1054|            throw RunnerError.message(\"Server or scope is undefined.\")\n1055|        }\n1056|        if !candidate.noSpacePath || !candidate.noSpaceWork {\n1057|            throw RunnerError.noSpacePath(\"Path or work folder contains a space; relocation is required.\")\n1058|        }\n1059|        if !candidate.runsvcExists || !candidate.binaryExists {\n1060|            throw RunnerError.message(\"Runner binaries are missing (run.sh / runsvc.sh).\")\n1061|        }\n1062|        if candidate.manifest == nil {\n1063|            // Folder imports without a manifest create a service; every other\n1064|            // check above must already have passed.\n1065|            return\n1066|        }\n1067|        if !candidate.manifestMatches {\n1068|            throw RunnerError.manifestMismatch(\"Service manifest does not match the runner directory.\")\n1069|        }\n1070|        if !candidate.issues.isEmpty {\n1071|            // Issues beyond the manifest notice (folder imports) refuse.\n1072|            let blocking = candidate.issues.filter { !$0.contains(\"No service manifest\") }\n1073|            if !blocking.isEmpty {\n1074|                throw RunnerError.message(blocking.joined(separator: \" \"))\n1075|            }\n1076|        }\n1077|    }\n1078|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
