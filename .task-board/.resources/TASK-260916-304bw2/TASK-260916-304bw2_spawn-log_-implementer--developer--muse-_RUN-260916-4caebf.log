{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca87","stream":{"kind":"session","id":"01a0a9ad-5350-7732-bcf8-b01012a6b1d2"},"sequence":926,"recorded_at":1780531400001847,"record_type":"event","durability":"durable","causation_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","payload_type":"task.lifecycle.started","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","run_stream":{"kind":"run","id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc"},"task_stream":{"kind":"task","id":"01a0a9b3-4999-7090-b703-9e0103371d4e"},"task_id":"01a0a9b3-4999-7090-b703-9e0103371d4e","event":{"kind":"started","task_id":"01a0a9b3-4999-7090-b703-9e0103371d4e","span_id":"446412c3d6b217da"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca89","stream":{"kind":"session","id":"01a0a9ad-5350-7732-bcf8-b01012a6b1d2"},"sequence":927,"recorded_at":1780531400001849,"record_type":"event","durability":"durable","causation_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","run_stream":{"kind":"run","id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc"},"task_stream":{"kind":"task","id":"01a0a9b3-4999-7090-b703-9e0103371d4e"},"task_id":"01a0a9b3-4999-7090-b703-9e0103371d4e","event":{"kind":"output","task_id":"01a0a9b3-4999-7090-b703-9e0103371d4e","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n(343 line(s) above)\n344|    /// `config.sh remove` so no registration, install, recovery or second\n345|    /// unregister can overlap. Files and the service manifest stay for\n346|    /// re-registration.\n347|    private func unregister(id: String, confirmation: String) async {\n348|        guard !unregisterWorking.contains(id), !working.contains(id) else { return }\n349|        unregisterWorking.insert(id)\n350|        await action { Runners.Action.unregistering(id, true) }\n351|        await runUnregister(id: id, confirmation: confirmation)\n352|        unregisterWorking.remove(id)\n353|        await action { Runners.Action.unregistering(id, false) }\n354|    }\n355|\n356|    /// Unregister body with guaranteed operation-state release: every early\n357|    /// return below still runs the caller's epilogue, so a refused or\n358|    /// session-invalidated attempt never wedges the UI \"unregistering\"\n359|    /// state and a retry stays possible.\n360|    private func runUnregister(id: String, confirmation: String) async {\n361|        let gen = catalogGeneration\n362|        // Session ownership: the initiating session is captured once and\n363|        // re-checked at every asynchronous boundary below.\n364|        let startedIdentity = await identities.load()\n365|        do {\n366|            let entries = await catalog.load()\n367|            guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n368|                throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n369|            }\n370|            let directory = RunnerCatalogStore.resolve(entry: entry)\n371|            // Mutation authority: local verified identity plus the service\n372|            // path. A remote name match alone never authorizes removal.\n373|            guard let local = await installer.readLocalRegistration(directory: directory),\n374|                  let agentID = local.agentID,\n375|                  let agentName = local.agentName, !agentName.isEmpty,\n376|                  let address = local.gitHubURL,\n377|                  let scope = unregisterScope(address: address) else {\n378|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n379|                    \"No verified local registration for '\\(entry.serviceLabel)'. Refusing to unregister another runner by name.\"\n380|                )\n381|            }\n382|            // Service-path binding: the catalog entry must still point at the\n383|            // verified directory; a relink mid-flight invalidates the evidence.\n384|            let canonical = RunnerCatalogStore.canonical(directory)\n385|            guard canonical == entry.canonicalPath else {\n386|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n387|                    \"Service path changed during unregister. Re-verify instead of removing another directory's registration.\"\n388|                )\n389|            }\n390|            // Agent-ID binding: a stored ID that disagrees with disk fails\n391|            // closed instead of removing a foreign registration.\n392|            if let stored = entry.remoteAgentID, stored != agentID {\n393|                throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n394|                    \"Catalog expects agent \\(stored) but disk shows agent \\(agentID) for '\\(agentName)'. Refusing to unregister a mismatched registration.\"\n395|                )\n396|            }\n397|            guard confirmation == agentName else {\n398|                throw RunnerRegistration.RegistrationError.confirmationMismatch(\n399|                    \"Type '\\(agentName)' to confirm unregister of agent \\(agentID) in \\(scope.detail).\"\n400|                )\n401|            }\n402|            guard !isCatalogStale(gen) else { return }\n403|            // Stopped-only gate: a positive confirmed `.stopped` observation\n404|            // is required before minting the remove token, so unregister\n405|            // cannot interrupt a job — or a service whose state is unknown.\n406|            try await requireConfirmedStopped(entry: entry)\n407|            guard !isCatalogStale(gen) else { return }\n408|            let auth = try await currentUserToken()\n409|            guard !isCatalogStale(gen) else { return }\n410|            // Server binding: the verified host must equal the authenticated\n411|            // server; a same-path foreign host never authorizes removal here.\n412|            let verifiedHost = URL(string: address)?.host ?? \"\"\n413|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n414|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n415|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n416|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost). Refusing cross-server unregister.\"\n417|                )\n418|            }\n419|            let created = try await api.createRemoveToken(config: auth.config, token: auth.token, scope: scope)\n420|            guard !isCatalogStale(gen) else { return }\n421|            // A logout, account or server switch during token acquisition\n422|            // invalidates the unstarted side effect; the minted token\n423|            // simply expires unused.\n424|            guard await sessionStill(startedIdentity) else { return }\n425|            // Re-verify after the network: scope/path edits invalidate stale\n426|            // evidence instead of removing a re-targeted registration.\n427|            guard let reread = await installer.readLocalRegistration(directory: directory),\n428|                  reread.agentID == agentID, reread.agentName == agentName,\n429|                  reread.gitHubURL == address else {\n430|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n431|                    \"Local registration changed during unregister. Re-verify instead of removing a re-targeted registration.\"\n432|                )\n433|            }\n434|            let currentEntries = await catalog.load()\n435|            guard currentEntries.contains(where: { $0.localID == entry.localID && $0.canonicalPath == canonical }) else {\n436|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n437|                    \"Catalog entry changed during unregister. Re-verify instead of removing another entry.\"\n438|                )\n439|            }\n440|            // Revalidate the stopped evidence at the side-effect boundary: a\n441|            // service started (or lost to inspection) after the token mint\n442|            // must not be unregistered.\n443|            guard !isCatalogStale(gen) else { return }\n444|            guard await sessionStill(startedIdentity) else { return }\n445|            try await requireConfirmedStopped(entry: entry)\n446|            try await installer.unregister(directory: directory, removeToken: created.token)\n447|            guard !isCatalogStale(gen) else { return }\n448|            // Remote registration is gone; the catalog entry stays so the\n449|            // user can re-register or remove it from the app. Files stay.\n450|            // This local bookkeeping follows a completed side effect: the\n451|            // remote removal is real even if the session changed while the\n452|            // installer lease was held, and no cancellation can undo it.\n453|            var updated = entry\n454|            updated.remoteAgentID = nil\n455|            updated.lastSeenAt = now()\n456|            try await catalog.update(updated)\n457|            await action { Runners.Action.catalogCleared }\n458|            let refreshed = await service.snapshots()\n459|            let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n460|            await action { Runners.Action.refreshed(mapped_refreshed) }\n461|        } catch {\n462|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n463|                await action { Runners.Action.catalogFailed(error.localizedDescription) }\n464|            }\n465|        }\n466|    }\n467|\n468|    /// Stopped-only gate for unregister. Only a positive confirmed `.stopped`\n469|    /// observation authorizes removal. `.running` refuses with a stop-first\n470|    /// message; a missing observation and every other state (unknown, failed,\n471|    /// missing, transitional, ...) refuse as unconfirmed instead of being\n472|    /// treated as stopped. A launchctl permission error (`.unknown`) therefore\n473|    /// never authorizes `config.sh remove` on a possibly live runner.\n474|    private func requireConfirmedStopped(entry: RunnerCatalogStore.Entry) async throws {\n475|        let snapshots = await service.snapshots()\n476|        guard let observation = snapshots.first(where: { $0.id == entry.serviceLabel }) else {\n477|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n478|                \"Cannot confirm the service '\\(entry.serviceLabel)' is stopped (no observation). Refusing to unregister while the service state is unconfirmed.\"\n(more lines below)","final_result":true}}}
