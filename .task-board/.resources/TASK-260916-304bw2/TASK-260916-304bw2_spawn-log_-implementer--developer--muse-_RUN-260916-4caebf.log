{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7ff","stream":{"kind":"session","id":"01a0a9ad-5350-7732-bcf8-b01012a6b1d2"},"sequence":602,"recorded_at":1780531400001199,"record_type":"event","durability":"durable","causation_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","run_stream":{"kind":"run","id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc"},"task_stream":{"kind":"task","id":"01a0a9b1-82e1-7e51-83f7-82d145e2f566"},"task_id":"01a0a9b1-82e1-7e51-83f7-82d145e2f566","event":{"kind":"output","task_id":"01a0a9b1-82e1-7e51-83f7-82d145e2f566","chunk":"Read text file `Packages/RunnerControlCore/Tests/GitHubTransportTests.swift`.\n1|import Foundation\n2|import Testing\n3|@testable import RunnerControlCore\n4|\n5|// MARK: - Shared fakes\n6|\n7|actor TestTransport: GitHubHTTPTransport {\n8|    private var queue: [GitHubHTTPResponse]\n9|    private(set) var requests: [GitHubHTTPRequest] = []\n10|    init(_ responses: [GitHubHTTPResponse]) { self.queue = responses }\n11|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n12|        requests.append(request)\n13|        guard !queue.isEmpty else { throw GitHubTransportError.invalidResponse }\n14|        return queue.removeFirst()\n15|    }\n16|    func prepend(_ response: GitHubHTTPResponse) { queue.insert(response, at: 0) }\n17|    func append(_ response: GitHubHTTPResponse) { queue.append(response) }\n18|}\n19|\n20|func jsonResponse(_ object: Any, status: Int = 200) -> GitHubHTTPResponse {\n21|    // Static test literals always serialize.\n22|    // swiftlint:disable:next force_try\n23|    let data = try! JSONSerialization.data(withJSONObject: object)\n24|    return GitHubHTTPResponse(status: status, body: data)\n25|}\n26|\n27|let testConfig = GitHubAuth.AppConfig(clientID: \"test-client-id\")\n28|\n29|// MARK: - Config\n30|\n31|@Test func configReportsExactMissingBinding() {\n32|    let bundle = Bundle.main\n33|    // Production bundle has no GitHubAppClientID until coordinator provisions it.\n34|    // Assert the thrown binding names the exact scaffold input.\n35|    let raw = bundle.object(forInfoDictionaryKey: \"GitHubAppClientID\") as? String\n36|    if let raw, !raw.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {\n37|        // Provisioned environment: config must load.\n38|        #expect((try? GitHubAuth.AppConfig.current(bundle: bundle)) != nil)\n39|    } else {\n40|        do {\n(more lines below)","final_result":true}}}
