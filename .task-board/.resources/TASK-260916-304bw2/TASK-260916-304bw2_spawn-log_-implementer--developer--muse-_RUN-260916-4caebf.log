{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6af","stream":{"kind":"session","id":"01a0a9ad-5350-7732-bcf8-b01012a6b1d2"},"sequence":434,"recorded_at":1780531400000863,"record_type":"event","durability":"durable","causation_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","run_stream":{"kind":"run","id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc"},"call_id":"call_01a0a9b0444575fea177c27ae6e95137","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n(1258 line(s) above)\n1259|    _ = await h.flow.apply(Runners.Effect.importFolder(b))\n1260|    let entries = await h.catalog.load()\n1261|    #expect(entries.count == 2)\n1262|    #expect(Set(entries.map(\\.serviceLabel)).count == 2)\n1263|}\n1264|\n1265|@Test func reviewCrossServerGroupApplyMustRefuse() async throws {\n1266|    let h = await catalogHarness(transportResponses: [groupsPayload([(4, \"g\")]), groupRunnersPayload([(42,\"r\",false)]), .init(status:204,body:Data()), groupReposPayload([1])])\n1267|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1268|    let d = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", label: \"actions.runner.review.cross\")\n1269|    let foreign: [String: Any] = [\"agentId\":42,\"agentName\":\"r\",\"gitHubUrl\":\"https://ghe.example.com/acme\",\"workFolder\":\"_work\"]\n1270|    try JSONSerialization.data(withJSONObject:foreign).write(to:d.appendingPathComponent(\".runner\"))\n1271|    var entry = unregisterEntry(dir:d,label:\"actions.runner.review.cross\")\n1272|    entry.serverHost = \"ghe.example.com\"\n1273|    try await h.catalog.add(entry)\n1274|    _ = await h.flow.apply(Runners.Effect.applyGroupAccess(\"actions.runner.review.cross\",groupID:4,repositories:[1],allowTakeover:true))\n1275|    #expect(await h.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1276|    #expect(loadedGroupAccess(h.logger,id:\"actions.runner.review.cross\") == nil)\n1277|}\n1278|\n1279|// MARK: - R2 bounds: revalidation, session preservation, control, persistence\n1280|\n1281|/// F1 bound: a service that starts (or is lost to inspection) after the\n1282|/// token mint must not reach `config.sh remove`. The boundary revalidation\n1283|/// refuses; the installer never runs and the entry keeps its registration.\n1284|@Test func unregisterRevalidatesStoppedAtSideEffectBoundary() async throws {\n1285|    let harness = await catalogHarness(\n1286|        launchResults: [\n1287|            CommandResult(code: 113, output: \"Could not find service x\"),\n1288|            CommandResult(code: 0, output: \"state = running\")\n1289|        ],\n1290|        installerResults: [CommandResult(code: 0, output: \"ok\")],\n1291|        transportResponses: [removeTokenPayload()]\n1292|    )\n1293|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1294|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", label: \"actions.runner.test.revalidate\")\n1295|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.revalidate\"))\n1296|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.unregister(\"actions.runner.test.revalidate\", confirmation: \"r\"))\n1297|    #expect(catalogErr(harness.logger).contains(\"Stop the runner first\"))\n1298|    #expect(await harness.installerExecutor.calls.isEmpty)\n1299|    #expect(await harness.catalog.load().first?.remoteAgentID == 42)\n1300|}\n1301|\n1302|/// Session double that returns `first` for the first `flipAfter` loads and\n1303|/// `later` afterwards: a deterministic mid-operation logout.\n1304|private final class FlippingSessionStore: GitHubSessionIdentityStoring, @unchecked Sendable {\n1305|    private let lock = NSLock()\n1306|    private var loads = 0\n1307|    private let flipAfter: Int\n1308|    private var first: GitHubSessionIdentity?\n1309|    private var later: GitHubSessionIdentity?\n1310|    init(first: GitHubSessionIdentity?, later: GitHubSessionIdentity?, flipAfter: Int) {\n1311|        self.first = first\n1312|        self.later = later\n1313|        self.flipAfter = flipAfter\n1314|    }\n1315|    func save(_ identity: GitHubSessionIdentity) async {\n1316|        lock.withLock { first = identity; later = identity }\n1317|    }\n1318|    func load() async -> GitHubSessionIdentity? {\n1319|        lock.withLock {\n1320|            loads += 1\n1321|            return loads <= flipAfter ? first : later\n1322|        }\n1323|    }\n1324|    func delete() async {\n1325|        lock.withLock { first = nil; later = nil }\n1326|    }\n1327|}\n1328|\n1329|/// F2 bound: a logout between the membership reads and the PUT stops\n1330|/// silently — reads happened, the write never fires into a dead session.\n1331|/// Identity load order in apply: started(1), auth(2), post-auth check(3),\n1332|/// pre-PUT check(4); the flip lands on the pre-PUT check.\n1333|@Test func applyGroupAccessStopsWhenSessionChangesMidApply() async throws {\n1334|    let session = GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\")\n1335|    let flipping = FlippingSessionStore(first: session, later: nil, flipAfter: 3)\n1336|    let harness = await catalogHarness(\n1337|        transportResponses: [\n1338|            groupsPayload([(4, \"g4\")]),\n1339|            groupRunnersPayload([(42, \"r\", false)])\n1340|        ],\n1341|        identitiesOverride: flipping\n1342|    )\n1343|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1344|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.sessionflip\")\n1345|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.sessionflip\"))\n1346|    let _: Relux.ActionResult = await harness.flow.apply(\n1347|        Runners.Effect.applyGroupAccess(\"actions.runner.test.sessionflip\", groupID: 4, repositories: [1, 2], allowTakeover: true)\n1348|    )\n1349|    let requests = await harness.transport.requests\n1350|    #expect(requests.count == 2)\n1351|    #expect(requests.filter { $0.method == \"PUT\" }.isEmpty)\n1352|    #expect(loadedGroupAccess(harness.logger, id: \"actions.runner.test.sessionflip\") == nil)\n1353|    #expect(groupAccessError(harness.logger, id: \"actions.runner.test.sessionflip\") == nil)\n1354|}\n1355|\n1356|/// F2 bound: a server switch between the membership reads and the PUT\n1357|/// also stops silently, even when the user ID is unchanged.\n1358|@Test func applyGroupAccessStopsWhenServerSwitchesMidApply() async throws {\n1359|    let first = GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\")\n1360|    let switched = GitHubSessionIdentity(serverHost: \"ghe.example.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\")\n1361|    let flipping = FlippingSessionStore(first: first, later: switched, flipAfter: 3)\n1362|    let harness = await catalogHarness(\n1363|        transportResponses: [\n1364|            groupsPayload([(4, \"g4\")]),\n1365|            groupRunnersPayload([(42, \"r\", false)])\n1366|        ],\n1367|        identitiesOverride: flipping\n1368|    )\n1369|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1370|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.serverswitch\")\n1371|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.serverswitch\"))\n1372|    let _: Relux.ActionResult = await harness.flow.apply(\n1373|        Runners.Effect.applyGroupAccess(\"actions.runner.test.serverswitch\", groupID: 4, repositories: [1, 2], allowTakeover: true)\n1374|    )\n1375|    let requests = await harness.transport.requests\n1376|    #expect(requests.count == 2)\n1377|    #expect(requests.filter { $0.method == \"PUT\" }.isEmpty)\n1378|    #expect(loadedGroupAccess(harness.logger, id: \"actions.runner.test.serverswitch\") == nil)\n1379|    #expect(groupAccessError(harness.logger, id: \"actions.runner.test.serverswitch\") == nil)\n1380|}\n1381|\n1382|/// F3 bound: the store itself refuses a second entry sharing one service\n1383|/// label, so no import path can create an uncontrollable duplicate.\n1384|@Test func catalogRefusesDuplicateServiceLabel() async throws {\n1385|    let file = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n1386|    defer { try? FileManager.default.removeItem(at: file) }\n1387|    let store = RunnerCatalogStore(fileURL: file)\n1388|    let root = FileManager.default.temporaryDirectory.appendingPathComponent(\"DupLabel-\" + UUID().uuidString)\n1389|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n1390|    defer { try? FileManager.default.removeItem(at: root) }\n1391|    let a = root.appendingPathComponent(\"a\")\n1392|    let b = root.appendingPathComponent(\"b\")\n1393|    try FileManager.default.createDirectory(at: a, withIntermediateDirectories: true)\n1394|    try FileManager.default.createDirectory(at: b, withIntermediateDirectories: true)\n1395|    let first = RunnerCatalogStore.Entry(\n1396|        directoryPath: a.path, canonicalPath: RunnerCatalogStore.canonical(a),\n1397|        serviceLabel: \"actions.runner.test.dup\",\n1398|        servicePlistPath: a.appendingPathComponent(\"manual-service.plist\").path,\n1399|        controllerKind: .manualManaged\n1400|    )\n1401|    try await store.add(first)\n1402|    let second = RunnerCatalogStore.Entry(\n1403|        directoryPath: b.path, canonicalPath: RunnerCatalogStore.canonical(b),\n1404|        serviceLabel: \"actions.runner.test.dup\",\n1405|        servicePlistPath: b.appendingPathComponent(\"manual-service.plist\").path,\n1406|        controllerKind: .manualManaged\n1407|    )\n1408|    do {\n1409|        try await store.add(second)\n1410|        Issue.record(\"Catalog admitted two entries sharing one service label\")\n1411|    } catch let error as RunnerCatalogStore.CatalogError {\n1412|        guard case .duplicateLabel(let label) = error, label == \"actions.runner.test.dup\" else {\n1413|            Issue.record(\"Wrong duplicate-label error: \\(error)\"); return\n1414|        }\n1415|    }\n1416|    #expect(await store.load().count == 1)\n1417|}\n1418|\n1419|/// F3 bound: same-name imports are independently controllable — enabling\n1420|/// each runner bootstraps its own manifest, never the sibling's.\n1421|@Test func sameNameFolderImportsControlIndependently() async throws {\n1422|    let stoppedResult = CommandResult(code: 113, output: \"Could not find service x\")\n1423|    let okResult = CommandResult(code: 0, output: \"\")\n1424|    let runningResult = CommandResult(code: 0, output: \"state = running\")\n1425|    let harness = await catalogHarness(launchResults: [\n1426|        stoppedResult, stoppedResult, stoppedResult,\n1427|        stoppedResult, okResult, runningResult, runningResult, runningResult,\n1428|        stoppedResult, okResult, runningResult, runningResult, runningResult\n1429|    ])\n1430|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1431|    let a = try makeRunnerDir(parent: harness.home, name: \"a\", agentName: \"same\", scope: \"acme/a\", withPlist: false)\n1432|    let b = try makeRunnerDir(parent: harness.home, name: \"b\", agentName: \"same\", scope: \"acme/b\", withPlist: false)\n1433|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.importFolder(a))\n1434|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.importFolder(b))\n1435|    let entries = await harness.catalog.load()\n1436|    #expect(entries.count == 2)\n1437|    let labels = entries.map(\\.serviceLabel)\n1438|    #expect(Set(labels).count == 2)\n1439|    for label in labels {\n1440|        let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.setEnabled(label, true))\n1441|    }\n1442|    let bootstraps = await harness.launchExecutor.calls.filter { $0.contains(\"bootstrap\") }\n1443|    #expect(bootstraps.count == 2)\n1444|    let targets = Set(bootstraps.compactMap(\\.last))\n1445|    #expect(targets == [\n1446|        a.appendingPathComponent(\"manual-service.plist\").path,\n1447|        b.appendingPathComponent(\"manual-service.plist\").path\n1448|    ])\n1449|}\n1450|\n1451|/// F3 bound: a manifest label already owned by another entry refuses the\n1452|/// second import instead of creating an uncontrollable duplicate.\n1453|@Test func importRefusesConflictingManifestLabel() async throws {\n1454|    let harness = await catalogHarness(launchResults: [\n1455|        CommandResult(code: 113, output: \"Could not find service x\")\n1456|    ])\n1457|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1458|    let a = try makeRunnerDir(parent: harness.home, name: \"a\", agentName: \"r\", scope: \"acme/a\", label: \"actions.runner.test.clash\")\n1459|    let b = try makeRunnerDir(parent: harness.home, name: \"b\", agentName: \"r\", scope: \"acme/b\", label: \"actions.runner.test.clash\")\n1460|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.importFolder(a))\n1461|    #expect(await harness.catalog.load().count == 1)\n1462|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.importFolder(b))\n1463|    #expect(await harness.catalog.load().count == 1)\n1464|    #expect(catalogErr(harness.logger).contains(\"already in the catalog\"))\n1465|}\n1466|\n1467|/// F4 bound: a malformed store fails closed — no migration, no overwrite —\n1468|/// and the bytes stay untouched for recovery.\n1469|@Test func migrationFailsClosedOnMalformedPersistence() async throws {\n1470|    let file = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n1471|    defer { try? FileManager.default.removeItem(at: file) }\n1472|    try \"not-json{{\".write(to: file, atomically: true, encoding: .utf8)\n1473|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"MalformedHome-\" + UUID().uuidString)\n1474|    try FileManager.default.createDirectory(at: home, withIntermediateDirectories: true)\n1475|    defer { try? FileManager.default.removeItem(at: home) }\n1476|    let store = RunnerCatalogStore(fileURL: file)\n1477|    do {\n1478|        _ = try await store.migrateIfNeeded(home: home)\n1479|        Issue.record(\"Migration treated malformed persistence as first-run absence\")\n1480|    } catch let error as RunnerCatalogStore.CatalogError {\n1481|        guard case .persistenceUnreadable = error else {\n1482|            Issue.record(\"Wrong malformed error: \\(error)\"); return\n1483|        }\n1484|    }\n1485|    let entry = RunnerCatalogStore.Entry(\n1486|        directoryPath: \"/tmp/x\", canonicalPath: \"/tmp/x\",\n1487|        serviceLabel: \"actions.runner.test.clobber\",\n1488|        servicePlistPath: \"/tmp/x/manual-service.plist\",\n1489|        controllerKind: .manualManaged\n1490|    )\n1491|    do {\n1492|        try await store.add(entry)\n1493|        Issue.record(\"Add overwrote malformed persistence\")\n1494|    } catch let error as RunnerCatalogStore.CatalogError {\n1495|        guard case .persistenceUnreadable = error else {\n1496|            Issue.record(\"Wrong clobber error: \\(error)\"); return\n1497|        }\n1498|    }\n1499|    #expect(await store.load().isEmpty)\n1500|    #expect(try String(contentsOf: file, encoding: .utf8) == \"not-json{{\")\n1501|}\n1502|\n1503|/// F4 bound: an unsupported catalog version fails closed instead of\n1504|/// migrating or overwriting.\n1505|@Test func migrationFailsClosedOnUnsupportedVersion() async throws {\n1506|    let file = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n1507|    defer { try? FileManager.default.removeItem(at: file) }\n1508|    try \"{\\\"version\\\":999,\\\"entries\\\":[],\\\"migrated\\\":true}\".write(to: file, atomically: true, encoding: .utf8)\n1509|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"VersionHome-\" + UUID().uuidString)\n1510|    try FileManager.default.createDirectory(at: home, withIntermediateDirectories: true)\n1511|    defer { try? FileManager.default.removeItem(at: home) }\n1512|    let store = RunnerCatalogStore(fileURL: file)\n1513|    do {\n1514|        _ = try await store.migrateIfNeeded(home: home)\n1515|        Issue.record(\"Migration treated an unsupported version as first-run absence\")\n1516|    } catch let error as RunnerCatalogStore.CatalogError {\n1517|        guard case .unsupportedVersion(let found) = error, found == 999 else {\n1518|            Issue.record(\"Wrong version error: \\(error)\"); return\n1519|        }\n1520|    }\n1521|    #expect(try String(contentsOf: file, encoding: .utf8).contains(\"\\\"version\\\":999\"))\n1522|}\n1523|\n1524|/// F4 bound: a legacy store without the migrated flag seals in place —\n1525|/// entries untouched — and a later explicit emptying stays authoritative.\n1526|@Test func migrationSealsLegacyStoreWithoutTouchingEntries() async throws {\n1527|    let file = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n1528|    defer { try? FileManager.default.removeItem(at: file) }\n1529|    let dir = FileManager.default.temporaryDirectory.appendingPathComponent(\"Legacy-\" + UUID().uuidString)\n1530|    try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)\n1531|    defer { try? FileManager.default.removeItem(at: dir) }\n1532|    let entry = RunnerCatalogStore.Entry(\n1533|        localID: \"legacy-local-id\",\n1534|        directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n1535|        serviceLabel: \"actions.runner.test.legacy\",\n1536|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n1537|        controllerKind: .manualManaged, agentName: \"legacy\"\n1538|    )\n1539|    let entryJSON = String(data: try JSONEncoder().encode(entry), encoding: .utf8)!\n1540|    try \"{\\\"version\\\":1,\\\"entries\\\":[\\(entryJSON)]}\".write(to: file, atomically: true, encoding: .utf8)\n1541|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"LegacyHome-\" + UUID().uuidString)\n1542|    try FileManager.default.createDirectory(at: home, withIntermediateDirectories: true)\n1543|    defer { try? FileManager.default.removeItem(at: home) }\n1544|    let store = RunnerCatalogStore(fileURL: file)\n1545|    let sealed = try await store.migrateIfNeeded(home: home)\n1546|    #expect(sealed.count == 1)\n1547|    #expect(sealed.first?.localID == \"legacy-local-id\")\n1548|    #expect(try String(contentsOf: file, encoding: .utf8).contains(\"\\\"migrated\\\":true\"))\n1549|    _ = try await store.remove(localID: \"legacy-local-id\")\n1550|    #expect(try await store.migrateIfNeeded(home: home).isEmpty)\n1551|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
