{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c7","stream":{"kind":"session","id":"01a0a9ad-5350-7732-bcf8-b01012a6b1d2"},"sequence":190,"recorded_at":1780531400000375,"record_type":"event","durability":"durable","causation_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","run_stream":{"kind":"run","id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc"},"task_stream":{"kind":"task","id":"01a0a9ad-cf29-7321-96a7-5e2c29d46476"},"task_id":"01a0a9ad-cf29-7321-96a7-5e2c29d46476","event":{"kind":"output","task_id":"01a0a9ad-cf29-7321-96a7-5e2c29d46476","chunk":"Read text file `/tmp/r3/probes.swift`.\n1|\n2|private actor ReviewLogoutTransport: GitHubHTTPTransport {\n3|    let base: TestTransport\n4|    let identities: any GitHubSessionIdentityStoring\n5|    let logoutMethod: String\n6|    init(_ base: TestTransport, identities: any GitHubSessionIdentityStoring, logoutMethod: String) {\n7|        self.base = base; self.identities = identities; self.logoutMethod = logoutMethod\n8|    }\n9|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n10|        let result = try await base.send(request)\n11|        if request.method == logoutMethod { await identities.delete() }\n12|        return result\n13|    }\n14|}\n15|\n16|private func reviewLogoutFlow(_ h: CatalogHarness, method: String) async -> Runners.Flow {\n17|    let transport = ReviewLogoutTransport(h.transport, identities: h.identities, logoutMethod: method)\n18|    return await Runners.Flow(service: h.service, catalog: h.catalog, installer: h.installer,\n19|        api: GitHubRunnerAPIClient(transport: transport), userStore: h.userStore,\n20|        identities: h.identities, refresher: GitHubTokenRefresh(transport: transport, store: h.userStore),\n21|        configProvider: { _ in testConfig }, home: h.home,\n22|        dispatcher: Relux.Dispatc