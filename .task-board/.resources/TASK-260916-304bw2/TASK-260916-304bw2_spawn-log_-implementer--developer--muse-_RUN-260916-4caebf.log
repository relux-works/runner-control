{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c567","stream":{"kind":"session","id":"01a0a9ad-5350-7732-bcf8-b01012a6b1d2"},"sequence":270,"recorded_at":1780531400000535,"record_type":"event","durability":"durable","causation_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc","run_stream":{"kind":"run","id":"7dbcf4d4-d16c-4240-8d6f-402893985bdc"},"task_stream":{"kind":"task","id":"01a0a9ae-08c1-7863-b719-848ac364b55e"},"task_id":"01a0a9ae-08c1-7863-b719-848ac364b55e","event":{"kind":"output","task_id":"01a0a9ae-08c1-7863-b719-848ac364b55e","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n1|import Foundation\n2|import Relux\n3|extension Runners {\n4|    public protocol IFlow: Relux.Flow {}\n5|    public actor Flow {\n6|        public let dispatcher: Relux.Dispatcher\n7|        private let service: any RunnerServicing\n8|        private let catalog: RunnerCatalogStore\n9|        private let installer: RunnerInstallerService\n10|        private let api: GitHubRunnerAPIClient\n11|        private let userStore: any GitHubCredentialStoring\n12|        private let identities: any GitHubSessionIdentityStoring\n13|        private let refresher: GitHubTokenRefresh\n14|        private let configProvider: @Sendable (String?) throws -> GitHubAuth.AppConfig\n15|        private let now: @Sendable () -> Date\n16|        private let home: URL\n17|        private var working: Set<String> = []\n18|        private var refreshing = false\n19|        private var revision = 0\n20|        private var pendingOp: [String: OperationPhase] = [:]\n21|        private var unregisterWorking: Set<String> = []\n22|        private var catalogGeneration = 0\n23|        public init(service: any RunnerServicing, dispatcher: Relux.Dispatcher? = nil) async {\n24|            self.service = service\n25|            self.catalog = RunnerCatalogStore()\n26|            self.installer = RunnerInstallerService()\n27|            let transport = URLSessionGitHubTransport()\n28|            let store: any GitHubCredentialStoring = GitHubKeychainStore()\n29|            self.api = GitHubRunnerAPIClient(transport: transport)\n30|            self.userStore = store\n31|            self.identities = UserDefaultsGitHubSessionIdentityStore()\n32|            self.refresher = GitHubTokenRefresh(transport: transport, store: store)\n33|            self.configProvider = { host in try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\") }\n34|            self.now = Date.init\n35|            self.home = FileManager.default.homeDirectoryForCurrentUser\n36|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n37|        }\n38|        /// Testable init with explicit catalog, installer and auth dependencies.\n39|        /// Production passes the shared installer so unregister/recovery and\n40|        /// registration cannot overlap.\n41|        public init(\n42|            service: any RunnerServicing,\n43|            catalog: RunnerCatalogStore,\n44|            installer: RunnerInstallerService,\n45|            api: GitHubRunnerAPIClient,\n46|            userStore: any GitHubCredentialStoring,\n47|            identities: any GitHubSessionIdentityStoring,\n48|            refresher: GitHubTokenRefresh,\n49|            configProvider: (@Sendable (String?) throws -> GitHubAuth.AppConfig)? = nil,\n50|            now: (@Sendable () -> Date)? = nil,\n51|            home: URL? = nil,\n52|            dispatcher: Relux.Dispatcher? = nil\n53|        ) async {\n54|            self.service = service\n55|            self.catalog = catalog\n56|            self.installer = installer\n57|            self.api = api\n58|            self.userStore = userStore\n59|            self.identities = identities\n60|            self.refresher = refresher\n61|            self.configProvider = configProvider ?? { host in try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\") }\n62|            self.now = now ?? Date.init\n63|            self.home = home ?? FileManager.default.homeDirectoryForCurrentUser\n64|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n65|        }\n66|    }\n67|}\n68|extension Runners.Flow: Runners.IFlow {\n69|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n70|        guard let effect = effect as? Runners.Effect else { return .success }\n71|        switch effect {\n72|        case .refresh: await refresh()\n73|        case .setEnabled(let id, let enabled): await setEnabled(id: id, enabled: enabled)\n74|        case .setEnabledMany(let ids, let enabled): await setEnabledMany(ids: ids, enabled: enabled)\n75|        case .loadCatalog: await loadCatalog()\n76|        case .discover: await discover()\n77|        case .importCandidate(let candidate): await importCandidate(candidate)\n78|        case .importFolder(let url): await importFolder(url)\n79|        case .removeFromApp(let id): await removeFromApp(id: id)\n80|        case .unregister(let id, let confirmation): await unregister(id: id, confirmation: confirmation)\n81|        case .refreshRemote: await refreshRemote()\n82|        case .setRunAtLoad(let id, let value): await setRunAtLoad(id: id, value: value)\n83|        case .setAlias(let id, let alias): await setAlias(id: id, alias: alias)\n84|        case .relinkDirectory(let id, let url): await relink(id: id, url: url)\n85|        case .selectRunner(let id): await action { Runners.Action.selected(id) }\n86|        case .loadLog(let id): await loadLog(id: id)\n87|        case .clearLog: await action { Runners.Action.logCleared }\n88|        case .loadGroupAccess(let id): await loadGroupAccess(id: id)\n89|        case .applyGroupAccess(let id, let groupID, let repos, let allowTakeover):\n90|            await applyGroupAccess(id: id, groupID: groupID, repos: repos, allowTakeover: allowTakeover)\n91|        }\n92|        return .success\n93|    }\n94|\n95|    private func isCatalogStale(_ gen: Int) -> Bool { catalogGeneration != gen }\n96|\n97|    // MARK: - Local refresh and power\n98|\n99|    private func refresh() async {\n100|        guard !refreshing, working.isEmpty else { return }\n101|        refreshing = true\n102|        let startedAt = revision\n103|        let snapshots = await service.snapshots()\n104|        // Do not publish a stale read if a command started during this await.\n105|        if working.isEmpty && revision == startedAt {\n106|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n107|            await action { Runners.Action.refreshed(mapped_snapshots) }\n108|        }\n109|        refreshing = false\n110|    }\n111|\n112|    private func withPendingOp(_ snapshots: [Runners.Snapshot]) -> [Runners.Snapshot] {\n113|        Self.applyPending(snapshots, pending: pendingOp)\n114|    }\n115|\n116|    private nonisolated static func applyPending(_ snapshots: [Runners.Snapshot], pending: [String: Runners.OperationPhase]) -> [Runners.Snapshot] {\n117|        snapshots.map { snapshot in\n118|            var next = snapshot\n119|            next.operation = pending[snapshot.id] ?? .idle\n120|            // Reflect the operation in the local status so the row shows\n121|            // starting/stopping instead of jumping ahead to running/stopped.\n122|            if next.operation == .starting, next.status == .stopped || next.status == .failed {\n123|                next.status = .starting\n124|            } else if next.operation == .stopping, next.status == .running {\n125|                next.status = .stopping\n126|            }\n127|            return next\n128|        }\n129|    }\n130|\n131|    private func setEnabled(id: String, enabled: Bool) async {\n132|        guard !working.contains(id), !unregisterWorking.contains(id) else { return }\n133|        working.insert(id)\n134|        revision += 1\n135|        pendingOp[id] = enabled ? .starting : .stopping\n136|        await action { Runners.Action.changing(id, true) }\n137|        do { try await service.setEnabled(enabled, id: id) }\n138|        catch { await action { Runners.Action.failed(error.localizedDescription) } }\n139|        pendingOp.removeValue(forKey: id)\n140|        let snapshots = await service.snapshots()\n141|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n142|        await action { Runners.Action.refreshed(mapped_snapshots) }\n143|        working.remove(id)\n144|        await action { Runners.Action.changing(id, false) }\n145|    }\n146|\n147|    /// Bulk power with per-row errors. Every row is attempted; failures are\n148|    /// reported per row in the refreshed snapshots plus one summary failure.\n149|    /// A single-row error never blocks the rest of the list.\n150|    private func setEnabledMany(ids: [String], enabled: Bool) async {\n151|        let targets = ids.filter { !working.contains($0) && !unregisterWorking.contains($0) }\n152|        guard !targets.isEmpty else { return }\n153|        for id in targets {\n154|            working.insert(id)\n155|            pendingOp[id] = enabled ? .starting : .stopping\n156|            await action { Runners.Action.changing(id, true) }\n157|        }\n158|        revision += 1\n159|        var failures: [(String, String)] = []\n160|        for id in targets {\n161|            do { try await service.setEnabled(enabled, id: id) }\n162|            catch { failures.append((id, error.localizedDescription)) }\n163|        }\n164|        for id in targets { pendingOp.removeValue(forKey: id) }\n165|        var snapshots = await service.snapshots()\n166|        if !failures.isEmpty {\n167|            let table = Dictionary(uniqueKeysWithValues: failures)\n168|            snapshots = snapshots.map { snapshot in\n169|                var next = snapshot\n170|                if let message = table[snapshot.id] {\n171|                    next.message = message\n172|                }\n173|                return next\n174|            }\n175|            let summary = failures.map { id, message in \"\\(id): \\(message)\" }.joined(separator: \"; \")\n176|            let failureCount = failures.count\n177|            let targetCount = targets.count\n178|            let bulkMessage = \"Partial failure (\\(failureCount) of \\(targetCount)): \\(summary)\"\n179|            await action { Runners.Action.failed(bulkMessage) }\n180|        }\n181|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n182|        await action { Runners.Action.refreshed(mapped_snapshots) }\n183|        for id in targets {\n184|            working.remove(id)\n185|            await action { Runners.Action.changing(id, false) }\n186|        }\n187|    }\n188|\n189|    // MARK: - Catalog\n190|\n191|    /// One-time migration plus refresh. Never starts or stops CI and never\n192|    /// modifies services; discovery only reads.\n193|    private func loadCatalog() async {\n194|        do {\n195|            _ = try await catalog.migrateIfNeeded()\n196|            await action { Runners.Action.catalogCleared }\n197|        } catch {\n198|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n199|        }\n200|        let snapshots = await service.snapshots()\n201|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n202|        await action { Runners.Action.refreshed(mapped_snapshots) }\n203|    }\n204|\n205|    private func discover() async {\n206|        let entries = await catalog.load()\n207|        let known = Set(entries.map(\\.canonicalPath))\n208|        let extra = entries.map { RunnerCatalogStore.resolve(entry: $0) }\n209|        let candidates = RunnerDiscovery.discoverCandidates(knownCanonicals: known, extraDirectories: extra)\n210|            .filter { candidate in\n211|                let canonical = RunnerCatalogStore.canonical(candidate.directory)\n212|                return !known.contains(canonical)\n213|            }\n214|        await action { Runners.Action.candidatesLoaded(candidates) }\n215|    }\n216|\n217|    private func importCandidate(_ candidate: RunnerDiscovery.Candidate) async {\n218|        let gen = catalogGeneration\n219|        // Refuse mutations for an entry already under unregister.\n220|        if let label = candidate.label, unregisterWorking.contains(label) {\n221|            await action { Runners.Action.catalogFailed(RunnerRegistration.RegistrationError.installerBusy(path: candidate.directory.path).localizedDescription) }\n222|            return\n223|        }\n224|        do {\n225|            try RunnersCatalogGates.validateImportable(candidate)\n226|            let canonical = RunnerCatalogStore.canonical(candidate.directory)\n227|            let entries = await catalog.load()\n228|            if entries.contains(where: { $0.canonicalPath == canonical }) {\n229|                throw RunnerCatalogStore.CatalogError.duplicateDirectory(path: candidate.directory.path)\n230|            }\n231|            guard !isCatalogStale(gen) else { return }\n232|            let label: String\n233|            let plist: URL\n234|            let kind = candidate.controllerKind\n235|            if let manifest = candidate.manifest, let existing = candidate.label {\n236|                // Import without changing the existing service: never\n237|                // re-registers and never flips the preserved RunAtLoad policy.\n238|                // A manifest label already owned by another entry refuses:\n239|                // two entries must never share one control identity.\n240|                if entries.contains(where: { $0.serviceLabel == existing }) {\n241|                    throw RunnerCatalogStore.CatalogError.duplicateLabel(label: existing)\n242|                }\n243|                label = existing\n244|                plist = manifest\n245|            } else {\n246|                // No manifest: create a manual service (RunAtLoad off for new\n247|                // runners). Never bootstraps; enabling is a separate action.\n248|                // The label binds agent name plus canonical path, so two\n249|                // same-name folders never share one control identity.\n250|                label = RunnerCatalogStore.importedServiceLabel(\n251|                    agentName: candidate.agentName, directory: candidate.directory\n252|                )\n253|                if entries.contains(where: { $0.serviceLabel == label }) {\n254|                    throw RunnerCatalogStore.CatalogError.duplicateLabel(label: label)\n255|                }\n256|                plist = try await installer.setupService(directory: candidate.directory, label: label)\n257|            }\n258|            guard !isCatalogStale(gen) else { return }\n259|            let info = RunnerRegistrationReader.read(directory: candidate.directory)\n260|            let entry = RunnerCatalogStore.Entry(\n261|                directoryPath: candidate.directory.path,\n262|                canonicalPath: canonical,\n263|                bookmarkBase64: RunnerCatalogStore.bookmark(for: candidate.directory),\n264|                serviceLabel: label,\n265|                servicePlistPath: plist.path,\n266|                controllerKind: kind,\n267|                runAtLoad: candidate.runAtLoad,\n268|                serverHost: info?.serverHost ?? candidate.serverHost,\n269|                scopeKind: info?.scopeKind,\n270|                scope: info?.scopeDetail ?? candidate.scope,\n271|                remoteAgentID: info?.agentID ?? candidate.agentID,\n272|                agentName: info?.agentName ?? candidate.agentName,\n273|                workFolder: info?.workFolder ?? candidate.workFolder\n274|            )\n275|            try await catalog.add(entry)\n276|            await action { Runners.Action.catalogCleared }\n277|            let snapshots = await service.snapshots()\n278|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n279|            await action { Runners.Action.refreshed(mapped_snapshots) }\n280|            await discover()\n281|        } catch {\n282|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n283|        }\n284|    }\n285|\n286|    private func importFolder(_ url: URL) async {\n287|        var isDir: ObjCBool = false\n288|        guard FileManager.default.fileExists(atPath: url.path, isDirectory: &isDir), isDir.boolValue else {\n289|            await action { Runners.Action.catalogFailed(\"Selected folder does not exist.\") }\n290|            return\n291|        }\n292|        let candidate = RunnerDiscovery.validateFolder(url)\n293|        if candidate.needsRelocation {\n294|            await action { Runners.Action.catalogFailed(\"Path contains a space; choose a location without spaces. Running runners are never moved automatically.\") }\n295|            return\n296|        }\n297|        await importCandidate(candidate)\n298|    }\n299|\n300|    /// Removes only the catalog record. Deletes no files, no GitHub\n301|    /// registration and no certificates, and never stops a running service.\n302|    /// Warns when the service keeps running.\n303|    private func removeFromApp(id: String) async {\n304|        if unregisterWorking.contains(id) {\n305|            await action { Runners.Action.catalogFailed(\"Runner is unregistering; retry after it settles.\") }\n306|            return\n307|        }\n308|        let entries = await catalog.load()\n309|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n310|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n311|            return\n312|        }\n313|        catalogGeneration += 1\n314|        let snapshots = await service.snapshots()\n315|        let wasRunning = snapshots.first(where: { $0.id == entry.serviceLabel })?.status == .running\n316|        do {\n317|            _ = try await catalog.remove(localID: entry.localID)\n318|        } catch {\n319|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n320|            return\n321|        }\n322|        let refreshed = await service.snapshots()\n323|        let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n324|        await action { Runners.Action.refreshed(mapped_refreshed) }\n325|        if wasRunning {\n326|            await action { Runners.Action.catalogFailed(\"Removed «\\(entry.agentName ?? entry.serviceLabel)» from the app. Its service keeps running.\") }\n327|        } else {\n328|            await action { Runners.Action.catalogCleared }\n329|        }\n330|        await discover()\n331|    }\n332|\n333|    // MARK: - Unregister (explicit remote removal)\n334|\n335|    /// Explicit remote unregister, distinct from catalog removal and file\n336|    /// deletion. Binds the local verified `.runner` server/scope/agentId and\n337|    /// the service path, never a remote name alone. Stopped-only: requires a\n338|    /// positive confirmed `.stopped` observation (unknown or missing state\n339|    /// refuses) both before minting the remove token and at the `config.sh\n340|    /// remove` boundary, plus a typed confirmation matching the agent name.\n341|    /// Holds the shared installer lease across `config.sh remove` so no\n342|    /// registration, install, recovery or second unregister can overlap.\n343|    /// Files and the service manifest stay for re-registration.\n344|    private func unregister(id: String, confirmation: String) async {\n345|        guard !unregisterWorking.contains(id), !working.contains(id) else { return }\n346|        unregisterWorking.insert(id)\n347|        await action { Runners.Action.unregistering(id, true) }\n348|        let gen = catalogGeneration\n349|        do {\n350|            let entries = await catalog.load()\n351|            guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n352|                throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n353|            }\n354|            let directory = RunnerCatalogStore.resolve(entry: entry)\n355|            // Mutation authority: local verified identity plus the service\n356|            // path. A remote name match alone never authorizes removal.\n357|            guard let local = await installer.readLocalRegistration(directory: directory),\n358|                  let agentID = local.agentID,\n359|                  let agentName = local.agentName, !agentName.isEmpty,\n360|                  let address = local.gitHubURL,\n361|                  let scope = unregisterScope(address: address) else {\n362|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n363|                    \"No verified local registration for '\\(entry.serviceLabel)'. Refusing to unregister another runner by name.\"\n364|                )\n365|            }\n366|            // Service-path binding: the catalog entry must still point at the\n367|            // verified directory; a relink mid-flight invalidates the evidence.\n368|            let canonical = RunnerCatalogStore.canonical(directory)\n369|            guard canonical == entry.canonicalPath else {\n370|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n371|                    \"Service path changed during unregister. Re-verify instead of removing another directory's registration.\"\n372|                )\n373|            }\n374|            // Agent-ID binding: a stored ID that disagrees with disk fails\n375|            // closed instead of removing a foreign registration.\n376|            if let stored = entry.remoteAgentID, stored != agentID {\n377|                throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n378|                    \"Catalog expects agent \\(stored) but disk shows agent \\(agentID) for '\\(agentName)'. Refusing to unregister a mismatched registration.\"\n379|                )\n380|            }\n381|            guard confirmation == agentName else {\n382|                throw RunnerRegistration.RegistrationError.confirmationMismatch(\n383|                    \"Type '\\(agentName)' to confirm unregister of agent \\(agentID) in \\(scope.detail).\"\n384|                )\n385|            }\n386|            guard !isCatalogStale(gen) else { return }\n387|            // Stopped-only gate: a positive confirmed `.stopped` observation\n388|            // is required before minting the remove token, so unregister\n389|            // cannot interrupt a job — or a service whose state is unknown.\n390|            try await requireConfirmedStopped(entry: entry)\n391|            guard !isCatalogStale(gen) else { return }\n392|            let auth = try await currentUserToken()\n393|            guard !isCatalogStale(gen) else { return }\n394|            // Server binding: the verified host must equal the authenticated\n395|            // server; a same-path foreign host never authorizes removal here.\n396|            let verifiedHost = URL(string: address)?.host ?? \"\"\n397|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n398|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n399|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n400|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost). Refusing cross-server unregister.\"\n401|                )\n402|            }\n403|            let created = try await api.createRemoveToken(config: auth.config, token: auth.token, scope: scope)\n404|            guard !isCatalogStale(gen) else { return }\n405|            // Re-verify after the network: scope/path edits invalidate stale\n406|            // evidence instead of removing a re-targeted registration.\n407|            guard let reread = await installer.readLocalRegistration(directory: directory),\n408|                  reread.agentID == agentID, reread.agentName == agentName,\n409|                  reread.gitHubURL == address else {\n410|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n411|                    \"Local registration changed during unregister. Re-verify instead of removing a re-targeted registration.\"\n412|                )\n413|            }\n414|            let currentEntries = await catalog.load()\n415|            guard currentEntries.contains(where: { $0.localID == entry.localID && $0.canonicalPath == canonical }) else {\n416|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n417|                    \"Catalog entry changed during unregister. Re-verify instead of removing another entry.\"\n418|                )\n419|            }\n420|            // Revalidate the stopped evidence at the side-effect boundary: a\n421|            // service started (or lost to inspection) after the token mint\n422|            // must not be unregistered.\n423|            guard !isCatalogStale(gen) else { return }\n424|            try await requireConfirmedStopped(entry: entry)\n425|            try await installer.unregister(directory: directory, removeToken: created.token)\n426|            guard !isCatalogStale(gen) else { return }\n427|            // Remote registration is gone; the catalog entry stays so the\n428|            // user can re-register or remove it from the app. Files stay.\n429|            var updated = entry\n430|            updated.remoteAgentID = nil\n431|            updated.lastSeenAt = now()\n432|            try await catalog.update(updated)\n433|            await action { Runners.Action.catalogCleared }\n434|            let refreshed = await service.snapshots()\n435|            let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n436|            await action { Runners.Action.refreshed(mapped_refreshed) }\n437|        } catch {\n438|            if !isCatalogStale(gen) {\n439|                await action { Runners.Action.catalogFailed(error.localizedDescription) }\n440|            }\n441|        }\n442|        unregisterWorking.remove(id)\n443|        await action { Runners.Action.unregistering(id, false) }\n444|    }\n445|\n446|    /// Stopped-only gate for unregister. Only a positive confirmed `.stopped`\n447|    /// observation authorizes removal. `.running` refuses with a stop-first\n448|    /// message; a missing observation and every other state (unknown, failed,\n449|    /// missing, transitional, ...) refuse as unconfirmed instead of being\n450|    /// treated as stopped. A launchctl permission error (`.unknown`) therefore\n451|    /// never authorizes `config.sh remove` on a possibly live runner.\n452|    private func requireConfirmedStopped(entry: RunnerCatalogStore.Entry) async throws {\n453|        let snapshots = await service.snapshots()\n454|        guard let observation = snapshots.first(where: { $0.id == entry.serviceLabel }) else {\n455|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n456|                \"Cannot confirm the service '\\(entry.serviceLabel)' is stopped (no observation). Refusing to unregister while the service state is unconfirmed.\"\n457|            )\n458|        }\n459|        switch observation.status {\n460|        case .stopped:\n461|            return\n462|        case .running:\n463|            throw RunnerRegistration.RegistrationError.invalidDraft(\n464|                \"Stop the runner first; unregister refuses to interrupt a running service.\"\n465|            )\n466|        default:\n467|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n468|                \"Cannot confirm the service '\\(entry.serviceLabel)' is stopped (observed: \\(observation.status.rawValue)). Refusing to unregister while the service state is unconfirmed.\"\n469|            )\n470|        }\n471|    }\n472|\n473|    private func unregisterScope(address: String) -> RunnerRegistration.Scope? {\n474|        guard let url = URL(string: address), url.scheme == \"https\" else { return nil }\n475|        let components = url.pathComponents.filter { $0 != \"/\" }\n476|        if components.count == 1 { return .organization(org: components[0]) }\n477|        if components.count == 2 { return .repository(owner: components[0], name: components[1]) }\n478|        return nil\n479|    }\n480|\n481|    private struct CatalogUserToken: Sendable {\n482|        let config: GitHubAuth.AppConfig\n483|        let token: String\n484|        let identity: GitHubSessionIdentity\n485|    }\n486|\n487|    private func currentUserToken() async throws -> CatalogUserToken {\n488|        guard let identity = await identities.load() else {\n489|            throw RunnerRegistration.RegistrationError.notAuthenticated\n490|        }\n491|        let config = try configProvider(identity.serverHost)\n492|        guard var record = await userStore.load(serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID) else {\n493|            throw RunnerRegistration.RegistrationError.notAuthenticated\n494|        }\n495|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n496|            do {\n497|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n498|            } catch is CancellationError {\n499|                throw CancellationError()\n500|            } catch let error as GitHubAuth.AuthError {\n501|                switch error {\n502|                case .revoked, .unauthorized, .tokenRefreshFailed:\n503|                    throw RunnerRegistration.RegistrationError.unauthorized\n504|                default: break\n505|                }\n506|            }\n507|        }\n508|        return CatalogUserToken(config: config, token: record.accessToken, identity: identity)\n509|    }\n510|\n511|    // MARK: - Remote observation\n512|\n513|    /// Best-effort GitHub sync. Offline, 401/403 and rate limits mark data\n514|    /// stale and never change local power state. Follows full pagination\n515|    /// before matching; matches by server + scope + ID, never by name.\n516|    private func refreshRemote() async {\n517|        let startedIdentity = await identities.load()\n518|        let entries = await catalog.load()\n519|        if entries.isEmpty {\n520|            await action { Runners.Action.remoteSyncFinished(self.now()) }\n521|            return\n522|        }\n523|        let auth: CatalogUserToken\n524|        do {\n525|            auth = try await currentUserToken()\n526|        } catch {\n527|            // Disconnected: local control stays fully available.\n528|            await action { Runners.Action.remoteSyncFailed(error.localizedDescription) }\n529|            return\n530|        }\n531|        // Group definitions by scope so one paginated list serves every\n532|        // runner in that scope.\n533|        var scopes: [String: (scope: RunnerRegistration.Scope, ids: [String])] = [:]\n534|        var definitions: [String: Runners.Definition] = [:]\n535|        for entry in entries {\n536|            let directory = RunnerCatalogStore.resolve(entry: entry)\n537|            let info = RunnerRegistrationReader.read(directory: directory)\n538|            guard let address = info?.gitHubURL ?? entry.serverHost.map({ \"https://\\($0)/\\(entry.scope ?? \"\")\" }),\n539|                  let scope = unregisterScope(address: address) else { continue }\n540|            // Observe only registrations on the authenticated server.\n541|            let host = URL(string: address)?.host ?? entry.serverHost ?? \"\"\n542|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(host)\n543|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else { continue }\n544|            let key = scope.scopeKey\n545|            scopes[key, default: (scope, [])].ids.append(entry.serviceLabel)\n546|            definitions[entry.serviceLabel] = LaunchAgentService.definition(from: entry)\n547|        }\n548|        var failures: [String] = []\n549|        for (_, group) in scopes {\n550|            // A logout mid-sync stops silently: no writes into a logged-out session.\n551|            let current = await identities.load()\n552|            if current == nil || current?.userID != startedIdentity?.userID\n553|                || current?.serverHost != startedIdentity?.serverHost {\n554|                return\n555|            }\n556|            do {\n557|                let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: group.scope)\n558|                for id in group.ids {\n559|                    guard let definition = definitions[id] else { continue }\n560|                    if let observation = GitHubRunnerObserver.match(definition: definition, runners: runners, now: now()) {\n561|                        await action { Runners.Action.remoteUpdated(id, GitHubRunnerObserver.withFreshness(observation, now: self.now())) }\n562|                    } else {\n563|                        await action { Runners.Action.remoteUpdated(id, Runners.RemoteObservation(\n564|                            busyKnown: false, updatedAt: self.now(), stale: false,\n565|                            syncError: \"Identity mismatch\"\n566|                        )) }\n567|                    }\n568|                }\n569|            } catch let error as RunnerRegistration.RegistrationError {\n570|                switch error {\n571|                case .unauthorized:\n572|                    await action { Runners.Action.remoteSyncFailed(RunnerRegistration.RegistrationError.unauthorized.localizedDescription) }\n573|                    return\n574|                case .rateLimited:\n575|                    failures.append(\"Rate limited; will retry.\")\n576|                case .missingPermission(let text):\n577|                    failures.append(text)\n578|                default:\n579|                    failures.append(error.localizedDescription)\n580|                }\n581|            } catch {\n582|                failures.append(error.localizedDescription)\n583|            }\n584|        }\n585|        if failures.isEmpty {\n586|            await action { Runners.Action.remoteSyncFinished(self.now()) }\n587|        } else {\n588|            let joinedFailures = failures.joined(separator: \"; \")\n589|            await action { Runners.Action.remoteSyncFailed(joinedFailures) }\n590|        }\n591|    }\n592|\n593|    // MARK: - Preferences and relink\n594|\n595|    /// Changes only the login-startup policy. Never bootstraps or bootouts;\n596|    /// the policy applies at next login. Refuses while an installer mutation\n597|    /// is live.\n598|    /// Changes only the login-start behavior. Standard manifests edit\n599|    /// their own RunAtLoad. External manual plists gain or lose a matching\n600|    /// registration in `~/Library/LaunchAgents` (RunAtLoad outside\n601|    /// LaunchAgents never persists login start). Never bootstraps or\n602|    /// bootouts: live runner state is preserved. Refuses while an installer\n603|    /// mutation is live, and never touches a foreign same-label plist.\n604|    private func setRunAtLoad(id: String, value: Bool) async {\n605|        if unregisterWorking.contains(id) || working.contains(id) {\n606|            await action { Runners.Action.catalogFailed(\"Runner is busy; retry after it settles.\") }\n607|            return\n608|        }\n609|        let entries = await catalog.load()\n610|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n611|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n612|            return\n613|        }\n614|        if entry.controllerKind == .unsupported {\n615|            await action { Runners.Action.catalogFailed(\"Unsupported runners have no Runner Control login policy.\") }\n616|            return\n617|        }\n618|        do {\n619|            let directory = RunnerCatalogStore.resolve(entry: entry)\n620|            try await installer.requireIdle(for: directory)\n621|            if entry.controllerKind == .standardLaunchAgent {\n622|                let plist = URL(fileURLWithPath: entry.servicePlistPath)\n623|                guard let data = try? Data(contentsOf: plist),\n624|                      var object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {\n625|                    throw RunnerError.message(\"Service manifest is unreadable.\")\n626|                }\n627|                object[\"RunAtLoad\"] = value\n628|                let out = try PropertyListSerialization.data(fromPropertyList: object, format: .xml, options: 0)\n629|                try out.write(to: plist, options: .atomic)\n630|                entry.runAtLoad = value\n631|                try await catalog.update(entry)\n632|            } else {\n633|                try setManualLogin(entry: entry, directory: directory, enabled: value)\n634|            }\n635|            await action { Runners.Action.catalogCleared }\n636|            let snapshots = await service.snapshots()\n637|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n638|            await action { Runners.Action.refreshed(mapped_snapshots) }\n639|        } catch {\n640|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n641|        }\n642|    }\n643|\n644|    /// Enables or disables login start for an external manual service by\n645|    /// managing its `~/Library/LaunchAgents` registration. The external\n646|    /// service file itself is never modified, so the imported policy stays\n647|    /// byte-identical; live launchd state is untouched.\n648|    private func setManualLogin(entry: RunnerCatalogStore.Entry, directory: URL, enabled: Bool) throws {\n649|        let external = URL(fileURLWithPath: entry.servicePlistPath)\n650|        guard let data = try? Data(contentsOf: external),\n651|              let object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {\n652|            throw RunnerError.message(\"Service manifest is unreadable.\")\n653|        }\n654|        let definition = LaunchAgentService.definition(from: entry)\n655|        let copy = RunnerControllers.loginRegistrationURL(label: entry.serviceLabel, home: home)\n656|        if enabled {\n657|            if let existing = try? Data(contentsOf: copy),\n658|               let current = try? PropertyListSerialization.propertyList(from: existing, format: nil) as? [String: Any] {\n659|                guard RunnerControllers.references(current, definition: definition) else {\n660|                    throw RunnerError.message(\"Login slot '\\(copy.lastPathComponent)' belongs to another service. Remove it by hand instead of overwriting.\")\n661|                }\n662|                var updated = current\n663|                updated[\"RunAtLoad\"] = true\n664|                let out = try PropertyListSerialization.data(fromPropertyList: updated, format: .xml, options: 0)\n665|                try out.write(to: copy, options: .atomic)\n666|                return\n667|            }\n668|            var registration = object\n669|            registration[\"Label\"] = entry.serviceLabel\n670|            registration[\"WorkingDirectory\"] = directory.path\n671|            registration[\"ProgramArguments\"] = [directory.appendingPathComponent(\"runsvc.sh\").path]\n672|            registration[\"RunAtLoad\"] = true\n673|            let out = try PropertyListSerialization.data(fromPropertyList: registration, format: .xml, options: 0)\n674|            try FileManager.default.createDirectory(at: copy.deletingLastPathComponent(), withIntermediateDirectories: true)\n675|            try out.write(to: copy, options: .atomic)\n676|            return\n677|        }\n678|        guard FileManager.default.fileExists(atPath: copy.path) else { return }\n679|        guard let existing = try? Data(contentsOf: copy),\n680|              let current = try? PropertyListSerialization.propertyList(from: existing, format: nil) as? [String: Any],\n681|              RunnerControllers.references(current, definition: definition) else {\n682|            throw RunnerError.message(\"Login slot '\\(copy.lastPathComponent)' belongs to another service. Remove it by hand instead of deleting.\")\n683|        }\n684|        try FileManager.default.removeItem(at: copy)\n685|    }\n686|\n687|    private func setAlias(id: String, alias: String?) async {\n688|        let entries = await catalog.load()\n689|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n690|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n691|            return\n692|        }\n693|        let trimmed = alias?.trimmingCharacters(in: .whitespacesAndNewlines)\n694|        entry.displayName = (trimmed?.isEmpty == true) ? nil : trimmed\n695|        do {\n696|            try await catalog.update(entry)\n697|            await action { Runners.Action.catalogCleared }\n698|            let snapshots = await service.snapshots()\n699|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n700|            await action { Runners.Action.refreshed(mapped_snapshots) }\n(more lines below)","final_result":true}}}
