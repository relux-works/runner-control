ners.Effect.unregister(\"actions.runner.test.unreg\", confirmation: \"wrong\"))\n662|    #expect(catalogErr(harness.logger).contains(\"Type 'my-runner'\"))\n663|    #expect(await harness.transport.requests.isEmpty)\n664|    #expect(await harness.installerExecutor.calls.isEmpty)\n665|}\n666|\n667|@Test func unregisterRefusesRunningService() async throws {\n668|    let harness = await catalogHarness(launchResults: [\n669|        CommandResult(code: 0, output: \"state = running\")\n670|    ])\n671|    defer { try? FileManager.default.removeItem(at: harness.home) }\n672|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", label: \"actions.runner.test.running\")\n673|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.running\"))\n674|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.unregister(\"actions.runner.test.running\", confirmation: \"r\"))\n675|    #expect(catalogErr(harness.logger).contains(\"Stop the runner first\"))\n676|    #expect(await harness.transport.requests.isEmpty)\n677|}\n678|\n679|@Test func unregisterRefusesNameWithoutVerifiedAgentID() async throws {\n680|    let harness = await catalogHarness()\n681|    defer { try? FileManager.default.removeItem(at: harness.home) }\n682|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", label: \"actions.runner.test.noname\")\n683|    // Strip the agent ID: a bare name must never authorize removal.\n684|    let config: [String: Any] = [\"agentName\": \"r\", \"gitHubUrl\": \"https://github.com/acme\", \"workFolder\": \"_work\"]\n685|    try JSONSerialization.data(withJSONObject: config).write(to: dir.appendingPathComponent(\".runner\"))\n686|    var entry = unregisterEntry(dir: dir, label: \"actions.runner.test.noname\")\n687|    entry.remoteAgentID = nil\n688|    try await harness.catalog.add(entry)\n689|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.unregister(\"actions.runner.test.noname\", confirmation: \"r\"))\n690|    #expect(catalogErr(harness.logger).contains(\"verified local registration\"))\n691|    #expect(await harness.transport.requests.isEmpty)\n692|}\n693|\n694|@Test func unregisterRefusesStoredIDMismatchAndCrossServer() async throws {\n695|    // Stored-vs-disk mismatch.\n696|    let mismatch = await catalogHarness()\n697|    defer { try? FileManager.default.removeItem(at: mismatch.home) }\n698|    let mismatchDir = try makeRunnerDir(parent: mismatch.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.mismatch\")\n699|    var entry = unregisterEntry(dir: mismatchDir, label: \"actions.runner.test.mismatch\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
