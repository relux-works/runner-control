nfig = GitHubAuth.AppConfig(clientID: \"test-client-id\")\n28|\n29|// MARK: - Config\n30|\n31|@Test func configReportsExactMissingBinding() {\n32|    let bundle = Bundle.main\n33|    // Production bundle has no GitHubAppClientID until coordinator provisions it.\n34|    // Assert the thrown binding names the exact scaffold input.\n35|    let raw = bundle.object(forInfoDictionaryKey: \"GitHubAppClientID\") as? String\n36|    if let raw, !raw.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {\n37|        // Provisioned environment: config must load.\n38|        #expect((try? GitHubAuth.AppConfig.current(bundle: bundle)) != nil)\n39|    } else {\n40|        do {\n(more lines below)","final_result":true}}}
