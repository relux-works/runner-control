      AppRegistry.start()\n27|        NotificationCenter.default.addObserver(\n28|            forName: .openManagementWindow,\n29|            object: nil,\n30|            queue: .main\n31|        ) { [weak self] _ in\n32|            Task { @MainActor in self?.showControls() }\n33|        }\n34|        if !UserDefaults.standard.bool(forKey: \"hasShownWelcome\") {\n35|            showControls()\n36|            UserDefaults.standard.set(true, forKey: \"hasShownWelcome\")\n37|        }\n38|    }\n39|    func applicationShouldHandleReopen(_ sender: NSApplication, hasVisibleWindows flag: Bool) -> Bool {\n40|        showControls()\n41|        return true\n42|    }\n43|    private func showControls() {\n44|        if window == nil {\n45|            let controller = NSHostingController(rootView: ManagementWindowContainer(\n46|                runners: AppRegistry.state,\n47|                github: AppRegistry.githubState,\n48|                registration: AppRegistry.registrationState\n49|            ))\n50|            let value = NSWindow(contentViewController: controller)\n51|            value.title = \"Раннеры и настройки\"\n52|            value.styleMask = [.titled, .closable, .miniaturizable, .resizable]\n53|            value.isReleasedWhenClosed = false\n54|            value.setContentSize(NSSize(width: 760, height: 540))\n55|            value.minSize = NSSize(width: 700, height: 480)\n56|            value.center()\n57|            window = value\n58|        }\n59|        window?.makeKeyAndOrderFront(nil)\n60|        NSApp.activate(ignoringOtherApps: true)\n61|    }\n62|}","final_result":true}}}
