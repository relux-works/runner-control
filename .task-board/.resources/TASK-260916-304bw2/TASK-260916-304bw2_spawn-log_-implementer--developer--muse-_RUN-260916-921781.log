outClearsBoth() async throws {\n382|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n383|    let identities = InMemoryGitHubSessionIdentityStore(value: GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n384|    try await store.save(\n385|        GitHubAuth.TokenRecord(accessToken: \"ghu_saved\", refreshToken: \"ghr_saved\", expiresAt: Date().addingTimeInterval(3600)),\n386|        serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n(more lines below)","final_result":true}}}
