.sessionIdentity.v1\"\n33|    ) {\n34|        self.defaults = defaults\n35|        self.key = key\n36|    }\n37|\n38|    public func save(_ identity: GitHubSessionIdentity) async {\n39|        if let data = try? JSONEncoder().encode(identity) {\n40|            defaults.set(data, forKey: key)\n41|        }\n42|    }\n43|\n44|    public func load() async -> GitHubSessionIdentity? {\n45|        guard let data = defaults.data(forKey: key) else { return nil }\n46|        return try? JSONDecoder().decode(GitHubSessionIdentity.self, from: data)\n47|    }\n48|\n49|    public func delete() async {\n50|        defaults.removeObject(forKey: key)\n51|    }\n52|}\n53|\n54|/// In-memory store for unit tests. Never used in production.\n55|public final class InMemoryGitHubSessionIdentityStore: GitHubSessionIdentityStoring, @unchecked Sendable {\n56|    private let lock = NSLock()\n57|    private var value: GitHubSessionIdentity?\n58|    public init(value: GitHubSessionIdentity? = nil) { self.value = value }\n59|    public func save(_ identity: GitHubSessionIdentity) async {\n60|        lock.withLock { value = identity }\n61|    }\n62|    public func load() async -> GitHubSessionIdentity? {\n63|        lock.withLock { value }\n64|    }\n65|    public func delete() async {\n66|        lock.withLock { value = nil }\n67|    }\n68|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
