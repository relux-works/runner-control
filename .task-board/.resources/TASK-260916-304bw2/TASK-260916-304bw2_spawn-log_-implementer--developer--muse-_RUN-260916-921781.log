{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9ff","stream":{"kind":"session","id":"01a0a9c5-2eb3-7902-83b0-77aeb115d140"},"sequence":858,"recorded_at":1780531400001711,"record_type":"event","durability":"durable","causation_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","run_stream":{"kind":"run","id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246"},"call_id":"call_01a0a9cad61372e8b6cbd4afb7b5b6cf","text":"Read text file `/Users/iv/Documents/Codex/2026-09-15/new-chat-4/outputs/RunnerControl/.temp/STORY-260916-36d1jg/worktree/Packages/RunnerControlCore/Tests/GitHubAuthFlowTests.swift`.\n(359 line(s) above)\n360|    await state.reduce(with: GitHubAuth.Action.restoreStarted(serverHost: \"ghe.example.com\"))\n361|    guard case .verifyingAccount = state.connection else {\n362|        Issue.record(\"Expected verifyingAccount, got \\(state.connection)\"); return\n363|    }\n364|    #expect(state.serverHost == \"ghe.example.com\")\n365|}\n366|\n367|@Test func flowLoginPersistsSessionIdentityForLaterRestore() async throws {\n368|    let identities = InMemoryGitHubSessionIdentityStore()\n369|    let transport = TestTransport([\n370|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n371|        jsonResponse([\"access_token\": \"ghu_x\", \"refresh_token\": \"ghr_y\", \"expires_in\": 3600]),\n372|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n373|        jsonResponse([\"installations\": []]),\n374|    ])\n375|    let (flow, logger, _) = await githubHarness(transport: transport, identityStore: identities)\n376|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n377|    #expect(await waitForLoggedActions(logger, count: 6))\n378|    #expect(await identities.load() == GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n379|}\n380|\n381|@Test func flowRestoreSessionConnectsFromPersistedIdentityThenLogoutClearsBoth() async throws {\n382|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n383|    let identities = InMemoryGitHubSessionIdentityStore(value: GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n384|    try await store.save(\n385|        GitHubAuth.TokenRecord(accessToken: \"ghu_saved\", refreshToken: \"ghr_saved\", expiresAt: Date().addingTimeInterval(3600)),\n386|        serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n387|    )\n388|    let transport = TestTransport([\n389|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n390|        jsonResponse([\"installations\": [[\"id\": 7, \"account\": [\"login\": \"acme\", \"type\": \"Organization\"]]]]),\n391|        jsonResponse([\"repositories\": [[\"id\": 9, \"full_name\": \"acme/app\", \"private\": false]]]),\n392|    ])\n393|    let (flow, logger, credentialStore) = await githubHarness(transport: transport, store: store, identityStore: identities)\n394|    _ = await flow.apply(GitHubAuth.Effect.restoreSession)\n395|    #expect(await waitForLoggedActions(logger, count: 5))\n396|    let actions = githubActions(logger)\n397|    guard case .restoreStarted = actions.first else {\n398|        Issue.record(\"Expected restoreStarted first, got \\(actions)\"); return\n399|    }\n400|    #expect(actions.contains { if case .connected(let user, _, _) = $0, user == \"octo\" { true } else { false } })\n401|    // Session is live: a sync now reaches the network instead of no-op.\n402|    await transport.append(jsonResponse([\"installations\": []]))\n403|    _ = await flow.apply(GitHubAuth.Effect.refreshInstallations)\n404|    #expect(await waitForLoggedActions(logger, count: 7))\n405|    // Logout after restore deletes both Keychain tokens and identity.\n406|    _ = await flow.apply(GitHubAuth.Effect.logout)\n407|    #expect(await waitForLoggedActions(logger, count: 8))\n408|    #expect(await credentialStore.load(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID) == nil)\n409|    #expect(await identities.load() == nil)\n410|}\n411|\n412|@Test func flowRestoreSessionWithRevokedTokenRequiresReloginAndClearsStorage() async throws {\n413|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n414|    let identities = InMemoryGitHubSessionIdentityStore(value: GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n415|    try await store.save(\n416|        GitHubAuth.TokenRecord(accessToken: \"ghu_revoked\", refreshToken: nil, expiresAt: nil),\n417|        serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n418|    )\n419|    let transport = TestTransport([GitHubHTTPResponse(status: 401, body: Data())])\n420|    let (flow, logger, credentialStore) = await githubHarness(transport: transport, store: store, identityStore: identities)\n421|    _ = await flow.apply(GitHubAuth.Effect.restoreSession)\n422|    #expect(await waitForLoggedActions(logger, count: 2))\n423|    guard case .failed(_, let retry) = githubActions(logger).last, retry == .relogin else {\n424|        Issue.record(\"Expected 401 relogin, got \\(githubActions(logger))\"); return\n425|    }\n426|    #expect(await credentialStore.load(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID) == nil)\n427|    #expect(await identities.load() == nil)\n428|}\n429|\n430|@Test func flowRestoreSessionWithoutIdentityIsNoop() async throws {\n431|    let (flow, logger, _) = await githubHarness(transport: TestTransport([]))\n432|    _ = await flow.apply(GitHubAuth.Effect.restoreSession)\n433|    try await Task.sleep(for: .milliseconds(100))\n434|    #expect(logger.actions.isEmpty)\n435|}\n436|\n437|// MARK: - Refresh through the production Flow path\n438|\n439|private func loginQueue(accessToken: String = \"ghu_old\", refreshToken: String = \"ghr_old\") -> [GitHubHTTPResponse] {\n440|    [\n441|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n442|        jsonResponse([\"access_token\": accessToken, \"refresh_token\": refreshToken, \"expires_in\": 3600]),\n443|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n444|        jsonResponse([\"installations\": []]),\n445|    ]\n446|}\n447|\n448|@Test func flowRefreshInstallationsRefreshesExpiringTokenViaProductionPath() async throws {\n449|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n450|    let transport = TestTransport(loginQueue())\n451|    let (flow, logger, credentialStore) = await githubHarness(transport: transport, store: store)\n452|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n453|    #expect(await waitForLoggedActions(logger, count: 6))\n454|    // Age the stored token into the 60s refresh window.\n455|    try await credentialStore.save(\n456|        GitHubAuth.TokenRecord(accessToken: \"ghu_old\", refreshToken: \"ghr_old\", expiresAt: Date().addingTimeInterval(30)),\n457|        serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n458|    )\n459|    await transport.append(jsonResponse([\"access_token\": \"ghu_new\", \"refresh_token\": \"ghr_new\", \"expires_in\": 3600]))\n460|    await transport.append(jsonResponse([\"installations\": [[\"id\": 7, \"account\": [\"login\": \"acme\", \"type\": \"Organization\"]]]]))\n461|    _ = await flow.apply(GitHubAuth.Effect.refreshInstallations)\n462|    #expect(await waitForLoggedActions(logger, count: 8))\n463|    let tokenPosts = await transport.requests.filter { $0.url == testConfig.tokenURL }\n464|    #expect(tokenPosts.count == 2) // 1 device poll during login + 1 refresh here\n465|    #expect(await credentialStore.load(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID)?.accessToken == \"ghu_new\")\n466|    #expect(githubActions(logger).contains { if case .syncSucceeded = $0 { true } else { false } })\n467|}\n468|\n469|@Test func flowRefreshInstallationsWithInvalidGrantDuringRefreshRequiresRelogin() async throws {\n470|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n471|    let transport = TestTransport(loginQueue())\n472|    let (flow, logger, _) = await githubHarness(transport: transport, store: store)\n473|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n474|    #expect(await waitForLoggedActions(logger, count: 6))\n475|    let expiring = GitHubAuth.TokenRecord(accessToken: \"ghu_old\", refreshToken: \"ghr_bad\", expiresAt: Date().addingTimeInterval(30))\n476|    await store.saveForTest(expiring, userID: 42)\n477|    await transport.append(jsonResponse([\"error\": \"invalid_grant\"]))\n478|    _ = await flow.apply(GitHubAuth.Effect.refreshInstallations)\n479|    #expect(await waitForLoggedActions(logger, count: 7))\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
