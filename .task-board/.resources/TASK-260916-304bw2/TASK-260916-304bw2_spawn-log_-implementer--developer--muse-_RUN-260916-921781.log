11)).foregroundStyle(.secondary).textSelection(.enabled)\n310|                Text(access.owned ? \"Группа этого Mac: изменения применяются явно.\" : \"Общая или импортированная группа: правки затрагивают все раннеры в ней и требуют явного принятия.\")\n311|                    .font(.system(size: 11)).foregroundStyle(access.owned ? Color.secondary : Color.orange)\n312|                if props.runners.candidateRepositories.isEmpty {\n313|                    Text(\"Выберите подходящую установку в разделе GitHub, чтобы увидеть репозитории.\")\n314|                        .font(.callout).foregroundStyle(.secondary)\n315|                } else if !orgMatches {\n316|                    Text(\"Выбранная установка не совпадает с организацией раннера «\\(definition.detail)». Выберите подходящую установку.\")\n317|                        .font(.callout).foregroundStyle(.orange)\n318|                } else {\n319|                    let loaded = Set(access.repoIDs)\n320|                    let draft = accessDrafts[definition.id] ?? loaded\n321|                    ForEach(props.runners.candidateRepositories) { repo in\n322|                        Toggle(\n323|                            repo.fullName,\n324|                            isOn: Binding(\n325|                                get: { draft.contains(repo.id) },\n326|                                set: { enabled in\n327|                                    var next = accessDrafts[definition.id] ?? loaded\n328|                                    if enabled { next.insert(repo.id) } else { next.remove(repo.id) }\n329|                                    accessDrafts[definition.id] = next\n330|                                }\n331|                            )\n332|                        )\n333|                        .font(.callout)\n334|                        .disabled(access.loading)\n335|                    }\n336|                    HStack(spacing: 8) {\n337|                        Button(\"Применить\") { reactions.applyGroupAccess(definition.id, draft) }\n338|                            .buttonStyle(.borderedProminent).tint(.teal).controlSize(.small)\n339|                            .disabled(access.loading || draft == loaded)\n340|                        Button(\"Обновить\") { reactions.loadGroupAccess(definition.id) }\n341|                            .buttonStyle(.bordered).controlSize(.small)\n342|                            .disabled(access.loading)\n343|                        if access.loading { ProgressView().controlSize(.small) }\n344|                    }\n345|                    .onChange(of: access.repoIDs) { accessDrafts.removeValue(forKey: definition.id) }\n346|                }\n347|            } else if access?.loading == true {\n348|                HStack(spacing: 8) {\n349|                    ProgressView().controlSize(.small)\n350|                    Text(\"Загружаем текущую группу из GitHub…\").font(.callout).foregroundStyle(.secondary)\n351|                }\n352|            } else {\n353|                if let error = access?.error {\n354|                    Text(error).font(.caption).foregroundStyle(.orange).textSelection(.enabled).lineLimit(4)\n355|                } else {\n356|                    Text(\"Группа определяется свежим составом GitHub, а не локальным .runner.\")\n357|                        .font(.system(size: 11)).foregroundStyle(.secondary)\n358|                }\n359|                Button(\"Загрузить текущий доступ\") { reactions.loadGroupAccess(definition.id) }\n360|                    .buttonStyle(.bordered).controlSize(.small)\n361|            }\n362|        }\n363|    }\n364|\n365|    private func detailRow(_ title: String, _ value: String) -> some View {\n366|        VStack(alignment: .leading, spacing: 2) {\n367|            Text(title).font(.system(size: 10)).foregroundStyle(.secondary)\n368|            Text(value).font(.system(size: 11)).textSelection(.enabled).lineLimit(3)\n369|        }\n370|    }\n371|\n372|    // MARK: - GitHub\n373|\n374|    private var githubTab: some View {\n375|        ScrollView {\n376|            VStack(alignment: .leading, spacing: 16) {\n377|                switch props.github.connection {\n378|                case .disconnected:\n379|                    disconnectedView\n380|                case .requestingCode:\n381|                    HStack(spacing: 10) {\n382|                        ProgressView().controlSize(.small)\n383|                        Text(\"Запрашиваем код входа…\").font(.callout)\n384|                    }\n385|                    .padding(.vertical, 20)\n386|                case .awaitingUser(let userCode, let uri, let expiresIn, let interval):\n387|                    awaitingView(userCode: userCode, uri: uri, expiresIn: expiresIn, interval: interval)\n388|                case .verifyingAccount:\n389|                    HStack(spacing: 10) {\n390|                        ProgressView().controlSize(.small)\n391|                        Text(\"Проверяем аккаунт…\").font(.callout)\n392|                    }\n393|                    .padding(.vertical, 20)\n394|                case .verifyingInstallations(let username):\n395|                    HStack(spacing: 10) {\n396|                        ProgressView().controlSize(.small)\n397|                        Text(\"Проверяем установки для @\\(username)…\").font(.callout)\n398|                    }\n399|                    .padding(.vertical, 20)\n400|                case .connected(let username, let host):\n401|                    connectedView(username: username, host: host)\n402|                case .failed(let message, let retry):\n403|                    failedView(message: message, retry: retry)\n404|                }\n405|            }\n406|            .padding(20)\n407|            .frame(maxWidth: .infinity, alignment: .leading)\n408|        }\n409|    }\n(more lines below)","final_result":true}}}
