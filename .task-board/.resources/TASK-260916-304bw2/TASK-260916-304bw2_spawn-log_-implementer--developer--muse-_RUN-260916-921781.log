ispatcher: Relux.Dispatcher? = nil) async {\n24|            self.service = service\n25|            self.catalog = RunnerCatalogStore()\n26|            self.installer = RunnerInstallerService()\n27|            let transport = URLSessionGitHubTransport()\n28|            let store: any GitHubCredentialStoring = GitHubKeychainStore()\n29|            self.api = GitHubRunnerAPIClient(transport: transport)\n30|            self.userStore = store\n31|            self.identities = UserDefaultsGitHubSessionIdentityStore()\n32|            self.refresher = GitHubTokenRefresh(transport: transport, store: store)\n33|            self.configProvider = { host in try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\") }\n34|            self.now = Date.init\n35|            self.home = FileManager.default.homeDirectoryForCurrentUser\n36|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n37|        }\n38|        /// Testable init with explicit catalog, installer and auth dependencies.\n39|        /// Production passes the shared installer so unregister/recovery and\n40|        /// registration cannot overlap.\n41|        public init(\n42|            service: any RunnerServicing,\n43|            catalog: RunnerCatalogStore,\n44|            installer: RunnerInstallerService,\n45|            api: GitHubRunnerAPIClient,\n46|            userStore: any GitHubCredentialStoring,\n47|            identities: any GitHubSessionIdentityStoring,\n48|            refresher: GitHubTokenRefresh,\n49|            configProvider: (@Sendable (String?) throws -> GitHubAuth.AppConfig)? = nil,\n50|            now: (@Sendable () -> Date)? = nil,\n51|            home: URL? = nil,\n52|            dispatcher: Relux.Dispatcher? = nil\n53|        ) async {\n54|            self.service = service\n55|            self.catalog = catalog\n56|            self.installer = installer\n57|            self.api = api\n58|            self.userStore = userStore\n59|            self.identities = identities\n60|            self.refresher = refresher\n61|            self.configProvider = configProvider ?? { host in try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\") }\n62|            self.now = now ?? Date.init\n63|            self.home = home ?? FileManager.default.homeDirectoryForCurrentUser\n64|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n65|        }\n66|    }\n67|}\n68|extension Runners.Flow: Runners.IFlow {\n69|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n70|        guard let effect = effect as? Runners.Effect else { return .success }\n71|        switch effect {\n72|        case .refresh: await refresh()\n73|        case .setEnabled(let id, let enabled): await setEnabled(id: id, enabled: enabled)\n74|        case .setEnabledMany(let ids, let enabled): await setEnabledMany(ids: ids, enabled: enabled)\n75|        case .loadCatalog: await loadCatalog()\n76|        case .discover: await discover()\n77|        case .importCandidate(let candidate): await importCandidate(candidate)\n78|        case .importFolder(let url): await importFolder(url)\n79|        case .removeFromApp(let id): await removeFromApp(id: id)\n80|        case .unregister(let id, let confirmation): await unregister(id: id, confirmation: confirmation)\n81|        case .refreshRemote: await refreshRemote()\n82|        case .setRunAtLoad(let id, let value): await setRunAtLoad(id: id, value: value)\n83|        case .setAlias(let id, let alias): await setAlias(id: id, alias: alias)\n84|        case .relinkDirectory(let id, let url): await relink(id: id, url: url)\n85|        case .selectRunner(let id): await action { Runners.Action.selected(id) }\n86|        case .loadLog(let id): await loadLog(id: id)\n87|        case .clearLog: await action { Runners.Action.logCleared }\n88|        case .loadGroupAccess(let id): await loadGroupAccess(id: id)\n89|        case .applyGroupAccess(let id, let groupID, let repos, let allowTakeover):\n90|            await applyGroupAccess(id: id, groupID: groupID, repos: repos, allowTakeover: allowTakeover)\n91|        }\n92|        return .success\n93|    }\n94|\n95|    private func isCatalogStale(_ gen: Int) -> Bool { catalogGeneration != gen }\n96|\n97|    // MARK: - Local refresh and power\n98|\n99|    private func refresh() async {\n100|        guard !refreshing, working.isEmpty else { return }\n101|        refreshing = true\n102|        let startedAt = revision\n103|        let snapshots = await service.snapshots()\n104|        // Do not publish a stale read if a command started during this await.\n105|        if working.isEmpty && revision == startedAt {\n106|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n107|            await action { Runners.Action.refreshed(mapped_snapshots) }\n108|        }\n109|        refreshing = false\n110|    }\n111|\n112|    private func withPendingOp(_ snapshots: [Runners.Snapshot]) -> [Runners.Snapshot] {\n113|        Self.applyPending(snapshots, pending: pendingOp)\n114|    }\n115|\n116|    private nonisolated static func applyPending(_ snapshots: [Runners.Snapshot], pending: [String: Runners.OperationPhase]) -> [Runners.Snapshot] {\n117|        snapshots.map { snapshot in\n118|            var next = snapshot\n119|            next.operation = pending[snapshot.id] ?? .idle\n120|            // Reflect the operation in the local status so the row shows\n121|            // starting/stopping instead of jumping ahead to running/stopped.\n122|            if next.operation == .starting, next.status == .stopped || next.status == .failed {\n123|                next.status = .starting\n124|            } else if next.operation == .stopping, next.status == .running {\n125|                next.status = .stopping\n126|            }\n127|            return next\n128|        }\n129|    }\n130|\n131|    private func setEnabled(id: String, enabled: Bool) async {\n132|        guard !working.contains(id), !unregisterWorking.contains(id) else { return }\n133|        working.insert(id)\n134|        revision += 1\n135|        pendingOp[id] = enabled ? .starting : .stopping\n136|        await action { Runners.Action.changing(id, true) }\n137|        do { try await service.setEnabled(enabled, id: id) }\n138|        catch { await action { Runners.Action.failed(error.localizedDescription) } }\n139|        pendingOp.removeValue(forKey: id)\n140|        let snapshots = await service.snapshots()\n141|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n142|        await action { Runners.Action.refreshed(mapped_snapshots) }\n143|        working.remove(id)\n144|        await action { Runners.Action.changing(id, false) }\n145|    }\n146|\n147|    /// Bulk power with per-row errors. Every row is attempted; failures are\n148|    /// reported per row in the refreshed snapshots plus one summary failure.\n149|    /// A single-row error never blocks the rest of the list.\n150|    private func setEnabledMany(ids: [String], enabled: Bool) async {\n151|        let targets = ids.filter { !working.contains($0) && !unregisterWorking.contains($0) }\n152|        guard !targets.isEmpty else { return }\n153|        for id in targets {\n154|            working.insert(id)\n155|            pendingOp[id] = enabled ? .starting : .stopping\n156|            await action { Runners.Action.changing(id, true) }\n157|        }\n158|        revision += 1\n159|        var failures: [(String, String)] = []\n160|        for id in targets {\n161|            do { try await service.setEnabled(enabled, id: id) }\n162|            catch { failures.append((id, error.localizedDescription)) }\n163|        }\n164|        for id in targets { pendingOp.removeValue(forKey: id) }\n165|        var snapshots = await service.snapshots()\n166|        if !failures.isEmpty {\n167|            let table = Dictionary(uniqueKeysWithValues: failures)\n168|            snapshots = snapshots.map { snapshot in\n169|                var next = snapshot\n170|                if let message = table[snapshot.id] {\n171|                    next.message = message\n172|                }\n173|                return next\n174|            }\n175|            let summary = failures.map { id, message in \"\\(id): \\(message)\" }.joined(separator: \"; \")\n176|            let failureCount = failures.count\n177|            let targetCount = targets.count\n178|            let bulkMessage = \"Partial failure (\\(failureCount) of \\(targetCount)): \\(summary)\"\n179|            await action { Runners.Action.failed(bulkMessage) }\n180|        }\n181|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n182|        await action { Runners.Action.refreshed(mapped_snapshots) }\n183|        for id in targets {\n184|            working.remove(id)\n185|            await action { Runners.Action.changing(id, false) }\n186|        }\n187|    }\n188|\n189|    // MARK: - Catalog\n190|\n191|    /// One-time migration plus refresh. Never starts or stops CI and never\n192|    /// modifies services; discovery only reads.\n193|    private func loadCatalog() async {\n194|        do {\n195|            _ = try await catalog.migrateIfNeeded()\n196|            await action { Runners.Action.catalogCleared }\n197|        } catch {\n198|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n199|        }\n200|        let snapshots = await service.snapshots()\n201|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n202|        await action { Runners.Action.refreshed(mapped_snapshots) }\n203|    }\n204|\n205|    private func discover() async {\n206|        let entries = await catalog.load()\n207|        let known = Set(entries.map(\\.canonicalPath))\n208|        let extra = entries.map { RunnerCatalogStore.resolve(entry: $0) }\n209|        let candidates = RunnerDiscovery.discoverCandidates(knownCanonicals: known, extraDirectories: extra)\n210|            .filter { candidate in\n211|                let canonical = RunnerCatalogStore.canonical(candidate.directory)\n212|                return !known.contains(canonical)\n213|            }\n214|        await action { Runners.Action.candidatesLoaded(candidates) }\n215|    }\n216|\n217|    private func importCandidate(_ candidate: RunnerDiscovery.Candidate) async {\n218|        let gen = catalogGeneration\n219|        // Refuse mutations for an entry already under unregister.\n220|        if let label = candidate.label, unregisterWorking.contains(label) {\n221|            await action { Runners.Action.catalogFailed(RunnerRegistration.RegistrationError.installerBusy(path: candidate.directory.path).localizedDescription) }\n222|            return\n223|        }\n224|        do {\n225|            try RunnersCatalogGates.validateImportable(candidate)\n226|            let canonical = RunnerCatalogStore.canonical(candidate.directory)\n227|            let entries = await catalog.load()\n228|            if entries.contains(where: { $0.canonicalPath == canonical }) {\n229|                throw RunnerCatalogStore.CatalogError.duplicateDirectory(path: candidate.directory.path)\n230|            }\n231|            guard !isCatalogStale(gen) else { return }\n232|            let label: String\n233|            let plist: URL\n234|            let kind = candidate.controllerKind\n235|            if let manifest = candidate.manifest, let existing = candidate.label {\n236|                // Import without changing the existing service: never\n237|                // re-registers and never flips the preserved RunAtLoad policy.\n238|                // A manifest label already owned by another entry refuses:\n239|                // two entries must never share one control identity.\n240|                if entries.contains(where: { $0.serviceLabel == existing }) {\n241|                    throw RunnerCatalogStore.CatalogError.duplicateLabel(label: existing)\n242|                }\n243|                label = existing\n244|                plist = manifest\n245|            } else {\n246|                // No manifest: create a manual service (RunAtLoad off for new\n247|                // runners). Never bootstraps; enabling is a separate action.\n248|                // The label binds agent name plus canonical path, so two\n249|                // same-name folders never share one control identity.\n250|                label = RunnerCatalogStore.importedServiceLabel(\n251|                    agentName: candidate.agentName, directory: candidate.directory\n252|                )\n253|                if entries.contains(where: { $0.serviceLabel == label }) {\n254|                    throw RunnerCatalogStore.CatalogError.duplicateLabel(label: label)\n255|                }\n256|                plist = try await installer.setupService(directory: candidate.directory, label: label)\n257|            }\n258|            guard !isCatalogStale(gen) else { return }\n259|            let info = RunnerRegistrationReader.read(directory: candidate.directory)\n260|            let entry = RunnerCatalogStore.Entry(\n261|                directoryPath: candidate.directory.path,\n262|                canonicalPath: canonical,\n263|                bookmarkBase64: RunnerCatalogStore.bookmark(for: candidate.directory),\n264|                serviceLabel: label,\n265|                servicePlistPath: plist.path,\n266|                controllerKind: kind,\n267|                runAtLoad: candidate.runAtLoad,\n268|                serverHost: info?.serverHost ?? candidate.serverHost,\n269|                scopeKind: info?.scopeKind,\n270|                scope: info?.scopeDetail ?? candidate.scope,\n271|                remoteAgentID: info?.agentID ?? candidate.agentID,\n272|                agentName: info?.agentName ?? candidate.agentName,\n273|                workFolder: info?.workFolder ?? candidate.workFolder\n274|            )\n275|            try await catalog.add(entry)\n276|            await action { Runners.Action.catalogCleared }\n277|            let snapshots = await service.snapshots()\n278|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n279|            await action { Runners.Action.refreshed(mapped_snapshots) }\n280|            await discover()\n281|        } catch {\n282|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n283|        }\n284|    }\n285|\n286|    private func importFolder(_ url: URL) async {\n287|        var isDir: ObjCBool = false\n288|        guard FileManager.default.fileExists(atPath: url.path, isDirectory: &isDir), isDir.boolValue else {\n289|            await action { Runners.Action.catalogFailed(\"Selected folder does not exist.\") }\n290|            return\n291|        }\n292|        let candidate = RunnerDiscovery.validateFolder(url)\n293|        if candidate.needsRelocation {\n294|            await action { Runners.Action.catalogFailed(\"Path contains a space; choose a location without spaces. Running runners are never moved automatically.\") }\n295|            return\n296|        }\n297|        await importCandidate(candidate)\n298|    }\n299|\n300|    /// Removes only the catalog record. Deletes no files, no GitHub\n301|    /// registration and no certificates, and never stops a running service.\n302|    /// Warns when the service keeps running.\n303|    private func removeFromApp(id: String) async {\n304|        if unregisterWorking.contains(id) {\n305|            await action { Runners.Action.catalogFailed(\"Runner is unregistering; retry after it settles.\") }\n306|            return\n307|        }\n308|        let entries = await catalog.load()\n309|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n310|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n311|            return\n312|        }\n313|        catalogGeneration += 1\n314|        let snapshots = await service.snapshots()\n315|        let wasRunning = snapshots.first(where: { $0.id == entry.serviceLabel })?.status == .running\n316|        do {\n317|            _ = try await catalog.remove(localID: entry.localID)\n318|        } catch {\n319|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n320|            return\n321|        }\n322|        let refreshed = await service.snapshots()\n323|        let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n324|        await action { Runners.Action.refreshed(mapped_refreshed) }\n325|        if wasRunning {\n326|            await action { Runners.Action.catalogFailed(\"Removed «\\(entry.agentName ?? entry.serviceLabel)» from the app. Its service keeps running.\") }\n327|        } else {\n328|            await action { Runners.Action.catalogCleared }\n329|        }\n330|        await discover()\n331|    }\n332|\n333|    // MARK: - Unregister (explicit remote removal)\n334|\n335|    /// Explicit remote unregister, distinct from catalog removal and file\n336|    /// deletion. Binds the local verified `.runner` server/scope/agentId and\n337|    /// the service path, never a remote name alone. Stopped-only: requires a\n338|    /// positive confirmed `.stopped` observation (unknown or missing state\n339|    /// refuses) both before minting the remove token and at the `config.sh\n340|    /// remove` boundary, plus a typed confirmation matching the agent name.\n341|    /// Bound to the session it started with: a logout, account or server\n342|    /// switch invalidates unstarted side effects instead of unregistering\n343|    /// under stale authority. Holds the shared installer lease across\n344|    /// `config.sh remove` so no registration, install, recovery or second\n345|    /// unregister can overlap. Files and the service manifest stay for\n346|    /// re-registration.\n347|    private func unregister(id: String, confirmation: String) async {\n348|        guard !unregisterWorking.contains(id), !working.contains(id) else { return }\n349|        unregisterWorking.insert(id)\n350|        await action { Runners.Action.unregistering(id, true) }\n351|        await runUnregister(id: id, confirmation: confirmation)\n352|        unregisterWorking.remove(id)\n353|        await action { Runners.Action.unregistering(id, false) }\n354|    }\n355|\n356|    /// Unregister body with guaranteed operation-state release: every early\n357|    /// return below still runs the caller's epilogue, so a refused or\n358|    /// session-invalidated attempt never wedges the UI \"unregistering\"\n359|    /// state and a retry stays possible.\n360|    private func runUnregister(id: String, confirmation: String) async {\n361|        let gen = catalogGeneration\n362|        // Session ownership: the initiating session is captured once and\n363|        // re-checked at every asynchronous boundary below.\n364|        let startedIdentity = await identities.load()\n365|        do {\n366|            let entries = await catalog.load()\n367|            guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n368|                throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n369|            }\n370|            let directory = RunnerCatalogStore.resolve(entry: entry)\n371|            // Mutation authority: local verified identity plus the service\n372|            // path. A remote name match alone never authorizes removal.\n373|            guard let local = await installer.readLocalRegistration(directory: directory),\n374|                  let agentID = local.agentID,\n375|                  let agentName = local.agentName, !agentName.isEmpty,\n376|                  let address = local.gitHubURL,\n377|                  let scope = unregisterScope(address: address) else {\n378|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n379|                    \"No verified local registration for '\\(entry.serviceLabel)'. Refusing to unregister another runner by name.\"\n380|                )\n381|            }\n382|            // Service-path binding: the catalog entry must still point at the\n383|            // verified directory; a relink mid-flight invalidates the evidence.\n384|            let canonical = RunnerCatalogStore.canonical(directory)\n385|            guard canonical == entry.canonicalPath else {\n386|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n387|                    \"Service path changed during unregister. Re-verify instead of removing another directory's registration.\"\n388|                )\n389|            }\n390|            // Agent-ID binding: a stored ID that disagrees with disk fails\n391|            // closed instead of removing a foreign registration.\n392|            if let stored = entry.remoteAgentID, stored != agentID {\n393|                throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n394|                    \"Catalog expects agent \\(stored) but disk shows agent \\(agentID) for '\\(agentName)'. Refusing to unregister a mismatched registration.\"\n395|                )\n396|            }\n397|            guard confirmation == agentName else {\n398|                throw RunnerRegistration.RegistrationError.confirmationMismatch(\n399|                    \"Type '\\(agentName)' to confirm unregister of agent \\(agentID) in \\(scope.detail).\"\n400|                )\n401|            }\n402|            guard !isCatalogStale(gen) else { return }\n403|            // Stopped-only gate: a positive confirmed `.stopped` observation\n404|            // is required before minting the remove token, so unregister\n405|            // cannot interrupt a job — or a service whose state is unknown.\n406|            try await requireConfirmedStopped(entry: entry)\n407|            guard !isCatalogStale(gen) else { return }\n408|            let auth = try await currentUserToken()\n409|            guard !isCatalogStale(gen) else { return }\n410|            // Server binding: the verified host must equal the authenticated\n411|            // server; a same-path foreign host never authorizes removal here.\n412|            let verifiedHost = URL(string: address)?.host ?? \"\"\n413|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n414|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n415|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n416|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost). Refusing cross-server unregister.\"\n417|                )\n418|            }\n419|            let created = try await api.createRemoveToken(config: auth.config, token: auth.token, scope: scope)\n420|            guard !isCatalogStale(gen) else { return }\n421|            // A logout, account or server switch during token acquisition\n422|            // invalidates the unstarted side effect; the minted token\n423|            // simply expires unused.\n424|            guard await sessionStill(startedIdentity) else { return }\n425|            // Re-verify after the network: scope/path edits invalidate stale\n426|            // evidence instead of removing a re-targeted registration.\n427|            guard let reread = await installer.readLocalRegistration(directory: directory),\n428|                  reread.agentID == agentID, reread.agentName == agentName,\n429|                  reread.gitHubURL == address else {\n430|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n431|                    \"Local registration changed during unregister. Re-verify instead of removing a re-targeted registration.\"\n432|                )\n433|            }\n434|            let currentEntries = await catalog.load()\n435|            guard currentEntries.contains(where: { $0.localID == entry.localID && $0.canonicalPath == canonical }) else {\n436|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n437|                    \"Catalog entry changed during unregister. Re-verify instead of removing another entry.\"\n438|                )\n439|            }\n440|            // Revalidate the stopped evidence at the side-effect boundary: a\n441|            // service started (or lost to inspection) after the token mint\n442|            // must not be unregistered.\n443|            guard !isCatalogStale(gen) else { return }\n444|            guard await sessionStill(startedIdentity) else { return }\n445|            try await requireConfirmedStopped(entry: entry)\n446|            try await installer.unregister(directory: directory, removeToken: created.token)\n447|            guard !isCatalogStale(gen) else { return }\n448|            // Remote registration is gone; the catalog entry stays so the\n449|            // user can re-register or remove it from the app. Files stay.\n450|            // This local bookkeeping follows a completed side effect: the\n451|            // remote removal is real even if the session changed while the\n452|            // installer lease was held, and no cancellation can undo it.\n453|            var updated = entry\n454|            updated.remoteAgentID = nil\n455|            updated.lastSeenAt = now()\n456|            try await catalog.update(updated)\n457|            await action { Runners.Action.catalogCleared }\n458|            let refreshed = await service.snapshots()\n459|            let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n460|            await action { Runners.Action.refreshed(mapped_refreshed) }\n461|        } catch {\n462|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n463|                await action { Runners.Action.catalogFailed(error.localizedDescription) }\n464|            }\n465|        }\n466|    }\n467|\n468|    /// Stopped-only gate for unregister. Only a positive confirmed `.stopped`\n469|    /// observation authorizes removal. `.running` refuses with a stop-first\n470|    /// message; a missing observation and every other state (unknown, failed,\n471|    /// missing, transitional, ...) refuse as unconfirmed instead of being\n472|    /// treated as stopped. A launchctl permission error (`.unknown`) therefore\n473|    /// never authorizes `config.sh remove` on a possibly live runner.\n474|    private func requireConfirmedStopped(entry: RunnerCatalogStore.Entry) async throws {\n475|        let snapshots = await service.snapshots()\n476|        guard let observation = snapshots.first(where: { $0.id == entry.serviceLabel }) else {\n477|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n478|                \"Cannot confirm the service '\\(entry.serviceLabel)' is stopped (no observation). Refusing to unregister while the service state is unconfirmed.\"\n479|            )\n480|        }\n481|        switch observation.status {\n482|        case .stopped:\n483|            return\n484|        case .running:\n485|            throw RunnerRegistration.RegistrationError.invalidDraft(\n486|                \"Stop the runner first; unregister refuses to interrupt a running service.\"\n487|            )\n488|        default:\n489|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n490|                \"Cannot confirm the service '\\(entry.serviceLabel)' is stopped (observed: \\(observation.status.rawValue)). Refusing to unregister while the service state is unconfirmed.\"\n491|            )\n492|        }\n493|    }\n494|\n495|    private func unregisterScope(address: String) -> RunnerRegistration.Scope? {\n496|        guard let url = URL(string: address), url.scheme == \"https\" else { return nil }\n497|        let components = url.pathComponents.filter { $0 != \"/\" }\n498|        if components.count == 1 { return .organization(org: components[0]) }\n499|        if components.count == 2 { return .repository(owner: components[0], name: components[1]) }\n500|        return nil\n(more lines below)","final_result":true}}}
