{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7a7","stream":{"kind":"session","id":"01a0a9c5-2eb3-7902-83b0-77aeb115d140"},"sequence":558,"recorded_at":1780531400001111,"record_type":"event","durability":"durable","causation_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","run_stream":{"kind":"run","id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246"},"task_stream":{"kind":"task","id":"01a0a9c6-8691-75f1-8868-04da763d92ea"},"task_id":"01a0a9c6-8691-75f1-8868-04da763d92ea","event":{"kind":"output","task_id":"01a0a9c6-8691-75f1-8868-04da763d92ea","chunk":"Read text file `/Users/iv/Documents/Codex/2026-09-15/new-chat-4/outputs/RunnerControl/.temp/STORY-260916-36d1jg/worktree/Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n1|import Foundation\n2|import Testing\n3|import Relux\n4|@testable import RunnerControlCore\n5|\n6|// MARK: - Catalog lifecycle harness (production entry points, controlled IO)\n7|\n8|// TestTransport, jsonResponse, testConfig shared from GitHubTransportTests.\n9|// FakeExecutor, stopped, running shared from RunnerControlCoreTests.\n10|\n11|private struct CatalogHarness {\n12|    let flow: Runners.Flow\n13|    let logger: Relux.Testing.Logger\n14|    let transport: TestTransport\n15|    let launchExecutor: FakeExecutor\n16|    let installerExecutor: FakeExecutor\n17|    let userStore: GitHubKeychainStore\n18|    let identities: any GitHubSessionIdentityStoring\n19|    let installer: RunnerInstallerService\n20|    let catalog: RunnerCatalogStore\n21|    let service: LaunchAgentService\n22|    let home: URL\n23|    let catalogFile: URL\n24|}\n25|\n26|private func catalogHarness(\n27|    launchResults: [CommandResult] = [],\n28|    installerResults: [CommandResult] = [],\n29|    transportResponses: [GitHubHTTPResponse] = [],\n30|    seedAuth: Bool = true,\n31|    identitiesOverride: (any GitHubSessionIdentityStoring)? = nil\n32|) async -> CatalogHarness {\n33|    let logger = Relux.Testing.Logger()\n34|    let dispatcher = Relux.Dispatcher(logger: logger)\n35|    let launchExecutor = FakeExecutor(launchResults)\n36|    let installerExecutor = FakeExecutor(installerResults)\n37|    let transport = TestTransport(transportResponses)\n38|    let userStore = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n39|    let identities: any GitHubSessionIdentityStoring = identitiesOverride ?? InMemoryGitHubSessionIdentityStore()\n40|    if seedAuth {\n41|        if identitiesOverride == nil {\n42|            await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n43|        }\n44|        try? await userStore.save(\n45|            GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n46|            serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n47|        )\n48|    }\n49|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"CatalogHome-\" + UUID().uuidString)\n50|    try? FileManager.default.createDirectory(at: home, withIntermediateDirectories: true)\n51|    let catalogFile = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n52|    let catalog = RunnerCatalogStore(fileURL: catalogFile)\n53|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n54|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n55|    let installer = RunnerInstallerService(installRoot: installRoot, executor: installerExecutor)\n56|    let service = LaunchAgentService(catalog: catalog, executor: launchExecutor, userID: 501, home: home)\n57|    let api = GitHubRunnerAPIClient(transport: transport)\n58|    let refresher = GitHubTokenRefresh(transport: transport, store: userStore)\n59|    let flow = await Runners.Flow(\n60|        service: service, catalog: catalog, installer: installer,\n61|        api: api, userStore: userStore, identities: identities,\n62|        refresher: refresher, configProvider: { _ in testConfig },\n63|        home: home, dispatcher: dispatcher\n64|    )\n65|    return CatalogHarness(\n66|        flow: flow, logger: logger, transport: transport,\n67|        launchExecutor: launchExecutor, installerExecutor: installerExecutor,\n68|        userStore: userStore, identities: identities,\n69|        installer: installer, catalog: catalog, service: service,\n70|        home: home, catalogFile: catalogFile\n71|    )\n72|}\n73|\n74|private func runnersActions(_ logger: Relux.Testing.Logger) -> [Runners.Action] {\n75|    logger.actions.compactMap { $0 as? Runners.Action }\n76|}\n77|\n78|private func lastCatalogFailure(_ logger: Relux.Testing.Logger) -> String? {\n79|    for action in runnersActions(logger).reversed() {\n80|        if case .catalogFailed(let message) = action { return message }\n81|    }\n82|    return nil\n83|}\n84|\n85|\n86|private func catalogErr(_ logger: Relux.Testing.Logger) -> String {\n87|    lastCatalogFailure(logger) ?? \"\"\n88|}\n89|\n90|private func failErr(_ logger: Relux.Testing.Logger) -> String {\n91|    lastFailureMessage(logger) ?? \"\"\n92|}\n93|\n94|private func lastFailureMessage(_ logger: Relux.Testing.Logger) -> String? {\n95|    for action in runnersActions(logger).reversed() {\n96|        if case .failed(let message) = action { return message }\n97|    }\n98|    return nil\n99|}\n100|\n101|/// Creates a runner directory with `.runner`, `runsvc.sh`, `run.sh` and an\n102|/// optional manual-service plist. Returns the directory.\n103|@discardableResult\n104|private func makeRunnerDir(\n105|    parent: URL, name: String,\n106|    agentName: String = \"test-runner\", scope: String = \"acme/app\",\n107|    agentID: Int64 = 42, workFolder: String = \"_work\",\n108|    runAtLoad: Bool? = true, withPlist: Bool = true,\n109|    label: String? = nil\n110|) throws -> URL {\n111|    let dir = parent.appendingPathComponent(name)\n112|    try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)\n113|    let config: [String: Any] = [\n114|        \"agentId\": agentID, \"agentName\": agentName,\n115|        \"gitHubUrl\": \"https://github.com/\" + scope, \"workFolder\": workFolder\n116|    ]\n117|    try JSONSerialization.data(withJSONObject: config).write(to: dir.appendingPathComponent(\".runner\"))\n118|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"runsvc.sh\"), atomically: true, encoding: .utf8)\n119|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n120|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n121|    if withPlist {\n122|        let resolvedLabel = label ?? \"actions.runner.test.\\(name)\"\n123|        var plist: [String: Any] = [\n124|            \"Label\": resolvedLabel,\n125|            \"ProgramArguments\": [dir.appendingPathComponent(\"runsvc.sh\").path],\n126|            \"WorkingDirectory\": dir.path\n127|        ]\n128|        if let runAtLoad { plist[\"RunAtLoad\"] = runAtLoad }\n129|        try PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0)\n130|            .write(to: dir.appendingPathComponent(\"manual-service.plist\"))\n131|    }\n132|    return dir\n133|}\n134|\n135|private func runnersListPayload(_ runners: [[String: Any]]) -> GitHubHTTPResponse {\n136|    jsonResponse([\"runners\": runners])\n137|}\n138|\n139|private func removeTokenPayload(token: String = \"remove-token-1\") -> GitHubHTTPResponse {\n140|    jsonResponse([\"token\": token, \"expires_at\": \"2030-01-01T00:00:00Z\"])\n141|}\n142|\n143|// MARK: - Catalog persistence and dedupe (AC rows 1, 3)\n144|\n145|@Test func catalogPersistsAndDedupesCanonicalViaSymlink() async throws {\n146|    let file = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n147|    defer { try? FileManager.default.removeItem(at: file) }\n148|    let store = RunnerCatalogStore(fileURL: file)\n149|    let root = FileManager.default.temporaryDirectory.appendingPathComponent(\"Dedupe-\" + UUID().uuidString)\n150|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n151|    defer { try? FileManager.default.removeItem(at: root) }\n152|    let dir = try makeRunnerDir(parent: root, name: \"runner-a\")\n153|    let canonical = RunnerCatalogStore.canonical(dir)\n154|    let entry = RunnerCatalogStore.Entry(\n155|        directoryPath: dir.path, canonicalPath: canonical,\n156|        serviceLabel: \"actions.runner.test.a\",\n157|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n158|        controllerKind: .manualManaged, runAtLoad: true,\n159|        serverHost: \"github.com\", scopeKind: \"repo\", scope: \"acme/app\",\n160|        remoteAgentID: 42, agentName: \"runner\", workFolder: \"_work\"\n161|    )\n162|    try await store.add(entry)\n163|    #expect(await store.load().count == 1)\n164|    // Same directory via a symlink spelling must be refused.\n165|    let link = root.appendingPathComponent(\"link-a\")\n166|    try FileManager.default.createSymbolicLink(at: link, withDestinationURL: dir)\n167|    let alias = RunnerCatalogStore.Entry(\n168|        directoryPath: link.path, canonicalPath: RunnerCatalogStore.canonical(link),\n169|        serviceLabel: \"actions.runner.test.alias\",\n170|        servicePlistPath: link.appendingPathComponent(\"manual-service.plist\").path,\n171|        controllerKind: .manualManaged\n172|    )\n173|    do {\n174|        try await store.add(alias)\n175|        Issue.record(\"Catalog admitted the same directory twice via symlink\")\n176|    } catch let error as RunnerCatalogStore.CatalogError {\n177|        guard case .duplicateDirectory = error else {\n178|            Issue.record(\"Wrong dedupe error: \\(error)\"); return\n179|        }\n180|    }\n181|    #expect(await store.load().count == 1)\n182|}\n183|\n184|@Test func catalogKeepsSameNameDifferentScopesAsTwoRunners() async throws {\n185|    let file = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n186|    defer { try? FileManager.default.removeItem(at: file) }\n187|    let store = RunnerCatalogStore(fileURL: file)\n188|    let root = FileManager.default.temporaryDirectory.appendingPathComponent(\"Scopes-\" + UUID().uuidString)\n189|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n190|    defer { try? FileManager.default.removeItem(at: root) }\n191|    let orgDir = try makeRunnerDir(parent: root, name: \"org-runner\", agentName: \"mac\", scope: \"acme\", agentID: 1)\n192|    let repoDir = try makeRunnerDir(parent: root, name: \"repo-runner\", agentName: \"mac\", scope: \"acme/app\", agentID: 2)\n193|    for (dir, label, kind, scope) in [\n194|        (orgDir, \"actions.runner.test.org\", \"org\", \"acme\"),\n195|        (repoDir, \"actions.runner.test.repo\", \"repo\", \"acme/app\")\n196|    ] {\n197|        let entry = RunnerCatalogStore.Entry(\n198|            directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n199|            serviceLabel: label,\n200|            servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n201|            controllerKind: .manualManaged, serverHost: \"github.com\",\n202|            scopeKind: kind, scope: scope, agentName: \"mac\"\n203|        )\n204|        try await store.add(entry)\n205|    }\n206|    let loaded = await store.load()\n207|    #expect(loaded.count == 2)\n208|    #expect(Set(loaded.map(\\.scope)) == [\"acme\", \"acme/app\"])\n209|}\n210|\n211|// MARK: - Migration preserves production (AC rows 12, 13)\n212|\n213|@Test func migrationPreservesPoliciesWithoutTouchingServices() async throws {\n214|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"MigHome-\" + UUID().uuidString)\n215|    defer { try? FileManager.default.removeItem(at: home) }\n216|    let root = home.appendingPathComponent(\"Library/GitHubActions\")\n217|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n218|    let a = try makeRunnerDir(parent: root, name: \"a\", agentName: \"mac\", scope: \"acme\", agentID: 11, runAtLoad: true, label: \"actions.runner.test.a\")\n219|    let b = try makeRunnerDir(parent: root, name: \"b\", agentName: \"mac\", scope: \"acme/app\", agentID: 22, runAtLoad: false, label: \"actions.runner.test.b\")\n220|    try \"#!/bin/sh\\nexit 0\\n\".write(to: a.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n221|    try \"#!/bin/sh\\nexit 0\\n\".write(to: b.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n222|    let beforeA = try Data(contentsOf: a.appendingPathComponent(\"manual-service.plist\"))\n223|    let beforeB = try Data(contentsOf: b.appendingPathComponent(\"manual-service.plist\"))\n224|    let file = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n225|    defer { try? FileManager.default.removeItem(at: file) }\n226|    let store = RunnerCatalogStore(fileURL: file)\n227|    let migrated = try await store.migrateIfNeeded(home: home)\n228|    #expect(migrated.count == 2)\n229|    #expect(Set(migrated.map(\\.serviceLabel)) == [\"actions.runner.test.a\", \"actions.runner.test.b\"])\n230|    #expect(migrated.first { $0.serviceLabel == \"actions.runner.test.a\" }?.runAtLoad == true)\n231|    #expect(migrated.first { $0.serviceLabel == \"actions.runner.test.b\" }?.runAtLoad == false)\n232|    #expect(migrated.first { $0.serviceLabel == \"actions.runner.test.a\" }?.scope == \"acme\")\n233|    #expect(migrated.first { $0.serviceLabel == \"actions.runner.test.b\" }?.scope == \"acme/app\")\n234|    // Services untouched: byte-identical plists, no relaunch.\n235|    #expect(try Data(contentsOf: a.appendingPathComponent(\"manual-service.plist\")) == beforeA)\n236|    #expect(try Data(contentsOf: b.appendingPathComponent(\"manual-service.plist\")) == beforeB)\n237|    // Second migration is a no-op (no duplicates).\n238|    let again = try await store.migrateIfNeeded(home: home)\n239|    #expect(again.count == 2)\n240|}\n241|\n242|// MARK: - Discovery candidates (AC row 2)\n243|\n244|@Test func discoveryFindsManualAndStandardWithoutLaunching() throws {\n245|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"DiscHome-\" + UUID().uuidString)\n246|    defer { try? FileManager.default.removeItem(at: home) }\n247|    let fm = FileManager.default\n248|    let agents = home.appendingPathComponent(\"Library/LaunchAgents\")\n249|    let root = home.appendingPathComponent(\"Library/GitHubActions\")\n250|    try fm.createDirectory(at: agents, withIntermediateDirectories: true)\n251|    try fm.createDirectory(at: root, withIntermediateDirectories: true)\n252|    let manual = try makeRunnerDir(parent: root, name: \"manual\", agentName: \"mac\", scope: \"acme/app\", label: \"actions.runner.test.manual\")\n253|    let custom = home.appendingPathComponent(\"custom-install\")\n254|    try fm.createDirectory(at: custom, withIntermediateDirectories: true)\n255|    let config: [String: Any] = [\"agentId\": 7, \"agentName\": \"mac\", \"gitHubUrl\": \"https://github.com/acme\", \"workFolder\": \"_work\"]\n256|    try JSONSerialization.data(withJSONObject: config).write(to: custom.appendingPathComponent(\".runner\"))\n257|    try \"#!/bin/sh\\nexit 0\\n\".write(to: custom.appendingPathComponent(\"runsvc.sh\"), atomically: true, encoding: .utf8)\n258|    try \"#!/bin/sh\\nexit 0\\n\".write(to: custom.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n259|    let standardManifest = agents.appendingPathComponent(\"actions.runner.test.standard.plist\")\n260|    let plist: [String: Any] = [\n261|        \"Label\": \"actions.runner.test.standard\",\n262|        \"WorkingDirectory\": custom.path,\n263|        \"ProgramArguments\": [custom.appendingPathComponent(\"runsvc.sh\").path],\n264|        \"RunAtLoad\": true\n265|    ]\n266|    try PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0).write(to: standardManifest)\n267|    // Unknown supervisor: label matches but args do not launch runsvc.sh.\n268|    let weirdDir = try makeRunnerDir(parent: root, name: \"weird\", withPlist: false)\n269|    let weirdManifest = agents.appendingPathComponent(\"actions.runner.test.weird.plist\")\n270|    let weird: [String: Any] = [\n271|        \"Label\": \"actions.runner.test.weird\",\n272|        \"WorkingDirectory\": weirdDir.path,\n273|        \"ProgramArguments\": [\"/bin/sleep\", \"10\"]\n274|    ]\n275|    try PropertyListSerialization.data(fromPropertyList: weird, format: .xml, options: 0).write(to: weirdManifest)\n276|    // .credentials present but must never be read for discovery.\n277|    try \"secret-token\".write(to: manual.appendingPathComponent(\".credentials\"), atomically: true, encoding: .utf8)\n278|    let candidates = RunnerDiscovery.discoverCandidates(home: home)\n279|    #expect(candidates.count == 3)\n280|    let manualCandidate = candidates.first { $0.directory.path == manual.path }\n281|    #expect(manualCandidate?.isImportable == true)\n282|    #expect(manualCandidate?.controllerKind == .manualManaged)\n283|    let standardCandidate = candidates.first { $0.label == \"actions.runner.test.standard\" }\n284|    #expect(standardCandidate?.isImportable == true)\n285|    #expect(standardCandidate?.controllerKind == .standardLaunchAgent)\n286|    let weirdCandidate = candidates.first { $0.label == \"actions.runner.test.weird\" }\n287|    #expect(weirdCandidate?.controllerKind == .unsupported)\n288|    #expect(weirdCandidate?.isImportable == false)\n289|    let weirdReason = weirdCandidate?.unsupportedReason ?? \"\"\n290|    #expect(weirdReason.contains(\"Unknown supervisor\"))\n291|}\n292|\n293|// MARK: - Import gates (AC rows 3, 4, 10, 12)\n294|\n295|@Test func importRefusesSpacedPathWithoutMoving() async throws {\n296|    let harness = await catalogHarness()\n297|    defer { try? FileManager.default.removeItem(at: harness.home) }\n298|    let root = harness.home.appendingPathComponent(\"spaced root\")\n299|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n300|    let dir = try makeRunnerDir(parent: root, name: \"runner\", label: \"actions.runner.test.spaced\")\n301|    let candidate = RunnerDiscovery.validateFolder(dir)\n302|    #expect(candidate.needsRelocation == true)\n303|    #expect(candidate.isImportable == false)\n304|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.importCandidate(candidate))\n305|    #expect(lastCatalogFailure(harness.logger)?.contains(\"space\") == true)\n306|    #expect(await harness.catalog.load().isEmpty)\n307|    // No auto-move: the spaced directory still exists untouched.\n308|    #expect(FileManager.default.fileExists(atPath: dir.path))\n309|}\n310|\n311|@Test func importRefusesMissingBinariesAndRegistration() async throws {\n312|    let harness = await catalogHarness()\n313|    defer { try? FileManager.default.removeItem(at: harness.home) }\n314|    let dir = try makeRunnerDir(parent: harness.home, name: \"broken\", label: \"actions.runner.test.broken\")\n315|    try FileManager.default.removeItem(at: dir.appendingPathComponent(\"runsvc.sh\"))\n316|    try FileManager.default.removeItem(at: dir.appendingPathComponent(\".runner\"))\n317|    let candidate = RunnerDiscovery.validateManifest(dir.appendingPathComponent(\"manual-service.plist\"))\n318|    #expect(candidate.isImportable == false)\n319|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.importCandidate(candidate))\n320|    #expect(lastCatalogFailure(harness.logger) != nil)\n321|    #expect(await harness.catalog.load().isEmpty)\n322|}\n323|\n324|@Test func importRefusesUnsupportedWithoutSecondProcess() async throws {\n325|    let harness = await catalogHarness()\n326|    defer { try? FileManager.default.removeItem(at: harness.home) }\n327|    let dir = try makeRunnerDir(parent: harness.home, name: \"weird\", withPlist: false)\n328|    let manifest = harness.home.appendingPathComponent(\"weird.plist\")\n329|    let plist: [String: Any] = [\n330|        \"Label\": \"actions.runner.test.weird\",\n331|        \"WorkingDirectory\": dir.path,\n332|        \"ProgramArguments\": [\"/bin/sleep\", \"10\"]\n333|    ]\n334|    try PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0).write(to: manifest)\n335|    let candidate = RunnerDiscovery.validateManifest(manifest)\n336|    #expect(candidate.controllerKind == .unsupported)\n337|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.importCandidate(candidate))\n338|    let unsupErr = catalogErr(harness.logger)\n339|    #expect(unsupErr.contains(\"Unsupported\") || unsupErr.contains(\"supervisor\"))\n340|    #expect(await harness.catalog.load().isEmpty)\n341|    #expect(await harness.launchExecutor.calls.isEmpty)\n342|}\n343|\n344|@Test func importPreservesServiceAndRunAtLoad() async throws {\n345|    let harness = await catalogHarness(launchResults: [\n346|        CommandResult(code: 113, output: \"Could not find service x\")\n347|    ])\n348|    defer { try? FileManager.default.removeItem(at: harness.home) }\n349|    let root = harness.home.appendingPathComponent(\"Library/GitHubActions\")\n350|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n351|    let dir = try makeRunnerDir(parent: root, name: \"keep\", agentName: \"keep-runner\", scope: \"acme\", runAtLoad: true, label: \"actions.runner.test.keep\")\n352|    let before = try Data(contentsOf: dir.appendingPathComponent(\"manual-service.plist\"))\n353|    let candidate = RunnerDiscovery.validateManifest(dir.appendingPathComponent(\"manual-service.plist\"))\n354|    #expect(candidate.isImportable == true)\n355|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.importCandidate(candidate))\n356|    #expect(lastCatalogFailure(harness.logger) == nil)\n357|    let entries = await harness.catalog.load()\n358|    #expect(entries.count == 1)\n359|    #expect(entries.first?.runAtLoad == true)\n360|    #expect(entries.first?.serviceLabel == \"actions.runner.test.keep\")\n361|    // Service file byte-identical: import never rewrites the policy.\n362|    #expect(try Data(contentsOf: dir.appendingPathComponent(\"manual-service.plist\")) == before)\n363|    // Import never bootstraps: only the post-import refresh print ran.\n364|    for call in await harness.launchExecutor.calls {\n365|        #expect(!call.contains(\"bootstrap\"))\n366|    }\n367|}\n368|\n369|// MARK: - Local snapshots preserve running (AC rows 5, 8)\n370|\n371|@Test func snapshotsPreserveRunningDespiteMissingRunner() async throws {\n372|    let root = FileManager.default.temporaryDirectory.appendingPathComponent(\"Snap-\" + UUID().uuidString)\n373|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n374|    defer { try? FileManager.default.removeItem(at: root) }\n375|    let dir = try makeRunnerDir(parent: root, name: \"svc\", label: \"actions.runner.test.svc\")\n376|    try FileManager.default.removeItem(at: dir.appendingPathComponent(\".runner\"))\n377|    let definition = Runners.Definition(\n378|        id: \"actions.runner.test.svc\", title: \"svc\", detail: \"acme\",\n379|        directory: dir, githubURL: URL(string: \"https://github.com/acme\")!,\n380|        servicePlist: dir.appendingPathComponent(\"manual-service.plist\")\n381|    )\n382|    let executor = FakeExecutor([CommandResult(code: 0, output: \"state = running\")])\n383|    let service = LaunchAgentService(definitions: [definition], executor: executor, userID: 501)\n384|    let snapshots = await service.snapshots()\n385|    #expect(snapshots.first?.status == .running)\n386|    let snapMsg = snapshots.first?.message ?? \"\"\n387|    #expect(snapMsg.contains(\"Рабочий каталог\"))\n388|}\n389|\n390|@Test func stopWorksDespiteMissingRunnerStartBlockedOnBadManifest() async throws {\n391|    let root = FileManager.default.temporaryDirectory.appendingPathComponent(\"Stop-\" + UUID().uuidString)\n392|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n393|    defer { try? FileManager.default.removeItem(at: root) }\n394|    let dir = try makeRunnerDir(parent: root, name: \"svc\", label: \"actions.runner.test.stop\")\n395|    try FileManager.default.removeItem(at: dir.appendingPathComponent(\".runner\"))\n396|    let definition = Runners.Definition(\n397|        id: \"actions.runner.test.stop\", title: \"svc\", detail: \"acme\",\n398|        directory: dir, githubURL: URL(string: \"https://github.com/acme\")!,\n399|        servicePlist: dir.appendingPathComponent(\"manual-service.plist\")\n400|    )\n(more lines below)","final_result":true}}}
