nt }\n20|        public func cleanup() async {\n21|            runners = runners.map { Snapshot(definition: $0.definition) }; changing = []; lastError = nil\n22|            candidates = []; catalogError = nil; selectedID = nil; unregistering = []\n23|            remoteSyncError = nil; lastRemoteSync = nil\n24|            logPreviewTitle = nil; logPreview = nil; groupAccess = [:]\n25|        }\n26|    }\n27|    public enum Action: Relux.Action {\n28|        case refreshed([Snapshot])\n29|        case changing(String, Bool)\n30|        case failed(String)\n31|        case clearError\n32|        case candidatesLoaded([RunnerDiscovery.Candidate])\n33|        case catalogFailed(String)\n34|        case catalogCleared\n35|        case selected(String?)\n36|        case unregistering(String, Bool)\n37|        case remoteUpdated(String, RemoteObservation)\n38|        case remoteSyncFinished(Date)\n39|        case remoteSyncFailed(String)\n40|        case logLoaded(title: String, excerpt: String)\n41|        case logCleared\n42|        case groupAccessLoading(String)\n43|        case groupAccessLoaded(String, GroupAccess)\n44|        case groupAccessFailed(String, String)\n45|    }\n46|    public enum Effect: Relux.Effect {\n47|        case refresh\n48|        case setEnabled(String, Bool)\n49|        case setEnabledMany([String], Bool)\n50|        case loadCatalog\n51|        case discover\n52|        case importCandidate(RunnerDiscovery.Candidate)\n53|        case importFolder(URL)\n54|        case removeFromApp(String)\n55|        case unregister(String, confirmation: String)\n56|        case refreshRemote\n57|        case setRunAtLoad(String, Bool)\n58|        case setAlias(String, String?)\n59|        case relinkDirectory(String, URL)\n60|        case selectRunner(String?)\n61|        case loadLog(String)\n62|        case clearLog\n63|        case loadGroupAccess(String)\n64|        case applyGroupAccess(String, groupID: Int64, repositories: Set<Int64>, allowTakeover: B