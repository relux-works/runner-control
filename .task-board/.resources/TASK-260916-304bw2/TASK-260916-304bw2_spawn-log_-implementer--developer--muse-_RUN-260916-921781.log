{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5fb","stream":{"kind":"session","id":"01a0a9c5-2eb3-7902-83b0-77aeb115d140"},"sequence":344,"recorded_at":1780531400000683,"record_type":"event","durability":"durable","causation_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","run_stream":{"kind":"run","id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246"},"task_stream":{"kind":"task","id":"01a0a9c6-125f-7d21-8633-03f708c904bc"},"task_id":"01a0a9c6-125f-7d21-8633-03f708c904bc","event":{"kind":"output","task_id":"01a0a9c6-125f-7d21-8633-03f708c904bc","chunk":"Read text file `/Users/iv/Documents/Codex/2026-09-15/new-chat-4/outputs/RunnerControl/.temp/STORY-260916-36d1jg/worktree/Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n(499 line(s) above)\n500|        return nil\n501|    }\n502|\n503|    private struct CatalogUserToken: Sendable {\n504|        let config: GitHubAuth.AppConfig\n505|        let token: String\n506|        let identity: GitHubSessionIdentity\n507|    }\n508|\n509|    private func currentUserToken() async throws -> CatalogUserToken {\n510|        guard let identity = await identities.load() else {\n511|            throw RunnerRegistration.RegistrationError.notAuthenticated\n512|        }\n513|        let config = try configProvider(identity.serverHost)\n514|        guard var record = await userStore.load(serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID) else {\n515|            throw RunnerRegistration.RegistrationError.notAuthenticated\n516|        }\n517|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n518|            do {\n519|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n520|            } catch is CancellationError {\n521|                throw CancellationError()\n522|            } catch let error as GitHubAuth.AuthError {\n523|                switch error {\n524|                case .revoked, .unauthorized, .tokenRefreshFailed:\n525|                    throw RunnerRegistration.RegistrationError.unauthorized\n526|                default: break\n527|                }\n528|            }\n529|        }\n530|        return CatalogUserToken(config: config, token: record.accessToken, identity: identity)\n531|    }\n532|\n533|    // MARK: - Remote observation\n534|\n535|    /// Best-effort GitHub sync. Offline, 401/403 and rate limits mark data\n536|    /// stale and never change local power state. Follows full pagination\n537|    /// before matching; matches by server + scope + ID, never by name.\n538|    private func refreshRemote() async {\n539|        let startedIdentity = await identities.load()\n540|        let entries = await catalog.load()\n541|        if entries.isEmpty {\n542|            await action { Runners.Action.remoteSyncFinished(self.now()) }\n543|            return\n544|        }\n545|        let auth: CatalogUserToken\n546|        do {\n547|            auth = try await currentUserToken()\n548|        } catch {\n549|            // Disconnected: local control stays fully available.\n550|            await action { Runners.Action.remoteSyncFailed(error.localizedDescription) }\n551|            return\n552|        }\n553|        // Group definitions by scope so one paginated list serves every\n554|        // runner in that scope.\n555|        var scopes: [String: (scope: RunnerRegistration.Scope, ids: [String])] = [:]\n556|        var definitions: [String: Runners.Definition] = [:]\n557|        for entry in entries {\n558|            let directory = RunnerCatalogStore.resolve(entry: entry)\n559|            let info = RunnerRegistrationReader.read(directory: directory)\n560|            guard let address = info?.gitHubURL ?? entry.serverHost.map({ \"https://\\($0)/\\(entry.scope ?? \"\")\" }),\n561|                  let scope = unregisterScope(address: address) else { continue }\n562|            // Observe only registrations on the authenticated server.\n563|            let host = URL(string: address)?.host ?? entry.serverHost ?? \"\"\n564|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(host)\n565|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else { continue }\n566|            let key = scope.scopeKey\n567|            scopes[key, default: (scope, [])].ids.append(entry.serviceLabel)\n568|            definitions[entry.serviceLabel] = LaunchAgentService.definition(from: entry)\n569|        }\n570|        var failures: [String] = []\n571|        for (_, group) in scopes {\n572|            // A logout mid-sync stops silently: no writes into a logged-out session.\n573|            let current = await identities.load()\n574|            if current == nil || current?.userID != startedIdentity?.userID\n575|                || current?.serverHost != startedIdentity?.serverHost {\n576|                return\n577|            }\n578|            do {\n579|                let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: group.scope)\n580|                for id in group.ids {\n581|                    guard let definition = definitions[id] else { continue }\n582|                    if let observation = GitHubRunnerObserver.match(definition: definition, runners: runners, now: now()) {\n583|                        await action { Runners.Action.remoteUpdated(id, GitHubRunnerObserver.withFreshness(observation, now: self.now())) }\n584|                    } else {\n585|                        await action { Runners.Action.remoteUpdated(id, Runners.RemoteObservation(\n586|                            busyKnown: false, updatedAt: self.now(), stale: false,\n587|                            syncError: \"Identity mismatch\"\n588|                        )) }\n589|                    }\n590|                }\n591|            } catch let error as RunnerRegistration.RegistrationError {\n592|                switch error {\n593|                case .unauthorized:\n594|                    await action { Runners.Action.remoteSyncFailed(RunnerRegistration.RegistrationError.unauthorized.localizedDescription) }\n595|                    return\n596|                case .rateLimited:\n597|                    failures.append(\"Rate limited; will retry.\")\n598|                case .missingPermission(let text):\n599|                    failures.append(text)\n600|                default:\n601|                    failures.append(error.localizedDescription)\n602|                }\n603|            } catch {\n604|                failures.append(error.localizedDescription)\n605|            }\n606|        }\n607|        if failures.isEmpty {\n608|            await action { Runners.Action.remoteSyncFinished(self.now()) }\n609|        } else {\n610|            let joinedFailures = failures.joined(separator: \"; \")\n611|            await action { Runners.Action.remoteSyncFailed(joinedFailures) }\n612|        }\n613|    }\n614|\n615|    // MARK: - Preferences and relink\n616|\n617|    /// Changes only the login-startup policy. Never bootstraps or bootouts;\n618|    /// the policy applies at next login. Refuses while an installer mutation\n619|    /// is live.\n620|    /// Changes only the login-start behavior. Standard manifests edit\n621|    /// their own RunAtLoad. External manual plists gain or lose a matching\n622|    /// registration in `~/Library/LaunchAgents` (RunAtLoad outside\n623|    /// LaunchAgents never persists login start). Never bootstraps or\n624|    /// bootouts: live runner state is preserved. Refuses while an installer\n625|    /// mutation is live, and never touches a foreign same-label plist.\n626|    private func setRunAtLoad(id: String, value: Bool) async {\n627|        if unregisterWorking.contains(id) || working.contains(id) {\n628|            await action { Runners.Action.catalogFailed(\"Runner is busy; retry after it settles.\") }\n629|            return\n630|        }\n631|        let entries = await catalog.load()\n632|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n633|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n634|            return\n635|        }\n636|        if entry.controllerKind == .unsupported {\n637|            await action { Runners.Action.catalogFailed(\"Unsupported runners have no Runner Control login policy.\") }\n638|            return\n639|        }\n640|        do {\n641|            let directory = RunnerCatalogStore.resolve(entry: entry)\n642|            try await installer.requireIdle(for: directory)\n643|            if entry.controllerKind == .standardLaunchAgent {\n644|                let plist = URL(fileURLWithPath: entry.servicePlistPath)\n645|                guard let data = try? Data(contentsOf: plist),\n646|                      var object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {\n647|                    throw RunnerError.message(\"Service manifest is unreadable.\")\n648|                }\n649|                object[\"RunAtLoad\"] = value\n650|                let out = try PropertyListSerialization.data(fromPropertyList: object, format: .xml, options: 0)\n651|                try out.write(to: plist, options: .atomic)\n652|                entry.runAtLoad = value\n653|                try await catalog.update(entry)\n654|            } else {\n655|                try setManualLogin(entry: entry, directory: directory, enabled: value)\n656|            }\n657|            await action { Runners.Action.catalogCleared }\n658|            let snapshots = await service.snapshots()\n659|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n660|            await action { Runners.Action.refreshed(mapped_snapshots) }\n661|        } catch {\n662|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n663|        }\n664|    }\n665|\n666|    /// Enables or disables login start for an external manual service by\n667|    /// managing its `~/Library/LaunchAgents` registration. The external\n668|    /// service file itself is never modified, so the imported policy stays\n669|    /// byte-identical; live launchd state is untouched.\n670|    private func setManualLogin(entry: RunnerCatalogStore.Entry, directory: URL, enabled: Bool) throws {\n671|        let external = URL(fileURLWithPath: entry.servicePlistPath)\n672|        guard let data = try? Data(contentsOf: external),\n673|              let object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {\n674|            throw RunnerError.message(\"Service manifest is unreadable.\")\n675|        }\n676|        let definition = LaunchAgentService.definition(from: entry)\n677|        let copy = RunnerControllers.loginRegistrationURL(label: entry.serviceLabel, home: home)\n678|        if enabled {\n679|            if let existing = try? Data(contentsOf: copy),\n680|               let current = try? PropertyListSerialization.propertyList(from: existing, format: nil) as? [String: Any] {\n681|                guard RunnerControllers.references(current, definition: definition) else {\n682|                    throw RunnerError.message(\"Login slot '\\(copy.lastPathComponent)' belongs to another service. Remove it by hand instead of overwriting.\")\n683|                }\n684|                var updated = current\n685|                updated[\"RunAtLoad\"] = true\n686|                let out = try PropertyListSerialization.data(fromPropertyList: updated, format: .xml, options: 0)\n687|                try out.write(to: copy, options: .atomic)\n688|                return\n689|            }\n690|            var registration = object\n691|            registration[\"Label\"] = entry.serviceLabel\n692|            registration[\"WorkingDirectory\"] = directory.path\n693|            registration[\"ProgramArguments\"] = [directory.appendingPathComponent(\"runsvc.sh\").path]\n694|            registration[\"RunAtLoad\"] = true\n695|            let out = try PropertyListSerialization.data(fromPropertyList: registration, format: .xml, options: 0)\n696|            try FileManager.default.createDirectory(at: copy.deletingLastPathComponent(), withIntermediateDirectories: true)\n697|            try out.write(to: copy, options: .atomic)\n698|            return\n699|        }\n700|        guard FileManager.default.fileExists(atPath: copy.path) else { return }\n701|        guard let existing = try? Data(contentsOf: copy),\n702|              let current = try? PropertyListSerialization.propertyList(from: existing, format: nil) as? [String: Any],\n703|              RunnerControllers.references(current, definition: definition) else {\n704|            throw RunnerError.message(\"Login slot '\\(copy.lastPathComponent)' belongs to another service. Remove it by hand instead of deleting.\")\n705|        }\n706|        try FileManager.default.removeItem(at: copy)\n707|    }\n708|\n709|    private func setAlias(id: String, alias: String?) async {\n710|        let entries = await catalog.load()\n711|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n712|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n713|            return\n714|        }\n715|        let trimmed = alias?.trimmingCharacters(in: .whitespacesAndNewlines)\n716|        entry.displayName = (trimmed?.isEmpty == true) ? nil : trimmed\n717|        do {\n718|            try await catalog.update(entry)\n719|            await action { Runners.Action.catalogCleared }\n720|            let snapshots = await service.snapshots()\n721|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n722|            await action { Runners.Action.refreshed(mapped_snapshots) }\n723|        } catch {\n724|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n725|        }\n726|    }\n727|\n728|    /// Relinks a moved folder. Requires the new folder to hold the same\n729|    /// agent ID so a foreign installation can never steal this entry.\n730|    /// Updates the service manifest paths, preserving RunAtLoad.\n731|    private func relink(id: String, url: URL) async {\n732|        if unregisterWorking.contains(id) || working.contains(id) {\n733|            await action { Runners.Action.catalogFailed(\"Runner is busy; retry after it settles.\") }\n734|            return\n735|        }\n736|        let entries = await catalog.load()\n737|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n738|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n739|            return\n740|        }\n741|        guard url.path != entry.directoryPath else {\n742|            await action { Runners.Action.catalogCleared }\n743|            return\n744|        }\n745|        if url.path.contains(\" \") {\n746|            await action { Runners.Action.catalogFailed(\"Path contains a space; choose a location without spaces.\") }\n747|            return\n748|        }\n749|        let canonical = RunnerCatalogStore.canonical(url)\n750|        if entries.contains(where: { $0.localID != entry.localID && $0.canonicalPath == canonical }) {\n751|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.duplicateDirectory(path: url.path).localizedDescription) }\n752|            return\n753|        }\n754|        guard let info = RunnerRegistrationReader.read(directory: url) else {\n755|            await action { Runners.Action.catalogFailed(\"Cannot read .runner in the selected folder.\") }\n756|            return\n757|        }\n758|        if let stored = entry.remoteAgentID, info.agentID != stored {\n759|            await action { Runners.Action.catalogFailed(\"Selected folder is agent \\(info.agentID.map(String.init) ?? \"unknown\"), not \\(stored). Refusing to relink a foreign installation.\") }\n760|            return\n761|        }\n762|        catalogGeneration += 1\n763|        do {\n764|            let plist = URL(fileURLWithPath: entry.servicePlistPath)\n765|            // Manual manifests move with the directory; standard manifests\n766|            // stay in LaunchAgents. Update whichever manifest this entry owns.\n767|            if plist.path.hasPrefix(entry.directoryPath) {\n768|                let moved = url.appendingPathComponent(\"manual-service.plist\")\n769|                if FileManager.default.fileExists(atPath: moved.path) {\n770|                    try await installer.updateServicePaths(plist: moved, directory: url)\n771|                    entry.servicePlistPath = moved.path\n772|                }\n773|            } else {\n774|                try await installer.updateServicePaths(plist: plist, directory: url)\n775|            }\n776|            let oldPath = entry.directoryPath\n777|            entry.directoryPath = url.path\n778|            entry.canonicalPath = canonical\n779|            entry.bookmarkBase64 = RunnerCatalogStore.bookmark(for: url)\n780|            entry.agentName = info.agentName ?? entry.agentName\n781|            entry.serverHost = info.serverHost ?? entry.serverHost\n782|            entry.scope = info.scopeDetail ?? entry.scope\n783|            entry.scopeKind = info.scopeKind ?? entry.scopeKind\n784|            entry.remoteAgentID = info.agentID ?? entry.remoteAgentID\n785|            entry.workFolder = info.workFolder ?? entry.workFolder\n786|            // Keep a managed login registration pointing at the new\n787|            // directory so relink preserves effective login. Foreign\n788|            // same-label plists are never touched.\n789|            if entry.controllerKind == .manualManaged {\n790|                let copy = RunnerControllers.loginRegistrationURL(label: entry.serviceLabel, home: home)\n791|                if let data = try? Data(contentsOf: copy),\n792|                   var current = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],\n793|                   current[\"Label\"] as? String == entry.serviceLabel,\n794|                   current[\"WorkingDirectory\"] as? String == oldPath {\n795|                    try await installer.requireIdle(for: url)\n796|                    current[\"WorkingDirectory\"] = url.path\n797|                    current[\"ProgramArguments\"] = [url.appendingPathComponent(\"runsvc.sh\").path]\n798|                    let out = try PropertyListSerialization.data(fromPropertyList: current, format: .xml, options: 0)\n799|                    try out.write(to: copy, options: .atomic)\n800|                }\n801|            }\n802|            try await catalog.update(entry)\n803|            await action { Runners.Action.catalogCleared }\n804|            let snapshots = await service.snapshots()\n805|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n806|            await action { Runners.Action.refreshed(mapped_snapshots) }\n807|        } catch {\n808|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n809|        }\n810|    }\n811|\n812|    // MARK: - Diagnostics\n813|\n814|    private func loadLog(id: String) async {\n815|        let snapshots = await service.snapshots()\n816|        guard let snapshot = snapshots.first(where: { $0.id == id }) else {\n817|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n818|            return\n819|        }\n820|        let excerpt = RunnerDiagnostics.tail(definition: snapshot.definition)\n821|        await action { Runners.Action.logLoaded(title: snapshot.definition.displayTitle, excerpt: excerpt) }\n822|    }\n823|\n824|    // MARK: - Group access (fresh API membership)\n825|\n826|    private struct VerifiedOrgRunner: Sendable {\n827|        let entry: RunnerCatalogStore.Entry\n828|        let directory: URL\n829|        let org: String\n830|        let agentID: Int64\n831|        let agentName: String\n832|    }\n833|\n834|    /// Verifies the local `.runner` identity for group reads/writes: agent\n835|    /// ID, name, server and org scope must all be present and bound to the\n836|    /// catalog entry's recorded original. Local pool fields are ignored\n837|    /// (they can lag); the group answer always comes from fresh API\n838|    /// membership below.\n839|    private func verifiedOrgRunner(id: String) async throws -> VerifiedOrgRunner {\n840|        let entries = await catalog.load()\n841|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n842|            throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n843|        }\n844|        let directory = RunnerCatalogStore.resolve(entry: entry)\n845|        guard let local = await installer.readLocalRegistration(directory: directory),\n846|              let agentID = local.agentID,\n847|              let agentName = local.agentName, !agentName.isEmpty,\n848|              let address = local.gitHubURL,\n849|              let url = URL(string: address), url.scheme == \"https\" else {\n850|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n851|                \"No verified local registration for '\\(entry.serviceLabel)'. Refusing group access for another runner.\"\n852|            )\n853|        }\n854|        let components = url.pathComponents.filter { $0 != \"/\" }\n855|        guard components.count == 1 else {\n856|            throw RunnerRegistration.RegistrationError.groupNotApplicable\n857|        }\n858|        if let stored = entry.remoteAgentID, stored != agentID {\n859|            throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n860|                \"Catalog expects agent \\(stored) but disk shows agent \\(agentID). Refusing group access for a mismatched registration.\"\n861|            )\n862|        }\n863|        // Catalog-original binding: the mutable on-disk registration must\n864|        // still agree with the server and scope recorded at import (or\n865|        // explicit relink). A scope or server edit on disk — without\n866|        // re-verification — refuses here instead of silently retargeting\n867|        // another org's group. Load and Apply both verify here, so neither\n868|        // path can drift off the catalog original between Load and Apply.\n869|        // Entries without a recorded server/scope predate this binding and\n870|        // fall through to the disk-vs-session checks below.\n871|        let diskHost = url.host ?? \"\"\n872|        if let storedHost = entry.serverHost,\n873|           RunnerRegistration.OperationIdentity.normalizeServerHost(storedHost)\n874|               != RunnerRegistration.OperationIdentity.normalizeServerHost(diskHost) {\n875|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n876|                \"Local registration server changed from '\\(storedHost)' to '\\(diskHost)' since import. Re-add the runner (or relink its moved folder) to re-verify instead of editing with stale identity.\"\n877|            )\n878|        }\n879|        if let storedScope = entry.scope, storedScope != components[0] {\n880|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n881|                \"Local registration scope changed from '\\(storedScope)' to '\\(components[0])' since import. Re-add the runner (or relink its moved folder) to re-verify instead of editing with stale identity.\"\n882|            )\n883|        }\n884|        return VerifiedOrgRunner(entry: entry, directory: directory, org: components[0], agentID: agentID, agentName: agentName)\n885|    }\n886|\n887|    /// Resolves the runner's current GitHub group by fresh API membership:\n888|    /// lists every group, then each group's runners, matching by agent ID\n889|    /// (and exact name on the matched ID). Never reads `.runner` pool\n890|    /// fields and never adopts a same-name foreign runner or group.\n891|    private func resolveFreshGroup(\n892|        org: String, agentID: Int64, agentName: String,\n893|        auth: CatalogUserToken, generation gen: Int\n894|    ) async throws -> RunnerRegistration.RunnerGroup {\n895|        let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n896|        for group in groups {\n897|            if isCatalogStale(gen) { throw CancellationError() }\n898|            let members = try await api.fetchGroupRunners(config: auth.config, token: auth.token, org: org, groupID: group.id)\n899|            if let exact = members.first(where: { $0.id == agentID }) {\n900|                guard exact.name == agentName else {\n901|                    throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n902|                        \"Group '\\(group.name)' lists agent \\(agentID) as '\\(exact.name)', not '\\(agentName)'. Refusing a mismatched group.\"\n903|                    )\n904|                }\n905|                return group\n906|            }\n907|            // A same-name foreign member in this group is ignored: only the\n908|            // exact agent ID binds membership.\n909|        }\n910|        throw RunnerRegistration.RegistrationError.remoteRunnerNotFound(\n911|            \"Agent \\(agentID) is not in any visible group for '\\(org)'. It may have been moved or the App lacks group access.\"\n912|        )\n913|    }\n914|\n915|    /// Loads fresh group + repository access for one org runner. Display and\n916|    /// later edits use this API answer, never stale `.runner` pool fields.\n917|    private func loadGroupAccess(id: String) async {\n918|        let gen = catalogGeneration\n919|        let startedIdentity = await identities.load()\n920|        await action { Runners.Action.groupAccessLoading(id) }\n921|        do {\n922|            let verified = try await verifiedOrgRunner(id: id)\n923|            let auth = try await currentUserToken()\n924|            if isCatalogStale(gen) { return }\n925|            guard let started = startedIdentity, await identities.load()?.userID == started.userID else { return }\n926|            let verifiedHost = URL(string: (await installer.readLocalRegistration(directory: verified.directory))?.gitHubURL ?? \"\")?.host ?? \"\"\n927|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n928|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n929|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n930|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost).\"\n931|                )\n932|            }\n933|            let group = try await resolveFreshGroup(\n934|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n935|                auth: auth, generation: gen\n936|            )\n937|            if isCatalogStale(gen) { return }\n938|            // Completion ownership: a logout, account or server switch\n939|            // during the membership reads refuses further authenticated\n940|            // work and any state publication into the changed session.\n941|            guard await sessionStill(startedIdentity) else { return }\n942|            let repoIDs = try await api.fetchGroupRepositories(\n943|                config: auth.config, token: auth.token, org: verified.org, groupID: group.id\n944|            )\n945|            if isCatalogStale(gen) { return }\n946|            guard await sessionStill(startedIdentity) else { return }\n947|            let owned = await installer.loadOwnedGroupID(\n948|                serverHost: auth.identity.serverHost, org: verified.org, name: group.name\n949|            ) == group.id\n950|            let access = Runners.GroupAccess(\n951|                group: group, repoIDs: repoIDs.sorted(), updatedAt: now(),\n952|                owned: owned, loading: false\n953|            )\n954|            await action { Runners.Action.groupAccessLoaded(id, access) }\n955|        } catch is CancellationError {\n956|            return\n957|        } catch {\n958|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n959|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n960|                await action { Runners.Action.groupAccessFailed(id, message) }\n961|            }\n962|        }\n963|    }\n964|\n965|    /// True when the GitHub session still matches the session this operation\n966|    /// started with. A logout, account or server switch mid-operation stops\n967|    /// silently: no writes into a changed session.\n968|    private func sessionStill(_ started: GitHubSessionIdentity?) async -> Bool {\n969|        let current = await identities.load()\n970|        guard let started else { return current == nil }\n971|        guard let current else { return false }\n972|        return current.userID == started.userID\n973|            && RunnerRegistration.OperationIdentity.normalizeServerHost(current.serverHost)\n974|                == RunnerRegistration.OperationIdentity.normalizeServerHost(started.serverHost)\n975|    }\n976|\n977|    /// Write-path identity binding for group edits. Re-reads the mutable\n978|    /// local registration and requires it to still match the verified\n979|    /// server host, org scope, agent ID and name, and requires the catalog\n980|    /// entry to still point at the verified canonical directory. A\n981|    /// same-path foreign host, a scope edit, or a relink mid-flight fails\n982|    /// instead of writing another server's group. Called after\n983|    /// authentication and re-called at the PUT boundary.\n984|    private func bindApplyIdentity(verified: VerifiedOrgRunner, auth: CatalogUserToken) async throws {\n985|        guard let reread = await installer.readLocalRegistration(directory: verified.directory),\n986|              reread.agentID == verified.agentID,\n987|              reread.agentName == verified.agentName,\n988|              let address = reread.gitHubURL,\n989|              let url = URL(string: address), url.scheme == \"https\" else {\n990|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n991|                \"Local registration changed during group apply. Reload instead of editing with stale identity.\"\n992|            )\n993|        }\n994|        let components = url.pathComponents.filter { $0 != \"/\" }\n995|        guard components.count == 1, components[0] == verified.org else {\n996|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n997|                \"Local registration scope changed during group apply. Reload instead of editing with stale identity.\"\n998|            )\n999|        }\n1000|        let verifiedHost = url.host ?? \"\"\n1001|        guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n1002|            == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n1003|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1004|                \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost). Refusing cross-server group apply.\"\n1005|            )\n1006|        }\n1007|        let canonical = RunnerCatalogStore.canonical(verified.directory)\n1008|        let current = await catalog.load()\n1009|        guard current.contains(where: { $0.localID == verified.entry.localID && $0.canonicalPath == canonical }) else {\n1010|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1011|                \"Catalog entry changed during group apply. Reload instead of editing another entry's group.\"\n1012|            )\n1013|        }\n1014|    }\n1015|\n1016|    /// Applies edited repository access to the runner's fresh group. Rejects\n1017|    /// stale UI (group moved since load), shared groups without explicit\n1018|    /// takeover, and partial confirmations. Binds server+scope+agentID+\n1019|    /// canonical service identity on this write path — verified against the\n1020|    /// catalog original, never assumed from an earlier Load — and preserves\n1021|    /// that binding plus the starting session over every asynchronous\n1022|    /// boundary through confirmation and publication. Reuses the\n1023|    /// registration ownership and confirmation gates; API-only, no\n1024|    /// installer lease.\n1025|    private func applyGroupAccess(id: String, groupID: Int64, repos: Set<Int64>, allowTakeover: Bool) async {\n1026|        let gen = catalogGeneration\n1027|        let startedIdentity = await identities.load()\n1028|        await action { Runners.Action.groupAccessLoading(id) }\n1029|        do {\n1030|            let verified = try await verifiedOrgRunner(id: id)\n1031|            let auth = try await currentUserToken()\n1032|            if isCatalogStale(gen) { return }\n1033|            guard await sessionStill(startedIdentity) else { return }\n1034|            try await bindApplyIdentity(verified: verified, auth: auth)\n1035|            // Fresh membership re-verified at write time: a move since the\n1036|            // UI loaded fails instead of editing the wrong group.\n1037|            let fresh = try await resolveFreshGroup(\n1038|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n1039|                auth: auth, generation: gen\n1040|            )\n1041|            guard fresh.id == groupID else {\n1042|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1043|                    \"Runner moved from group \\(groupID) to '\\(fresh.name)' (\\(fresh.id)) since loading. Reload instead of editing a stale group.\"\n1044|                )\n1045|            }\n1046|            if isCatalogStale(gen) { return }\n1047|            let owned = await installer.loadOwnedGroupID(\n1048|                serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name\n1049|            )\n1050|            try RunnerRegistration.Gates.authorizeGroupTakeover(\n1051|                groupName: fresh.name, existingID: fresh.id,\n1052|                ownedID: owned, allowTakeover: allowTakeover\n1053|            )\n1054|            if owned != fresh.id {\n1055|                try await installer.saveOwnedGroupID(\n1056|                    serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name, groupID: fresh.id\n1057|                )\n1058|            }\n1059|            if isCatalogStale(gen) { return }\n1060|            // Re-bind at the PUT boundary: the membership and ownership\n1061|            // awaits above must not carry stale identity into the write.\n1062|            guard await sessionStill(startedIdentity) else { return }\n1063|            try await bindApplyIdentity(verified: verified, auth: auth)\n1064|            try await api.setGroupRepositories(\n1065|                config: auth.config, token: auth.token, org: verified.org,\n1066|                groupID: fresh.id, selectedRepositoryIDs: repos\n1067|            )\n1068|            if isCatalogStale(gen) { return }\n1069|            // Completion ownership: the issued PUT cannot be undone, but a\n1070|            // logout, account or server switch after it refuses the\n1071|            // confirmation read and any state publication into the changed\n1072|            // session.\n1073|            guard await sessionStill(startedIdentity) else { return }\n1074|            let confirmed = try await api.fetchGroupRepositories(\n1075|                config: auth.config, token: auth.token, org: verified.org, groupID: fresh.id\n1076|            )\n1077|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: repos, confirmed: confirmed)\n1078|            if isCatalogStale(gen) { return }\n1079|            guard await sessionStill(startedIdentity) else { return }\n1080|            let access = Runners.GroupAccess(\n1081|                group: fresh, repoIDs: confirmed.sorted(), updatedAt: now(),\n1082|                owned: true, loading: false\n1083|            )\n1084|            await action { Runners.Action.groupAccessLoaded(id, access) }\n1085|            await action { Runners.Action.catalogCleared }\n1086|        } catch is CancellationError {\n1087|            return\n1088|        } catch {\n1089|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n1090|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n1091|                await action { Runners.Action.groupAccessFailed(id, message) }\n1092|            }\n1093|        }\n1094|    }\n1095|}\n1096|\n1097|/// Import gates. Each gate refuses a concrete invalid class; negative tests\n1098|/// narrow every one of them.\n1099|public enum RunnersCatalogGates {\n1100|    public static func validateImportable(_ candidate: RunnerDiscovery.Candidate) throws {\n1101|        if candidate.controllerKind == .unsupported || candidate.unsupportedReason != nil {\n1102|            throw RunnerError.unsupported(candidate.unsupportedReason ?? \"Unsupported management.\")\n1103|        }\n1104|        if !candidate.registrationReadable {\n1105|            throw RunnerError.message(\"Cannot read .runner registration.\")\n1106|        }\n1107|        if candidate.agentName == nil || candidate.agentName?.isEmpty == true {\n1108|            throw RunnerError.message(\"Registration name is missing.\")\n1109|        }\n1110|        if candidate.serverHost == nil || candidate.scope == nil {\n1111|            throw RunnerError.message(\"Server or scope is undefined.\")\n1112|        }\n1113|        if !candidate.noSpacePath || !candidate.noSpaceWork {\n1114|            throw RunnerError.noSpacePath(\"Path or work folder contains a space; relocation is required.\")\n1115|        }\n1116|        if !candidate.runsvcExists || !candidate.binaryExists {\n1117|            throw RunnerError.message(\"Runner binaries are missing (run.sh / runsvc.sh).\")\n1118|        }\n1119|        if candidate.manifest == nil {\n1120|            // Folder imports without a manifest create a service; every other\n1121|            // check above must already have passed.\n1122|            return\n1123|        }\n1124|        if !candidate.manifestMatches {\n1125|            throw RunnerError.manifestMismatch(\"Service manifest does not match the runner directory.\")\n1126|        }\n1127|        if !candidate.issues.isEmpty {\n1128|            // Issues beyond the manifest notice (folder imports) refuse.\n1129|            let blocking = candidate.issues.filter { !$0.contains(\"No service manifest\") }\n1130|            if !blocking.isEmpty {\n1131|                throw RunnerError.message(blocking.joined(separator: \" \"))\n1132|            }\n1133|        }\n1134|    }\n1135|}","final_result":true}}}
