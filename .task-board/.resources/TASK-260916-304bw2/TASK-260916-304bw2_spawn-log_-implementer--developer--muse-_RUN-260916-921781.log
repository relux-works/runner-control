r { try? FileManager.default.removeItem(at: harness.home) }\n994|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"real-name\", label: \"actions.runner.test.alias\")\n995|    let entry = RunnerCatalogStore.Entry(\n996|        directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n997|        serviceLabel: \"actions.runner.test.alias\",\n998|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n999|        controllerKind: .manualManaged, agentName: \"real-name\"\n1000|    )\n1001|    try await harness.catalog.add(entry)\n1002|    let localID = entry.localID\n1003|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.setAlias(\"actions.runner.test.alias\", \"My CI\"))\n1004|    let loaded = await harness.catalog.load()\n1005|    #expect(loaded.first?.displayName == \"My CI\")\n1006|    #expect(loaded.first?.localID == localID)\n1007|    #expect(loaded.first?.agentName == \"real-name\")\n1008|    let definition = Runners.Definition(\n1009|        id: \"actions.runner.test.alias\", title: \"real-name\", detail: \"acme\",\n1010|        directory: dir, githubURL: URL(string: \"https://github.com/acme\")!,\n1011|        displayName: \"My CI\"\n1012|    )\n1013|    #expect(definition.displayTitle == \"My CI\")\n1014|}\n1015|\n1016|// MARK: - Direct gate narrowing (mutant targets)\n1017|\n1018|@Test func importGateRefusesSpacedPathDirectly() {\n1019|    // Crafted candidate isolates the explicit no-space check from the generic\n1020|    // issues check: spaced path, empty issues, every other check valid.\n1021|    let dir = URL(fileURLWithPath: \"/tmp/spaced root/runner\")\n1022|    let candidate = RunnerDiscovery.Candidate(\n1023|        directory: dir,\n1024|        manifest: dir.appendingPathComponent(\"manual-service.plist\"),\n1025|        label: \"actions.runner.test.x\",\n1026|        controllerKind: .manualManaged,\n1027|        agentName: \"r\", scope: \"acme\", serverHost: \"github.com\",\n1028|        agentID: 1, workFolder: \"_work\", runAtLoad: false,\n1029|        runsvcExists: true, binaryExists: true,\n(more lines below)","final_result":true}}}
