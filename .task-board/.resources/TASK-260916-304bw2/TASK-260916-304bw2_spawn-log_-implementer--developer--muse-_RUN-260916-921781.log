{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c76f","stream":{"kind":"session","id":"01a0a9c5-2eb3-7902-83b0-77aeb115d140"},"sequence":530,"recorded_at":1780531400001055,"record_type":"event","durability":"durable","causation_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","run_stream":{"kind":"run","id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246"},"task_stream":{"kind":"task","id":"01a0a9c6-6dce-74a2-a8b4-560c3b77d47f"},"task_id":"01a0a9c6-6dce-74a2-a8b4-560c3b77d47f","event":{"kind":"output","task_id":"01a0a9c6-6dce-74a2-a8b4-560c3b77d47f","chunk":"Read text file `/Users/iv/Documents/Codex/2026-09-15/new-chat-4/outputs/RunnerControl/.temp/STORY-260916-36d1jg/worktree/Packages/RunnerControlCore/Sources/Runners+Service.swift`.\n1|import Foundation\n2|public protocol RunnerServicing: Sendable {\n3|    func snapshots() async -> [Runners.Snapshot]\n4|    func setEnabled(_ enabled: Bool, id: String) async throws\n5|}\n6|public actor LaunchAgentService: RunnerServicing {\n7|    private let fixedDefinitions: [Runners.Definition]?\n8|    private let catalog: RunnerCatalogStore?\n9|    private let executor: any CommandExecuting\n10|    private let domain: String\n11|    private let home: URL\n12|    public init(definitions: [Runners.Definition] = Runners.Definition.installed(), executor: any CommandExecuting = CommandExecutor(), userID: UInt32 = getuid(), home: URL = FileManager.default.homeDirectoryForCurrentUser) {\n13|        self.fixedDefinitions = definitions; self.catalog = nil; self.executor = executor; domain = \"gui/\\(userID)\"; self.home = home\n14|    }\n15|    /// Catalog-backed service. Snapshots always reflect the current catalog;\n16|    /// fixed definitions are used only when no catalog is supplied (tests).\n17|    public init(catalog: RunnerCatalogStore, executor: any CommandExecuting = CommandExecutor(), userID: UInt32 = getuid(), home: URL = FileManager.default.homeDirectoryForCurrentUser) {\n18|        self.fixedDefinitions = nil; self.catalog = catalog; self.executor = executor; domain = \"gui/\\(userID)\"; self.home = home\n19|    }\n20|    public static func status(from result: CommandResult) -> Runners.Status {\n21|        if result.code == 0 { return result.output.contains(\"state = running\") ? .running : .failed }\n22|        if result.code == 113 && result.output.contains(\"Could not find service\") { return .stopped }\n23|        return .unknown\n24|    }\n25|    private func currentDefinitions() async -> [Runners.Definition] {\n26|        if let catalog {\n27|            let entries = await catalog.load()\n28|            return entries.map { Self.definition(from: $0) }\n29|        }\n30|        return fixedDefinitions ?? []\n31|    }\n32|    /// Builds a definition from a catalog entry, resolving the stored\n33|    /// bookmark when present and refreshing the RunAtLoad policy from disk\n34|    /// so the UI always shows the preserved policy, never a stale copy.\n35|    static func definition(from entry: RunnerCatalogStore.Entry) -> Runners.Definition {\n36|        let directory = RunnerCatalogStore.resolve(entry: entry)\n37|        let plist = URL(fileURLWithPath: entry.servicePlistPath)\n38|        let runAtLoad: Bool? = {\n39|            guard let data = try? Data(contentsOf: plist),\n40|                  let object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {\n41|                return entry.runAtLoad\n42|            }\n43|            return (object[\"RunAtLoad\"] as? Bool) ?? entry.runAtLoad\n44|        }()\n45|        let githubURL: URL = {\n46|            if let host = entry.serverHost, let scope = entry.scope, let kind = entry.scopeKind {\n47|                let base = host == \"github.com\" ? \"https://github.com\" : \"https://\\(host)\"\n48|                let path = kind == \"org\" ? \"/organizations/\\(scope)/settings/actions/runners\" : \"/\\(scope)/settings/actions/runners\"\n49|                if let url = URL(string: base + path) { return url }\n50|            }\n51|            return URL(string: \"https://github.com\")!\n52|        }()\n53|        return Runners.Definition(\n54|            id: entry.serviceLabel, title: entry.agentName ?? directory.lastPathComponent,\n55|            detail: entry.scope ?? \"\", directory: directory, githubURL: githubURL,\n56|            servicePlist: plist, localID: entry.localID,\n57|            controllerKind: entry.controllerKind, runAtLoad: runAtLoad,\n58|            displayName: entry.displayName, serverHost: entry.serverHost,\n59|            remoteAgentID: entry.remoteAgentID, workFolder: entry.workFolder\n60|        )\n61|    }\n62|    private func validate(_ definition: Runners.Definition) throws {\n63|        try RunnerControllers.validateForStart(definition)\n64|    }\n65|    public func snapshots() async -> [Runners.Snapshot] {\n66|        let definitions = await currentDefinitions()\n67|        let now = Date()\n68|        let home = self.home\n69|        var values: [Runners.Snapshot] = []\n70|        for raw in definitions {\n71|            // Effective login is computed per snapshot so the toggle always\n72|            // reflects real login behavior, never a stale copy.\n73|            let d = raw.withLoginEnabled(RunnerControllers.effectiveLogin(raw, home: home))\n74|            // Unsupported entries are still inspected via launchctl so a\n75|            // running foreign service is visible; control stays refused.\n76|            if d.controllerKind == .unsupported {\n77|                do {\n78|                    let result = try await executor.run(\"/bin/launchctl\", [\"print\", domain + \"/\" + d.id])\n79|                    let status = Self.status(from: result)\n80|                    let reason = \"Unsupported management: control it with its own supervisor.\"\n81|                    let message = status == .unknown ? String(result.output.prefix(300)) : reason\n82|                    values.append(.init(definition: d, status: status, message: message, observedAt: now))\n83|                } catch {\n84|                    values.append(.init(definition: d, status: .unknown, message: error.localizedDescription, observedAt: now))\n85|                }\n86|                continue\n87|            }\n88|            // Print first so a missing registration or damaged manifest never\n89|            // hides a running service and its Stop.\n90|            let printed: CommandResult?\n91|            do {\n92|                printed = try await executor.run(\"/bin/launchctl\", [\"print\", domain + \"/\" + d.id])\n93|            } catch {\n94|                values.append(.init(definition: d, status: .unknown, message: error.localizedDescription, observedAt: now))\n95|                continue\n96|            }\n97|            let launchStatus = Self.status(from: printed!)\n98|            do {\n99|                try validate(d)\n100|                let message = launchStatus == .unknown ? String(printed!.output.prefix(300)) : nil\n101|                values.append(.init(definition: d, status: launchStatus, message: message, observedAt: now))\n102|            } catch {\n103|                // A running service stays visible (and stoppable) even when\n104|                // registration or manifest is damaged.\n105|                if launchStatus == .running {\n106|                    values.append(.init(definition: d, status: .running, message: error.localizedDescription, observedAt: now))\n107|                } else if let runnerError = error as? RunnerError, case .noSpacePath = runnerError {\n108|                    values.append(.init(definition: d, status: .needsSetup, message: error.localizedDescription, observedAt: now))\n109|                } else {\n110|                    values.append(.init(definition: d, status: .missing, message: error.localizedDescription, observedAt: now))\n111|                }\n112|            }\n113|        }\n114|        return values\n115|    }\n116|    public func setEnabled(_ enabled: Bool, id: String) async throws {\n117|        let definitions = await currentDefinitions()\n118|        guard let d = definitions.first(where: { $0.id == id }) else { throw RunnerError.message(\"Неизвестный раннер.\") }\n119|        if d.controllerKind == .unsupported {\n120|            throw RunnerError.unsupported(\"Runner «\\(d.displayTitle)» uses unsupported management. Control it with its own supervisor instead of Runner Control.\")\n121|        }\n122|        // Stop must remain possible even if someone damages registration/plist.\n123|        if enabled { try validate(d) }\n124|        let key = domain + \"/\" + d.id\n125|        let current = try await executor.run(\"/bin/launchctl\", [\"print\", key])\n126|        let state = Self.status(from: current)\n127|        if !enabled && state == .stopped || enabled && state == .running { return }\n128|        guard state != .unknown else { throw RunnerError.message(String(current.output.prefix(500))) }\n129|        if enabled && state == .failed {\n130|            let removed = try await executor.run(\"/bin/launchctl\", [\"bootout\", key])\n131|            guard removed.code == 0 else { throw RunnerError.message(removed.output) }\n132|        }\n133|        let result = try await executor.run(\"/bin/launchctl\", enabled ? [\"bootstrap\", domain, d.plist.path] : [\"bootout\", key])\n134|        guard result.code == 0 else { throw RunnerError.message(String(result.output.prefix(700))) }\n135|        for _ in 0..<30 {\n136|            let result = try await executor.run(\"/bin/launchctl\", [\"print\", key])\n137|            if Self.status(from: result) == (enabled ? .running : .stopped) { return }\n138|            try await Task.sleep(for: .milliseconds(100))\n139|        }\n140|        throw RunnerError.message(\"Не удалось подтвердить остановку. Проверьте журнал раннера и повторите проверку.\")\n141|    }\n142|}","final_result":true}}}
