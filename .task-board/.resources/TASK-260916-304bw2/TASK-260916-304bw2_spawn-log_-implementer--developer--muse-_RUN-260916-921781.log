{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e1","stream":{"kind":"session","id":"01a0a9c5-2eb3-7902-83b0-77aeb115d140"},"sequence":459,"recorded_at":1780531400000913,"record_type":"event","durability":"durable","causation_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","run_stream":{"kind":"run","id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246"},"task_stream":{"kind":"task","id":"01a0a9c6-4d38-7292-b908-6f8307c5ba90"},"task_id":"01a0a9c6-4d38-7292-b908-6f8307c5ba90","event":{"kind":"output","task_id":"01a0a9c6-4d38-7292-b908-6f8307c5ba90","chunk":"Read text file `/Users/iv/Documents/Codex/2026-09-15/new-chat-4/outputs/RunnerControl/.temp/STORY-260916-36d1jg/worktree/Targets/RunnerControl/Sources/ManagementWindowContainer.swift`.\n1|import AppKit\n2|import SwiftUI\n3|import RunnerControlCore\n4|\n5|/// Management window composition root. Reads Relux state, dispatches production effects.\n6|struct ManagementWindowContainer: View {\n7|    @ObservedObject var runners: Runners.State\n8|    @ObservedObject var github: GitHubAuth.State\n9|    @ObservedObject var registration: RunnerRegistration.State\n10|    @ObservedObject private var updater = AppRegistry.updater\n11|    @StateObject private var launchAtLogin = LaunchAtLoginModel()\n12|    @State private var serverHostText: String = \"github.com\"\n13|    @State private var showRegistration = false\n14|\n15|    var body: some View {\n16|        ManagementWindowPage(\n17|            props: .init(\n18|                runners: .init(\n19|                    snapshots: runners.runners,\n20|                    changing: runners.changing,\n21|                    runnerError: runners.lastError,\n22|                    candidates: runners.candidates,\n23|                    catalogError: runners.catalogError,\n24|                    selectedID: runners.selectedID,\n25|                    unregistering: runners.unregistering,\n26|                    remoteSyncError: runners.remoteSyncError,\n27|                    lastRemoteSync: runners.lastRemoteSync,\n28|                    logPreviewTitle: runners.logPreviewTitle,\n29|                    logPreview: runners.logPreview,\n30|                    groupAccess: runners.groupAccess,\n31|                    candidateRepositories: github.repositories,\n32|                    installations: github.installations,\n33|                    selectedInstallationID: github.selectedInstallationID\n34|                ),\n35|                github: .init(\n36|                    connection: github.connection,\n37|                    username: github.username,\n38|                    serverHost: github.serverHost,\n39|                    serverHostText: serverHostText,\n40|                    installations: github.installations,\n41|                    selectedInstallationID: github.selectedInstallationID,\n42|                    repositories: github.repositories,\n43|                    selectedRepositoryIDs: github.selectedRepositoryIDs,\n44|                    syncError: github.syncError,\n45|                    lastSyncAt: github.lastSyncAt\n46|                ),\n47|                general: .init(\n48|                    appVersion: Bundle.main.object(forInfoDictionaryKey: \"CFBundleShortVersionString\") as? String ?? \"—\",\n49|                    canCheckForUpdates: updater.canCheckForUpdates,\n50|                    automaticChecks: updater.automaticallyChecks,\n51|                    automaticDownloads: updater.automaticallyDownloads,\n52|                    launchAtLoginEnabled: launchAtLogin.enabled\n53|                )\n54|            ),\n55|            reactions: .init(\n56|                setEnabled: change,\n57|                enableAll: enableAll,\n58|                disableAll: { confirmStop(ids: runners.runners.filter { $0.definition.controllerKind.canControl }.map(\\.id)) },\n59|                openGitHub: { NSWorkspace.shared.open($0.githubURL) },\n60|                openLogs: openLogs,\n61|                showDirectory: { NSWorkspace.shared.open($0.directory) },\n62|                clearRunnerError: { Task { await action { Runners.Action.clearError } } },\n63|                openRegistration: { showRegistration = true },\n64|                discover: { Task { await action { Runners.Effect.discover } } },\n65|                importCandidate: { candidate in Task { await action { Runners.Effect.importCandidate(candidate) } } },\n66|                importFolder: chooseFolder,\n67|                removeFromApp: confirmRemove,\n68|                unregister: confirmUnregister,\n69|                setRunAtLoad: { id, value in Task { await action { Runners.Effect.setRunAtLoad(id, value) } } },\n70|                renameRunner: renameRunner,\n71|                relink: chooseRelink,\n72|                selectRunner: { id in Task { await action { Runners.Effect.selectRunner(id) } } },\n73|                loadLog: { id in Task { await action { Runners.Effect.loadLog(id) } } },\n74|                clearLog: { Task { await action { Runners.Effect.clearLog } } },\n75|                clearCatalogError: { Task { await action { Runners.Action.catalogCleared } } },\n76|                refreshRemote: { Task { await action { Runners.Effect.refreshRemote } } },\n77|                loadGroupAccess: { id in Task { await action { Runners.Effect.loadGroupAccess(id) } } },\n78|                applyGroupAccess: applyGroupAccess,\n79|                serverHostChanged: { serverHostText = $0 },\n80|                beginLogin: beginLogin,\n81|                cancelLogin: { Task { await action { GitHubAuth.Effect.cancelLogin } } },\n82|                logout: { Task { await action { GitHubAuth.Effect.logout } } },\n83|                openVerification: { NSWorkspace.shared.open($0) },\n84|                copyCode: copyCode,\n85|                refreshInstallations: { Task { await action { GitHubAuth.Effect.refreshInstallations } } },\n86|                selectInstallation: { id in Task { await action { GitHubAuth.Effect.selectInstallation(id) } } },\n87|                selectRepositories: { ids in Task { await action { GitHubAuth.Effect.selectRepositories(ids) } } },\n88|                grantAccess: { NSWorkspace.shared.open(URL(string: \"https://github.com/settings/installations\")!) },\n89|                revokeInGitHub: { NSWorkspace.shared.open(URL(string: \"https://github.com/settings/connections/applications\")!) },\n90|                checkForUpdates: updater.check,\n91|                setAutomaticChecks: updater.setAutomaticChecks,\n92|                setAutomaticDownloads: updater.setAutomaticDownloads,\n93|                setLaunchAtLogin: { launchAtLogin.setEnabled($0) },\n94|                quit: quit\n95|            )\n96|        )\n97|        .sheet(isPresented: $showRegistration) {\n98|            RunnerRegistrationContainer(\n99|                registration: registration,\n100|                github: github,\n101|                close: {\n102|                    showRegistration = false\n103|                    Task {\n104|                        await action { Runners.Effect.loadCatalog }\n105|                        await action { Runners.Effect.discover }\n106|                    }\n107|                }\n108|            )\n109|        }\n110|    }\n111|\n112|    private func beginLogin() {\n113|        let host = serverHostText.trimmingCharacters(in: .whitespacesAndNewlines)\n114|        let value = host.isEmpty ? nil : host\n115|        Task { await action { GitHubAuth.Effect.beginLogin(serverHost: value) } }\n116|    }\n117|\n118|    private func copyCode(_ code: String) {\n119|        NSPasteboard.general.clearContents()\n120|        NSPasteboard.general.setString(code, forType: .string)\n121|    }\n122|\n123|    private func enableAll() {\n124|        let ids = runners.runners.filter {\n125|            $0.definition.controllerKind.canControl && [.stopped, .failed].contains($0.status)\n126|        }.map(\\.id)\n127|        guard !ids.isEmpty else { return }\n128|        Task { await action { Runners.Effect.setEnabledMany(ids, true) } }\n129|    }\n130|\n131|    private func change(_ id: String, _ enabled: Bool) {\n132|        if enabled { Task { await action { Runners.Effect.setEnabled(id, true) } } }\n133|        else { confirmStop(ids: [id]) }\n134|    }\n135|\n136|    private func openLogs(_ definition: Runners.Definition) {\n137|        let files = RunnerDiagnostics.logFiles(definition: definition)\n138|        if let first = files.first {\n139|            NSWorkspace.shared.open(first)\n140|        } else {\n141|            NSWorkspace.shared.open(definition.logs)\n142|        }\n143|    }\n144|\n145|    private func confirmStop(ids: [String]) {\n146|        let targets = runners.runners.filter { ids.contains($0.id) && $0.status == .running }\n147|        guard !targets.isEmpty else {\n148|            if !ids.isEmpty {\n149|                let copy = ids\n150|                Task { await action { Runners.Effect.setEnabledMany(copy, false) } }\n151|            }\n152|            return\n153|        }\n154|        let alert = NSAlert()\n155|        if targets.count == 1, let only = targets.first {\n156|            let busy = only.remote?.busy == true && (only.remote?.busyKnown == true) && !(only.remote?.stale ?? true)\n157|            alert.messageText = busy ? \"На раннере выполняется задача\" : \"Выключить CI?\"\n158|            alert.informativeText = Runners.StopConfirmation.message(remote: only.remote, runnerTitle: only.definition.displayTitle)\n159|            alert.addButton(withTitle: \"Оставить включённым\")\n160|            alert.addButton(withTitle: busy ? \"Прервать и выключить\" : \"Выключить\")\n161|        } else {\n162|            alert.messageText = \"Выключить \\(targets.count) раннеров?\"\n163|            let names = targets.map(\\.definition.displayTitle).joined(separator: \", \")\n164|            alert.informativeText = \"Будут остановлены: \\(names). Если какой-то раннер выполняет сборку, она будет прервана.\"\n165|            alert.addButton(withTitle: \"Отмена\")\n166|            alert.addButton(withTitle: \"Выключить все\")\n167|        }\n168|        guard alert.runModal() == .alertSecondButtonReturn else { return }\n169|        let copy = ids\n170|        Task { await action { Runners.Effect.setEnabledMany(copy, false) } }\n171|    }\n172|\n173|    private func chooseFolder() {\n174|        let panel = NSOpenPanel()\n175|        panel.canChooseFiles = false\n176|        panel.canChooseDirectories = true\n177|        panel.allowsMultipleSelection = false\n178|        panel.message = \"Выберите папку существующего раннера\"\n179|        guard panel.runModal() == .OK, let url = panel.url else { return }\n180|        Task { await action { Runners.Effect.importFolder(url) } }\n181|    }\n182|\n183|    private func confirmRemove(id: String) {\n184|        guard let snapshot = runners.runners.first(where: { $0.id == id }) else { return }\n185|        let alert = NSAlert()\n186|        alert.messageText = \"Убрать «\\(snapshot.definition.displayTitle)» из приложения?\"\n187|        var text = \"Удаляется только запись каталога. Файлы, регистрация GitHub и сертификаты не затрагиваются.\"\n188|        if snapshot.status == .running {\n189|            text += \" Служба продолжит работать.\"\n190|        }\n191|        alert.informativeText = text\n192|        alert.addButton(withTitle: \"Отмена\")\n193|        alert.addButton(withTitle: \"Убрать\")\n194|        guard alert.runModal() == .alertSecondButtonReturn else { return }\n195|        Task { await action { Runners.Effect.removeFromApp(id) } }\n196|    }\n197|\n198|    private func confirmUnregister(id: String) {\n199|        guard let snapshot = runners.runners.first(where: { $0.id == id }) else { return }\n200|        let definition = snapshot.definition\n201|        if snapshot.status == .running {\n202|            let alert = NSAlert()\n203|            alert.messageText = \"Сначала остановите раннер\"\n204|            alert.informativeText = \"Удаление из GitHub отказывается прерывать работающую службу. Остановите «\\(definition.displayTitle)», затем повторите.\"\n205|            alert.addButton(withTitle: \"Понятно\")\n206|            alert.runModal()\n207|            return\n208|        }\n209|        // Stopped-only: an unconfirmed state (unknown, failed, transitional)\n210|        // never reaches the typed confirmation. The flow re-checks anyway.\n211|        guard snapshot.status == .stopped else {\n212|            let alert = NSAlert()\n213|            alert.messageText = \"Состояние службы не подтверждено\"\n214|            alert.informativeText = \"«\\(definition.displayTitle)»: \\(snapshot.status.title). Удаление из GitHub требует подтверждённой остановки — сначала остановите службу и дождитесь статуса «Выключен».\"\n215|            alert.addButton(withTitle: \"Понятно\")\n216|            alert.runModal()\n217|            return\n218|        }\n219|        let alert = NSAlert()\n220|        alert.messageText = \"Удалить раннер из GitHub?\"\n221|        let scope = definition.detail.isEmpty ? \"—\" : definition.detail\n222|        let agent = definition.remoteAgentID.map(String.init) ?? \"—\"\n223|        alert.informativeText = \"Scope: \\(scope). Agent ID: \\(agent). Введите имя раннера «\\(definition.title)» для подтверждения. Файлы и служба останутся для перерегистрации.\"\n224|        let field = NSTextField(frame: NSRect(x: 0, y: 0, width: 260, height: 24))\n225|        field.placeholderString = definition.title\n226|        alert.accessoryView = field\n227|        alert.addButton(withTitle: \"Отмена\")\n228|        alert.addButton(withTitle: \"Удалить из GitHub\")\n229|        alert.window.initialFirstResponder = field\n230|        guard alert.runModal() == .alertSecondButtonReturn else { return }\n231|        let confirmation = field.stringValue\n232|        Task { await action { Runners.Effect.unregister(id, confirmation: confirmation) } }\n233|    }\n234|\n235|    private func renameRunner(id: String) {\n236|        guard let snapshot = runners.runners.first(where: { $0.id == id }) else { return }\n237|        let alert = NSAlert()\n238|        alert.messageText = \"Псевдоним раннера\"\n239|        alert.informativeText = \"Регистрационное имя «\\(snapshot.definition.title)» не меняется. Пустое поле убирает псевдоним.\"\n240|        let field = NSTextField(frame: NSRect(x: 0, y: 0, width: 260, height: 24))\n241|        field.stringValue = snapshot.definition.displayName ?? \"\"\n242|        field.placeholderString = snapshot.definition.title\n243|        alert.accessoryView = field\n244|        alert.addButton(withTitle: \"Отмена\")\n245|        alert.addButton(withTitle: \"Сохранить\")\n246|        alert.window.initialFirstResponder = field\n247|        guard alert.runModal() == .alertSecondButtonReturn else { return }\n248|        let value = field.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)\n249|        Task { await action { Runners.Effect.setAlias(id, value.isEmpty ? nil : value) } }\n250|    }\n251|\n252|    private func applyGroupAccess(id: String, repos: Set<Int64>) {\n253|        guard let access = runners.groupAccess[id], let group = access.group else { return }\n254|        if !access.owned {\n255|            let alert = NSAlert()\n256|            alert.messageText = \"Принять группу «\\(group.name)»?\"\n257|            alert.informativeText = \"Группа общая или импортированная: правки затрагивают все раннеры в ней. Принятие записывает её как выделенную группу этого Mac на этом сервере, затем применяет \\(repos.count) репозиториев.\"\n258|            alert.addButton(withTitle: \"Отмена\")\n259|            alert.addButton(withTitle: \"Принять и применить\")\n260|            guard alert.runModal() == .alertSecondButtonReturn else { return }\n261|            Task { await action { Runners.Effect.applyGroupAccess(id, groupID: group.id, repositories: repos, allowTakeover: true) } }\n262|            return\n263|        }\n264|        let alert = NSAlert()\n265|        alert.messageText = \"Применить доступ к группе «\\(group.name)»?\"\n266|        alert.informativeText = \"Будет установлено \\(repos.count) репозиториев для группы id \\(group.id). Затрагивает все раннеры в группе.\"\n267|        alert.addButton(withTitle: \"Отмена\")\n268|        alert.addButton(withTitle: \"Применить\")\n269|        guard alert.runModal() == .alertSecondButtonReturn else { return }\n270|        Task { await action { Runners.Effect.applyGroupAccess(id, groupID: group.id, repositories: repos, allowTakeover: false) } }\n271|    }\n272|\n273|    private func chooseRelink(id: String) {\n274|        let panel = NSOpenPanel()\n275|        panel.canChooseFiles = false\n276|        panel.canChooseDirectories = true\n277|        panel.allowsMultipleSelection = false\n278|        panel.message = \"Выберите перемещённую папку раннера\"\n279|        guard panel.runModal() == .OK, let url = panel.url else { return }\n280|        Task { await action { Runners.Effect.relinkDirectory(id, url) } }\n281|    }\n282|\n283|    private func quit() {\n284|        guard runners.changing.isEmpty else { return }\n285|        if runners.runners.contains(where: { $0.status == .running || $0.status == .failed || $0.status == .unknown }) {\n286|            let alert = NSAlert()\n287|            alert.messageText = \"Закрыть Runner Control?\"\n288|            alert.informativeText = \"Включённые раннеры продолжат работать в фоне. Для остановки CI сначала нажмите «Выключить все».\"\n289|            alert.addButton(withTitle: \"Остаться\")\n290|            alert.addButton(withTitle: \"Закрыть приложение\")\n291|            guard alert.runModal() == .alertSecondButtonReturn else { return }\n292|        }\n293|        NSApp.terminate(nil)\n294|    }\n295