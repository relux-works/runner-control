    return\n565|        } catch {\n566|            guard !isStale(gen) else { return }\n567|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n568|            return\n569|        }\n570|        do {\n571|            let repos = try await api.fetchRepositories(config: sess.config, token: token, installationID: id)\n572|            guard !isStale(gen) else { return }\n573|            await action { GitHubAuth.Action.repositoriesLoaded(installationID: id, repositories: repos) }\n574|            guard !isStale(gen) else { return }\n575|            await action { GitHubAuth.Action.syncSucceeded(now()) }\n576|        } catch is CancellationError {\n577|            return\n578|        } catch let error as GitHubAuth.AuthError {\n579|            guard !isStale(gen) else { return }\n580|            switch error {\n581|            case .unauthorized, .revoked:\n582|                await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .relogin) }\n583|            default:\n584|                await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n585|            }\n586|        } catch {\n587|            guard !isStale(gen) else { return }\n588|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n589|        }\n590|    }\n591|\n592|    private nonisolated static func retryKind(for error: GitHubAuth.AuthError) -> GitHubAuth.RetryKind {\n593|        switch error {\n594|        case .denied, .codeExpired: .newCode\n595|        case .unauthorized, .revoked, .tokenRefreshFailed: .relogin\n596|        case .forbidden, .needsApproval, .needsInstallation: .grantAccess\n597|        case .ssoRequired, .missingClientID, .patNotSupported: .none\n598|        case .cancelled: .none\n599|        case .network, .rateLimited, .slowDown, .authorizationPending: .retry\n600|        }\n601|    }\n602|}","correlation_facts":{"tool_name":"read_file","outco