opeKind = info.scopeKind ?? entry.scopeKind\n782|            entry.remoteAgentID = info.agentID ?? entry.remoteAgentID\n783|            entry.workFolder = info.workFolder ?? entry.workFolder\n784|            // Keep a managed login registration pointing at the new\n785|            // directory so relink preserves effective login. Foreign\n786|            // same-label plists are never touched.\n787|            if entry.controllerKind == .manualManaged {\n788|                let copy = RunnerControllers.loginRegistrationURL(label: entry.serviceLabel, home: home)\n789|                if let data = try? Data(contentsOf: copy),\n790|                   var current = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],\n791|                   current[\"Label\"] as? String == entry.serviceLabel,\n792|                   current[\"WorkingDirectory\"] as? String == oldPath {\n793|                    try await installer.requireIdle(for: url)\n794|                    current[\"WorkingDirectory\"] = url.path\n795|                    current[\"ProgramArguments\"] = [url.appendingPathComponent(\"runsvc.sh\").path]\n796|                    let out = try PropertyListSerialization.data(fromPropertyList: current, format: .xml, options: 0)\n797|                    try out.write(to: copy, options: .atomic)\n798|                }\n799|            }\n800|            try await catalog.update(entry)\n801|            await action { Runners.Action.catalogCleared }\n802|            let snapshots = await service.snapshots()\n803|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n804|            await action { Runners.Action.refreshed(mapped_snapshots) }\n805|        } catch {\n806|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n807|        }\n808|    }\n809|\n810|    // MARK: - Diagnostics\n811|\n812|    private func loadLog(id: String) async {\n813|        let snapshots = await service.snapshots()\n814|        guard let snapshot = snapshots.first(where: { $0.id == id }) else {\n815|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n816|            return\n817|        }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
