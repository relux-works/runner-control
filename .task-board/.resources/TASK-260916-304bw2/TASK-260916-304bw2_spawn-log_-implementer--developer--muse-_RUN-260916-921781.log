{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cec7","stream":{"kind":"session","id":"01a0a9c5-2eb3-7902-83b0-77aeb115d140"},"sequence":1470,"recorded_at":1780531400002935,"record_type":"event","durability":"durable","causation_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","run_stream":{"kind":"run","id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246"},"task_stream":{"kind":"task","id":"01a0a9cc-bc40-7070-a4c0-eae251374c15"},"task_id":"01a0a9cc-bc40-7070-a4c0-eae251374c15","event":{"kind":"output","task_id":"01a0a9cc-bc40-7070-a4c0-eae251374c15","chunk":"Read text file `/Users/iv/Documents/Codex/2026-09-15/new-chat-4/outputs/RunnerControl/.temp/STORY-260916-36d1jg/worktree/Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n(1014 line(s) above)\n1015|        }\n1016|        let canonical = RunnerCatalogStore.canonical(verified.directory)\n1017|        let current = await catalog.load()\n1018|        guard current.contains(where: { $0.localID == verified.entry.localID && $0.canonicalPath == canonical }) else {\n1019|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1020|                \"Catalog entry changed during group apply. Reload instead of editing another entry's group.\"\n1021|            )\n1022|        }\n1023|    }\n1024|\n1025|    /// Applies edited repository access to the runner's fresh group. Rejects\n1026|    /// stale UI (group moved since load), shared groups without explicit\n1027|    /// takeover, and partial confirmations. Binds server+scope+agentID+\n1028|    /// canonical service identity on this write path — verified against the\n1029|    /// catalog original, never assumed from an earlier Load — and preserves\n1030|    /// that binding plus the starting session over every asynchronous\n1031|    /// boundary through confirmation and publication. Reuses the\n1032|    /// registration ownership and confirmation gates; API-only, no\n1033|    /// installer lease.\n1034|    private func applyGroupAccess(id: String, groupID: Int64, repos: Set<Int64>, allowTakeover: Bool) async {\n1035|        let gen = catalogGeneration\n1036|        let startedIdentity = await identities.load()\n1037|        await action { Runners.Action.groupAccessLoading(id) }\n1038|        do {\n1039|            let verified = try await verifiedOrgRunner(id: id)\n1040|            let auth = try await currentUserToken()\n1041|            if isCatalogStale(gen) { return }\n1042|            guard await sessionStill(startedIdentity) else { return }\n1043|            try await bindApplyIdentity(verified: verified, auth: auth)\n1044|            // Fresh membership re-verified at write time: a move since the\n1045|            // UI loaded fails instead of editing the wrong group.\n1046|            let fresh = try await resolveFreshGroup(\n1047|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n1048|                auth: auth, generation: gen\n1049|            )\n1050|            guard fresh.id == groupID else {\n1051|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1052|                    \"Runner moved from group \\(groupID) to '\\(fresh.name)' (\\(fresh.id)) since loading. Reload instead of editing a stale group.\"\n1053|                )\n1054|            }\n1055|            if isCatalogStale(gen) { return }\n1056|            let owned = await installer.loadOwnedGroupID(\n1057|                serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name\n1058|            )\n1059|            try RunnerRegistration.Gates.authorizeGroupTakeover(\n1060|                groupName: fresh.name, existingID: fresh.id,\n1061|                ownedID: owned, allowTakeover: allowTakeover\n1062|            )\n1063|            if owned != fresh.id {\n1064|                try await installer.saveOwnedGroupID(\n1065|                    serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name, groupID: fresh.id\n1066|                )\n1067|            }\n1068|            if isCatalogStale(gen) { return }\n1069|            // Re-bind at the PUT boundary: the membership and ownership\n1070|            // awaits above must not carry stale identity into the write.\n1071|            guard await sessionStill(startedIdentity) else { return }\n1072|            try await bindApplyIdentity(verified: verified, auth: auth)\n1073|            try await api.setGroupRepositories(\n1074|                config: auth.config, token: auth.token, org: verified.org,\n1075|                groupID: fresh.id, selectedRepositoryIDs: repos\n1076|            )\n1077|            if isCatalogStale(gen) { return }\n1078|            // Completion ownership: the issued PUT cannot be undone, but a\n1079|            // logout, account or server switch after it refuses the\n1080|            // confirmation read and any state publication into the changed\n1081|            // session.\n1082|            guard await sessionStill(startedIdentity) else { return }\n1083|            let confirmed = try await api.fetchGroupRepositories(\n1084|                config: auth.config, token: auth.token, org: verified.org, groupID: fresh.id\n1085|            )\n1086|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: repos, confirmed: confirmed)\n1087|            if isCatalogStale(gen) { return }\n1088|            guard await sessionStill(startedIdentity) else { return }\n1089|            let access = Runners.GroupAccess(\n1090|                group: fresh, repoIDs: confirmed.sorted(), updatedAt: now(),\n1091|                owned: true, loading: false\n1092|            )\n1093|            await action { Runners.Action.groupAccessLoaded(id, access) }\n1094|            await action { Runners.Action.catalogCleared }\n1095|        } catch is CancellationError {\n1096|            return\n1097|        } catch {\n1098|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n1099|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n1100|                await action { Runners.Action.groupAccessFailed(id, message) }\n1101|            }\n1102|        }\n1103|    }\n1104|}\n1105|\n1106|/// Import gates. Each gate refuses a concrete invalid class; negative tests\n1107|/// narrow every one of them.\n1108|public enum RunnersCatalogGates {\n1109|    public static func validateImportable(_ candidate: RunnerDiscovery.Candidate) throws {\n1110|        if candidate.controllerKind == .unsupported || candidate.unsupportedReason != nil {\n1111|            throw RunnerError.unsupported(candidate.unsupportedReason ?? \"Unsupported management.\")\n1112|        }\n1113|        if !candidate.registrationReadable {\n1114|            throw RunnerError.message(\"Cannot read .runner registration.\")\n1115|        }\n1116|        if candidate.agentName == nil || candidate.agentName?.isEmpty == true {\n1117|            throw RunnerError.message(\"Registration name is missing.\")\n1118|        }\n1119|        if candidate.serverHost == nil || candidate.scope == nil {\n1120|            throw RunnerError.message(\"Server or scope is undefined.\")\n1121|        }\n1122|        if !candidate.noSpacePath || !candidate.noSpaceWork {\n1123|            throw RunnerError.noSpacePath(\"Path or work folder contains a space; relocation is required.\")\n1124|        }\n1125|        if !candidate.runsvcExists || !candidate.binaryExists {\n1126|            throw RunnerError.message(\"Runner binaries are missing (run.sh / runsvc.sh).\")\n1127|        }\n1128|        if candidate.manifest == nil {\n1129|            // Folder imports without a manifest create a service; every other\n1130|            // check above must already have passed.\n1131|            return\n1132|        }\n1133|        if !candidate.manifestMatches {\n1134|            throw RunnerError.manifestMismatch(\"Service manifest does not match the runner directory.\")\n1135|        }\n1136|        if !candidate.issues.isEmpty {\n1137|            // Issues beyond the manifest notice (folder imports) refuse.\n1138|            let blocking = candidate.issues.filter { !$0.contains(\"No service manifest\") }\n1139|            if !blocking.isEmpty {\n1140|                throw RunnerError.message(blocking.joined(separator: \" \"))\n1141|            }\n1142|        }\n1143|    }\n1144|}","final_result":true}}}
