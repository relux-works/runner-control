   defer { try? FileManager.default.removeItem(at: file) }\n1387|    let store = RunnerCatalogStore(fileURL: file)\n1388|    let root = FileManager.default.temporaryDirectory.appendingPathComponent(\"DupLabel-\" + UUID().uuidString)\n1389|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n1390|    defer { try? FileManager.default.removeItem(at: root) }\n1391|    let a = root.appendingPathComponent(\"a\")\n1392|    let b = root.appendingPathComponent(\"b\")\n1393|    try FileManager.default.createDirectory(at: a, withIntermediateDirectories: true)\n1394|    try FileManager.default.createDirectory(at: b, withIntermediateDirectories: true)\n1395|    let first = RunnerCatalogStore.Entry(\n1396|        directoryPath: a.path, canonicalPath: RunnerCatalogStore.canonical(a),\n1397|        serviceLabel: \"actions.runner.test.dup\",\n1398|        servicePlistPath: a.appendingPathComponent(\"manual-service.plist\").path,\n1399|        controllerKind: .manualManaged\n1400|    )\n1401|    try await store.add(first)\n1402|    let second = RunnerCatalogStore.Entry(\n1403|        directoryPath: b.path, canonicalPath: RunnerCatalogStore.canonical(b),\n1404|        serviceLabel: \"actions.runner.test.dup\",\n1405|        servicePlistPath: b.appendingPathComponent(\"manual-service.plist\").path,\n1406|        controllerKind: .manualManaged\n1407|    )\n1408|    do {\n1409|        try await store.add(second)\n1410|        Issue.record(\"Catalog admitted two entries sharing one service label\")\n1411|    } catch let error as RunnerCatalogStore.CatalogError {\n1412|        guard case .duplicateLabel(let label) = error, label == \"actions.runner.test.dup\" else {\n1413|            Issue.record(\"Wrong duplicate-label error: \\(error)\"); return\n1414|        }\n1415|    }\n1416|    #expect(await store.load().count == 1)\n1417|}\n1418|\n1419|/// F3 bound: same-name imports are independently controllable — enabling\n1420|/// each runner bootstraps its own manifest, never the sibling's.\n1421|@Test func sameNameFolderImportsControlIndependently() async throws {\n1422|    let stoppedResult = CommandResult(code: 113, output: \"Could not find service x\")\n1423|    let okResult = CommandResult(code: 0, output: \"\")\n1424|    let runningResult = CommandResult(code: 0, output: \"state = running\")\n1425|    let harness = await catalogHarness(launchResults: [\n1426|        stoppedResult, stoppedResult, stoppedResult,\n1427|        stoppedResult, okResult, runningResult, runningResult, runningResult,\n1428|        stoppedResult, okResult, runningResult, runningResult, runningResult\n1429|    ])\n1430|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1431|    let a = try makeRunnerDir(parent: harness.home, name: \"a\", agentName: \"same\", scope: \"acme/a\", withPlist: false)\n1432|    let b = try makeRunnerDir(parent: harness.home, name: \"b\", agentName: \"same\", scope: \"acme/b\", withPlist: false)\n1433|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.importFolder(a))\n1434|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.importFolder(b))\n1435|    let entries = await harness.catalog.load()\n1436|    #expect(entries.count == 2)\n1437|    let labels = entries.map(\\.serviceLabel)\n1438|    #expect(Set(labels).count == 2)\n1439|    for label in labels {\n1440|        let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.setEnabled(label, true))\n1441|    }\n1442|    let bootstraps = await harness.launchExecutor.calls.filter { $0.contains(\"bootstrap\") }\n1443|    #expect(bootstraps.count == 2)\n1444|    let targets = Set(bootstraps.compactMap(\\.last))\n1445|    #expect(targets == [\n1446|        a.appendingPathComponent(\"manual-service.plist\").path,\n1447|        b.appendingPathComponent(\"manual-service.plist\").path\n1448|    ])\n1449|}\n1450|\n1451|/// F3 bound: a manifest label already owned by another entry refuses the\n1452|/// second import instead of creating an uncontrollable duplicate.\n1453|@Test func importRefusesConflictingManifestLabel() async throws {\n1454|    let harness = await catalogHarness(launchResults: [\n1455|        CommandResult(code: 113, output: \"Could not find service x\")\n1456|    ])\n1457|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1458|    let a = try makeRunnerDir(parent: harness.home, name: \"a\", agentName: \"r\", scope: \"acme/a\", label: \"actions.runner.test.clash\")\n1459|    let b = try makeRunnerDir(parent: harness.home, name: \"b\", agentName: \"r\", scope: \"acme/b\", label: \"actions.runner.test.clash\")\n1460|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.importFolder(a))\n1461|    #expect(await harness.catalog.load().count == 1)\n1462|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.importFolder(b))\n1463|    #expect(await harness.catalog.load().count == 1)\n1464|    #expect(catalogErr(harness.logger).contains(\"already in the catalog\"))\n1465|}\n1466|\n1467|/// F4 bound: a malformed store fails closed — no migration, no overwrite —\n1468|/// and the bytes stay untouched for recovery.\n1469|@Test func migrationFailsClosedOnMalformedPersistence() async throws {\n1470|    let file = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n1471|    defer { try? FileManager.default.removeItem(at: file) }\n1472|    try \"not-json{{\".write(to: file, atomically: true, encoding: .utf8)\n1473|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"MalformedHome-\" + UUID().uuidString)\n1474|    try FileManager.default.createDirectory(at: home, withIntermediateDirectories: true)\n1475|    defer { try? FileManager.default.removeItem(at: home) }\n1476|    let store = RunnerCatalogStore(fileURL: file)\n1477|    do {\n1478|        _ = try await store.migrateIfNeeded(home: home)\n1479|        Issue.record(\"Migration 