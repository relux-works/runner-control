{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e5","stream":{"kind":"session","id":"01a0a9c5-2eb3-7902-83b0-77aeb115d140"},"sequence":461,"recorded_at":1780531400000917,"record_type":"event","durability":"durable","causation_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","run_stream":{"kind":"run","id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246"},"call_id":"call_01a0a9c6468a7512bbe0f2879dcbc3eb","text":"Read text file `/Users/iv/Documents/Codex/2026-09-15/new-chat-4/outputs/RunnerControl/.temp/STORY-260916-36d1jg/worktree/Packages/RunnerControlCore/Sources/RunnerCatalog.swift`.\n1|import CryptoKit\n2|import Foundation\n3|\n4|extension Runners {\n5|    /// How a catalog entry is controlled. Managed kinds use launchctl;\n6|    /// unsupported entries are read-only (no fake toggle, no second process).\n7|    public enum ControllerKind: String, Sendable, Equatable, Codable {\n8|        case manualManaged\n9|        case standardLaunchAgent\n10|        case unsupported\n11|\n12|        public var title: String {\n13|            switch self {\n14|            case .manualManaged: \"Ручная служба\"\n15|            case .standardLaunchAgent: \"LaunchAgent\"\n16|            case .unsupported: \"Неподдерживаемое управление\"\n17|            }\n18|        }\n19|\n20|        public var canControl: Bool { self != .unsupported }\n21|    }\n22|}\n23|\n24|/// Versioned persistent catalog of user-managed runner installations.\n25|///\n26|/// Stored as JSON in Application Support/RunnerControl/catalog.json. Holds\n27|/// identity, paths, display overrides, controller kind and preferences.\n28|/// Never holds secrets, tokens, or credentials.\n29|public actor RunnerCatalogStore {\n30|    public static let currentVersion = 1\n31|    public static let fileName = \"catalog.json\"\n32|\n33|    public struct Entry: Sendable, Equatable, Codable, Identifiable {\n34|        public var localID: String\n35|        public var directoryPath: String\n36|        public var canonicalPath: String\n37|        public var bookmarkBase64: String?\n38|        public var displayName: String?\n39|        public var serviceLabel: String\n40|        public var servicePlistPath: String\n41|        public var controllerKind: Runners.ControllerKind\n42|        public var runAtLoad: Bool?\n43|        public var serverHost: String?\n44|        public var scopeKind: String?\n45|        public var scope: String?\n46|        public var remoteAgentID: Int64?\n47|        public var agentName: String?\n48|        public var workFolder: String?\n49|        public var addedAt: Date\n50|        public var lastSeenAt: Date?\n51|\n52|        public var id: String { localID }\n53|\n54|        public init(\n55|            localID: String = UUID().uuidString,\n56|            directoryPath: String,\n57|            canonicalPath: String,\n58|            bookmarkBase64: String? = nil,\n59|            displayName: String? = nil,\n60|            serviceLabel: String,\n61|            servicePlistPath: String,\n62|            controllerKind: Runners.ControllerKind,\n63|            runAtLoad: Bool? = nil,\n64|            serverHost: String? = nil,\n65|            scopeKind: String? = nil,\n66|            scope: String? = nil,\n67|            remoteAgentID: Int64? = nil,\n68|            agentName: String? = nil,\n69|            workFolder: String? = nil,\n70|            addedAt: Date = Date(),\n71|            lastSeenAt: Date? = nil\n72|        ) {\n73|            self.localID = localID\n74|            self.directoryPath = directoryPath\n75|            self.canonicalPath = canonicalPath\n76|            self.bookmarkBase64 = bookmarkBase64\n77|            self.displayName = displayName\n78|            self.serviceLabel = serviceLabel\n79|            self.servicePlistPath = servicePlistPath\n80|            self.controllerKind = controllerKind\n81|            self.runAtLoad = runAtLoad\n82|            self.serverHost = serverHost\n83|            self.scopeKind = scopeKind\n84|            self.scope = scope\n85|            self.remoteAgentID = remoteAgentID\n86|            self.agentName = agentName\n87|            self.workFolder = workFolder\n88|            self.addedAt = addedAt\n89|            self.lastSeenAt = lastSeenAt\n90|        }\n91|    }\n92|\n93|    struct File: Codable, Sendable, Equatable {\n94|        var version: Int\n95|        var entries: [Entry]\n96|        /// True once one-time migration has run or any explicit user mutation\n97|        /// sealed the catalog. An initialized-but-empty catalog is\n98|        /// authoritative and never re-triggers migration. Legacy files without\n99|        /// this key decode as false and are sealed on the next migration pass.\n100|        var migrated: Bool\n101|\n102|        enum CodingKeys: String, CodingKey {\n103|            case version, entries, migrated\n104|        }\n105|\n106|        init(version: Int, entries: [Entry], migrated: Bool) {\n107|            self.version = version\n108|            self.entries = entries\n109|            self.migrated = migrated\n110|        }\n111|\n112|        init(from decoder: Decoder) throws {\n113|            let container = try decoder.container(keyedBy: CodingKeys.self)\n114|            version = try container.decode(Int.self, forKey: .version)\n115|            entries = try container.decode([Entry].self, forKey: .entries)\n116|            migrated = try container.decodeIfPresent(Bool.self, forKey: .migrated) ?? false\n117|        }\n118|    }\n119|\n120|    public enum CatalogError: LocalizedError, Sendable, Equatable {\n121|        case duplicateDirectory(path: String)\n122|        case duplicateLabel(label: String)\n123|        case unknownEntry(id: String)\n124|        case persistenceUnreadable(reason: String)\n125|        case unsupportedVersion(found: Int)\n126|\n127|        public var errorDescription: String? {\n128|            switch self {\n129|            case .duplicateDirectory(let path):\n130|                \"Runner directory is already in the catalog: \\(path). One directory cannot be imported twice.\"\n131|            case .duplicateLabel(let label):\n132|                \"Service '\\(label)' is already in the catalog. Two entries must never share one control identity.\"\n133|            case .unknownEntry(let id):\n134|                \"Unknown catalog entry: \\(id).\"\n135|            case .persistenceUnreadable(let reason):\n136|                reason\n137|            case .unsupportedVersion(let found):\n138|                \"Catalog version \\(found) is not supported by this app (expected \\(RunnerCatalogStore.currentVersion)). Refusing to migrate or overwrite it.\"\n139|            }\n140|        }\n141|    }\n142|\n143|    private let fileURL: URL\n144|\n145|    public init(fileURL: URL? = nil) {\n146|        if let fileURL {\n147|            self.fileURL = fileURL\n148|        } else {\n149|            let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first\n150|                ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/Application Support\")\n151|            self.fileURL = base.appendingPathComponent(\"RunnerControl/\\(Self.fileName)\")\n152|        }\n153|    }\n154|\n155|    public nonisolated var url: URL { fileURL }\n156|\n157|    /// Canonical directory identity. Symlink spellings collapse to one key,\n158|    /// so the same installation cannot be imported twice via an alias path.\n159|    public nonisolated static func canonical(_ url: URL) -> String {\n160|        url.resolvingSymlinksInPath().standardizedFileURL.path\n161|    }\n162|\n163|    /// Collision-safe service label for manifest-free folder imports. The\n164|    /// agent name keeps the label readable; the canonical-path hash keeps it\n165|    /// unique and persistent: two folders with the same agent name on\n166|    /// different scopes or paths never share one control identity, and the\n167|    /// same directory always maps to the same label.\n168|    public nonisolated static func importedServiceLabel(agentName: String?, directory: URL) -> String {\n169|        let raw = (agentName ?? directory.lastPathComponent)\n170|            .lowercased().replacingOccurrences(of: \" \", with: \"-\")\n171|        let base = raw.isEmpty ? \"runner\" : raw\n172|        let digest = SHA256.hash(data: Data(canonical(directory).utf8))\n173|        let suffix = digest.prefix(4).map { String(format: \"%02x\", $0) }.joined()\n174|        return \"actions.runner.imported.\\(base)-\\(suffix)\"\n175|    }\n176|\n177|    /// Checked file read. A missing file is first-run absence (nil). A present\n178|    /// but unreadable or malformed file, or a version mismatch, fails closed\n179|    /// instead of masquerading as an empty catalog.\n180|    private func existingFile() throws -> File? {\n181|        guard FileManager.default.fileExists(atPath: fileURL.path) else { return nil }\n182|        guard let data = try? Data(contentsOf: fileURL) else {\n183|            throw CatalogError.persistenceUnreadable(reason: \"Cannot read the catalog file at \\(fileURL.path). Refusing to treat a read failure as an empty catalog.\")\n184|        }\n185|        guard let file = try? JSONDecoder().decode(File.self, from: data) else {\n186|            throw CatalogError.persistenceUnreadable(reason: \"The catalog file at \\(fileURL.path) is malformed. Refusing to migrate or overwrite it.\")\n187|        }\n188|        guard file.version == Self.currentVersion else {\n189|            throw CatalogError.unsupportedVersion(found: file.version)\n190|        }\n191|        return file\n192|    }\n193|\n194|    /// Fail-soft display read: missing, malformed or version-mismatched\n195|    /// persistence all surface as an empty list for snapshots and discovery.\n196|    /// Mutations (`add`/`remove`/`update`) and `migrateIfNeeded` use checked\n197|    /// reads and fail closed instead of clobbering or re-seeding.\n198|    public func load() -> [Entry] {\n199|        guard let file = try? existingFile() else { return [] }\n200|        return file.entries\n201|    }\n202|\n203|    /// Checked entries for mutations. Missing file starts from empty; a\n204|    /// corrupt or unsupported store throws instead of being overwritten.\n205|    private func checkedEntriesForMutation() throws -> [Entry] {\n206|        try existingFile()?.entries ?? []\n207|    }\n208|\n209|    /// Persists entries and seals the catalog as user-authoritative: an\n210|    /// explicit save (including an explicit emptying) never re-triggers\n211|    /// migration.\n212|    public func save(_ entries: [Entry]) throws {\n213|        try write(entries: entries, migrated: true)\n214|    }\n215|\n216|    private func write(entries: [Entry], migrated: Bool) throws {\n217|        let file = File(version: Self.currentVersion, entries: entries, migrated: migrated)\n218|        let data = try JSONEncoder().encode(file)\n219|        try FileManager.default.createDirectory(at: fileURL.deletingLastPathComponent(), withIntermediateDirectories: true)\n220|        try data.write(to: fileURL, options: .atomic)\n221|    }\n222|\n223|    /// Adds an entry. Refuses a second entry for the same canonical directory,\n224|    /// including symlink spellings, and refuses a second entry sharing one\n225|    /// service label: two entries must never share one control identity. Two\n226|    /// identical agent names on different scopes stay two entries with two\n227|    /// distinct labels.\n228|    public func add(_ entry: Entry) throws {\n229|        var entries = try checkedEntriesForMutation()\n230|        let want = entry.canonicalPath\n231|        if entries.contains(where: { $0.canonicalPath == want }) {\n232|            throw CatalogError.duplicateDirectory(path: entry.directoryPath)\n233|        }\n234|        if entries.contains(where: { $0.serviceLabel == entry.serviceLabel }) {\n235|            throw CatalogError.duplicateLabel(label: entry.serviceLabel)\n236|        }\n237|        entries.append(entry)\n238|        try save(entries)\n239|    }\n240|\n241|    /// Removes only the catalog record. Deletes no files, no GitHub\n242|    /// registration, no certificates, and never stops a running service.\n243|    /// Returns the removed entry so the caller can warn when the service\n244|    /// keeps running. An emptied catalog stays empty: removal seals the\n245|    /// catalog and `migrateIfNeeded` never resurrects removed entries.\n246|    @discardableResult\n247|    public func remove(localID: String) throws -> Entry {\n248|        var entries = try checkedEntriesForMutation()\n249|        guard let index = entries.firstIndex(where: { $0.localID == localID }) else {\n250|            throw CatalogError.unknownEntry(id: localID)\n251|        }\n252|        let removed = entries.remove(at: index)\n253|        try save(entries)\n254|        return removed\n255|    }\n256|\n257|    public func update(_ entry: Entry) throws {\n258|        var entries = try checkedEntriesForMutation()\n259|        guard let index = entries.firstIndex(where: { $0.localID == entry.localID }) else {\n260|            throw CatalogError.unknownEntry(id: entry.localID)\n261|        }\n262|        // Directory moves must not collide with another entry's canonical path.\n263|        if entries.enumerated().contains(where: { $0.offset != index && $0.element.canonicalPath == entry.canonicalPath }) {\n264|            throw CatalogError.duplicateDirectory(path: entry.directoryPath)\n265|        }\n266|        // Labels must never collide either: one label is one control identity.\n267|        if entries.enumerated().contains(where: { $0.offset != index && $0.element.serviceLabel == entry.serviceLabel }) {\n268|            throw CatalogError.duplicateLabel(label: entry.serviceLabel)\n269|        }\n270|        entries[index] = entry\n271|        try save(entries)\n272|    }\n273|\n274|    /// One-time migration: when the catalog was never initialized, import\n275|    /// every discovered installation with its real directory, scope, label\n276|    /// and preserved RunAtLoad policy, then seal the catalog — including an\n277|    /// empty result. An initialized catalog (even an explicitly emptied one)\n278|    /// is authoritative and is returned untouched; removing the last entry\n279|    /// never resurrects it at restart. A malformed, unreadable or\n280|    /// unsupported store fails closed instead of migrating. Never stops,\n281|    /// renames, re-registers or changes autostart; discovery only reads.\n282|    /// Returns the migrated or stored entries.\n283|    public func migrateIfNeeded(home: URL = FileManager.default.homeDirectoryForCurrentUser) throws -> [Entry] {\n284|        if let file = try existingFile() {\n285|            if file.migrated || !file.entries.isEmpty {\n286|                if !file.migrated {\n287|                    // Legacy initialized store: seal without touching entries.\n288|                    try write(entries: file.entries, migrated: true)\n289|                }\n290|                return file.entries\n291|            }\n292|            // Empty and never migrated: one-time import, then seal.\n293|            let entries = collectMigrationEntries(home: home)\n294|            try write(entries: entries, migrated: true)\n295|            return entries\n296|        }\n297|        // First run: no catalog file yet.\n298|        let entries = collectMigrationEntries(home: home)\n299|        try write(entries: entries, migrated: true)\n300|        return entries\n301|    }\n302|\n303|    private func collectMigrationEntries(home: URL) -> [Entry] {\n304|        let definitions = RunnerDiscovery.installed(home: home)\n305|        var entries: [Entry] = []\n306|        for definition in definitions {\n307|            let url = definition.directory\n30