ogStore.canonical(url)\n748|        if entries.contains(where: { $0.localID != entry.localID && $0.canonicalPath == canonical }) {\n749|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.duplicateDirectory(path: url.path).localizedDescription) }\n750|            return\n751|        }\n752|        guard let info = RunnerRegistrationReader.read(directory: url) else {\n753|            await action { Runners.Action.catalogFailed(\"Cannot read .runner in the selected folder.\") }\n754|            return\n755|        }\n756|        if let stored = entry.remoteAgentID, info.agentID != stored {\n757|            await action { Runners.Action.catalogFailed(\"Selected folder is agent \\(info.agentID.map(String.init) ?? \"unknown\"), not \\(stored). Refusing to relink a foreign installation.\") }\n758|            return\n759|        }\n760|        catalogGeneration += 1\n761|        do {\n762|            let plist = URL(fileURLWithPath: entry.servicePlistPath)\n763|            // Manual manifests move with the directory; standard manifests\n764|            // stay in LaunchAgents. Update whichever manifest this entry owns.\n765|            if plist.path.hasPrefix(entry.directoryPath) {\n766|                let moved = url.appendingPathComponent(\"manual-service.plist\")\n767|                if FileManager.default.fileExists(atPath: moved.path) {\n768|                    try await installer.updateServicePaths(plist: moved, directory: url)\n769|                    entry.servicePlistPath = moved.path\n770|                }\n771|            } else {\n772|                try await installer.updateServicePaths(plist: plist, directory: url)\n773|            }\n774|            let oldPath = entry.directoryPath\n775|            entry.directoryPath = url.path\n776|            entry.canonicalPath = canonical\n777|            entry.bookmarkBase64 = RunnerCatalogStore.bookmark(for: url)\n778|            entry.agentName = info.agentName ?? entry.agentName\n779|            entry.serverHost = info.serverHost ?? entry.serverHost\n780|            entry.scope = info.scopeDetail ?? entry.scope\n781|            entry.scopeKind = info.scopeKind ?? entry.scopeKind\n782|            entry.remoteAgentID = info.agentID ?? entry.remoteAgentID\n783|            entry.workFolder = info.workFolder ?? entry.workFolder\n784|            // Keep a managed login registration pointing at the new\n785|            // directory so relink preserves effective login. Foreign\n786|            // same-label plists are never touched.\n787|            if entry.controllerKind == .manualManaged {\n788|                let copy = RunnerControllers.loginRegistrationURL(label: entry.serviceLabel, home: home)\n789|                if let data = try? Data(contentsOf: copy),\n790|                   var current = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],\n791|                   current[\"Label\"] as? String == entry.serviceLabel,\n792|                   current[\"WorkingDirectory\"] as? String == oldPath {\n793|                    try await installer.requireIdle(for: url)\n794|                    current[\"WorkingDirectory\"] = url.path\n795|                    current[\"ProgramArguments\"] = [url.appendingPathComponent(\"runsvc.sh\").path]\n796|                    let out = try PropertyListSerialization.data(fromPropertyList: current, format: .xml, options: 0)\n797|                    try out.write(to: copy, options: .atomic)\n798|                }\n799|            }\n800|            try await catalog.update(entry)\n801|            await action { Runners.Action.catalogCleared }\n802|            let snapshots = await service.snapshots()\n803|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n804|            await action { Runners.Action.refreshed(mapped_snapshots) }\n805|        } catch {\n806|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n807|        }\n808|    }\n809|\n810|    // MARK: - Diagnostics\n811|\n812|    private func loadLog(id: String) async {\n813|        let snapshots = await service.snapshots()\n814|        guard let snapshot = snapshots.first(where: { $0.id == id }) else {\n815|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n816|            return\n817|        }\n(more lines below)","final_result":true}}}
