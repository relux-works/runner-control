n false\n260|    }\n261|\n262|    // MARK: - Auth\n263|\n264|    private func currentUserToken(generation gen: Int) async throws -> FlowUserToken {\n265|        guard let identity = await identities.load() else {\n266|            throw RunnerRegistration.RegistrationError.notAuthenticated\n267|        }\n268|        let config = try configProvider(identity.serverHost)\n269|        guard var record = await userStore.load(\n270|            serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID\n271|        ) else {\n272|            throw RunnerRegistration.RegistrationError.notAuthenticated\n273|        }\n274|        guard !isStale(gen) else { throw CancellationError() }\n275|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n276|            do {\n277|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n278|            } catch is CancellationError {\n279|                throw CancellationError()\n280|            } catch let error as GitHubAuth.AuthError {\n281|                switch error {\n282|                case .revoked, .unauthorized, .tokenRefreshFailed:\n283|                    throw RunnerRegistration.RegistrationError.unauthorized\n284|                default:\n285|                    break\n286|                }\n287|            }\n288|            guard !isStale(gen) else { throw CancellationError() }\n289|        }\n290|        return FlowUserToken(config: config, token: record.accessToken, identity: identity)\n291|    }\n292|\n293|    /// Binds cached progress to the authenticated server. When the session\n294|    /// server changes between steps, server-bound caches (group, asset,\n295|    /// runner ID, pendings) are dropped before any reuse, so an ID from one\n296|    /// server never authorizes writes on another. Returns false when the\n297|    /// binding changed and the caller must re-resolve instead of reusing.\n298|    @discardableResult\n299|    private func syncServerBinding(_ host: String) -> Bool {\n300|        let normalized = RunnerRegistration.OperationIdentity.normalizeServerHost(host)\n301|        if let bound = boundServerHost,\n302|           RunnerRegistration.OperationIdentity.normalizeServerHost(bound) == normalized {\n303|            return true\n304|        }\n305|        if boundServerHost != nil {\n306|            group = nil\n307|            asset = nil\n308|            runnerID = nil\n309|            pendingRepositoryIDs = nil\n310|            pendingTargetGroupID = nil\n311|            pendingLabels = nil\n312|            failedStep = nil\n313|            boundServerHost = normalized\n314|            return false\n315|        }\n316|        boundServerHost = normalized\n317|        return true\n318|    }\n319|\n320|    /// Generation-owned failure exit. Only the generation that still holds\n321|    /// the lock may record its failure and release it; a stale failure\n322|    /// (abandoned, cancelled, or reset while suspended) mutates nothing, so\n323|    /// it can never unlock a newer operation or plant its failedStep.\n324|    private func fail(_ error: Error, step: String, generation gen: Int) async {\n325|        guard workingOwner == gen else { return }\n326|        failedStep = step\n327|        workingOwner = nil\n328|        workingStep = nil\n329|        if error is CancellationError { return }\n330|        if let reg = error as? RunnerRegistration.RegistrationError {\n331|            switch reg {\n332|            case .missingPermission, .forbidden:\n333|                await action {\n334|                    RunnerRegistration.Action.permissionDenied(message: reg.localizedDescription, step: step)\n335|                }\n336|                return\n337|            default:\n338|                break\n339|            }\n340|        }\n341|        let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n342|        await action { RunnerRegistration.Action.failed(message: message, step: step) }\n343|    }\n344|\n345|    /// Generation-owned success exit. Only the generation that still holds\n346|    /// the lock may attest its step and release it; a stale success emits\n347|    /// nothing and mutates nothing.\n348|    private func finishStep(_ step: String, generation gen: Int) async {\n349|        guard workingOwner == gen else { return }\n350|        failedStep = nil\n351|        workingOwner = nil\n352|        workingStep = nil\n353|        await action { RunnerRegistration.Action.stepFinished(step) }\n354|    }\n355|\n356|    // MARK: - Group\n357|\n358|    private func resolveGroup() async {\n359|        let gen = generation\n360|        guard workingOwner == nil else { return }\n361|        guard let draft else {\n362|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"resolveGroup\") }\n363|            return\n364|        }\n365|        do {\n366|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n367|        } catch {\n368|            failedStep = \"resolveGroup\"\n369|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"resolveGroup\") }\n(more lines below)","final_result":true}}}
