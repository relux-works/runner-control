{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c817","stream":{"kind":"session","id":"01a0a9c5-2eb3-7902-83b0-77aeb115d140"},"sequence":614,"recorded_at":1780531400001223,"record_type":"event","durability":"durable","causation_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","run_stream":{"kind":"run","id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246"},"call_id":"call_01a0a9c69c3276ba9ca17784717fc48b","text":"Read text file `/Users/iv/Documents/Codex/2026-09-15/new-chat-4/outputs/RunnerControl/.temp/STORY-260916-36d1jg/worktree/Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n(1019 line(s) above)\n1020|    // issues check: spaced path, empty issues, every other check valid.\n1021|    let dir = URL(fileURLWithPath: \"/tmp/spaced root/runner\")\n1022|    let candidate = RunnerDiscovery.Candidate(\n1023|        directory: dir,\n1024|        manifest: dir.appendingPathComponent(\"manual-service.plist\"),\n1025|        label: \"actions.runner.test.x\",\n1026|        controllerKind: .manualManaged,\n1027|        agentName: \"r\", scope: \"acme\", serverHost: \"github.com\",\n1028|        agentID: 1, workFolder: \"_work\", runAtLoad: false,\n1029|        runsvcExists: true, binaryExists: true,\n1030|        registrationReadable: true, manifestMatches: true,\n1031|        noSpacePath: false, noSpaceWork: true,\n1032|        issues: []\n1033|    )\n1034|    do {\n1035|        try RunnersCatalogGates.validateImportable(candidate)\n1036|        Issue.record(\"Import gate admitted a spaced install path\")\n1037|    } catch let error as RunnerError {\n1038|        guard case .noSpacePath = error else {\n1039|            Issue.record(\"Wrong no-space error: \\(error)\"); return\n1040|        }\n1041|    } catch {\n1042|        Issue.record(\"Unexpected error: \\(error)\")\n1043|    }\n1044|}\n1045|\n1046|// MARK: - Group access uses fresh API membership (imported drift)\n1047|\n1048|private func groupsPayload(_ groups: [(Int64, String)]) -> GitHubHTTPResponse {\n1049|    jsonResponse([\"runner_groups\": groups.map { id, name in\n1050|        [\"id\": id, \"name\": name, \"visibility\": \"selected\", \"allows_public_repositories\": true] as [String: Any]\n1051|    }])\n1052|}\n1053|\n1054|private func groupRunnersPayload(_ runners: [(Int64, String, Bool)]) -> GitHubHTTPResponse {\n1055|    jsonResponse([\"runners\": runners.map { id, name, busy in\n1056|        [\"id\": id, \"name\": name, \"labels\": [], \"status\": \"online\", \"busy\": busy] as [String: Any]\n1057|    }])\n1058|}\n1059|\n1060|private func groupReposPayload(_ ids: [Int64]) -> GitHubHTTPResponse {\n1061|    jsonResponse([\"repositories\": ids.map { [\"id\": $0] }])\n1062|}\n1063|\n1064|private func loadedGroupAccess(_ logger: Relux.Testing.Logger, id: String) -> Runners.GroupAccess? {\n1065|    for action in runnersActions(logger).reversed() {\n1066|        if case .groupAccessLoaded(let loadedID, let access) = action, loadedID == id {\n1067|            return access\n1068|        }\n1069|    }\n1070|    return nil\n1071|}\n1072|\n1073|private func groupAccessError(_ logger: Relux.Testing.Logger, id: String) -> String? {\n1074|    for action in runnersActions(logger).reversed() {\n1075|        if case .groupAccessFailed(let failedID, let message) = action, failedID == id {\n1076|            return message\n1077|        }\n1078|    }\n1079|    return nil\n1080|}\n1081|\n1082|@Test func groupAccessUsesFreshAPIMembershipNotStalePool() async throws {\n1083|    // Local .runner carries stale pool3 fields; fresh API puts ID39 in group4.\n1084|    // Same-name foreign ID99 sits in group3 and must never be adopted.\n1085|    let harness = await catalogHarness(transportResponses: [\n1086|        groupsPayload([(3, \"old-group\"), (4, \"current-group\")]),\n1087|        groupRunnersPayload([(99, \"macbook-iv\", false)]),\n1088|        groupRunnersPayload([(39, \"macbook-iv\", true)]),\n1089|        groupReposPayload([101, 102])\n1090|    ])\n1091|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1092|    let dir = harness.home.appendingPathComponent(\"r\")\n1093|    try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)\n1094|    let stale: [String: Any] = [\n1095|        \"agentId\": 39, \"agentName\": \"macbook-iv\",\n1096|        \"poolId\": 3, \"poolName\": \"rose-air-projects\",\n1097|        \"gitHubUrl\": \"https://github.com/acme\", \"workFolder\": \"_work\"\n1098|    ]\n1099|    try JSONSerialization.data(withJSONObject: stale).write(to: dir.appendingPathComponent(\".runner\"))\n1100|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"runsvc.sh\"), atomically: true, encoding: .utf8)\n1101|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n1102|    let manifest: [String: Any] = [\n1103|        \"Label\": \"actions.runner.test.drift\",\n1104|        \"ProgramArguments\": [dir.appendingPathComponent(\"runsvc.sh\").path],\n1105|        \"WorkingDirectory\": dir.path, \"RunAtLoad\": false\n1106|    ]\n1107|    try PropertyListSerialization.data(fromPropertyList: manifest, format: .xml, options: 0)\n1108|        .write(to: dir.appendingPathComponent(\"manual-service.plist\"))\n1109|    let entry = RunnerCatalogStore.Entry(\n1110|        directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n1111|        serviceLabel: \"actions.runner.test.drift\",\n1112|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n1113|        controllerKind: .manualManaged, serverHost: \"github.com\",\n1114|        scopeKind: \"org\", scope: \"acme\", remoteAgentID: 39,\n1115|        agentName: \"macbook-iv\", workFolder: \"_work\"\n1116|    )\n1117|    try await harness.catalog.add(entry)\n1118|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.drift\"))\n1119|    let access = loadedGroupAccess(harness.logger, id: \"actions.runner.test.drift\")\n1120|    #expect(access?.group?.id == 4)\n1121|    #expect(access?.group?.name == \"current-group\")\n1122|    #expect(access?.repoIDs == [101, 102])\n1123|    #expect(access?.owned == false)\n1124|    #expect(groupAccessError(harness.logger, id: \"actions.runner.test.drift\") == nil)\n1125|}\n1126|\n1127|@Test func groupAccessRefusesRepoScope() async throws {\n1128|    let harness = await catalogHarness()\n1129|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1130|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme/app\", label: \"actions.runner.test.repo\")\n1131|    let entry = RunnerCatalogStore.Entry(\n1132|        directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n1133|        serviceLabel: \"actions.runner.test.repo\",\n1134|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n1135|        controllerKind: .manualManaged, serverHost: \"github.com\",\n1136|        scopeKind: \"repo\", scope: \"acme/app\", remoteAgentID: 42, agentName: \"r\", workFolder: \"_work\"\n1137|    )\n1138|    try await harness.catalog.add(entry)\n1139|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.repo\"))\n1140|    let err = groupAccessError(harness.logger, id: \"actions.runner.test.repo\") ?? \"\"\n1141|    #expect(err.contains(\"organization runners only\"))\n1142|    #expect(await harness.transport.requests.isEmpty)\n1143|}\n1144|\n1145|@Test func applyGroupAccessRequiresTakeoverForShared() async throws {\n1146|    let harness = await catalogHarness(transportResponses: [\n1147|        groupsPayload([(4, \"team-group\")]),\n1148|        groupRunnersPayload([(42, \"r\", false)]),\n1149|        groupReposPayload([1])\n1150|    ])\n1151|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1152|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.shared\")\n1153|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.shared\"))\n1154|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.shared\"))\n1155|    #expect(loadedGroupAccess(harness.logger, id: \"actions.runner.test.shared\")?.owned == false)\n1156|    // Without takeover: refused before any PUT.\n1157|    await harness.transport.append(groupsPayload([(4, \"team-group\")]))\n1158|    await harness.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1159|    let _: Relux.ActionResult = await harness.flow.apply(\n1160|        Runners.Effect.applyGroupAccess(\"actions.runner.test.shared\", groupID: 4, repositories: [1, 2], allowTakeover: false)\n1161|    )\n1162|    let refused = groupAccessError(harness.logger, id: \"actions.runner.test.shared\") ?? \"\"\n1163|    #expect(refused.contains(\"team-group\"))\n1164|    #expect(await harness.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1165|    // With explicit takeover: ownership recorded, PUT applied, confirmation re-fetched.\n1166|    await harness.transport.append(groupsPayload([(4, \"team-group\")]))\n1167|    await harness.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1168|    await harness.transport.append(GitHubHTTPResponse(status: 204, body: Data()))\n1169|    await harness.transport.append(groupReposPayload([1, 2]))\n1170|    let _: Relux.ActionResult = await harness.flow.apply(\n1171|        Runners.Effect.applyGroupAccess(\"actions.runner.test.shared\", groupID: 4, repositories: [1, 2], allowTakeover: true)\n1172|    )\n1173|    // Success is proven by the fresh loaded access below; the action log\n1174|    // retains the earlier refusal by design.\n1175|    let access = loadedGroupAccess(harness.logger, id: \"actions.runner.test.shared\")\n1176|    #expect(access?.repoIDs == [1, 2])\n1177|    #expect(access?.owned == true)\n1178|    #expect(await harness.transport.requests.filter { $0.method == \"PUT\" }.count == 1)\n1179|}\n1180|\n1181|@Test func applyGroupAccessRefusesStaleGroup() async throws {\n1182|    let harness = await catalogHarness(transportResponses: [\n1183|        groupsPayload([(4, \"g4\")]),\n1184|        groupRunnersPayload([(42, \"r\", false)]),\n1185|        groupReposPayload([1])\n1186|    ])\n1187|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1188|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.stalegroup\")\n1189|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.stalegroup\"))\n1190|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.stalegroup\"))\n1191|    #expect(loadedGroupAccess(harness.logger, id: \"actions.runner.test.stalegroup\")?.group?.id == 4)\n1192|    // Fresh membership now shows the runner in group5: the UI group4 is stale.\n1193|    await harness.transport.append(groupsPayload([(4, \"g4\"), (5, \"g5\")]))\n1194|    await harness.transport.append(groupRunnersPayload([]))\n1195|    await harness.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1196|    let _: Relux.ActionResult = await harness.flow.apply(\n1197|        Runners.Effect.applyGroupAccess(\"actions.runner.test.stalegroup\", groupID: 4, repositories: [1, 2], allowTakeover: true)\n1198|    )\n1199|    let err = groupAccessError(harness.logger, id: \"actions.runner.test.stalegroup\") ?? \"\"\n1200|    #expect(err.contains(\"moved from group 4\"))\n1201|    #expect(await harness.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1202|}\n1203|\n1204|@Test func applyGroupAccessConfirmsExactRepos() async throws {\n1205|    let harness = await catalogHarness(transportResponses: [\n1206|        groupsPayload([(4, \"g4\")]),\n1207|        groupRunnersPayload([(42, \"r\", false)]),\n1208|        groupReposPayload([1])\n1209|    ])\n1210|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1211|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.confirm\")\n1212|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.confirm\"))\n1213|    try await harness.installer.saveOwnedGroupID(serverHost: \"github.com\", org: \"acme\", name: \"g4\", groupID: 4)\n1214|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.confirm\"))\n1215|    #expect(loadedGroupAccess(harness.logger, id: \"actions.runner.test.confirm\")?.owned == true)\n1216|    await harness.transport.append(groupsPayload([(4, \"g4\")]))\n1217|    await harness.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1218|    await harness.transport.append(GitHubHTTPResponse(status: 204, body: Data()))\n1219|    await harness.transport.append(groupReposPayload([1]))\n1220|    let _: Relux.ActionResult = await harness.flow.apply(\n1221|        Runners.Effect.applyGroupAccess(\"actions.runner.test.confirm\", groupID: 4, repositories: [1, 2], allowTakeover: false)\n1222|    )\n1223|    let err = groupAccessError(harness.logger, id: \"actions.runner.test.confirm\") ?? \"\"\n1224|    #expect(err.contains(\"confirmed repositories\"))\n1225|}\n1226|\n1227|// MARK: - R2 reviewer regressions (rev1 verdict, adopted probes + bounds)\n1228|\n1229|// The four exact reviewer probes, adopted as maintained production-entry\n1230|// regressions. Each failed on the rev1 candidate (exit 1) and passes now.\n1231|\n1232|@Test func reviewUnknownServiceMustRefuseUnregister() async throws {\n1233|    let h = await catalogHarness(launchResults: [.init(code: 1, output: \"Operation not permitted\")], installerResults: [.init(code: 0, output: \"ok\")], transportResponses: [removeTokenPayload()])\n1234|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1235|    let d = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", label: \"actions.runner.review.unknown\")\n1236|    try await h.catalog.add(unregisterEntry(dir: d, label: \"actions.runner.review.unknown\"))\n1237|    _ = await h.flow.apply(Runners.Effect.unregister(\"actions.runner.review.unknown\", confirmation: \"r\"))\n1238|    #expect(await h.transport.requests.isEmpty)\n1239|    #expect(await h.installerExecutor.calls.isEmpty)\n1240|}\n1241|\n1242|@Test func reviewRemovedLastEntryMustStayRemovedOnMigration() async throws {\n1243|    let h = await catalogHarness()\n1244|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1245|    _ = try makeRunnerDir(parent: h.home.appendingPathComponent(\"Library/GitHubActions\"), name: \"r\")\n1246|    let entries = try await h.catalog.migrateIfNeeded(home: h.home)\n1247|    #expect(entries.count == 1)\n1248|    _ = try await h.catalog.remove(localID: entries[0].localID)\n1249|    #expect(await h.catalog.load().isEmpty)\n1250|    #expect(try await h.catalog.migrateIfNeeded(home: h.home).isEmpty)\n1251|}\n1252|\n1253|@Test func reviewSameNameFolderImportsMustHaveDistinctServiceIDs() async throws {\n1254|    let h = await catalogHarness()\n1255|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1256|    let a = try makeRunnerDir(parent: h.home, name: \"a\", agentName: \"same\", scope: \"acme/a\", withPlist: false)\n1257|    let b = try makeRunnerDir(parent: h.home, name: \"b\", agentName: \"same\", scope: \"acme/b\", withPlist: false)\n1258|    _ = await h.flow.apply(Runners.Effect.importFolder(a))\n1259|    _ = await h.flow.apply(Runners.Effect.importFolder(b))\n1260|    let entries = await h.catalog.load()\n1261|    #expect(entries.count == 2)\n1262|    #expect(Set(entries.map(\\.serviceLabel)).count == 2)\n1263|}\n1264|\n1265|@Test func reviewCrossServerGroupApplyMustRefuse() async throws {\n1266|    let h = await catalogHarness(transportResponses: [groupsPayload([(4, \"g\")]), groupRunnersPayload([(42,\"r\",false)]), .init(status:204,body:Data()), groupReposPayload([1])])\n1267|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1268|    let d = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", label: \"actions.runner.review.cross\")\n1269|    let foreign: [String: Any] = [\"agentId\":42,\"agentName\":\"r\",\"gitHubUrl\":\"https://ghe.example.com/acme\",\"workFolder\":\"_work\"]\n1270|    try JSONSerialization.data(withJSONObject:foreign).write(to:d.appendingPathComponent(\".runner\"))\n1271|    var entry = unregisterEntry(dir:d,label:\"actions.runner.review.cross\")\n1272|    entry.serverHost = \"ghe.example.com\"\n1273|    try await h.catalog.add(entry)\n1274|    _ = await h.flow.apply(Runners.Effect.applyGroupAccess(\"actions.runner.review.cross\",groupID:4,repositories:[1],allowTakeover:true))\n1275|    #expect(await h.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1276|    #expect(loadedGroupAccess(h.logger,id:\"actions.runner.review.cross\") == nil)\n1277|}\n1278|\n1279|// MARK: - R2 bounds: revalidation, session preservation, control, persistence\n1280|\n1281|/// F1 bound: a service that starts (or is lost to inspection) after the\n1282|/// token mint must not reach `config.sh remove`. The boundary revalidation\n1283|/// refuses; the installer never runs and the entry keeps its registration.\n1284|@Test func unregisterRevalidatesStoppedAtSideEffectBoundary() async throws {\n1285|    let harness = await catalogHarness(\n1286|        launchResults: [\n1287|            CommandResult(code: 113, output: \"Could not find service x\"),\n1288|            CommandResult(code: 0, output: \"state = running\")\n1289|        ],\n1290|        installerResults: [CommandResult(code: 0, output: \"ok\")],\n1291|        transportResponses: [removeTokenPayload()]\n1292|    )\n1293|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1294|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", label: \"actions.runner.test.revalidate\")\n1295|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.revalidate\"))\n1296|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.unregister(\"actions.runner.test.revalidate\", confirmation: \"r\"))\n1297|    #expect(catalogErr(harness.logger).contains(\"Stop the runner first\"))\n1298|    #expect(await harness.installerExecutor.calls.isEmpty)\n1299|    #expect(await harness.catalog.load().first?.remoteAgentID == 42)\n1300|}\n1301|\n1302|/// Session double that returns `first` for the first `flipAfter` loads and\n1303|/// `later` afterwards: a deterministic mid-operation logout.\n1304|private final class FlippingSessionStore: GitHubSessionIdentityStoring, @unchecked Sendable {\n1305|    private let lock = NSLock()\n1306|    private var loads = 0\n1307|    private let flipAfter: Int\n1308|    private var first: GitHubSessionIdentity?\n1309|    private var later: GitHubSessionIdentity?\n1310|    init(first: GitHubSessionIdentity?, later: GitHubSessionIdentity?, flipAfter: Int) {\n1311|        self.first = first\n1312|        self.later = later\n1313|        self.flipAfter = flipAfter\n1314|    }\n1315|    func save(_ identity: GitHubSessionIdentity) async {\n1316|        lock.withLock { first = identity; later = identity }\n1317|    }\n1318|    func load() async -> GitHubSessionIdentity? {\n1319|        lock.withLock {\n1320|            loads += 1\n1321|            return loads <= flipAfter ? first : later\n1322|        }\n1323|    }\n1324|    func delete() async {\n1325|        lock.withLock { first = nil; later = nil }\n1326|    }\n1327|}\n1328|\n1329|/// F2 bound: a logout between the membership reads and the PUT stops\n1330|/// silently — reads happened, the write never fires into a dead session.\n1331|/// Identity load order in apply: started(1), auth(2), post-auth check(3),\n1332|/// pre-PUT check(4); the flip lands on the pre-PUT check.\n1333|@Test func applyGroupAccessStopsWhenSessionChangesMidApply() async throws {\n1334|    let session = GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\")\n1335|    let flipping = FlippingSessionStore(first: session, later: nil, flipAfter: 3)\n1336|    let harness = await catalogHarness(\n1337|        transportResponses: [\n1338|            groupsPayload([(4, \"g4\")]),\n1339|            groupRunnersPayload([(42, \"r\", false)])\n1340|        ],\n1341|        identitiesOverride: flipping\n1342|    )\n1343|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1344|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.sessionflip\")\n1345|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.sessionflip\"))\n1346|    let _: Relux.ActionResult = await harness.flow.apply(\n1347|        Runners.Effect.applyGroupAccess(\"actions.runner.test.sessionflip\", groupID: 4, repositories: [1, 2], allowTakeover: true)\n1348|    )\n1349|    let requests = await harness.transport.requests\n1350|    #expect(requests.count == 2)\n1351|    #expect(requests.filter { $0.method == \"PUT\" }.isEmpty)\n1352|    #expect(loadedGroupAccess(harness.logger, id: \"actions.runner.test.sessionflip\") == nil)\n1353|    #expect(groupAccessError(harness.logger, id: \"actions.runner.test.sessionflip\") == nil)\n1354|}\n1355|\n1356|/// F2 bound: a server switch between the membership reads and the PUT\n1357|/// also stops silently, even when the user ID is unchanged.\n1358|@Test func applyGroupAccessStopsWhenServerSwitchesMidApply() async throws {\n1359|    let first = GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\")\n1360|    let switched = GitHubSessionIdentity(serverHost: \"ghe.example.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\")\n1361|    let flipping = FlippingSessionStore(first: first, later: switched, flipAfter: 3)\n1362|    let harness = await catalogHarness(\n1363|        transportResponses: [\n1364|            groupsPayload([(4, \"g4\")]),\n1365|            groupRunnersPayload([(42, \"r\", false)])\n1366|        ],\n1367|        identitiesOverride: flipping\n1368|    )\n1369|    defer { try? FileManager.default.removeItem(at: harness.home) }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c819","stream":{"kind":"session","id":"01a0a9c5-2eb3-7902-83b0-77aeb115d140"},"sequence":615,"recorded_at":1780531400001225,"record_type":"event","durability":"durable","causation_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246","run_stream":{"kind":"run","id":"0bd83bfa-ae0a-4313-a4d0-115d5a67d246"},"call_id":"call_01a0a9c69f60727987c7e031169c43af","text":"Read text file `/Users/iv/Documents/Codex/2026-09-15/new-chat-4/outputs/RunnerControl/.temp/STORY-260916-36d1jg/worktree/Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n(1469 line(s) above)\n1470|    let file = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n1471|    defer { try? FileManager.default.removeItem(at: file) }\n1472|    try \"not-json{{\".write(to: file, atomically: true, encoding: .utf8)\n1473|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"MalformedHome-\" + UUID().uuidString)\n1474|    try FileManager.default.createDirectory(at: home, withIntermediateDirectories: true)\n1475|    defer { try? FileManager.default.removeItem(at: home) }\n1476|    let store = RunnerCatalogStore(fileURL: file)\n1477|    do {\n1478|        _ = try await store.migrateIfNeeded(home: home)\n1479|        Issue.record(\"Migration treated malformed persistence as first-run absence\")\n1480|    } catch let error as RunnerCatalogStore.CatalogError {\n1481|        guard case .persistenceUnreadable = error else {\n1482|            Issue.record(\"Wrong malformed error: \\(error)\"); return\n1483|        }\n1484|    }\n1485|    let entry = RunnerCatalogStore.Entry(\n1486|        directoryPath: \"/tmp/x\", canonicalPath: \"/tmp/x\",\n1487|        serviceLabel: \"actions.runner.test.clobber\",\n1488|        servicePlistPath: \"/tmp/x/manual-service.plist\",\n1489|        controllerKind: .manualManaged\n1490|    )\n1491|    do {\n1492|        try await store.add(entry)\n1493|        Issue.record(\"Add overwrote malformed persistence\")\n1494|    } catch let error as RunnerCatalogStore.CatalogError {\n1495|        guard case .persistenceUnreadable = error else {\n1496|            Issue.record(\"Wrong clobber error: \\(error)\"); return\n1497|        }\n1498|    }\n1499|    #expect(await store.load().isEmpty)\n1500|    #expect(try String(contentsOf: file, encoding: .utf8) == \"not-json{{\")\n1501|}\n1502|\n1503|/// F4 bound: an unsupported catalog version fails closed instead of\n1504|/// migrating or overwriting.\n1505|@Test func migrationFailsClosedOnUnsupportedVersion() async throws {\n1506|    let file = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n1507|    defer { try? FileManager.default.removeItem(at: file) }\n1508|    try \"{\\\"version\\\":999,\\\"entries\\\":[],\\\"migrated\\\":true}\".write(to: file, atomically: true, encoding: .utf8)\n1509|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"VersionHome-\" + UUID().uuidString)\n1510|    try FileManager.default.createDirectory(at: home, withIntermediateDirectories: true)\n1511|    defer { try? FileManager.default.removeItem(at: home) }\n1512|    let store = RunnerCatalogStore(fileURL: file)\n1513|    do {\n1514|        _ = try await store.migrateIfNeeded(home: home)\n1515|        Issue.record(\"Migration treated an unsupported version as first-run absence\")\n1516|    } catch let error as RunnerCatalogStore.CatalogError {\n1517|        guard case .unsupportedVersion(let found) = error, found == 999 else {\n1518|            Issue.record(\"Wrong version error: \\(error)\"); return\n1519|        }\n1520|    }\n1521|    #expect(try String(contentsOf: file, encoding: .utf8).contains(\"\\\"version\\\":999\"))\n1522|}\n1523|\n1524|/// F4 bound: a legacy store without the migrated flag seals in place —\n1525|/// entries untouched — and a later explicit emptying stays authoritative.\n1526|@Test func migrationSealsLegacyStoreWithoutTouchingEntries() async throws {\n1527|    let file = FileManager.default.temporaryDirectory.appendingPathComponent(\"Catalog-\" + UUID().uuidString + \".json\")\n1528|    defer { try? FileManager.default.removeItem(at: file) }\n1529|    let dir = FileManager.default.temporaryDirectory.appendingPathComponent(\"Legacy-\" + UUID().uuidString)\n1530|    try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)\n1531|    defer { try? FileManager.default.removeItem(at: dir) }\n1532|    let entry = RunnerCatalogStore.Entry(\n1533|        localID: \"legacy-local-id\",\n1534|        directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n1535|        serviceLabel: \"actions.runner.test.legacy\",\n1536|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n1537|        controllerKind: .manualManaged, agentName: \"legacy\"\n1538|    )\n1539|    let entryJSON = String(data: try JSONEncoder().encode(entry), encoding: .utf8)!\n1540|    try \"{\\\"version\\\":1,\\\"entries\\\":[\\(entryJSON)]}\".write(to: file, atomically: true, encoding: .utf8)\n1541|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"LegacyHome-\" + UUID().uuidString)\n1542|    try FileManager.default.createDirectory(at: home, withIntermediateDirectories: true)\n1543|    defer { try? FileManager.default.removeItem(at: home) }\n1544|    let store = RunnerCatalogStore(fileURL: file)\n1545|    let sealed = try await store.migrateIfNeeded(home: home)\n1546|    #expect(sealed.count == 1)\n1547|    #expect(sealed.first?.localID == \"legacy-local-id\")\n1548|    #expect(try String(contentsOf: file, encoding: .utf8).contains(\"\\\"migrated\\\":true\"))\n1549|    _ = try await store.remove(localID: \"legacy-local-id\")\n1550|    #expect(try await store.migrateIfNeeded(home: home).isEmpty)\n1551|}\n1552|\n1553|// MARK: - R3 reviewer regressions (rev2 verdict, adopted probes + bounds)\n1554|\n1555|// The three exact rev2 reviewer probes, adopted as maintained\n1556|// production-entry regressions. Each failed on the rev2 candidate (exit 1,\n1557|// 5 assertion failures) and passes now.\n1558|\n1559|private actor ReviewLogoutTransport: GitHubHTTPTransport {\n1560|    let base: TestTransport\n1561|    let identities: any GitHubSessionIdentityStoring\n1562|    let logoutMethod: String\n1563|    init(_ base: TestTransport, identities: any GitHubSessionIdentityStoring, logoutMethod: String) {\n1564|        self.base = base; self.identities = identities; self.logoutMethod = logoutMethod\n1565|    }\n1566|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n1567|        let result = try await base.send(request)\n1568|        if request.method == logoutMethod { await identities.delete() }\n1569|        return result\n1570|    }\n1571|}\n1572|\n1573|private func reviewLogoutFlow(_ h: CatalogHarness, method: String) async -> Runners.Flow {\n1574|    let transport = ReviewLogoutTransport(h.transport, identities: h.identities, logoutMethod: method)\n1575|    return await Runners.Flow(service: h.service, catalog: h.catalog, installer: h.installer,\n1576|        api: GitHubRunnerAPIClient(transport: transport), userStore: h.userStore,\n1577|        identities: h.identities, refresher: GitHubTokenRefresh(transport: transport, store: h.userStore),\n1578|        configProvider: { _ in testConfig }, home: h.home,\n1579|        dispatcher: Relux.Dispatcher(logger: h.logger))\n1580|}\n1581|\n1582|@Test func reviewR2LogoutDuringPutMustNotPublishAccess() async throws {\n1583|    let h = await catalogHarness(transportResponses: [groupsPayload([(4, \"g\")]),\n1584|        groupRunnersPayload([(42, \"r\", false)]), .init(status: 204, body: Data()), groupReposPayload([1])])\n1585|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1586|    let label = \"actions.runner.test.logoutput\"\n1587|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1588|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1589|    let flow = await reviewLogoutFlow(h, method: \"PUT\")\n1590|    let _: Relux.ActionResult = await flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [1], allowTakeover: true))\n1591|    #expect(await h.identities.load() == nil)\n1592|    #expect(loadedGroupAccess(h.logger, id: label) == nil)\n1593|    #expect(await h.transport.requests.count == 3)\n1594|}\n1595|\n1596|@Test func reviewR2LogoutDuringRemoveTokenMustRefuseSideEffect() async throws {\n1597|    let h = await catalogHarness(launchResults: [stopped, stopped, stopped],\n1598|        installerResults: [.init(code: 0, output: \"ok\")], transportResponses: [removeTokenPayload()])\n1599|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1600|    let label = \"actions.runner.test.logoutremove\"\n1601|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1602|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n1603|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1604|    let flow = await reviewLogoutFlow(h, method: \"POST\")\n1605|    let _: Relux.ActionResult = await flow.apply(Runners.Effect.unregister(label, confirmation: \"r\"))\n1606|    #expect(await h.identities.load() == nil)\n1607|    #expect(await h.installerExecutor.calls.isEmpty)\n1608|    #expect(await h.catalog.load().first?.remoteAgentID == 42)\n1609|}\n1610|\n1611|@Test func reviewR2ScopeEditAfterLoadMustNotRetargetApply() async throws {\n1612|    let h = await catalogHarness(transportResponses: [groupsPayload([(4, \"g\")]),\n1613|        groupRunnersPayload([(42, \"r\", false)]), groupReposPayload([1]),\n1614|        groupsPayload([(4, \"g\")]), groupRunnersPayload([(42, \"r\", false)]),\n1615|        .init(status: 204, body: Data()), groupReposPayload([2])])\n1616|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1617|    let label = \"actions.runner.test.scoperetarget\"\n1618|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1619|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1620|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.loadGroupAccess(label))\n1621|    #expect(loadedGroupAccess(h.logger, id: label)?.group?.id == 4)\n1622|    let runner = dir.appendingPathComponent(\".runner\")\n1623|    var object = try JSONSerialization.jsonObject(with: Data(contentsOf: runner)) as! [String: Any]\n1624|    object[\"gitHubUrl\"] = \"https://github.com/other-org\"\n1625|    try JSONSerialization.data(withJSONObject: object).write(to: runner)\n1626|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true))\n1627|    #expect(await h.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1628|}\n1629|\n1630|// MARK: - R3 bounds: completion ownership, retry release, re-verification\n1631|\n1632|/// R2-F2 bound (sibling Load completion): a logout during the membership\n1633|/// reads stops the Load — the repository fetch after the invalidation\n1634|/// point never fires and no stale access is published into the logged-out\n1635|/// session. Bound: the in-flight membership loop may finish its current\n1636|/// read; no write, confirmation read, or publication follows.\n1637|@Test func loadGroupAccessStopsPublishingAfterMidLoadLogout() async throws {\n1638|    let h = await catalogHarness(transportResponses: [groupsPayload([(4, \"g\")]),\n1639|        groupRunnersPayload([(42, \"r\", false)]), groupReposPayload([1])])\n1640|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1641|    let label = \"actions.runner.test.loadlogout\"\n1642|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1643|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1644|    let flow = await reviewLogoutFlow(h, method: \"GET\")\n1645|    let _: Relux.ActionResult = await flow.apply(Runners.Effect.loadGroupAccess(label))\n1646|    #expect(await h.identities.load() == nil)\n1647|    #expect(loadedGroupAccess(h.logger, id: label) == nil)\n1648|    #expect(groupAccessError(h.logger, id: label) == nil)\n1649|    // Groups + runners reads happened; the repos fetch after the logout did not.\n1650|    #expect(await h.transport.requests.count == 2)\n1651|}\n1652|\n1653|private func lastUnregistering(_ logger: Relux.Testing.Logger, id: String) -> Bool? {\n1654|    for action in runnersActions(logger).reversed() {\n1655|        if case .unregistering(let target, let value) = action, target == id {\n1656|            return value\n1657|        }\n1658|    }\n1659|    return nil\n1660|}\n1661|\n1662|/// R2-F3 bound: a session-invalidated unregister releases the UI operation\n1663|/// state, so re-authenticating and retrying proceeds instead of wedging on\n1664|/// a stuck \"unregistering\" flag.\n1665|@Test func unregisterReleasesOperationStateAfterSessionLoss() async throws {\n1666|    let h = await catalogHarness(launchResults: [stopped, stopped, stopped, stopped],\n1667|        installerResults: [.init(code: 0, output: \"ok\")], transportResponses: [removeTokenPayload()])\n1668|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1669|    let label = \"actions.runner.test.unregretry\"\n1670|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1671|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1672|    let loggedOut = await reviewLogoutFlow(h, method: \"POST\")\n1673|    let _: Relux.ActionResult = await loggedOut.apply(Runners.Effect.unregister(label, confirmation: \"r\"))\n1674|    #expect(await h.identities.load() == nil)\n1675|    #expect(await h.installerExecutor.calls.isEmpty)\n1676|    #expect(lastUnregistering(h.logger, id: label) == false)\n1677|    // Re-authenticate and retry through the normal entry: the side effect proceeds.\n1678|    await h.identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n1679|    await h.transport.append(removeTokenPayload())\n1680|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.unregister(label, confirmation: \"r\"))\n1681|    #expect(await h.installerExecutor.calls.count == 1)\n1682|    #expect(await h.catalog.load().first?.remoteAgentID == nil)\n1683|}\n1684|\n1685|/// R2-F1 bound: the scope-change refusal names the drift and is recoverable\n1686|/// through explicit re-verification — remove and re-add rebinds the catalog\n1687|/// original, after which Apply targets the new org (and only it).\n1688|@Test func scopeEditThenReAddReverifiesGroupApply() async throws {\n1689|    let h = await catalogHarness(\n1690|        launchResults: [stopped, stopped],\n1691|        transportResponses: [\n1692|            groupsPayload([(4, \"g\")]),\n1693|            groupRunnersPayload([(42, \"r\", false)]),\n1694|            groupReposPayload([1])\n1695|        ]\n1696|    )\n1697|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1698|    let label = \"actions.runner.test.scopeverify\"\n1699|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1700|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1701|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.loadGroupAccess(label))\n1702|    #expect(loadedGroupAccess(h.logger, id: label)?.group?.id == 4)\n1703|    // Same-host scope edit without re-verification: refused, no PUT.\n1704|    let runner = dir.appendingPathComponent(\".runner\")\n1705|    var object = try JSONSerialization.jsonObject(with: Data(contentsOf: runner)) as! [String: Any]\n1706|    object[\"gitHubUrl\"] = \"https://github.com/other-org\"\n1707|    try JSONSerialization.data(withJSONObject: object).write(to: runner)\n1708|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true))\n1709|    #expect(await h.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1710|    let refusal = groupAccessError(h.logger, id: label) ?? \"\"\n1711|    #expect(refusal.contains(\"acme\") && refusal.contains(\"other-org\"))\n1712|    // Explicit re-verification: remove and re-add rebinds the original.\n1713|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.removeFromApp(label))\n1714|    #expect(await h.catalog.load().isEmpty)\n1715|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.importFolder(dir))\n1716|    #expect(await h.catalog.load().count == 1)\n1717|    #expect(await h.catalog.load().first?.scope == \"other-org\")\n1718|    await h.transport.append(groupsPayload([(4, \"g\")]))\n1719|    await h.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1720|    await h.transport.append(groupReposPayload([1]))\n1721|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.loadGroupAccess(label))\n1722|    #expect(loadedGroupAccess(h.logger, id: label)?.group?.id == 4)\n1723|    await h.transport.append(groupsPayload([(4, \"g\")]))\n1724|    await h.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1725|    await h.transport.append(.init(status: 204, body: Data()))\n1726|    await h.transport.append(groupReposPayload([2]))\n1727|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true))\n1728|    let puts = await h.transport.requests.filter { $0.method == \"PUT\" }\n1729|    #expect(puts.count == 1)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
