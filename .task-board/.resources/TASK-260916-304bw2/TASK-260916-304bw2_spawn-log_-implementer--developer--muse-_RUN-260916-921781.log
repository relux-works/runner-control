\n31|    ) async throws -> GitHubAuth.TokenRecord {\n32|        // Fast path: another task already refreshed while we waited.\n33|        if let latest = await store.load(serverHost: config.serverHost, userID: userID, clientID: config.clientID),\n34|           latest.accessToken != current.accessToken {\n35|            return latest\n36|        }\n37|        if let flight = inFlight {\n38|            return try await flight.value\n39|        }\n40|        guard let refreshToken = current.refreshToken, !refreshToken.isEmpty else {\n41|            throw GitHubAuth.AuthError.tokenRefreshFailed\n42|        }\n43|        let transportCopy = transport\n44|        let storeCopy = store\n45|        let nowCopy = now\n46|        let task: Task<GitHubAuth.TokenRecord, Error> = Task {\n47|            let body = try JSONEncoder().encode(GitHubAuth.TokenRefreshRequest(\n48|                client_id: config.clientID,\n49|                grant_type: \"refresh_token\",\n50|                refresh_token: refreshToken\n51|            ))\n52|            let request = GitHubHTTPRequest(\n53|                method: \"POST\",\n54|                url: config.tokenURL,\n55|                headers: [\"Accept\": \"application/json\", \"Content-Type\": \"application/json\"],\n56|                body: body\n57|            )\n58|            let response: GitHubHTTPResponse\n59|            do {\n60|                response = try await transportCopy.send(request)\n61|            } catch {\n62|                throw GitHubAuth.AuthError.network(GitHubTransportError.offline.localizedDescription)\n63|            }\n64|            let decoded: GitHubAuth.TokenSuccessResponse\n65|            do {\n66|                decoded = try JSONDecoder().decode(GitHubAuth.TokenSuccessResponse.self, from: response.body)\n67|            } catch {\n68|                throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n69|            }\n70|            if let token = decoded.access_token, !token.isEmpty {\n71|                try GitHubAuth.PATGuard.validate(token: token)\n72|                let expiresAt: Date?\n73|                if let seconds = decoded.expires_in {\n74|                    expiresAt = nowCopy().addingTimeInterval(TimeInterval(seconds))\n75|                } else {\n76|                    expiresAt = nil\n77|                }\n78|                let next = GitHubAuth.TokenRecord(\n79|                    accessToken: token,\n80|                    refreshToken: decoded.refresh_token ?? refreshToken,\n81|                    expiresAt: expiresAt,\n82|                    obtainedAt: nowCopy()\n83|                )\n84|                // A superseding logout/login must not leave refreshed tokens behind.\n85|                if Task.isCancelled { throw CancellationError() }\n86|                try await storeCopy.save(next, serverHost: config.serverHost, userID: userID, clientID: config.clientID)\n87|                if Task.isCancelled {\n88|                    // Lost a race with cancel during the save: remove the orphan,\n89|                    // but never touch tokens a newer login may have stored since.\n90|                    if let current = await storeCopy.load(serverHost: config.serverHost, userID: userID, clientID: config.clientID),\n91|                       current.accessToken == next.accessToken {\n92|                        await storeCopy.delete(serverHost: config.serverHost, userID: userID, clientID: config.clientID)\n93|                    }\n94|                    throw CancellationError()\n95|                }\n96|                return next\n97|            }\n98|            if decoded.error == \"invalid_grant\" {\n99|                throw GitHubAuth.AuthError.revoked\n100|            }\n101|            throw GitHubAuth.AuthError.tokenRefreshFailed\n102|        }\n103|        inFlight = task\n104|        do {\n105|            let value = try await task.value\n106|            inFlight = nil\n107|            return value\n108|        } catch {\n109|            inFlight = nil\n110|            throw error\n111|        }\n112|    }\n113|\n114|    public static func isExpiringSoon(_ record: GitHubAuth.TokenRecord, now: Date = Date(), within seconds: TimeInterval = 60) -> Bool {\n115|        guard let expiresAt = record.expiresAt else { return false }\n116|        return expiresAt.timeIntervalSince(now) <= seconds\n117|    }\n118|}","final_result":true}}}
