ation.propertyList(from: data, format: nil) as? [String: Any] else {\n578|                throw RunnerError.message(\"Service manifest is unreadable.\")\n579|            }\n580|            object[\"RunAtLoad\"] = value\n581|            let out = try PropertyListSerialization.data(fromPropertyList: object, format: .xml, options: 0)\n582|            try out.write(to: plist, options: .atomic)\n583|            entry.runAtLoad = value\n584|            try await catalog.update(entry)\n585|            await action { Runners.Action.catalogCleared }\n586|            let snapshots = await service.snapshots()\n587|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n588|            await action { Runners.Action.refreshed(mapped_snapshots) }\n589|        } catch {\n590|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n591|        }\n592|    }\n593|\n594|    private func setAlias(id: String, alias: String?) async {\n595|        let entries = await catalog.load()\n596|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n597|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n(more lines below)","final_result":true}}}
