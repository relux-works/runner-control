{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a7","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":430,"recorded_at":1780531400000855,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a94f-ba99-72b0-ba6f-61e36747c52b"},"task_id":"01a0a94f-ba99-72b0-ba6f-61e36747c52b","event":{"kind":"output","task_id":"01a0a94f-ba99-72b0-ba6f-61e36747c52b","chunk":"Read text file `Targets/RunnerControl/Sources/ManagementWindowContainer.swift`.\n1|import AppKit\n2|import SwiftUI\n3|import RunnerControlCore\n4|\n5|/// Management window composition root. Reads Relux state, dispatches production effects.\n6|struct ManagementWindowContainer: View {\n7|    @ObservedObject var runners: Runners.State\n8|    @ObservedObject var github: GitHubAuth.State\n9|    @ObservedObject var registration: RunnerRegistration.State\n10|    @ObservedObject private var updater = AppRegistry.updater\n11|    @StateObject private var launchAtLogin = LaunchAtLoginModel()\n12|    @State private var serverHostText: String = \"github.com\"\n13|    @State private var showRegistration = false\n14|\n15|    var body: some View {\n16|        ManagementWindowPage(\n17|            props: .init(\n18|                runners: runners.runners,\n19|                changing: runners.changing,\n20|                runnerError: runners.lastError,\n21|                github: .init(\n22|                    connection: github.connection,\n23|                    username: github.username,\n24|                    serverHost: github.serverHost,\n25|                    serverHostText: serverHostText,\n26|                    installations: github.installations,\n27|                    selectedInstallationID: github.selectedInstallationID,\n28|                    repositories: github.repositories,\n29|                    selectedRepositoryIDs: github.selectedRepositoryIDs,\n30|                    syncError: github.syncError,\n31|                    lastSyncAt: github.lastSyncAt\n32|                ),\n33|                general: .init(\n34|                    appVersion: Bundle.main.object(forInfoDictionaryKey: \"CFBundleShortVersionString\") as? String ?? \"—\",\n35|                    canCheckForUpdates: updater.canCheckForUpdates,\n36|                    automaticChecks: updater.automaticallyChecks,\n37|                    automaticDownloads: updater.automaticallyDownloads,\n38|                    launchAtLoginEnabled: launchAtLogin.enabled\n39|                )\n40|            ),\n41|            reactions: .init(\n42|                setEnabled: change,\n43|                enableAll: { for runner in runners.runners where [.stopped, .failed].contains(runner.status) { change(runner.id, true) } },\n44|                disableAll: { confirmStop(ids: runners.runners.map(\\.id)) },\n45|                openGitHub: { NSWorkspace.shared.open($0.githubURL) },\n46|                openLogs: { NSWorkspace.shared.open($0.logs) },\n47|                showDirectory: { NSWorkspace.shared.open($0.directory) },\n48|                clearRunnerError: { Task { await action { Runners.Action.clearError } } },\n49|                openRegistration: { showRegistration = true },\n50|                serverHostChanged: { serverHostText = $0 },\n51|                beginLogin: beginLogin,\n52|                cancelLogin: { Task { await action { GitHubAuth.Effect.cancelLogin } } },\n53|                logout: { Task { await action { GitHubAuth.Effect.logout } } },\n54|                openVerification: { NSWorkspace.shared.open($0) },\n55|                copyCode: copyCode,\n56|                refreshInstallations: { Task { await action { GitHubAuth.Effect.refreshInstallations } } },\n57|                selectInstallation: { id in Task { await action { GitHubAuth.Effect.selectInstallation(id) } } },\n58|                selectRepositories: { ids in Task { await action { GitHubAuth.Effect.selectRepositories(ids) } } },\n59|                grantAccess: { NSWorkspace.shared.open(URL(string: \"https://github.com/settings/installations\")!) },\n60|                revokeInGitHub: { NSWorkspace.shared.open(URL(string: \"https://github.com/settings/connections/applications\")!) },\n61|                checkForUpdates: updater.check,\n62|                setAutomaticChecks: updater.setAutomaticChecks,\n63|                setAutomaticDownloads: updater.setAutomaticDownloads,\n64|                setLaunchAtLogin: { launchAtLogin.setEnabled($0) },\n65|                quit: quit\n66|            )\n67|        )\n68|        .sheet(isPresented: $showRegistration) {\n69|            RunnerRegistrationContainer(\n70|                registration: registration,\n71|                github: github,\n72|                close: { showRegistration = false }\n73|            )\n74|        }\n75|    }\n76|\n77|    private func beginLogin() {\n78|        let host = serverHostText.trimmingCharacters(in: .whitespacesAndNewlines)\n79|        let value = host.isEmpty ? nil : host\n80|        Task { await action { GitHubAuth.Effect.beginLogin(serverHost: value) } }\n81|    }\n82|\n83|    private func copyCode(_ code: String) {\n84|        NSPasteboard.general.clearContents()\n85|        NSPasteboard.general.setString(code, forType: .string)\n86|    }\n87|\n88|    private func change(_ id: String, _ enabled: Bool) {\n89|        if enabled { Task { await action { Runners.Effect.setEnabled(id, true) } } }\n90|        else { confirmStop(ids: [id]) }\n91|    }\n92|\n93|    private func confirmStop(ids: [String]) {\n94|        let alert = NSAlert()\n95|        alert.messageText = \"Выключить CI?\"\n96|        alert.informativeText = \"Если раннер сейчас выполняет сборку, она будет прервана. Новые задания он принимать не будет.\"\n97|        alert.addButton(withTitle: \"Отмена\")\n98|        alert.addButton(withTitle: \"Выключить\")\n99|        guard alert.runModal() == .alertSecondButtonReturn else { return }\n100|        Task { for id in ids { await action { Runners.Effect.setEnabled(id, false) } } }\n101|    }\n102|\n103|    private func quit() {\n104|        guard runners.changing.isEmpty else { return }\n105|        if runners.runners.contains(where: { $0.status == .running || $0.status == .failed || $0.status == .unknown }) {\n106|            let alert = NSAlert()\n107|            alert.messageText = \"Закрыть Runner Control?\"\n108|            alert.informativeText = \"Включённые раннеры продолжат работать в фоне. Для остановки CI сначала нажмите «Выключить все».\"\n109|            alert.addButton(withTitle: \"Остаться\")\n110|            alert.addButton(withTitle: \"Закрыть приложение\")\n111|            guard alert.runModal() == .alertSecondButtonReturn else { return }\n112|        }\n113|        NSApp.terminate(nil)\n114|    }\n115|}","final_result":true}}}
