ail ?? entry.scope\n720|            entry.scopeKind = info.scopeKind ?? entry.scopeKind\n721|            entry.remoteAgentID = info.agentID ?? entry.remoteAgentID\n722|            entry.workFolder = info.workFolder ?? entry.workFolder\n723|            try await catalog.update(entry)\n724|            await action { Runners.Action.catalogCleared }\n725|            let snapshots = await service.snapshots()\n726|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n727|            await action { Runners.Action.refreshed(mapped_snapshots) }\n728|        } catch {\n729|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n730|        }\n731|    }\n732|\n733|    // MARK: - Diagnostics\n734|\n735|    private func loadLog(id: String) async {\n736|        let snapshots = await service.snapshots()\n737|        guard let snapshot = snapshots.first(where: { $0.id == id }) else {\n738|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n739|            return\n740|        }\n741|        let excerpt = RunnerDiagnostics.tail(definition: snapshot.definition)\n742|        await action { Runners.Action.logLoaded(title: snapshot.definition.displayTitle, excerpt: excerpt) }\n743|    }\n744|\n745|    // MARK: - Group access (fresh API membership)\n746|\n747|    private struct VerifiedOrgRunner: Sendable {\n748|        let entry: RunnerCatalogStore.Entry\n749|        let directory: URL\n750|        let org: String\n751|        let agentID: Int64\n752|        let agentName: String\n753|    }\n754|\n(more lines below)","final_result":true}}}
