th.AppConfig,\n453|        token: String,\n454|        org: String,\n455|        groupID: Int64,\n456|        selectedRepositoryIDs: Set<Int64>\n457|    ) async throws {\n458|        let payload = SetGroupRepositoriesDTO(selectedRepositoryIDs: Array(selectedRepositoryIDs).sorted())\n459|        let body = try JSONEncoder().encode(payload)\n460|        do {\n461|            _ = try await send(\n462|                method: \"PUT\", config: config,\n463|                path: \"orgs/\\(org)/actions/runner-groups/\\(groupID)/repositories\", token: token, body: body\n464|            )\n465|        } catch let error as RunnerRegistration.RegistrationError {\n466|            if case .forbidden(let text) = error {\n467|                throw RunnerRegistration.RegistrationError.missingPermission(\n468|                    permissionHelp(scope: .organization(org: org), detail: text)\n469|                )\n470|            }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
