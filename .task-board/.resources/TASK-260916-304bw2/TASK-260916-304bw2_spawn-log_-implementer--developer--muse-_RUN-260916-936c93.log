{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ee01","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":5467,"recorded_at":1780531400010929,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a979-e729-7620-94bb-a94dfdc27d89"},"task_id":"01a0a979-e729-7620-94bb-a94dfdc27d89","event":{"kind":"output","task_id":"01a0a979-e729-7620-94bb-a94dfdc27d89","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n(815 line(s) above)\n816|@Test func runAtLoadChangePreservesManifestAndSkipsLaunchctl() async throws {\n817|    let harness = await catalogHarness()\n818|    defer { try? FileManager.default.removeItem(at: harness.home) }\n819|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", runAtLoad: true, label: \"actions.runner.test.policy\")\n820|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.policy\"))\n821|    // Snapshots after the edit need one print.\n822|    await harness.transport.prepend(runnersListPayload([]))\n823|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.setRunAtLoad(\"actions.runner.test.policy\", false))\n824|    // The snapshots print has no queued result, so the edit still applied; check the file + catalog.\n825|    let plist = try PropertyListSerialization.propertyList(from: Data(contentsOf: dir.appendingPathComponent(\"manual-service.plist\")), format: nil) as! [String: Any]\n826|    #expect((plist[\"RunAtLoad\"] as? Bool) == false)\n827|    #expect(plist[\"Label\"] as? String == \"actions.runner.test.policy\")\n828|    let entries = await harness.catalog.load()\n829|    #expect(entries.first?.runAtLoad == false)\n830|    for call in await harness.launchExecutor.calls {\n831|        #expect(!call.contains(\"bootstrap\") && !call.contains(\"bootout\"))\n832|    }\n833|}\n834|\n835|@Test func relinkRequiresSameAgent() async throws {\n836|    let harness = await catalogHarness()\n837|    defer { try? FileManager.default.removeItem(at: harness.home) }\n838|    let a = try makeRunnerDir(parent: harness.home, name: \"a\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.relink\")\n839|    let b = try makeRunnerDir(parent: harness.home, name: \"b\", agentName: \"r\", scope: \"acme\", agentID: 99, label: \"actions.runner.test.other\")\n840|    try await harness.catalog.add(unregisterEntry(dir: a, label: \"actions.runner.test.relink\"))\n841|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.relinkDirectory(\"actions.runner.test.relink\", b))\n842|    #expect(catalogErr(harness.logger).contains(\"not 42\"))\n843|    #expect(await harness.catalog.load().first?.directoryPath == a.path)\n844|}\n845|\n(more lines below)","final_result":true}}}
