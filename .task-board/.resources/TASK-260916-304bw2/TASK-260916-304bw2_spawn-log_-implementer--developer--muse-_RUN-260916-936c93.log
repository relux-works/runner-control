\"\\\"        let copy = loginRegistrationURL(label: definition.id, home: home)\\n        guard let data = try? Data(contentsOf: copy),\\n              let object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],\\n              references(object, definition: definition) else {\\n            return false\\n        }\\\"\\\"\\\",\\n \\\"\\\"\\\"        let copy = loginRegistrationURL(label: definition.id, home: home)\\n        guard let data = try? Data(contentsOf: copy),\\n              let object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],\\n              references(object, definition: definition) else {\\n            let external = (try? Data(contentsOf: definition.plist)).flatMap {\\n                try? PropertyListSerialization.propertyList(from: $0, format: nil) as? [String: Any]\\n            }\\n            return (external?[\\\"RunAtLoad\\\"] as? Bool) ?? false\\n        }\\\"\\\"\\\",\\n \\\"manualExternalRunAtLoadTrueDisplaysLoginOff\\\")\\n\\nF = \\\"Packages/RunnerControlCore/Sources/Runners+Flow.swift\\\"\\nrun_mutant(\\\"toggle-on-skips-registration-write\\\", F,\\n \\\"\\\"\\\"            var registration = object\\n            registration[\\\"Label\\\"] = entry.serviceLabel\\n            registration[\\\"WorkingDirectory\\\"] = directory.path\\n            registration[\\\"ProgramArguments\\\"] = [directory.appendingPathComponent(\\\"runsvc.sh\\\").path]\\n            registration[\\\"RunAtLoad\\\"] = true\\n            let out = try PropertyListSerialization.data(fromPropertyList: registration, format: .xml, options: 0)\\n            try FileManager.default.createDirectory(at: copy.deletingLastPathComponent(), withIntermediateDirectories: true)\\n            try out.write(to: copy, options: .atomic)\\n            return\\\"\\\"\\\",\\n \\\"\\\"\\\"            _ = object\\n            return\\\"\\\"\\\",\\n \\\"manualToggleOnRegistersLoginWithoutChangingLiveState\\\")\\nrun_mutant(\\\"toggle-admits-foreign-overwrite\\\", F,\\n \\\"\\\"\\\"                guard RunnerControllers.references(current, definition: definition) else {\\n                    throw RunnerError.message(\\\"Login slot '\\\\\\\\(copy.lastPathComponent)' belongs to another service. Remove it by hand instead of overwriting.\\\")\\n                }\\\"\\\"\\\",\\n \\\"\\\"\\\"                _ = current\\\"\\\"\\\",\\n \\\"manualToggleRefusesForeignPlist\\\")\\nrun_mutant(\\\"toggle-stops-live-service\\\", F,\\n \\\"\\\"\\\"            } else {\\n                try setManualLogin(entry: entry, directory: directory, enabled: value)\\n            }\\\"\\\"\\\",\\n \\\"\\\"\\\"            } else {\\n                try setManualLogin(entry: entry, directory: directory, enabled: value)\\n                try? await service.setEnabled(false, id: id)\\n            }\\\"\\\"\\\",\\n \\\"manualToggleOnRegistersLoginWithoutChangingLiveState\\\")\\nPY\",\n  \"description\": \"Run login gate mutants\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"login-admits-external-runatload: FAIL-as-expected\\ntoggle-on-skips-registration-write: FAIL-as-expected\\ntoggle-admits-foreign-overwrite: FAIL-as-expected\\ntoggle-stops-live-service: FAIL-as-expected\\n\",\n  \"original_output_bytes\": 197,\n  \"original_output_tokens\": 50,\n  \"truncated\": false\n}","final_result":true}}}
