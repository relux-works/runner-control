{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c527","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":238,"recorded_at":1780531400000471,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a94f-8207-71e2-bb6c-1034f0f68cf5"},"task_id":"01a0a94f-8207-71e2-bb6c-1034f0f68cf5","event":{"kind":"output","task_id":"01a0a94f-8207-71e2-bb6c-1034f0f68cf5","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+State+Reducer.swift`.\n1|import Relux\n2|extension Runners.State {\n3|    public func reduce(with action: any Relux.Action) async {\n4|        guard let action = action as? Runners.Action else { return }\n5|        switch action {\n6|        case .refreshed(let snapshots): runners = snapshots\n7|        case .changing(let id, let value):\n8|            if value { changing.insert(id) } else { changing.remove(id) }\n9|        case .failed(let message): lastError = message\n10|        case .clearError: lastError = nil\n11|        }\n12|    }\n13|}","final_result":true}}}
