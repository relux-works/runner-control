{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c64f","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":386,"recorded_at":1780531400000767,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"call_id":"call_01a0a94fa24b73d280e11258c8738efd","text":"Read text file `Targets/RunnerControl/Sources/App.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|@main\n5|struct RunnerControl: App {\n6|    @NSApplicationDelegateAdaptor(AppDelegate.self) private var delegate\n7|    @StateObject private var state = AppRegistry.state\n8|    var body: some Scene {\n9|        MenuBarExtra {\n10|            RunnerContainer(state: state)\n11|        } label: {\n12|            Image(systemName: state.activeCount > 0 ? \"bolt.circle.fill\" : \"bolt.circle\")\n13|                .accessibilityLabel(\"Runner Control: \\(state.activeCount) включено\")\n14|        }\n15|        .menuBarExtraStyle(.window)\n16|    }\n17|}\n18|\n19|@MainActor final class AppDelegate: NSObject, NSApplicationDelegate {\n20|    private var window: NSWindow?\n21|    func applicationDidFinishLaunching(_ notification: Notification) {\n22|        NSApp.setActivationPolicy(.accessory)\n23|        AppRegistry.start()\n24|        NotificationCenter.default.addObserver(\n25|            forName: .openManagementWindow,\n26|            object: nil,\n27|            queue: .main\n28|        ) { [weak self] _ in\n29|            Task { @MainActor in self?.showControls() }\n30|        }\n31|        if !UserDefaults.standard.bool(forKey: \"hasShownWelcome\") {\n32|            showControls()\n33|            UserDefaults.standard.set(true, forKey: \"hasShownWelcome\")\n34|        }\n35|    }\n36|    func applicationShouldHandleReopen(_ sender: NSApplication, hasVisibleWindows flag: Bool) -> Bool {\n37|        showControls()\n38|        return true\n39|    }\n40|    private func showControls() {\n41|        if window == nil {\n42|            let controller = NSHostingController(rootView: ManagementWindowContainer(\n43|                runners: AppRegistry.state,\n44|                github: AppRegistry.githubState,\n45|                registration: AppRegistry.registrationState\n46|            ))\n47|            let value = NSWindow(contentViewController: controller)\n48|            value.title = \"Раннеры и настройки\"\n49|            value.styleMask = [.titled, .closable, .miniaturizable, .resizable]\n50|            value.isReleasedWhenClosed = false\n51|            value.setContentSize(NSSize(width: 760, height: 540))\n52|            value.minSize = NSSize(width: 700, height: 480)\n53|            value.center()\n54|            window = value\n55|        }\n56|        window?.makeKeyAndOrderFront(nil)\n57|        NSApp.activate(ignoringOtherApps: true)\n58|    }\n59|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
