{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c707","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":478,"recorded_at":1780531400000951,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a94f-cc01-7242-8be1-9e18d03fa3c0"},"task_id":"01a0a94f-cc01-7242-8be1-9e18d03fa3c0","event":{"kind":"output","task_id":"01a0a94f-cc01-7242-8be1-9e18d03fa3c0","chunk":"Read text file `Packages/RunnerControlCore/Sources/CommandExecutor.swift`.\n1|import Foundation\n2|public struct CommandResult: Sendable, Equatable {\n3|    public let code: Int32\n4|    public let output: String\n5|    public init(code: Int32, output: String) { self.code = code; self.output = output }\n6|}\n7|public protocol CommandExecuting: Sendable {\n8|    func run(_ executable: String, _ arguments: [String]) async throws -> CommandResult\n9|}\n10|public enum RunnerError: LocalizedError, Sendable {\n11|    case message(String)\n12|    public var errorDescription: String? { if case .message(let text) = self { text } else { nil } }\n13|}\n14|public actor CommandExecutor: CommandExecuting {\n15|    public init() {}\n16|    public func run(_ executable: String, _ arguments: [String]) async throws -> CommandResult {\n17|        // File-backed output avoids pipe-buffer deadlocks from launchctl print.\n18|        let url = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)\n19|        FileManager.default.createFile(atPath: url.path, contents: nil, attributes: [.posixPermissions: 0o600])\n20|        defer { try? FileManager.default.removeItem(at: url) }\n21|        let handle = try FileHandle(forWritingTo: url)\n22|        defer { try? handle.close() }\n23|        let process = Process()\n24|        process.executableURL = URL(fileURLWithPath: executable)\n25|        process.arguments = arguments\n26|        process.standardOutput = handle; process.standardError = handle\n27|        try process.run()\n28|        let deadline = ContinuousClock.now.advanced(by: .seconds(12))\n29|        while process.isRunning {\n30|            if Task.isCancelled || ContinuousClock.now >= deadline {\n31|                process.terminate()\n32|                for _ in 0..<20 where process.isRunning { try? await Task.sleep(for: .milliseconds(50)) }\n33|                if process.isRunning { kill(process.processIdentifier, SIGKILL) }\n34|                throw RunnerError.message(\"Команда не завершилась вовремя. Обновите статус и попробуйте снова.\")\n35|            }\n36|            try? await Task.sleep(for: .milliseconds(40))\n37|        }\n38|        let read = try FileHandle(forReadingFrom: url)\n39|        defer { try? read.close() }\n40|        let data = try read.read(upToCount: 131072) ?? Data()\n41|        return CommandResult(code: process.terminationStatus, output: String(decoding: data, as: UTF8.self))\n42|    }\n43|}","final_result":true}}}
