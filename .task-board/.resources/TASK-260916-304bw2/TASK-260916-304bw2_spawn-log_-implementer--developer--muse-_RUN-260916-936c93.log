{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d3d3","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":2116,"recorded_at":1780531400004227,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a95c-dbe4-7de2-9766-16df448472fc"},"task_id":"01a0a95c-dbe4-7de2-9766-16df448472fc","event":{"kind":"output","task_id":"01a0a95c-dbe4-7de2-9766-16df448472fc","chunk":"Read text file `Targets/RunnerControl/Sources/RunnerCard.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|struct RunnerCard: View {\n5|    let snapshot: Runners.Snapshot\n6|    let changing: Bool\n7|    let setEnabled: (Bool) -> Void\n8|    let openGitHub: () -> Void\n9|    let openLogs: () -> Void\n10|    var body: some View {\n11|        VStack(alignment: .leading, spacing: 9) {\n12|            HStack {\n13|                VStack(alignment: .leading, spacing: 4) {\n14|                    Text(snapshot.definition.title).font(.system(size: 13, weight: .semibold))\n15|                    Text(snapshot.definition.detail).font(.system(size: 10)).foregroundStyle(.secondary)\n16|                }\n17|                Spacer(minLength: 6)\n18|                if changing { ProgressView().controlSize(.small) }\n19|                Toggle(snapshot.definition.title, isOn: Binding(get: { snapshot.status == .running }, set: setEnabled))\n20|                    .labelsHidden().toggleStyle(.switch).controlSize(.small).tint(.teal)\n21|                    .disabled(changing || [.checking, .missing, .unknown].contains(snapshot.status))\n22|                    .accessibilityIdentifier(\"Runners menu \\(snapshot.definition.title) toggle\")\n23|            }\n24|            HStack(spacing: 5) {\n25|                Circle().fill(color).frame(width: 5, height: 5)\n26|                Text(changing ? \"Меняем состояние…\" : snapshot.status.title).font(.system(size: 11)).foregroundStyle(.secondary)\n27|                Spacer()\n28|                Button(action: openLogs) { Image(systemName: \"doc.text.magnifyingglass\") }.help(\"Открыть журналы\")\n29|                Button(action: openGitHub) { Image(systemName: \"arrow.up.right.square\") }.help(\"Открыть раннеры в GitHub\")\n30|            }.buttonStyle(.plain).foregroundStyle(.secondary)\n31|            if let message = snapshot.message {\n32|                Text(message).font(.caption2).foregroundStyle(.orange).lineLimit(3)\n33|            }\n34|        }.padding(13).background(.primary.opacity(0.04), in: RoundedRectangle(cornerRadius: 12))\n35|    }\n36|    private var color: Color {\n37|        switch snapshot.status {\n38|        case .running: .green\n39|        case .failed, .missing, .unknown: .orange\n40|        default: .secondary.opacity(0.6)\n41|        }\n42|    }\n43|}","final_result":true}}}
