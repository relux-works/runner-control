{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf83","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":1564,"recorded_at":1780531400003123,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a956-d588-7413-aff4-bc867df88b84"},"task_id":"01a0a956-d588-7413-aff4-bc867df88b84","event":{"kind":"output","task_id":"01a0a956-d588-7413-aff4-bc867df88b84","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+Service.swift`.\n1|import Foundation\n2|public protocol RunnerServicing: Sendable {\n3|    func snapshots() async -> [Runners.Snapshot]\n4|    func setEnabled(_ enabled: Bool, id: String) async throws\n5|}\n6|public actor LaunchAgentService: RunnerServicing {\n7|    private let definitions: [Runners.Definition]\n8|    private let executor: any CommandExecuting\n9|    private let domain: String\n10|    public init(definitions: [Runners.Definition] = Runners.Definition.installed(), executor: any CommandExecuting = CommandExecutor(), userID: UInt32 = getuid()) {\n11|        self.definitions = definitions; self.executor = executor; domain = \"gui/\\(userID)\"\n12|    }\n13|    public static func status(from result: CommandResult) -> Runners.Status {\n14|        if result.code == 0 { return result.output.contains(\"state = running\") ? .running : .failed }\n15|        if result.code == 113 && result.output.contains(\"Could not find service\") { return .stopped }\n16|        return .unknown\n17|    }\n18|    private func validate(_ definition: Runners.Definition) throws {\n19|        let data = try Data(contentsOf: definition.plist)\n20|        guard let plist = try PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],\n21|              plist[\"Label\"] as? String == definition.id,\n22|              let args = plist[\"ProgramArguments\"] as? [String],\n23|              args == [definition.directory.appendingPathComponent(\"runsvc.sh\").path],\n24|              plist[\"WorkingDirectory\"] as? String == definition.directory.path else {\n25|            throw RunnerError.message(\"Настройки службы не соответствуют раннеру \\(definition.title).\")\n26|        }\n27|        guard !definition.directory.path.contains(\" \") else { throw RunnerError.message(\"Путь раннера содержит пробел. Исправьте путь перед запуском.\") }\n28|        let registration = try Data(contentsOf: definition.directory.appendingPathComponent(\".runner\"))\n29|        // GitHub writes a UTF-8 BOM; JSONSerialization accepts it.\n30|        guard let object = try JSONSerialization.jsonObject(with: registration) as? [String: Any],\n31|              let work = object[\"workFolder\"] as? String, !work.contains(\" \") else {\n32|            throw RunnerError.message(\"Рабочий каталог раннера отсутствует или содержит пробел.\")\n33|        }\n34|    }\n35|    public func snapshots() async -> [Runners.Snapshot] {\n36|        var values: [Runners.Snapshot] = []\n37|        for d in definitions {\n38|            do {\n39|                try validate(d)\n40|                let result = try await executor.run(\"/bin/launchctl\", [\"print\", domain + \"/\" + d.id])\n41|                let status = Self.status(from: result)\n42|                values.append(.init(definition: d, status: status, message: status == .unknown ? String(result.output.prefix(300)) : nil))\n43|            } catch { values.append(.init(definition: d, status: .missing, message: error.localizedDescription)) }\n44|        }\n45|        return values\n46|    }\n47|    public func setEnabled(_ enabled: Bool, id: String) async throws {\n48|        guard let d = definitions.first(where: { $0.id == id }) else { throw RunnerError.message(\"Неизвестный раннер.\") }\n49|        // Stop must remain possible even if someone damages registration/plist.\n50|        if enabled { try validate(d) }\n51|        let key = domain + \"/\" + d.id\n52|        let current = try await executor.run(\"/bin/launchctl\", [\"print\", key])\n53|        let state = Self.status(from: current)\n54|        if !enabled && state == .stopped || enabled && state == .running { return }\n55|        guard state != .unknown else { throw RunnerError.message(String(current.output.prefix(500))) }\n56|        if enabled && state == .failed {\n57|            let removed = try await executor.run(\"/bin/launchctl\", [\"bootout\", key])\n58|            guard removed.code == 0 else { throw RunnerError.message(removed.output) }\n59|        }\n60|        let result = try await executor.run(\"/bin/launchctl\", enabled ? [\"bootstrap\", domain, d.plist.path] : [\"bootout\", key])\n61|        guard result.code == 0 else { throw RunnerError.message(String(result.output.prefix(700))) }\n62|        for _ in 0..<30 {\n63|            let result = try await executor.run(\"/bin/launchctl\", [\"print\", key])\n64|            if Self.status(from: result) == (enabled ? .running : .stopped) { return }\n65|            try await Task.sleep(for: .milliseconds(100))\n66|        }\n67|        throw RunnerError.message(\"Служба не подтвердила изменение состояния. Проверьте журнал раннера.\")\n68|    }\n69|}","final_result":true}}}
