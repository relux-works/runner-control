{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d8b7","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":2742,"recorded_at":1780531400005479,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a960-52ec-7111-ba43-a111fd6b62c1"},"task_id":"01a0a960-52ec-7111-ba43-a111fd6b62c1","event":{"kind":"output","task_id":"01a0a960-52ec-7111-ba43-a111fd6b62c1","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n1|import CryptoKit\n2|import Foundation\n3|import Testing\n4|import Relux\n5|@testable import RunnerControlCore\n6|\n7|// MARK: - Registration harness (production entry points, controlled IO)\n8|\n9|// TestTransport, jsonResponse, and testConfig are shared from GitHubTransportTests.\n10|\n11|private struct RegistrationHarness {\n12|    let flow: RunnerRegistration.Flow\n13|    let logger: Relux.Testing.Logger\n14|    let transport: TestTransport\n15|    let userStore: GitHubKeychainStore\n16|    let identities: InMemoryGitHubSessionIdentityStore\n17|    let registrationTokens: RunnerRegistrationTokenStore\n18|    let installer: RunnerInstallerService\n19|    let home: URL\n20|    let installRoot: URL\n21|}\n22|\n23|private func registrationHarness(\n24|    transport: TestTransport,\n25|    downloader: (@Sendable (URL) async throws -> Data)? = nil,\n26|    executor: (any CommandExecuting)? = nil,\n27|    arch: String = \"arm64\",\n28|    seedAuth: Bool = true\n29|) async -> RegistrationHarness {\n30|    let logger = Relux.Testing.Logger()\n31|    let dispatcher = Relux.Dispatcher(logger: logger)\n32|    let userStore = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n33|    let identities = InMemoryGitHubSessionIdentityStore()\n34|    if seedAuth {\n35|        await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n36|        try? await userStore.save(\n37|            GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n38|            serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n39|        )\n40|    }\n41|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"RegHome-\" + UUID().uuidString)\n42|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n43|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n44|    let archCopy = arch\n45|    let installer = RunnerInstallerService(\n46|        installRoot: installRoot,\n47|        downloader: downloader,\n48|        executor: executor,\n49|        currentArch: { archCopy }\n50|    )\n51|    let api = GitHubRunnerAPIClient(transport: transport)\n52|    let registrationTokens = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n53|    let refresher = GitHubTokenRefresh(transport: transport, store: userStore)\n54|    let flow = await RunnerRegistration.Flow(\n55|        api: api, installer: installer, registrationTokens: registrationTokens,\n56|        userStore: userStore, identityStore: identities, refresher: refresher,\n57|        configProvider: { _ in testConfig }, dispatcher: dispatcher\n58|    )\n59|    return RegistrationHarness(\n60|        flow: flow, logger: logger, transport: transport, userStore: userStore,\n61|        identities: identities, registrationTokens: registrationTokens,\n62|        installer: installer, home: home, installRoot: installRoot\n63|    )\n64|}\n65|\n66|private func registrationActions(_ logger: Relux.Testing.Logger) -> [RunnerRegistration.Action] {\n67|    logger.actions.compactMap { $0 as? RunnerRegistration.Action }\n68|}\n69|\n70|private func lastFailure(_ logger: Relux.Testing.Logger) -> (message: String, step: String)? {\n71|    for action in registrationActions(logger).reversed() {\n72|        switch action {\n73|        case .failed(let message, let step): return (message, step)\n74|        case .permissionDenied(let message, let step): return (message, step)\n75|        default: break\n76|        }\n77|    }\n78|    return nil\n79|}\n80|\n(more lines below)","final_result":true}}}
