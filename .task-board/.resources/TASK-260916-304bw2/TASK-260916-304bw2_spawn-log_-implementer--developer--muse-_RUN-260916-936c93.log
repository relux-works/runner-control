{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf2d","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":1521,"recorded_at":1780531400003037,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a956-b0d1-7063-af7a-fe94415bcf02"},"task_id":"01a0a956-b0d1-7063-af7a-fe94415bcf02","event":{"kind":"output","task_id":"01a0a956-b0d1-7063-af7a-fe94415bcf02","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerControllers.swift`.\n1|import Foundation\n2|\n3|/// Controller capabilities for one definition. Managed kinds use launchctl;\n4|/// unsupported entries are read-only.\n5|public enum RunnerControllers {\n6|    /// Refuses control of unsupported entries with an explicit reason.\n7|    /// Never creates a second process and never fakes a toggle.\n8|    public static func requireControllable(_ definition: Runners.Definition) throws {\n9|        if definition.controllerKind == .unsupported {\n10|            throw RunnerError.message(\n11|                \"Runner «\\(definition.displayTitle)» uses unsupported management. Control it with its own supervisor instead of Runner Control.\"\n12|            )\n13|        }\n14|    }\n15|\n16|    /// Re-validates configuration immediately before a start. Start is\n17|    /// blocked on any mismatch; stop stays possible when registration or\n18|    /// manifest is damaged (the service identity alone is enough to bootout).\n19|    /// Import-time checks (binaries, server/scope) live in discovery\n20|    /// candidates so existing fixtures and running services are not broken\n21|    /// by stricter start gates.\n22|    public static func validateForStart(_ definition: Runners.Definition) throws {\n23|        try requireControllable(definition)\n24|        try validateManifestMatches(definition)\n25|        try validateNoSpace(definition)\n26|        try validateWorkFolder(definition)\n27|    }\n28|\n29|    public static func validateManifestMatches(_ definition: Runners.Definition) throws {\n30|        let data: Data\n31|        do {\n32|            data = try Data(contentsOf: definition.plist)\n33|        } catch {\n34|            throw RunnerError.manifestMismatch(\"Service manifest is missing for «\\(definition.displayTitle)».\")\n35|        }\n36|        guard let plist = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],\n37|              plist[\"Label\"] as? String == definition.id,\n38|              let args = plist[\"ProgramArguments\"] as? [String],\n39|              args == [definition.directory.appendingPathComponent(\"runsvc.sh\").path],\n40|              plist[\"WorkingDirectory\"] as? String == definition.directory.path else {\n41|            throw RunnerError.manifestMismatch(\"Настройки службы не соответствуют раннеру \\(definition.title).\")\n42|        }\n43|    }\n44|\n45|    public static func validateNoSpace(_ definition: Runners.Definition) throws {\n46|        if definition.directory.path.contains(\" \") {\n47|            throw RunnerError.noSpacePath(\"Путь раннера содержит пробел. Исправьте путь перед запуском.\")\n48|        }\n49|        let registration = try? Data(contentsOf: definition.directory.appendingPathComponent(\".runner\"))\n50|        if let registration,\n51|           let object = try? JSONSerialization.jsonObject(with: registration) as? [String: Any],\n52|           let work = object[\"workFolder\"] as? String, work.contains(\" \") {\n53|            throw RunnerError.noSpacePath(\"Рабочий каталог раннера отсутствует или содержит пробел.\")\n54|        }\n55|    }\n56|\n57|    public static func validateWorkFolder(_ definition: Runners.Definition) throws {\n58|        let url = definition.directory.appendingPathComponent(\".runner\")\n59|        guard let data = try? Data(contentsOf: url),\n60|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any],\n61|              let work = object[\"workFolder\"] as? String, !work.isEmpty, !work.contains(\" \") else {\n62|            throw RunnerError.message(\"Рабочий каталог раннера отсутствует или содержит пробел.\")\n63|        }\n64|    }\n65|\n66|    /// Import-time registration check: name and server/scope must be defined.\n67|    /// Used by discovery candidates, not by the start gate.\n68|    public static func validateRegistration(_ definition: Runners.Definition) throws {\n69|        try validateWorkFolder(definition)\n70|        // Server/scope must be defined; the label format is never trusted.\n71|        let info = RunnerRegistrationReader.read(directory: definition.directory)\n72|        if (info?.agentName ?? \"\").isEmpty {\n73|            throw RunnerError.message(\"Registration name is missing for «\\(definition.displayTitle)».\")\n74|        }\n75|        if info?.serverHost == nil || info?.scopeDetail == nil {\n76|            throw RunnerError.message(\"Server or scope is undefined for «\\(definition.displayTitle)».\")\n77|        }\n78|    }\n79|\n80|    public static func validateBinaries(_ definition: Runners.Definition) throws {\n81|        let fm = FileManager.default\n82|        if !fm.fileExists(atPath: definition.directory.appendingPathComponent(\"runsvc.sh\").path) {\n83|            throw RunnerError.message(\"runsvc.sh is missing for «\\(definition.displayTitle)». Reinstall before starting.\")\n84|        }\n85|        if !fm.fileExists(atPath: definition.directory.appendingPathComponent(\"run.sh\").path) {\n86|            throw RunnerError.message(\"run.sh is missing for «\\(definition.displayTitle)». Reinstall before starting.\")\n87|        }\n88|    }\n89|}","final_result":true}}}
