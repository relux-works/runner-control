{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8ab","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":688,"recorded_at":1780531400001371,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a950-5226-7440-9ca9-95ac94bf1bc3"},"task_id":"01a0a950-5226-7440-9ca9-95ac94bf1bc3","event":{"kind":"output","task_id":"01a0a950-5226-7440-9ca9-95ac94bf1bc3","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n(499 line(s) above)\n500|            \"WorkingDirectory\": directory.path,\n501|            \"RunAtLoad\": false\n502|        ]\n503|        let data = try PropertyListSerialization.data(fromPropertyList: payload, format: .xml, options: 0)\n504|        try data.write(to: plist, options: .atomic)\n505|        let scopeKey = loadMarker(directory: directory)?.scopeKey ?? \"\"\n506|        try markCompleted(Self.stepServiceReady, directory: directory, scopeKey: scopeKey)\n507|        return plist\n508|    }\n509|\n510|    /// Removes a failed partial install so retries start clean. Refuses to\n511|    /// touch directories that already hold a registration (`.runner`) or an\n512|    /// unknown marker scope: recovery never deletes a working runner.\n513|    public func recoverPartialInstall(directory: URL, scopeKey: String) throws {\n514|        let files = FileManager.default\n515|        guard files.fileExists(atPath: directory.path) else { return }\n516|        // Never delete while the installer lease is held by a live\n517|        // operation; the caller retries after that operation settles.\n518|        try requireIdleInstaller(directory)\n519|        guard !files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n520|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: directory.lastPathComponent)\n521|        }\n522|        if let marker = loadMarker(directory: directory), marker.scopeKey != scopeKey {\n523|            throw RunnerRegistration.RegistrationError.alreadyInstalled(path: directory.path)\n524|        }\n525|        try files.removeItem(at: directory)\n526|    }\n527|}","final_result":true}}}
