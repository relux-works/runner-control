{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c9","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":575,"recorded_at":1780531400001145,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a94f-e82d-7e62-bc72-024fe27c0f28"},"task_id":"01a0a94f-e82d-7e62-bc72-024fe27c0f28","event":{"kind":"output","task_id":"01a0a94f-e82d-7e62-bc72-024fe27c0f28","chunk":"Read text file `Targets/RunnerControl/Sources/LaunchAtLoginModel.swift`.\n1|import SwiftUI\n2|import ServiceManagement\n3|import RunnerControlCore\n4|\n5|/// Launch-at-login adapter (app to open at login, distinct from CI autostart).\n6|@MainActor final class LaunchAtLoginModel: ObservableObject {\n7|    @Published private(set) var enabled: Bool = false\n8|    init() {\n9|        enabled = SMAppService.mainApp.status == .enabled\n10|    }\n11|    func setEnabled(_ value: Bool) {\n12|        do {\n13|            if value { try SMAppService.mainApp.register() } else { try SMAppService.mainApp.unregister() }\n14|            enabled = value\n15|        } catch {\n16|            enabled = SMAppService.mainApp.status == .enabled\n17|        }\n18|    }\n19|    func refresh() {\n20|        enabled = SMAppService.mainApp.status == .enabled\n21|    }\n22|}","final_result":true}}}
