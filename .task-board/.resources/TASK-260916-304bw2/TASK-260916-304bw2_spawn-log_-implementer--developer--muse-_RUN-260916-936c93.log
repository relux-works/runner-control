\"\n26|            case .running: \"Служба включена\"\n27|            case .failed: \"Ошибка службы\"\n28|            case .missing: \"Раннер не найден\"\n29|            case .unknown: \"Статус недоступен\"\n30|            }\n31|        }\n32|    }\n33|    public struct Snapshot: Identifiable, Sendable, Equatable {\n34|        public let definition: Definition\n35|        public var status: Status\n36|        public var message: String?\n37|        public var id: String { definition.id }\n38|        public init(definition: Definition, status: Status = .checking, message: String? = nil) {\n39|            self.definition = definition; self.status = status; self.message = message\n40|        }\n41|    }\n42|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
