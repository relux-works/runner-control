Text(\"Runner Control\").font(.system(size: 16, weight: .semibold))\n36|                    Text(\"\\(Host.current().localizedName ?? \"Этот Mac\") · \\(active) из \\(props.runners.count) включено\")\n37|                        .font(.system(size: 11)).foregroundStyle(.secondary)\n38|                }\n39|                Spacer()\n40|                Circle().fill(active > 0 ? Color.green : Color.secondary.opacity(0.4)).frame(width: 8, height: 8)\n41|            }\n42|            if props.runners.isEmpty {\n43|                Text(\"Установленные службы раннеров не найдены на этом Mac.\")\n44|                    .font(.callout).foregroundStyle(.secondary)\n45|            }\n46|            VStack(spacing: 10) {\n47|                ForEach(props.runners) { runner in\n48|                    RunnerCard(snapshot: runner, changing: props.changing.contains(runner.id),\n49|                               setEnabled: { reactions.setEnabled(runner.id, $0) },\n50|                               openGitHub: { reactions.openGitHub(runner.definition) },\n51|                               openLogs: { reactions.openLogs(runner.definition) })\n52|                }\n53|            }\n54|            if let error = props.error {\n55|                HStack(alignment: .top, spacing: 8) {\n56|                    Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n57|                    Text(error).font(.caption).textSelection(.enabled).lineLimit(6)\n58|                    Spacer(minLength: 0)\n59|                    Button(action: reactions.clearError) { Image(systemName: \"xmark\") }.buttonStyle(.plain)\n60|                }.padding(10).background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n61|            }\n62|            HStack(spacing: 8) {\n63|                Button(\"Включить все\", action: reactions.enableAll)\n64|                    .buttonStyle(.borderedProminent).tint(.teal)\n65|                    .disabled(!props.changing.isEmpty || props.runners.allSatisfy { $0.status == .running || $0.status == .checking || $0.status == .missing || $0.status == .unknown })\n66|                Button(\"Выключить все\", action: reactions.disableAll)\n67|                    .buttonStyle(.bordered)\n68|                    .disabled(!props.changing.isEmpty || props.runners.allSatisfy { $0.status == .stopped || $0.status == .checking })\n69|            }.controlSize(.regular)\n70|            Text(\"Закрытие приложения не останавливает CI. Автозапуск определяется настройками каждой службы.\")\n71|                .font(.system(size: 11)).foregroundStyle(.secondary).fixedSize(horizontal: false, vertical: true)\n72|            Divider()\n73|            VStack(alignment: .leading, spacing: 9) {\n74|                HStack {\n75|                    Text(\"Обновления\").font(.system(size: 12, weight: .medium))\n76|                    Spacer()\n77|                    Button(\"Проверить…\", action: reactions.checkForUpdates)\n78|                        .disabled(!props.canCheckForUpdates)\n79|                }\n80|                Toggle(\"Проверять автоматически\", isOn: Binding(get: { props.automaticChecks }, set: reactions.setAutomaticChecks))\n81|                Toggle(\"Устанавливать автоматически\", isOn: Binding(get: { props.automaticDownloads }, set: reactions.setAutomaticDownloads))\n82|                    .disabled(!props.automaticChecks)\n83|            }.font(.system(size: 11)).toggleStyle(.switch).controlSize(.mini)\n84|            Button(\"Раннеры и настройки…\", action: reactions.openSettings)\n85|                .buttonStyle(.bordered)\n86|                .controlSize(.regular)\n87|            Divider()\n88|            HStack {\n89|                Text(\"RELUX WORKS\").font(.system(size: 9, weight: .semibold, design: .monospaced)).tracking(1.5).foregroundStyle(.tertiary)\n90|                Spacer()\n91|                Button(\"Закрыть приложение\", action: reactions.quit).buttonStyle(.plain)\n92|                    .font(.system(size: 11)).foregroundStyle(.secondary).disabled(!props.changing.isEmpty)\n93|            }\n94|        }.padding(20).frame(width: 370)\n95|    }\n96|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c655","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":389,"recorded_at":1780531400000773,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"call_id":"call_01a0a94fa70575949bde480fb642e48b","text":"Read text file `Targets/RunnerControl/Sources/RunnerContainer.swift`.\n1|import SwiftUI\n2|import AppKit\n3|import RunnerControlCore\n4|\n5|struct RunnerContainer: View {\n6|    @ObservedObject var state: Runners.State\n7|    @ObservedObject private var updater = AppRegistry.updater\n8|    var body: some View {\n9|        RunnerPage(\n10|            props: .init(runners: state.runners, changing: state.changing, error: state.lastError, canCheckForUpdates: updater.canCheckForUpdates, automaticChecks: updater.automaticallyChecks, automaticDownloads: updater.automaticallyDownloads),\n11|            reactions: .init(\n12|                setEnabled: change,\n13|                enableAll: { for runner in state.runners where [.stopped, .failed].contains(runner.status) { change(runner.id, true) } },\n14|                disableAll: { confirmStop(ids: state.runners.map(\\.id)) },\n15|                openGitHub: { NSWorkspace.shared.open($0.githubURL) },\n16|                openLogs: { NSWorkspace.shared.open($0.logs) },\n17|                clearError: { Task { await action { Runners.Action.clearError } } },\n18|                quit: quit,\n19|                checkForUpdates: updater.check,\n20|                setAutomaticChecks: updater.setAutomaticChecks,\n21|                setAutomaticDownloads: updater.setAutomaticDownloads,\n22|                openSettings: { AppRegistry.openManagementWindow() }\n23|            )\n24|        )\n25|    }\n26|    private func change(_ id: String, _ enabled: Bool) {\n27|        if enabled { Task { await action { Runners.Effect.setEnabled(id, true) } } }\n28|        else { confirmStop(ids: [id]) }\n29|    }\n30|    private func confirmStop(ids: [String]) {\n31|        let alert = NSAlert()\n32|        alert.messageText = \"Выключить CI?\"\n33|        alert.informativeText = \"Если раннер сейчас выполняет сборку, она будет прервана. Новые задания он принимать не будет.\"\n34|        alert.addButton(withTitle: \"Отмена\")\n35|        alert.addButton(withTitle: \"Выключить\")\n36|        guard alert.runModal() == .alertSecondButtonReturn else { return }\n37|        Task { for id in ids { await action { Runners.Effect.setEnabled(id, false) } } }\n38|    }\n39|    private func quit() {\n40|        guard state.changing.isEmpty else { return }\n41|        if state.runners.contains(where: { $0.status == .running || $0.status == .failed || $0.status == .unknown }) {\n42|            let alert = NSAlert()\n43|            alert.messageText = \"Закрыть Runner Control?\"\n44|            alert.informativeText = \"Включённые раннеры продолжат работать в фоне. Для остановки CI сначала нажмите «Выключить все».\"\n45|            alert.addButton(withTitle: \"Остаться\")\n46|            alert.addButton(withTitle: \"Закрыть приложение\")\n47|            guard alert.runModal() == .alertSecondButtonReturn else { return }\n48|        }\n49|        NSApp.terminate(nil)\n50|    }\n51|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
