{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d439","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":2167,"recorded_at":1780531400004329,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a95d-064a-7fa2-926c-6dd10e07bae1"},"task_id":"01a0a95d-064a-7fa2-926c-6dd10e07bae1","event":{"kind":"output","task_id":"01a0a95d-064a-7fa2-926c-6dd10e07bae1","chunk":"Read text file `Targets/RunnerControl/Sources/RunnerPage.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|struct RunnerPage: View {\n5|    struct Props {\n6|        let runners: [Runners.Snapshot]\n7|        let changing: Set<String>\n8|        let error: String?\n9|        let canCheckForUpdates: Bool\n10|        let automaticChecks: Bool\n11|        let automaticDownloads: Bool\n12|    }\n13|    struct Reactions {\n14|        let setEnabled: (String, Bool) -> Void\n15|        let enableAll: () -> Void\n16|        let disableAll: () -> Void\n17|        let openGitHub: (Runners.Definition) -> Void\n18|        let openLogs: (Runners.Definition) -> Void\n19|        let clearError: () -> Void\n20|        let quit: () -> Void\n21|        let checkForUpdates: () -> Void\n22|        let setAutomaticChecks: (Bool) -> Void\n23|        let setAutomaticDownloads: (Bool) -> Void\n24|        let openSettings: () -> Void\n25|    }\n26|    let props: Props\n27|    let reactions: Reactions\n28|    private var active: Int { props.runners.filter { $0.status == .running }.count }\n29|    var body: some View {\n30|        VStack(alignment: .leading, spacing: 18) {\n31|            HStack(spacing: 10) {\n32|                Image(systemName: \"bolt.circle.fill\")\n33|                    .font(.system(size: 30, weight: .medium)).foregroundStyle(.teal)\n34|                VStack(alignment: .leading, spacing: 3) {\n35|                    Text(\"Runner Control\").font(.system(size: 16, weight: .semibold))\n36|                    Text(\"\\(Host.current().localizedName ?? \"Этот Mac\") · \\(active) из \\(props.runners.count) включено\")\n37|                        .font(.system(size: 11)).foregroundStyle(.secondary)\n38|                }\n39|                Spacer()\n40|                Circle().fill(active > 0 ? Color.green : Color.secondary.opacity(0.4)).frame(width: 8, height: 8)\n41|            }\n42|            if props.runners.isEmpty {\n43|                Text(\"Установленные службы раннеров не найдены на этом Mac.\")\n44|                    .font(.callout).foregroundStyle(.secondary)\n45|            }\n46|            VStack(spacing: 10) {\n47|                ForEach(props.runners) { runner in\n48|                    RunnerCard(snapshot: runner, changing: props.changing.contains(runner.id),\n49|                               setEnabled: { reactions.setEnabled(runner.id, $0) },\n50|                               openGitHub: { reactions.openGitHub(runner.definition) },\n51|                               openLogs: { reactions.openLogs(runner.definition) })\n52|                }\n53|            }\n54|            if let error = props.error {\n55|                HStack(alignment: .top, spacing: 8) {\n56|                    Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n57|                    Text(error).font(.caption).textSelection(.enabled).lineLimit(6)\n58|                    Spacer(minLength: 0)\n59|                    Button(action: reactions.clearError) { Image(systemName: \"xmark\") }.buttonStyle(.plain)\n60|                }.padding(10).background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n61|            }\n62|            HStack(spacing: 8) {\n63|                Button(\"Включить все\", action: reactions.enableAll)\n64|                    .buttonStyle(.borderedProminent).tint(.teal)\n65|                    .disabled(!props.changing.isEmpty || props.runners.allSatisfy { $0.status == .running || $0.status == .checking || $0.status == .missing || $0.status == .unknown })\n66|                Button(\"Выключить все\", action: reactions.disableAll)\n67|                    .buttonStyle(.bordered)\n68|                    .disabled(!props.changing.isEmpty || props.runners.allSatisfy { $0.status == .stopped || $0.status == .checking })\n69|            }.controlSize(.regular)\n70|            Text(\"Закрытие приложения не останавливает CI. Автозапуск определяется настройками каждой службы.\")\n71|                .font(.system(size: 11)).foregroundStyle(.secondary).fixedSize(horizontal: false, vertical: true)\n72|            Divider()\n73|            VStack(alignment: .leading, spacing: 9) {\n74|                HStack {\n75|                    Text(\"Обновления\").font(.system(size: 12, weight: .medium))\n76|                    Spacer()\n77|                    Button(\"Проверить…\", action: reactions.checkForUpdates)\n78|                        .disabled(!props.canCheckForUpdates)\n79|                }\n80|                Toggle(\"Проверять автоматически\", isOn: Binding(get: { props.automaticChecks }, set: reactions.setAutomaticChecks))\n81|                Toggle(\"Устанавливать автоматически\", isOn: Binding(get: { props.automaticDownloads }, set: reactions.setAutomaticDownloads))\n82|                    .disabled(!props.automaticChecks)\n83|            }.font(.system(size: 11)).toggleStyle(.switch).controlSize(.mini)\n84|            Button(\"Раннеры и настройки…\", action: reactions.openSettings)\n85|                .buttonStyle(.bordered)\n86|                .controlSize(.regular)\n87|            Divider()\n88|            HStack {\n89|                Text(\"RELUX WORKS\").font(.system(size: 9, weight: .semibold, design: .monospaced)).tracking(1.5).foregroundStyle(.tertiary)\n90|                Spacer()\n91|                Button(\"Закрыть приложение\", action: reactions.quit).buttonStyle(.plain)\n92|                    .font(.system(size: 11)).foregroundStyle(.secondary).disabled(!props.changing.isEmpty)\n93|            }\n94|        }.padding(20).frame(width: 370)\n95|    }\n96|}","final_result":true}}}
