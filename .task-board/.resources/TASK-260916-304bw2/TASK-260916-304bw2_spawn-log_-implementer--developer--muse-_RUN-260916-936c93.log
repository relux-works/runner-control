ers.Definition) -> Void\n36|        let openLogs: (Runners.Definition) -> Void\n37|        let showDirectory: (Runners.Definition) -> Void\n38|        let clearRunnerError: () -> Void\n39|        let openRegistration: () -> Void\n40|        let serverHostChanged: (String) -> Void\n41|        let beginLogin: () -> Void\n42|        let cancelLogin: () -> Void\n43|        let logout: () -> Void\n44|        let openVerification: (URL) -> Void\n45|        let copyCode: (String) -> Void\n46|        let refreshInstallations: () -> Void\n47|        let selectInstallation: (Int64?) -> Void\n48|        let selectRepositories: (Set<Int64>) -> Void\n49|        let grantAccess: () -> Void\n50|        let revokeInGitHub: () -> Void\n51|        let checkForUpdates: () -> Void\n52|        let setAutomaticChecks: (Bool) -> Void\n53|        let setAutomaticDownloads: (Bool) -> Void\n54|        let setLaunchAtLogin: (Bool) -> Void\n55|        let quit: () -> Void\n56|    }\n57|}","final_result":true}}}
