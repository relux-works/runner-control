fort and never blocks local control.\n29|                if case .connected = githubState.connection {\n30|                    await action { GitHubAuth.Effect.refreshInstallations }\n31|                }\n32|                _ = ticks\n33|            }\n34|        }\n35|    }\n36|\n37|    static func openManagementWindow() {\n38|        NotificationCenter.default.post(name: .openManagementWindow, object: nil)\n39|    }\n40|}\n41|\n42|extension Notification.Name {\n43|    static let openManagementWindow = Notification.Name(\"works.relux.runnercontrol.openManagementWindow\")\n44|}","final_result":true}}}
