{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c523","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":236,"recorded_at":1780531400000467,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a94f-8170-72a3-a889-fc4a678bcd70"},"task_id":"01a0a94f-8170-72a3-a889-fc4a678bcd70","event":{"kind":"output","task_id":"01a0a94f-8170-72a3-a889-fc4a678bcd70","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+Models.swift`.\n1|import Foundation\n2|extension Runners {\n3|    public struct Definition: Identifiable, Sendable, Equatable {\n4|        public let id: String\n5|        public let title: String\n6|        public let detail: String\n7|        public let directory: URL\n8|        public let githubURL: URL\n9|        private let servicePlist: URL?\n10|        public init(id: String, title: String, detail: String, directory: URL, githubURL: URL, servicePlist: URL? = nil) {\n11|            self.id = id; self.title = title; self.detail = detail\n12|            self.directory = directory; self.githubURL = githubURL; self.servicePlist = servicePlist\n13|        }\n14|        public var plist: URL { servicePlist ?? directory.appendingPathComponent(\"manual-service.plist\") }\n15|        public var logs: URL { FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/Logs/\" + id) }\n16|        public static func installed(home: URL = FileManager.default.homeDirectoryForCurrentUser) -> [Self] {\n17|            RunnerDiscovery.installed(home: home)\n18|        }\n19|    }\n20|    public enum Status: String, Sendable, Equatable {\n21|        case checking, stopped, running, failed, missing, unknown\n22|        public var title: String {\n23|            switch self {\n24|            case .checking: \"Проверяем…\"\n25|            case .stopped: \"Выключен\"\n26|            case .running: \"Служба включена\"\n27|            case .failed: \"Ошибка службы\"\n28|            case .missing: \"Раннер не найден\"\n29|            case .unknown: \"Статус недоступен\"\n30|            }\n31|        }\n32|    }\n33|    public struct Snapshot: Identifiable, Sendable, Equatable {\n34|        public let definition: Definition\n35|        public var status: Status\n36|        public var message: String?\n37|        public var id: String { definition.id }\n38|        public init(definition: Definition, status: Status = .checking, message: String? = nil) {\n39|            self.definition = definition; self.status = status; self.message = message\n40|        }\n41|    }\n42|}","final_result":true}}}
