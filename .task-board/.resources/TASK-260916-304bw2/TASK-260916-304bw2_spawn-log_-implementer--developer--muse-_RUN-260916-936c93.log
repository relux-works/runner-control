{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c767","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":526,"recorded_at":1780531400001047,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a94f-d97b-7e82-a713-90f4b6d611c5"},"task_id":"01a0a94f-d97b-7e82-a713-90f4b6d611c5","event":{"kind":"output","task_id":"01a0a94f-d97b-7e82-a713-90f4b6d611c5","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension RunnerRegistration {\n5|    public protocol IFlow: Relux.Flow {}\n6|\n7|    public actor Flow {\n8|        public let dispatcher: Relux.Dispatcher\n9|        private let api: GitHubRunnerAPIClient\n10|        private let installer: RunnerInstallerService\n11|        private let registrationTokens: any RunnerRegistrationTokenStoring\n12|        private let userStore: any GitHubCredentialStoring\n13|        private let identities: any GitHubSessionIdentityStoring\n14|        private let refresher: GitHubTokenRefresh\n15|        private let configProvider: @Sendable (String?) throws -> GitHubAuth.AppConfig\n16|        private let now: @Sendable () -> Date\n17|\n18|        private var generation = 0\n19|        /// Operation owner: the generation that holds the busy lock, or nil\n20|        /// when idle. Every step sets it to its starting generation before\n21|        /// its first await; every success/failure/cancel exit clears it only\n22|        /// when the exiting generation still owns it. A stale generation\n23|        /// never mutates a newer owner's lock, step, or failure state.\n24|        /// Abandoning a generation releases this UI lock so the new draft can\n25|        /// proceed, but never releases the installer-wide lease: a live side\n26|        /// effect keeps owning the installer until it settles, and any second\n27|        /// mutation meanwhile is refused as installer-busy.\n28|        private var workingOwner: Int?\n29|        private var workingStep: String?\n30|        private var draft: Draft?\n31|        private var group: RunnerGroup?\n32|        private var asset: DownloadAsset?\n33|        private var installPath: String?\n34|        private var runnerID: Int64?\n35|        private var failedStep: String?\n36|        private var pendingRepositoryIDs: Set<Int64>?\n37|        private var pendingTargetGroupID: Int64?\n38|        private var pendingLabels: [String]?\n39|        /// Authenticated server the cached progress is bound to. A session\n40|        /// change invalidates server-bound caches before any reuse, so a\n41|        /// group/runner ID from one server never authorizes writes on another.\n42|        private var boundServerHost: String?\n43|\n44|        public init(\n45|            api: GitHubRunnerAPIClient,\n46|            installer: RunnerInstallerService,\n47|            registrationTokens: any RunnerRegistrationTokenStoring,\n48|            userStore: any GitHubCredentialStoring,\n49|            identityStore: any GitHubSessionIdentityStoring,\n50|            refresher: GitHubTokenRefresh,\n51|            configProvider: (@Sendable (String?) throws -> GitHubAuth.AppConfig)? = nil,\n52|            now: (@Sendable () -> Date)? = nil,\n53|            dispatcher: Relux.Dispatcher? = nil\n54|        ) async {\n55|            self.api = api\n56|            self.installer = installer\n57|            self.registrationTokens = registrationTokens\n58|            self.userStore = userStore\n59|            self.identities = identityStore\n60|            self.refresher = refresher\n61|            self.configProvider = configProvider ?? { host in\n62|                try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\")\n63|            }\n64|            self.now = now ?? Date.init\n65|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n66|        }\n67|\n68|        /// Deterministic LaunchAgent label for a draft. Always carries the\n69|        /// `actions.runner.` prefix discovery requires.\n70|        public nonisolated static func serviceLabel(draft: Draft) -> String {\n71|            let scope = draft.scope.detail.replacingOccurrences(of: \"/\", with: \"-\")\n72|            let raw = \"actions.runner.\\(scope).\\(draft.installDirName)\"\n73|            let allowed = CharacterSet.alphanumerics.union(CharacterSet(charactersIn: \".-\"))\n74|            return raw.unicodeScalars.map { allowed.contains($0) ? String($0) : \"-\" }.joined()\n75|        }\n76|\n77|        public nonisolated static func tokenScopeKey(draft: Draft) -> String {\n78|            \"\\(draft.scope.scopeKey):\\(draft.installDirName)\"\n79|        }\n80|    }\n81|}\n82|\n83|/// Authenticated user token for wizard API calls. Never logged.\n84|private struct FlowUserToken: Sendable {\n85|    let config: GitHubAuth.AppConfig\n86|    let token: String\n87|    let identity: GitHubSessionIdentity\n88|}\n89|\n90|extension RunnerRegistration.Flow: RunnerRegistration.IFlow {\n91|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n92|        guard let effect = effect as? RunnerRegistration.Effect else { return .success }\n93|        switch effect {\n94|        case .beginDraft(let draft): await beginDraft(draft)\n95|        case .updateDraft(let draft): await updateDraft(draft)\n96|        case .resolveGroup: await resolveGroup()\n97|        case .prepareDownload: await prepareDownload()\n98|        case .downloadAndInstall: await downloadAndInstall()\n99|        case .registerRunner: await registerRunner()\n100|        case .setupService: await setupService()\n101|        case .applyRepositoryAccess(let groupID, let ids): await applyRepositoryAccess(groupID: groupID, ids: ids)\n102|        case .applyLabels(let labels): await applyLabels(labels)\n103|        case .retry: await retry()\n104|        case .cancel: await cancel()\n105|        case .reset: await reset()\n106|        case .dismissPermission: await action { RunnerRegistration.Action.permissionDismissed }\n107|        }\n108|        return .success\n109|    }\n110|\n111|    private func isStale(_ gen: Int) -> Bool { generation != gen }\n112|\n113|    // MARK: - Draft\n114|\n115|    private func beginDraft(_ draft: RunnerRegistration.Draft) async {\n116|        do {\n117|            try RunnerRegistration.Gates.validateDraft(draft)\n118|        } catch {\n119|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"beginDraft\") }\n120|            return\n121|        }\n122|        // A new draft abandons any in-flight completion: the old operation's\n123|        // success must never be attributed to the new draft. Already-started\n124|        // filesystem side effects keep the installer-wide lease until they\n125|        // settle; only their completion ownership is revoked via the\n126|        // generation bump, and the UI lock is released for the new draft.\n127|        let abandoned = workingOwner != nil\n128|        if abandoned {\n129|            generation += 1\n130|            workingOwner = nil\n131|            workingStep = nil\n132|        }\n133|        self.draft = draft\n134|        group = nil\n135|        asset = nil\n136|        installPath = nil\n137|        runnerID = nil\n138|        failedStep = nil\n139|        pendingRepositoryIDs = nil\n140|        pendingTargetGroupID = nil\n141|        pendingLabels = nil\n142|        boundServerHost = nil\n143|        await action { RunnerRegistration.Action.draftBegan(draft) }\n144|        if abandoned {\n145|            await action { RunnerRegistration.Action.cancelled }\n146|        }\n147|    }\n148|\n149|    private func updateDraft(_ draft: RunnerRegistration.Draft) async {\n150|        do {\n151|            try RunnerRegistration.Gates.validateDraft(draft)\n152|        } catch {\n153|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"updateDraft\") }\n154|            return\n155|        }\n156|        // Identity edits while working abandon the in-flight operation via\n157|        // the generation bump. Selections stay editable without cancelling\n158|        // unrelated steps — except the mutation they feed: a labels edit\n159|        // abandons in-flight applyLabels and a repository edit abandons\n160|        // in-flight applyRepositoryAccess, so an older completion can never\n161|        // overwrite the newer visible selection or report it as applied.\n162|        // Stale completions observe the bump at their next await boundary\n163|        // and emit nothing.\n164|        var abandoned = false\n165|        if let old = self.draft {\n166|            if workingOwner != nil, shouldAbandonInFlight(old: old, new: draft) {\n167|                generation += 1\n168|                workingOwner = nil\n169|                workingStep = nil\n170|                abandoned = true\n171|            }\n172|            invalidateProgress(old: old, new: draft)\n173|        }\n174|        self.draft = draft\n175|        await action { RunnerRegistration.Action.draftUpdated(draft) }\n176|        if abandoned {\n177|            await action { RunnerRegistration.Action.cancelled }\n178|        }\n179|    }\n180|\n181|    /// Invalidates cached success-progress bound to the changed identity\n182|    /// fields. Scope/install/name/group/work-folder edits never reuse\n183|    /// another registration's evidence; editable selections re-target pending\n184|    /// retries to the visible values instead. Mirrors the reducer's\n185|    /// invalidation. Group is part of the config identity (`--runnergroup`):\n186|    /// a group edit drops registration evidence as well, so the old group's\n187|    /// configuration is never claimed as the new draft's success.\n188|    private func invalidateProgress(old: RunnerRegistration.Draft, new: RunnerRegistration.Draft) {\n189|        if old.scope != new.scope {\n190|            group = nil\n191|            asset = nil\n192|            installPath = nil\n193|            runnerID = nil\n194|            pendingRepositoryIDs = nil\n195|            pendingTargetGroupID = nil\n196|            pendingLabels = nil\n197|            failedStep = nil\n198|            return\n199|        }\n200|        if old.installDirName != new.installDirName {\n201|            installPath = nil\n202|            runnerID = nil\n203|            pendingLabels = nil\n204|            if [\"downloadAndInstall\", \"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n205|                failedStep = nil\n206|            }\n207|        }\n208|        let oldName = old.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n209|        let newName = new.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n210|        if oldName != newName {\n211|            runnerID = nil\n212|            pendingLabels = nil\n213|            if [\"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n214|                failedStep = nil\n215|            }\n216|        }\n217|        let oldIsOrg: Bool = if case .organization = old.scope { true } else { false }\n218|        let newIsOrg: Bool = if case .organization = new.scope { true } else { false }\n219|        if oldIsOrg || newIsOrg {\n220|            let oldGroup = old.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n221|            let newGroup = new.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n222|            if oldGroup != newGroup {\n223|                group = nil\n224|                runnerID = nil\n225|                pendingRepositoryIDs = nil\n226|                pendingTargetGroupID = nil\n227|                pendingLabels = nil\n228|                if [\"resolveGroup\", \"applyRepositoryAccess\", \"registerRunner\", \"setupService\", \"applyLabels\"]\n229|                    .contains(failedStep ?? \"\") {\n230|                    failedStep = nil\n231|                }\n232|            }\n233|        }\n234|        if old.workFolder != new.workFolder {\n235|            runnerID = nil\n236|            pendingLabels = nil\n237|            if [\"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n238|                failedStep = nil\n239|            }\n240|        }\n241|        // Editable selections stay live: a retry after an edit applies the\n242|        // visible values, never the stale attempt's.\n243|        if old.labels != new.labels, !new.labels.isEmpty {\n244|            pendingLabels = new.labels\n245|        }\n246|        if old.selectedRepositoryIDs != new.selectedRepositoryIDs {\n247|            pendingRepositoryIDs = new.selectedRepositoryIDs\n248|        }\n249|    }\n250|\n251|    /// True when an edit must abandon the in-flight step: any identity\n252|    /// change, plus a selection change for the mutation it feeds.\n253|    private func shouldAbandonInFlight(old: RunnerRegistration.Draft, new: RunnerRegistration.Draft) -> Bool {\n254|        if RunnerRegistration.Gates.identityFieldsChanged(old: old, new: new) { return true }\n255|        if workingStep == \"applyLabels\", old.labels != new.labels { return true }\n256|        if workingStep == \"applyRepositoryAccess\", old.selectedRepositoryIDs != new.selectedRepositoryIDs {\n257|            return true\n258|        }\n259|        return false\n260|    }\n261|\n262|    // MARK: - Auth\n263|\n264|    private func currentUserToken(generation gen: Int) async throws -> FlowUserToken {\n265|        guard let identity = await identities.load() else {\n266|            throw RunnerRegistration.RegistrationError.notAuthenticated\n267|        }\n268|        let config = try configProvider(identity.serverHost)\n269|        guard var record = await userStore.load(\n270|            serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID\n271|        ) else {\n272|            throw RunnerRegistration.RegistrationError.notAuthenticated\n273|        }\n274|        guard !isStale(gen) else { throw CancellationError() }\n275|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n276|            do {\n277|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n278|            } catch is CancellationError {\n279|                throw CancellationError()\n280|            } catch let error as GitHubAuth.AuthError {\n281|                switch error {\n282|                case .revoked, .unauthorized, .tokenRefreshFailed:\n283|                    throw RunnerRegistration.RegistrationError.unauthorized\n284|                default:\n285|                    break\n286|                }\n287|            }\n288|            guard !isStale(gen) else { throw CancellationError() }\n289|        }\n290|        return FlowUserToken(config: config, token: record.accessToken, identity: identity)\n291|    }\n292|\n293|    /// Binds cached progress to the authenticated server. When the session\n294|    /// server changes between steps, server-bound caches (group, asset,\n295|    /// runner ID, pendings) are dropped before any reuse, so an ID from one\n296|    /// server never authorizes writes on another. Returns false when the\n297|    /// binding changed and the caller must re-resolve instead of reusing.\n298|    @discardableResult\n299|    private func syncServerBinding(_ host: String) -> Bool {\n300|        let normalized = RunnerRegistration.OperationIdentity.normalizeServerHost(host)\n301|        if let bound = boundServerHost,\n302|           RunnerRegistration.OperationIdentity.normalizeServerHost(bound) == normalized {\n303|            return true\n304|        }\n305|        if boundServerHost != nil {\n306|            group = nil\n307|            asset = nil\n308|            runnerID = nil\n309|            pendingRepositoryIDs = nil\n310|            pendingTargetGroupID = nil\n311|            pendingLabels = nil\n312|            failedStep = nil\n313|            boundServerHost = normalized\n314|            return false\n315|        }\n316|        boundServerHost = normalized\n317|        return true\n318|    }\n319|\n320|    /// Generation-owned failure exit. Only the generation that still holds\n321|    /// the lock may record its failure and release it; a stale failure\n322|    /// (abandoned, cancelled, or reset while suspended) mutates nothing, so\n323|    /// it can never unlock a newer operation or plant its failedStep.\n324|    private func fail(_ error: Error, step: String, generation gen: Int) async {\n325|        guard workingOwner == gen else { return }\n326|        failedStep = step\n327|        workingOwner = nil\n328|        workingStep = nil\n329|        if error is CancellationError { return }\n330|        if let reg = error as? RunnerRegistration.RegistrationError {\n331|            switch reg {\n332|            case .missingPermission, .forbidden:\n333|                await action {\n334|                    RunnerRegistration.Action.permissionDenied(message: reg.localizedDescription, step: step)\n335|                }\n336|                return\n337|            default:\n338|                break\n339|            }\n340|        }\n341|        let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n342|        await action { RunnerRegistration.Action.failed(message: message, step: step) }\n343|    }\n344|\n345|    /// Generation-owned success exit. Only the generation that still holds\n346|    /// the lock may attest its step and release it; a stale success emits\n347|    /// nothing and mutates nothing.\n348|    private func finishStep(_ step: String, generation gen: Int) async {\n349|        guard workingOwner == gen else { return }\n350|        failedStep = nil\n351|        workingOwner = nil\n352|        workingStep = nil\n353|        await action { RunnerRegistration.Action.stepFinished(step) }\n354|    }\n355|\n356|    // MARK: - Group\n357|\n358|    private func resolveGroup() async {\n359|        let gen = generation\n360|        guard workingOwner == nil else { return }\n361|        guard let draft else {\n362|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"resolveGroup\") }\n363|            return\n364|        }\n365|        do {\n366|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n367|        } catch {\n368|            failedStep = \"resolveGroup\"\n369|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"resolveGroup\") }\n370|            return\n371|        }\n372|        guard case .organization(let org) = draft.scope else { return }\n373|        workingOwner = gen\n374|        workingStep = \"resolveGroup\"\n375|        await action { RunnerRegistration.Action.stepStarted(\"resolveGroup\") }\n376|        do {\n377|            let auth = try await currentUserToken(generation: gen)\n378|            guard !isStale(gen) else { return }\n379|            _ = syncServerBinding(auth.identity.serverHost)\n380|            guard !isStale(gen) else { return }\n381|            let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n382|            guard !isStale(gen) else { return }\n383|            let name = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n384|            let resolved: RunnerRegistration.RunnerGroup\n385|            if let existing = groups.first(where: { $0.name == name }) {\n386|                // Name alone never authorizes adoption: require a locally\n387|                // recorded ownership entry on this server or explicit\n388|                // takeover confirmation.\n389|                let owned = await installer.loadOwnedGroupID(\n390|                    serverHost: auth.identity.serverHost, org: org, name: name\n391|                )\n392|                try RunnerRegistration.Gates.authorizeGroupTakeover(\n393|                    groupName: name, existingID: existing.id,\n394|                    ownedID: owned, allowTakeover: draft.allowGroupTakeover\n395|                )\n396|                if owned != existing.id {\n397|                    try await installer.saveOwnedGroupID(\n398|                        serverHost: auth.identity.serverHost, org: org, name: name, groupID: existing.id\n399|                    )\n400|                }\n401|                guard !isStale(gen) else { return }\n402|                // A pre-existing group may deny public repos (GitHub default\n403|                // false), which would silently drop selected public repos.\n404|                if existing.allowsPublicRepositories {\n405|                    resolved = existing\n406|                } else {\n407|                    resolved = try await api.updateGroupAllowsPublic(\n408|                        config: auth.config, token: auth.token, org: org,\n409|                        groupID: existing.id, allowsPublic: true\n410|                    )\n411|                }\n412|            } else {\n413|                resolved = try await api.createGroup(\n414|                    config: auth.config, token: auth.token, org: org,\n415|                    name: name, selectedRepositoryIDs: draft.selectedRepositoryIDs,\n416|                    allowsPublicRepositories: true\n417|                )\n418|                guard !isStale(gen) else { return }\n419|                try await installer.saveOwnedGroupID(\n420|                    serverHost: auth.identity.serverHost, org: org, name: name, groupID: resolved.id\n421|                )\n422|            }\n423|            guard !isStale(gen) else { return }\n424|            let repoIDs = try await api.fetchGroupRepositories(\n425|                config: auth.config, token: auth.token, org: org, groupID: resolved.id\n426|            )\n427|            guard !isStale(gen) else { return }\n428|            group = resolved\n429|            await action { RunnerRegistration.Action.groupResolved(resolved, repositoryIDs: repoIDs) }\n430|            guard !isStale(gen) else { return }\n431|            await action { RunnerRegistration.Action.permissionDismissed }\n432|            await finishStep(\"resolveGroup\", generation: gen)\n433|        } catch {\n434|            await fail(error, step: \"resolveGroup\", generation: gen)\n435|        }\n436|    }\n437|\n438|    // MARK: - Download\n439|\n440|    private func prepareDownload() async {\n441|        let gen = generation\n442|        guard workingOwner == nil else { return }\n443|        guard let draft else {\n444|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"prepareDownload\") }\n445|            return\n446|        }\n447|        workingOwner = gen\n448|        workingStep = \"prepareDownload\"\n449|        await action { RunnerRegistration.Action.stepStarted(\"prepareDownload\") }\n450|        do {\n451|            let auth = try await currentUserToken(generation: gen)\n452|            guard !isStale(gen) else { return }\n453|            _ = syncServerBinding(auth.identity.serverHost)\n454|            guard !isStale(gen) else { return }\n455|            let found = try await prepareDownloadInner(draft: draft, auth: auth, generation: gen)\n456|            guard !isStale(gen) else { return }\n457|            asset = found\n458|            await action { RunnerRegistration.Action.downloadReady(found) }\n459|            await finishStep(\"prepareDownload\", generation: gen)\n460|        } catch {\n461|            await fail(error, step: \"prepareDownload\", generation: gen)\n462|        }\n463|    }\n464|\n465|    private func prepareDownloadInner(\n466|        draft: RunnerRegistration.Draft, auth: FlowUserToken, generation gen: Int\n467|    ) async throws -> RunnerRegistration.DownloadAsset {\n468|        guard !isStale(gen) else { throw CancellationError() }\n469|        let assets = try await api.fetchDownloads(config: auth.config, token: auth.token, scope: draft.scope)\n470|        guard !isStale(gen) else { throw CancellationError() }\n471|        return try RunnerRegistration.Gates.selectDownload(\n472|            osName: RunnerInstallerService.installOS,\n473|            arch: installer.architecture,\n474|            from: assets\n475|        )\n476|    }\n477|\n478|    // MARK: - Install\n479|\n480|    private func downloadAndInstall() async {\n481|        let gen = generation\n482|        guard workingOwner == nil else { return }\n483|        guard let draft else {\n484|            await action {\n485|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"downloadAndInstall\")\n486|            }\n487|            return\n488|        }\n489|        workingOwner = gen\n490|        workingStep = \"downloadAndInstall\"\n491|        await action { RunnerRegistration.Action.stepStarted(\"downloadAndInstall\") }\n492|        do {\n493|            // Bind to the authenticated server before touching the cache: a\n494|            // session change drops the old server's asset instead of reusing\n495|            // it. The same auth serves the whole step; no mid-step reload\n496|            // may mix servers.\n497|            let auth = try await currentUserToken(generation: gen)\n498|            guard !isStale(gen) else { return }\n499|            _ = syncServerBinding(auth.identity.serverHost)\n500|            guard !isStale(gen) else { return }\n(more lines below)","final_result":true}}}
