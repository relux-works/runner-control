le.close() }\n23|        let process = Process()\n24|        process.executableURL = URL(fileURLWithPath: executable)\n25|        process.arguments = arguments\n26|        process.standardOutput = handle; process.standardError = handle\n27|        try process.run()\n28|        let deadline = ContinuousClock.now.advanced(by: .seconds(12))\n29|        while process.isRunning {\n30|            if Task.isCancelled || ContinuousClock.now >= deadline {\n31|                process.terminate()\n32|                for _ in 0..<20 where process.isRunning { try? await Task.sleep(for: .milliseconds(50)) }\n33|                if process.isRunning { kill(process.processIdentifier, SIGKILL) }\n34|                throw RunnerError.message(\"Команда не завершилась вовремя. Обновите статус и попробуйте снова.\")\n35|            }\n36|            try? await Task.sleep(for: .milliseconds(40))\n37|        }\n38|        let read = try FileHandle(forReadingFrom: url)\n39|        defer { try? read.close() }\n40|        let data = try read.read(upToCount: 131072) ?? Data()\n41|        return CommandResult(code: process.terminationStatus, output: String(decoding: data, as: UTF8.self))\n42|    }\n43|}","final_result":true}}}
