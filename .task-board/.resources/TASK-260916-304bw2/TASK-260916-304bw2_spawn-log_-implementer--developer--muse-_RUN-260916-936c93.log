erverHost)/login/oauth/access_token\")!\n23|                self.apiBaseURL = URL(string: \"https://\\(serverHost)/api/v3\")!\n24|            }\n25|        }\n26|\n27|        /// Exact scaffold binding the coordinator must provision.\n28|        public static let missingBindingHelp = \"Info.plist[GitHubAppClientID] (scaffold input ios-app-manager.json → macos.info_plist.GitHubAppClientID, coordinator-provisioned public client_id)\"\n29|\n30|        public static func current(bundle: Bundle = .main, serverHost: String = \"github.com\") throws -> Self {\n31|            if let info = bundle.infoDictionary {\n32|                try auditNoSecrets(in: info)\n33|            }\n34|            let raw = bundle.object(forInfoDictionaryKey: \"GitHubAppClientID\") as? String\n35|            let trimmed = raw?.trimmingCharacters(in: .whitespacesAndNewlines) ?? \"\"\n36|            guard !trimmed.isEmpty else {\n37|                throw ConfigError.missingClientID(binding: missingBindingHelp)\n38|            }\n39|            return Self(clientID: trimmed, serverHost: serverHost)\n40|        }\n41|\n42|        /// Fail-closed audit: Info.plist must not carry secrets or private keys.\n43|        public static func auditNoSecrets(in dictionary: [String: Any]) throws {\n44|            let forbidden = [\"secret\", \"private_key\", \"privatekey\", \"token\"]\n45|            for key in dictionary.keys {\n46|                let lowered = key.lowercased()\n47|                for token in forbidden where lowered.contains(token) {\n48|                    if key == \"GitHubAppClientID\" { continue }\n49|                    throw ConfigError.embeddedSecret(key: key)\n50|                }\n51|            }\n52|        }\n53|    }\n54|\n55|    public enum ConfigError: LocalizedError, Sendable, Equatable {\n56|        case missingClientID(binding: String)\n57|        case embeddedSecret(key: String)\n58|        case unsupportedEnterprise(host: String)\n59|\n60|        public var errorDescripti