{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b3","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":436,"recorded_at":1780531400000867,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a94f-ba2a-7c12-845d-14fad9711963"},"task_id":"01a0a94f-ba2a-7c12-845d-14fad9711963","event":{"kind":"output","task_id":"01a0a94f-ba2a-7c12-845d-14fad9711963","chunk":"Read text file `Targets/RunnerControl/Sources/ManagementWindowPage.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|struct ManagementWindowPage: View {\n5|    let props: Props\n6|    let reactions: Reactions\n7|    @State private var selection: Tab = .runners\n8|\n9|    enum Tab: Hashable {\n10|        case runners, github, general\n11|    }\n12|\n13|    var body: some View {\n14|        TabView(selection: $selection) {\n15|            runnersTab\n16|                .tabItem { Label(\"Раннеры\", systemImage: \"bolt.circle\") }\n17|                .tag(Tab.runners)\n18|            githubTab\n19|                .tabItem { Label(\"GitHub\", systemImage: \"person.circle\") }\n20|                .tag(Tab.github)\n21|            generalTab\n22|                .tabItem { Label(\"Основные\", systemImage: \"gearshape\") }\n23|                .tag(Tab.general)\n24|        }\n25|        .frame(width: 760, height: 540)\n26|    }\n27|\n28|    // MARK: - Runners\n29|\n30|    private var active: Int { props.runners.filter { $0.status == .running }.count }\n31|\n32|    private var runnersTab: some View {\n33|        VStack(alignment: .leading, spacing: 14) {\n34|            HStack(spacing: 10) {\n35|                VStack(alignment: .leading, spacing: 3) {\n36|                    Text(\"Раннеры на этом Mac\").font(.system(size: 15, weight: .semibold))\n37|                    Text(\"\\(Host.current().localizedName ?? \"Этот Mac\") · \\(active) из \\(props.runners.count) включено\")\n38|                        .font(.system(size: 11)).foregroundStyle(.secondary)\n39|                }\n40|                Spacer()\n41|                Circle().fill(active > 0 ? Color.green : Color.secondary.opacity(0.4)).frame(width: 8, height: 8)\n42|            }\n43|            if props.runners.isEmpty {\n44|                VStack(alignment: .leading, spacing: 8) {\n45|                    Text(\"Добавьте раннер на этом Mac\").font(.callout.weight(.medium))\n46|                    Text(\"Учётная запись GitHub не обязательна. Локальное управление работает без входа.\")\n47|                        .font(.callout).foregroundStyle(.secondary)\n48|                }\n49|                .padding(.vertical, 8)\n50|            }\n51|            ScrollView {\n52|                VStack(spacing: 10) {\n53|                    ForEach(props.runners) { runner in\n54|                        RunnerCard(\n55|                            snapshot: runner,\n56|                            changing: props.changing.contains(runner.id),\n57|                            setEnabled: { reactions.setEnabled(runner.id, $0) },\n58|                            openGitHub: { reactions.openGitHub(runner.definition) },\n59|                            openLogs: { reactions.openLogs(runner.definition) }\n60|                        )\n61|                    }\n62|                }\n63|            }\n64|            if let error = props.runnerError {\n65|                HStack(alignment: .top, spacing: 8) {\n66|                    Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n67|                    Text(error).font(.caption).textSelection(.enabled).lineLimit(6)\n68|                    Spacer(minLength: 0)\n69|                    Button(action: reactions.clearRunnerError) { Image(systemName: \"xmark\") }.buttonStyle(.plain)\n70|                }.padding(10).background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n71|            }\n72|            HStack(spacing: 8) {\n73|                Button(\"Включить все\", action: reactions.enableAll)\n74|                    .buttonStyle(.borderedProminent).tint(.teal)\n75|                    .disabled(!props.changing.isEmpty || props.runners.allSatisfy { $0.status == .running || $0.status == .checking || $0.status == .missing || $0.status == .unknown })\n76|                Button(\"Выключить все…\", action: reactions.disableAll)\n77|                    .buttonStyle(.bordered)\n78|                    .disabled(!props.changing.isEmpty || props.runners.allSatisfy { $0.status == .stopped || $0.status == .checking })\n79|                Button(\"Добавить раннер…\", action: reactions.openRegistration)\n80|                    .buttonStyle(.bordered)\n81|                    .accessibilityIdentifier(\"Add runner button\")\n82|            }\n83|            Text(\"Закрытие приложения не останавливает CI. Автозапуск определяется настройками каждой службы.\")\n84|                .font(.system(size: 11)).foregroundStyle(.secondary)\n85|        }\n86|        .padding(20)\n87|    }\n88|\n89|    // MARK: - GitHub\n90|\n91|    private var githubTab: some View {\n92|        ScrollView {\n93|            VStack(alignment: .leading, spacing: 16) {\n94|                switch props.github.connection {\n95|                case .disconnected:\n96|                    disconnectedView\n97|                case .requestingCode:\n98|                    HStack(spacing: 10) {\n99|                        ProgressView().controlSize(.small)\n100|                        Text(\"Запрашиваем код входа…\").font(.callout)\n101|                    }\n102|                    .padding(.vertical, 20)\n103|                case .awaitingUser(let userCode, let uri, let expiresIn, let interval):\n104|                    awaitingView(userCode: userCode, uri: uri, expiresIn: expiresIn, interval: interval)\n105|                case .verifyingAccount:\n106|                    HStack(spacing: 10) {\n107|                        ProgressView().controlSize(.small)\n108|                        Text(\"Проверяем аккаунт…\").font(.callout)\n109|                    }\n110|                    .padding(.vertical, 20)\n111|                case .verifyingInstallations(let username):\n112|                    HStack(spacing: 10) {\n113|                        ProgressView().controlSize(.small)\n114|                        Text(\"Проверяем установки для @\\(username)…\").font(.callout)\n115|                    }\n116|                    .padding(.vertical, 20)\n117|                case .connected(let username, let host):\n118|                    connectedView(username: username, host: host)\n119|                case .failed(let message, let retry):\n120|                    failedView(message: message, retry: retry)\n121|                }\n122|            }\n123|            .padding(20)\n124|            .frame(maxWidth: .infinity, alignment: .leading)\n125|        }\n126|    }\n127|\n128|    private var disconnectedView: some View {\n129|        VStack(alignment: .leading, spacing: 12) {\n130|            Text(\"Подключение GitHub\").font(.system(size: 15, weight: .semibold))\n131|            Text(\"Необязательно. Локальное включение и выключение работает без входа. Вход добавляет подтверждённые online/busy/labels.\")\n132|                .font(.callout).foregroundStyle(.secondary)\n133|            HStack(spacing: 8) {\n134|                Text(\"Сервер:\").font(.callout)\n135|                TextField(\"github.com\", text: Binding(\n136|                    get: { props.github.serverHostText },\n137|                    set: reactions.serverHostChanged\n138|                ))\n139|                .textFieldStyle(.roundedBorder)\n140|                .frame(width: 220)\n141|                .accessibilityIdentifier(\"GitHub server host field\")\n142|            }\n143|            Button(\"Войти через GitHub\", action: reactions.beginLogin)\n144|                .buttonStyle(.borderedProminent).tint(.teal)\n145|                .accessibilityIdentifier(\"GitHub sign in button\")\n146|            Text(\"Откроется код подтверждения. Пароль и 2FA вводятся только на сайте GitHub. Токены хранятся в Keychain.\")\n147|                .font(.system(size: 11)).foregroundStyle(.secondary)\n148|            if let syncError = props.github.syncError {\n149|                Text(syncError).font(.caption).foregroundStyle(.orange)\n150|            }\n151|        }\n152|    }\n153|\n154|    private func awaitingView(userCode: String, uri: URL, expiresIn: Int, interval: Int) -> some View {\n155|        VStack(alignment: .leading, spacing: 12) {\n156|            Text(\"Подтвердите подключение на GitHub\").font(.system(size: 15, weight: .semibold))\n157|            Text(userCode)\n158|                .font(.system(size: 32, weight: .bold, design: .monospaced))\n159|                .textSelection(.enabled)\n160|                .accessibilityIdentifier(\"GitHub user code\")\n161|            Text(\"Код действует ~\\(expiresIn / 60) мин. Опрос каждые \\(interval) c.\")\n162|                .font(.callout).foregroundStyle(.secondary)\n163|            HStack(spacing: 8) {\n164|                Button(\"Скопировать код\") { reactions.copyCode(userCode) }\n165|                    .buttonStyle(.bordered)\n166|                    .accessibilityIdentifier(\"GitHub copy code button\")\n167|                Button(\"Открыть GitHub\") { reactions.openVerification(uri) }\n168|                    .buttonStyle(.bordered)\n169|                    .accessibilityIdentifier(\"GitHub open verification button\")\n170|                Button(\"Отмена\", action: reactions.cancelLogin)\n171|                    .buttonStyle(.plain).foregroundStyle(.secondary)\n172|                    .accessibilityIdentifier(\"GitHub cancel login button\")\n173|            }\n174|            Text(\"Браузер — системный по умолчанию. Отмена уничтожает временный код и прекращает опрос.\")\n175|                .font(.system(size: 11)).foregroundStyle(.secondary)\n176|        }\n177|    }\n178|\n179|    private func connectedView(username: String, host: String) -> some View {\n180|        VStack(alignment: .leading, spacing: 12) {\n181|            HStack {\n182|                VStack(alignment: .leading, spacing: 3) {\n183|                    Text(\"Подключено как @\\(username)\").font(.system(size: 15, weight: .semibold))\n184|                    Text(host).font(.callout).foregroundStyle(.secondary)\n185|                    if let synced = props.github.lastSyncAt {\n186|                        Text(\"Обновлено: \\(synced.formatted(date: .omitted, time: .standard))\")\n187|                            .font(.system(size: 11)).foregroundStyle(.secondary)\n188|                    }\n189|                }\n190|                Spacer()\n191|                Button(\"Обновить\", action: reactions.refreshInstallations)\n192|                    .buttonStyle(.bordered).controlSize(.small)\n193|                    .accessibilityIdentifier(\"GitHub refresh button\")\n194|            }\n195|            if let syncError = props.github.syncError {\n196|                HStack(alignment: .top, spacing: 8) {\n197|                    Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n198|                    Text(syncError).font(.caption).lineLimit(6)\n199|                    Spacer(minLength: 0)\n200|                }.padding(10).background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n201|            }\n202|            HStack(spacing: 8) {\n203|                Button(\"Выйти на этом Mac\", action: reactions.logout)\n204|                    .buttonStyle(.bordered)\n205|                    .accessibilityIdentifier(\"GitHub logout button\")\n206|                Button(\"Отозвать доступ в GitHub…\", action: reactions.revokeInGitHub)\n207|                    .buttonStyle(.plain).font(.callout).foregroundStyle(.secondary)\n208|            }\n209|            Text(\"Выход удаляет локальные токены и останавливает опрос GitHub. Локальные службы продолжают работать.\")\n210|                .font(.system(size: 11)).foregroundStyle(.secondary)\n211|            Divider()\n212|            HStack {\n213|                Text(\"Установки GitHub App\").font(.system(size: 13, weight: .semibold))\n214|                Spacer()\n215|                Button(\"Предоставить доступ организации…\", action: reactions.grantAccess)\n216|                    .buttonStyle(.plain).font(.callout)\n217|            }\n218|            if props.github.installations.isEmpty {\n219|                Text(\"Нет доступных установок. Предоставьте доступ организации или запросите одобрение владельца.\")\n220|                    .font(.callout).foregroundStyle(.secondary)\n221|            } else {\n222|                Picker(\"Установка\", selection: Binding(\n223|                    get: { props.github.selectedInstallationID },\n224|                    set: reactions.selectInstallation\n225|                )) {\n226|                    ForEach(props.github.installations) { installation in\n227|                        Text(\"\\(installation.account) (\\(installation.accountType))\").tag(Optional(installation.id))\n228|                    }\n229|                }\n230|                .pickerStyle(.menu)\n231|                .accessibilityIdentifier(\"GitHub installation picker\")\n232|            }\n233|            Text(\"Репозитории\").font(.system(size: 13, weight: .semibold))\n234|            if props.github.repositories.isEmpty {\n235|                Text(\"Репозитории выбранной установки появятся здесь.\")\n236|                    .font(.callout).foregroundStyle(.secondary)\n237|            } else {\n238|                VStack(alignment: .leading, spacing: 6) {\n239|                    ForEach(props.github.repositories) { repo in\n240|                        Toggle(\n241|                            repo.fullName,\n242|                            isOn: Binding(\n243|                                get: { props.github.selectedRepositoryIDs.contains(repo.id) },\n244|                                set: { enabled in\n245|                                    var next = props.github.selectedRepositoryIDs\n246|                                    if enabled { next.insert(repo.id) } else { next.remove(repo.id) }\n247|                                    reactions.selectRepositories(next)\n248|                                }\n249|                            )\n250|                        )\n251|                        .font(.callout)\n252|                    }\n253|                }\n254|            }\n255|            if !props.github.selectedRepositoryIDs.isEmpty {\n256|                Text(\"Выбрано: \\(props.github.selectedRepositoryIDs.count). Применяется при регистрации раннера.\")\n257|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n258|            }\n259|        }\n260|    }\n261|\n262|    private func failedView(message: String, retry: GitHubAuth.RetryKind) -> some View {\n263|        VStack(alignment: .leading, spacing: 12) {\n264|            HStack(spacing: 8) {\n265|                Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n266|                Text(\"Не удалось подключить GitHub\").font(.system(size: 15, weight: .semibold))\n267|            }\n268|            Text(message).font(.callout).textSelection(.enabled)\n269|            HStack(spacing: 8) {\n270|                switch retry {\n271|                case .newCode:\n272|                    Button(\"Получить новый код\", action: reactions.beginLogin)\n273|                        .buttonStyle(.borderedProminent).tint(.teal)\n274|                case .retry:\n275|                    Button(\"Повторить\", action: reactions.beginLogin)\n276|                        .buttonStyle(.borderedProminent).tint(.teal)\n277|                case .relogin:\n278|                    Button(\"Войти снова\", action: reactions.beginLogin)\n279|                        .buttonStyle(.borderedProminent).tint(.teal)\n280|                case .grantAccess:\n281|                    Button(\"Предоставить доступ…\", action: reactions.grantAccess)\n282|                        .buttonStyle(.borderedProminent).tint(.teal)\n283|                    Button(\"Повторить\", action: reactions.beginLogin)\n284|                        .buttonStyle(.bordered)\n285|                case .none:\n286|                    EmptyView()\n287|                }\n288|                if retry != .none {\n289|                    Button(\"Отмена\", action: reactions.cancelLogin)\n290|                        .buttonStyle(.plain).foregroundStyle(.secondary)\n291|                } else {\n292|                    Button(\"Назад\", action: reactions.cancelLogin)\n293|                        .buttonStyle(.bordered)\n294|                }\n295|            }\n296|            Text(\"Локальное управление раннерами остаётся доступным.\")\n297|                .font(.system(size: 11)).foregroundStyle(.secondary)\n298|        }\n299|    }\n300|\n301|    // MARK: - General\n302|\n303|    private var generalTab: some View {\n304|        ScrollView {\n305|            VStack(alignment: .leading, spacing: 14) {\n306|                Text(\"Основные\").font(.system(size: 15, weight: .semibold))\n307|                Toggle(\n308|                    \"Открывать Runner Control при входе\",\n309|                    isOn: Binding(get: { props.general.launchAtLoginEnabled }, set: reactions.setLaunchAtLogin)\n310|                )\n311|                .font(.callout)\n312|                Text(\"Отдельно от запуска CI. Для новых управляемых служб запуск раннера при входе выключен.\")\n313|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n314|                Divider()\n315|                HStack {\n316|                    Text(\"Версия \\(props.general.appVersion)\").font(.callout).foregroundStyle(.secondary)\n317|                    Spacer()\n318|                    Button(\"Проверить обновления…\", action: reactions.checkForUpdates)\n319|                        .disabled(!props.general.canCheckForUpdates)\n320|                }\n321|                Toggle(\"Проверять автоматически\", isOn: Binding(get: { props.general.automaticChecks }, set: reactions.setAutomaticChecks))\n322|                    .font(.callout)\n323|                Toggle(\"Устанавливать автоматически\", isOn: Binding(get: { props.general.automaticDownloads }, set: reactions.setAutomaticDownloads))\n324|                    .font(.callout)\n325|                    .disabled(!props.general.automaticChecks)\n326|                Text(\"Выход и обновление приложения оставляют уже запущенные службы работать.\")\n327|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n328|                Divider()\n329|                HStack {\n330|                    Text(\"RELUX WORKS\").font(.system(size: 9, weight: .semibold, design: .monospaced)).tracking(1.5).foregroundStyle(.tertiary)\n331|                    Spacer()\n332|                    Button(\"Закрыть приложение\", action: reactions.quit).buttonStyle(.plain)\n333|                        .font(.system(size: 11)).foregroundStyle(.secondary)\n334|                }\n335|            }\n336|            .padding(20)\n337|            .frame(maxWidth: .infinity, alignment: .leading)\n338|        }\n339|    }\n340|}","final_result":true}}}
