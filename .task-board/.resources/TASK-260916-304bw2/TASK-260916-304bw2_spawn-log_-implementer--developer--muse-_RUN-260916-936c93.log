{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dc93","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":3236,"recorded_at":1780531400006467,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"call_id":"call_01a0a9671cf172d8aa6c916502a97cc8","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n(386 line(s) above)\n387|@Test func stopWorksDespiteMissingRunnerStartBlockedOnBadManifest() async throws {\n388|    let root = FileManager.default.temporaryDirectory.appendingPathComponent(\"Stop-\" + UUID().uuidString)\n389|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n390|    defer { try? FileManager.default.removeItem(at: root) }\n391|    let dir = try makeRunnerDir(parent: root, name: \"svc\", label: \"actions.runner.test.stop\")\n392|    try FileManager.default.removeItem(at: dir.appendingPathComponent(\".runner\"))\n393|    let definition = Runners.Definition(\n394|        id: \"actions.runner.test.stop\", title: \"svc\", detail: \"acme\",\n395|        directory: dir, githubURL: URL(string: \"https://github.com/acme\")!,\n396|        servicePlist: dir.appendingPathComponent(\"manual-service.plist\")\n397|    )\n398|    // Stop succeeds without .runner.\n399|    let stopExecutor = FakeExecutor([\n400|        CommandResult(code: 0, output: \"state = running\"),\n401|        CommandResult(code: 0, output: \"\"),\n402|        CommandResult(code: 113, output: \"Could not find service x\")\n403|    ])\n404|    let stopService = LaunchAgentService(definitions: [definition], executor: stopExecutor, userID: 501)\n405|    try await stopService.setEnabled(false, id: definition.id)\n406|    #expect(await stopExecutor.calls.contains([\"/bin/launchctl\", \"bootout\", \"gui/501/\" + definition.id]))\n407|    // Start is blocked on a damaged manifest (no bootstrap).\n408|    let badPlist = dir.appendingPathComponent(\"manual-service.plist\")\n409|    let bad: [String: Any] = [\"Label\": definition.id, \"WorkingDirectory\": \"/elsewhere\", \"ProgramArguments\": [\"/bin/false\"]]\n410|    try PropertyListSerialization.data(fromPropertyList: bad, format: .xml, options: 0).write(to: badPlist)\n411|    // Restore .runner so the failure is attributed to the manifest, not registration.\n412|    let config: [String: Any] = [\"agentName\": \"svc\", \"gitHubUrl\": \"https://github.com/acme\", \"workFolder\": \"_work\"]\n413|    try JSONSerialization.data(withJSONObject: config).write(to: dir.appendingPathComponent(\".runner\"))\n414|    let startExecutor = FakeExecutor([])\n415|    let startService = LaunchAgentService(definitions: [definition], executor: startExecutor, userID: 501)\n416|    do {\n417|        try await startService.setEnabled(true, id: definition.id)\n418|        Issue.record(\"Start admitted a mismatched manifest\")\n419|    } catch let error as RunnerError {\n420|        guard case .manifestMismatch = error else {\n421|            Issue.record(\"Wrong start-block error: \\(error)\"); return\n422|        }\n423|    }\n424|    #expect(await startExecutor.calls.isEmpty)\n425|}\n426|\n427|@Test func unsupportedShowsStateButRefusesControl() async throws {\n428|    let root = FileManager.default.temporaryDirectory.appendingPathComponent(\"Unsup-\" + UUID().uuidString)\n429|    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n430|    defer { try? FileManager.default.removeItem(at: root) }\n431|    let dir = try makeRunnerDir(parent: root, name: \"svc\", label: \"actions.runner.test.unsup\")\n432|    let definition = Runners.Definition(\n433|        id: \"actions.runner.test.unsup\", title: \"svc\", detail: \"acme\",\n434|        directory: dir, githubURL: URL(string: \"https://github.com/acme\")!,\n435|        servicePlist: dir.appendingPathComponent(\"manual-service.plist\"),\n436|        controllerKind: .unsupported\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
