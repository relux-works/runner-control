{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c86b","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":656,"recorded_at":1780531400001307,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"call_id":"call_01a0a9503de57670a1c71f47ef21c5c9","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubAuth+Flow.swift`.\n(499 line(s) above)\n500|    private func refreshInstallations() async {\n501|        let gen = generation\n502|        guard session != nil else { return }\n503|        let sess: GitHubAuth.Session\n504|        let token: String\n505|        do {\n506|            (sess, token) = try await currentToken(generation: gen)\n507|        } catch is CancellationError {\n508|            return\n509|        } catch let error as GitHubAuth.AuthError {\n510|            guard !isStale(gen) else { return }\n511|            switch error {\n512|            case .revoked, .unauthorized, .tokenRefreshFailed:\n513|                await action { GitHubAuth.Action.failed(message: GitHubAuth.AuthError.revoked.localizedDescription, retry: .relogin) }\n514|            default:\n515|                await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n516|            }\n517|            return\n518|        } catch {\n519|            guard !isStale(gen) else { return }\n520|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n521|            return\n522|        }\n523|        do {\n524|            let installations = try await api.fetchInstallations(config: sess.config, token: token)\n525|            guard !isStale(gen) else { return }\n526|            await action { GitHubAuth.Action.installationsLoaded(installations) }\n527|            guard !isStale(gen) else { return }\n528|            await action { GitHubAuth.Action.syncSucceeded(now()) }\n529|        } catch is CancellationError {\n530|            return\n531|        } catch let error as GitHubAuth.AuthError {\n532|            guard !isStale(gen) else { return }\n533|            switch error {\n534|            case .unauthorized, .revoked:\n535|                await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .relogin) }\n536|            default:\n537|                await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n538|            }\n539|        } catch {\n540|            guard !isStale(gen) else { return }\n541|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n542|        }\n543|    }\n544|\n545|    private func selectInstallation(_ id: Int64?) async {\n546|        let gen = generation\n547|        await action { GitHubAuth.Action.installationSelected(id) }\n548|        guard !isStale(gen) else { return }\n549|        guard let id, session != nil else { return }\n550|        let sess: GitHubAuth.Session\n551|        let token: String\n552|        do {\n553|            (sess, token) = try await currentToken(generation: gen)\n554|        } catch is CancellationError {\n555|            return\n556|        } catch let error as GitHubAuth.AuthError {\n557|            guard !isStale(gen) else { return }\n558|            switch error {\n559|            case .revoked, .unauthorized, .tokenRefreshFailed:\n560|                await action { GitHubAuth.Action.failed(message: GitHubAuth.AuthError.revoked.localizedDescription, retry: .relogin) }\n561|            default:\n562|                await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n563|            }\n564|            return\n565|        } catch {\n566|            guard !isStale(gen) else { return }\n567|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n568|            return\n569|        }\n570|        do {\n571|            let repos = try await api.fetchRepositories(config: sess.config, token: token, installationID: id)\n572|            guard !isStale(gen) else { return }\n573|            await action { GitHubAuth.Action.repositoriesLoaded(installationID: id, repositories: repos) }\n574|            guard !isStale(gen) else { return }\n575|            await action { GitHubAuth.Action.syncSucceeded(now()) }\n576|        } catch is CancellationError {\n577|            return\n578|        } catch let error as GitHubAuth.AuthError {\n579|            guard !isStale(gen) else { return }\n580|            switch error {\n581|            case .unauthorized, .revoked:\n582|                await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .relogin) }\n583|            default:\n584|                await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n585|            }\n586|        } catch {\n587|            guard !isStale(gen) else { return }\n588|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n589|        }\n590|    }\n591|\n592|    private nonisolated static func retryKind(for error: GitHubAuth.AuthError) -> GitHubAuth.RetryKind {\n593|        switch error {\n594|        case .denied, .codeExpired: .newCode\n595|        case .unauthorized, .revoked, .tokenRefreshFailed: .relogin\n596|        case .forbidden, .needsApproval, .needsInstallation: .grantAccess\n597|        case .ssoRequired, .missingClientID, .patNotSupported: .none\n598|        case .cancelled: .none\n599|        case .network, .rateLimited, .slowDown, .authorizationPending: .retry\n600|        }\n601|    }\n602|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c86d","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":657,"recorded_at":1780531400001309,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"call_id":"call_01a0a9503fc07237a8abfe883059e24a","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n1|import CryptoKit\n2|import Foundation\n3|\n4|/// Filesystem installer for downloaded GitHub Actions runners.\n5|///\n6|/// Production path: download bytes → SHA-256 verify → tar extract →\n7|/// `bin/runsvc.sh` copied into the root and chmodded (as official `svc.sh`\n8|/// would) → exact `config.sh` invocation → manual LaunchAgent plist.\n9|/// All side effects stay below `installRoot`; tests inject a temporary root,\n10|/// a fake downloader, and fixtures instead of touching production runners.\n11|public actor RunnerInstallerService {\n12|    public static let markerFileName = \".runnercontrol-install.json\"\n13|    public static let installOS = \"osx\"\n14|\n15|    private let installRoot: URL\n16|    private let downloader: @Sendable (URL) async throws -> Data\n17|    private let executor: any CommandExecuting\n18|    private let currentArch: @Sendable () -> String\n19|    private let hasher: @Sendable (Data) -> String\n20|\n21|    public init(\n22|        installRoot: URL? = nil,\n23|        downloader: (@Sendable (URL) async throws -> Data)? = nil,\n24|        executor: (any CommandExecuting)? = nil,\n25|        currentArch: (@Sendable () -> String)? = nil,\n26|        hasher: (@Sendable (Data) -> String)? = nil\n27|    ) {\n28|        self.installRoot = installRoot\n29|            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/GitHubActions\")\n30|        self.downloader = downloader ?? { url in\n31|            let (data, _) = try await URLSession.shared.data(from: url)\n32|            return data\n33|        }\n34|        self.executor = executor ?? CommandExecutor()\n35|        self.currentArch = currentArch ?? {\n36|            #if arch(arm64)\n37|            return \"arm64\"\n38|            #else\n39|            return \"x64\"\n40|            #endif\n41|        }\n42|        self.hasher = hasher ?? { data in\n43|            SHA256.hash(data: data).map { String(format: \"%02x\", $0) }.joined()\n44|        }\n45|    }\n46|\n47|    public nonisolated var root: URL { installRoot }\n48|    public nonisolated var architecture: String { currentArch() }\n49|\n50|    /// Single installer-wide mutation lease. The registration wizard runs\n51|    /// ONE active mutating installer operation per app instance\n52|    /// (download/extract, config.sh, service setup, partial recovery),\n53|    /// for ANY directory. Acquired synchronously before the first await and\n54|    /// released only when the owning operation settles, so actor reentrancy\n55|    /// can never admit two concurrent mutations — no path-identity\n56|    /// comparison, and therefore no filesystem-alias bypass class\n57|    /// (symlinks, case variants, Unicode equivalences). Abandoning a UI\n58|    /// generation does not release this resource; only the settling side\n59|    /// effect does. Ordinary start/stop of already-installed runners and\n60|    /// multiple installed CI runners are unaffected: they never take this\n61|    /// lease.\n62|    private var activeOperation: UUID?\n63|    /// Directory the lease owner is mutating. Diagnostic only: refusal never\n64|    /// compares paths, it refuses whenever a lease is held.\n65|    private var activePath: String?\n66|\n67|    public func directory(for installDirName: String) -> URL {\n68|        installRoot.appendingPathComponent(installDirName)\n69|    }\n70|\n71|    private nonisolated static func isSymlink(atPath path: String) -> Bool {\n72|        (try? FileManager.default.destinationOfSymbolicLink(atPath: path)) != nil\n73|    }\n74|\n75|    /// Refuses Finder-alias installation paths before any side effect. A\n76|    /// Finder alias is not a transparent directory like a symlink: operating\n77|    /// through its spelling would not operate on the target, so alias\n78|    /// spellings are rejected instead of being followed. Symlinks are not\n79|    /// refused here — and must be excluded explicitly because\n80|    /// `isAliasFileKey` is also true for symlinks such as the system `/var`\n81|    /// and `/tmp` links every temporary path resolves through. Concurrent\n82|    /// symlink-alias mutations are serialized by the installer-wide lease,\n83|    /// which compares nothing about paths.\n84|    nonisolated static func ensureNoAlias(at directory: URL) throws {\n85|        var current = URL(fileURLWithPath: directory.path).standardizedFileURL\n86|        while true {\n87|            if FileManager.default.fileExists(atPath: current.path),\n88|               !isSymlink(atPath: current.path),\n89|               (try? current.resourceValues(forKeys: [.isAliasFileKey]))?.isAliasFile == true {\n90|                throw RunnerRegistration.RegistrationError.invalidDraft(\n91|                    \"Installation path '\\(directory.path)' resolves through a Finder alias at '\\(current.path)'. Choose a direct folder path instead of an alias.\"\n92|                )\n93|            }\n94|            let parent = current.deletingLastPathComponent()\n95|            if parent.path == current.path { break }\n96|            current = parent\n97|        }\n98|    }\n99|\n100|    /// Acquires the installer-wide mutation lease for `directory`.\n101|    /// Synchronous: callers must invoke it before their first await so the\n102|    /// check-and-set is atomic under actor isolation. Throws a retryable\n103|    /// `installerBusy` whenever ANY live operation holds the lease,\n104|    /// regardless of directory — there is no path comparison to bypass.\n105|    /// Returns the owner token; the caller must hold it across awaits and\n106|    /// release that exact token when the operation settles.\n107|    private func acquireMutationLease(for directory: URL) throws -> UUID {\n108|        try Self.ensureNoAlias(at: directory)\n109|        guard activeOperation == nil else {\n110|            throw RunnerRegistration.RegistrationError.installerBusy(path: directory.path)\n111|        }\n112|        let token = UUID()\n113|        activeOperation = token\n114|        activePath = directory.path\n115|        return token\n116|    }\n117|\n118|    /// Releases the installer-wide lease, but only for its exact owner. A\n119|    /// token that does not match the current owner releases nothing, so a\n120|    /// stale or foreign completion can never unlock a newer operation.\n121|    private func releaseMutationLease(_ token: UUID) {\n122|        guard activeOperation == token else { return }\n123|        activeOperation = nil\n124|        activePath = nil\n125|    }\n126|\n127|    /// Refuses a synchronous mutation (service setup, recovery) while the\n128|    /// installer lease is held by a live async side effect. No insert:\n129|    /// without an await the caller itself cannot interleave, it only needs\n130|    /// to respect the lease held by another operation. Refuses for ANY\n131|    /// directory while ANY mutation is live.\n132|    private func requireIdleInstaller(_ directory: URL) throws {\n133|        try Self.ensureNoAlias(at: directory)\n134|        guard activeOperation == nil else {\n135|            throw RunnerRegistration.RegistrationError.installerBusy(path: directory.path)\n136|        }\n137|    }\n138|\n139|    // MARK: - Idempotency markers\n140|\n141|    public struct Marker: Codable, Sendable, Equatable {\n142|        public var scopeKey: String\n143|        public var completedSteps: Set<String>\n144|        /// Server the directory was configured against (`.runner` host is\n145|        /// authoritative; this records the config-time expectation so a\n146|        /// group/server change cannot reuse an old configured marker).\n147|        public var serverHost: String?\n148|        /// Dedicated group passed to `config.sh --runnergroup` (org scope).\n149|        /// `.runner` does not record it, so the marker must: a group-name\n150|        /// edit never claims the old group's configuration as its own.\n151|        public var groupName: String?\n152|        public init(\n153|            scopeKey: String, completedSteps: Set<String> = [],\n154|            serverHost: String? = nil, groupName: String? = nil\n155|        ) {\n156|            self.scopeKey = scopeKey; self.completedSteps = completedSteps\n157|            self.serverHost = serverHost; self.groupName = groupName\n158|        }\n159|    }\n160|\n161|    public static let stepDownloaded = \"downloaded\"\n162|    public static let stepInstalled = \"installed\"\n163|    public static let stepConfigured = \"configured\"\n164|    public static let stepServiceReady = \"serviceReady\"\n165|\n166|    public func loadMarker(directory: URL) -> Marker? {\n167|        let url = directory.appendingPathComponent(Self.markerFileName)\n168|        guard let data = try? Data(contentsOf: url) else { return nil }\n169|        return try? JSONDecoder().decode(Marker.self, from: data)\n170|    }\n171|\n172|    private func storeMarker(_ marker: Marker, directory: URL) throws {\n173|        let data = try JSONEncoder().encode(marker)\n174|        try data.write(to: directory.appendingPathComponent(Self.markerFileName), options: .atomic)\n175|    }\n176|\n177|    public func markCompleted(\n178|        _ step: String, directory: URL, scopeKey: String,\n179|        serverHost: String? = nil, groupName: String? = nil\n180|    ) throws {\n181|        var marker = loadMarker(directory: directory) ?? Marker(scopeKey: scopeKey)\n182|        marker.completedSteps.insert(step)\n183|        if let serverHost { marker.serverHost = serverHost }\n184|        if let groupName { marker.groupName = groupName }\n185|        try storeMarker(marker, directory: directory)\n186|    }\n187|\n188|    public func hasCompleted(_ step: String, directory: URL) -> Bool {\n189|        loadMarker(directory: directory)?.completedSteps.contains(step) == true\n190|    }\n191|\n192|    // MARK: - Install\n193|\n194|    /// Downloads, verifies, and extracts the official package. Idempotent:\n195|    /// a completed `installed` marker with matching scope and server skips\n196|    /// the work. Refuses to overwrite an already-registered directory (no\n197|    /// duplicates).\n198|    public func downloadAndInstall(\n199|        asset: RunnerRegistration.DownloadAsset,\n200|        draft: RunnerRegistration.Draft,\n201|        serverHost: String? = nil\n202|    ) async throws -> URL {\n203|        try RunnerRegistration.Gates.validateNoSpace(\n204|            installDirName: draft.installDirName, workFolder: draft.workFolder\n205|        )\n206|        let directory = self.directory(for: draft.installDirName)\n207|        if directory.path.contains(\" \") {\n208|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n209|        }\n210|        // Installer-wide ownership for the whole mutation, acquired before\n211|        // the first await (reuse check included): any second mutation while\n212|        // this install is live — same directory or not — is refused\n213|        // retryably instead of starting a second download/extract. The owner\n214|        // token is held across awaits and only that exact token releases.\n215|        let lease = try acquireMutationLease(for: directory)\n216|        defer { releaseMutationLease(lease) }\n217|        let files = FileManager.default\n218|        if let marker = loadMarker(directory: directory),\n219|           marker.completedSteps.contains(Self.stepInstalled),\n220|           marker.scopeKey == draft.scope.scopeKey,\n221|           Self.markerServerMatches(marker: marker, serverHost: serverHost),\n222|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n223|            return directory\n224|        }\n225|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n226|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: draft.runnerName)\n227|        }\n228|        let bytes: Data\n229|        do {\n230|            bytes = try await downloader(asset.downloadURL)\n231|        } catch {\n232|            throw RunnerRegistration.RegistrationError.network(\"Runner download failed: \\(error.localizedDescription)\")\n233|        }\n234|        // Fail closed: the official downloads endpoint documents\n235|        // `sha256_checksum`, and an install without a verified digest is\n236|        // refused rather than trusted on TLS alone.\n237|        guard let expected = asset.sha256Checksum, !expected.isEmpty else {\n238|            throw RunnerRegistration.RegistrationError.integrityMismatch\n239|        }\n240|        let actual = hasher(bytes)\n241|        guard actual.lowercased() == expected.lowercased() else {\n242|            throw RunnerRegistration.RegistrationError.integrityMismatch\n243|        }\n244|        try files.createDirectory(at: directory, withIntermediateDirectories: true)\n245|        let archive = files.temporaryDirectory.appendingPathComponent(UUID().uuidString + \"-\" + asset.filename)\n246|        defer { try? files.removeItem(at: archive) }\n247|        try bytes.write(to: archive, options: .atomic)\n248|        let result = try await executor.run(\"/usr/bin/tar\", [\"-xzf\", archive.path, \"-C\", directory.path])\n249|        guard result.code == 0 else {\n250|            throw RunnerRegistration.RegistrationError.network(\n251|                \"Runner archive extraction failed: \\(String(result.output.prefix(300)))\"\n252|            )\n253|        }\n254|        // Official packages keep runsvc.sh under bin/ until svc.sh installs it;\n255|        // a bare extraction leaves the root copy absent, so install it here.\n256|        try installRunsvc(directory: directory)\n257|        try markCompleted(\n258|            Self.stepDownloaded, directory: directory,\n259|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n260|        )\n261|        try markCompleted(\n262|            Self.stepInstalled, directory: directory,\n263|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n264|        )\n265|        return directory\n266|    }\n267|\n268|    /// Server binding for install reuse. A marker written without a server\n269|    /// (pre-revision-4) never satisfies a server-bound request: the next\n270|    /// install re-verifies instead of reusing unknown provenance. Direct\n271|    /// installer calls without a server (unit fixtures) keep the legacy\n272|    /// scope-only reuse.\n273|    static func markerServerMatches(marker: Marker, serverHost: String?) -> Bool {\n274|        guard let want = serverHost else { return true }\n275|        guard let have = marker.serverHost else { return false }\n276|        return RunnerRegistration.OperationIdentity.normalizeServerHost(have)\n277|            == RunnerRegistration.OperationIdentity.normalizeServerHost(want)\n278|    }\n279|\n280|    /// Copies official `bin/runsvc.sh` into the installation root and makes\n281|    /// it executable, mirroring what official `svc.sh install` would do.\n282|    public func installRunsvc(directory: URL) throws {\n283|        let files = FileManager.default\n284|        let source = directory.appendingPathComponent(\"bin/runsvc.sh\")\n285|        let target = directory.appendingPathComponent(\"runsvc.sh\")\n286|        guard files.fileExists(atPath: source.path) else {\n287|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing bin/runsvc.sh.\")\n288|        }\n289|        if files.fileExists(atPath: target.path) {\n290|            try files.removeItem(at: target)\n291|        }\n292|        try files.copyItem(at: source, to: target)\n293|        try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: target.path)\n294|    }\n295|\n296|    // MARK: - Configure\n297|\n298|    /// Runs the exact `config.sh` invocation. Skips when a previous attempt\n299|    /// already registered this directory (marker + `.runner` present), so\n300|    /// retries never create orphan or duplicate GitHub registrations.\n301|    /// Returns the local agent ID read back from `.runner`.\n302|    @discardableResult\n303|    public func runConfig(\n304|        directory: URL,\n305|        scopeURL: String,\n306|        token: String,\n307|        draft: RunnerRegistration.Draft,\n308|        runnerGroup: String?\n309|    ) async throws -> Int64? {\n310|        try await runConfig(\n311|            directory: directory, scopeURL: scopeURL, token: token,\n312|            draft: draft, runnerGroup: runnerGroup, replace: draft.allowReplace\n313|        )\n314|    }\n315|\n316|    /// Explicit-`replace` variant. Production callers pass\n317|    /// `draft.allowReplace`; tests drive both values.\n318|    @discardableResult\n319|    public func runConfig(\n320|        directory: URL,\n321|        scopeURL: String,\n322|        token: String,\n323|        draft: RunnerRegistration.Draft,\n324|        runnerGroup: String?,\n325|        replace: Bool\n326|    ) async throws -> Int64? {\n327|        let files = FileManager.default\n328|        let scopeHost = URL(string: scopeURL)?.host ?? \"\"\n329|        // Installer-wide ownership for the whole config, acquired before the\n330|        // first await (resume checks included): any second mutation while\n331|        // this config.sh is live is refused retryably instead of invoking\n332|        // another config.sh. The lease is released only when this operation\n333|        // settles; an abandoned UI generation never releases it. The owner\n334|        // token is held across awaits and only that exact token releases.\n335|        let lease = try acquireMutationLease(for: directory)\n336|        defer { releaseMutationLease(lease) }\n337|        if hasCompleted(Self.stepConfigured, directory: directory),\n338|           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n339|            // Idempotent resume never returns a stale ID: the existing\n340|            // configuration must still match this draft on this server.\n341|            let local = readLocalRegistration(directory: directory)\n342|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n343|                local: local, configured: true, draft: draft, serverHost: scopeHost\n344|            )\n345|            try Self.verifyConfiguredGroup(\n346|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n347|            )\n348|            return verified\n349|        }\n350|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n351|           hasCompleted(Self.stepConfigured, directory: directory) {\n352|            let local = readLocalRegistration(directory: directory)\n353|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n354|                local: local, configured: true, draft: draft, serverHost: scopeHost\n355|            )\n356|            try Self.verifyConfiguredGroup(\n357|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n358|            )\n359|            return verified\n360|        }\n361|        let spec = RunnerRegistration.ConfigSpec(\n362|            scopeURL: scopeURL, token: token, name: draft.runnerName,\n363|            workFolder: draft.workFolder, labels: draft.labels,\n364|            runnerGroup: runnerGroup, replace: replace\n365|        )\n366|        let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n367|        let executable = directory.appendingPathComponent(\"config.sh\").path\n368|        guard files.fileExists(atPath: executable) else {\n369|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n370|        }\n371|        let result = try await executor.run(executable, args)\n372|        guard result.code == 0 else {\n373|            // Never echo the token: config output may repeat arguments.\n374|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [token])\n375|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n376|        }\n377|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n378|            throw RunnerRegistration.RegistrationError.configFailed(\n379|                \"config.sh reported success but .runner is missing.\"\n380|            )\n381|        }\n382|        try markCompleted(\n383|            Self.stepConfigured, directory: directory, scopeKey: draft.scope.scopeKey,\n384|            serverHost: scopeHost, groupName: runnerGroup\n385|        )\n386|        return readAgentID(directory: directory)\n387|    }\n388|\n389|    /// `.runner` does not record the org group, so the configured marker\n390|    /// does. A resume whose marker names another group (or predates group\n391|    /// recording) refuses instead of claiming the old group's configuration\n392|    /// as the new draft's. Repository scope never configures a group.\n393|    static func verifyConfiguredGroup(\n394|        marker: Marker?, runnerGroup: String?, draft: RunnerRegistration.Draft\n395|    ) throws {\n396|        switch draft.scope {\n397|        case .repository:\n398|            return\n399|        case .organization:\n400|            break\n401|        }\n402|        let wanted = (runnerGroup ?? draft.groupName).trimmingCharacters(in: .whitespacesAndNewlines)\n403|        guard let have = marker?.groupName?.trimmingCharacters(in: .whitespacesAndNewlines),\n404|              !have.isEmpty else {\n405|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n406|                \"Directory '\\(draft.installDirName)' was configured before group recording. Reconfigure for group '\\(wanted)' instead of reusing the old configuration.\"\n407|            )\n408|        }\n409|        guard have == wanted else {\n410|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n411|                \"Local registration was configured for group '\\(have)', not '\\(wanted)'. Reconfigure instead of reusing the old group's configuration.\"\n412|            )\n413|        }\n414|    }\n415|\n416|    // MARK: - Dedicated-group ownership\n417|\n418|    public static let ownershipFileName = \".runnercontrol-groups.json\"\n419|\n420|    private func ownershipFile() -> URL {\n421|        installRoot.appendingPathComponent(Self.ownershipFileName)\n422|    }\n423|\n424|    private static func ownershipKey(serverHost: String, org: String, name: String) -> String {\n425|        \"\\(RunnerRegistration.OperationIdentity.normalizeServerHost(serverHost))\\u{0}\\(org.lowercased())\\u{0}\\(name)\"\n426|    }\n427|\n428|    /// Returns the locally recorded dedicated-group ID for\n429|    /// `server` + `org` + `name`, or nil when this Mac never created (or\n430|    /// took over) that group on that server. Name matches on GitHub alone\n431|    /// never count as ownership, and ownership on one server never\n432|    /// authorizes adoption on another.\n433|    public func loadOwnedGroupID(serverHost: String, org: String, name: String) -> Int64? {\n434|        guard let data = try? Data(contentsOf: ownershipFile()),\n435|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n436|        return table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)]\n437|    }\n438|\n439|    public func saveOwnedGroupID(serverHost: String, org: String, name: String, groupID: Int64) throws {\n440|        let file = ownershipFile()\n441|        var table: [String: Int64] = [:]\n442|        if let data = try? Data(contentsOf: file),\n443|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n444|            table = decoded\n445|        }\n446|        table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)] = groupID\n447|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n448|        let data = try JSONEncoder().encode(table)\n449|        try data.write(to: file, options: .atomic)\n450|    }\n451|\n452|    /// Reads the local `.runner` identity without touching credentials.\n453|    /// Returns nil only when the file is missing or unparseable; a present\n454|    /// but incomplete file returns a partial struct so verification can name\n455|    /// the exact missing field instead of crashing.\n456|    public func readLocalRegistration(directory: URL) -> RunnerRegistration.LocalRegistration? {\n457|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n458|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n459|        var agentID: Int64?\n460|        if let id = object[\"agentId\"] as? Int64 { agentID = id }\n461|        else if let id = object[\"agentId\"] as? Int { agentID = Int64(id) }\n462|        else if let id = object[\"agentId\"] as? NSNumber { agentID = id.int64Value }\n463|        return RunnerRegistration.LocalRegistration(\n464|            agentID: agentID,\n465|            agentName: object[\"agentName\"] as? String,\n466|            gitHubURL: object[\"gitHubUrl\"] as? String,\n467|            workFolder: object[\"workFolder\"] as? String\n468|        )\n469|    }\n470|\n471|    /// Reads the local agent ID from `.runner` without touching credentials.\n472|    public func readAgentID(directory: URL) -> Int64? {\n473|        readLocalRegistration(directory: directory)?.agentID\n474|    }\n475|\n476|    // MARK: - Manual LaunchAgent\n477|\n478|    /// Writes the manual service plist (RunAtLoad off for new runners) and\n479|    /// validates it matches the directory. Never bootstraps the service:\n480|    /// enabling is the user's separate action.\n481|    @discardableResult\n482|    public func setupService(directory: URL, label: String) throws -> URL {\n483|        guard !directory.path.contains(\" \") else {\n484|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n485|        }\n486|        // Never rewrite the service while the installer lease is held by a\n487|        // live install/config; the caller retries after that operation\n488|        // settles.\n489|        try requireIdleInstaller(directory)\n490|        let files = FileManager.default\n491|        guard files.fileExists(atPath: directory.appendingPathComponent(\"runsvc.sh\").path) else {\n492|            throw RunnerRegistration.RegistrationError.network(\n493|                \"runsvc.sh is missing; reinstall before setting up the service.\"\n494|            )\n495|        }\n496|        let plist = directory.appendingPathComponent(\"manual-service.plist\")\n497|        let payload: [String: Any] = [\n498|            \"Label\": label,\n499|            \"ProgramArguments\": [directory.appendingPathComponent(\"runsvc.sh\").path],\n500|            \"WorkingDirectory\": directory.path,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
