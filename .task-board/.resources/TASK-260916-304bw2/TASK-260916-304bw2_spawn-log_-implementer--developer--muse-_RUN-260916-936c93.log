    if let exact = members.first(where: { $0.id == agentID }) {\\\",\\n \\\"            if let exact = (members.first(where: { $0.id == agentID }) ?? members.first(where: { $0.name == agentName })) {\\\",\\n \\\"groupAccessUsesFreshAPIMembershipNotStalePool\\\")\\nrun_mutant(\\\"apply-admits-stale-group\\\", F,\\n \\\"            guard fresh.id == groupID else {\\\\n                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\\\\n                    \\\\\\\"Runner moved from group \\\\\\\\(groupID) to '\\\\\\\\(fresh.name)' (\\\\\\\\(fresh.id)) since loading. Reload instead of editing a stale group.\\\\\\\"\\\\n                )\\\\n            }\\\",\\n \\\"            _ = groupID\\\",\\n \\\"applyGroupAccessRefusesStaleGroup\\\")\\nrun_mutant(\\\"apply-admits-shared-without-takeover\\\", F,\\n \\\"            try RunnerRegistration.Gates.authorizeGroupTakeover(\\\\n                groupName: fresh.name, existingID: fresh.id,\\\\n                ownedID: owned, allowTakeover: allowTakeover\\\\n            )\\\",\\n \\\"            _ = allowTakeover\\\",\\n \\\"applyGroupAccessRequiresTakeoverForShared\\\")\\nrun_mutant(\\\"apply-admits-partial-confirm\\\", F,\\n \\\"            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: repos, confirmed: confirmed)\\\",\\n \\\"            _ = repos\\\",\\n \\\"applyGroupAccessConfirmsExactRepos\\\")\\nPY\",\n  \"description\": \"Run group gate mutants\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"group-adopts-same-name-foreign: FAIL-as-expected\\napply-admits-stale-group: FAIL-as-expected\\napply-admits-shared-without-takeover: FAIL-as-expected\\napply-admits-partial-confirm: FAIL-as-expected\\n\",\n  \"original_output_bytes\": 194,\n  \"original_output_tokens\": 49,\n  \"truncated\": false\n}","final_result":true}}}
