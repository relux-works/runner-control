{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5e5","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":333,"recorded_at":1780531400000661,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a94f-9ae4-75e2-9655-bdcbeb5dac1e"},"task_id":"01a0a94f-9ae4-75e2-9655-bdcbeb5dac1e","event":{"kind":"output","task_id":"01a0a94f-9ae4-75e2-9655-bdcbeb5dac1e","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+State.swift`.\n1|import Combine\n2|import Foundation\n3|import Relux\n4|\n5|extension RunnerRegistration {\n6|    /// Wizard phases. Holds IDs, paths, and errors — never tokens.\n7|    public enum Phase: Sendable, Equatable {\n8|        case idle\n9|        case drafting\n10|        case resolvingGroup\n11|        case preparingDownload\n12|        case installing\n13|        case registering\n14|        case settingUpService\n15|        case done\n16|    }\n17|\n18|    @MainActor public final class State: ObservableObject, Relux.HybridState {\n19|        @Published public internal(set) var phase: Phase = .idle\n20|        @Published public internal(set) var draft: Draft?\n21|        @Published public internal(set) var working: Bool = false\n22|        @Published public internal(set) var group: RunnerGroup?\n23|        @Published public internal(set) var groupRepositoryIDs: [Int64] = []\n24|        @Published public internal(set) var asset: DownloadAsset?\n25|        @Published public internal(set) var installPath: String?\n26|        @Published public internal(set) var runnerID: Int64?\n27|        @Published public internal(set) var localAgentID: Int64?\n28|        @Published public internal(set) var completedSteps: Set<String> = []\n29|        @Published public internal(set) var error: String?\n30|        @Published public internal(set) var failedStep: String?\n31|        /// Retained permission errors (403/missing rights). Draft edits never\n32|        /// clear them; only an explicit retry, reset, or dismiss does.\n33|        @Published public internal(set) var permissionError: String?\n34|\n35|        public init() {}\n36|\n37|        public func cleanup() async {\n38|            phase = .idle\n39|            draft = nil\n40|            working = false\n41|            group = nil\n42|            groupRepositoryIDs = []\n43|            asset = nil\n44|            installPath = nil\n45|            runnerID = nil\n46|            localAgentID = nil\n47|            completedSteps = []\n48|            error = nil\n49|            failedStep = nil\n50|            permissionError = nil\n51|        }\n52|    }\n53|\n54|    public enum Action: Relux.Action {\n55|        case draftBegan(Draft)\n56|        case draftUpdated(Draft)\n57|        case stepStarted(String)\n58|        case stepFinished(String)\n59|        case groupResolved(RunnerGroup, repositoryIDs: [Int64])\n60|        case downloadReady(DownloadAsset)\n61|        case installed(path: String)\n62|        case registered(runnerID: Int64?, localAgentID: Int64?)\n63|        case serviceReady(plistPath: String)\n64|        case repositoryAccessApplied([Int64])\n65|        case labelsApplied([String])\n66|        case failed(message: String, step: String)\n67|        case permissionDenied(message: String, step: String)\n68|        case permissionDismissed\n69|        case cancelled\n70|        case didReset\n71|    }\n72|\n73|    public enum Effect: Relux.Effect {\n74|        case beginDraft(Draft)\n75|        case updateDraft(Draft)\n76|        case resolveGroup\n77|        case prepareDownload\n78|        case downloadAndInstall\n79|        case registerRunner\n80|        case setupService\n81|        case applyRepositoryAccess(groupID: Int64, repositories: Set<Int64>)\n82|        case applyLabels([String])\n83|        case retry\n84|        case cancel\n85|        case reset\n86|        case dismissPermission\n87|    }\n88|}","final_result":true}}}
