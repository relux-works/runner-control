{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb09","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":991,"recorded_at":1780531400001977,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"call_id":"call_01a0a95250d575c187df1dcdd6eb2de1","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n(499 line(s) above)\n500|            guard !isStale(gen) else { return }\n501|            let serverHost = auth.identity.serverHost\n502|            let resolved: RunnerRegistration.DownloadAsset\n503|            if let asset {\n504|                resolved = asset\n505|            } else {\n506|                resolved = try await prepareDownloadInner(draft: draft, auth: auth, generation: gen)\n507|                guard !isStale(gen) else { return }\n508|                asset = resolved\n509|                await action { RunnerRegistration.Action.downloadReady(resolved) }\n510|            }\n511|            guard !isStale(gen) else { return }\n512|            let directory = try await installer.downloadAndInstall(\n513|                asset: resolved, draft: draft, serverHost: serverHost\n514|            )\n515|            guard !isStale(gen) else { return }\n516|            installPath = directory.path\n517|            await action { RunnerRegistration.Action.installed(path: directory.path) }\n518|            await finishStep(\"downloadAndInstall\", generation: gen)\n519|        } catch {\n520|            await fail(error, step: \"downloadAndInstall\", generation: gen)\n521|        }\n522|    }\n523|\n524|    // MARK: - Register\n525|\n526|    private func registerRunner() async {\n527|        let gen = generation\n528|        guard workingOwner == nil else { return }\n529|        guard let draft else {\n530|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"registerRunner\") }\n531|            return\n532|        }\n533|        guard let installPath else {\n534|            failedStep = \"registerRunner\"\n535|            await action {\n536|                RunnerRegistration.Action.failed(message: \"Install the runner package first.\", step: \"registerRunner\")\n537|            }\n538|            return\n539|        }\n540|        workingOwner = gen\n541|        workingStep = \"registerRunner\"\n542|        await action { RunnerRegistration.Action.stepStarted(\"registerRunner\") }\n543|        let directory = URL(fileURLWithPath: installPath)\n544|        let scopeKey = Self.tokenScopeKey(draft: draft)\n545|        do {\n546|            // The whole step — including idempotent resume — is bound to one\n547|            // authenticated server. Resume verifies the full local identity\n548|            // (server/scope/agent/name/work-folder/group) before any success:\n549|            // a drifted or re-targeted draft never adopts the old marker.\n550|            let auth = try await currentUserToken(generation: gen)\n551|            guard !isStale(gen) else { return }\n552|            _ = syncServerBinding(auth.identity.serverHost)\n553|            guard !isStale(gen) else { return }\n554|            let serverHost = auth.identity.serverHost\n555|            if await installer.hasCompleted(RunnerInstallerService.stepConfigured, directory: directory) {\n556|                let local = await installer.readLocalRegistration(directory: directory)\n557|                let localID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n558|                    local: local, configured: true, draft: draft, serverHost: serverHost\n559|                )\n560|                let marker = await installer.loadMarker(directory: directory)\n561|                let groupName: String?\n562|                switch draft.scope {\n563|                case .organization:\n564|                    groupName = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n565|                case .repository:\n566|                    groupName = nil\n567|                }\n568|                try RunnerInstallerService.verifyConfiguredGroup(\n569|                    marker: marker, runnerGroup: groupName, draft: draft\n570|                )\n571|                let remoteID = try await resolveBoundRemoteRunnerID(\n572|                    draft: draft, localAgentID: localID, auth: auth, generation: gen\n573|                )\n574|                guard !isStale(gen) else { return }\n575|                runnerID = remoteID\n576|                await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: localID) }\n577|                await finishStep(\"registerRunner\", generation: gen)\n578|                return\n579|            }\n580|            guard !isStale(gen) else { return }\n581|            // Duplicate guard before any token is minted: without explicit\n582|            // replace consent a remote name match refuses the run so config\n583|            // can never silently replace another machine's registration.\n584|            // The list is complete (every page followed); a duplicate that\n585|            // appears after this check still fails at config.sh, which omits\n586|            // `--replace` unless the user explicitly allowed it.\n587|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n588|            let existing = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n589|            guard !isStale(gen) else { return }\n590|            try RunnerRegistration.Gates.rejectRemoteDuplicate(\n591|                name: wanted, isTaken: existing.contains(where: { $0.name == wanted }),\n592|                allowReplace: draft.allowReplace\n593|            )\n594|            guard !isStale(gen) else { return }\n595|            let created = try await api.createRegistrationToken(\n596|                config: auth.config, token: auth.token, scope: draft.scope\n597|            )\n598|            guard !isStale(gen) else { return }\n599|            let scoped = RunnerRegistration.ScopedToken(\n600|                token: created.token, expiresAt: created.expiresAt, obtainedAt: now()\n601|            )\n602|            try await registrationTokens.save(scoped, scopeKey: scopeKey)\n603|            guard !isStale(gen) else { return }\n604|            let groupName: String?\n605|            switch draft.scope {\n606|            case .organization: groupName = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n607|            case .repository: groupName = nil\n608|            }\n609|            let localID: Int64?\n610|            do {\n611|                localID = try await installer.runConfig(\n612|                    directory: directory,\n613|                    scopeURL: draft.scope.configURL(serverHost: auth.identity.serverHost),\n614|                    token: created.token,\n615|                    draft: draft,\n616|                    runnerGroup: groupName\n617|                )\n618|            } catch {\n619|                await registrationTokens.delete(scopeKey: scopeKey)\n620|                throw error\n621|            }\n622|            // The single-use token is consumed by config.sh: delete it before\n623|            // any follow-up API call so a post-config failure (review F6)\n624|            // reports the error without retaining the token.\n625|            await registrationTokens.delete(scopeKey: scopeKey)\n626|            guard !isStale(gen) else { return }\n627|            // Bind the remote ID to the verified local agent, never to a\n628|            // bare name match: a same-name foreign runner must fail here\n629|            // instead of becoming this installation's identity.\n630|            let verifiedLocal: RunnerRegistration.LocalRegistration? = await installer.readLocalRegistration(\n631|                directory: directory\n632|            )\n633|            let verifiedConfigured = await installer.hasCompleted(\n634|                RunnerInstallerService.stepConfigured, directory: directory\n635|            )\n636|            let verifiedID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n637|                local: verifiedLocal,\n638|                configured: verifiedConfigured && localID != nil,\n639|                draft: draft,\n640|                serverHost: serverHost\n641|            )\n642|            let remoteID = try await resolveBoundRemoteRunnerID(\n643|                draft: draft, localAgentID: verifiedID, auth: auth, generation: gen\n644|            )\n645|            guard !isStale(gen) else { return }\n646|            runnerID = remoteID\n647|            await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: verifiedID) }\n648|            guard !isStale(gen) else { return }\n649|            await action { RunnerRegistration.Action.permissionDismissed }\n650|            await finishStep(\"registerRunner\", generation: gen)\n651|        } catch {\n652|            await fail(error, step: \"registerRunner\", generation: gen)\n653|        }\n654|    }\n655|\n656|    /// Binds the complete remote runner list to the verified local agent ID.\n657|    /// Returns nil when this agent is not listed yet (convergence, retryable);\n658|    /// throws when the list contradicts the local identity. The step's own\n659|    /// auth is reused: no mid-step session reload may mix servers.\n660|    private func resolveBoundRemoteRunnerID(\n661|        draft: RunnerRegistration.Draft, localAgentID: Int64,\n662|        auth: FlowUserToken, generation gen: Int\n663|    ) async throws -> Int64? {\n664|        guard !isStale(gen) else { throw CancellationError() }\n665|        let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n666|        let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n667|        return try RunnerRegistration.Gates.boundRemoteRunnerID(\n668|            localAgentID: localAgentID, name: wanted, runners: runners\n669|        )\n670|    }\n671|\n672|    // MARK: - Service\n673|\n674|    private func setupService() async {\n675|        let gen = generation\n676|        guard workingOwner == nil else { return }\n677|        guard let draft, let installPath else {\n678|            failedStep = \"setupService\"\n679|            await action {\n680|                RunnerRegistration.Action.failed(message: \"Register the runner first.\", step: \"setupService\")\n681|            }\n682|            return\n683|        }\n684|        workingOwner = gen\n685|        workingStep = \"setupService\"\n686|        await action { RunnerRegistration.Action.stepStarted(\"setupService\") }\n687|        let directory = URL(fileURLWithPath: installPath)\n688|        do {\n689|            // Service setup never declares registration complete on its own:\n690|            // it requires this operation's verified configured local identity\n691|            // on the authenticated server.\n692|            let auth = try await currentUserToken(generation: gen)\n693|            guard !isStale(gen) else { return }\n694|            _ = syncServerBinding(auth.identity.serverHost)\n695|            guard !isStale(gen) else { return }\n696|            let local = await installer.readLocalRegistration(directory: directory)\n697|            let configured = await installer.hasCompleted(\n698|                RunnerInstallerService.stepConfigured, directory: directory\n699|            )\n700|            _ = try RunnerRegistration.Gates.verifiedLocalAgentID(\n701|                local: local, configured: configured, draft: draft,\n702|                serverHost: auth.identity.serverHost\n703|            )\n704|            let marker = await installer.loadMarker(directory: directory)\n705|            let groupName: String?\n706|            switch draft.scope {\n707|            case .organization:\n708|                groupName = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n709|            case .repository:\n710|                groupName = nil\n711|            }\n712|            try RunnerInstallerService.verifyConfiguredGroup(\n713|                marker: marker, runnerGroup: groupName, draft: draft\n714|            )\n715|            guard !isStale(gen) else { return }\n716|            let label = Self.serviceLabel(draft: draft)\n717|            let plist = try await installer.setupService(directory: directory, label: label)\n718|            guard !isStale(gen) else { return }\n719|            await action { RunnerRegistration.Action.serviceReady(plistPath: plist.path) }\n720|            await finishStep(\"setupService\", generation: gen)\n721|        } catch {\n722|            await fail(error, step: \"setupService\", generation: gen)\n723|        }\n724|    }\n725|\n726|    // MARK: - Editable access and labels\n727|\n728|    private func applyRepositoryAccess(groupID: Int64, ids: Set<Int64>) async {\n729|        let gen = generation\n730|        guard workingOwner == nil else { return }\n731|        guard let draft else {\n732|            await action {\n733|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyRepositoryAccess\")\n734|            }\n735|            return\n736|        }\n737|        do {\n738|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n739|            guard case .organization(let org) = draft.scope else { return }\n740|            workingOwner = gen\n741|            workingStep = \"applyRepositoryAccess\"\n742|            pendingRepositoryIDs = ids\n743|            pendingTargetGroupID = groupID\n744|            await action { RunnerRegistration.Action.stepStarted(\"applyRepositoryAccess\") }\n745|            let auth = try await currentUserToken(generation: gen)\n746|            guard !isStale(gen) else { return }\n747|            _ = syncServerBinding(auth.identity.serverHost)\n748|            guard !isStale(gen) else { return }\n749|            guard let group else {\n750|                throw RunnerRegistration.RegistrationError.invalidDraft(\n751|                    \"Resolve the dedicated group first.\"\n752|                )\n753|            }\n754|            try RunnerRegistration.Gates.authorizeGroupMutation(\n755|                targetGroupID: groupID, resolvedGroupID: group.id,\n756|                allowFlag: draft.allowGroupMutation\n757|            )\n758|            guard !isStale(gen) else { return }\n759|            try await api.setGroupRepositories(\n760|                config: auth.config, token: auth.token, org: org, groupID: group.id, selectedRepositoryIDs: ids\n761|            )\n762|            guard !isStale(gen) else { return }\n763|            let confirmed = try await api.fetchGroupRepositories(\n764|                config: auth.config, token: auth.token, org: org, groupID: group.id\n765|            )\n766|            guard !isStale(gen) else { return }\n767|            // The confirmed list is complete (every page followed). It must\n768|            // equal the request exactly; otherwise the draft keeps the\n769|            // requested selection and the step fails instead of claiming a\n770|            // partial write as success.\n771|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: ids, confirmed: confirmed)\n772|            guard !isStale(gen) else { return }\n773|            if var current = self.draft {\n774|                current.selectedRepositoryIDs = Set(confirmed)\n775|                self.draft = current\n776|            }\n777|            await action { RunnerRegistration.Action.repositoryAccessApplied(confirmed) }\n778|            guard !isStale(gen) else { return }\n779|            await action { RunnerRegistration.Action.permissionDismissed }\n780|            pendingRepositoryIDs = nil\n781|            pendingTargetGroupID = nil\n782|            await finishStep(\"applyRepositoryAccess\", generation: gen)\n783|        } catch {\n784|            await fail(error, step: \"applyRepositoryAccess\", generation: gen)\n785|        }\n786|    }\n787|\n788|    private func applyLabels(_ labels: [String]) async {\n789|        let gen = generation\n790|        guard workingOwner == nil else { return }\n791|        guard let draft else {\n792|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyLabels\") }\n793|            return\n794|        }\n795|        let trimmed = labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }\n796|        guard !trimmed.isEmpty else {\n797|            failedStep = \"applyLabels\"\n798|            await action {\n799|                RunnerRegistration.Action.failed(message: \"At least one label is required.\", step: \"applyLabels\")\n800|            }\n801|            return\n802|        }\n803|        guard let installPath else {\n804|            failedStep = \"applyLabels\"\n805|            await action {\n806|                RunnerRegistration.Action.failed(\n807|                    message: \"Register the runner first so labels target this installation.\",\n808|                    step: \"applyLabels\"\n809|                )\n810|            }\n811|            return\n812|        }\n813|        workingOwner = gen\n814|        workingStep = \"applyLabels\"\n815|        pendingLabels = trimmed\n816|        await action { RunnerRegistration.Action.stepStarted(\"applyLabels\") }\n817|        let directory = URL(fileURLWithPath: installPath)\n818|        do {\n819|            // Label writes require this operation's verified local identity\n820|            // on the authenticated server — checked before any runner-list or\n821|            // label network. A remote name match alone never authorizes\n822|            // mutating another runner, and a foreign-server ID never\n823|            // authorizes writes on this session's server.\n824|            let auth = try await currentUserToken(generation: gen)\n825|            guard !isStale(gen) else { return }\n826|            _ = syncServerBinding(auth.identity.serverHost)\n827|            guard !isStale(gen) else { return }\n828|            let local = await installer.readLocalRegistration(directory: directory)\n829|            let configured = await installer.hasCompleted(\n830|                RunnerInstallerService.stepConfigured, directory: directory\n831|            )\n832|            let localAgentID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n833|                local: local, configured: configured, draft: draft,\n834|                serverHost: auth.identity.serverHost\n835|            )\n836|            guard !isStale(gen) else { return }\n837|            // Re-bind on every write: the stored ID is never trusted across\n838|            // edits, retries, or remote drift. A missing agent fails with\n839|            // not-found; a contradictory list fails with mismatch. Neither\n840|            // guesses by name.\n841|            let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n842|            guard !isStale(gen) else { return }\n843|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n844|            let bound = try RunnerRegistration.Gates.boundRemoteRunnerID(\n845|                localAgentID: localAgentID, name: wanted, runners: runners\n846|            )\n847|            guard let runnerID = bound else {\n848|                throw RunnerRegistration.RegistrationError.remoteRunnerNotFound(\n849|                    \"GitHub does not list agent \\(localAgentID) for this scope yet; refusing to guess '\\(wanted)' by name. Retry after registration converges.\"\n850|                )\n851|            }\n852|            try await api.setRunnerLabels(\n853|                config: auth.config, token: auth.token, scope: draft.scope, runnerID: runnerID, labels: trimmed\n854|            )\n855|            guard !isStale(gen) else { return }\n856|            self.runnerID = runnerID\n857|            if var current = self.draft {\n858|                current.labels = trimmed\n859|                self.draft = current\n860|            }\n861|            await action { RunnerRegistration.Action.labelsApplied(trimmed) }\n862|            pendingLabels = nil\n863|            await finishStep(\"applyLabels\", generation: gen)\n864|        } catch {\n865|            await fail(error, step: \"applyLabels\", generation: gen)\n866|        }\n867|    }\n868|\n869|    // MARK: - Retry / cancel / reset\n870|\n871|    private func retry() async {\n872|        guard workingOwner == nil else { return }\n873|        guard let step = failedStep else { return }\n874|        switch step {\n875|        case \"resolveGroup\": await resolveGroup()\n876|        case \"prepareDownload\": await prepareDownload()\n877|        case \"downloadAndInstall\": await downloadAndInstall()\n878|        case \"registerRunner\": await registerRunner()\n879|        case \"setupService\": await setupService()\n880|        case \"applyRepositoryAccess\":\n881|            if let ids = pendingRepositoryIDs, let target = pendingTargetGroupID {\n882|                await applyRepositoryAccess(groupID: target, ids: ids)\n883|            }\n884|        case \"applyLabels\":\n885|            if let labels = pendingLabels { await applyLabels(labels) }\n886|        default:\n887|            return\n888|        }\n889|    }\n890|\n891|    private func cancel() async {\n892|        // New generation takes over the UI lock immediately; the abandoned\n893|        // operation's installer lease (if any) stays held until that side\n894|        // effect settles, and its stale exit mutates nothing.\n895|        generation += 1\n896|        workingOwner = nil\n897|        workingStep = nil\n898|        if let draft {\n899|            await registrationTokens.delete(scopeKey: Self.tokenScopeKey(draft: draft))\n900|        }\n901|        failedStep = nil\n902|        pendingRepositoryIDs = nil\n903|        pendingTargetGroupID = nil\n904|        pendingLabels = nil\n905|        await action { RunnerRegistration.Action.cancelled }\n906|    }\n907|\n908|    private func reset() async {\n909|        // Same ownership handoff as cancel: the UI lock moves to the fresh\n910|        // generation at once; live side effects keep the installer lease\n911|        // and their stale exits mutate nothing.\n912|        generation += 1\n913|        workingOwner = nil\n914|        workingStep = nil\n915|        if let draft {\n916|            await registrationTokens.delete(scopeKey: Self.tokenScopeKey(draft: draft))\n917|        }\n918|        draft = nil\n919|        group = nil\n920|        asset = nil\n921|        installPath = nil\n922|        runnerID = nil\n923|        failedStep = nil\n924|        pendingRepositoryIDs = nil\n925|        pendingTargetGroupID = nil\n926|        pendingLabels = nil\n927|        boundServerHost = nil\n928|        await action { RunnerRegistration.Action.didReset }\n929|    }\n930|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
