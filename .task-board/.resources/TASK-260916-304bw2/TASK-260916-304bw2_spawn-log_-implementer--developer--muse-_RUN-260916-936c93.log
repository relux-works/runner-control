{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d19d","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":1833,"recorded_at":1780531400003661,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a959-fb8a-7543-bd86-f55da4579d05"},"task_id":"01a0a959-fb8a-7543-bd86-f55da4579d05","event":{"kind":"output","task_id":"01a0a959-fb8a-7543-bd86-f55da4579d05","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRuntime.swift`.\n1|import Foundation\n2|import Relux\n3|import OSLog\n4|@MainActor public enum RunnerRuntime {\n5|    public static func make(state: Runners.State, service: any RunnerServicing = LaunchAgentService()) async -> Relux {\n6|        let runtime = await Relux(logger: RuntimeLogger())\n7|        let flow = await Runners.Flow(service: service, dispatcher: runtime.dispatcher)\n8|        runtime.register(Runners.Module(state: state, flow: flow))\n9|        return runtime\n10|    }\n11|\n12|    public static func make(\n13|        state: Runners.State,\n14|        githubState: GitHubAuth.State,\n15|        service: any RunnerServicing = LaunchAgentService(),\n16|        transport: any GitHubHTTPTransport = URLSessionGitHubTransport(),\n17|        store: any GitHubCredentialStoring = GitHubKeychainStore()\n18|    ) async -> Relux {\n19|        let registrationState = await MainActor.run { RunnerRegistration.State() }\n20|        return await make(state: state, githubState: githubState, registrationState: registrationState, service: service, transport: transport, store: store)\n21|    }\n22|\n23|    public static func make(\n24|        state: Runners.State,\n25|        githubState: GitHubAuth.State,\n26|        registrationState: RunnerRegistration.State,\n27|        service: any RunnerServicing = LaunchAgentService(),\n28|        transport: any GitHubHTTPTransport = URLSessionGitHubTransport(),\n29|        store: any GitHubCredentialStoring = GitHubKeychainStore()\n30|    ) async -> Relux {\n31|        let runtime = await Relux(logger: RuntimeLogger())\n32|        let flow = await Runners.Flow(service: service, dispatcher: runtime.dispatcher)\n33|        runtime.register(Runners.Module(state: state, flow: flow))\n34|        let deviceFlow = GitHubDeviceFlow(transport: transport)\n35|        let api = GitHubAPIClient(transport: transport)\n36|        let refresher = GitHubTokenRefresh(transport: transport, store: store)\n37|        let githubFlow = await GitHubAuth.Flow(deviceFlow: deviceFlow, api: api, refresher: refresher, store: store, dispatcher: runtime.dispatcher)\n38|        runtime.register(GitHubAuth.Module(state: githubState, flow: githubFlow))\n39|        let runnerAPI = GitHubRunnerAPIClient(transport: transport)\n40|        let installer = RunnerInstallerService()\n41|        let registrationTokens = RunnerRegistrationTokenStore()\n42|        let registrationFlow = await RunnerRegistration.Flow(\n43|            api: runnerAPI, installer: installer, registrationTokens: registrationTokens,\n44|            userStore: store, identityStore: UserDefaultsGitHubSessionIdentityStore(),\n45|            refresher: refresher, dispatcher: runtime.dispatcher\n46|        )\n47|        runtime.register(RunnerRegistration.Module(state: registrationState, flow: registrationFlow))\n48|        return runtime\n49|    }\n50|}\n51|struct RuntimeLogger: Relux.Logger {\n52|    func logAction(_ action: Relux.EnumReflectable, result: Relux.ActionResult?, startTimeInMillis: Int, privacy: Relux.OSLogPrivacy, fileID: String, functionName: String, lineNumber: Int) {\n53|        Logger(subsystem: \"works.relux.runnercontrol\", category: \"state\").debug(\"State event: \\(String(describing: type(of: action)), privacy: .public)\")\n54|    }\n55|}","final_result":true}}}
