{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c591","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":291,"recorded_at":1780531400000577,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a94f-8fe6-7e62-ad74-7a7601f85025"},"task_id":"01a0a94f-8fe6-7e62-ad74-7a7601f85025","event":{"kind":"output","task_id":"01a0a94f-8fe6-7e62-ad74-7a7601f85025","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+Module.swift`.\n1|import Relux\n2|extension Runners {\n3|    @MainActor public struct Module: Relux.Module {\n4|        nonisolated public var states: [any Relux.AnyState] { [state] }\n5|        nonisolated public var sagas: [any Relux.Saga] { [flow] }\n6|        public let state: State\n7|        public let flow: Flow\n8|        public init(state: State, flow: Flow) { self.state = state; self.flow = flow }\n9|    }\n10|}","final_result":true}}}
