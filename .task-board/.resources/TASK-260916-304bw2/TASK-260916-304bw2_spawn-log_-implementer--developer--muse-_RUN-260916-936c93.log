{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d137","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":1782,"recorded_at":1780531400003559,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a959-0329-7a31-a994-99e3cd451201"},"task_id":"01a0a959-0329-7a31-a994-99e3cd451201","event":{"kind":"output","task_id":"01a0a959-0329-7a31-a994-99e3cd451201","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n1|import Relux\n2|extension Runners {\n3|    public protocol IFlow: Relux.Flow {}\n4|    public actor Flow {\n5|        public let dispatcher: Relux.Dispatcher\n6|        private let service: any RunnerServicing\n7|        private var working: Set<String> = []\n8|        private var refreshing = false\n9|        private var revision = 0\n10|        public init(service: any RunnerServicing, dispatcher: Relux.Dispatcher? = nil) async {\n11|            self.service = service\n12|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n13|        }\n14|    }\n15|}\n16|extension Runners.Flow: Runners.IFlow {\n17|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n18|        guard let effect = effect as? Runners.Effect else { return .success }\n19|        switch effect {\n20|        case .refresh:\n21|            guard !refreshing, working.isEmpty else { return .success }\n22|            refreshing = true\n23|            let startedAt = revision\n24|            let snapshots = await service.snapshots()\n25|            // Do not publish a stale read if a command started during this await.\n26|            if working.isEmpty && revision == startedAt { await action { Runners.Action.refreshed(snapshots) } }\n27|            refreshing = false\n28|        case .setEnabled(let id, let enabled):\n29|            guard !working.contains(id) else { return .success }\n30|            working.insert(id)\n31|            revision += 1\n32|            await action { Runners.Action.changing(id, true) }\n33|            do { try await service.setEnabled(enabled, id: id) }\n34|            catch { await action { Runners.Action.failed(error.localizedDescription) } }\n35|            let snapshots = await service.snapshots()\n36|            await action { Runners.Action.refreshed(snapshots) }\n37|            working.remove(id)\n38|            await action { Runners.Action.changing(id, false) }\n39|        }\n40|        return .success\n41|    }\n42|}","final_result":true}}}
