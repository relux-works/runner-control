{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca3f","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":890,"recorded_at":1780531400001775,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"call_id":"call_01a0a951cf1d77f598f60657fa1027fa","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubRedaction.swift`.\n1|import Foundation\n2|\n3|extension GitHubAuth {\n4|    /// Redacts secret values from diagnostics. Never logs raw tokens.\n5|    /// Bound: no production caller in this slice. The diagnostics export\n6|    /// (log tail, _diag archive) lands with catalog/lifecycle; until then\n7|    /// RuntimeLogger emits action types only, so there is nothing to scrub.\n8|    public enum Redaction {\n9|        public static func sanitize(_ text: String, secrets: [String]) -> String {\n10|            var result = text\n11|            for secret in secrets where !secret.isEmpty {\n12|                result = result.replacingOccurrences(of: secret, with: \"[REDACTED]\")\n13|            }\n14|            // Scrub common token JSON shapes even when the exact value is unknown.\n15|            for key in [\"access_token\", \"refresh_token\", \"device_code\"] {\n16|                result = scrubJSONValue(for: key, in: result)\n17|            }\n18|            return result\n19|        }\n20|\n21|        private static func scrubJSONValue(for key: String, in text: String) -> String {\n22|            // \"key\":\"value\" and \"key\": \"value\" shapes.\n23|            var result = text\n24|            for pattern in [\"\\\"\\(key)\\\":\\\"\", \"\\\"\\(key)\\\": \\\"\"] {\n25|                var searchFrom = result.startIndex\n26|                while let keyRange = result.range(of: pattern, range: searchFrom..<result.endIndex) {\n27|                    let valueStart = keyRange.upperBound\n28|                    guard let valueEnd = result[valueStart...].firstIndex(of: \"\\\"\") else { break }\n29|                    result.replaceSubrange(valueStart..<valueEnd, with: \"[REDACTED]\")\n30|                    searchFrom = result.index(valueEnd, offsetBy: 0, limitedBy: result.endIndex) ?? result.endIndex\n31|                    if searchFrom >= result.endIndex { break }\n32|                }\n33|            }\n34|            return result\n35|        }\n36|    }\n37|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
