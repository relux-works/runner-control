{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e513","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":4324,"recorded_at":1780531400008643,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a96f-2e57-7a30-a7d7-58cd0709364d"},"task_id":"01a0a96f-2e57-7a30-a7d7-58cd0709364d","event":{"kind":"output","task_id":"01a0a96f-2e57-7a30-a7d7-58cd0709364d","chunk":"Read text file `Targets/RunnerControl/Sources/ManagementWindowPage.swift`.\n(217 line(s) above)\n218|            if !snapshot.remoteLabels.isEmpty {\n219|                detailRow(\"Labels\", snapshot.remoteLabels.joined(separator: \", \"))\n220|            }\n221|            if definition.detail.contains(\"/\") {\n222|                detailRow(\"Доступ\", \"Настраивается в GitHub\")\n223|            } else if snapshot.remoteGroup != nil {\n224|                detailRow(\"Группа\", snapshot.remoteGroup ?? \"—\")\n225|            } else {\n226|                detailRow(\"Доступ к репозиториям\", \"Настраивается в GitHub\")\n227|            }\n228|            if let synced = snapshot.remote?.updatedAt {\n229|                detailRow(\"GitHub обновлён\", synced.formatted(date: .omitted, time: .standard))\n230|            }\n231|            HStack {\n232|                Text(\"Запуск раннера при входе\").font(.callout)\n233|                Spacer()\n234|                if definition.controllerKind.canControl, let runAtLoad = definition.runAtLoad {\n235|                    Toggle(\"\", isOn: Binding(\n236|                        get: { runAtLoad },\n237|                        set: { reactions.setRunAtLoad(definition.id, $0) }\n238|                    ))\n239|                    .labelsHidden().toggleStyle(.switch).controlSize(.small)\n240|                    .help(\"Политика импортированной службы сохраняется. Изменение — отдельное действие.\")\n241|                } else {\n242|                    Text(\"—\").font(.callout).foregroundStyle(.secondary)\n243|                }\n244|            }\n245|            Text(\"Импортированная политика сохраняется и явно показывается, а не меняется молча.\")\n246|                .font(.system(size: 10)).foregroundStyle(.secondary)\n247|            Divider()\n248|            VStack(alignment: .leading, spacing: 8) {\n249|                HStack(spacing: 8) {\n250|                    if snapshot.status == .running {\n251|                        Button(\"Выключить…\") { reactions.setEnabled(definition.id, false) }\n252|                            .buttonStyle(.bordered)\n253|                            .disabled(props.runners.changing.contains(definition.id))\n254|                    } else {\n255|                        Button(\"Включить\") { reactions.setEnabled(definition.id, true) }\n256|                            .buttonStyle(.borderedProminent).tint(.teal)\n257|                            .disabled(props.runners.changing.contains(definition.id) || [.checking, .missing, .needsSetup, .unknown].contains(snapshot.status) || !definition.controllerKind.canControl)\n258|                    }\n259|                    Button(\"Журнал\") { reactions.loadLog(definition.id) }\n260|                        .buttonStyle(.bordered).controlSize(.small)\n261|                }\n262|                HStack(spacing: 8) {\n263|                    Button(\"Показать каталог\") { reactions.showDirectory(definition) }\n264|                        .buttonStyle(.plain).font(.callout)\n265|                    Button(\"Открыть GitHub\") { reactions.openGitHub(definition) }\n266|                        .buttonStyle(.plain).font(.callout)\n267|                }\n268|                HStack(spacing: 8) {\n269|                    Button(\"Переименовать…\") { reactions.renameRunner(definition.id) }\n270|                        .buttonStyle(.plain).font(.callout)\n271|                    Button(\"Выбрать перемещённую папку…\") { reactions.relink(definition.id) }\n272|                        .buttonStyle(.plain).font(.callout)\n273|                }\n274|                HStack(spacing: 8) {\n275|                    Button(\"Убрать из приложения\") { reactions.removeFromApp(definition.id) }\n276|                        .buttonStyle(.plain).font(.callout).foregroundStyle(.secondary)\n277|                        .help(\"Удаляет только запись каталога. Файлы, регистрация GitHub и служба не затрагиваются.\")\n278|                        .disabled(props.runners.unregistering.contains(definition.id))\n279|                    Button(\"Удалить из GitHub…\") { reactions.unregister(definition.id) }\n280|                        .buttonStyle(.plain).font(.callout).foregroundStyle(.red)\n281|                        .help(\"Явное удаление регистрации из GitHub. Требует остановки и подтверждения.\")\n282|                        .disabled(props.runners.unregistering.contains(definition.id) || snapshot.status == .running)\n283|                }\n284|                if props.runners.unregistering.contains(definition.id) {\n285|                    HStack(spacing: 6) {\n286|                        ProgressView().controlSize(.small)\n287|                        Text(\"Удаляем из GitHub…\").font(.caption).foregroundStyle(.secondary)\n288|                    }\n289|                }\n290|            }\n291|        }\n292|        .padding(12)\n293|        .background(.primary.opacity(0.03), in: RoundedRectangle(cornerRadius: 10))\n294|    }\n295|\n296|    private func detailRow(_ title: String, _ value: String) -> some View {\n297|        VStack(alignment: .leading, spacing: 2) {\n(more lines below)","final_result":true}}}
