{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c76f","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":530,"recorded_at":1780531400001055,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"call_id":"call_01a0a94fd3e5752e88636573e77258ea","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension RunnerRegistration {\n5|    public protocol IFlow: Relux.Flow {}\n6|\n7|    public actor Flow {\n8|        public let dispatcher: Relux.Dispatcher\n9|        private let api: GitHubRunnerAPIClient\n10|        private let installer: RunnerInstallerService\n11|        private let registrationTokens: any RunnerRegistrationTokenStoring\n12|        private let userStore: any GitHubCredentialStoring\n13|        private let identities: any GitHubSessionIdentityStoring\n14|        private let refresher: GitHubTokenRefresh\n15|        private let configProvider: @Sendable (String?) throws -> GitHubAuth.AppConfig\n16|        private let now: @Sendable () -> Date\n17|\n18|        private var generation = 0\n19|        /// Operation owner: the generation that holds the busy lock, or nil\n20|        /// when idle. Every step sets it to its starting generation before\n21|        /// its first await; every success/failure/cancel exit clears it only\n22|        /// when the exiting generation still owns it. A stale generation\n23|        /// never mutates a newer owner's lock, step, or failure state.\n24|        /// Abandoning a generation releases this UI lock so the new draft can\n25|        /// proceed, but never releases the installer-wide lease: a live side\n26|        /// effect keeps owning the installer until it settles, and any second\n27|        /// mutation meanwhile is refused as installer-busy.\n28|        private var workingOwner: Int?\n29|        private var workingStep: String?\n30|        private var draft: Draft?\n31|        private var group: RunnerGroup?\n32|        private var asset: DownloadAsset?\n33|        private var installPath: String?\n34|        private var runnerID: Int64?\n35|        private var failedStep: String?\n36|        private var pendingRepositoryIDs: Set<Int64>?\n37|        private var pendingTargetGroupID: Int64?\n38|        private var pendingLabels: [String]?\n39|        /// Authenticated server the cached progress is bound to. A session\n40|        /// change invalidates server-bound caches before any reuse, so a\n41|        /// group/runner ID from one server never authorizes writes on another.\n42|        private var boundServerHost: String?\n43|\n44|        public init(\n45|            api: GitHubRunnerAPIClient,\n46|            installer: RunnerInstallerService,\n47|            registrationTokens: any RunnerRegistrationTokenStoring,\n48|            userStore: any GitHubCredentialStoring,\n49|            identityStore: any GitHubSessionIdentityStoring,\n50|            refresher: GitHubTokenRefresh,\n51|            configProvider: (@Sendable (String?) throws -> GitHubAuth.AppConfig)? = nil,\n52|            now: (@Sendable () -> Date)? = nil,\n53|            dispatcher: Relux.Dispatcher? = nil\n54|        ) async {\n55|            self.api = api\n56|            self.installer = installer\n57|            self.registrationTokens = registrationTokens\n58|            self.userStore = userStore\n59|            self.identities = identityStore\n60|            self.refresher = refresher\n61|            self.configProvider = configProvider ?? { host in\n62|                try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\")\n63|            }\n64|            self.now = now ?? Date.init\n65|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n66|        }\n67|\n68|        /// Deterministic LaunchAgent label for a draft. Always carries the\n69|        /// `actions.runner.` prefix discovery requires.\n70|        public nonisolated static func serviceLabel(draft: Draft) -> String {\n71|            let scope = draft.scope.detail.replacingOccurrences(of: \"/\", with: \"-\")\n72|            let raw = \"actions.runner.\\(scope).\\(draft.installDirName)\"\n73|            let allowed = CharacterSet.alphanumerics.union(CharacterSet(charactersIn: \".-\"))\n74|            return raw.unicodeScalars.map { allowed.contains($0) ? String($0) : \"-\" }.joined()\n75|        }\n76|\n77|        public nonisolated static func tokenScopeKey(draft: Draft) -> String {\n78|            \"\\(draft.scope.scopeKey):\\(draft.installDirName)\"\n79|        }\n80|    }\n81|}\n82|\n83|/// Authenticated user token for wizard API calls. Never logged.\n84|private struct FlowUserToken: Sendable {\n85|    let config: GitHubAuth.AppConfig\n86|    let token: String\n87|    let identity: GitHubSessionIdentity\n88|}\n89|\n90|extension RunnerRegistration.Flow: RunnerRegistration.IFlow {\n91|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n92|        guard let effect = effect as? RunnerRegistration.Effect else { return .success }\n93|        switch effect {\n94|        case .beginDraft(let draft): await beginDraft(draft)\n95|        case .updateDraft(let draft): await updateDraft(draft)\n96|        case .resolveGroup: await resolveGroup()\n97|        case .prepareDownload: await prepareDownload()\n98|        case .downloadAndInstall: await downloadAndInstall()\n99|        case .registerRunner: await registerRunner()\n100|        case .setupService: await setupService()\n101|        case .applyRepositoryAccess(let groupID, let ids): await applyRepositoryAccess(groupID: groupID, ids: ids)\n102|        case .applyLabels(let labels): await applyLabels(labels)\n103|        case .retry: await retry()\n104|        case .cancel: await cancel()\n105|        case .reset: await reset()\n106|        case .dismissPermission: await action { RunnerRegistration.Action.permissionDismissed }\n107|        }\n108|        return .success\n109|    }\n110|\n111|    private func isStale(_ gen: Int) -> Bool { generation != gen }\n112|\n113|    // MARK: - Draft\n114|\n115|    private func beginDraft(_ draft: RunnerRegistration.Draft) async {\n116|        do {\n117|            try RunnerRegistration.Gates.validateDraft(draft)\n118|        } catch {\n119|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"beginDraft\") }\n120|            return\n121|        }\n122|        // A new draft abandons any in-flight completion: the old operation's\n123|        // success must never be attributed to the new draft. Already-started\n124|        // filesystem side effects keep the installer-wide lease until they\n125|        // settle; only their completion ownership is revoked via the\n126|        // generation bump, and the UI lock is released for the new draft.\n127|        let abandoned = workingOwner != nil\n128|        if abandoned {\n129|            generation += 1\n130|            workingOwner = nil\n131|            workingStep = nil\n132|        }\n133|        self.draft = draft\n134|        group = nil\n135|        asset = nil\n136|        installPath = nil\n137|        runnerID = nil\n138|        failedStep = nil\n139|        pendingRepositoryIDs = nil\n140|        pendingTargetGroupID = nil\n141|        pendingLabels = nil\n142|        boundServerHost = nil\n143|        await action { RunnerRegistration.Action.draftBegan(draft) }\n144|        if abandoned {\n145|            await action { RunnerRegistration.Action.cancelled }\n146|        }\n147|    }\n148|\n149|    private func updateDraft(_ draft: RunnerRegistration.Draft) async {\n150|        do {\n151|            try RunnerRegistration.Gates.validateDraft(draft)\n152|        } catch {\n153|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"updateDraft\") }\n154|            return\n155|        }\n156|        // Identity edits while working abandon the in-flight operation via\n157|        // the generation bump. Selections stay editable without cancelling\n158|        // unrelated steps — except the mutation they feed: a labels edit\n159|        // abandons in-flight applyLabels and a repository edit abandons\n160|        // in-flight applyRepositoryAccess, so an older completion can never\n161|        // overwrite the newer visible selection or report it as applied.\n162|        // Stale completions observe the bump at their next await boundary\n163|        // and emit nothing.\n164|        var abandoned = false\n165|        if let old = self.draft {\n166|            if workingOwner != nil, shouldAbandonInFlight(old: old, new: draft) {\n167|                generation += 1\n168|                workingOwner = nil\n169|                workingStep = nil\n170|                abandoned = true\n171|            }\n172|            invalidateProgress(old: old, new: draft)\n173|        }\n174|        self.draft = draft\n175|        await action { RunnerRegistration.Action.draftUpdated(draft) }\n176|        if abandoned {\n177|            await action { RunnerRegistration.Action.cancelled }\n178|        }\n179|    }\n180|\n181|    /// Invalidates cached success-progress bound to the changed identity\n182|    /// fields. Scope/install/name/group/work-folder edits never reuse\n183|    /// another registration's evidence; editable selections re-target pending\n184|    /// retries to the visible values instead. Mirrors the reducer's\n185|    /// invalidation. Group is part of the config identity (`--runnergroup`):\n186|    /// a group edit drops registration evidence as well, so the old group's\n187|    /// configuration is never claimed as the new draft's success.\n188|    private func invalidateProgress(old: RunnerRegistration.Draft, new: RunnerRegistration.Draft) {\n189|        if old.scope != new.scope {\n190|            group = nil\n191|            asset = nil\n192|            installPath = nil\n193|            runnerID = nil\n194|            pendingRepositoryIDs = nil\n195|            pendingTargetGroupID = nil\n196|            pendingLabels = nil\n197|            failedStep = nil\n198|            return\n199|        }\n200|        if old.installDirName != new.installDirName {\n201|            installPath = nil\n202|            runnerID = nil\n203|            pendingLabels = nil\n204|            if [\"downloadAndInstall\", \"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n205|                failedStep = nil\n206|            }\n207|        }\n208|        let oldName = old.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n209|        let newName = new.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n210|        if oldName != newName {\n211|            runnerID = nil\n212|            pendingLabels = nil\n213|            if [\"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n214|                failedStep = nil\n215|            }\n216|        }\n217|        let oldIsOrg: Bool = if case .organization = old.scope { true } else { false }\n218|        let newIsOrg: Bool = if case .organization = new.scope { true } else { false }\n219|        if oldIsOrg || newIsOrg {\n220|            let oldGroup = old.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n221|            let newGroup = new.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n222|            if oldGroup != newGroup {\n223|                group = nil\n224|                runnerID = nil\n225|                pendingRepositoryIDs = nil\n226|                pendingTargetGroupID = nil\n227|                pendingLabels = nil\n228|                if [\"resolveGroup\", \"applyRepositoryAccess\", \"registerRunner\", \"setupService\", \"applyLabels\"]\n229|                    .contains(failedStep ?? \"\") {\n230|                    failedStep = nil\n231|                }\n232|            }\n233|        }\n234|        if old.workFolder != new.workFolder {\n235|            runnerID = nil\n236|            pendingLabels = nil\n237|            if [\"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n238|                failedStep = nil\n239|            }\n240|        }\n241|        // Editable selections stay live: a retry after an edit applies the\n242|        // visible values, never the stale attempt's.\n243|        if old.labels != new.labels, !new.labels.isEmpty {\n244|            pendingLabels = new.labels\n245|        }\n246|        if old.selectedRepositoryIDs != new.selectedRepositoryIDs {\n247|            pendingRepositoryIDs = new.selectedRepositoryIDs\n248|        }\n249|    }\n250|\n251|    /// True when an edit must abandon the in-flight step: any identity\n252|    /// change, plus a selection change for the mutation it feeds.\n253|    private func shouldAbandonInFlight(old: RunnerRegistration.Draft, new: RunnerRegistration.Draft) -> Bool {\n254|        if RunnerRegistration.Gates.identityFieldsChanged(old: old, new: new) { return true }\n255|        if workingStep == \"applyLabels\", old.labels != new.labels { return true }\n256|        if workingStep == \"applyRepositoryAccess\", old.selectedRepositoryIDs != new.selectedRepositoryIDs {\n257|            return true\n258|        }\n259|        return false\n260|    }\n261|\n262|    // MARK: - Auth\n263|\n264|    private func currentUserToken(generation gen: Int) async throws -> FlowUserToken {\n265|        guard let identity = await identities.load() else {\n266|            throw RunnerRegistration.RegistrationError.notAuthenticated\n267|        }\n268|        let config = try configProvider(identity.serverHost)\n269|        guard var record = await userStore.load(\n270|            serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID\n271|        ) else {\n272|            throw RunnerRegistration.RegistrationError.notAuthenticated\n273|        }\n274|        guard !isStale(gen) else { throw CancellationError() }\n275|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n276|            do {\n277|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n278|            } catch is CancellationError {\n279|                throw CancellationError()\n280|            } catch let error as GitHubAuth.AuthError {\n281|                switch error {\n282|                case .revoked, .unauthorized, .tokenRefreshFailed:\n283|                    throw RunnerRegistration.RegistrationError.unauthorized\n284|                default:\n285|                    break\n286|                }\n287|            }\n288|            guard !isStale(gen) else { throw CancellationError() }\n289|        }\n290|        return FlowUserToken(config: config, token: record.accessToken, identity: identity)\n291|    }\n292|\n293|    /// Binds cached progress to the authenticated server. When the session\n294|    /// server changes between steps, server-bound caches (group, asset,\n295|    /// runner ID, pendings) are dropped before any reuse, so an ID from one\n296|    /// server never authorizes writes on another. Returns false when the\n297|    /// binding changed and the caller must re-resolve instead of reusing.\n298|    @discardableResult\n299|    private func syncServerBinding(_ host: String) -> Bool {\n300|        let normalized = RunnerRegistration.OperationIdentity.normalizeServerHost(host)\n301|        if let bound = boundServerHost,\n302|           RunnerRegistration.OperationIdentity.normalizeServerHost(bound) == normalized {\n303|            return true\n304|        }\n305|        if boundServerHost != nil {\n306|            group = nil\n307|            asset = nil\n308|            runnerID = nil\n309|            pendingRepositoryIDs = nil\n310|            pendingTargetGroupID = nil\n311|            pendingLabels = nil\n312|            failedStep = nil\n313|            boundServerHost = normalized\n314|            return false\n315|        }\n316|        boundServerHost = normalized\n317|        return true\n318|    }\n319|\n320|    /// Generation-owned failure exit. Only the generation that still holds\n321|    /// the lock may record its failure and release it; a stale failure\n322|    /// (abandoned, cancelled, or reset while suspended) mutates nothing, so\n323|    /// it can never unlock a newer operation or plant its failedStep.\n324|    private func fail(_ error: Error, step: String, generation gen: Int) async {\n325|        guard workingOwner == gen else { return }\n326|        failedStep = step\n327|        workingOwner = nil\n328|        workingStep = nil\n329|        if error is CancellationError { return }\n330|        if let reg = error as? RunnerRegistration.RegistrationError {\n331|            switch reg {\n332|            case .missingPermission, .forbidden:\n333|                await action {\n334|                    RunnerRegistration.Action.permissionDenied(message: reg.localizedDescription, step: step)\n335|                }\n336|                return\n337|            default:\n338|                break\n339|            }\n340|        }\n341|        let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n342|        await action { RunnerRegistration.Action.failed(message: message, step: step) }\n343|    }\n344|\n345|    /// Generation-owned success exit. Only the generation that still holds\n346|    /// the lock may attest its step and release it; a stale success emits\n347|    /// nothing and mutates nothing.\n348|    private func finishStep(_ step: String, generation gen: Int) async {\n349|        guard workingOwner == gen else { return }\n350|        failedStep = nil\n351|        workingOwner = nil\n352|        workingStep = nil\n353|        await action { RunnerRegistration.Action.stepFinished(step) }\n354|    }\n355|\n356|    // MARK: - Group\n357|\n358|    private func resolveGroup() async {\n359|        let gen = generation\n360|        guard workingOwner == nil else { return }\n361|        guard let draft else {\n362|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"resolveGroup\") }\n363|            return\n364|        }\n365|        do {\n366|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n367|        } catch {\n368|            failedStep = \"resolveGroup\"\n369|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"resolveGroup\") }\n370|            return\n371|        }\n372|        guard case .organization(let org) = draft.scope else { return }\n373|        workingOwner = gen\n374|        workingStep = \"resolveGroup\"\n375|        await action { RunnerRegistration.Action.stepStarted(\"resolveGroup\") }\n376|        do {\n377|            let auth = try await currentUserToken(generation: gen)\n378|            guard !isStale(gen) else { return }\n379|            _ = syncServerBinding(auth.identity.serverHost)\n380|            guard !isStale(gen) else { return }\n381|            let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n382|            guard !isStale(gen) else { return }\n383|            let name = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n384|            let resolved: RunnerRegistration.RunnerGroup\n385|            if let existing = groups.first(where: { $0.name == name }) {\n386|                // Name alone never authorizes adoption: require a locally\n387|                // recorded ownership entry on this server or explicit\n388|                // takeover confirmation.\n389|                let owned = await installer.loadOwnedGroupID(\n390|                    serverHost: auth.identity.serverHost, org: org, name: name\n391|                )\n392|                try RunnerRegistration.Gates.authorizeGroupTakeover(\n393|                    groupName: name, existingID: existing.id,\n394|                    ownedID: owned, allowTakeover: draft.allowGroupTakeover\n395|                )\n396|                if owned != existing.id {\n397|                    try await installer.saveOwnedGroupID(\n398|                        serverHost: auth.identity.serverHost, org: org, name: name, groupID: existing.id\n399|                    )\n400|                }\n401|                guard !isStale(gen) else { return }\n402|                // A pre-existing group may deny public repos (GitHub default\n403|                // false), which would silently drop selected public repos.\n404|                if existing.allowsPublicRepositories {\n405|                    resolved = existing\n406|                } else {\n407|                    resolved = try await api.updateGroupAllowsPublic(\n408|                        config: auth.config, token: auth.token, org: org,\n409|                        groupID: existing.id, allowsPublic: true\n410|                    )\n411|                }\n412|            } else {\n413|                resolved = try await api.createGroup(\n414|                    config: auth.config, token: auth.token, org: org,\n415|                    name: name, selectedRepositoryIDs: draft.selectedRepositoryIDs,\n416|                    allowsPublicRepositories: true\n417|                )\n418|                guard !isStale(gen) else { return }\n419|                try await installer.saveOwnedGroupID(\n420|                    serverHost: auth.identity.serverHost, org: org, name: name, groupID: resolved.id\n421|                )\n422|            }\n423|            guard !isStale(gen) else { return }\n424|            let repoIDs = try await api.fetchGroupRepositories(\n425|                config: auth.config, token: auth.token, org: org, groupID: resolved.id\n426|            )\n427|            guard !isStale(gen) else { return }\n428|            group = resolved\n429|            await action { RunnerRegistration.Action.groupResolved(resolved, repositoryIDs: repoIDs) }\n430|            guard !isStale(gen) else { return }\n431|            await action { RunnerRegistration.Action.permissionDismissed }\n432|            await finishStep(\"resolveGroup\", generation: gen)\n433|        } catch {\n434|            await fail(error, step: \"resolveGroup\", generation: gen)\n435|        }\n436|    }\n437|\n438|    // MARK: - Download\n439|\n440|    private func prepareDownload() async {\n441|        let gen = generation\n442|        guard workingOwner == nil else { return }\n443|        guard let draft else {\n444|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"prepareDownload\") }\n445|            return\n446|        }\n447|        workingOwner = gen\n448|        workingStep = \"prepareDownload\"\n449|        await action { RunnerRegistration.Action.stepStarted(\"prepareDownload\") }\n450|        do {\n451|            let auth = try await currentUserToken(generation: gen)\n452|            guard !isStale(gen) else { return }\n453|            _ = syncServerBinding(auth.identity.serverHost)\n454|            guard !isStale(gen) else { return }\n455|            let found = try await prepareDownloadInner(draft: draft, auth: auth, generation: gen)\n456|            guard !isStale(gen) else { return }\n457|            asset = found\n458|            await action { RunnerRegistration.Action.downloadReady(found) }\n459|            await finishStep(\"prepareDownload\", generation: gen)\n460|        } catch {\n461|            await fail(error, step: \"prepareDownload\", generation: gen)\n462|        }\n463|    }\n464|\n465|    private func prepareDownloadInner(\n466|        draft: RunnerRegistration.Draft, auth: FlowUserToken, generation gen: Int\n467|    ) async throws -> RunnerRegistration.DownloadAsset {\n468|        guard !isStale(gen) else { throw CancellationError() }\n469|        let assets = try await api.fetchDownloads(config: auth.config, token: auth.token, scope: draft.scope)\n470|        guard !isStale(gen) else { throw CancellationError() }\n471|        return try RunnerRegistration.Gates.selectDownload(\n472|            osName: RunnerInstallerService.installOS,\n473|            arch: installer.architecture,\n474|            from: assets\n475|        )\n476|    }\n477|\n478|    // MARK: - Install\n479|\n480|    private func downloadAndInstall() async {\n481|        let gen = generation\n482|        guard workingOwner == nil else { return }\n483|        guard let draft else {\n484|            await action {\n485|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"downloadAndInstall\")\n486|            }\n487|            return\n488|        }\n489|        workingOwner = gen\n490|        workingStep = \"downloadAndInstall\"\n491|        await action { RunnerRegistration.Action.stepStarted(\"downloadAndInstall\") }\n492|        do {\n493|            // Bind to the authenticated server before touching the cache: a\n494|            // session change drops the old server's asset instead of reusing\n495|            // it. The same auth serves the whole step; no mid-step reload\n496|            // may mix servers.\n497|            let auth = try await currentUserToken(generation: gen)\n498|            guard !isStale(gen) else { return }\n499|            _ = syncServerBinding(auth.identity.serverHost)\n500|            guard !isStale(gen) else { return }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c771","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":531,"recorded_at":1780531400001057,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"call_id":"call_01a0a94fd5b3735c8e6275fd738f9d59","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Gates.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Validation gates. Each gate refuses a concrete invalid class; negative\n5|    /// tests narrow every one of them.\n6|    public enum Gates {\n7|        /// Refuses install/work paths containing spaces. GitHub's own setup has\n8|        /// a known defect with spaced paths; the wizard never reproduces it.\n9|        public static func validateNoSpace(installDirName: String, workFolder: String) throws {\n10|            if installDirName.contains(\" \") {\n11|                throw RegistrationError.noSpacePath(\"Installation folder name must not contain spaces.\")\n12|            }\n13|            if installDirName.contains(\"/\") || installDirName.isEmpty {\n14|                throw RegistrationError.invalidDraft(\"Installation folder name is invalid.\")\n15|            }\n16|            if workFolder.contains(\" \") {\n17|                throw RegistrationError.noSpacePath(\"Work folder must not contain spaces.\")\n18|            }\n19|            if workFolder.isEmpty || workFolder.contains(\"/\") {\n20|                throw RegistrationError.invalidDraft(\"Work folder name is invalid.\")\n21|            }\n22|        }\n23|\n24|        /// Validates the full draft before any network or filesystem mutation.\n25|        public static func validateDraft(_ draft: Draft) throws {\n26|            let name = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n27|            guard !name.isEmpty else {\n28|                throw RegistrationError.invalidDraft(\"Runner name must not be empty.\")\n29|            }\n30|            guard name.count <= 64 else {\n31|                throw RegistrationError.invalidDraft(\"Runner name is too long (max 64 characters).\")\n32|            }\n33|            let labels = draft.labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }\n34|            guard !labels.isEmpty else {\n35|                throw RegistrationError.invalidDraft(\"At least one label is required.\")\n36|            }\n37|            for label in labels {\n38|                guard !label.isEmpty else {\n39|                    throw RegistrationError.invalidDraft(\"Labels must not be empty.\")\n40|                }\n41|                guard label.count <= 100 else {\n42|                    throw RegistrationError.invalidDraft(\"Label '\\(label)' is too long (max 100 characters).\")\n43|                }\n44|            }\n45|            try validateNoSpace(installDirName: draft.installDirName, workFolder: draft.workFolder)\n46|            switch draft.scope {\n47|            case .organization:\n48|                let group = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n49|                guard !group.isEmpty else {\n50|                    throw RegistrationError.invalidDraft(\"Organization runners need a dedicated per-Mac group name.\")\n51|                }\n52|            case .repository:\n53|                break\n54|            }\n55|        }\n56|\n57|        /// Picks the architecture-matched official asset. Refuses any\n58|        /// substitute: both OS and architecture must match exactly.\n59|        public static func selectDownload(\n60|            osName: String, arch: String, from assets: [DownloadAsset]\n61|        ) throws -> DownloadAsset {\n62|            guard let match = assets.first(where: { $0.osName == osName && $0.architecture == arch }) else {\n63|                throw RegistrationError.downloadMismatch(osName: osName, arch: arch)\n64|            }\n65|            return match\n66|        }\n67|\n68|        /// Authorizes a group mutation only when the UI explicitly scoped it\n69|        /// AND the target is this run's resolved dedicated group. Never\n70|        /// mutates unrelated or shared groups.\n71|        public static func authorizeGroupMutation(\n72|            targetGroupID: Int64, resolvedGroupID: Int64?, allowFlag: Bool\n73|        ) throws {\n74|            guard allowFlag else { throw RegistrationError.groupScopeNotConfirmed }\n75|            guard let resolved = resolvedGroupID, resolved == targetGroupID else {\n76|                throw RegistrationError.refusesSharedGroup(groupID: targetGroupID)\n77|            }\n78|        }\n79|\n80|        /// Repository scope never touches groups: personal repos get separate\n81|        /// installations without shared-group coupling.\n82|        public static func requireOrganizationScope(_ scope: Scope) throws {\n83|            if case .organization = scope { return }\n84|            throw RegistrationError.groupNotApplicable\n85|        }\n86|\n87|        /// Ownership check for a pre-existing group with the requested name.\n88|        /// A name match alone never authorizes adoption: the caller must show\n89|        /// either a locally recorded ownership entry for the same group ID or\n90|        /// an explicit UI takeover confirmation.\n91|        public static func authorizeGroupTakeover(\n92|            groupName: String, existingID: Int64, ownedID: Int64?, allowTakeover: Bool\n93|        ) throws {\n94|            if let owned = ownedID, owned == existingID { return }\n95|            guard allowTakeover else {\n96|                throw RegistrationError.groupNameTaken(name: groupName, groupID: existingID)\n97|            }\n98|        }\n99|\n100|        /// Duplicate-name guard run before any registration token is minted.\n101|        /// Without explicit replace consent a remote name match refuses the\n102|        /// run so `config.sh` can never silently replace another machine.\n103|        public static func rejectRemoteDuplicate(name: String, isTaken: Bool, allowReplace: Bool) throws {\n104|            guard isTaken, !allowReplace else { return }\n105|            throw RegistrationError.remoteNameTaken(name: name)\n106|        }\n107|\n108|        /// Verifies the local `.runner` identity belongs to this draft's\n109|        /// operation on the authenticated server. Returns the verified local\n110|        /// agent ID. Refuses anything else: an unconfigured directory, a\n111|        /// missing or unreadable agent ID, a name mismatch, a server/scope\n112|        /// mismatch, or a work-folder mismatch. Agent IDs belong to their\n113|        /// server: a same-ID foreign host never authorizes writes on this\n114|        /// session's server. A remote name match alone never authorizes\n115|        /// writes to another runner.\n116|        public static func verifiedLocalAgentID(\n117|            local: LocalRegistration?, configured: Bool, draft: Draft, serverHost: String\n118|        ) throws -> Int64 {\n119|            guard configured else {\n120|                throw RegistrationError.unverifiedRegistration(\n121|                    \"Directory '\\(draft.installDirName)' was never configured by this wizard. Register it first; refusing a planted or foreign registration.\"\n122|                )\n123|            }\n124|            guard let local, let agentID = local.agentID else {\n125|                throw RegistrationError.unverifiedRegistration(\n126|                    \"No verified local registration for '\\(draft.runnerName)': install and register this directory first; refusing to touch a runner that is not this installation.\"\n127|                )\n128|            }\n129|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n130|            guard let name = local.agentName, name == wanted else {\n131|                throw RegistrationError.unverifiedRegistration(\n132|                    \"Local registration is for '\\(local.agentName ?? \"unknown\")', not '\\(wanted)'. Refusing to use another registration's identity.\"\n133|                )\n134|            }\n135|            guard let address = local.gitHubURL,\n136|                  scopeMatches(address: address, scope: draft.scope, serverHost: serverHost) else {\n137|                throw RegistrationError.unverifiedRegistration(\n138|                    \"Local registration points at '\\(local.gitHubURL ?? \"unknown\")', not this draft's scope on \\(OperationIdentity.normalizeServerHost(serverHost)). Refusing to use another registration's identity.\"\n139|                )\n140|            }\n141|            let wantedWork = draft.workFolder.trimmingCharacters(in: .whitespacesAndNewlines)\n142|            guard let work = local.workFolder, work == wantedWork else {\n143|                throw RegistrationError.unverifiedRegistration(\n144|                    \"Local registration uses work folder '\\(local.workFolder ?? \"unknown\")', not '\\(wantedWork)'. Reconfigure for the new work folder instead of reusing the old configuration.\"\n145|                )\n146|            }\n147|            return agentID\n148|        }\n149|\n150|        /// Matches a `.runner` gitHubUrl against a draft scope on the\n151|        /// authenticated server. Host must equal the session server\n152|        /// (`www.github.com` aliases `github.com`); path mirrors\n153|        /// RunnerDiscovery's parsing (one component for an org, two for\n154|        /// owner/repo). GitHub logins compare case-insensitively. Agent IDs\n155|        /// are server-scoped, so a same-path foreign host never matches.\n156|        public static func scopeMatches(address: String, scope: Scope, serverHost: String) -> Bool {\n157|            guard let url = URL(string: address), url.scheme == \"https\" else { return false }\n158|            guard let host = url.host,\n159|                  OperationIdentity.normalizeServerHost(host)\n160|                    == OperationIdentity.normalizeServerHost(serverHost) else { return false }\n161|            let components = url.pathComponents.filter { $0 != \"/\" }.map { $0.lowercased() }\n162|            switch scope {\n163|            case .organization(let org):\n164|                return components == [org.lowercased()]\n165|            case .repository(let owner, let name):\n166|                return components == [owner.lowercased(), name.lowercased()]\n167|            }\n168|        }\n169|\n170|        /// True when an edit changes operation identity (server is bound\n171|        /// separately via the authenticated session): scope, install folder,\n172|        /// runner name, work folder, or the dedicated group for org scope.\n173|        /// Labels, repository selections, and consent flags are editable and\n174|        /// never invalidate an in-flight operation.\n175|        public static func identityFieldsChanged(old: Draft, new: Draft) -> Bool {\n176|            if old.scope != new.scope { return true }\n177|            if old.installDirName != new.installDirName { return true }\n178|            let oldName = old.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n179|            let newName = new.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n180|            if oldName != newName { return true }\n181|            if old.workFolder != new.workFolder { return true }\n182|            let oldIsOrg: Bool = if case .organization = old.scope { true } else { false }\n183|            let newIsOrg: Bool = if case .organization = new.scope { true } else { false }\n184|            if oldIsOrg || newIsOrg {\n185|                let oldGroup = old.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n186|                let newGroup = new.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n187|                if oldGroup != newGroup { return true }\n188|            }\n189|            return false\n190|        }\n191|\n192|        /// Binds the complete remote runner list to the verified local agent\n193|        /// ID. Returns the bound runner ID, or nil when this agent is not\n194|        /// listed yet (retryable convergence, never an error by itself).\n195|        /// Throws when the list contradicts the local identity — a same-name\n196|        /// foreign runner or a renamed local agent — instead of guessing.\n197|        public static func boundRemoteRunnerID(\n198|            localAgentID: Int64, name: String, runners: [RegisteredRunner]\n199|        ) throws -> Int64? {\n200|            if let exact = runners.first(where: { $0.id == localAgentID }) {\n201|                guard exact.name == name else {\n202|                    throw RegistrationError.remoteIdentityMismatch(\n203|                        \"GitHub lists agent \\(localAgentID) as '\\(exact.name)', not '\\(name)'. Refusing to write to a mismatched registration.\"\n204|                    )\n205|                }\n206|                return exact.id\n207|            }\n208|            if let foreign = runners.first(where: { $0.name == name }) {\n209|                throw RegistrationError.remoteIdentityMismatch(\n210|                    \"This installation is agent \\(localAgentID), but GitHub shows '\\(name)' as agent \\(foreign.id). Refusing to adopt another runner's identity.\"\n211|                )\n212|            }\n213|            return nil\n214|        }\n215|\n216|        /// Confirms a repository-access write against the complete confirmed\n217|        /// list. Any difference — missing or extra IDs — fails closed instead\n218|        /// of reporting partial access as complete.\n219|        public static func confirmRepositoryIDs(requested: Set<Int64>, confirmed: [Int64]) throws {\n220|            guard Set(confirmed) == requested else {\n221|                throw RegistrationError.confirmationMismatch(\n222|                    \"GitHub confirmed repositories \\(confirmed.sorted()) but \\(requested.sorted()) was requested. Refusing to report partial access as complete.\"\n223|                )\n224|            }\n225|        }\n226|    }\n227|\n228|    /// Exact `config.sh` invocation inputs.\n229|    public struct ConfigSpec: Sendable, Equatable {\n230|        let scopeURL: String\n231|        let token: String\n232|        let name: String\n233|        let workFolder: String\n234|        let labels: [String]\n235|        let runnerGroup: String?\n236|        /// Explicit `--replace`. Production sets it only from\n237|        /// `Draft.allowReplace`; default invocations omit the flag so a\n238|        /// duplicate name fails instead of stealing another registration.\n239|        let replace: Bool\n240|    }\n241|\n242|    /// Exact `config.sh` invocation builder. Argument order is fixed and\n243|    /// covered by tests; production runs this exact array.\n244|    public enum ConfigInvocation {\n245|        public static func arguments(_ spec: ConfigSpec) -> [String] {\n246|            var args = [\n247|                \"--url\", spec.scopeURL,\n248|                \"--token\", spec.token,\n249|                \"--name\", spec.name,\n250|                \"--work\", spec.workFolder,\n251|                \"--labels\", spec.labels.joined(separator: \",\")\n252|            ]\n253|            if let group = spec.runnerGroup, !group.isEmpty {\n254|                args += [\"--runnergroup\", group]\n255|            }\n256|            args += [\"--unattended\"]\n257|            if spec.replace {\n258|                args += [\"--replace\"]\n259|            }\n260|            return args\n261|        }\n262|    }\n263|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c773","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":532,"recorded_at":1780531400001059,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"call_id":"call_01a0a94fd75f76ba88455828fa9a6b90","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerControlCoreTests.swift`.\n1|import Foundation\n2|import Testing\n3|import Relux\n4|@testable import RunnerControlCore\n5|\n6|struct ForeignAction: Relux.Action {}\n7|struct ForeignEffect: Relux.Effect {}\n8|\n9|@Test @MainActor func reducerPreservesUnrelatedActionsAndCleansState() async {\n10|    let definitions = (1...2).map { Runners.Definition(id: \"test.\\($0)\", title: \"Test\", detail: \"\", directory: URL(fileURLWithPath: \"/tmp/test-\\($0)\"), githubURL: URL(string: \"https://github.com/example\")!) }\n11|    let state = Runners.State(definitions: definitions)\n12|    let original = state.runners\n13|    await state.reduce(with: ForeignAction())\n14|    #expect(state.runners == original)\n15|    await state.reduce(with: Runners.Action.changing(original[0].id, true))\n16|    await state.reduce(with: Runners.Action.failed(\"Permission denied\"))\n17|    #expect(state.changing.contains(original[0].id))\n18|    #expect(state.lastError == \"Permission denied\")\n19|    await state.reduce(with: Runners.Action.refreshed(original.map { .init(definition: $0.definition, status: .running) }))\n20|    #expect(state.activeCount == 2)\n21|    await state.cleanup()\n22|    #expect(state.activeCount == 0)\n23|    #expect(state.changing.isEmpty)\n24|    #expect(state.lastError == nil)\n25|}\n26|\n27|@Test(arguments: [\n28|    (CommandResult(code: 0, output: \"state = running\\npid = 23\"), Runners.Status.running),\n29|    (CommandResult(code: 0, output: \"state = exited\"), .failed),\n30|    (CommandResult(code: 113, output: \"Could not find service foo\"), .stopped),\n31|    (CommandResult(code: 1, output: \"Operation not permitted\"), .unknown),\n32|    (CommandResult(code: 113, output: \"Could not find domain\"), .unknown)\n33|]) func distinguishesStoppedFromPermissionFailure(value: (CommandResult, Runners.Status)) {\n34|    #expect(LaunchAgentService.status(from: value.0) == value.1)\n35|}\n36|\n37|actor FakeExecutor: CommandExecuting {\n38|    private var results: [CommandResult]\n39|    private(set) var calls: [[String]] = []\n40|    init(_ results: [CommandResult]) { self.results = results }\n41|    func run(_ executable: String, _ arguments: [String]) async throws -> CommandResult {\n42|        calls.append([executable] + arguments)\n43|        guard !results.isEmpty else { throw RunnerError.message(\"Unexpected command\") }\n44|        return results.removeFirst()\n45|    }\n46|}\n47|struct Fixture {\n48|    let root: URL\n49|    let definition: Runners.Definition\n50|    init(suffix: String = \"\", work: String = \"_work\") throws {\n51|        root = FileManager.default.temporaryDirectory.appendingPathComponent(\"RunnerControl-\" + UUID().uuidString + suffix)\n52|        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n53|        definition = .init(id: \"works.relux.runnercontrol.test.\" + UUID().uuidString, title: \"Test\", detail: \"Fixture\", directory: root, githubURL: URL(string: \"https://example.com\")!)\n54|        let script = root.appendingPathComponent(\"runsvc.sh\")\n55|        try \"#!/bin/sh\\nexec /bin/sleep 120\\n\".write(to: script, atomically: true, encoding: .utf8)\n56|        try FileManager.default.setAttributes([.posixPermissions: 0o755], ofItemAtPath: script.path)\n57|        let plist: [String: Any] = [\"Label\": definition.id, \"ProgramArguments\": [script.path], \"WorkingDirectory\": root.path, \"RunAtLoad\": true]\n58|        try PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0).write(to: definition.plist)\n59|        try JSONSerialization.data(withJSONObject: [\"workFolder\": work]).write(to: root.appendingPathComponent(\".runner\"))\n60|    }\n61|    func clean() { try? FileManager.default.removeItem(at: root) }\n62|}\n63|let stopped = CommandResult(code: 113, output: \"Could not find service test\")\n64|let running = CommandResult(code: 0, output: \"state = running\")\n65|\n66|@Test func startIsIdempotentAndStopUsesServiceIdentity() async throws {\n67|    let fixture = try Fixture(); defer { fixture.clean() }\n68|    let executor = FakeExecutor([running, running, .init(code: 0, output: \"\"), stopped])\n69|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor, userID: 501)\n70|    try await service.setEnabled(true, id: fixture.definition.id)\n71|    try await service.setEnabled(false, id: fixture.definition.id)\n72|    let calls = await executor.calls\n73|    #expect(calls.count == 4)\n74|    #expect(calls[2] == [\"/bin/launchctl\", \"bootout\", \"gui/501/\" + fixture.definition.id])\n75|}\n76|\n77|@Test func startWaitsForRunningState() async throws {\n78|    let fixture = try Fixture(); defer { fixture.clean() }\n79|    let executor = FakeExecutor([stopped, .init(code: 0, output: \"\"), running])\n80|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor, userID: 501)\n81|    try await service.setEnabled(true, id: fixture.definition.id)\n82|    let calls = await executor.calls\n83|    #expect(calls[1] == [\"/bin/launchctl\", \"bootstrap\", \"gui/501\", fixture.definition.plist.path])\n84|}\n85|\n86|@Test(arguments: [false, true]) func rejectsSpacesBeforeLaunching(inWorkFolder: Bool) async throws {\n87|    let fixture = try Fixture(suffix: inWorkFolder ? \"\" : \" bad\", work: inWorkFolder ? \"bad path\" : \"_work\")\n88|    defer { fixture.clean() }\n89|    let executor = FakeExecutor([])\n90|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor)\n91|    await #expect(throws: (any Error).self) { try await service.setEnabled(true, id: fixture.definition.id) }\n92|    #expect(await executor.calls.isEmpty)\n93|}\n94|\n95|@Test func permissionErrorsNeverTriggerBootstrap() async throws {\n96|    let fixture = try Fixture(); defer { fixture.clean() }\n97|    let executor = FakeExecutor([.init(code: 1, output: \"Operation not permitted\")])\n98|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor)\n99|    await #expect(throws: (any Error).self) { try await service.setEnabled(true, id: fixture.definition.id) }\n100|    #expect(await executor.calls.count == 1)\n101|}\n102|\n103|@Test func canStopAfterRegistrationIsDeleted() async throws {\n104|    let fixture = try Fixture(); defer { fixture.clean() }\n105|    try FileManager.default.removeItem(at: fixture.root.appendingPathComponent(\".runner\"))\n106|    let executor = FakeExecutor([running, .init(code: 0, output: \"\"), stopped])\n107|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor)\n108|    try await service.setEnabled(false, id: fixture.definition.id)\n109|    #expect(await executor.calls.count == 3)\n110|}\n111|\n112|actor FailingService: RunnerServicing {\n113|    func snapshots() async -> [Runners.Snapshot] { [] }\n114|    func setEnabled(_ enabled: Bool, id: String) async throws { throw RunnerError.message(\"Denied\") }\n115|}\n116|@Test @MainActor func flowPublishesFailureAndClearsPendingState() async {\n117|    let logger = Relux.Testing.Logger()\n118|    let dispatcher = Relux.Dispatcher(logger: logger)\n119|    let flow = await Runners.Flow(service: FailingService(), dispatcher: dispatcher)\n120|    let _: Relux.ActionResult = await flow.apply(Runners.Effect.setEnabled(\"test\", true))\n121|    let actions = logger.actions.compactMap { $0 as? Runners.Action }\n122|    #expect(actions.count == 4)\n123|    guard case .changing(\"test\", true) = actions[0],\n124|          case .failed(\"Denied\") = actions[1],\n125|          case .changing(\"test\", false) = actions[3] else {\n126|        Issue.record(\"Flow did not balance start/failure/finish actions\"); return\n127|    }\n128|    let _: Relux.ActionResult = await flow.apply(ForeignEffect())\n129|    #expect(logger.actions.count == 4)\n130|}\n131|\n132|@Test func commandExecutorHandlesLargeOutputAndExitStatus() async throws {\n133|    let runner = CommandExecutor()\n134|    let result = try await runner.run(\"/usr/bin/printf\", [\"%050000d\", \"1\"])\n135|    #expect(result.code == 0)\n136|    #expect(result.output.count == 50000)\n137|    let failed = try await runner.run(\"/usr/bin/false\", [])\n138|    #expect(failed.code != 0)\n139|}\n140|\n141|@Test(.enabled(if: ProcessInfo.processInfo.environment[\"RUN_LAUNCH_AGENT_INTEGRATION\"] == \"1\"))\n142|func realLaunchAgentLifecycleWithoutGitHubJobs() async throws {\n143|    let fixture = try Fixture(); defer { fixture.clean() }\n144|    let service = LaunchAgentService(definitions: [fixture.definition])\n145|    do {\n146|        try await service.setEnabled(true, id: fixture.definition.id)\n147|        #expect(await service.snapshots().first?.status == .running)\n148|        try await service.setEnabled(true, id: fixture.definition.id)\n149|        try await service.setEnabled(false, id: fixture.definition.id)\n150|        #expect(await service.snapshots().first?.status == .stopped)\n151|        try await service.setEnabled(false, id: fixture.definition.id)\n152|    } catch {\n153|        try? await service.setEnabled(false, id: fixture.definition.id)\n154|        throw error\n155|    }\n156|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
