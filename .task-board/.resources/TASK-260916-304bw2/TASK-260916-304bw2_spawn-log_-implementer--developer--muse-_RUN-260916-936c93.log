dInstallationID = nil\n27|            repositories = []\n28|            selectedRepositoryIDs = []\n29|            syncError = nil\n30|            lastSyncAt = nil\n31|        }\n32|    }\n33|\n34|    public enum Action: Relux.Action {\n35|        case restoreStarted(serverHost: String)\n36|        case loginStarted(serverHost: String)\n37|        case codeReceived(userCode: String, verificationURI: URL, expiresIn: Int, interval: Int)\n38|        case pollIntervalUpdated(Int)\n39|        case loginCancelled\n40|        case accountVerified(username: String, userID: Int64, serverHost: String)\n41|        case installationsLoaded([Installation])\n42|        case repositoriesLoaded(installationID: Int64, repositories: [Repository])\n43|        case connected(username: String, serverHost: String, syncedAt: Date)\n44|        case failed(message: String, retry: RetryKind)\n45|        case syncFailed(message: String)\n46|        case syncSucceeded(Date)\n47|        case installationSelected(Int64?)\n48|        case repositoriesSelected(Set<Int64>)\n49|        case loggedOut\n50|        case clearSyncError\n51|    }\n52|\n53|    public enum Effect: Relux.Effect {\n54|        case restoreSession\n55|        case beginLogin(serverHost: String?)\n56|        case cancelLogin\n57|        case logout\n58|        case refreshInstallations\n59|        case selectInstallation(Int64?)\n60|        case selectRepositories(Set<Int64>)\n61|    }\n62|}","final_result":true}}}
