{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c1","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":571,"recorded_at":1780531400001137,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a94f-e7f2-7e82-9b58-94bd2b74018e"},"task_id":"01a0a94f-e7f2-7e82-9b58-94bd2b74018e","event":{"kind":"output","task_id":"01a0a94f-e7f2-7e82-9b58-94bd2b74018e","chunk":"Read text file `Targets/RunnerControl/Sources/RunnerRegistrationContainer.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|/// Wizard composition root. Edits local draft fields, dispatches production\n5|/// `RunnerRegistration.Effect`s, and never holds tokens.\n6|struct RunnerRegistrationContainer: View {\n7|    @ObservedObject var registration: RunnerRegistration.State\n8|    @ObservedObject var github: GitHubAuth.State\n9|    let close: () -> Void\n10|\n11|    @State private var scopeKind: RunnerRegistrationPage.ScopeKind = .organization\n12|    @State private var org = \"\"\n13|    @State private var repoOwner = \"\"\n14|    @State private var repoName = \"\"\n15|    @State private var runnerName = Host.current().localizedName ?? \"\"\n16|    @State private var labelsText = \"self-hosted, macOS\"\n17|    @State private var installDirName = \"\"\n18|    @State private var workFolder = \"_work\"\n19|    @State private var groupName = RunnerRegistration.Draft.defaultGroupName(\n20|        hostName: Host.current().localizedName ?? \"\"\n21|    )\n22|    @State private var allowGroupMutation = false\n23|    @State private var allowGroupTakeover = false\n24|    @State private var allowReplace = false\n25|    @State private var selectedRepositoryIDs: Set<Int64> = []\n26|    @State private var seeded = false\n27|\n28|    private static func parseLabels(_ text: String) -> [String] {\n29|        text.split(separator: \",\").map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }\n30|    }\n31|\n32|    private var currentDraft: RunnerRegistration.Draft {\n33|        let scope: RunnerRegistration.Scope\n34|        switch scopeKind {\n35|        case .organization:\n36|            scope = .organization(org: org.trimmingCharacters(in: .whitespacesAndNewlines))\n37|        case .repository:\n38|            scope = .repository(\n39|                owner: repoOwner.trimmingCharacters(in: .whitespacesAndNewlines),\n40|                name: repoName.trimmingCharacters(in: .whitespacesAndNewlines)\n41|            )\n42|        }\n43|        return RunnerRegistration.Draft(\n44|            scope: scope,\n45|            runnerName: runnerName.trimmingCharacters(in: .whitespacesAndNewlines),\n46|            labels: Self.parseLabels(labelsText),\n47|            installDirName: installDirName.trimmingCharacters(in: .whitespacesAndNewlines),\n48|            workFolder: workFolder.trimmingCharacters(in: .whitespacesAndNewlines),\n49|            groupName: groupName.trimmingCharacters(in: .whitespacesAndNewlines),\n50|            selectedRepositoryIDs: selectedRepositoryIDs,\n51|            allowGroupMutation: allowGroupMutation,\n52|            allowGroupTakeover: allowGroupTakeover,\n53|            allowReplace: allowReplace\n54|        )\n55|    }\n56|\n57|    var body: some View {\n58|        RunnerRegistrationPage(\n59|            props: .init(\n60|                phase: registration.phase,\n61|                working: registration.working,\n62|                scopeKind: scopeKind,\n63|                org: org,\n64|                repoOwner: repoOwner,\n65|                repoName: repoName,\n66|                runnerName: runnerName,\n67|                labelsText: labelsText,\n68|                installDirName: installDirName,\n69|                workFolder: workFolder,\n70|                groupName: groupName,\n71|                allowGroupMutation: allowGroupMutation,\n72|                allowGroupTakeover: allowGroupTakeover,\n73|                allowReplace: allowReplace,\n74|                selectedRepositoryIDs: selectedRepositoryIDs,\n75|                repositories: github.repositories,\n76|                installations: github.installations,\n77|                githubConnected: isConnected,\n78|                githubUsername: github.username,\n79|                group: registration.group,\n80|                groupRepositoryIDs: registration.groupRepositoryIDs,\n81|                assetFilename: registration.asset?.filename,\n82|                installPath: registration.installPath,\n83|                runnerID: registration.runnerID,\n84|                localAgentID: registration.localAgentID,\n85|                completedSteps: registration.completedSteps,\n86|                error: registration.error,\n87|                failedStep: registration.failedStep,\n88|                permissionError: registration.permissionError\n89|            ),\n90|            reactions: .init(\n91|                scopeKindChanged: { scopeKind = $0; pushDraft() },\n92|                orgChanged: { org = $0; pushDraft() },\n93|                repoOwnerChanged: { repoOwner = $0; pushDraft() },\n94|                repoNameChanged: { repoName = $0; pushDraft() },\n95|                runnerNameChanged: { runnerName = $0; pushDraft() },\n96|                labelsChanged: { labelsText = $0; pushDraft() },\n97|                installDirChanged: { installDirName = $0; pushDraft() },\n98|                workFolderChanged: { workFolder = $0; pushDraft() },\n99|                groupNameChanged: { groupName = $0; pushDraft() },\n100|                allowGroupMutationChanged: { allowGroupMutation = $0; pushDraft() },\n101|                allowGroupTakeoverChanged: { allowGroupTakeover = $0; pushDraft() },\n102|                allowReplaceChanged: { allowReplace = $0; pushDraft() },\n103|                repositoriesChanged: { ids in\n104|                    selectedRepositoryIDs = ids\n105|                    Task { await action { GitHubAuth.Effect.selectRepositories(ids) } }\n106|                    pushDraft()\n107|                },\n108|                beginDraft: { Task { await action { RunnerRegistration.Effect.beginDraft(currentDraft) } } },\n109|                resolveGroup: { Task { await action { RunnerRegistration.Effect.resolveGroup } } },\n110|                downloadAndInstall: { Task { await action { RunnerRegistration.Effect.downloadAndInstall } } },\n111|                registerRunner: { Task { await action { RunnerRegistration.Effect.registerRunner } } },\n112|                setupService: { Task { await action { RunnerRegistration.Effect.setupService } } },\n113|                applyRepositoryAccess: {\n114|                    let target = registration.group?.id ?? -1\n115|                    let effect = RunnerRegistration.Effect.applyRepositoryAccess(\n116|                        groupID: target, repositories: selectedRepositoryIDs\n117|                    )\n118|                    Task { await action { effect } }\n119|                },\n120|                applyLabels: {\n121|                    let labels = Self.parseLabels(labelsText)\n122|                    Task { await action { RunnerRegistration.Effect.applyLabels(labels) } }\n123|                },\n124|                retry: { Task { await action { RunnerRegistration.Effect.retry } } },\n125|                cancel: { Task { await action { RunnerRegistration.Effect.cancel } } },\n126|                reset: { Task { await action { RunnerRegistration.Effect.reset } } },\n127|                dismissPermission: { Task { await action { RunnerRegistration.Effect.dismissPermission } } },\n128|                close: close\n129|            )\n130|        )\n131|        .onAppear(perform: seedFromGitHub)\n132|    }\n133|\n134|    private var isConnected: Bool {\n135|        if case .connected = github.connection { return true }\n136|        return false\n137|    }\n138|\n139|    /// Pushes field edits into the draft once the wizard has begun, so step\n140|    /// buttons always run the visible values. Before the first begin the\n141|    /// draft does not exist yet and edits stay local.\n142|    private func pushDraft() {\n143|        guard registration.phase != .idle else { return }\n144|        let draft = currentDraft\n145|        Task { await action { RunnerRegistration.Effect.updateDraft(draft) } }\n146|    }\n147|\n148|    /// Seeds org/owner from the selected GitHub installation once.\n149|    private func seedFromGitHub() {\n150|        guard !seeded else { return }\n151|        seeded = true\n152|        if installDirName.isEmpty {\n153|            installDirName = (Host.current().localizedName ?? \"runner\")\n154|                .lowercased()\n155|                .replacingOccurrences(of: \" \", with: \"-\")\n156|        }\n157|        guard let id = github.selectedInstallationID,\n158|              let installation = github.installations.first(where: { $0.id == id }) else { return }\n159|        if org.isEmpty, installation.accountType == \"Organization\" {\n160|            org = installation.account\n161|            scopeKind = .organization\n162|        } else if repoOwner.isEmpty {\n163|            repoOwner = installation.account\n164|            scopeKind = .repository\n165|        }\n166|        if selectedRepositoryIDs.isEmpty {\n167|            selectedRepositoryIDs = github.selectedRepositoryIDs\n168|        }\n169|    }\n170|}","final_result":true}}}
