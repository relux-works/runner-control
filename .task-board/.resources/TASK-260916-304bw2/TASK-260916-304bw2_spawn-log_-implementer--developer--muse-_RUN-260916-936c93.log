{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d6ad","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":2481,"recorded_at":1780531400004957,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"call_id":"call_01a0a95f29c775c286052f060c63b7b4","text":"Read text file `Targets/RunnerControl/Sources/AppRegistry.swift`.\n1|import Foundation\n2|import RunnerControlCore\n3|\n4|@MainActor enum AppRegistry {\n5|    static let state = Runners.State()\n6|    static let githubState = GitHubAuth.State()\n7|    static let registrationState = RunnerRegistration.State()\n8|    static let updater = AppUpdater()\n9|    private static var task: Task<Void, Never>?\n10|    private static var githubTask: Task<Void, Never>?\n11|    static func start() {\n12|        guard task == nil else { return }\n13|        updater.start()\n14|        // One composition root for every MenuBarExtra presentation.\n15|        task = Task {\n16|            _ = await RunnerRuntime.make(state: state, githubState: githubState, registrationState: registrationState)\n17|            await action { GitHubAuth.Effect.restoreSession }\n18|            while !Task.isCancelled {\n19|                await action { Runners.Effect.refresh }\n20|                try? await Task.sleep(for: .seconds(3))\n21|            }\n22|        }\n23|        githubTask = Task {\n24|            var ticks = 0\n25|            while !Task.isCancelled {\n26|                try? await Task.sleep(for: .seconds(30))\n27|                ticks += 1\n28|                // GitHub sync is best-effort and never blocks local control.\n29|                if case .connected = githubState.connection {\n30|                    await action { GitHubAuth.Effect.refreshInstallations }\n31|                }\n32|                _ = ticks\n33|            }\n34|        }\n35|    }\n36|\n37|    static func openManagementWindow() {\n38|        NotificationCenter.default.post(name: .openManagementWindow, object: nil)\n39|    }\n40|}\n41|\n42|extension Notification.Name {\n43|    static let openManagementWindow = Notification.Name(\"works.relux.runnercontrol.openManagementWindow\")\n44|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
