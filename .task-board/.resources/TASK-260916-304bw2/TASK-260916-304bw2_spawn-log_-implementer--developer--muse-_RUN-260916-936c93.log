{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c52f","stream":{"kind":"session","id":"01a0a94e-f9b9-7860-b0c6-fdeb793e4d2e"},"sequence":242,"recorded_at":1780531400000479,"record_type":"event","durability":"durable","causation_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bdb55aec-3668-4dc2-8767-4018e566a62d","run_stream":{"kind":"run","id":"bdb55aec-3668-4dc2-8767-4018e566a62d"},"task_stream":{"kind":"task","id":"01a0a94f-8254-75d1-b3b1-77a5b3b2631f"},"task_id":"01a0a94f-8254-75d1-b3b1-77a5b3b2631f","event":{"kind":"output","task_id":"01a0a94f-8254-75d1-b3b1-77a5b3b2631f","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerDiscovery.swift`.\n1|import Foundation\n2|\n3|/// Read-only discovery of user-owned runner service manifests. Never runs scripts.\n4|public enum RunnerDiscovery {\n5|    public static func installed(home: URL = FileManager.default.homeDirectoryForCurrentUser) -> [Runners.Definition] {\n6|        let fm = FileManager.default\n7|        let launchAgents = home.appendingPathComponent(\"Library/LaunchAgents\")\n8|        let root = home.appendingPathComponent(\"Library/GitHubActions\")\n9|        let agents = (try? fm.contentsOfDirectory(at: launchAgents, includingPropertiesForKeys: nil)) ?? []\n10|        let folders = (try? fm.contentsOfDirectory(at: root, includingPropertiesForKeys: nil)) ?? []\n11|        // Prefer a standard service when both manifests describe the same registration.\n12|        let candidates = agents.filter { $0.lastPathComponent.hasPrefix(\"actions.runner.\") && $0.pathExtension == \"plist\" }.sorted { $0.path < $1.path }\n13|            + folders.sorted { $0.path < $1.path }.map { $0.appendingPathComponent(\"manual-service.plist\") }\n14|        var ids = Set<String>()\n15|        var directories = Set<String>()\n16|        return candidates.compactMap { manifest in\n17|            guard let data = try? Data(contentsOf: manifest),\n18|                  let object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],\n19|                  let label = object[\"Label\"] as? String, label.hasPrefix(\"actions.runner.\"),\n20|                  let path = object[\"WorkingDirectory\"] as? String, path.hasPrefix(\"/\"),\n21|                  let args = object[\"ProgramArguments\"] as? [String],\n22|                  args == [URL(fileURLWithPath: path).appendingPathComponent(\"runsvc.sh\").path] else { return nil }\n23|            let directory = URL(fileURLWithPath: path)\n24|            let canonical = directory.resolvingSymlinksInPath().standardizedFileURL.path\n25|            guard !ids.contains(label), !directories.contains(canonical),\n26|                  let registration = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n27|                  let config = try? JSONSerialization.jsonObject(with: registration) as? [String: Any],\n28|                  let name = config[\"agentName\"] as? String, !name.isEmpty,\n29|                  let address = config[\"gitHubUrl\"] as? String,\n30|                  let url = URL(string: address), url.scheme == \"https\", url.host != nil else { return nil }\n31|            let components = url.pathComponents.filter { $0 != \"/\" }\n32|            guard components.count == 1 || components.count == 2 else { return nil }\n33|            let scope = components.joined(separator: \"/\")\n34|            let settingsPath = components.count == 1\n35|                ? \"/organizations/\\(scope)/settings/actions/runners\"\n36|                : \"/\\(scope)/settings/actions/runners\"\n37|            var settings = URLComponents(url: url, resolvingAgainstBaseURL: false)!\n38|            settings.path = settingsPath; settings.query = nil; settings.fragment = nil\n39|            guard let settingsURL = settings.url else { return nil }\n40|            ids.insert(label); directories.insert(canonical)\n41|            return .init(id: label, title: name, detail: scope, directory: directory,\n42|                         githubURL: settingsURL, servicePlist: manifest)\n43|        }\n44|    }\n45|}","final_result":true}}}
