state.changing.isEmpty)\n24|    #expect(state.lastError == nil)\n25|}\n26|\n27|@Test(arguments: [\n28|    (CommandResult(code: 0, output: \"state = running\\npid = 23\"), Runners.Status.running),\n29|    (CommandResult(code: 0, output: \"state = exited\"), .failed),\n30|    (CommandResult(code: 113, output: \"Could not find service foo\"), .stopped),\n31|    (CommandResult(code: 1, output: \"Operation not permitted\"), .unknown),\n32|    (CommandResult(code: 113, output: \"Could not find domain\"), .unknown)\n33|]) func distinguishesStoppedFromPermissionFailure(value: (CommandResult, Runners.Status)) {\n34|    #expect(LaunchAgentService.status(from: value.0) == value.1)\n35|}\n36|\n37|actor FakeExecutor: CommandExecuting {\n38|    private var results: [CommandResult]\n39|    private(set) var calls: [[String]] = []\n40|    init(_ results: [CommandResult]) { self.results = results }\n41|    func run(_ executable: String, _ arguments: [String]) async throws -> CommandResult {\n42|        calls.append([executable] + arguments)\n43|        guard !results.isEmpty else { throw RunnerError.message(\"Unexpected command\") }\n44|        return results.removeFirst()\n45|    }\n46|}\n47|struct Fixture {\n48|    let root: URL\n49|    let definition: Runners.Definition\n50|    init(suffix: String = \"\", work: String = \"_work\") throws {\n51|        root = FileManager.default.temporaryDirectory.appendingPathComponent(\"RunnerControl-\" + UUID().uuidString + suffix)\n52|        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n53|        definition = .init(id: \"works.relux.runnercontrol.test.\" + UUID().uuidString, title: \"Test\", detail: \"Fixture\", directory: root, githubURL: URL(string: \"https://example.com\")!)\n54|        let script = root.appendingPathComponent(\"runsvc.sh\")\n55|        try \"#!/bin/sh\\nexec /bin/sleep 120\\n\".write(to: script, atomically: true, encoding: .utf8)\n56|        try FileManager.default.setAttributes([.posixPermissions: 0o755], ofItemAtPath: script.path)\n57|        let plist: [String: Any] = [\"Label\": definition.id, \"ProgramArguments\": [script.path], \"WorkingDirectory\": root.path, \"RunAtLoad\": true]\n58|        try PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0).write(to: definition.plist)\n59|        try JSONSerialization.data(withJSONObject: [\"workFolder\": work]).write(to: root.appendingPathComponent(\".runner\"))\n60|    }\n61|    func clean() { try? FileManager.default.removeItem(at: root) }\n62|}\n63|let stopped = CommandResult(code: 113, output: \"Could not find service test\")\n64|let running = CommandResult(code: 0, output: \"state = running\")\n65|\n66|@Test func startIsIdempotentAndStopUsesServiceIdentity() async throws {\n67|    let fixture = try Fixture(); defer { fixture.clean() }\n68|    let executor = FakeExecutor([running, running, .init(code: 0, output: \"\"), stopped])\n69|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor, userID: 501)\n70|    try await service.setEnabled(true, id: fixture.definition.id)\n71|    try await service.setEnabled(false, id: fixture.definition.id)\n72|    let calls = await executor.calls\n73|    #expect(calls.count == 4)\n74|    #expect(calls[2] == [\"/bin/launchctl\", \"bootout\", \"gui/501/\" + fixture.definition.id])\n75|}\n76|\n77|@Test func startWaitsForRunningState() async throws {\n78|    let fixture = try Fixture(); defer { fixture.clean() }\n79|    let executor = FakeExecutor([stopped, .init(code: 0, output: \"\"), running])\n80|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor, userID: 501)\n81|    try await service.setEnabled(true, id: fixture.definition.id)\n82|    let calls = await executor.calls\n83|    #expect(calls[1] == [\"/bin/launchctl\", \"bootstrap\", \"gui/501\", fixture.definition.plist.path])\n84|}\n85|\n86|@Test(arguments: [false, true]) func rejectsSpacesBeforeLaunching(inWorkFolder: Bool) async throws {\n87|    let fixture = try Fixture(suffix: inWorkFolder ? \"\" : \" bad\", work: inWorkFolder ? \"bad path\" : \"_work\")\n88|    defer { fixture.clean() }\n89|    let executor = FakeExecutor([])\n90|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor)\n91|    await #expect(throws: (any Error).self) { try await service.setEnabled(true, id: fixture.definition.id) }\n92|    #expect(await executor.calls.isEmpty)\n93|}\n94|\n95|@Test func permissionErrorsNeverTriggerBootstrap() async throws {\n96|    let fixture = try Fixture(); defer { fixture.clean() }\n97|    let executor = FakeExecutor([.init(code: 1, output: \"Operation not permitted\")])\n98|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor)\n99|    await #expect(throws: (any Error).self) { try await service.setEnabled(true, id: fixture.definition.id) }\n100|    #expect(await executor.calls.count == 1)\n101|}\n102|\n103|@Test func canStopAfterRegistrationIsDeleted() async throws {\n104|    let fixture = try Fixture(); defer { fixture.clean() }\n105|    try FileManager.default.removeItem(at: fixture.root.appendingPathComponent(\".runner\"))\n106|    let executor = FakeExecutor([running, .init(code: 0, output: \"\"), stopped])\n107|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor)\n108|    try await service.setEnabled(false, id: fixture.definition.id)\n109|    #expect(await executor.calls.count == 3)\n110|}\n111|\n112|actor FailingService: RunnerServicing {\n113|    func snapshots() async -> [Runners.Snapshot] { [] }\n114|    func setEnabled(_ enabled: Bool, id: String) async throws { throw RunnerError.message(\"Denied\") }\n115|}\n116|@Test @MainActor func flowPublishesFailureAndClearsPendingState() async {\n117|    let logger = Relux.Testing.Logger()\n118|    let dispatcher = Relux.Dispatcher(logger: logger)\n119|    let flow = await Runners.Flow(service: FailingService(), dispatcher: dispatcher)\n120|    let _: Relux.ActionResult = await flow.apply(Runners.Effect.setEnabled(\"test\", true))\n121|    let actions = logger.actions.compactMap { $0 as? Runners.Action }\n122|    #expect(actions.count == 4)\n123|    guard case .changing(\"test\", true) = actions[0],\n124|          case .failed(\"Denied\") = actions[1],\n125|          case .changing(\"test\", false) = actions[3] else {\n126|        Issue.record(\"Flow did not balance start/failure/finish actions\"); return\n127|    }\n128|    let _: Relux.ActionResult = await flow.apply(ForeignEffect())\n129|    #expect(logger.actions.count == 4)\n130|}\n131|\n132|@Test func commandExecutorHandlesLargeOutputAndExitStatus() async throws {\n133|    let runner = CommandExecutor()\n134|    let result = try await runner.run(\"/usr/bin/printf\", [\"%050000d\", \"1\"])\n135|    #expect(result.code == 0)\n136|    #expect(result.output.count == 50000)\n137|    let failed = try await runner.run(\"/usr/bin/false\", [])\n138|    #expect(failed.code != 0)\n139|}\n140|\n141|@Test(.enabled(if: ProcessInfo.processInfo.environment[\"RUN_LAUNCH_AGENT_INTEGRATION\"] == \"1\"))\n142|func realLaunchAgentLifecycleWithoutGitHubJobs() async throws {\n143|    let fixture = try Fixture(); defer { fixture.clean() }\n144|    let service = LaunchAgentService(definitions: [fixture.definition])\n145|    do {\n146|        try await service.setEnabled(true, id: fixture.definition.id)\n147|        #expect(await service.snapshots().first?.status == .running)\n148|        try await service.setEnabled(true, id: fixture.definition.id)\n149|        try await service.setEnabled(false, id: fixture.definition.id)\n150|        #expect(await service.snapshots().first?.status == .stopped)\n151|        try await service.setEnabled(false, id: fixture.definition.id)\n152|    } catch {\n153|        try? await service.setEnabled(false, id: fixture.definition.id)\n154|        throw error\n155|    }\n156|}","final_result":true}}}
