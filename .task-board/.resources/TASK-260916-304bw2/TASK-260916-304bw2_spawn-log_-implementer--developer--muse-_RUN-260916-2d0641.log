ermediateDirectories: true)\n698|            try out.write(to: copy, options: .atomic)\n699|            return\n700|        }\n701|        guard FileManager.default.fileExists(atPath: copy.path) else { return }\n702|        guard let existing = try? Data(contentsOf: copy),\n703|              let current = try? PropertyListSerialization.propertyList(from: existing, format: nil) as? [String: Any],\n704|              RunnerControllers.references(current, definition: definition) else {\n705|            throw RunnerError.message(\"Login slot '\\(copy.lastPathComponent)' belongs to another service. Remove it by hand instead of deleting.\")\n706|        }\n707|        try FileManager.default.removeItem(at: copy)\n708|    }\n709|\n710|    private func setAlias(id: String, alias: String?) async {\n711|        let entries = await catalog.load()\n712|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n713|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n714|            return\n715|        }\n716|        let trimmed = alias?.trimmingCharacters(in: .whitespacesAndNewlines)\n717|        entry.displayName = (trimmed?.isEmpty == true) ? nil : trimmed\n718|        do {\n719|            try await catalog.update(entry)\n720|            await action { Runners.Action.catalogCleared }\n721|            let snapshots = await service.snapshots()\n722|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n723|            await action { Runners.Action.refreshed(mapped_snapshots) }\n724|        } catch {\n725|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n726|        }\n727|    }\n728|\n729|    /// Relinks a moved folder. Requires the new folder to hold the same full\n730|    /// registration identity (server host, scope, agent ID) so a foreign\n731|    /// installation can never steal this entry. Any successful relocation\n732|    /// changes the canonical path and therefore invalidates the loaded group\n733|    /// editor, which must be reloaded explicitly. Updates the service\n734|    /// manifest paths, preserving RunAtLoad.\n735|    private func relink(id: String, url: URL) async {\n736|        if unregisterWorking.contains(id) || working.contains(id) {\n737|            await action { Runners.Action.catalogFailed(\"Runner is busy; retry after it settles.\") }\n738|            return\n739|        }\n740|        let entries = await catalog.load()\n741|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n742|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n743|            return\n744|        }\n745|        guard url.path != entry.directoryPath else {\n746|            await action { Runners.Action.catalogCleared }\n747|            return\n748|        }\n749|        if url.path.contains(\" \") {\n750|            await action { Runners.Action.catalogFailed(\"Path contains a space; choose a location without spaces.\") }\n751|            return\n752|        }\n753|        let canonical = RunnerCatalogStore.canonical(url)\n754|        if entries.contains(where: { $0.localID != entry.localID && $0.canonicalPath == canonical }) {\n755|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.duplicateDirectory(path: url.path).localizedDescription) }\n756|            return\n757|        }\n758|        guard let info = RunnerRegistrationReader.read(directory: url) else {\n759|            await action { Runners.Action.catalogFailed(\"Cannot read .runner in the selected folder.\") }\n760|            return\n761|        }\n762|        if let stored = entry.remoteAgentID, info.agentID != stored {\n763|            await action { Runners.Action.catalogFailed(\"Selected folder is agent \\(info.agentID.map(String.init) ?? \"unknown\"), not \\(stored). Refusing to relink a foreign installation.\") }\n764|            return\n765|        }\n766|        if let recordedHost = entry.serverHost, let folderHost = info.serverHost,\n767|           RunnerRegistration.OperationIdentity.normalizeServerHost(recordedHost)\n768|            != RunnerRegistration.OperationIdentity.normalizeServerHost(folderHost) {\n769|            await invalidateEditor(id: id, serviceLabel: entry.serviceLabel, message: \"Selected folder points at '\\(folderHost)', not '\\(recordedHost)'. Reload group access before applying.\")\n770|            await action { Runners.Action.catalogFailed(\"Selected folder points at '\\(folderHost)', not '\\(recordedHost)'. Refusing to relink a foreign installation.\") }\n771|            return\n772|        }\n773|        if let recordedScope = entry.scope, let folderScope = info.scopeDetail, recordedScope != folderScope {\n774|            await invalidateEditor(id: id, serviceLabel: entry.serviceLabel, message: \"Selected folder scope is '\\(folderScope)', not '\\(recordedScope)'. Reload group access before applying.\")\n775|            await action { Runners.Action.catalogFailed(\"Selected folder scope is '\\(folderScope)', not '\\(recordedScope)'. Refusing to relink a foreign installation.\") }\n776|            return\n777|        }\n778|        catalogGeneration += 1\n779|        do {\n780|            let plist = URL(fileURLWithPath: entry.servicePlistPath)\n781|            // Manual manifests move with the directory; standard manifests\n782|            // stay in LaunchAgents. Update whichever manifest this entry owns.\n783|            if plist.path.hasPrefix(entry.directoryPath) {\n784|                let moved = url.appendingPathComponent(\"manual-service.plist\")\n785|                if FileManager.default.fileExists(atPath: moved.path) {\n786|                    try await installer.updateServicePaths(plist: moved, directory: url)\n787|                    entry.servicePlistPath = moved.path\n788|                }\n789|            } else {\n790|                try await installer.updateServicePaths(plist: plist, directory: url)\n791|            }\n792|            let oldPath = entry.directoryPath\n793|            entry.directoryPath = url.path\n794|            entry.canonicalPath = canonical\n795|            entry.bookmarkBase64 = RunnerCatalogStore.bookmark(for: url)\n796|            entry.agentName = info.agentName ?? entry.agentName\n797|            entry.serverHost = info.serverHost ?? entry.serverHost\n798|            entry.scope = info.scopeDetail ?? entry.scope\n799|            entry.scopeKind = info.scopeKind ?? entry.scopeKind\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
