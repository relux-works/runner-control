     // This local bookkeeping follows a completed side effect: the\n455|            // remote removal is real even if the session changed while the\n456|            // installer lease was held, and no cancellation can undo it.\n457|            var updated = entry\n458|            updated.remoteAgentID = nil\n459|            updated.lastSeenAt = now()\n460|            try await catalog.update(updated)\n461|            await action { Runners.Action.catalogCleared }\n462|            let refreshed = await service.snapshots()\n463|            let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n464|            await action { Runners.Action.refreshed(mapped_refreshed) }\n465|        } catch {\n466|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n467|                await action { Runners.Action.catalogFailed(error.localizedDescription) }\n468|            }\n469|        }\n470|    }\n471|\n472|    /// Stopped-only gate for unregister. Only a positive confirmed `.stopped`\n473|    /// observation authorizes removal. `.running` refuses with a stop-first\n474|    /// message; a missing observation and every other state (unknown, failed,\n475|    /// missing, transitional, ...) refuse as unconfirmed instead of being\n476|    /// treated as stopped. A launchctl permission error (`.unknown`) therefore\n477|    /// never authorizes `config.sh remove` on a possibly live runner.\n478|    private func requireConfirmedStopped(entry: RunnerCatalogStore.Entry) async throws {\n479|        let snapshots = await service.snapshots()\n480|        guard let observation = snapshots.first(where: { $0.id == entry.serviceLabel }) else {\n481|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n482|                \"Cannot confirm the service '\\(entry.serviceLabel)' is stopped (no observation). Refusing to unregister while the service state is unconfirmed.\"\n483|            )\n484|        }\n485|        switch observatio