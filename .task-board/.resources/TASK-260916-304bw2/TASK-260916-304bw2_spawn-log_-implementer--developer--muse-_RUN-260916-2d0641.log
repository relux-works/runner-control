ount: Int { runners.filter { $0.status == .running }.count }\n20|        public func cleanup() async {\n21|            runners = runners.map { Snapshot(definition: $0.definition) }; changing = []; lastError = nil\n22|            candidates = []; catalogError = nil; selectedID = nil; unregistering = []\n23|            remoteSyncError = nil; lastRemoteSync = nil\n24|            logPreviewTitle = nil; logPreview = nil; groupAccess = [:]\n25|        }\n26|    }\n27|    public enum Action: Relux.Action {\n28|        case refreshed([Snapshot])\n29|        case changing(String, Bool)\n30|        case failed(String)\n31|        case clearError\n32|        case candidatesLoaded([RunnerDiscovery.Candidate])\n33|        case catalogFailed(String)\n34|        case catalogCleared\n35|        case selected(String?)\n36|        case unregistering(String, Bool)\n37|        case remoteUpdated(String, RemoteObservation)\n38|        case remoteSyncFinished(Date)\n39|        case remoteSyncFailed(String)\n40|        case logLoaded(title: String, excerpt: String)\n41|        case logCleared\n42|        case groupAccessLoading(String)\n43|        case groupAccessLoaded(String, GroupAccess)\n44|        case groupAccessFailed(String, String)\n45|        case groupAccessInvalidated(String, String)\n46|    }\n47|    public enum Effect: Relux.Effect {\n48|        case refresh\n49|        case setEnabled(String, Bool)\n50|        case setEnabledMany([String], Bool)\n51|        case loadCatalog\n52|        case discover\n53|        case importCandidate(RunnerDiscovery.Candidate)\n54|        case importFolder(URL)\n55|        case removeFromApp(String)\n56|        case unregister(String, confirmation: String)\n57|        case refreshRemote\n58|        case setRunAtLoad(String, Bool)\n59|        case setAlias(String, String?)\n60|        case relinkDirectory(String, URL)\n61|        case selectRunner(String?)\n62|        case loadLog(String)\n63|        case clearLog\n64|        case loadGroupAccess(String)\n65|        case applyGroupAccess(String, groupID: Int64, repositories: Set<Int64>, allowTakeover: Bool)\n66|    }\n67|}","final_result":true}}}
