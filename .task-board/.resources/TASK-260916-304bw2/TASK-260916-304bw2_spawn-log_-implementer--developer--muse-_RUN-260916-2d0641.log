2|\n1073|private func groupAccessError(_ logger: Relux.Testing.Logger, id: String) -> String? {\n1074|    for action in runnersActions(logger).reversed() {\n1075|        if case .groupAccessFailed(let failedID, let message) = action, failedID == id {\n1076|            return message\n1077|        }\n1078|        if case .groupAccessInvalidated(let failedID, let message) = action, failedID == id {\n1079|            return message\n1080|        }\n1081|    }\n1082|    return nil\n1083|}\n1084|\n1085|@Test func groupAccessUsesFreshAPIMembershipNotStalePool() async throws {\n1086|    // Local .runner carries stale pool3 fields; fresh API puts ID39 in group4.\n1087|    // Same-name foreign ID99 sits in group3 and must never be adopted.\n1088|    let harness = await catalogHarness(transportResponses: [\n1089|        groupsPayload([(3, \"old-group\"), (4, \"current-group\")]),\n1090|        groupRunnersPayload([(99, \"macbook-iv\", false)]),\n1091|        groupRunnersPayload([(39, \"macbook-iv\", true)]),\n1092|        groupReposPayload([101, 102])\n1093|    ])\n1094|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1095|    let dir = harness.home.appendingPathComponent(\"r\")\n1096|    try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)\n1097|    let stale: [String: Any] = [\n1098|        \"agentId\": 39, \"agentName\": \"macbook-iv\",\n1099|        \"poolId\": 3, \"poolName\": \"rose-air-projects\",\n1100|        \"gitHubUrl\": \"https://github.com/acme\", \"workFolder\": \"_work\"\n1101|    ]\n1102|    try JSONSerialization.data(withJSONObject: stale).write(to: dir.appendingPathComponent(\".runner\"))\n1103|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"runsvc.sh\"), atomically: true, encoding: .utf8)\n1104|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n1105|    let manifest: [String: Any] = [\n1106|        \"Label\": \"actions.runner.test.drift\",\n1107|        \"ProgramArguments\": [dir.appendingPathComponent(\"runsvc.sh\").path],\n1108|        \"WorkingDirectory\": dir.path, \"RunAtLoad\": false\n1109|    ]\n1110|    try PropertyListSerialization.data(fromPropertyList: manifest, format: .xml, options: 0)\n1111|        .write(to: dir.appendingPathComponent(\"manual-service.plist\"))\n1112|    let entry = RunnerCatalogStore.Entry(\n1113|        directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n1114|        serviceLabel: \"actions.runner.test.drift\",\n1115|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n1116|        controllerKind: .manualManaged, serverHost: \"github.com\",\n1117|        scopeKind: \"org\", scope: \"acme\", remoteAgentID: 39,\n1118|        agentName: \"macbook-iv\", workFolder: \"_work\"\n1119|    )\n1120|    try await harness.catalog.add(entry)\n1121|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.drift\"))\n1122|    let access = loadedGroupAccess(harness.logger, id: \"actions.runner.test.drift\")\n1123|    #expect(access?.group?.id == 4)\n1124|    #expect(access?.group?.name == \"current-group\")\n1125|    #expect(access?.repoIDs == [101, 102])\n1126|    #expect(access?.owned == false)\n1127|    #expect(groupAccessError(harness.logger, id: \"actions.runner.test.drift\") == nil)\n1128|}\n1129|\n1130|@Test func groupAccessRefusesRepoScope() async throws {\n1131|    let harness = await catalogHarness()\n1132|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1133|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme/app\", label: \"actions.runner.test.repo\")\n1134|    let entry = RunnerCatalogStore.Entry(\n1135|        directoryPath: dir.path, canonicalPath: RunnerCatalogStore.canonical(dir),\n1136|        serviceLabel: \"actions.runner.test.repo\",\n1137|        servicePlistPath: dir.appendingPathComponent(\"manual-service.plist\").path,\n1138|        controllerKind: .manualManaged, serverHost: \"github.com\",\n1139|        scopeKind: \"repo\", scope: \"acme/app\", remoteAgentID: 42, agentName: \"r\", workFolder: \"_work\"\n1140|    )\n1141|    try await harness.catalog.add(entry)\n1142|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.repo\"))\n1143|    let err = groupAccessError(harness.logger, id: \"actions.runner.test.repo\") ?? \"\"\n1144|    #expect(err.contains(\"organization runners only\"))\n1145|    #expect(await harness.transport.requests.isEmpty)\n1146|}\n1147|\n1148|@Test func applyGroupAccessRequiresTakeoverForShared() async throws {\n1149|    let harness = await catalogHarness(transportResponses: [\n1150|        groupsPayload([(4, \"team-group\")]),\n1151|        groupRunnersPayload([(42, \"r\", false)]),\n1152|        groupReposPayload([1])\n1153|    ])\n1154|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1155|    let dir = try makeRunnerDir(parent: harness.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: \"actions.runner.test.shared\")\n1156|    try await harness.catalog.add(unregisterEntry(dir: dir, label: \"actions.runner.test.shared\"))\n1157|    let _: Relux.ActionResult = await harness.flow.apply(Runners.Effect.loadGroupAccess(\"actions.runner.test.shared\"))\n1158|    #expect(loadedGroupAccess(harness.logger, id: \"actions.runner.test.shared\")?.owned == false)\n1159|    // Without takeover: refused before any PUT.\n1160|    await harness.transport.append(groupsPayload([(4, \"team-group\")]))\n1161|    await harness.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1162|    let _: Relux.ActionResult = await harness.flow.apply(\n1163|        Runners.Effect.applyGroupAccess(\"actions.runner.test.shared\", groupID: 4, repositories: [1, 2], allowTakeover: false)\n1164|    )\n1165|    let refused = groupAccessError(harness.logger, id: \"actions.runner.test.shared\") ?? \"\"\n1166|    #expect(refused.contains(\"team-group\"))\n1167|    #expect(await harness.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1168|    // With explicit takeover: ownership recorded, PUT applied, confirmation re-fetched.\n1169|    await harness.transport.append(groupsPayload([(4, \"team-group\")]))\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
