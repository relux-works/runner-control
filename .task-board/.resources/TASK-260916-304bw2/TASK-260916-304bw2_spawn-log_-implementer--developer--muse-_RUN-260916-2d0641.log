n\\\"}],\\\"examples\\\":[\\\"list(type=task, status=development) { overview }\\\",\\\"list(take=5) { minimal }\\\",\\\"list(type=story, skip=10, take=5) { overview }\\\"]},\\\"plan\\\":{\\\"description\\\":\\\"Get execution plan with dependency phases and critical path\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"scope\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Scope to an element ID, or a set of IDs: scope=[ID,ID,...] (union of their subtrees)\\\"},{\\\"name\\\":\\\"mode\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Planning mode: children or related\\\"},{\\\"name\\\":\\\"active\\\",\\\"type\\\":\\\"bool\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Exclude done/closed elements before building phases\\\"}],\\\"examples\\\":[\\\"plan()\\\",\\\"plan(EPIC-XX)\\\",\\\"plan(STORY-XX, mode=related)\\\",\\\"plan(EPIC-XX, active=true)\\\",\\\"plan(scope=[EPIC-XX, STORY-YY, TASK-ZZ], mode=children)\\\"]},\\\"project_config\\\":{\\\"description\\\":\\\"Show the active project board runtime config or a target-specific spawn preflight projection\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"view\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Optional narrow projection; targeted arguments opt in to spawn-preflight\\\",\\\"enum\\\":[\\\"spawn-preflight\\\"]},{\\\"name\\\":\\\"role\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Target spawn role; required for spawn-preflight\\\"},{\\\"name\\\":\\\"agent\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Explicit target runtime: a built-in runtime or one declared under spawn.runtimes; omitted uses normal provider selection\\\",\\\"enum\\\":[\\\"agy\\\",\\\"claude\\\",\\\"codex\\\",\\\"gemini\\\",\\\"muse\\\",\\\"qwen\\\",\\\"qwen-codex\\\"]},{\\\"name\\\":\\\"task_class\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Task class used for deterministi