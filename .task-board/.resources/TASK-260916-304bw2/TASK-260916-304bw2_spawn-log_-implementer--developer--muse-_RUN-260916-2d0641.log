port),\n22|        api: GitHubAPIClient(transport: authTransport),\n23|        refresher: GitHubTokenRefresh(transport: authTransport, store: h.userStore),\n24|        store: h.userStore, identityStore: h.identities, configProvider: { _ in testConfig },\n25|        dispatcher: Relux.Dispatcher(logger: Relux.Testing.Logger()))\n26|    let service = LaunchAgentService(catalog: h.catalog, executor: ReviewR4LogoutExecutor(auth: auth), userID: 501, home: h.home)\n27|    let flow = await Runners.Flow(service: service, catalog: h.catalog, installer: h.installer,\n28|        api: GitHubRunnerAPIClient(transport: h.transport), userStore: h.userStore,\n29|        identities: h.identities, refresher: GitHubTokenRefresh(transport: h.transport, store: h.userStore),\n30|        configProvider: { _ in testConfig }, home: h.home, dispatcher: Relux.Dispatcher(logger: h.logger))\n31|    _ = await flow.apply(Runners.Effect.unregister(label, confirmation: \"r\"))\n32|    #expect(await h.identities.load() == nil)\n33|    #expect(await h.transport.requests.count == 1)\n34|    #expect(await h.installerExecutor.calls.isEmpty)\n35|    #expect(await h.catalog.load().first?.remoteAgentID == 42)\n36|}\n37|\n38|@MainActor @Test(arguments: [false, true])\n39|func reviewR4SessionInvalidationMustReleaseEditorLoading(apply: Bool) async throws {\n40|    let responses: [GitHubHTTPResponse] = apply\n41|        ? [groupsPayload([(4, \"g\")]), groupRunnersPayload([(42, \"r\", false)]), .init(status: 204), groupReposPayload([2])]\n42|        : [groupsPayload([(4, \"g\")]), groupRunnersPayload([(42, \"r\", false)]), groupReposPayload([1])]\n43|    let h = await catalogHarness(transportResponses: responses)\n44|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n45|    let label = \"actions.runner.test.releaseeditor\"\n46|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n47|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n48|    let flow = await reviewR3ReloginFlow(h, method: apply ? \"PUT\" : \"GET\")\n49|    let effect: Runners.Effect = apply ? .applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true) : .loadGroupAccess(label)\n50|    _ = await flow.apply(effect)\n51|    #expect(await h.identities.load()?.sessionIncarnation != nil)\n52|    #expect(loadedGroupAccess(h.logger, id: label) == nil)\n53|    let state = Runners.State(definitions: [])\n54|    for action in runnersActions(h.logger) { await state.reduce(with: action) }\n55|    // Normal local polling must not leave the editor wedged either.\n56|    await state.reduce(with: Runners.Action.refreshed(await h.service.snapshots()))\n57|    #expect(state.groupAccess[label]?.loading != true)\n58|}","final_result":true}}}
