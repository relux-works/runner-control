{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c895","stream":{"kind":"session","id":"01a0a9e5-dacc-74b3-81e5-780baad0bee6"},"sequence":677,"recorded_at":1780531400001349,"record_type":"event","durability":"durable","causation_id":"d57b5cc1-8b32-4b5c-b165-7938b80d84cd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d57b5cc1-8b32-4b5c-b165-7938b80d84cd","run_stream":{"kind":"run","id":"d57b5cc1-8b32-4b5c-b165-7938b80d84cd"},"task_stream":{"kind":"task","id":"01a0a9e9-939f-7273-9fc7-9ec10aad338f"},"task_id":"01a0a9e9-939f-7273-9fc7-9ec10aad338f","event":{"kind":"output","task_id":"01a0a9e9-939f-7273-9fc7-9ec10aad338f","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n(1879 line(s) above)\n1880|    let before = await h.identities.load()\n1881|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [1, 2], allowTakeover: true))\n1882|    #expect(await h.identities.load()?.sessionIncarnation == before?.sessionIncarnation)\n1883|    #expect(await h.transport.requests.filter { $0.method == \"PUT\" }.count == 1)\n1884|    #expect(loadedGroupAccess(h.logger, id: label)?.repoIDs == [1, 2])\n1885|}\n1886|\n1887|/// Retry control: after a same-account relogin invalidates an unregister,\n1888|/// an explicit retry initiated in the new incarnation proceeds.\n1889|@Test func unregisterRetryInNewIncarnationSucceeds() async throws {\n1890|    let h = await catalogHarness(launchResults: [stopped, stopped, stopped, stopped],\n1891|        installerResults: [.init(code: 0, output: \"ok\")],\n1892|        transportResponses: [removeTokenPayload(), removeTokenPayload()])\n1893|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1894|    let label = \"actions.runner.test.unregrelogin\"\n1895|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1896|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1897|    let stale = await reviewR3ReloginFlow(h, method: \"POST\")\n1898|    let _: Relux.ActionResult = await stale.apply(Runners.Effect.unregister(label, confirmation: \"r\"))\n1899|    #expect(await h.identities.load()?.userID == 42)\n1900|    #expect(await h.identities.load()?.sessionIncarnation?.isEmpty == false)\n1901|    #expect(await h.installerExecutor.calls.isEmpty)\n1902|    #expect(await h.catalog.load().first?.remoteAgentID == 42)\n1903|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.unregister(label, confirmation: \"r\"))\n1904|    #expect(await h.installerExecutor.calls.count == 1)\n1905|    #expect(await h.catalog.load().first?.remoteAgentID == nil)\n1906|}\n1907|\n1908|/// R3-F1 bound: relink to a same-ID different-scope folder refuses, keeps\n1909|/// the catalog on the original, invalidates the loaded editor, and requires\n1910|/// an explicit Load before the next Apply (which then targets the original).\n1911|@Test func relinkRefusesChangedScopeAndRequiresReload() async throws {\n1912|    let h = await catalogHarness(transportResponses: [\n1913|        groupsPayload([(4, \"g\")]), groupRunnersPayload([(42, \"r\", false)]), groupReposPayload([1])\n1914|    ])\n1915|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1916|    let label = \"actions.runner.test.relinkscope\"\n1917|    let dir = try makeRunnerDir(parent: h.home, name: \"original\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1918|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1919|    _ = await h.flow.apply(Runners.Effect.loadGroupAccess(label))\n1920|    #expect(loadedGroupAccess(h.logger, id: label)?.group?.id == 4)\n1921|    let foreign = try makeRunnerDir(parent: h.home, name: \"foreign\", agentName: \"r\", scope: \"other-org\", agentID: 42, label: label)\n1922|    _ = await h.flow.apply(Runners.Effect.relinkDirectory(label, foreign))\n1923|    #expect(catalogErr(h.logger).contains(\"other-org\") && catalogErr(h.logger).contains(\"acme\"))\n1924|    #expect(await h.catalog.load().first?.directoryPath == dir.path)\n1925|    #expect(await h.catalog.load().first?.scope == \"acme\")\n1926|    #expect((groupAccessError(h.logger, id: label) ?? \"\").contains(\"Reload group access\"))\n1927|    _ = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true))\n1928|    #expect(await h.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1929|    await h.transport.append(groupsPayload([(4, \"g\")]))\n1930|    await h.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1931|    await h.transport.append(groupReposPayload([1]))\n1932|    _ = await h.flow.apply(Runners.Effect.loadGroupAccess(label))\n1933|    #expect(loadedGroupAccess(h.logger, id: label)?.group?.id == 4)\n1934|    await h.transport.append(groupsPayload([(4, \"g\")]))\n1935|    await h.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1936|    await h.transport.append(.init(status: 204, body: Data()))\n1937|    await h.transport.append(groupReposPayload([2]))\n1938|    _ = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true))\n1939|    let puts = await h.transport.requests.filter { $0.method == \"PUT\" }\n1940|    #expect(puts.count == 1)\n1941|    #expect(puts.first?.url.path.contains(\"orgs/acme/\") == true)\n1942|}\n1943|\n1944|/// R3-F1 bound: a legitimate same-identity move still changes the canonical\n1945|/// path, so it invalidates the editor and requires an explicit Load; the\n1946|/// reloaded editor then applies to the moved folder.\n1947|@Test func relinkSameIdentityMoveRequiresReload() async throws {\n1948|    let h = await catalogHarness(transportResponses: [\n1949|        groupsPayload([(4, \"g\")]), groupRunnersPayload([(42, \"r\", false)]), groupReposPayload([1])\n1950|    ])\n1951|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1952|    let label = \"actions.runner.test.relinkmove\"\n1953|    let a = try makeRunnerDir(parent: h.home, name: \"a\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1954|    try await h.catalog.add(unregisterEntry(dir: a, label: label))\n1955|    _ = await h.flow.apply(Runners.Effect.loadGroupAccess(label))\n1956|    #expect(loadedGroupAccess(h.logger, id: label)?.group?.id == 4)\n1957|    let b = try makeRunnerDir(parent: h.home, name: \"b\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1958|    _ = await h.flow.apply(Runners.Effect.relinkDirectory(label, b))\n1959|    #expect(await h.catalog.load().first?.directoryPath == b.path)\n1960|    #expect((groupAccessError(h.logger, id: label) ?? \"\").contains(\"Reload group access\"))\n1961|    _ = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true))\n1962|    #expect(await h.transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1963|    await h.transport.append(groupsPayload([(4, \"g\")]))\n1964|    await h.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1965|    await h.transport.append(groupReposPayload([1]))\n1966|    _ = await h.flow.apply(Runners.Effect.loadGroupAccess(label))\n1967|    #expect(loadedGroupAccess(h.logger, id: label)?.group?.id == 4)\n1968|    await h.transport.append(groupsPayload([(4, \"g\")]))\n1969|    await h.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n1970|    await h.transport.append(.init(status: 204, body: Data()))\n1971|    await h.transport.append(groupReposPayload([2]))\n1972|    _ = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true))\n1973|    #expect(await h.transport.requests.filter { $0.method == \"PUT\" }.count == 1)\n1974|    #expect(loadedGroupAccess(h.logger, id: label)?.repoIDs == [2])\n1975|}","final_result":true}}}
