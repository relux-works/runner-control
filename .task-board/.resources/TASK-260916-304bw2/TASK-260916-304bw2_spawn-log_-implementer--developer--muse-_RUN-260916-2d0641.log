{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c625","stream":{"kind":"session","id":"01a0a9e5-dacc-74b3-81e5-780baad0bee6"},"sequence":365,"recorded_at":1780531400000725,"record_type":"event","durability":"durable","causation_id":"d57b5cc1-8b32-4b5c-b165-7938b80d84cd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d57b5cc1-8b32-4b5c-b165-7938b80d84cd","run_stream":{"kind":"run","id":"d57b5cc1-8b32-4b5c-b165-7938b80d84cd"},"task_stream":{"kind":"task","id":"01a0a9e6-cc2f-7273-876c-c537bd87d987"},"task_id":"01a0a9e6-cc2f-7273-876c-c537bd87d987","event":{"kind":"output","task_id":"01a0a9e6-cc2f-7273-876c-c537bd87d987","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n(379 line(s) above)\n380|                  let address = local.gitHubURL,\n381|                  let scope = unregisterScope(address: address) else {\n382|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n383|                    \"No verified local registration for '\\(entry.serviceLabel)'. Refusing to unregister another runner by name.\"\n384|                )\n385|            }\n386|            // Service-path binding: the catalog entry must still point at the\n387|            // verified directory; a relink mid-flight invalidates the evidence.\n388|            let canonical = RunnerCatalogStore.canonical(directory)\n389|            guard canonical == entry.canonicalPath else {\n390|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n391|                    \"Service path changed during unregister. Re-verify instead of removing another directory's registration.\"\n392|                )\n393|            }\n394|            // Agent-ID binding: a stored ID that disagrees with disk fails\n395|            // closed instead of removing a foreign registration.\n396|            if let stored = entry.remoteAgentID, stored != agentID {\n397|                throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n398|                    \"Catalog expects agent \\(stored) but disk shows agent \\(agentID) for '\\(agentName)'. Refusing to unregister a mismatched registration.\"\n399|                )\n400|            }\n401|            guard confirmation == agentName else {\n402|                throw RunnerRegistration.RegistrationError.confirmationMismatch(\n403|                    \"Type '\\(agentName)' to confirm unregister of agent \\(agentID) in \\(scope.detail).\"\n404|                )\n405|            }\n406|            guard !isCatalogStale(gen) else { return }\n407|            // Stopped-only gate: a positive confirmed `.stopped` observation\n408|            // is required before minting the remove token, so unregister\n409|            // cannot interrupt a job — or a service whose state is unknown.\n410|            try await requireConfirmedStopped(entry: entry)\n411|            guard !isCatalogStale(gen) else { return }\n412|            let auth = try await currentUserToken()\n413|            guard !isCatalogStale(gen) else { return }\n414|            // Server binding: the verified host must equal the authenticated\n415|            // server; a same-path foreign host never authorizes removal here.\n416|            let verifiedHost = URL(string: address)?.host ?? \"\"\n417|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n418|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n419|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n420|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost). Refusing cross-server unregister.\"\n421|                )\n422|            }\n423|            let created = try await api.createRemoveToken(config: auth.config, token: auth.token, scope: scope)\n424|            guard !isCatalogStale(gen) else { return }\n425|            // A logout, account or server switch during token acquisition\n426|            // invalidates the unstarted side effect; the minted token\n427|            // simply expires unused.\n428|            guard await sessionStill(startedIdentity) else { return }\n429|            // Re-verify after the network: scope/path edits invalidate stale\n430|            // evidence instead of removing a re-targeted registration.\n431|            guard let reread = await installer.readLocalRegistration(directory: directory),\n432|                  reread.agentID == agentID, reread.agentName == agentName,\n433|                  reread.gitHubURL == address else {\n434|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n435|                    \"Local registration changed during unregister. Re-verify instead of removing a re-targeted registration.\"\n436|                )\n437|            }\n438|            let currentEntries = await catalog.load()\n439|            guard currentEntries.contains(where: { $0.localID == entry.localID && $0.canonicalPath == canonical }) else {\n440|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n441|                    \"Catalog entry changed during unregister. Re-verify instead of removing another entry.\"\n442|                )\n443|            }\n444|            // Revalidate the stopped evidence at the side-effect boundary: a\n445|            // service started (or lost to inspection) after the token mint\n446|            // must not be unregistered.\n447|            guard !isCatalogStale(gen) else { return }\n448|            guard await sessionStill(startedIdentity) else { return }\n449|            try await requireConfirmedStopped(entry: entry)\n450|            try await installer.unregister(directory: directory, removeToken: created.token)\n451|            guard !isCatalogStale(gen) else { return }\n452|            // Remote registration is gone; the catalog entry stays so the\n453|            // user can re-register or remove it from the app. Files stay.\n454|            // This local bookkeeping follows a completed side effect: the\n455|            // remote removal is real even if the session changed while the\n456|            // installer lease was held, and no cancellation can undo it.\n457|            var updated = entry\n458|            updated.remoteAgentID = nil\n459|            updated.lastSeenAt = now()\n460|            try await catalog.update(updated)\n461|            await action { Runners.Action.catalogCleared }\n462|            let refreshed = await service.snapshots()\n463|            let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n464|            await action { Runners.Action.refreshed(mapped_refreshed) }\n465|        } catch {\n466|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n467|                await action { Runners.Action.catalogFailed(error.localizedDescription) }\n468|            }\n469|        }\n470|    }\n471|\n472|    /// Stopped-only gate for unregister. Only a positive confirmed `.stopped`\n473|    /// observation authorizes removal. `.running` refuses with a stop-first\n474|    /// message; a missing observation and every other state (unknown, failed,\n475|    /// missing, transitional, ...) refuse as unconfirmed instead of being\n476|    /// treated as stopped. A launchctl permission error (`.unknown`) therefore\n477|    /// never authorizes `config.sh remove` on a possibly live runner.\n478|    private func requireConfirmedStopped(entry: RunnerCatalogStore.Entry) async throws {\n479|        let snapshots = await service.snapshots()\n480|        guard let observation = snapshots.first(where: { $0.id == entry.serviceLabel }) else {\n481|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n482|                \"Cannot confirm the service '\\(entry.serviceLabel)' is stopped (no observation). Refusing to unregister while the service state is unconfirmed.\"\n483|            )\n484|        }\n485|        switch observation.status {\n486|        case .stopped:\n487|            return\n488|        case .running:\n489|            throw RunnerRegistration.RegistrationError.invalidDraft(\n490|                \"Stop the runner first; unregister refuses to interrupt a running service.\"\n491|            )\n492|        default:\n493|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n494|                \"Cannot confirm the service '\\(entry.serviceLabel)' is stopped (observed: \\(observation.status.rawValue)). Refusing to unregister while the service state is unconfirmed.\"\n495|            )\n496|        }\n497|    }\n498|\n499|    private func unregisterScope(address: String) -> RunnerRegistration.Scope? {\n500|        guard let url = URL(string: address), url.scheme == \"https\" else { return nil }\n501|        let components = url.pathComponents.filter { $0 != \"/\" }\n502|        if components.count == 1 { return .organization(org: components[0]) }\n503|        if components.count == 2 { return .repository(owner: components[0], name: components[1]) }\n504|        return nil\n505|    }\n506|\n507|    private struct CatalogUserToken: Sendable {\n508|        let config: GitHubAuth.AppConfig\n509|        let token: String\n510|        let identity: GitHubSessionIdentity\n511|    }\n512|\n513|    private func currentUserToken() async throws -> CatalogUserToken {\n514|        guard let identity = await identities.load() else {\n515|            throw RunnerRegistration.RegistrationError.notAuthenticated\n516|        }\n517|        let config = try configProvider(identity.serverHost)\n518|        guard var record = await userStore.load(serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID) else {\n519|            throw RunnerRegistration.RegistrationError.notAuthenticated\n520|        }\n521|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n522|            do {\n523|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n524|            } catch is CancellationError {\n525|                throw CancellationError()\n526|            } catch let error as GitHubAuth.AuthError {\n527|                switch error {\n528|                case .revoked, .unauthorized, .tokenRefreshFailed:\n529|                    throw RunnerRegistration.RegistrationError.unauthorized\n530|                default: break\n531|                }\n532|            }\n533|        }\n534|        return CatalogUserToken(config: config, token: record.accessToken, identity: identity)\n535|    }\n536|\n537|    // MARK: - Remote observation\n538|\n539|    /// Best-effort GitHub sync. Offline, 401/403 and rate limits mark data\n540|    /// stale and never change local power state. Follows full pagination\n541|    /// before matching; matches by server + scope + ID, never by name.\n542|    private func refreshRemote() async {\n543|        let startedIdentity = await identities.load()\n544|        let entries = await catalog.load()\n545|        if entries.isEmpty {\n546|            await action { Runners.Action.remoteSyncFinished(self.now()) }\n547|            return\n548|        }\n549|        let auth: CatalogUserToken\n550|        do {\n551|            auth = try await currentUserToken()\n552|        } catch {\n553|            // Disconnected: local control stays fully available.\n554|            await action { Runners.Action.remoteSyncFailed(error.localizedDescription) }\n555|            return\n556|        }\n557|        // Group definitions by scope so one paginated list serves every\n558|        // runner in that scope.\n559|        var scopes: [String: (scope: RunnerRegistration.Scope, ids: [String])] = [:]\n560|        var definitions: [String: Runners.Definition] = [:]\n561|        for entry in entries {\n562|            let directory = RunnerCatalogStore.resolve(entry: entry)\n563|            let info = RunnerRegistrationReader.read(directory: directory)\n564|            guard let address = info?.gitHubURL ?? entry.serverHost.map({ \"https://\\($0)/\\(entry.scope ?? \"\")\" }),\n565|                  let scope = unregisterScope(address: address) else { continue }\n566|            // Observe only registrations on the authenticated server.\n567|            let host = URL(string: address)?.host ?? entry.serverHost ?? \"\"\n568|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(host)\n569|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else { continue }\n570|            let key = scope.scopeKey\n571|            scopes[key, default: (scope, [])].ids.append(entry.serviceLabel)\n572|            definitions[entry.serviceLabel] = LaunchAgentService.definition(from: entry)\n573|        }\n574|        var failures: [String] = []\n575|        for (_, group) in scopes {\n576|            // A logout or login replacement mid-sync stops silently: no writes\n577|            // into a changed session incarnation.\n578|            guard await sessionStill(startedIdentity) else { return }\n579|            do {\n580|                let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: group.scope)\n581|                for id in group.ids {\n582|                    guard let definition = definitions[id] else { continue }\n583|                    if let observation = GitHubRunnerObserver.match(definition: definition, runners: runners, now: now()) {\n584|                        await action { Runners.Action.remoteUpdated(id, GitHubRunnerObserver.withFreshness(observation, now: self.now())) }\n585|                    } else {\n586|                        await action { Runners.Action.remoteUpdated(id, Runners.RemoteObservation(\n587|                            busyKnown