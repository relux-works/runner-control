cess = groupAccess.filter { live.contains($0.key) }\n25|        case .changing(let id, let value):\n26|            if value { changing.insert(id) } else { changing.remove(id) }\n27|        case .failed(let message): lastError = message\n28|        case .clearError: lastError = nil\n29|        case .candidatesLoaded(let candidates): self.candidates = candidates\n30|        case .catalogFailed(let message): catalogError = message\n31|        case .catalogCleared: catalogError = nil\n32|        case .selected(let id): selectedID = id\n33|        case .unregistering(let id, let value):\n34|            if value { unregistering.insert(id) } else { unregistering.remove(id) }\n35|        case .remoteUpdated(let id, let observation):\n36|            if let index = runners.firstIndex(where: { $0.id == id }) {\n37|                var next = runners[index]\n38|                next.remote = observation\n39|                runners[index] = next\n40|            }\n41|        case .remoteSyncFinished(let date):\n42|            lastRemoteSync = date\n43|            remoteSyncError = nil\n44|        case .remoteSyncFailed(let message):\n45|            remoteSyncError = message\n46|        case .logLoaded(let title, let excerpt):\n47|            logPreviewTitle = title\n48|            logPreview = excerpt\n49|        case .logCleared:\n50|            logPreviewTitle = nil\n51|            logPreview = nil\n52|        case .groupAccessLoading(let id):\n53|            var current = groupAccess[id] ?? Runners.GroupAccess()\n54|            current.loading = true\n55|            current.error = nil\n56|            groupAccess[id] = current\n57|        case .groupAccessLoaded(let id, let access):\n58|            groupAccess[id] = access\n59|        case .groupAccessFailed(let id, let message):\n60|            var current = groupAccess[id] ?? Runners.GroupAccess()\n61|            current.loading = false\n62|            current.error = message\n63|            groupAccess[id] = current\n64|        case .groupAccessInvalidated(let id, let message):\n65|            groupAccess[id] = Runners.GroupAccess(loading: false, error: message)\n66|        }\n67|    }\n68|}","final_result":true}}}
