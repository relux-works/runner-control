ReviewR3ReloginTransport: GitHubHTTPTransport {\n1746|    let base: TestTransport\n1747|    let auth: GitHubAuth.Flow\n1748|    let authLogger: Relux.Testing.Logger\n1749|    let method: String\n1750|    private var fired = false\n1751|    init(base: TestTransport, auth: GitHubAuth.Flow, logger: Relux.Testing.Logger, method: String) {\n1752|        self.base = base; self.auth = auth; self.authLogger = logger; self.method = method\n1753|    }\n1754|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n1755|        let result = try await base.send(request)\n1756|        if request.method == method && !fired {\n1757|            fired = true\n1758|            _ = await auth.apply(GitHubAuth.Effect.logout)\n1759|            _ = await auth.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n1760|            let deadline = ContinuousClock.now.advanced(by: .seconds(3))\n1761|            while ContinuousClock.now < deadline {\n1762|                if authLogger.actions.contains(where: {\n1763|                    guard let a = $0 as? GitHubAuth.Action else { return false }\n1764|                    if case .connected = a { return true }; return false\n1765|                }) { return result }\n1766|                try await Task.sleep(for: .milliseconds(5))\n1767|            }\n1768|            Issue.record(\"Real auth flow failed to finish same-account re-login\")\n1769|        }\n1770|        return result\n1771|    }\n1772|}\n1773|\n1774|private func reviewR3ReloginFlow(_ h: CatalogHarness, method: String) async -> Runners.Flow {\n1775|    let authTransport = TestTransport([\n1776|        jsonResponse([\"device_code\": \"dev-r3\", \"user_code\": \"R3-CODE\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n1777|        jsonResponse([\"access_token\": \"[REDACTED]\", \"refresh_token\": \"[REDACTED]\", \"expires_in\": 3600]),\n1778|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n1779|        jsonResponse([\"installations\": []])\n1780|    ])\n1781|    let logger = Relux.Testing.Logger()\n1782|    let auth = await GitHubAuth.Flow(deviceFlow: GitHubDeviceFlow(transport: authTransport),\n1783|        api: GitHubAPIClient(transport: authTransport),\n1784|        refresher: GitHubTokenRefresh(transport: authTransport, store: h.userStore),\n1785|        store: h.userStore, identityStore: h.identities, configProvider: { _ in testConfig },\n1786|        sleeper: { _ in }, dispatcher: Relux.Dispatcher(logger: logger))\n1787|    let transport = ReviewR3ReloginTransport(base: h.transport, auth: auth, logger: logger, method: method)\n1788|    return await Runners.Flow(service: h.service, catalog: h.catalog, installer: h.installer,\n1789|        api: GitHubRunnerAPIClient(transport: transport), userStore: h.userStore,\n1790|        identities: h.identities, refresher: GitHubTokenRefresh(transport: transport, store: h.userStore),\n1791|        configProvider: { _ in testConfig }, home: h.home, dispatcher: Relux.Dispatcher(logger: h.logger))\n1792|}\n1793|\n1794|@Test func reviewR3SameAccountReloginDuringPutMustNotPublishAccess() async throws {\n1795|    let h = await catalogHarness(transportResponses: [groupsPayload([(4, \"g\")]),\n1796|        groupRunnersPayload([(42, \"r\", false)]), .init(status: 204, body: Data()), groupReposPayload([1])])\n1797|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1798|    let label = \"actions.runner.test.logoutput\"\n1799|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1800|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1801|    let flow = await reviewR3ReloginFlow(h, method: \"PUT\")\n1802|    let _: Relux.ActionResult = await flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [1], allowTakeover: true))\n1803|    #expect(await h.identities.load()?.userID == 42)\n1804|    #expect(loadedGroupAccess(h.logger, id: label) == nil)\n1805|    #expect(await h.transport.requests.count == 3)\n1806|}\n1807|\n1808|@Test func reviewR3SameAccountReloginDuringRemoveTokenMustRefuseSideEffect() async throws {\n1809|    let h = await catalogHarness(launchResults: [stopped, stopped, stopped],\n1810|        installerResults: [.init(code: 0, output: \"ok\")], transportResponses: [removeTokenPayload()])\n1811|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1812|    let label = \"actions.runner.test.logoutremove\"\n1813|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1814|    try \"#!/bin/sh\\nexit 0\\n\".write(to: dir.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n1815|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1816|    let flow = await reviewR3ReloginFlow(h, method: \"POST\")\n1817|    let _: Relux.ActionResult = await flow.apply(Runners.Effect.unregister(label, confirmation: \"r\"))\n1818|    #expect(await h.identities.load()?.userID == 42)\n1819|    #expect(await h.installerExecutor.calls.isEmpty)\n1820|    #expect(await h.catalog.load().first?.remoteAgentID == 42)\n1821|}\n1822|\n1823|@Test func reviewR3RelinkMustNotRebindLoadedEditorToOtherOrg() async throws {\n1824|    let h = await catalogHarness(transportResponses: [groupsPayload([(4, \"g\")]),\n1825|        groupRunnersPayload([(42, \"r\", false)]), groupReposPayload([1]),\n1826|        groupsPayload([(4, \"g\")]), groupRunnersPayload([(42, \"r\", false)]),\n1827|        .init(status: 204), groupReposPayload([2])])\n1828|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1829|    let label = \"actions.runner.test.relinkretarget\"\n1830|    let dir = try makeRunnerDir(parent: h.home, name: \"original\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1831|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1832|    _ = await h.flow.apply(Runners.Effect.loadGroupAccess(label))\n1833|    #expect(loadedGroupAccess(h.logger, id: label)?.group?.id == 4)\n1834|    let foreign = try makeRunnerDir(parent: h.home, name: \"foreign\", agentName: \"r\", scope: \"other-org\", agentID: 42, label: label)\n1835|    _ = await h.flow.apply(Runners.Effect.relinkDirectory(label, foreign))\n1836|    _ = await h.flow.apply(Runners.Effect.applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true))\n1837|    let writes = await h.transport.requests.filter { $0.method == \"PUT\" }\n1838|    #expect(writes.isEmpty)\n1839|}\n1840|\n1841|// MARK: - R4 bounds: incarnation, editor invalidation, retry, refresh\n1842|\n1843|/// R3-F2 sibling (Load completion): same-account re-login through the real\n1844|/// auth flow during the Load membership reads refuses the repository fetch\n1845|/// and any publication into the new incarnation.\n1846|@Test func reviewR3SiblingLoadDuringReloginMustNotPublishAccess() async throws {\n1847|    let h = await catalogHarness(transportResponses: [groupsPayload([(4, \"g\")]),\n1848|        groupRunnersPayload([(42, \"r\", false)]), groupReposPayload([1])])\n1849|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1850|    let label = \"actions.runner.test.loadrelogin\"\n1851|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1852|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1853|    let flow = await reviewR3ReloginFlow(h, method: \"GET\")\n1854|    let _: Relux.ActionResult = await flow.apply(Runners.Effect.loadGroupAccess(label))\n1855|    #expect(await h.identities.load()?.userID == 42)\n1856|    #expect(await h.identities.load()?.sessionIncarnation?.isEmpty == false)\n1857|    #expect(loadedGroupAccess(h.logger, id: label) == nil)\n1858|    #expect(groupAccessError(h.logger, id: label) == nil)\n1859|    #expect(await h.transport.requests.count == 2)\n1860|}\n1861|\n1862|/// Positive control: an expiring token refreshed within the same login keeps\n1863|/// the same incarnation, so Apply proceeds and publishes.\n1864|@Test func applySucceedsAfterTokenRefreshWithinSameLogin() async throws {\n1865|    let h = await catalogHarness(transportResponses: [\n1866|        jsonResponse([\"access_token\": \"ghu_new\", \"refresh_token\": \"ghr_new\", \"expires_in\": 3600]),\n1867|        groupsPayload([(4, \"g\")]),\n1868|        groupRunnersPayload([(42, \"r\", false)]),\n1869|        .init(status: 204, body: Data()),\n1870|        groupReposPayload([1, 2])\n1871|    ])\n1872|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n1873|    let label = \"actions.runner.test.refreshok\"\n1874|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n1875|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n1876|    try? await h.userStore.save(\n1877|        GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(30)),\n1878|        serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n1879|    )\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
