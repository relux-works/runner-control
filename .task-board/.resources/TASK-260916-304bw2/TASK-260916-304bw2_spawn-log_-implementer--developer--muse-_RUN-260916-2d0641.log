{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c691","stream":{"kind":"session","id":"01a0a9e5-dacc-74b3-81e5-780baad0bee6"},"sequence":419,"recorded_at":1780531400000833,"record_type":"event","durability":"durable","causation_id":"d57b5cc1-8b32-4b5c-b165-7938b80d84cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d57b5cc1-8b32-4b5c-b165-7938b80d84cd","run_stream":{"kind":"run","id":"d57b5cc1-8b32-4b5c-b165-7938b80d84cd"},"call_id":"call_01a0a9e6e45272e482f81e0bca5a67f1","text":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n(899 line(s) above)\n900|        if let storedHost = entry.serverHost,\n901|           RunnerRegistration.OperationIdentity.normalizeServerHost(storedHost)\n902|               != RunnerRegistration.OperationIdentity.normalizeServerHost(diskHost) {\n903|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n904|                \"Local registration server changed from '\\(storedHost)' to '\\(diskHost)' since import. Re-add the runner (or relink its moved folder) to re-verify instead of editing with stale identity.\"\n905|            )\n906|        }\n907|        if let storedScope = entry.scope, storedScope != components[0] {\n908|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n909|                \"Local registration scope changed from '\\(storedScope)' to '\\(components[0])' since import. Re-add the runner (or relink its moved folder) to re-verify instead of editing with stale identity.\"\n910|            )\n911|        }\n912|        return VerifiedOrgRunner(entry: entry, directory: directory, org: components[0], agentID: agentID, agentName: agentName)\n913|    }\n914|\n915|    /// Resolves the runner's current GitHub group by fresh API membership:\n916|    /// lists every group, then each group's runners, matching by agent ID\n917|    /// (and exact name on the matched ID). Never reads `.runner` pool\n918|    /// fields and never adopts a same-name foreign runner or group.\n919|    private func resolveFreshGroup(\n920|        org: String, agentID: Int64, agentName: String,\n921|        auth: CatalogUserToken, generation gen: Int\n922|    ) async throws -> RunnerRegistration.RunnerGroup {\n923|        let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n924|        for group in groups {\n925|            if isCatalogStale(gen) { throw CancellationError() }\n926|            let members = try await api.fetchGroupRunners(config: auth.config, token: auth.token, org: org, groupID: group.id)\n927|            if let exact = members.first(where: { $0.id == agentID }) {\n928|                guard exact.name == agentName else {\n929|                    throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n930|                        \"Group '\\(group.name)' lists agent \\(agentID) as '\\(exact.name)', not '\\(agentName)'. Refusing a mismatched group.\"\n931|                    )\n932|                }\n933|                return group\n934|            }\n935|            // A same-name foreign member in this group is ignored: only the\n936|            // exact agent ID binds membership.\n937|        }\n938|        throw RunnerRegistration.RegistrationError.remoteRunnerNotFound(\n939|            \"Agent \\(agentID) is not in any visible group for '\\(org)'. It may have been moved or the App lacks group access.\"\n940|        )\n941|    }\n942|\n943|    /// Loads fresh group + repository access for one org runner. Display and\n944|    /// later edits use this API answer, never stale `.runner` pool fields.\n945|    private func loadGroupAccess(id: String) async {\n946|        let gen = catalogGeneration\n947|        let startedIdentity = await identities.load()\n948|        await action { Runners.Action.groupAccessLoading(id) }\n949|        do {\n950|            let verified = try await verifiedOrgRunner(id: id)\n951|            let auth = try await currentUserToken()\n952|            if isCatalogStale(gen) { return }\n953|            guard await sessionStill(startedIdentity) else { return }\n954|            let verifiedHost = URL(string: (await installer.readLocalRegistration(directory: verified.directory))?.gitHubURL ?? \"\")?.host ?? \"\"\n955|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n956|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n957|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n958|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost).\"\n959|                )\n960|            }\n961|            let group = try await resolveFreshGroup(\n962|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n963|                auth: auth, generation: gen\n964|            )\n965|            if isCatalogStale(gen) { return }\n966|            // Completion ownership: a logout, account/server switch, or\n967|            // same-account re-login during the membership reads refuses\n968|            // further authenticated work and any state publication into the\n969|            // changed session incarnation.\n970|            guard await sessionStill(startedIdentity) else { return }\n971|            let repoIDs = try await api.fetchGroupRepositories(\n972|                config: auth.config, token: auth.token, org: verified.org, groupID: group.id\n973|            )\n974|            if isCatalogStale(gen) { return }\n975|            guard await sessionStill(startedIdentity) else { return }\n976|            let owned = await installer.loadOwnedGroupID(\n977|                serverHost: auth.identity.serverHost, org: verified.org, name: group.name\n978|            ) == group.id\n979|            let authority = Runners.EditorAuthority(\n980|                serverHost: verifiedHost, org: verified.org,\n981|                agentID: verified.agentID, agentName: verified.agentName,\n982|                canonicalPath: RunnerCatalogStore.canonical(verified.directory),\n983|                localID: verified.entry.localID\n984|            )\n985|            editorAuthorities[verified.entry.serviceLabel] = authority\n986|            editorInvalidated.remove(verified.entry.serviceLabel)\n987|            let access = Runners.GroupAccess(\n988|                group: group, repoIDs: repoIDs.sorted(), updatedAt: now(),\n989|                owned: owned, loading: false, authority: authority\n990|            )\n991|            await action { Runners.Action.groupAccessLoaded(id, access) }\n992|        } catch is CancellationError {\n993|            return\n994|        } catch {\n995|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n996|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n997|                await action { Runners.Action.groupAccessFailed(id, message) }\n998|            }\n999|        }\n1000|    }\n1001|\n1002|    /// True when the GitHub session still matches the login incarnation this\n1003|    /// operation started with. A logout, account/server switch, or logout +\n1004|    /// same-account re-login mid-operation stops silently: no writes into a\n1005|    /// changed session. Ordinary token refresh keeps the same incarnation and\n1006|    /// stays valid. Legacy identities without an incarnation compare as nil.\n1007|    private func sessionStill(_ started: GitHubSessionIdentity?) async -> Bool {\n1008|        let current = await identities.load()\n1009|        guard let started else { return current == nil }\n1010|        guard let current else { return false }\n1011|        guard current.userID == started.userID,\n1012|              RunnerRegistration.OperationIdentity.normalizeServerHost(current.serverHost)\n1013|                == RunnerRegistration.OperationIdentity.normalizeServerHost(started.serverHost) else { return false }\n1014|        return current.sessionIncarnation == started.sessionIncarnation\n1015|    }\n1016|\n1017|    /// Write-path identity binding for group edits. Re-reads the mutable\n1018|    /// local registration and requires it to still match the verified\n1019|    /// server host, org scope, agent ID and name, and requires the catalog\n1020|    /// entry to still point at the verified canonical directory. A\n1021|    /// same-path foreign host, a scope edit, or a relink mid-flight fails\n1022|    /// instead of writing another server's group. Called after\n1023|    /// authentication and re-called at the PUT boundary.\n1024|    private func bindApplyIdentity(verified: VerifiedOrgRunner, auth: CatalogUserToken) async throws {\n1025|        guard let reread = await installer.readLocalRegistration(directory: verified.directory),\n1026|              reread.agentID == verified.agentID,\n1027|              reread.agentName == verified.agentName,\n1028|              let address = reread.gitHubURL,\n1029|              let url = URL(string: address), url.scheme == \"https\" else {\n1030|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1031|                \"Local registration changed during group apply. Reload instead of editing with stale identity.\"\n1032|            )\n1033|        }\n1034|        let components = url.pathComponents.filter { $0 != \"/\" }\n1035|        guard components.count == 1, components[0] == verified.org else {\n1036|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1037|                \"Local registration scope changed during group apply. Reload instead of editing with stale identity.\"\n1038|            )\n1039|        }\n1040|        let verifiedHost = url.host ?? \"\"\n1041|        guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n1042|            == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n1043|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1044|                \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost). Refusing cross-server group apply.\"\n1045|            )\n1046|        }\n1047|        let canonical = RunnerCatalogStore.canonical(verified.directory)\n1048|        let current = await catalog.load()\n1049|        guard current.contains(where: { $0.localID == verified.entry.localID && $0.canonicalPath == canonical }) else {\n1050|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1051|                \"Catalog entry changed during group apply. Reload instead of editing another entry's group.\"\n1052|            )\n1053|        }\n1054|    }\n1055|\n1056|    /// Consumes the immutable Load-time editor authority for this runner.\n1057|    /// Returns the verified tuple when the current disk/catalog identity\n1058|    /// still matches the stored server/scope/agent/canonical/localID; when it\n1059|    /// no longer matches, clears the stored editor, publishes an explicit\n1060|    /// invalidation requiring a new Load, and returns nil without throwing.\n1061|    /// A missing entry throws unknownEntry like the verified path.\n1062|    private func consumeStoredEditorAuthority(_ stored: Runners.EditorAuthority, id: String) async throws -> VerifiedOrgRunner? {\n1063|        let entries = await catalog.load()\n1064|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n1065|            throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n1066|        }\n1067|        let directory = RunnerCatalogStore.resolve(entry: entry)\n1068|        let canonical = RunnerCatalogStore.canonical(directory)\n1069|        guard let local = await installer.readLocalRegistration(directory: directory),\n1070|              let agentID = local.agentID,\n1071|              let agentName = local.agentName, !agentName.isEmpty,\n1072|              let address = local.gitHubURL,\n1073|              let url = URL(string: address), url.scheme == \"https\" else {\n1074|            editorAuthorities.removeValue(forKey: entry.serviceLabel)\n1075|            editorInvalidated.insert(entry.serviceLabel)\n1076|            let message = \"Runner identity changed since loading (registration unreadable for '\\(entry.serviceLabel)'). Reload group access before applying.\"\n1077|            await action { Runners.Action.groupAccessInvalidated(id, message) }\n1078|            return nil\n1079|        }\n1080|        let components = url.pathComponents.filter { $0 != \"/\" }\n1081|        let diskHost = url.host ?? \"\"\n1082|        let matches = components.count == 1\n1083|            && components[0] == stored.org\n1084|            && RunnerRegistration.OperationIdentity.normalizeServerHost(diskHost)\n1085|                == RunnerRegistration.OperationIdentity.normalizeServerHost(stored.serverHost)\n1086|            && agentID == stored.agentID\n1087|            && agentName == stored.agentName\n1088|            && canonical == stored.canonicalPath\n1089|            && entry.localID == stored.localID\n1090|        guard matches else {\n1091|            editorAuthorities.removeValue(forKey: entry.serviceLabel)\n1092|            editorInvalidated.insert(entry.serviceLabel)\n1093|            let foundScope = components.count == 1 ? components[0] : (components.joined(separator: \"/\").isEmpty ? \"?\" : components.joined(separator: \"/\"))\n1094|            let message = \"Runner identity changed since loading (expected \\(stored.serverHost)/\\(stored.org)/agent\\(stored.agentID), found \\(diskHost)/\\(foundScope)/agent\\(agentID)). Reload group access before applying.\"\n1095|            await action { Runners.Action.groupAccessInvalidated(id, message) }\n1096|            return nil\n1097|        }\n1098|        return VerifiedOrgRunner(entry: entry, directory: directory, org: stored.org, agentID: stored.agentID, agentName: stored.agentName)\n1099|    }\n1100|\n1101|    /// Applies edited repository access to the runner's fresh group. Rejects\n1102|    /// stale UI (group moved since load), shared groups without explicit\n1103|    /// takeover, and partial confirmations. When a Load established an\n1104|    /// immutable editor authority, Apply consumes that tuple and refuses when\n1105|    /// the current identity no longer matches it — never reconstructing\n1106|    /// authority from the mutable current catalog. A direct Apply without a\n1107|    /// prior Load establishes its own start authority for that single write.\n1108|    /// Preserves the binding plus the starting login incarnation over every\n1109|    /// asynchronous boundary through confirmation and publication. Reuses the\n1110|    /// registration ownership and confirmation gates; API-only, no\n1111|    /// installer lease.\n1112|    private func applyGroupAccess(id: String, groupID: Int64, repos: Set<Int64>, allowTakeover: Bool) async {\n1113|        let gen = catalogGeneration\n1114|        let startedIdentity = await identities.load()\n1115|        await action { Runners.Action.groupAccessLoading(id) }\n1116|        do {\n1117|            if await editorRequiresReload(id: id) {\n1118|                await action { Runners.Action.groupAccessInvalidated(id, \"Runner editor was invalidated (folder moved or identity changed). Reload group access before applying.\") }\n1119|                return\n1120|            }\n1121|            let verified: VerifiedOrgRunner\n1122|            if let stored = await storedEditorAuthority(id: id) {\n1123|                guard let consumed = try await consumeStoredEditorAuthority(stored, id: id) else { return }\n1124|                verified = consumed\n1125|            } else {\n1126|                verified = try await verifiedOrgRunner(id: id)\n1127|            }\n1128|            let auth = try await currentUserToken()\n1129|            if isCatalogStale(gen) { return }\n1130|            guard await sessionStill(startedIdentity) else { return }\n1131|            try await bindApplyIdentity(verified: verified, auth: auth)\n1132|            // Fresh membership re-verified at write time: a move since the\n1133|            // UI loaded fails instead of editing the wrong group.\n1134|            let fresh = try await resolveFreshGroup(\n1135|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n1136|                auth: auth, generation: gen\n1137|            )\n1138|            guard fresh.id == groupID else {\n1139|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1140|                    \"Runner moved from group \\(groupID) to '\\(fresh.name)' (\\(fresh.id)) since loading. Reload instead of editing a stale group.\"\n1141|                )\n1142|            }\n1143|            if isCatalogStale(gen) { return }\n1144|            let owned = await installer.loadOwnedGroupID(\n1145|                serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name\n1146|            )\n1147|            try RunnerRegistration.Gates.authorizeGroupTakeover(\n1148|                groupName: fresh.name, existingID: fresh.id,\n1149|                ownedID: owned, allowTakeover: allowTakeover\n1150|            )\n1151|            if owned != fresh.id {\n1152|                try await installer.saveOwnedGroupID(\n1153|                    serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name, groupID: fresh.id\n1154|                )\n1155|            }\n1156|            if isCatalogStale(gen) { return }\n1157|            // Re-bind at the PUT boundary: the membership and ownership\n1158|            // awaits above must not carry stale identity into the write.\n1159|            guard await sessionStill(startedIdentity) else { return }\n1160|            try await bindApplyIdentity(verified: verified, auth: auth)\n1161|            try await api.setGroupRepositories(\n1162|                config: auth.config, token: auth.token, org: verified.org,\n1163|                groupID: fresh.id, selectedRepositoryIDs: repos\n1164|            )\n1165|            if isCatalogStale(gen) { return }\n1166|            // Completion ownership: the issued PUT cannot be undone, but a\n1167|            // logout, account/server switch, or same-account re-login after\n1168|            // it refuses the confirmation read and any state publication\n1169|            // into the changed session incarnation.\n1170|            guard await sessionStill(startedIdentity) else { return }\n1171|            let confirmed = try await api.fetchGroupRepositories(\n1172|                config: auth.config, token: auth.token, org: verified.org, groupID: fresh.id\n1173|            )\n1174|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: repos, confirmed: confirmed)\n1175|            if isCatalogStale(gen) { return }\n1176|            guard await sessionStill(startedIdentity) else { return }\n1177|            let authority = Runners.EditorAuthority(\n1178|                serverHost: URL(string: (await installer.readLocalRegistration(directory: verified.directory))?.gitHubURL ?? \"\")?.host ?? verified.entry.serverHost ?? auth.identity.serverHost,\n1179|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n1180|                canonicalPath: RunnerCatalogStore.canonical(verified.directory),\n1181|                localID: verified.entry.localID\n1182|            )\n1183|            editorAuthorities[verified.entry.serviceLabel] = authority\n1184|            editorInvalidated.remove(verified.entry.serviceLabel)\n1185|            let access = Runners.GroupAccess(\n1186|                group: fresh, repoIDs: confirmed.sorted(), updatedAt: now(),\n1187|                owned: true, loading: false, authority: authority\n1188|            )\n1189|            await action { Runners.Action.groupAccessLoaded(id, access) }\n1190|            await action { Runners.Action.catalogCleared }\n1191|        } catch is CancellationError {\n1192|            return\n1193|        } catch {\n1194|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n1195|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n1196|                await action { Runners.Action.groupAccessFailed(id, message) }\n1197|            }\n1198|        }\n1199|    }\n1200|\n1201|    /// Looks up the immutable Load-time editor authority for this runner, if\n1202|    /// a Load established one. Keyed by the stable service label.\n1203|    private func storedEditorAuthority(id: String) async -> Runners.EditorAuthority? {\n1204|        let entries = await catalog.load()\n1205|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else { return nil }\n1206|        return editorAuthorities[entry.serviceLabel]\n1207|    }\n1208|\n1209|    /// True when a relocation or identity change invalidated the editor and\n1210|    /// an explicit Load is required before the next Apply.\n1211|    private func editorRequiresReload(id: String) async -> Bool {\n1212|        let entries = await catalog.load()\n1213|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else { return false }\n1214|        return editorInvalidated.contains(entry.serviceLabel)\n1215|    }\n1216|}\n1217|\n1218|/// Import gates. Each gate refuses a concrete invalid class; negative tests\n1219|/// narrow every one of them.\n1220|public enum RunnersCatalogGates {\n1221|    public static func validateImportable(_ candidate: RunnerDiscovery.Candidate) throws {\n1222|        if candidate.controllerKind == .unsupported || candidate.unsupportedReason != nil {\n1223|            throw RunnerError.unsupported(candidate.unsupportedReason ?? \"Unsupported management.\")\n1224|        }\n1225|        if !candidate.registrationReadable {\n1226|            throw RunnerError.message(\"Cannot read .runner registration.\")\n1227|        }\n1228|        if candidate.agentName == nil || candidate.agentName?.isEmpty == true {\n1229|            throw RunnerError.message(\"Registration name is missing.\")\n1230|        }\n1231|        if candidate.serverHost == nil || candidate.scope == nil {\n1232|            throw RunnerError.message(\"Server or scope is undefined.\")\n1233|        }\n1234|        if !candidate.noSpacePath || !candidate.noSpaceWork {\n1235|            throw RunnerError.noSpacePath(\"Path or work folder contains a space; relocation is required.\")\n1236|        }\n1237|        if !candidate.runsvcExists || !candidate.binaryExists {\n1238|            throw RunnerError.message(\"Runner binaries are missing (run.sh / runsvc.sh).\")\n1239|        }\n1240|        if candidate.manifest == nil {\n1241|            // Folder imports without a manifest create a service; every other\n1242|            // check above must already have passed.\n1243|            return\n1244|        }\n1245|        if !candidate.manifestMatches {\n1246|            throw RunnerError.manifestMismatch(\"Service manifest does not match the runner directory.\")\n1247|        }\n1248|        if !candidate.issues.isEmpty {\n1249|            // Issues beyond the manifest notice (folder imports) refuse.\n1250|            let blocking = candidate.issues.filter { !$0.contains(\"No service manifest\") }\n1251|            if !blocking.isEmpty {\n1252|                throw RunnerError.message(blocking.joined(separator: \" \"))\n1253|            }\n1254|        }\n1255|    }\n1256|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
