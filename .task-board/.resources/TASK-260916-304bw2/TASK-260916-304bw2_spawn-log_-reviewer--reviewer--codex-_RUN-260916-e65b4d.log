    }

    /// True when this operation is still the newest one for the editor.
    private func ownsGroupAccess(id: String, operation: Int) -> Bool {
        groupAccessGeneration[id] == operation
    }

    /// Drops the operation ownership for both id spellings of an entry, so
    /// an in-flight Load/Apply can neither publish into nor release the
    /// editor after the entry is removed or relinked.
    private func dropGroupAccessOwnership(serviceLabel: String, localID: String) {
        groupAccessGeneration.removeValue(forKey: serviceLabel)
        groupAccessGeneration.removeValue(forKey: localID)
    }

