    // MARK: - Group-access operation ownership

    /// Takes the next operation number for this editor. Every Load/Apply
    /// calls this before publishing its loading state.
    private func beginGroupAccessOperation(id: String) -> Int {
        let next = (groupAccessGeneration[id] ?? 0) + 1
        groupAccessGeneration[id] = next
