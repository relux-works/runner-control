{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c67b","stream":{"kind":"session","id":"01a0aa0a-86a0-7111-8cdf-bab999a2f9d6"},"sequence":408,"recorded_at":1780531400000811,"record_type":"event","durability":"durable","causation_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","run_stream":{"kind":"run","id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8"},"call_id":"call_01a0aa0b8b237155af3deeab4e45cbba","text":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n(499 line(s) above)\n500|                \"Cannot confirm the service '\\(entry.serviceLabel)' is stopped (no observation). Refusing to unregister while the service state is unconfirmed.\"\n501|            )\n502|        }\n503|        switch observation.status {\n504|        case .stopped:\n505|            return\n506|        case .running:\n507|            throw RunnerRegistration.RegistrationError.invalidDraft(\n508|                \"Stop the runner first; unregister refuses to interrupt a running service.\"\n509|            )\n510|        default:\n511|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n512|                \"Cannot confirm the service '\\(entry.serviceLabel)' is stopped (observed: \\(observation.status.rawValue)). Refusing to unregister while the service state is unconfirmed.\"\n513|            )\n514|        }\n515|    }\n516|\n517|    private func unregisterScope(address: String) -> RunnerRegistration.Scope? {\n518|        guard let url = URL(string: address), url.scheme == \"https\" else { return nil }\n519|        let components = url.pathComponents.filter { $0 != \"/\" }\n520|        if components.count == 1 { return .organization(org: components[0]) }\n521|        if components.count == 2 { return .repository(owner: components[0], name: components[1]) }\n522|        return nil\n523|    }\n524|\n525|    private struct CatalogUserToken: Sendable {\n526|        let config: GitHubAuth.AppConfig\n527|        let token: String\n528|        let identity: GitHubSessionIdentity\n529|    }\n530|\n531|    private func currentUserToken() async throws -> CatalogUserToken {\n532|        guard let identity = await identities.load() else {\n533|            throw RunnerRegistration.RegistrationError.notAuthenticated\n534|        }\n535|        let config = try configProvider(identity.serverHost)\n536|        guard var record = await userStore.load(serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID) else {\n537|            throw RunnerRegistration.RegistrationError.notAuthenticated\n538|        }\n539|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n540|            do {\n541|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n542|            } catch is CancellationError {\n543|                throw CancellationError()\n544|            } catch let error as GitHubAuth.AuthError {\n545|                switch error {\n546|                case .revoked, .unauthorized, .tokenRefreshFailed:\n547|                    throw RunnerRegistration.RegistrationError.unauthorized\n548|                default: break\n549|                }\n550|            }\n551|        }\n552|        return CatalogUserToken(config: config, token: record.accessToken, identity: identity)\n553|    }\n554|\n555|    // MARK: - Remote observation\n556|\n557|    /// Best-effort GitHub sync. Offline, 401/403 and rate limits mark data\n558|    /// stale and never change local power state. Follows full pagination\n559|    /// before matching; matches by server + scope + ID, never by name.\n560|    private func refreshRemote() async {\n561|        let startedIdentity = await identities.load()\n562|        let entries = await catalog.load()\n563|        if entries.isEmpty {\n564|            await action { Runners.Action.remoteSyncFinished(self.now()) }\n565|            return\n566|        }\n567|        let auth: CatalogUserToken\n568|        do {\n569|            auth = try await currentUserToken()\n570|        } catch {\n571|            // Disconnected: local control stays fully available.\n572|            await action { Runners.Action.remoteSyncFailed(error.localizedDescription) }\n573|            return\n574|        }\n575|        // Group definitions by scope so one paginated list serves every\n576|        // runner in that scope.\n577|        var scopes: [String: (scope: RunnerRegistration.Scope, ids: [String])] = [:]\n578|        var definitions: [String: Runners.Definition] = [:]\n579|        for entry in entries {\n580|            let directory = RunnerCatalogStore.resolve(entry: entry)\n581|            let info = RunnerRegistrationReader.read(directory: directory)\n582|            guard let address = info?.gitHubURL ?? entry.serverHost.map({ \"https://\\($0)/\\(entry.scope ?? \"\")\" }),\n583|                  let scope = unregisterScope(address: address) else { continue }\n584|            // Observe only registrations on the authenticated server.\n585|            let host = URL(string: address)?.host ?? entry.serverHost ?? \"\"\n586|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(host)\n587|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else { continue }\n588|            let key = scope.scopeKey\n589|            scopes[key, default: (scope, [])].ids.append(entry.serviceLabel)\n590|            definitions[entry.serviceLabel] = LaunchAgentService.definition(from: entry)\n591|        }\n592|        var failures: [String] = []\n593|        for (_, group) in scopes {\n594|            // A logout or login replacement mid-sync stops silently: no writes\n595|            // into a changed session incarnation.\n596|            guard await sessionStill(startedIdentity) else { return }\n597|            do {\n598|                let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: group.scope)\n599|                for id in group.ids {\n600|                    guard let definition = definitions[id] else { continue }\n601|                    if let observation = GitHubRunnerObserver.match(definition: definition, runners: runners, now: now()) {\n602|                        await action { Runners.Action.remoteUpdated(id, GitHubRunnerObserver.withFreshness(observation, now: self.now())) }\n603|                    } else {\n604|                        await action { Runners.Action.remoteUpdated(id, Runners.RemoteObservation(\n605|                            busyKnown: false, updatedAt: self.now(), stale: false,\n606|                            syncError: \"Identity mismatch\"\n607|                        )) }\n608|                    }\n609|                }\n610|            } catch let error as RunnerRegistration.RegistrationError {\n611|                switch error {\n612|                case .unauthorized:\n613|                    await action { Runners.Action.remoteSyncFailed(RunnerRegistration.RegistrationError.unauthorized.localizedDescription) }\n614|                    return\n615|                case .rateLimited:\n616|                    failures.append(\"Rate limited; will retry.\")\n617|                case .missingPermission(let text):\n618|                    failures.append(text)\n619|                default:\n620|                    failures.append(error.localizedDescription)\n621|                }\n622|            } catch {\n623|                failures.append(error.localizedDescription)\n624|            }\n625|        }\n626|        if failures.isEmpty {\n627|            await action { Runners.Action.remoteSyncFinished(self.now()) }\n628|        } else {\n629|            let joinedFailures = failures.joined(separator: \"; \")\n630|            await action { Runners.Action.remoteSyncFailed(joinedFailures) }\n631|        }\n632|    }\n633|\n634|    // MARK: - Preferences and relink\n635|\n636|    /// Changes only the login-startup policy. Never bootstraps or bootouts;\n637|    /// the policy applies at next login. Refuses while an installer mutation\n638|    /// is live.\n639|    /// Changes only the login-start behavior. Standard manifests edit\n640|    /// their own RunAtLoad. External manual plists gain or lose a matching\n641|    /// registration in `~/Library/LaunchAgents` (RunAtLoad outside\n642|    /// LaunchAgents never persists login start). Never bootstraps or\n643|    /// bootouts: live runner state is preserved. Refuses while an installer\n644|    /// mutation is live, and never touches a foreign same-label plist.\n645|    private func setRunAtLoad(id: String, value: Bool) async {\n646|        if unregisterWorking.contains(id) || working.contains(id) {\n647|            await action { Runners.Action.catalogFailed(\"Runner is busy; retry after it settles.\") }\n648|            return\n649|        }\n650|        let entries = await catalog.load()\n651|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n652|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n653|            return\n654|        }\n655|        if entry.controllerKind == .unsupported {\n656|            await action { Runners.Action.catalogFailed(\"Unsupported runners have no Runner Control login policy.\") }\n657|            return\n658|        }\n659|        do {\n660|            let directory = RunnerCatalogStore.resolve(entry: entry)\n661|            try await installer.requireIdle(for: directory)\n662|            if entry.controllerKind == .standardLaunchAgent {\n663|                let plist = URL(fileURLWithPath: entry.servicePlistPath)\n664|                guard let data = try? Data(contentsOf: plist),\n665|                      var object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {\n666|                    throw RunnerError.message(\"Service manifest is unreadable.\")\n667|                }\n668|                object[\"RunAtLoad\"] = value\n669|                let out = try PropertyListSerialization.data(fromPropertyList: object, format: .xml, options: 0)\n670|                try out.write(to: plist, options: .atomic)\n671|                entry.runAtLoad = value\n672|                try await catalog.update(entry)\n673|            } else {\n674|                try setManualLogin(entry: entry, directory: directory, enabled: value)\n675|            }\n676|            await action { Runners.Action.catalogCleared }\n677|            let snapshots = await service.snapshots()\n678|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n679|            await action { Runners.Action.refreshed(mapped_snapshots) }\n680|        } catch {\n681|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n682|        }\n683|    }\n684|\n685|    /// Enables or disables login start for an external manual service by\n686|    /// managing its `~/Library/LaunchAgents` registration. The external\n687|    /// service file itself is never modified, so the imported policy stays\n688|    /// byte-identical; live launchd state is untouched.\n689|    private func setManualLogin(entry: RunnerCatalogStore.Entry, directory: URL, enabled: Bool) throws {\n690|        let external = URL(fileURLWithPath: entry.servicePlistPath)\n691|        guard let data = try? Data(contentsOf: external),\n692|              let object = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {\n693|            throw RunnerError.message(\"Service manifest is unreadable.\")\n694|        }\n695|        let definition = LaunchAgentService.definition(from: entry)\n696|        let copy = RunnerControllers.loginRegistrationURL(label: entry.serviceLabel, home: home)\n697|        if enabled {\n698|            if let existing = try? Data(contentsOf: copy),\n699|               let current = try? PropertyListSerialization.propertyList(from: existing, format: nil) as? [String: Any] {\n700|                guard RunnerControllers.references(current, definition: definition) else {\n701|                    throw RunnerError.message(\"Login slot '\\(copy.lastPathComponent)' belongs to another service. Remove it by hand instead of overwriting.\")\n702|                }\n703|                var updated = current\n704|                updated[\"RunAtLoad\"] = true\n705|                let out = try PropertyListSerialization.data(fromPropertyList: updated, format: .xml, options: 0)\n706|                try out.write(to: copy, options: .atomic)\n707|                return\n708|            }\n709|            var registration = object\n710|            registration[\"Label\"] = entry.serviceLabel\n711|            registration[\"WorkingDirectory\"] = directory.path\n712|            registration[\"ProgramArguments\"] = [directory.appendingPathComponent(\"runsvc.sh\").path]\n713|            registration[\"RunAtLoad\"] = true\n714|            let out = try PropertyListSerialization.data(fromPropertyList: registration, format: .xml, options: 0)\n715|            try FileManager.default.createDirectory(at: copy.deletingLastPathComponent(), withIntermediateDirectories: true)\n716|            try out.write(to: copy, options: .atomic)\n717|            return\n718|        }\n719|        guard FileManager.default.fileExists(atPath: copy.path) else { return }\n720|        guard let existing = try? Data(contentsOf: copy),\n721|              let current = try? PropertyListSerialization.propertyList(from: existing, format: nil) as? [String: Any],\n722|              RunnerControllers.references(current, definition: definition) else {\n723|            throw RunnerError.message(\"Login slot '\\(copy.lastPathComponent)' belongs to another service. Remove it by hand instead of deleting.\")\n724|        }\n725|        try FileManager.default.removeItem(at: copy)\n726|    }\n727|\n728|    private func setAlias(id: String, alias: String?) async {\n729|        let entries = await catalog.load()\n730|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n731|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n732|            return\n733|        }\n734|        let trimmed = alias?.trimmingCharacters(in: .whitespacesAndNewlines)\n735|        entry.displayName = (trimmed?.isEmpty == true) ? nil : trimmed\n736|        do {\n737|            try await catalog.update(entry)\n738|            await action { Runners.Action.catalogCleared }\n739|            let snapshots = await service.snapshots()\n740|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n741|            await action { Runners.Action.refreshed(mapped_snapshots) }\n742|        } catch {\n743|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n744|        }\n745|    }\n746|\n747|    /// Relinks a moved folder. Requires the new folder to hold the same full\n748|    /// registration identity (server host, scope, agent ID) so a foreign\n749|    /// installation can never steal this entry. Any successful relocation\n750|    /// changes the canonical path and therefore invalidates the loaded group\n751|    /// editor, which must be reloaded explicitly. Updates the service\n752|    /// manifest paths, preserving RunAtLoad.\n753|    private func relink(id: String, url: URL) async {\n754|        if unregisterWorking.contains(id) || working.contains(id) {\n755|            await action { Runners.Action.catalogFailed(\"Runner is busy; retry after it settles.\") }\n756|            return\n757|        }\n758|        let entries = await catalog.load()\n759|        guard var entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n760|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n761|            return\n762|        }\n763|        guard url.path != entry.directoryPath else {\n764|            await action { Runners.Action.catalogCleared }\n765|            return\n766|        }\n767|        if url.path.contains(\" \") {\n768|            await action { Runners.Action.catalogFailed(\"Path contains a space; choose a location without spaces.\") }\n769|            return\n770|        }\n771|        let canonical = RunnerCatalogStore.canonical(url)\n772|        if entries.contains(where: { $0.localID != entry.localID && $0.canonicalPath == canonical }) {\n773|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.duplicateDirectory(path: url.path).localizedDescription) }\n774|            return\n775|        }\n776|        guard let info = RunnerRegistrationReader.read(directory: url) else {\n777|            await action { Runners.Action.catalogFailed(\"Cannot read .runner in the selected folder.\") }\n778|            return\n779|        }\n780|        if let stored = entry.remoteAgentID, info.agentID != stored {\n781|            await action { Runners.Action.catalogFailed(\"Selected folder is agent \\(info.agentID.map(String.init) ?? \"unknown\"), not \\(stored). Refusing to relink a foreign installation.\") }\n782|            return\n783|        }\n784|        if let recordedHost = entry.serverHost, let folderHost = info.serverHost,\n785|           RunnerRegistration.OperationIdentity.normalizeServerHost(recordedHost)\n786|            != RunnerRegistration.OperationIdentity.normalizeServerHost(folderHost) {\n787|            await invalidateEditor(id: id, serviceLabel: entry.serviceLabel, message: \"Selected folder points at '\\(folderHost)', not '\\(recordedHost)'. Reload group access before applying.\")\n788|            await action { Runners.Action.catalogFailed(\"Selected folder points at '\\(folderHost)', not '\\(recordedHost)'. Refusing to relink a foreign installation.\") }\n789|            return\n790|        }\n791|        if let recordedScope = entry.scope, let folderScope = info.scopeDetail, recordedScope != folderScope {\n792|            await invalidateEditor(id: id, serviceLabel: entry.serviceLabel, message: \"Selected folder scope is '\\(folderScope)', not '\\(recordedScope)'. Reload group access before applying.\")\n793|            await action { Runners.Action.catalogFailed(\"Selected folder scope is '\\(folderScope)', not '\\(recordedScope)'. Refusing to relink a foreign installation.\") }\n794|            return\n795|        }\n796|        catalogGeneration += 1\n797|        dropGroupAccessOwnership(serviceLabel: entry.serviceLabel, localID: entry.localID)\n798|        do {\n799|            let plist = URL(fileURLWithPath: entry.servicePlistPath)\n800|            // Manual manifests move with the directory; standard manifests\n801|            // stay in LaunchAgents. Update whichever manifest this entry owns.\n802|            if plist.path.hasPrefix(entry.directoryPath) {\n803|                let moved = url.appendingPathComponent(\"manual-service.plist\")\n804|                if FileManager.default.fileExists(atPath: moved.path) {\n805|                    try await installer.updateServicePaths(plist: moved, directory: url)\n806|                    entry.servicePlistPath = moved.path\n807|                }\n808|            } else {\n809|                try await installer.updateServicePaths(plist: plist, directory: url)\n810|            }\n811|            let oldPath = entry.directoryPath\n812|            entry.directoryPath = url.path\n813|            entry.canonicalPath = canonical\n814|            entry.bookmarkBase64 = RunnerCatalogStore.bookmark(for: url)\n815|            entry.agentName = info.agentName ?? entry.agentName\n816|            entry.serverHost = info.serverHost ?? entry.serverHost\n817|            entry.scope = info.scopeDetail ?? entry.scope\n818|            entry.scopeKind = info.scopeKind ?? entry.scopeKind\n819|            entry.remoteAgentID = info.agentID ?? entry.remoteAgentID\n820|            entry.workFolder = info.workFolder ?? entry.workFolder\n821|            // Keep a managed login registration pointing at the new\n822|            // directory so relink preserves effective login. Foreign\n823|            // same-label plists are never touched.\n824|            if entry.controllerKind == .manualManaged {\n825|                let copy = RunnerControllers.loginRegistrationURL(label: entry.serviceLabel, home: home)\n826|                if let data = try? Data(contentsOf: copy),\n827|                   var current = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],\n828|                   current[\"Label\"] as? String == entry.serviceLabel,\n829|                   current[\"WorkingDirectory\"] as? String == oldPath {\n830|                    try await installer.requireIdle(for: url)\n831|                    current[\"WorkingDirectory\"] = url.path\n832|                    current[\"ProgramArguments\"] = [url.appendingPathComponent(\"runsvc.sh\").path]\n833|                    let out = try PropertyListSerialization.data(fromPropertyList: current, format: .xml, options: 0)\n834|                    try out.write(to: copy, options: .atomic)\n835|                }\n836|            }\n837|            try await catalog.update(entry)\n838|            await action { Runners.Action.catalogCleared }\n839|            await invalidateEditor(id: id, serviceLabel: entry.serviceLabel, message: \"Runner folder moved. Reload group access before applying.\")\n840|            let snapshots = await service.snapshots()\n841|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n842|            await action { Runners.Action.refreshed(mapped_snapshots) }\n843|        } catch {\n844|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n845|        }\n846|    }\n847|\n848|    /// Clears the immutable Load-time editor authority for this runner,\n849|    /// marks it as requiring an explicit Load, and publishes an explicit\n850|    /// invalidation so the UI returns to a Load instead of submitting a\n851|    /// stale group ID. A later Apply without a fresh Load refuses even\n852|    /// when the current disk/catalog happens to match the old values.\n853|    private func invalidateEditor(id: String, serviceLabel: String, message: String) async {\n854|        editorAuthorities.removeValue(forKey: serviceLabel)\n855|        editorInvalidated.insert(serviceLabel)\n856|        await action { Runners.Action.groupAccessInvalidated(id, message) }\n857|    }\n858|\n859|    // MARK: - Diagnostics\n860|\n861|    private func loadLog(id: String) async {\n862|        let snapshots = await service.snapshots()\n863|        guard let snapshot = snapshots.first(where: { $0.id == id }) else {\n864|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n865|            return\n866|        }\n867|        let excerpt = RunnerDiagnostics.tail(definition: snapshot.definition)\n868|        await action { Runners.Action.logLoaded(title: snapshot.definition.displayTitle, excerpt: excerpt) }\n869|    }\n870|\n871|    // MARK: - Group access (fresh API membership)\n872|\n873|    private struct VerifiedOrgRunner: Sendable {\n874|        let entry: RunnerCatalogStore.Entry\n875|        let directory: URL\n876|        let org: String\n877|        let agentID: Int64\n878|        let agentName: String\n879|    }\n880|\n881|    /// Verifies the local `.runner` identity for group reads/writes: agent\n882|    /// ID, name, server and org scope must all be present and bound to the\n883|    /// catalog entry's recorded original. Local pool fields are ignored\n884|    /// (they can lag); the group answer always comes from fresh API\n885|    /// membership below.\n886|    private func verifiedOrgRunner(id: String) async throws -> VerifiedOrgRunner {\n887|        let entries = await catalog.load()\n888|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n889|            throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n890|        }\n891|        let directory = RunnerCatalogStore.resolve(entry: entry)\n892|        guard let local = await installer.readLocalRegistration(directory: directory),\n893|              let agentID = local.agentID,\n894|              let agentName = local.agentName, !agentName.isEmpty,\n895|              let address = local.gitHubURL,\n896|              let url = URL(string: address), url.scheme == \"https\" else {\n897|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n898|                \"No verified local registration for '\\(entry.serviceLabel)'. Refusing group access for another runner.\"\n899|            )\n900|        }\n901|        let components = url.pathComponents.filter { $0 != \"/\" }\n902|        guard components.count == 1 else {\n903|            throw RunnerRegistration.RegistrationError.groupNotApplicable\n904|        }\n905|        if let stored = entry.remoteAgentID, stored != agentID {\n906|            throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n907|                \"Catalog expects agent \\(stored) but disk shows agent \\(agentID). Refusing group access for a mismatched registration.\"\n908|            )\n909|        }\n910|        // Catalog-original binding: the mutable on-disk registration must\n911|        // still agree with the server and scope recorded at import (or\n912|        // explicit relink). A scope or server edit on disk — without\n913|        // re-verification — refuses here instead of silently retargeting\n914|        // another org's group. Load and Apply both verify here, so neither\n915|        // path can drift off the catalog original between Load and Apply.\n916|        // Entries without a recorded server/scope predate this binding and\n917|        // fall through to the disk-vs-session checks below.\n918|        let diskHost = url.host ?? \"\"\n919|        if let storedHost = entry.serverHost,\n920|           RunnerRegistration.OperationIdentity.normalizeServerHost(storedHost)\n921|               != RunnerRegistration.OperationIdentity.normalizeServerHost(diskHost) {\n922|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n923|                \"Local registration server changed from '\\(storedHost)' to '\\(diskHost)' since import. Re-add the runner (or relink its moved folder) to re-verify instead of editing with stale identity.\"\n924|            )\n925|        }\n926|        if let storedScope = entry.scope, storedScope != components[0] {\n927|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n928|                \"Local registration scope changed from '\\(storedScope)' to '\\(components[0])' since import. Re-add the runner (or relink its moved folder) to re-verify instead of editing with stale identity.\"\n929|            )\n930|        }\n931|        return VerifiedOrgRunner(entry: entry, directory: directory, org: components[0], agentID: agentID, agentName: agentName)\n932|    }\n933|\n934|    /// Resolves the runner's current GitHub group by fresh API membership:\n935|    /// lists every group, then each group's runners, matching by agent ID\n936|    /// (and exact name on the matched ID). Never reads `.runner` pool\n937|    /// fields and never adopts a same-name foreign runner or group.\n938|    private func resolveFreshGroup(\n939|        org: String, agentID: Int64, agentName: String,\n940|        auth: CatalogUserToken, generation gen: Int\n941|    ) async throws -> RunnerRegistration.RunnerGroup {\n942|        let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n943|        for group in groups {\n944|            if isCatalogStale(gen) { throw CancellationError() }\n945|            let members = try await api.fetchGroupRunners(config: auth.config, token: auth.token, org: org, groupID: group.id)\n946|            if let exact = members.first(where: { $0.id == agentID }) {\n947|                guard exact.name == agentName else {\n948|                    throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n949|                        \"Group '\\(group.name)' lists agent \\(agentID) as '\\(exact.name)', not '\\(agentName)'. Refusing a mismatched group.\"\n950|                    )\n951|                }\n952|                return group\n953|            }\n954|            // A same-name foreign member in this group is ignored: only the\n955|            // exact agent ID binds membership.\n956|        }\n957|        throw RunnerRegistration.RegistrationError.remoteRunnerNotFound(\n958|            \"Agent \\(agentID) is not in any visible group for '\\(org)'. It may have been moved or the App lacks group access.\"\n959|        )\n960|    }\n961|\n962|    /// Loads fresh group + repository access for one org runner. Display and\n963|    /// later edits use this API answer, never stale `.runner` pool fields.\n964|    private func loadGroupAccess(id: String) async {\n965|        let gen = catalogGeneration\n966|        let startedIdentity = await identities.load()\n967|        let operation = beginGroupAccessOperation(id: id)\n968|        await action { Runners.Action.groupAccessLoading(id) }\n969|        do {\n970|            let verified = try await verifiedOrgRunner(id: id)\n971|            let auth = try await currentUserToken()\n972|            if isCatalogStale(gen) {\n973|                await abandonGroupAccessAfterCatalogChange(id: id, operation: operation)\n974|                return\n975|            }\n976|            guard await sessionStill(startedIdentity) else {\n977|                await releaseGroupAccessAfterSessionChange(id: id, operation: operation)\n978|                return\n979|            }\n980|            let verifiedHost = URL(string: (await installer.readLocalRegistration(directory: verified.directory))?.gitHubURL ?? \"\")?.host ?? \"\"\n981|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n982|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n983|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n984|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost).\"\n985|                )\n986|            }\n987|            let group = try await resolveFreshGroup(\n988|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n989|                auth: auth, generation: gen\n990|            )\n991|            if isCatalogStale(gen) {\n992|                await abandonGroupAccessAfterCatalogChange(id: id, operation: operation)\n993|                return\n994|            }\n995|            // Completion ownership: a logout, account/server switch, or\n996|            // same-account re-login during the membership reads refuses\n997|            // further authenticated work and any state publication into the\n998|            // changed session incarnation — but still releases this\n999|            // operation's busy state so the editor can be retried.\n1000|            guard await sessionStill(startedIdentity) else {\n1001|                await releaseGroupAccessAfterSessionChange(id: id, operation: operation)\n1002|                return\n1003|            }\n1004|            let repoIDs = try await api.fetchGroupRepositories(\n1005|                config: auth.config, token: auth.token, org: verified.org, groupID: group.id\n1006|            )\n1007|            if isCatalogStale(gen) {\n1008|                await abandonGroupAccessAfterCatalogChange(id: id, operation: operation)\n1009|                return\n1010|            }\n1011|            guard await sessionStill(startedIdentity) else {\n1012|                await releaseGroupAccessAfterSessionChange(id: id, operation: operation)\n1013|                return\n1014|            }\n1015|            let owned = await installer.loadOwnedGroupID(\n1016|                serverHost: auth.identity.serverHost, org: verified.org, name: group.name\n1017|            ) == group.id\n1018|            // A newer Load/Apply on this runner owns the editor now; this\n1019|            // completion stores and publishes nothing, not even cleanup.\n1020|            guard ownsGroupAccess(id: id, operation: operation) else { return }\n1021|            let authority = Runners.EditorAuthority(\n1022|                serverHost: verifiedHost, org: verified.org,\n1023|                agentID: verified.agentID, agentName: verified.agentName,\n1024|                canonicalPath: RunnerCatalogStore.canonical(verified.directory),\n1025|                localID: verified.entry.localID\n1026|            )\n1027|            editorAuthorities[verified.entry.serviceLabel] = authority\n1028|            editorInvalidated.remove(verified.entry.serviceLabel)\n1029|            let access = Runners.GroupAccess(\n1030|                group: group, repoIDs: repoIDs.sorted(), updatedAt: now(),\n1031|                owned: owned, loading: false, authority: authority\n1032|            )\n1033|            await publishGroupAccessIfCurrent(id: id, operation: operation) {\n1034|                Runners.Action.groupAccessLoaded(id, access)\n1035|            }\n1036|        } catch is CancellationError {\n1037|            await abandonGroupAccessAfterCatalogChange(id: id, operation: operation)\n1038|        } catch {\n1039|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n1040|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n1041|                await publishGroupAccessIfCurrent(id: id, operation: operation) {\n1042|                    Runners.Action.groupAccessFailed(id, message)\n1043|                }\n1044|            } else if !isCatalogStale(gen) {\n1045|                await releaseGroupAccessAfterSessionChange(id: id, operation: operation)\n1046|            } else {\n1047|                await abandonGroupAccessAfterCatalogChange(id: id, operation: operation)\n1048|            }\n1049|        }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
