{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca09","stream":{"kind":"session","id":"01a0aa0a-86a0-7111-8cdf-bab999a2f9d6"},"sequence":863,"recorded_at":1780531400001721,"record_type":"event","durability":"durable","causation_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","run_stream":{"kind":"run","id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8"},"task_stream":{"kind":"task","id":"01a0aa0d-6bac-7fc3-b20d-f082edee0b4b"},"task_id":"01a0aa0d-6bac-7fc3-b20d-f082edee0b4b","event":{"kind":"output","task_id":"01a0aa0d-6bac-7fc3-b20d-f082edee0b4b","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n(1309 line(s) above)\n1310|        }\n1311|    }\n1312|\n1313|    // MARK: - Group-access operation ownership\n1314|\n1315|    /// Takes the next operation number for this editor. Every Load/Apply\n1316|    /// calls this before publishing its loading state.\n1317|    private func beginGroupAccessOperation(id: String) -> Int {\n1318|        let next = (groupAccessGeneration[id] ?? 0) + 1\n1319|        groupAccessGeneration[id] = next\n1320|        return next\n1321|    }\n1322|\n1323|    /// True when this operation is still the newest one for the editor.\n1324|    private func ownsGroupAccess(id: String, operation: Int) -> Bool {\n1325|        groupAccessGeneration[id] == operation\n1326|    }\n1327|\n1328|    /// Drops the operation ownership for both id spellings of an entry, so\n1329|    /// an in-flight Load/Apply can neither publish into nor release the\n1330|    /// editor after the entry is removed or relinked.\n1331|    private func dropGroupAccessOwnership(serviceLabel: String, localID: String) {\n1332|        groupAccessGeneration.removeValue(forKey: serviceLabel)\n1333|        groupAccessGeneration.removeValue(forKey: localID)\n1334|    }\n1335|\n1336|    /// Publishes only when this operation still owns the editor. A stale\n1337|    /// completion — superseded by a newer Load/Apply on the same runner —\n1338|    /// publishes nothing: no cleared busy state, no stale data.\n1339|    private func publishGroupAccessIfCurrent(\n1340|        id: String, operation: Int, makeAction: @Sendable () -> Runners.Action\n1341|    ) async {\n1342|        guard ownsGroupAccess(id: id, operation: operation) else { return }\n1343|        await action { makeAction() }\n1344|    }\n1345|\n1346|    /// Releases the busy state after a session invalidation, but only when\n1347|    /// this operation still owns the editor. Publishes an explicit retry\n1348|    /// message instead of stale data, so the UI returns to Load/refresh\n1349|    /// instead of wedging on a spinner.\n1350|    private func releaseGroupAccessAfterSessionChange(id: String, operation: Int) async {\n1351|        guard ownsGroupAccess(id: id, operation: operation) else { return }\n1352|        await action {\n1353|            Runners.Action.groupAccessFailed(\n1354|                id,\n1355|                \"GitHub session changed during group access. Reload group access to retry in the current session.\"\n1356|            )\n1357|        }\n1358|    }\n1359|\n1360|    /// Releases the busy state after the catalog changed under this\n1361|    /// operation, but only when this operation still owns the editor and the\n1362|    /// entry still exists. A removed entry needs no publication: its removal\n1363|    /// already pruned the editor state. A relinked entry was already\n1364|    /// released by its explicit invalidation.\n1365|    private func abandonGroupAccessAfterCatalogChange(id: String, operation: Int) async {\n1366|        guard ownsGroupAccess(id: id, operation: operation) else { return }\n1367|        let entries = await catalog.load()\n1368|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else { return }\n1369|        guard !editorInvalidated.contains(entry.serviceLabel) else { return }\n1370|        await action {\n1371|            Runners.Action.groupAccessFailed(\n1372|                id,\n1373|                \"Runner catalog changed during group access. Reload group access to retry.\"\n1374|            )\n1375|        }\n1376|    }\n1377|\n1378|    /// Looks up the immutable Load-time editor authority for this runner, if\n1379|    /// a Load established one. Keyed by the stable service label.\n(more lines below)","final_result":true}}}
