{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c64d","stream":{"kind":"session","id":"01a0aa0a-86a0-7111-8cdf-bab999a2f9d6"},"sequence":385,"recorded_at":1780531400000765,"record_type":"event","durability":"durable","causation_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","run_stream":{"kind":"run","id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8"},"task_stream":{"kind":"task","id":"01a0aa0b-8691-7e82-9a43-d7fed17ee66e"},"task_id":"01a0aa0b-8691-7e82-9a43-d7fed17ee66e","event":{"kind":"output","task_id":"01a0aa0b-8691-7e82-9a43-d7fed17ee66e","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n1|import Foundation\n2|import Relux\n3|extension Runners {\n4|    public protocol IFlow: Relux.Flow {}\n5|    public actor Flow {\n6|        public let dispatcher: Relux.Dispatcher\n7|        private let service: any RunnerServicing\n8|        private let catalog: RunnerCatalogStore\n9|        private let installer: RunnerInstallerService\n10|        private let api: GitHubRunnerAPIClient\n11|        private let userStore: any GitHubCredentialStoring\n12|        private let identities: any GitHubSessionIdentityStoring\n13|        private let refresher: GitHubTokenRefresh\n14|        private let configProvider: @Sendable (String?) throws -> GitHubAuth.AppConfig\n15|        private let now: @Sendable () -> Date\n16|        private let home: URL\n17|        private var working: Set<String> = []\n18|        private var refreshing = false\n19|        private var revision = 0\n20|        private var pendingOp: [String: OperationPhase] = [:]\n21|        private var unregisterWorking: Set<String> = []\n22|        private var catalogGeneration = 0\n23|        private var editorAuthorities: [String: Runners.EditorAuthority] = [:]\n24|        private var editorInvalidated: Set<String> = []\n25|        /// Per-editor group-access operation generation. Every Load/Apply\n26|        /// takes the next number; only the newest operation may publish into\n27|        /// the shared editor state or release its busy flag. Keyed by the\n28|        /// same id spelling the actions use, so the owner check lines up\n29|        /// with the reducer key.\n30|        private var groupAccessGeneration: [String: Int] = [:]\n31|        public init(service: any RunnerServicing, dispatcher: Relux.Dispatcher? = nil) async {\n32|            self.service = service\n33|            self.catalog = RunnerCatalogStore()\n34|            self.installer = RunnerInstallerService()\n35|            let transport = URLSessionGitHubTransport()\n36|            let store: any GitHubCredentialStoring = GitHubKeychainStore()\n37|            self.api = GitHubRunnerAPIClient(transport: transport)\n38|            self.userStore = store\n39|            self.identities = UserDefaultsGitHubSessionIdentityStore()\n40|            self.refresher = GitHubTokenRefresh(transport: transport, store: store)\n41|            self.configProvider = { host in try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\") }\n42|            self.now = Date.init\n43|            self.home = FileManager.default.homeDirectoryForCurrentUser\n44|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n45|        }\n46|        /// Testable init with explicit catalog, installer and auth dependencies.\n47|        /// Production passes the shared installer so unregister/recovery and\n48|        /// registration cannot overlap.\n49|        public init(\n50|            service: any RunnerServicing,\n51|            catalog: RunnerCatalogStore,\n52|            installer: RunnerInstallerService,\n53|            api: GitHubRunnerAPIClient,\n54|            userStore: any GitHubCredentialStoring,\n55|            identities: any GitHubSessionIdentityStoring,\n56|            refresher: GitHubTokenRefresh,\n57|            configProvider: (@Sendable (String?) throws -> GitHubAuth.AppConfig)? = nil,\n58|            now: (@Sendable () -> Date)? = nil,\n59|            home: URL? = nil,\n60|            dispatcher: Relux.Dispatcher? = nil\n61|        ) async {\n62|            self.service = service\n63|            self.catalog = catalog\n64|            self.installer = installer\n65|            self.api = api\n66|            self.userStore = userStore\n67|            self.identities = identities\n68|            self.refresher = refresher\n69|            self.configProvider = configProvider ?? { host in try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\") }\n70|            self.now = now ?? Date.init\n71|            self.home = home ?? FileManager.default.homeDirectoryForCurrentUser\n72|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n73|        }\n74|    }\n75|}\n76|extension Runners.Flow: Runners.IFlow {\n77|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n78|        guard let effect = effect as? Runners.Effect else { return .success }\n79|        switch effect {\n80|        case .refresh: await refresh()\n81|        case .setEnabled(let id, let enabled): await setEnabled(id: id, enabled: enabled)\n82|        case .setEnabledMany(let ids, let enabled): await setEnabledMany(ids: ids, enabled: enabled)\n83|        case .loadCatalog: await loadCatalog()\n84|        case .discover: await discover()\n85|        case .importCandidate(let candidate): await importCandidate(candidate)\n86|        case .importFolder(let url): await importFolder(url)\n87|        case .removeFromApp(let id): await removeFromApp(id: id)\n88|        case .unregister(let id, let confirmation): await unregister(id: id, confirmation: confirmation)\n89|        case .refreshRemote: await refreshRemote()\n90|        case .setRunAtLoad(let id, let value): await setRunAtLoad(id: id, value: value)\n91|        case .setAlias(let id, let alias): await setAlias(id: id, alias: alias)\n92|        case .relinkDirectory(let id, let url): await relink(id: id, url: url)\n93|        case .selectRunner(let id): await action { Runners.Action.selected(id) }\n94|        case .loadLog(let id): await loadLog(id: id)\n95|        case .clearLog: await action { Runners.Action.logCleared }\n96|        case .loadGroupAccess(let id): await loadGroupAccess(id: id)\n97|        case .applyGroupAccess(let id, let groupID, let repos, let allowTakeover):\n98|            await applyGroupAccess(id: id, groupID: groupID, repos: repos, allowTakeover: allowTakeover)\n99|        }\n100|        return .success\n101|    }\n102|\n103|    private func isCatalogStale(_ gen: Int) -> Bool { catalogGeneration != gen }\n104|\n105|    // MARK: - Local refresh and power\n106|\n107|    private func refresh() async {\n108|        guard !refreshing, working.isEmpty else { return }\n109|        refreshing = true\n110|        let startedAt = revision\n111|        let snapshots = await service.snapshots()\n112|        // Do not publish a stale read if a command started during this await.\n113|        if working.isEmpty && revision == startedAt {\n114|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n115|            await action { Runners.Action.refreshed(mapped_snapshots) }\n116|        }\n117|        refreshing = false\n118|    }\n119|\n120|    private func withPendingOp(_ snapshots: [Runners.Snapshot]) -> [Runners.Snapshot] {\n121|        Self.applyPending(snapshots, pending: pendingOp)\n122|    }\n123|\n124|    private nonisolated static func applyPending(_ snapshots: [Runners.Snapshot], pending: [String: Runners.OperationPhase]) -> [Runners.Snapshot] {\n125|        snapshots.map { snapshot in\n126|            var next = snapshot\n127|            next.operation = pending[snapshot.id] ?? .idle\n128|            // Reflect the operation in the local status so the row shows\n129|            // starting/stopping instead of jumping ahead to running/stopped.\n130|            if next.operation == .starting, next.status == .stopped || next.status == .failed {\n131|                next.status = .starting\n132|            } else if next.operation == .stopping, next.status == .running {\n133|                next.status = .stopping\n134|            }\n135|            return next\n136|        }\n137|    }\n138|\n139|    private func setEnabled(id: String, enabled: Bool) async {\n140|        guard !working.contains(id), !unregisterWorking.contains(id) else { return }\n141|        working.insert(id)\n142|        revision += 1\n143|        pendingOp[id] = enabled ? .starting : .stopping\n144|        await action { Runners.Action.changing(id, true) }\n145|        do { try await service.setEnabled(enabled, id: id) }\n146|        catch { await action { Runners.Action.failed(error.localizedDescription) } }\n147|        pendingOp.removeValue(forKey: id)\n148|        let snapshots = await service.snapshots()\n149|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n150|        await action { Runners.Action.refreshed(mapped_snapshots) }\n151|        working.remove(id)\n152|        await action { Runners.Action.changing(id, false) }\n153|    }\n154|\n155|    /// Bulk power with per-row errors. Every row is attempted; failures are\n156|    /// reported per row in the refreshed snapshots plus one summary failure.\n157|    /// A single-row error never blocks the rest of the list.\n158|    private func setEnabledMany(ids: [String], enabled: Bool) async {\n159|        let targets = ids.filter { !working.contains($0) && !unregisterWorking.contains($0) }\n160|        guard !targets.isEmpty else { return }\n161|        for id in targets {\n162|            working.insert(id)\n163|            pendingOp[id] = enabled ? .starting : .stopping\n164|            await action { Runners.Action.changing(id, true) }\n165|        }\n166|        revision += 1\n167|        var failures: [(String, String)] = []\n168|        for id in targets {\n169|            do { try await service.setEnabled(enabled, id: id) }\n170|            catch { failures.append((id, error.localizedDescription)) }\n171|        }\n172|        for id in targets { pendingOp.removeValue(forKey: id) }\n173|        var snapshots = await service.snapshots()\n174|        if !failures.isEmpty {\n175|            let table = Dictionary(uniqueKeysWithValues: failures)\n176|            snapshots = snapshots.map { snapshot in\n177|                var next = snapshot\n178|                if let message = table[snapshot.id] {\n179|                    next.message = message\n180|                }\n181|                return next\n182|            }\n183|            let summary = failures.map { id, message in \"\\(id): \\(message)\" }.joined(separator: \"; \")\n184|            let failureCount = failures.count\n185|            let targetCount = targets.count\n186|            let bulkMessage = \"Partial failure (\\(failureCount) of \\(targetCount)): \\(summary)\"\n187|            await action { Runners.Action.failed(bulkMessage) }\n188|        }\n189|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n190|        await action { Runners.Action.refreshed(mapped_snapshots) }\n191|        for id in targets {\n192|            working.remove(id)\n193|            await action { Runners.Action.changing(id, false) }\n194|        }\n195|    }\n196|\n197|    // MARK: - Catalog\n198|\n199|    /// One-time migration plus refresh. Never starts or stops CI and never\n200|    /// modifies services; discovery only reads.\n201|    private func loadCatalog() async {\n202|        do {\n203|            _ = try await catalog.migrateIfNeeded()\n204|            await action { Runners.Action.catalogCleared }\n205|        } catch {\n206|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n207|        }\n208|        let snapshots = await service.snapshots()\n209|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n210|        await action { Runners.Action.refreshed(mapped_snapshots) }\n211|    }\n212|\n213|    private func discover() async {\n214|        let entries = await catalog.load()\n215|        let known = Set(entries.map(\\.canonicalPath))\n216|        let extra = entries.map { RunnerCatalogStore.resolve(entry: $0) }\n217|        let candidates = RunnerDiscovery.discoverCandidates(knownCanonicals: known, extraDirectories: extra)\n218|            .filter { candidate in\n219|                let canonical = RunnerCatalogStore.canonical(candidate.directory)\n220|                return !known.contains(canonical)\n221|            }\n222|        await action { Runners.Action.candidatesLoaded(candidates) }\n223|    }\n224|\n225|    private func importCandidate(_ candidate: RunnerDiscovery.Candidate) async {\n226|        let gen = catalogGeneration\n227|        // Refuse mutations for an entry already under unregister.\n228|        if let label = candidate.label, unregisterWorking.contains(label) {\n229|            await action { Runners.Action.catalogFailed(RunnerRegistration.RegistrationError.installerBusy(path: candidate.directory.path).localizedDescription) }\n230|            return\n231|        }\n232|        do {\n233|            try RunnersCatalogGates.validateImportable(candidate)\n234|            let canonical = RunnerCatalogStore.canonical(candidate.directory)\n235|            let entries = await catalog.load()\n236|            if entries.contains(where: { $0.canonicalPath == canonical }) {\n237|                throw RunnerCatalogStore.CatalogError.duplicateDirectory(path: candidate.directory.path)\n238|            }\n239|            guard !isCatalogStale(gen) else { return }\n240|            let label: String\n241|            let plist: URL\n242|            let kind = candidate.controllerKind\n243|            if let manifest = candidate.manifest, let existing = candidate.label {\n244|                // Import without changing the existing service: never\n245|                // re-registers and never flips the preserved RunAtLoad policy.\n246|                // A manifest label already owned by another entry refuses:\n247|                // two entries must never share one control identity.\n248|                if entries.contains(where: { $0.serviceLabel == existing }) {\n249|                    throw RunnerCatalogStore.CatalogError.duplicateLabel(label: existing)\n250|                }\n251|                label = existing\n252|                plist = manifest\n253|            } else {\n254|                // No manifest: create a manual service (RunAtLoad off for new\n255|                // runners). Never bootstraps; enabling is a separate action.\n256|                // The label binds agent name plus canonical path, so two\n257|                // same-name folders never share one control identity.\n258|                label = RunnerCatalogStore.importedServiceLabel(\n259|                    agentName: candidate.agentName, directory: candidate.directory\n260|                )\n261|                if entries.contains(where: { $0.serviceLabel == label }) {\n262|                    throw RunnerCatalogStore.CatalogError.duplicateLabel(label: label)\n263|                }\n264|                plist = try await installer.setupService(directory: candidate.directory, label: label)\n265|            }\n266|            guard !isCatalogStale(gen) else { return }\n267|            let info = RunnerRegistrationReader.read(directory: candidate.directory)\n268|            let entry = RunnerCatalogStore.Entry(\n269|                directoryPath: candidate.directory.path,\n270|                canonicalPath: canonical,\n271|                bookmarkBase64: RunnerCatalogStore.bookmark(for: candidate.directory),\n272|                serviceLabel: label,\n273|                servicePlistPath: plist.path,\n274|                controllerKind: kind,\n275|                runAtLoad: candidate.runAtLoad,\n276|                serverHost: info?.serverHost ?? candidate.serverHost,\n277|                scopeKind: info?.scopeKind,\n278|                scope: info?.scopeDetail ?? candidate.scope,\n279|                remoteAgentID: info?.agentID ?? candidate.agentID,\n280|                agentName: info?.agentName ?? candidate.agentName,\n281|                workFolder: info?.workFolder ?? candidate.workFolder\n282|            )\n283|            try await catalog.add(entry)\n284|            await action { Runners.Action.catalogCleared }\n285|            let snapshots = await service.snapshots()\n286|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n287|            await action { Runners.Action.refreshed(mapped_snapshots) }\n288|            await discover()\n289|        } catch {\n290|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n291|        }\n292|    }\n293|\n294|    private func importFolder(_ url: URL) async {\n295|        var isDir: ObjCBool = false\n296|        guard FileManager.default.fileExists(atPath: url.path, isDirectory: &isDir), isDir.boolValue else {\n297|            await action { Runners.Action.catalogFailed(\"Selected folder does not exist.\") }\n298|            return\n299|        }\n300|        let candidate = RunnerDiscovery.validateFolder(url)\n301|        if candidate.needsRelocation {\n302|            await action { Runners.Action.catalogFailed(\"Path contains a space; choose a location without spaces. Running runners are never moved automatically.\") }\n303|            return\n304|        }\n305|        await importCandidate(candidate)\n306|    }\n307|\n308|    /// Removes only the catalog record. Deletes no files, no GitHub\n309|    /// registration and no certificates, and never stops a running service.\n310|    /// Warns when the service keeps running.\n311|    private func removeFromApp(id: String) async {\n312|        if unregisterWorking.contains(id) {\n313|            await action { Runners.Action.catalogFailed(\"Runner is unregistering; retry after it settles.\") }\n314|            return\n315|        }\n316|        let entries = await catalog.load()\n317|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n318|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n319|            return\n320|        }\n321|        catalogGeneration += 1\n322|        editorAuthorities.removeValue(forKey: entry.serviceLabel)\n323|        editorInvalidated.remove(entry.serviceLabel)\n324|        dropGroupAccessOwnership(serviceLabel: entry.serviceLabel, localID: entry.localID)\n325|        let snapshots = await service.snapshots()\n326|        let wasRunning = snapshots.first(where: { $0.id == entry.serviceLabel })?.status == .running\n327|        do {\n328|            _ = try await catalog.remove(localID: entry.localID)\n329|        } catch {\n330|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n331|            return\n332|        }\n333|        let refreshed = await service.snapshots()\n334|        let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n335|        await action { Runners.Action.refreshed(mapped_refreshed) }\n336|        if wasRunning {\n337|            await action { Runners.Action.catalogFailed(\"Removed «\\(entry.agentName ?? entry.serviceLabel)» from the app. Its service keeps running.\") }\n338|        } else {\n339|            await action { Runners.Action.catalogCleared }\n340|        }\n341|        await discover()\n342|    }\n343|\n344|    // MARK: - Unregister (explicit remote removal)\n345|\n346|    /// Explicit remote unregister, distinct from catalog removal and file\n347|    /// deletion. Binds the local verified `.runner` server/scope/agentId and\n348|    /// the service path, never a remote name alone. Stopped-only: requires a\n349|    /// positive confirmed `.stopped` observation (unknown or missing state\n350|    /// refuses) both before minting the remove token and at the `config.sh\n351|    /// remove` boundary, plus a typed confirmation matching the agent name.\n352|    /// Bound to the session it started with: a logout, account or server\n353|    /// switch invalidates unstarted side effects instead of unregistering\n354|    /// under stale authority. Holds the shared installer lease across\n355|    /// `config.sh remove` so no registration, install, recovery or second\n356|    /// unregister can overlap. Files and the service manifest stay for\n357|    /// re-registration.\n358|    private func unregister(id: String, confirmation: String) async {\n359|        guard !unregisterWorking.contains(id), !working.contains(id) else { return }\n360|        unregisterWorking.insert(id)\n361|        await action { Runners.Action.unregistering(id, true) }\n362|        await runUnregister(id: id, confirmation: confirmation)\n363|        unregisterWorking.remove(id)\n364|        await action { Runners.Action.unregistering(id, false) }\n365|    }\n366|\n367|    /// Unregister body with guaranteed operation-state release: every early\n368|    /// return below still runs the caller's epilogue, so a refused or\n369|    /// session-invalidated attempt never wedges the UI \"unregistering\"\n370|    /// state and a retry stays possible.\n371|    private func runUnregister(id: String, confirmation: String) async {\n372|        let gen = catalogGeneration\n373|        // Session ownership: the initiating session is captured once and\n374|        // re-checked at every asynchronous boundary below.\n375|        let startedIdentity = await identities.load()\n376|        do {\n377|            let entries = await catalog.load()\n378|            guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n379|                throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n380|            }\n381|            let directory = RunnerCatalogStore.resolve(entry: entry)\n382|            // Mutation authority: local verified identity plus the service\n383|            // path. A remote name match alone never authorizes removal.\n384|            guard let local = await installer.readLocalRegistration(directory: directory),\n385|                  let agentID = local.agentID,\n386|                  let agentName = local.agentName, !agentName.isEmpty,\n387|                  let address = local.gitHubURL,\n388|                  let scope = unregisterScope(address: address) else {\n389|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n390|                    \"No verified local registration for '\\(entry.serviceLabel)'. Refusing to unregister another runner by name.\"\n391|                )\n392|            }\n393|            // Service-path binding: the catalog entry must still point at the\n394|            // verified directory; a relink mid-flight invalidates the evidence.\n395|            let canonical = RunnerCatalogStore.canonical(directory)\n396|            guard canonical == entry.canonicalPath else {\n397|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n398|                    \"Service path changed during unregister. Re-verify instead of removing another directory's registration.\"\n399|                )\n400|            }\n401|            // Agent-ID binding: a stored ID that disagrees with disk fails\n402|            // closed instead of removing a foreign registration.\n403|            if let stored = entry.remoteAgentID, stored != agentID {\n404|                throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n405|                    \"Catalog expects agent \\(stored) but disk shows agent \\(agentID) for '\\(agentName)'. Refusing to unregister a mismatched registration.\"\n406|                )\n407|            }\n408|            guard confirmation == agentName else {\n409|                throw RunnerRegistration.RegistrationError.confirmationMismatch(\n410|                    \"Type '\\(agentName)' to confirm unregister of agent \\(agentID) in \\(scope.detail).\"\n411|                )\n412|            }\n413|            guard !isCatalogStale(gen) else { return }\n414|            // Stopped-only gate: a positive confirmed `.stopped` observation\n415|            // is required before minting the remove token, so unregister\n416|            // cannot interrupt a job — or a service whose state is unknown.\n417|            try await requireConfirmedStopped(entry: entry)\n418|            guard !isCatalogStale(gen) else { return }\n419|            let auth = try await currentUserToken()\n420|            guard !isCatalogStale(gen) else { return }\n421|            // Server binding: the verified host must equal the authenticated\n422|            // server; a same-path foreign host never authorizes removal here.\n423|            let verifiedHost = URL(string: address)?.host ?? \"\"\n424|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n425|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n426|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n427|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost). Refusing cross-server unregister.\"\n428|                )\n429|            }\n430|            let created = try await api.createRemoveToken(config: auth.config, token: auth.token, scope: scope)\n431|            guard !isCatalogStale(gen) else { return }\n432|            // A logout, account or server switch during token acquisition\n433|            // invalidates the unstarted side effect; the minted token\n434|            // simply expires unused.\n435|            guard await sessionStill(startedIdentity) else { return }\n436|            // Re-verify after the network: scope/path edits invalidate stale\n437|            // evidence instead of removing a re-targeted registration.\n438|            guard let reread = await installer.readLocalRegistration(directory: directory),\n439|                  reread.agentID == agentID, reread.agentName == agentName,\n440|                  reread.gitHubURL == address else {\n441|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n442|                    \"Local registration changed during unregister. Re-verify instead of removing a re-targeted registration.\"\n443|                )\n444|            }\n445|            let currentEntries = await catalog.load()\n446|            guard currentEntries.contains(where: { $0.localID == entry.localID && $0.canonicalPath == canonical }) else {\n447|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n448|                    \"Catalog entry changed during unregister. Re-verify instead of removing another entry.\"\n449|                )\n450|            }\n451|            // Revalidate the stopped evidence at the side-effect boundary: a\n452|            // service started (or lost to inspection) after the token mint\n453|            // must not be unregistered.\n454|            guard !isCatalogStale(gen) else { return }\n455|            guard await sessionStill(startedIdentity) else { return }\n456|            try await requireConfirmedStopped(entry: entry)\n457|            // Final boundary: the inspection above awaits production\n458|            // launchctl, so a logout, account/server switch, or same-account\n459|            // re-login can finish during it. Re-check the initiating-session\n460|            // authority after the inspection, and enforce the same authority\n461|            // again inside the installer before `config.sh remove` begins, so\n462|            // no invalidation between the two checks can start the removal.\n463|            guard !isCatalogStale(gen) else { return }\n464|            guard await sessionStill(startedIdentity) else { return }\n465|            let authority: @Sendable () async -> Bool = { [identities, startedIdentity] in\n466|                Self.sessionMatches(startedIdentity, await identities.load())\n467|            }\n468|            try await installer.unregister(directory: directory, removeToken: created.token, sessionAuthority: authority)\n469|            guard !isCatalogStale(gen) else { return }\n470|            // Remote registration is gone; the catalog entry stays so the\n471|            // user can re-register or remove it from the app. Files stay.\n472|            // This local bookkeeping follows a completed side effect: the\n473|            // remote removal is real even if the session changed while the\n474|            // installer lease was held, and no cancellation can undo it.\n475|            var updated = entry\n476|            updated.remoteAgentID = nil\n477|            updated.lastSeenAt = now()\n478|            try await catalog.update(updated)\n479|            await action { Runners.Action.catalogCleared }\n480|            let refreshed = await service.snapshots()\n481|            let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n482|            await action { Runners.Action.refreshed(mapped_refreshed) }\n483|        } catch {\n484|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n485|                await action { Runners.Action.catalogFailed(error.localizedDescription) }\n486|            }\n487|        }\n488|    }\n489|\n490|    /// Stopped-only gate for unregister. Only a positive confirmed `.stopped`\n491|    /// observation authorizes removal. `.running` refuses with a stop-first\n492|    /// message; a missing observation and every other state (unknown, failed,\n493|    /// missing, transitional, ...) refuse as unconfirmed instead of being\n494|    /// treated as stopped. A launchctl permission error (`.unknown`) therefore\n495|    /// never authorizes `config.sh remove` on a possibly live runner.\n496|    private func requireConfirmedStopped(entry: RunnerCatalogStore.Entry) async throws {\n497|        let snapshots = await service.snapshots()\n498|        guard let observation = snapshots.first(where: { $0.id == entry.serviceLabel }) else {\n499|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n500|                \"Cannot confirm the service '\\(entry.serviceLabel)' is stopped (no observation). Refusing to unregister while the service state is unconfirmed.\"\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c64f","stream":{"kind":"session","id":"01a0aa0a-86a0-7111-8cdf-bab999a2f9d6"},"sequence":386,"recorded_at":1780531400000767,"record_type":"event","durability":"durable","causation_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","run_stream":{"kind":"run","id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8"},"task_stream":{"kind":"task","id":"01a0aa0b-8691-7e82-9a43-d7fed17ee66e"},"task_id":"01a0aa0b-8691-7e82-9a43-d7fed17ee66e","event":{"kind":"completed","task_id":"01a0aa0b-8691-7e82-9a43-d7fed17ee66e"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c651","stream":{"kind":"session","id":"01a0aa0a-86a0-7111-8cdf-bab999a2f9d6"},"sequence":387,"recorded_at":1780531400000769,"record_type":"event","durability":"durable","causation_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","run_stream":{"kind":"run","id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8"},"call_id":"call_01a0aa0b826c73c6b743d39af5794ef2","text":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n1|import Foundation\n2|import Relux\n3|extension Runners {\n4|    public protocol IFlow: Relux.Flow {}\n5|    public actor Flow {\n6|        public let dispatcher: Relux.Dispatcher\n7|        private let service: any RunnerServicing\n8|        private let catalog: RunnerCatalogStore\n9|        private let installer: RunnerInstallerService\n10|        private let api: GitHubRunnerAPIClient\n11|        private let userStore: any GitHubCredentialStoring\n12|        private let identities: any GitHubSessionIdentityStoring\n13|        private let refresher: GitHubTokenRefresh\n14|        private let configProvider: @Sendable (String?) throws -> GitHubAuth.AppConfig\n15|        private let now: @Sendable () -> Date\n16|        private let home: URL\n17|        private var working: Set<String> = []\n18|        private var refreshing = false\n19|        private var revision = 0\n20|        private var pendingOp: [String: OperationPhase] = [:]\n21|        private var unregisterWorking: Set<String> = []\n22|        private var catalogGeneration = 0\n23|        private var editorAuthorities: [String: Runners.EditorAuthority] = [:]\n24|        private var editorInvalidated: Set<String> = []\n25|        /// Per-editor group-access operation generation. Every Load/Apply\n26|        /// takes the next number; only the newest operation may publish into\n27|        /// the shared editor state or release its busy flag. Keyed by the\n28|        /// same id spelling the actions use, so the owner check lines up\n29|        /// with the reducer key.\n30|        private var groupAccessGeneration: [String: Int] = [:]\n31|        public init(service: any RunnerServicing, dispatcher: Relux.Dispatcher? = nil) async {\n32|            self.service = service\n33|            self.catalog = RunnerCatalogStore()\n34|            self.installer = RunnerInstallerService()\n35|            let transport = URLSessionGitHubTransport()\n36|            let store: any GitHubCredentialStoring = GitHubKeychainStore()\n37|            self.api = GitHubRunnerAPIClient(transport: transport)\n38|            self.userStore = store\n39|            self.identities = UserDefaultsGitHubSessionIdentityStore()\n40|            self.refresher = GitHubTokenRefresh(transport: transport, store: store)\n41|            self.configProvider = { host in try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\") }\n42|            self.now = Date.init\n43|            self.home = FileManager.default.homeDirectoryForCurrentUser\n44|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n45|        }\n46|        /// Testable init with explicit catalog, installer and auth dependencies.\n47|        /// Production passes the shared installer so unregister/recovery and\n48|        /// registration cannot overlap.\n49|        public init(\n50|            service: any RunnerServicing,\n51|            catalog: RunnerCatalogStore,\n52|            installer: RunnerInstallerService,\n53|            api: GitHubRunnerAPIClient,\n54|            userStore: any GitHubCredentialStoring,\n55|            identities: any GitHubSessionIdentityStoring,\n56|            refresher: GitHubTokenRefresh,\n57|            configProvider: (@Sendable (String?) throws -> GitHubAuth.AppConfig)? = nil,\n58|            now: (@Sendable () -> Date)? = nil,\n59|            home: URL? = nil,\n60|            dispatcher: Relux.Dispatcher? = nil\n61|        ) async {\n62|            self.service = service\n63|            self.catalog = catalog\n64|            self.installer = installer\n65|            self.api = api\n66|            self.userStore = userStore\n67|            self.identities = identities\n68|            self.refresher = refresher\n69|            self.configProvider = configProvider ?? { host in try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\") }\n70|            self.now = now ?? Date.init\n71|            self.home = home ?? FileManager.default.homeDirectoryForCurrentUser\n72|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n73|        }\n74|    }\n75|}\n76|extension Runners.Flow: Runners.IFlow {\n77|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n78|        guard let effect = effect as? Runners.Effect else { return .success }\n79|        switch effect {\n80|        case .refresh: await refresh()\n81|        case .setEnabled(let id, let enabled): await setEnabled(id: id, enabled: enabled)\n82|        case .setEnabledMany(let ids, let enabled): await setEnabledMany(ids: ids, enabled: enabled)\n83|        case .loadCatalog: await loadCatalog()\n84|        case .discover: await discover()\n85|        case .importCandidate(let candidate): await importCandidate(candidate)\n86|        case .importFolder(let url): await importFolder(url)\n87|        case .removeFromApp(let id): await removeFromApp(id: id)\n88|        case .unregister(let id, let confirmation): await unregister(id: id, confirmation: confirmation)\n89|        case .refreshRemote: await refreshRemote()\n90|        case .setRunAtLoad(let id, let value): await setRunAtLoad(id: id, value: value)\n91|        case .setAlias(let id, let alias): await setAlias(id: id, alias: alias)\n92|        case .relinkDirectory(let id, let url): await relink(id: id, url: url)\n93|        case .selectRunner(let id): await action { Runners.Action.selected(id) }\n94|        case .loadLog(let id): await loadLog(id: id)\n95|        case .clearLog: await action { Runners.Action.logCleared }\n96|        case .loadGroupAccess(let id): await loadGroupAccess(id: id)\n97|        case .applyGroupAccess(let id, let groupID, let repos, let allowTakeover):\n98|            await applyGroupAccess(id: id, groupID: groupID, repos: repos, allowTakeover: allowTakeover)\n99|        }\n100|        return .success\n101|    }\n102|\n103|    private func isCatalogStale(_ gen: Int) -> Bool { catalogGeneration != gen }\n104|\n105|    // MARK: - Local refresh and power\n106|\n107|    private func refresh() async {\n108|        guard !refreshing, working.isEmpty else { return }\n109|        refreshing = true\n110|        let startedAt = revision\n111|        let snapshots = await service.snapshots()\n112|        // Do not publish a stale read if a command started during this await.\n113|        if working.isEmpty && revision == startedAt {\n114|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n115|            await action { Runners.Action.refreshed(mapped_snapshots) }\n116|        }\n117|        refreshing = false\n118|    }\n119|\n120|    private func withPendingOp(_ snapshots: [Runners.Snapshot]) -> [Runners.Snapshot] {\n121|        Self.applyPending(snapshots, pending: pendingOp)\n122|    }\n123|\n124|    private nonisolated static func applyPending(_ snapshots: [Runners.Snapshot], pending: [String: Runners.OperationPhase]) -> [Runners.Snapshot] {\n125|        snapshots.map { snapshot in\n126|            var next = snapshot\n127|            next.operation = pending[snapshot.id] ?? .idle\n128|            // Reflect the operation in the local status so the row shows\n129|            // starting/stopping instead of jumping ahead to running/stopped.\n130|            if next.operation == .starting, next.status == .stopped || next.status == .failed {\n131|                next.status = .starting\n132|            } else if next.operation == .stopping, next.status == .running {\n133|                next.status = .stopping\n134|            }\n135|            return next\n136|        }\n137|    }\n138|\n139|    private func setEnabled(id: String, enabled: Bool) async {\n140|        guard !working.contains(id), !unregisterWorking.contains(id) else { return }\n141|        working.insert(id)\n142|        revision += 1\n143|        pendingOp[id] = enabled ? .starting : .stopping\n144|        await action { Runners.Action.changing(id, true) }\n145|        do { try await service.setEnabled(enabled, id: id) }\n146|        catch { await action { Runners.Action.failed(error.localizedDescription) } }\n147|        pendingOp.removeValue(forKey: id)\n148|        let snapshots = await service.snapshots()\n149|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n150|        await action { Runners.Action.refreshed(mapped_snapshots) }\n151|        working.remove(id)\n152|        await action { Runners.Action.changing(id, false) }\n153|    }\n154|\n155|    /// Bulk power with per-row errors. Every row is attempted; failures are\n156|    /// reported per row in the refreshed snapshots plus one summary failure.\n157|    /// A single-row error never blocks the rest of the list.\n158|    private func setEnabledMany(ids: [String], enabled: Bool) async {\n159|        let targets = ids.filter { !working.contains($0) && !unregisterWorking.contains($0) }\n160|        guard !targets.isEmpty else { return }\n161|        for id in targets {\n162|            working.insert(id)\n163|            pendingOp[id] = enabled ? .starting : .stopping\n164|            await action { Runners.Action.changing(id, true) }\n165|        }\n166|        revision += 1\n167|        var failures: [(String, String)] = []\n168|        for id in targets {\n169|            do { try await service.setEnabled(enabled, id: id) }\n170|            catch { failures.append((id, error.localizedDescription)) }\n171|        }\n172|        for id in targets { pendingOp.removeValue(forKey: id) }\n173|        var snapshots = await service.snapshots()\n174|        if !failures.isEmpty {\n175|            let table = Dictionary(uniqueKeysWithValues: failures)\n176|            snapshots = snapshots.map { snapshot in\n177|                var next = snapshot\n178|                if let message = table[snapshot.id] {\n179|                    next.message = message\n180|                }\n181|                return next\n182|            }\n183|            let summary = failures.map { id, message in \"\\(id): \\(message)\" }.joined(separator: \"; \")\n184|            let failureCount = failures.count\n185|            let targetCount = targets.count\n186|            let bulkMessage = \"Partial failure (\\(failureCount) of \\(targetCount)): \\(summary)\"\n187|            await action { Runners.Action.failed(bulkMessage) }\n188|        }\n189|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n190|        await action { Runners.Action.refreshed(mapped_snapshots) }\n191|        for id in targets {\n192|            working.remove(id)\n193|            await action { Runners.Action.changing(id, false) }\n194|        }\n195|    }\n196|\n197|    // MARK: - Catalog\n198|\n199|    /// One-time migration plus refresh. Never starts or stops CI and never\n200|    /// modifies services; discovery only reads.\n201|    private func loadCatalog() async {\n202|        do {\n203|            _ = try await catalog.migrateIfNeeded()\n204|            await action { Runners.Action.catalogCleared }\n205|        } catch {\n206|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n207|        }\n208|        let snapshots = await service.snapshots()\n209|        let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n210|        await action { Runners.Action.refreshed(mapped_snapshots) }\n211|    }\n212|\n213|    private func discover() async {\n214|        let entries = await catalog.load()\n215|        let known = Set(entries.map(\\.canonicalPath))\n216|        let extra = entries.map { RunnerCatalogStore.resolve(entry: $0) }\n217|        let candidates = RunnerDiscovery.discoverCandidates(knownCanonicals: known, extraDirectories: extra)\n218|            .filter { candidate in\n219|                let canonical = RunnerCatalogStore.canonical(candidate.directory)\n220|                return !known.contains(canonical)\n221|            }\n222|        await action { Runners.Action.candidatesLoaded(candidates) }\n223|    }\n224|\n225|    private func importCandidate(_ candidate: RunnerDiscovery.Candidate) async {\n226|        let gen = catalogGeneration\n227|        // Refuse mutations for an entry already under unregister.\n228|        if let label = candidate.label, unregisterWorking.contains(label) {\n229|            await action { Runners.Action.catalogFailed(RunnerRegistration.RegistrationError.installerBusy(path: candidate.directory.path).localizedDescription) }\n230|            return\n231|        }\n232|        do {\n233|            try RunnersCatalogGates.validateImportable(candidate)\n234|            let canonical = RunnerCatalogStore.canonical(candidate.directory)\n235|            let entries = await catalog.load()\n236|            if entries.contains(where: { $0.canonicalPath == canonical }) {\n237|                throw RunnerCatalogStore.CatalogError.duplicateDirectory(path: candidate.directory.path)\n238|            }\n239|            guard !isCatalogStale(gen) else { return }\n240|            let label: String\n241|            let plist: URL\n242|            let kind = candidate.controllerKind\n243|            if let manifest = candidate.manifest, let existing = candidate.label {\n244|                // Import without changing the existing service: never\n245|                // re-registers and never flips the preserved RunAtLoad policy.\n246|                // A manifest label already owned by another entry refuses:\n247|                // two entries must never share one control identity.\n248|                if entries.contains(where: { $0.serviceLabel == existing }) {\n249|                    throw RunnerCatalogStore.CatalogError.duplicateLabel(label: existing)\n250|                }\n251|                label = existing\n252|                plist = manifest\n253|            } else {\n254|                // No manifest: create a manual service (RunAtLoad off for new\n255|                // runners). Never bootstraps; enabling is a separate action.\n256|                // The label binds agent name plus canonical path, so two\n257|                // same-name folders never share one control identity.\n258|                label = RunnerCatalogStore.importedServiceLabel(\n259|                    agentName: candidate.agentName, directory: candidate.directory\n260|                )\n261|                if entries.contains(where: { $0.serviceLabel == label }) {\n262|                    throw RunnerCatalogStore.CatalogError.duplicateLabel(label: label)\n263|                }\n264|                plist = try await installer.setupService(directory: candidate.directory, label: label)\n265|            }\n266|            guard !isCatalogStale(gen) else { return }\n267|            let info = RunnerRegistrationReader.read(directory: candidate.directory)\n268|            let entry = RunnerCatalogStore.Entry(\n269|                directoryPath: candidate.directory.path,\n270|                canonicalPath: canonical,\n271|                bookmarkBase64: RunnerCatalogStore.bookmark(for: candidate.directory),\n272|                serviceLabel: label,\n273|                servicePlistPath: plist.path,\n274|                controllerKind: kind,\n275|                runAtLoad: candidate.runAtLoad,\n276|                serverHost: info?.serverHost ?? candidate.serverHost,\n277|                scopeKind: info?.scopeKind,\n278|                scope: info?.scopeDetail ?? candidate.scope,\n279|                remoteAgentID: info?.agentID ?? candidate.agentID,\n280|                agentName: info?.agentName ?? candidate.agentName,\n281|                workFolder: info?.workFolder ?? candidate.workFolder\n282|            )\n283|            try await catalog.add(entry)\n284|            await action { Runners.Action.catalogCleared }\n285|            let snapshots = await service.snapshots()\n286|            let mapped_snapshots = Self.applyPending(snapshots, pending: pendingOp)\n287|            await action { Runners.Action.refreshed(mapped_snapshots) }\n288|            await discover()\n289|        } catch {\n290|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n291|        }\n292|    }\n293|\n294|    private func importFolder(_ url: URL) async {\n295|        var isDir: ObjCBool = false\n296|        guard FileManager.default.fileExists(atPath: url.path, isDirectory: &isDir), isDir.boolValue else {\n297|            await action { Runners.Action.catalogFailed(\"Selected folder does not exist.\") }\n298|            return\n299|        }\n300|        let candidate = RunnerDiscovery.validateFolder(url)\n301|        if candidate.needsRelocation {\n302|            await action { Runners.Action.catalogFailed(\"Path contains a space; choose a location without spaces. Running runners are never moved automatically.\") }\n303|            return\n304|        }\n305|        await importCandidate(candidate)\n306|    }\n307|\n308|    /// Removes only the catalog record. Deletes no files, no GitHub\n309|    /// registration and no certificates, and never stops a running service.\n310|    /// Warns when the service keeps running.\n311|    private func removeFromApp(id: String) async {\n312|        if unregisterWorking.contains(id) {\n313|            await action { Runners.Action.catalogFailed(\"Runner is unregistering; retry after it settles.\") }\n314|            return\n315|        }\n316|        let entries = await catalog.load()\n317|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n318|            await action { Runners.Action.catalogFailed(RunnerCatalogStore.CatalogError.unknownEntry(id: id).localizedDescription) }\n319|            return\n320|        }\n321|        catalogGeneration += 1\n322|        editorAuthorities.removeValue(forKey: entry.serviceLabel)\n323|        editorInvalidated.remove(entry.serviceLabel)\n324|        dropGroupAccessOwnership(serviceLabel: entry.serviceLabel, localID: entry.localID)\n325|        let snapshots = await service.snapshots()\n326|        let wasRunning = snapshots.first(where: { $0.id == entry.serviceLabel })?.status == .running\n327|        do {\n328|            _ = try await catalog.remove(localID: entry.localID)\n329|        } catch {\n330|            await action { Runners.Action.catalogFailed(error.localizedDescription) }\n331|            return\n332|        }\n333|        let refreshed = await service.snapshots()\n334|        let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n335|        await action { Runners.Action.refreshed(mapped_refreshed) }\n336|        if wasRunning {\n337|            await action { Runners.Action.catalogFailed(\"Removed «\\(entry.agentName ?? entry.serviceLabel)» from the app. Its service keeps running.\") }\n338|        } else {\n339|            await action { Runners.Action.catalogCleared }\n340|        }\n341|        await discover()\n342|    }\n343|\n344|    // MARK: - Unregister (explicit remote removal)\n345|\n346|    /// Explicit remote unregister, distinct from catalog removal and file\n347|    /// deletion. Binds the local verified `.runner` server/scope/agentId and\n348|    /// the service path, never a remote name alone. Stopped-only: requires a\n349|    /// positive confirmed `.stopped` observation (unknown or missing state\n350|    /// refuses) both before minting the remove token and at the `config.sh\n351|    /// remove` boundary, plus a typed confirmation matching the agent name.\n352|    /// Bound to the session it started with: a logout, account or server\n353|    /// switch invalidates unstarted side effects instead of unregistering\n354|    /// under stale authority. Holds the shared installer lease across\n355|    /// `config.sh remove` so no registration, install, recovery or second\n356|    /// unregister can overlap. Files and the service manifest stay for\n357|    /// re-registration.\n358|    private func unregister(id: String, confirmation: String) async {\n359|        guard !unregisterWorking.contains(id), !working.contains(id) else { return }\n360|        unregisterWorking.insert(id)\n361|        await action { Runners.Action.unregistering(id, true) }\n362|        await runUnregister(id: id, confirmation: confirmation)\n363|        unregisterWorking.remove(id)\n364|        await action { Runners.Action.unregistering(id, false) }\n365|    }\n366|\n367|    /// Unregister body with guaranteed operation-state release: every early\n368|    /// return below still runs the caller's epilogue, so a refused or\n369|    /// session-invalidated attempt never wedges the UI \"unregistering\"\n370|    /// state and a retry stays possible.\n371|    private func runUnregister(id: String, confirmation: String) async {\n372|        let gen = catalogGeneration\n373|        // Session ownership: the initiating session is captured once and\n374|        // re-checked at every asynchronous boundary below.\n375|        let startedIdentity = await identities.load()\n376|        do {\n377|            let entries = await catalog.load()\n378|            guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n379|                throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n380|            }\n381|            let directory = RunnerCatalogStore.resolve(entry: entry)\n382|            // Mutation authority: local verified identity plus the service\n383|            // path. A remote name match alone never authorizes removal.\n384|            guard let local = await installer.readLocalRegistration(directory: directory),\n385|                  let agentID = local.agentID,\n386|                  let agentName = local.agentName, !agentName.isEmpty,\n387|                  let address = local.gitHubURL,\n388|                  let scope = unregisterScope(address: address) else {\n389|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n390|                    \"No verified local registration for '\\(entry.serviceLabel)'. Refusing to unregister another runner by name.\"\n391|                )\n392|            }\n393|            // Service-path binding: the catalog entry must still point at the\n394|            // verified directory; a relink mid-flight invalidates the evidence.\n395|            let canonical = RunnerCatalogStore.canonical(directory)\n396|            guard canonical == entry.canonicalPath else {\n397|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n398|                    \"Service path changed during unregister. Re-verify instead of removing another directory's registration.\"\n399|                )\n400|            }\n401|            // Agent-ID binding: a stored ID that disagrees with disk fails\n402|            // closed instead of removing a foreign registration.\n403|            if let stored = entry.remoteAgentID, stored != agentID {\n404|                throw RunnerRegistration.RegistrationError.remoteIdentityMismatch(\n405|                    \"Catalog expects agent \\(stored) but disk shows agent \\(agentID) for '\\(agentName)'. Refusing to unregister a mismatched registration.\"\n406|                )\n407|            }\n408|            guard confirmation == agentName else {\n409|                throw RunnerRegistration.RegistrationError.confirmationMismatch(\n410|                    \"Type '\\(agentName)' to confirm unregister of agent \\(agentID) in \\(scope.detail).\"\n411|                )\n412|            }\n413|            guard !isCatalogStale(gen) else { return }\n414|            // Stopped-only gate: a positive confirmed `.stopped` observation\n415|            // is required before minting the remove token, so unregister\n416|            // cannot interrupt a job — or a service whose state is unknown.\n417|            try await requireConfirmedStopped(entry: entry)\n418|            guard !isCatalogStale(gen) else { return }\n419|            let auth = try await currentUserToken()\n420|            guard !isCatalogStale(gen) else { return }\n421|            // Server binding: the verified host must equal the authenticated\n422|            // server; a same-path foreign host never authorizes removal here.\n423|            let verifiedHost = URL(string: address)?.host ?? \"\"\n424|            guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n425|                == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n426|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n427|                    \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost). Refusing cross-server unregister.\"\n428|                )\n429|            }\n430|            let created = try await api.createRemoveToken(config: auth.config, token: auth.token, scope: scope)\n431|            guard !isCatalogStale(gen) else { return }\n432|            // A logout, account or server switch during token acquisition\n433|            // invalidates the unstarted side effect; the minted token\n434|            // simply expires unused.\n435|            guard await sessionStill(startedIdentity) else { return }\n436|            // Re-verify after the network: scope/path edits invalidate stale\n437|            // evidence instead of removing a re-targeted registration.\n438|            guard let reread = await installer.readLocalRegistration(directory: directory),\n439|                  reread.agentID == agentID, reread.agentName == agentName,\n440|                  reread.gitHubURL == address else {\n441|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n442|                    \"Local registration changed during unregister. Re-verify instead of removing a re-targeted registration.\"\n443|                )\n444|            }\n445|            let currentEntries = await catalog.load()\n446|            guard currentEntries.contains(where: { $0.localID == entry.localID && $0.canonicalPath == canonical }) else {\n447|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n448|                    \"Catalog entry changed during unregister. Re-verify instead of removing another entry.\"\n449|                )\n450|            }\n451|            // Revalidate the stopped evidence at the side-effect boundary: a\n452|            // service started (or lost to inspection) after the token mint\n453|            // must not be unregistered.\n454|            guard !isCatalogStale(gen) else { return }\n455|            guard await sessionStill(startedIdentity) else { return }\n456|            try await requireConfirmedStopped(entry: entry)\n457|            // Final boundary: the inspection above awaits production\n458|            // launchctl, so a logout, account/server switch, or same-account\n459|            // re-login can finish during it. Re-check the initiating-session\n460|            // authority after the inspection, and enforce the same authority\n461|            // again inside the installer before `config.sh remove` begins, so\n462|            // no invalidation between the two checks can start the removal.\n463|            guard !isCatalogStale(gen) else { return }\n464|            guard await sessionStill(startedIdentity) else { return }\n465|            let authority: @Sendable () async -> Bool = { [identities, startedIdentity] in\n466|                Self.sessionMatches(startedIdentity, await identities.load())\n467|            }\n468|            try await installer.unregister(directory: directory, removeToken: created.token, sessionAuthority: authority)\n469|            guard !isCatalogStale(gen) else { return }\n470|            // Remote registration is gone; the catalog entry stays so the\n471|            // user can re-register or remove it from the app. Files stay.\n472|            // This local bookkeeping follows a completed side effect: the\n473|            // remote removal is real even if the session changed while the\n474|            // installer lease was held, and no cancellation can undo it.\n475|            var updated = entry\n476|            updated.remoteAgentID = nil\n477|            updated.lastSeenAt = now()\n478|            try await catalog.update(updated)\n479|            await action { Runners.Action.catalogCleared }\n480|            let refreshed = await service.snapshots()\n481|            let mapped_refreshed = Self.applyPending(refreshed, pending: pendingOp)\n482|            await action { Runners.Action.refreshed(mapped_refreshed) }\n483|        } catch {\n484|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n485|                await action { Runners.Action.catalogFailed(error.localizedDescription) }\n486|            }\n487|        }\n488|    }\n489|\n490|    /// Stopped-only gate for unregister. Only a positive confirmed `.stopped`\n491|    /// observation authorizes removal. `.running` refuses with a stop-first\n492|    /// message; a missing observation and every other state (unknown, failed,\n493|    /// missing, transitional, ...) refuse as unconfirmed instead of being\n494|    /// treated as stopped. A launchctl permission error (`.unknown`) therefore\n495|    /// never authorizes `config.sh remove` on a possibly live runner.\n496|    private func requireConfirmedStopped(entry: RunnerCatalogStore.Entry) async throws {\n497|        let snapshots = await service.snapshots()\n498|        guard let observation = snapshots.first(where: { $0.id == entry.serviceLabel }) else {\n499|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n500|                \"Cannot confirm the service '\\(entry.serviceLabel)' is stopped (no observation). Refusing to unregister while the service state is unconfirmed.\"\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
