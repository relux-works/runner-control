{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c897","stream":{"kind":"session","id":"01a0aa0a-86a0-7111-8cdf-bab999a2f9d6"},"sequence":678,"recorded_at":1780531400001351,"record_type":"event","durability":"durable","causation_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","run_stream":{"kind":"run","id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8"},"task_stream":{"kind":"task","id":"01a0aa0c-cd5e-7e52-9e40-150a8178281f"},"task_id":"01a0aa0c-cd5e-7e52-9e40-150a8178281f","event":{"kind":"output","task_id":"01a0aa0c-cd5e-7e52-9e40-150a8178281f","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerCatalogLifecycleTests.swift`.\n(2030 line(s) above)\n2031|func reviewR4SessionInvalidationMustReleaseEditorLoading(apply: Bool) async throws {\n2032|    let responses: [GitHubHTTPResponse] = apply\n2033|        ? [groupsPayload([(4, \"g\")]), groupRunnersPayload([(42, \"r\", false)]), .init(status: 204), groupReposPayload([2])]\n2034|        : [groupsPayload([(4, \"g\")]), groupRunnersPayload([(42, \"r\", false)]), groupReposPayload([1])]\n2035|    let h = await catalogHarness(transportResponses: responses)\n2036|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n2037|    let label = \"actions.runner.test.releaseeditor\"\n2038|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n2039|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n2040|    let flow = await reviewR3ReloginFlow(h, method: apply ? \"PUT\" : \"GET\")\n2041|    let effect: Runners.Effect = apply ? .applyGroupAccess(label, groupID: 4, repositories: [2], allowTakeover: true) : .loadGroupAccess(label)\n2042|    _ = await flow.apply(effect)\n2043|    #expect(await h.identities.load()?.sessionIncarnation != nil)\n2044|    #expect(loadedGroupAccess(h.logger, id: label) == nil)\n2045|    let state = Runners.State(definitions: [])\n2046|    for action in runnersActions(h.logger) { await state.reduce(with: action) }\n2047|    // Normal local polling must not leave the editor wedged either.\n2048|    await state.reduce(with: Runners.Action.refreshed(await h.service.snapshots()))\n2049|    #expect(state.groupAccess[label]?.loading != true)\n2050|}\n2051|\n2052|// MARK: - R5 bounds: final installer boundary, overlap, same-flow retry\n2053|\n2054|/// R4-F1 bound: a logout that lands after the final stopped inspection —\n2055|/// between the Flow's last check and `config.sh remove` — is refused at the\n2056|/// actual installer mutation boundary. Identity load order in unregister:\n2057|/// started(1), auth(2), post-token check(3), pre-inspection check(4),\n2058|/// post-inspection check(5), installer authority(6); the flip lands on the\n2059|/// installer authority check. The minted remove token expires unused, the\n2060|/// operation state is released, and an explicit retry in the new session\n2061|/// proceeds through the same Flow.\n2062|@Test func unregisterRefusesLogoutBetweenFinalInspectionAndConfigRemove() async throws {\n2063|    let session = GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\")\n2064|    let flipping = FlippingSessionStore(first: session, later: nil, flipAfter: 5)\n2065|    let h = await catalogHarness(\n2066|        launchResults: [stopped, stopped, stopped, stopped, stopped],\n2067|        installerResults: [.init(code: 0, output: \"ok\")],\n2068|        transportResponses: [removeTokenPayload()],\n2069|        identitiesOverride: flipping\n2070|    )\n2071|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n2072|    let label = \"actions.runner.test.installerboundary\"\n2073|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n2074|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n2075|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.unregister(label, confirmation: \"r\"))\n2076|    #expect(await h.transport.requests.count == 1)\n2077|    #expect(await h.installerExecutor.calls.isEmpty)\n2078|    #expect(await h.catalog.load().first?.remoteAgentID == 42)\n2079|    #expect(lastUnregistering(h.logger, id: label) == false)\n2080|    // Re-authenticate and retry through the same Flow: removal proceeds.\n2081|    await flipping.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n2082|    await h.transport.append(removeTokenPayload(token: \"remove-token-2\"))\n2083|    let _: Relux.ActionResult = await h.flow.apply(Runners.Effect.unregister(label, confirmation: \"r\"))\n2084|    #expect(await h.installerExecutor.calls.count == 1)\n2085|    #expect(await h.catalog.load().first?.remoteAgentID == nil)\n2086|}\n2087|\n2088|/// Holds the first HTTP send on a latch while later sends pass through, so\n2089|/// two overlapping Loads on one Flow interleave deterministically.\n2090|private actor LatchFirstSendTransport: GitHubHTTPTransport {\n2091|    let base: TestTransport\n2092|    private var latched = false\n2093|    private var gate: CheckedContinuation<Void, Never>?\n2094|    private(set) var sends = 0\n2095|    init(_ base: TestTransport) { self.base = base }\n2096|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n2097|        sends += 1\n2098|        if !latched {\n2099|            latched = true\n2100|            await withCheckedContinuation { (continuation: CheckedContinuation<Void, Never>) in gate = continuation }\n2101|        }\n2102|        return try await base.send(request)\n2103|    }\n2104|    func release() { gate?.resume(); gate = nil }\n2105|}\n2106|\n2107|/// R4-F2 bound: when two Loads overlap on the same Flow, the older\n2108|/// completion publishes nothing — it neither clears the newer request's\n2109|/// busy state nor overwrites its data. Driven through the production\n2110|/// reducer plus a normal local refresh.\n2111|@MainActor @Test func editorOverlappingLoadSuppressesStaleCompletion() async throws {\n2112|    let h = await catalogHarness(transportResponses: [\n2113|        groupsPayload([(4, \"g\")]), groupRunnersPayload([(42, \"r\", false)]), groupReposPayload([7]),\n2114|        groupsPayload([(4, \"g\")]), groupRunnersPayload([(42, \"r\", false)]), groupReposPayload([9])\n2115|    ])\n2116|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n2117|    let label = \"actions.runner.test.overlap\"\n2118|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n2119|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n2120|    let latch = LatchFirstSendTransport(h.transport)\n2121|    let flow = await Runners.Flow(service: h.service, catalog: h.catalog, installer: h.installer,\n2122|        api: GitHubRunnerAPIClient(transport: latch), userStore: h.userStore,\n2123|        identities: h.identities, refresher: GitHubTokenRefresh(transport: latch, store: h.userStore),\n2124|        configProvider: { _ in testConfig }, home: h.home, dispatcher: Relux.Dispatcher(logger: h.logger))\n2125|    async let first: Relux.ActionResult = flow.apply(Runners.Effect.loadGroupAccess(label))\n2126|    // Bounded wait until the first op's initial send is held on the latch;\n2127|    // only then start the newer overlapping Load.\n2128|    let deadline = ContinuousClock.now.advanced(by: .seconds(3))\n2129|    while await latch.sends == 0, ContinuousClock.now < deadline {\n2130|        try await Task.sleep(for: .milliseconds(5))\n2131|    }\n2132|    #expect(await latch.sends == 1)\n2133|    let _: Relux.ActionResult = await flow.apply(Runners.Effect.loadGroupAccess(label))\n2134|    #expect(loadedGroupAccess(h.logger, id: label)?.repoIDs == [7])\n2135|    await latch.release()\n2136|    let _: Relux.ActionResult = await first\n2137|    #expect(await h.transport.requests.count == 6)\n2138|    #expect(loadedGroupAccess(h.logger, id: label)?.repoIDs == [7])\n2139|    let state = Runners.State(definitions: [])\n2140|    for action in runnersActions(h.logger) { await state.reduce(with: action) }\n2141|    await state.reduce(with: Runners.Action.refreshed(await h.service.snapshots()))\n2142|    #expect(state.groupAccess[label]?.loading == false)\n2143|    #expect(state.groupAccess[label]?.repoIDs == [7])\n2144|}\n2145|\n2146|/// Logs out exactly once, on the first HTTP request, so a retry after\n2147|/// re-authentication is not logged out again.\n2148|private actor SingleFireLogoutTransport: GitHubHTTPTransport {\n2149|    let base: TestTransport\n2150|    let identities: any GitHubSessionIdentityStoring\n2151|    private var fired = false\n2152|    init(_ base: TestTransport, identities: any GitHubSessionIdentityStoring) {\n2153|        self.base = base; self.identities = identities\n2154|    }\n2155|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n2156|        let result = try await base.send(request)\n2157|        if !fired {\n2158|            fired = true\n2159|            await identities.delete()\n2160|        }\n2161|        return result\n2162|    }\n2163|}\n2164|\n2165|/// R4-F2 bound: after a session invalidation releases the editor busy state,\n2166|/// an explicit retry through the SAME Flow in the new session succeeds.\n2167|/// Driven through the production reducer plus a normal local refresh.\n2168|@MainActor @Test func editorRetryAfterSessionInvalidationSucceedsOnSameFlow() async throws {\n2169|    let h = await catalogHarness(transportResponses: [\n2170|        groupsPayload([(4, \"g\")]), groupRunnersPayload([(42, \"r\", false)])\n2171|    ])\n2172|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n2173|    let label = \"actions.runner.test.editorretry\"\n2174|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n2175|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n2176|    let transport = SingleFireLogoutTransport(h.transport, identities: h.identities)\n2177|    let flow = await Runners.Flow(service: h.service, catalog: h.catalog, installer: h.installer,\n2178|        api: GitHubRunnerAPIClient(transport: transport), userStore: h.userStore,\n2179|        identities: h.identities, refresher: GitHubTokenRefresh(transport: transport, store: h.userStore),\n2180|        configProvider: { _ in testConfig }, home: h.home, dispatcher: Relux.Dispatcher(logger: h.logger))\n2181|    let _: Relux.ActionResult = await flow.apply(Runners.Effect.loadGroupAccess(label))\n2182|    #expect(await h.identities.load() == nil)\n2183|    #expect(loadedGroupAccess(h.logger, id: label) == nil)\n2184|    let cleanup = groupAccessError(h.logger, id: label) ?? \"\"\n2185|    #expect(cleanup.contains(\"session changed\") && cleanup.contains(\"Reload group access\"))\n2186|    #expect(await h.transport.requests.count == 2)\n2187|    // Re-authenticate and retry through the same Flow: the released editor proceeds.\n2188|    await h.identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n2189|    await h.transport.append(groupsPayload([(4, \"g\")]))\n2190|    await h.transport.append(groupRunnersPayload([(42, \"r\", false)]))\n2191|    await h.transport.append(groupReposPayload([11]))\n2192|    let _: Relux.ActionResult = await flow.apply(Runners.Effect.loadGroupAccess(label))\n2193|    #expect(loadedGroupAccess(h.logger, id: label)?.repoIDs == [11])\n2194|    #expect(await h.transport.requests.count == 5)\n2195|    let state = Runners.State(definitions: [])\n2196|    for action in runnersActions(h.logger) { await state.reduce(with: action) }\n2197|    await state.reduce(with: Runners.Action.refreshed(await h.service.snapshots()))\n2198|    #expect(state.groupAccess[label]?.loading == false)\n2199|    #expect(state.groupAccess[label]?.repoIDs == [11])\n2200|}","final_result":true}}}
