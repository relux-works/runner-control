{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c627","stream":{"kind":"session","id":"01a0aa0a-86a0-7111-8cdf-bab999a2f9d6"},"sequence":366,"recorded_at":1780531400000727,"record_type":"event","durability":"durable","causation_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","run_stream":{"kind":"run","id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8"},"call_id":"call_01a0aa0b754d7209800de8a9b1c10652","text":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n(1049 line(s) above)\n1050|    }\n1051|\n1052|    /// True when the GitHub session still matches the login incarnation this\n1053|    /// operation started with. A logout, account/server switch, or logout +\n1054|    /// same-account re-login mid-operation stops silently: no writes into a\n1055|    /// changed session. Ordinary token refresh keeps the same incarnation and\n1056|    /// stays valid. Legacy identities without an incarnation compare as nil.\n1057|    private func sessionStill(_ started: GitHubSessionIdentity?) async -> Bool {\n1058|        Self.sessionMatches(started, await identities.load())\n1059|    }\n1060|\n1061|    /// Pure incarnation comparison shared by `sessionStill` and by the\n1062|    /// installer-boundary authority closure, so both enforce the same\n1063|    /// initiating-session authority without capturing the Flow actor.\n1064|    private nonisolated static func sessionMatches(\n1065|        _ started: GitHubSessionIdentity?, _ current: GitHubSessionIdentity?\n1066|    ) -> Bool {\n1067|        guard let started else { return current == nil }\n1068|        guard let current else { return false }\n1069|        guard current.userID == started.userID,\n1070|              RunnerRegistration.OperationIdentity.normalizeServerHost(current.serverHost)\n1071|                == RunnerRegistration.OperationIdentity.normalizeServerHost(started.serverHost) else { return false }\n1072|        return current.sessionIncarnation == started.sessionIncarnation\n1073|    }\n1074|\n1075|    /// Write-path identity binding for group edits. Re-reads the mutable\n1076|    /// local registration and requires it to still match the verified\n1077|    /// server host, org scope, agent ID and name, and requires the catalog\n1078|    /// entry to still point at the verified canonical directory. A\n1079|    /// same-path foreign host, a scope edit, or a relink mid-flight fails\n1080|    /// instead of writing another server's group. Called after\n1081|    /// authentication and re-called at the PUT boundary.\n1082|    private func bindApplyIdentity(verified: VerifiedOrgRunner, auth: CatalogUserToken) async throws {\n1083|        guard let reread = await installer.readLocalRegistration(directory: verified.directory),\n1084|              reread.agentID == verified.agentID,\n1085|              reread.agentName == verified.agentName,\n1086|              let address = reread.gitHubURL,\n1087|              let url = URL(string: address), url.scheme == \"https\" else {\n1088|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1089|                \"Local registration changed during group apply. Reload instead of editing with stale identity.\"\n1090|            )\n1091|        }\n1092|        let components = url.pathComponents.filter { $0 != \"/\" }\n1093|        guard components.count == 1, components[0] == verified.org else {\n1094|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1095|                \"Local registration scope changed during group apply. Reload instead of editing with stale identity.\"\n1096|            )\n1097|        }\n1098|        let verifiedHost = url.host ?? \"\"\n1099|        guard RunnerRegistration.OperationIdentity.normalizeServerHost(verifiedHost)\n1100|            == RunnerRegistration.OperationIdentity.normalizeServerHost(auth.identity.serverHost) else {\n1101|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1102|                \"Local registration points at '\\(verifiedHost)', not the signed-in server \\(auth.identity.serverHost). Refusing cross-server group apply.\"\n1103|            )\n1104|        }\n1105|        let canonical = RunnerCatalogStore.canonical(verified.directory)\n1106|        let current = await catalog.load()\n1107|        guard current.contains(where: { $0.localID == verified.entry.localID && $0.canonicalPath == canonical }) else {\n1108|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1109|                \"Catalog entry changed during group apply. Reload instead of editing another entry's group.\"\n1110|            )\n1111|        }\n1112|    }\n1113|\n1114|    /// Consumes the immutable Load-time editor authority for this runner.\n1115|    /// Returns the verified tuple when the current disk/catalog identity\n1116|    /// still matches the stored server/scope/agent/canonical/localID; when it\n1117|    /// no longer matches and this operation still owns the editor, clears the\n1118|    /// stored editor, publishes an explicit invalidation requiring a new Load,\n1119|    /// and returns nil without throwing. A stale operation refuses silently:\n1120|    /// the newer owner keeps the narrative. A missing entry throws\n1121|    /// unknownEntry like the verified path.\n1122|    private func consumeStoredEditorAuthority(_ stored: Runners.EditorAuthority, id: String, operation: Int) async throws -> VerifiedOrgRunner? {\n1123|        let entries = await catalog.load()\n1124|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else {\n1125|            throw RunnerCatalogStore.CatalogError.unknownEntry(id: id)\n1126|        }\n1127|        let directory = RunnerCatalogStore.resolve(entry: entry)\n1128|        let canonical = RunnerCatalogStore.canonical(directory)\n1129|        guard let local = await installer.readLocalRegistration(directory: directory),\n1130|              let agentID = local.agentID,\n1131|              let agentName = local.agentName, !agentName.isEmpty,\n1132|              let address = local.gitHubURL,\n1133|              let url = URL(string: address), url.scheme == \"https\" else {\n1134|            if ownsGroupAccess(id: id, operation: operation) {\n1135|                editorAuthorities.removeValue(forKey: entry.serviceLabel)\n1136|                editorInvalidated.insert(entry.serviceLabel)\n1137|                let message = \"Runner identity changed since loading (registration unreadable for '\\(entry.serviceLabel)'). Reload group access before applying.\"\n1138|                await action { Runners.Action.groupAccessInvalidated(id, message) }\n1139|            }\n1140|            return nil\n1141|        }\n1142|        let components = url.pathComponents.filter { $0 != \"/\" }\n1143|        let diskHost = url.host ?? \"\"\n1144|        let matches = components.count == 1\n1145|            && components[0] == stored.org\n1146|            && RunnerRegistration.OperationIdentity.normalizeServerHost(diskHost)\n1147|                == RunnerRegistration.OperationIdentity.normalizeServerHost(stored.serverHost)\n1148|            && agentID == stored.agentID\n1149|            && agentName == stored.agentName\n1150|            && canonical == stored.canonicalPath\n1151|            && entry.localID == stored.localID\n1152|        guard matches else {\n1153|            if ownsGroupAccess(id: id, operation: operation) {\n1154|                editorAuthorities.removeValue(forKey: entry.serviceLabel)\n1155|                editorInvalidated.insert(entry.serviceLabel)\n1156|                let foundScope = components.count == 1 ? components[0] : (components.joined(separator: \"/\").isEmpty ? \"?\" : components.joined(separator: \"/\"))\n1157|                let message = \"Runner identity changed since loading (expected \\(stored.serverHost)/\\(stored.org)/agent\\(stored.agentID), found \\(diskHost)/\\(foundScope)/agent\\(agentID)). Reload group access before applying.\"\n1158|                await action { Runners.Action.groupAccessInvalidated(id, message) }\n1159|            }\n1160|            return nil\n1161|        }\n1162|        return VerifiedOrgRunner(entry: entry, directory: directory, org: stored.org, agentID: stored.agentID, agentName: stored.agentName)\n1163|    }\n1164|\n1165|    /// Applies edited repository access to the runner's fresh group. Rejects\n1166|    /// stale UI (group moved since load), shared groups without explicit\n1167|    /// takeover, and partial confirmations. When a Load established an\n1168|    /// immutable editor authority, Apply consumes that tuple and refuses when\n1169|    /// the current identity no longer matches it — never reconstructing\n1170|    /// authority from the mutable current catalog. A direct Apply without a\n1171|    /// prior Load establishes its own start authority for that single write.\n1172|    /// Preserves the binding plus the starting login incarnation over every\n1173|    /// asynchronous boundary through confirmation and publication. Reuses the\n1174|    /// registration ownership and confirmation gates; API-only, no\n1175|    /// installer lease.\n1176|    private func applyGroupAccess(id: String, groupID: Int64, repos: Set<Int64>, allowTakeover: Bool) async {\n1177|        let gen = catalogGeneration\n1178|        let startedIdentity = await identities.load()\n1179|        let operation = beginGroupAccessOperation(id: id)\n1180|        await action { Runners.Action.groupAccessLoading(id) }\n1181|        do {\n1182|            if await editorRequiresReload(id: id) {\n1183|                await publishGroupAccessIfCurrent(id: id, operation: operation) {\n1184|                    Runners.Action.groupAccessInvalidated(id, \"Runner editor was invalidated (folder moved or identity changed). Reload group access before applying.\")\n1185|                }\n1186|                return\n1187|            }\n1188|            let verified: VerifiedOrgRunner\n1189|            if let stored = await storedEditorAuthority(id: id) {\n1190|                guard let consumed = try await consumeStoredEditorAuthority(stored, id: id, operation: operation) else { return }\n1191|                verified = consumed\n1192|            } else {\n1193|                verified = try await verifiedOrgRunner(id: id)\n1194|            }\n1195|            let auth = try await currentUserToken()\n1196|            if isCatalogStale(gen) {\n1197|                await abandonGroupAccessAfterCatalogChange(id: id, operation: operation)\n1198|                return\n1199|            }\n1200|            guard await sessionStill(startedIdentity) else {\n1201|                await releaseGroupAccessAfterSessionChange(id: id, operation: operation)\n1202|                return\n1203|            }\n1204|            try await bindApplyIdentity(verified: verified, auth: auth)\n1205|            // Fresh membership re-verified at write time: a move since the\n1206|            // UI loaded fails instead of editing the wrong group.\n1207|            let fresh = try await resolveFreshGroup(\n1208|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n1209|                auth: auth, generation: gen\n1210|            )\n1211|            guard fresh.id == groupID else {\n1212|                throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n1213|                    \"Runner moved from group \\(groupID) to '\\(fresh.name)' (\\(fresh.id)) since loading. Reload instead of editing a stale group.\"\n1214|                )\n1215|            }\n1216|            if isCatalogStale(gen) {\n1217|                await abandonGroupAccessAfterCatalogChange(id: id, operation: operation)\n1218|                return\n1219|            }\n1220|            let owned = await installer.loadOwnedGroupID(\n1221|                serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name\n1222|            )\n1223|            try RunnerRegistration.Gates.authorizeGroupTakeover(\n1224|                groupName: fresh.name, existingID: fresh.id,\n1225|                ownedID: owned, allowTakeover: allowTakeover\n1226|            )\n1227|            if owned != fresh.id {\n1228|                try await installer.saveOwnedGroupID(\n1229|                    serverHost: auth.identity.serverHost, org: verified.org, name: fresh.name, groupID: fresh.id\n1230|                )\n1231|            }\n1232|            if isCatalogStale(gen) {\n1233|                await abandonGroupAccessAfterCatalogChange(id: id, operation: operation)\n1234|                return\n1235|            }\n1236|            // Re-bind at the PUT boundary: the membership and ownership\n1237|            // awaits above must not carry stale identity into the write.\n1238|            guard await sessionStill(startedIdentity) else {\n1239|                await releaseGroupAccessAfterSessionChange(id: id, operation: operation)\n1240|                return\n1241|            }\n1242|            try await bindApplyIdentity(verified: verified, auth: auth)\n1243|            try await api.setGroupRepositories(\n1244|                config: auth.config, token: auth.token, org: verified.org,\n1245|                groupID: fresh.id, selectedRepositoryIDs: repos\n1246|            )\n1247|            if isCatalogStale(gen) {\n1248|                await abandonGroupAccessAfterCatalogChange(id: id, operation: operation)\n1249|                return\n1250|            }\n1251|            // Completion ownership: the issued PUT cannot be undone, but a\n1252|            // logout, account/server switch, or same-account re-login after\n1253|            // it refuses the confirmation read and any state publication\n1254|            // into the changed session incarnation — while still releasing\n1255|            // this operation's busy state so the editor can be retried.\n1256|            guard await sessionStill(startedIdentity) else {\n1257|                await releaseGroupAccessAfterSessionChange(id: id, operation: operation)\n1258|                return\n1259|            }\n1260|            let confirmed = try await api.fetchGroupRepositories(\n1261|                config: auth.config, token: auth.token, org: verified.org, groupID: fresh.id\n1262|            )\n1263|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: repos, confirmed: confirmed)\n1264|            if isCatalogStale(gen) {\n1265|                await abandonGroupAccessAfterCatalogChange(id: id, operation: operation)\n1266|                return\n1267|            }\n1268|            guard await sessionStill(startedIdentity) else {\n1269|                await releaseGroupAccessAfterSessionChange(id: id, operation: operation)\n1270|                return\n1271|            }\n1272|            let authorityHost = URL(string: (await installer.readLocalRegistration(directory: verified.directory))?.gitHubURL ?? \"\")?.host ?? verified.entry.serverHost ?? auth.identity.serverHost\n1273|            // A newer Load/Apply on this runner owns the editor now; this\n1274|            // completion stores and publishes nothing, not even cleanup.\n1275|            guard ownsGroupAccess(id: id, operation: operation) else { return }\n1276|            let authority = Runners.EditorAuthority(\n1277|                serverHost: authorityHost,\n1278|                org: verified.org, agentID: verified.agentID, agentName: verified.agentName,\n1279|                canonicalPath: RunnerCatalogStore.canonical(verified.directory),\n1280|                localID: verified.entry.localID\n1281|            )\n1282|            editorAuthorities[verified.entry.serviceLabel] = authority\n1283|            editorInvalidated.remove(verified.entry.serviceLabel)\n1284|            let access = Runners.GroupAccess(\n1285|                group: fresh, repoIDs: confirmed.sorted(), updatedAt: now(),\n1286|                owned: true, loading: false, authority: authority\n1287|            )\n1288|            await publishGroupAccessIfCurrent(id: id, operation: operation) {\n1289|                Runners.Action.groupAccessLoaded(id, access)\n1290|            }\n1291|            await publishGroupAccessIfCurrent(id: id, operation: operation) {\n1292|                Runners.Action.catalogCleared\n1293|            }\n1294|        } catch is CancellationError {\n1295|            await abandonGroupAccessAfterCatalogChange(id: id, operation: operation)\n1296|        } catch {\n1297|            if !isCatalogStale(gen), await sessionStill(startedIdentity) {\n1298|                let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n1299|                await publishGroupAccessIfCurrent(id: id, operation: operation) {\n1300|                    Runners.Action.groupAccessFailed(id, message)\n1301|                }\n1302|            } else if !isCatalogStale(gen) {\n1303|                await releaseGroupAccessAfterSessionChange(id: id, operation: operation)\n1304|            } else {\n1305|                await abandonGroupAccessAfterCatalogChange(id: id, operation: operation)\n1306|            }\n1307|        }\n1308|    }\n1309|\n1310|    // MARK: - Group-access operation ownership\n1311|\n1312|    /// Takes the next operation number for this editor. Every Load/Apply\n1313|    /// calls this before publishing its loading state.\n1314|    private func beginGroupAccessOperation(id: String) -> Int {\n1315|        let next = (groupAccessGeneration[id] ?? 0) + 1\n1316|        groupAccessGeneration[id] = next\n1317|        return next\n1318|    }\n1319|\n1320|    /// True when this operation is still the newest one for the editor.\n1321|    private func ownsGroupAccess(id: String, operation: Int) -> Bool {\n1322|        groupAccessGeneration[id] == operation\n1323|    }\n1324|\n1325|    /// Drops the operation ownership for both id spellings of an entry, so\n1326|    /// an in-flight Load/Apply can neither publish into nor release the\n1327|    /// editor after the entry is removed or relinked.\n1328|    private func dropGroupAccessOwnership(serviceLabel: String, localID: String) {\n1329|        groupAccessGeneration.removeValue(forKey: serviceLabel)\n1330|        groupAccessGeneration.removeValue(forKey: localID)\n1331|    }\n1332|\n1333|    /// Publishes only when this operation still owns the editor. A stale\n1334|    /// completion — superseded by a newer Load/Apply on the same runner —\n1335|    /// publishes nothing: no cleared busy state, no stale data.\n1336|    private func publishGroupAccessIfCurrent(\n1337|        id: String, operation: Int, makeAction: @Sendable () -> Runners.Action\n1338|    ) async {\n1339|        guard ownsGroupAccess(id: id, operation: operation) else { return }\n1340|        await action { makeAction() }\n1341|    }\n1342|\n1343|    /// Releases the busy state after a session invalidation, but only when\n1344|    /// this operation still owns the editor. Publishes an explicit retry\n1345|    /// message instead of stale data, so the UI returns to Load/refresh\n1346|    /// instead of wedging on a spinner.\n1347|    private func releaseGroupAccessAfterSessionChange(id: String, operation: Int) async {\n1348|        guard ownsGroupAccess(id: id, operation: operation) else { return }\n1349|        await action {\n1350|            Runners.Action.groupAccessFailed(\n1351|                id,\n1352|                \"GitHub session changed during group access. Reload group access to retry in the current session.\"\n1353|            )\n1354|        }\n1355|    }\n1356|\n1357|    /// Releases the busy state after the catalog changed under this\n1358|    /// operation, but only when this operation still owns the editor and the\n1359|    /// entry still exists. A removed entry needs no publication: its removal\n1360|    /// already pruned the editor state. A relinked entry was already\n1361|    /// released by its explicit invalidation.\n1362|    private func abandonGroupAccessAfterCatalogChange(id: String, operation: Int) async {\n1363|        guard ownsGroupAccess(id: id, operation: operation) else { return }\n1364|        let entries = await catalog.load()\n1365|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else { return }\n1366|        guard !editorInvalidated.contains(entry.serviceLabel) else { return }\n1367|        await action {\n1368|            Runners.Action.groupAccessFailed(\n1369|                id,\n1370|                \"Runner catalog changed during group access. Reload group access to retry.\"\n1371|            )\n1372|        }\n1373|    }\n1374|\n1375|    /// Looks up the immutable Load-time editor authority for this runner, if\n1376|    /// a Load established one. Keyed by the stable service label.\n1377|    private func storedEditorAuthority(id: String) async -> Runners.EditorAuthority? {\n1378|        let entries = await catalog.load()\n1379|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else { return nil }\n1380|        return editorAuthorities[entry.serviceLabel]\n1381|    }\n1382|\n1383|    /// True when a relocation or identity change invalidated the editor and\n1384|    /// an explicit Load is required before the next Apply.\n1385|    private func editorRequiresReload(id: String) async -> Bool {\n1386|        let entries = await catalog.load()\n1387|        guard let entry = entries.first(where: { $0.serviceLabel == id || $0.localID == id }) else { return false }\n1388|        return editorInvalidated.contains(entry.serviceLabel)\n1389|    }\n1390|}\n1391|\n1392|/// Import gates. Each gate refuses a concrete invalid class; negative tests\n1393|/// narrow every one of them.\n1394|public enum RunnersCatalogGates {\n1395|    public static func validateImportable(_ candidate: RunnerDiscovery.Candidate) throws {\n1396|        if candidate.controllerKind == .unsupported || candidate.unsupportedReason != nil {\n1397|            throw RunnerError.unsupported(candidate.unsupportedReason ?? \"Unsupported management.\")\n1398|        }\n1399|        if !candidate.registrationReadable {\n1400|            throw RunnerError.message(\"Cannot read .runner registration.\")\n1401|        }\n1402|        if candidate.agentName == nil || candidate.agentName?.isEmpty == true {\n1403|            throw RunnerError.message(\"Registration name is missing.\")\n1404|        }\n1405|        if candidate.serverHost == nil || candidate.scope == nil {\n1406|            throw RunnerError.message(\"Server or scope is undefined.\")\n1407|        }\n1408|        if !candidate.noSpacePath || !candidate.noSpaceWork {\n1409|            throw RunnerError.noSpacePath(\"Path or work folder contains a space; relocation is required.\")\n1410|        }\n1411|        if !candidate.runsvcExists || !candidate.binaryExists {\n1412|            throw RunnerError.message(\"Runner binaries are missing (run.sh / runsvc.sh).\")\n1413|        }\n1414|        if candidate.manifest == nil {\n1415|            // Folder imports without a manifest create a service; every other\n1416|            // check above must already have passed.\n1417|            return\n1418|        }\n1419|        if !candidate.manifestMatches {\n1420|            throw RunnerError.manifestMismatch(\"Service manifest does not match the runner directory.\")\n1421|        }\n1422|        if !candidate.issues.isEmpty {\n1423|            // Issues beyond the manifest notice (folder imports) refuse.\n1424|            let blocking = candidate.issues.filter { !$0.contains(\"No service manifest\") }\n1425|            if !blocking.isEmpty {\n1426|                throw RunnerError.message(blocking.joined(separator: \" \"))\n1427|            }\n1428|        }\n1429|    }\n1430|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
