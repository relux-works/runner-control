{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c565","stream":{"kind":"session","id":"01a0aa0a-86a0-7111-8cdf-bab999a2f9d6"},"sequence":269,"recorded_at":1780531400000533,"record_type":"event","durability":"durable","causation_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8","run_stream":{"kind":"run","id":"03f62105-9a02-4d8f-abd9-d3525c9bfed8"},"task_stream":{"kind":"task","id":"01a0aa0b-3f41-71e3-a28d-a1ffaa557f26"},"task_id":"01a0aa0b-3f41-71e3-a28d-a1ffaa557f26","event":{"kind":"output","task_id":"01a0aa0b-3f41-71e3-a28d-a1ffaa557f26","chunk":"Read text file `/tmp/rev5-probes.swift`.\n1|\n2|private actor ReviewR5TwoLoads: GitHubHTTPTransport {\n3|    var sends = 0\n4|    var gates: [Int: CheckedContinuation<Void, Never>] = [:]\n5|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n6|        sends += 1\n7|        let n = sends\n8|        if n <= 2 {\n9|            await withCheckedContinuation { gates[n] = $0 }\n10|            return groupsPayload([(4, \"g\")])\n11|        }\n12|        if request.url.path.contains(\"/runners\") { return groupRunnersPayload([(42, \"r\", false)]) }\n13|        return groupReposPayload([7])\n14|    }\n15|    func release(_ n: Int) { gates.removeValue(forKey: n)?.resume() }\n16|}\n17|\n18|@MainActor @Test func reviewR5RemoveReimportMustNotReviveOldEditorOwner() async throws {\n19|    let h = await catalogHarness()\n20|    defer { try? FileManager.default.removeItem(at: h.home); try? FileManager.default.removeItem(at: h.catalogFile) }\n21|    let label = \"actions.runner.test.owneraba\"\n22|    let dir = try makeRunnerDir(parent: h.home, name: \"r\", agentName: \"r\", scope: \"acme\", agentID: 42, label: label)\n23|    try await h.catalog.add(unregisterEntry(dir: dir, label: label))\n24|    let transport = ReviewR5TwoLoads()\n25|    let flow = await Runners.Flow(service: h.service, catalog: h.catalog, installer: h.installer,\n26|        api: GitHubRunnerAPIClient(transport: transport), userStore: h.userStore,\n27|        identities: h.identities, refresher: GitHubTokenRefresh(transport: transport, store: h.userStore),\n28|        configProvider: { _ in testConfig }, home: h.home, dispatcher: Relux.Dispatcher(logger: h.logger))\n29|    let first = Task { await flow.apply(Runners.Effect.loadGroupAccess(label)) }\n30|    let deadline = ContinuousClock.now.advanced(by: .seconds(3))\n31|    while await transport.sends < 1, ContinuousClock.now < deadline { try await Task.sleep(for: .milliseconds(5)) }\n32|    #expect(await transport.sends == 1)\n33|    _ = await flow.apply(Runners.Effect.removeFromApp(label))\n34|    _ = await flow.apply(Runners.Effect.importFolder(dir))\n35|    #expect(await h.catalog.load().first?.serviceLabel == label)\n36|    let second = Task { await flow.apply(Runners.Effect.loadGroupAccess(label)) }\n37|    let deadline2 = ContinuousClock.now.advanced(by: .seconds(3))\n38|    while await transport.sends < 2, ContinuousClock.now < deadline2 { try await Task.sleep(for: .milliseconds(5)) }\n39|    #expect(await transport.sends == 2)\n40|    await transport.release(1)\n41|    _ = await first.value\n42|    let state = Runners.State(definitions: [])\n43|    for action in runnersActions(h.logger) { await state.reduce(with: action) }\n44|    #expect(state.groupAccess[label]?.loading == true, \"Old operation must not clear the newer pending Load\")\n45|    #expect(state.groupAccess[label]?.error == nil, \"Old operation must not publish its catalog-change error into new editor\")\n46|    await transport.release(2)\n47|    _ = await second.value\n48|}","final_result":true}}}
