{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c895","stream":{"kind":"session","id":"01a0a801-0567-73c0-8c2c-4cc236f90421"},"sequence":677,"recorded_at":1780531400001349,"record_type":"event","durability":"durable","causation_id":"98b36224-760c-4ad5-9bfe-0ec4d038663d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"98b36224-760c-4ad5-9bfe-0ec4d038663d","run_stream":{"kind":"run","id":"98b36224-760c-4ad5-9bfe-0ec4d038663d"},"task_stream":{"kind":"task","id":"01a0a806-d205-7123-9a55-eef9b23158dc"},"task_id":"01a0a806-d205-7123-9a55-eef9b23158dc","event":{"kind":"output","task_id":"01a0a806-d205-7123-9a55-eef9b23158dc","chunk":"Read text file `Scripts/tests/test_release_metadata.py`.\n1|import base64\n2|import copy\n3|import importlib.util\n4|from pathlib import Path\n5|import tempfile\n6|import unittest\n7|\n8|spec = importlib.util.spec_from_file_location('metadata', Path(__file__).parents[1] / 'release_metadata.py')\n9|m = importlib.util.module_from_spec(spec)\n10|spec.loader.exec_module(m)\n11|\n12|class ReleaseMetadataTests(unittest.TestCase):\n13|    def setUp(self):\n14|        self.config = {'marketing_version': '1.1.0', 'bundle_id': 'works.relux.runnercontrol',\n15|                       'team_id': '262RZ595FP', 'macos': {'info_plist': {\n16|                           'SUFeedURL': m.FEED, 'SUPublicEDKey': base64.b64encode(bytes(32)).decode()}}}\n17|    def test_builds_increase_between_attempts_and_runs(self):\n18|        values = [m.prepare(copy.deepcopy(self.config), 'v1.1.0', r, a)['project_version']\n19|                  for r, a in [(1, 1), (1, 2), (2, 1)]]\n20|        self.assertEqual(values, ['101.1', '101.2', '102.1'])\n21|    def test_rejects_wrong_tag_or_identity(self):\n22|        for tag in ['v1.0.0', 'main', 'v1.1.0;echo']:\n23|            with self.assertRaises(ValueError): m.prepare(copy.deepcopy(self.config), tag, 1, 1)\n24|        self.config['team_id'] = 'OTHERTEAM'\n25|        with self.assertRaises(ValueError): m.prepare(self.config, 'v1.1.0', 1, 1)\n26|    def test_rejects_wrong_feed(self):\n27|        self.config['macos']['info_plist']['SUFeedURL'] = 'https://example.org/feed'\n28|        with self.assertRaises(ValueError): m.prepare(self.config, 'v1.1.0', 1, 1)\n29|    def test_appcast_archive_binding(self):\n30|        with tempfile.TemporaryDirectory() as d:\n31|            dmg = Path(d) / 'RunnerControl.dmg'; dmg.write_bytes(b'archive')\n32|            feed = Path(d) / 'appcast.xml'\n33|            xml = f'''<rss xmlns:sparkle=\"{m.NS[1:-1]}\"><channel><item>\n34|              <sparkle:version>101.1</sparkle:version><sparkle:shortVersionString>1.1.0</sparkle:shortVersionString>\n35|              <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>\n36|              <enclosure url=\"https://github.com/{m.REPO}/releases/download/v1.1.0/RunnerControl.dmg\"\n37|              length=\"7\" sparkle:edSignature=\"{base64.b64encode(bytes(64)).decode()}\"/>\n38|              </item></channel></rss>'''\n39|            feed.write_text(xml)\n40|            m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')\n41|            for bad in [xml.replace('length=\"7\"', 'length=\"8\"'), xml.replace('/v1.1.0/', '/v9.0.0/'),\n42|                        xml.replace('101.1', '100.1'), xml.replace('14.0', '13.0')]:\n43|                feed.write_text(bad)\n44|                with self.assertRaises(ValueError): m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')","final_result":true}}}
