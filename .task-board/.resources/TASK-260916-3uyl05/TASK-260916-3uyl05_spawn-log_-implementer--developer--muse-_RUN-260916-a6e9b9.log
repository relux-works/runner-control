 present? ===\\n1\\n=== default keychain ===\\n    \\\"/Users/iv/Library/Keychains/login.keychain-db\\\"\\n=== keychain list ===\\n    \\\"/Users/iv/Library/Keychains/login.keychain-db\\\"\\n    \\\"/Library/Keychains/System.keychain\\\"\\n=== login keychain info (lock state only) ===\\nKeychain \\\"/Users/iv/Library/Keychains/login.keychain-db\\\" no-timeout\\n\",\n  \"original_output_bytes\": 554,\n  \"original_output_tokens\": 139,\n  \"truncated\": false\n}","final_result":true}}}
