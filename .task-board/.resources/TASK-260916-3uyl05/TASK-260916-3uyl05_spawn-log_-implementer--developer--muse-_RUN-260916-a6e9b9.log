{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c74f","stream":{"kind":"session","id":"01a0a801-0567-73c0-8c2c-4cc236f90421"},"sequence":514,"recorded_at":1780531400001023,"record_type":"event","durability":"durable","causation_id":"98b36224-760c-4ad5-9bfe-0ec4d038663d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"98b36224-760c-4ad5-9bfe-0ec4d038663d","run_stream":{"kind":"run","id":"98b36224-760c-4ad5-9bfe-0ec4d038663d"},"task_stream":{"kind":"task","id":"01a0a806-63a9-7090-bf7a-abbf0fcd458e"},"task_id":"01a0a806-63a9-7090-bf7a-abbf0fcd458e","event":{"kind":"output","task_id":"01a0a806-63a9-7090-bf7a-abbf0fcd458e","chunk":"Read text file `Scripts/release_metadata.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Validate release identity and appcast metadata without handling private keys.\"\"\"\n3|import argparse\n4|import base64\n5|import json\n6|from pathlib import Path\n7|import re\n8|import xml.etree.ElementTree as ET\n9|\n10|REPO = 'relux-works/runner-control'\n11|FEED = f'https://github.com/{REPO}/releases/latest/download/appcast.xml'\n12|NS = '{http://www.andymatuschak.org/xml-namespaces/sparkle}'\n13|\n14|def prepare(config, tag, run, attempt):\n15|    if not re.fullmatch(r'v\\d+\\.\\d+\\.\\d+', tag):\n16|        raise ValueError('Release tag must be vMAJOR.MINOR.PATCH')\n17|    if config['marketing_version'] != tag[1:]:\n18|        raise ValueError('Tag must match marketing_version in ios-app-manager.json')\n19|    if config['bundle_id'] != 'works.relux.runnercontrol' or config['team_id'] != '262RZ595FP':\n20|        raise ValueError('Unexpected bundle ID or signing team')\n21|    if not 1 <= run <= 9899 or not 1 <= attempt <= 99:\n22|        raise ValueError('Invalid release run/attempt number')\n23|    if config['macos']['info_plist']['SUFeedURL'] != FEED:\n24|        raise ValueError('Unexpected public update feed')\n25|    key = base64.b64decode(config['macos']['info_plist']['SUPublicEDKey'], validate=True)\n26|    if len(key) != 32:\n27|        raise ValueError('Invalid Sparkle public key')\n28|    config['project_version'] = f'{100 + run}.{attempt}'\n29|    return config\n30|\n31|def verify_appcast(path, dmg, tag, build):\n32|    root = ET.parse(path).getroot()\n33|    items = root.findall('./channel/item')\n34|    if len(items) != 1:\n35|        raise ValueError('Expected one current release in appcast')\n36|    item = items[0]\n37|    if item.findtext(NS + 'version') != build:\n38|        raise ValueError('Appcast build does not match app build')\n39|    if item.findtext(NS + 'shortVersionString') != tag[1:]:\n40|        raise ValueError('Appcast release version mismatch')\n41|    enclosure = item.find('enclosure')\n42|    if enclosure is None or enclosure.get('url') != f'https://github.com/{REPO}/releases/download/{tag}/RunnerControl.dmg':\n43|        raise ValueError('Unexpected download URL')\n44|    signature = base64.b64decode(enclosure.get(NS + 'edSignature', ''), validate=True)\n45|    if len(signature) != 64 or int(enclosure.get('length', '0')) != dmg.stat().st_size:\n46|        raise ValueError('Missing signature or archive length mismatch')\n47|    minimum = item.findtext(NS + 'minimumSystemVersion')\n48|    if not minimum or int(minimum.split('.')[0]) < 14:\n49|        raise ValueError('Missing minimum macOS requirement')\n50|\n51|def main():\n52|    parser = argparse.ArgumentParser()\n53|    sub = parser.add_subparsers(dest='command', required=True)\n54|    prep = sub.add_parser('prepare')\n55|    prep.add_argument('--config', type=Path, required=True)\n56|    prep.add_argument('--tag', required=True)\n57|    prep.add_argument('--run', type=int, required=True)\n58|    prep.add_argument('--attempt', type=int, required=True)\n59|    verify = sub.add_parser('verify')\n60|    verify.add_argument('--appcast', type=Path, required=True)\n61|    verify.add_argument('--dmg', type=Path, required=True)\n62|    verify.add_argument('--tag', required=True)\n63|    verify.add_argument('--build', required=True)\n64|    args = parser.parse_args()\n65|    if args.command == 'prepare':\n66|        data = prepare(json.loads(args.config.read_text()), args.tag, args.run, args.attempt)\n67|        args.config.write_text(json.dumps(data, indent=2) + '\\n')\n68|        print(data['project_version'])\n69|    else:\n70|        verify_appcast(args.appcast, args.dmg, args.tag, args.build)\n71|        print('Appcast identity, signature presence, size and minimum OS verified')\n72|\n73|if __name__ == '__main__':\n74|    main()","final_result":true}}}
