{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c83f","stream":{"kind":"session","id":"01a0a801-0567-73c0-8c2c-4cc236f90421"},"sequence":634,"recorded_at":1780531400001263,"record_type":"event","durability":"durable","causation_id":"98b36224-760c-4ad5-9bfe-0ec4d038663d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"98b36224-760c-4ad5-9bfe-0ec4d038663d","run_stream":{"kind":"run","id":"98b36224-760c-4ad5-9bfe-0ec4d038663d"},"task_stream":{"kind":"task","id":"01a0a806-b795-7cc1-a9ed-aa649c2139b6"},"task_id":"01a0a806-b795-7cc1-a9ed-aa649c2139b6","event":{"kind":"output","task_id":"01a0a806-b795-7cc1-a9ed-aa649c2139b6","chunk":"Read text file `Scripts/release.sh`.\n1|#!/bin/bash\n2|# Build, notarize and package. Never publishes a failed/unnotarized build.\n3|set -euo pipefail\n4|root=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n5|cd \"$root\"\n6|: \"${RELEASE_TAG:?Set RELEASE_TAG to an existing vMAJOR.MINOR.PATCH tag}\"\n7|: \"${GITHUB_RUN_NUMBER:?Use the GitHub release workflow for monotonic build numbers}\"\n8|: \"${GITHUB_RUN_ATTEMPT:?Missing workflow run attempt}\"\n9|: \"${IOS_APP_MANAGER:?Set IOS_APP_MANAGER to the pinned generator binary}\"\n10|./Scripts/release-preflight.sh\n11|build=\"$(python3 Scripts/release_metadata.py prepare --config ios-app-manager.json --tag \"$RELEASE_TAG\" --run \"$GITHUB_RUN_NUMBER\" --attempt \"$GITHUB_RUN_ATTEMPT\")\"\n12|\"$IOS_APP_MANAGER\" generate macos-app --config ios-app-manager.json\n13|tuist generate --no-open\n14|release_root=\"$root/.temp/release-$build\"\n15|mkdir -p \"$release_root/dist\" \"$release_root/image\"\n16|archive=\"$release_root/RunnerControl.xcarchive\"\n17|xcodebuild -workspace RunnerControl.xcworkspace -scheme RunnerControl -configuration Release \\\n18|  -destination 'generic/platform=macOS' -archivePath \"$archive\" \\\n19|  -derivedDataPath \"$release_root/DerivedData\" \\\n20|  CONFIGURATION_BUILD_DIR=\"$release_root/products\" \\\n21|  CODE_SIGN_IDENTITY='Developer ID Application' DEVELOPMENT_TEAM=262RZ595FP \\\n22|  CODE_SIGN_STYLE=Manual ENABLE_HARDENED_RUNTIME=YES \\\n23|  OTHER_CODE_SIGN_FLAGS='--timestamp' archive > \"$release_root/archive.log\" 2>&1\n24|cat > \"$release_root/ExportOptions.plist\" <<'PLIST'\n25|<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n26|<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n27|<plist version=\"1.0\"><dict>\n28|<key>method</key><string>developer-id</string>\n29|<key>teamID</key><string>262RZ595FP</string>\n30|<key>signingStyle</key><string>manual</string>\n31|<key>signingCertificate</key><string>Developer ID Application</string>\n32|</dict></plist>\n33|PLIST\n34|xcodebuild -exportArchive -archivePath \"$archive\" -exportPath \"$release_root/export\" \\\n35|  -exportOptionsPlist \"$release_root/ExportOptions.plist\" > \"$release_root/export.log\" 2>&1\n36|app=\"$release_root/export/RunnerControl.app\"\n37|codesign --verify --deep --strict \"$app\"\n38|metadata=\"$(codesign -dvv \"$app\" 2>&1)\"\n39|grep -q 'TeamIdentifier=262RZ595FP' <<< \"$metadata\"\n40|grep -q 'Authority=Developer ID Application:' <<< \"$metadata\"\n41|notarize() {\n42|  local artifact=\"$1\" result=\"$2\"\n43|  xcrun notarytool submit \"$artifact\" --keychain-profile \"${NOTARY_PROFILE:-RunnerControl-notary}\" \\\n44|    --wait --timeout 30m --output-format json > \"$result\"\n45|  python3 - \"$result\" <<'PY'\n46|import json,sys\n47|r=json.load(open(sys.argv[1]))\n48|if r.get('status') != 'Accepted':\n49|    raise SystemExit('Apple did not accept this submission: ' + str(r))\n50|PY\n51|}\n52|ditto -c -k --keepParent \"$app\" \"$release_root/RunnerControl.zip\"\n53|notarize \"$release_root/RunnerControl.zip\" \"$release_root/app-notary.json\"\n54|xcrun stapler staple \"$app\"\n55|xcrun stapler validate \"$app\"\n56|spctl --assess --type execute --verbose \"$app\"\n57|ditto \"$app\" \"$release_root/image/RunnerControl.app\"\n58|ln -s /Applications \"$release_root/image/Applications\"\n59|hdiutil create -volname 'Runner Control' -srcfolder \"$release_root/image\" -fs APFS \\\n60|  -format ULFO \"$release_root/dist/RunnerControl.dmg\"\n61|signing_identity=\"$(security find-identity -v -p codesigning | sed -nE '/Developer ID Application:.*\\(262RZ595FP\\)/s/.*[0-9]+\\) ([A-Fa-f0-9]+) .*/\\1/p' | head -n 1)\"\n62|codesign --force --timestamp --sign \"$signing_identity\" \"$release_root/dist/RunnerControl.dmg\"\n63|notarize \"$release_root/dist/RunnerControl.dmg\" \"$release_root/dmg-notary.json\"\n64|xcrun stapler staple \"$release_root/dist/RunnerControl.dmg\"\n65|xcrun stapler validate \"$release_root/dist/RunnerControl.dmg\"\n66|sparkle_bin=\"$(./Scripts/sparkle-tools.sh)\"\n67|\"$sparkle_bin/generate_appcast\" --account works.relux.runnercontrol \\\n68|  --maximum-versions 1 --maximum-deltas 0 \\\n69|  --download-url-prefix \"https://github.com/relux-works/runner-control/releases/download/$RELEASE_TAG/\" \\\n70|  --link 'https://github.com/relux-works/runner-control' \"$release_root/dist\"\n71|python3 Scripts/release_metadata.py verify --appcast \"$release_root/dist/appcast.xml\" \\\n72|  --dmg \"$release_root/dist/RunnerControl.dmg\" --tag \"$RELEASE_TAG\" --build \"$build\"\n73|(cd \"$release_root/dist\" && shasum -a 256 RunnerControl.dmg appcast.xml > SHA256SUMS)\n74|if [ -n \"${GITHUB_OUTPUT:-}\" ]; then printf 'dist=%s\\n' \"$release_root/dist\" >> \"$GITHUB_OUTPUT\"; fi\n75|printf 'Notarized release assets: %s\\n' \"$release_root/dist\"","final_result":true}}}
