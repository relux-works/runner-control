{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c753","stream":{"kind":"session","id":"01a0a801-0567-73c0-8c2c-4cc236f90421"},"sequence":516,"recorded_at":1780531400001027,"record_type":"event","durability":"durable","causation_id":"98b36224-760c-4ad5-9bfe-0ec4d038663d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"98b36224-760c-4ad5-9bfe-0ec4d038663d","run_stream":{"kind":"run","id":"98b36224-760c-4ad5-9bfe-0ec4d038663d"},"task_stream":{"kind":"task","id":"01a0a806-6372-7db1-87dc-1286c12c3312"},"task_id":"01a0a806-6372-7db1-87dc-1286c12c3312","event":{"kind":"output","task_id":"01a0a806-6372-7db1-87dc-1286c12c3312","chunk":"Read text file `Scripts/release-preflight.sh`.\n1|#!/bin/bash\n2|set -euo pipefail\n3|for tool in xcodebuild xcrun codesign security hdiutil tuist gh python3; do\n4|  command -v \"$tool\" >/dev/null || { echo \"Missing release tool: $tool\" >&2; exit 1; }\n5|done\n6|if ! security find-identity -v -p codesigning | grep -E 'Developer ID Application:.*\\(262RZ595FP\\)' >/dev/null; then\n7|  echo 'Missing Developer ID Application identity with private key for team 262RZ595FP.' >&2\n8|  echo 'An Account Holder must issue it; Apple Development or another team cannot be substituted.' >&2\n9|  exit 1\n10|fi\n11|xcrun notarytool history --keychain-profile \"${NOTARY_PROFILE:-RunnerControl-notary}\" --output-format json >/dev/null\n12|root=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n13|cd \"$root\"\n14|sparkle_bin=\"$(\"$root/Scripts/sparkle-tools.sh\")\"\n15|actual=\"$(\"$sparkle_bin/generate_keys\" --account works.relux.runnercontrol -p)\"\n16|expected=\"$(python3 -c 'import json; print(json.load(open(\"ios-app-manager.json\"))[\"macos\"][\"info_plist\"][\"SUPublicEDKey\"])')\"\n17|[ \"$actual\" = \"$expected\" ] || { echo 'Sparkle signing key is missing or does not match the app public key.' >&2; exit 1; }","final_result":true}}}
