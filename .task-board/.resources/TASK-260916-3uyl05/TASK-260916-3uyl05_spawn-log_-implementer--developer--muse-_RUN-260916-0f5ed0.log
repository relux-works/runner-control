{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c45d","stream":{"kind":"session","id":"01a0a811-e233-7700-9f73-d0f94294967e"},"sequence":137,"recorded_at":1780531400000269,"record_type":"event","durability":"durable","causation_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","run_stream":{"kind":"run","id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d"},"task_stream":{"kind":"task","id":"01a0a812-47f1-7773-8ee9-c93df93a3287"},"task_id":"01a0a812-47f1-7773-8ee9-c93df93a3287","event":{"kind":"output","task_id":"01a0a812-47f1-7773-8ee9-c93df93a3287","chunk":"Read text file `Scripts/release_metadata.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Validate release identity and appcast metadata without handling private keys.\"\"\"\n3|import argparse\n4|import base64\n5|import json\n6|from pathlib import Path\n7|import re\n8|import sys\n9|import xml.etree.ElementTree as ET\n10|\n11|REPO = 'relux-works/runner-control'\n12|FEED = f'https://github.com/{REPO}/releases/latest/download/appcast.xml'\n13|NS = '{http://www.andymatuschak.org/xml-namespaces/sparkle}'\n14|\n15|def prepare(config, tag, run, attempt):\n16|    if not re.fullmatch(r'v\\d+\\.\\d+\\.\\d+', tag):\n17|        raise ValueError('Release tag must be vMAJOR.MINOR.PATCH')\n18|    if config['marketing_version'] != tag[1:]:\n19|        raise ValueError('Tag must match marketing_version in ios-app-manager.json')\n20|    if config['bundle_id'] != 'works.relux.runnercontrol' or config['team_id'] != '262RZ595FP':\n21|        raise ValueError('Unexpected bundle ID or signing team')\n22|    if not 1 <= run <= 9899 or not 1 <= attempt <= 99:\n23|        raise ValueError('Invalid release run/attempt number')\n24|    if config['macos']['info_plist']['SUFeedURL'] != FEED:\n25|        raise ValueError('Unexpected public update feed')\n26|    key = base64.b64decode(config['macos']['info_plist']['SUPublicEDKey'], validate=True)\n27|    if len(key) != 32:\n28|        raise ValueError('Invalid Sparkle public key')\n29|    config['project_version'] = f'{100 + run}.{attempt}'\n30|    return config\n31|\n32|def resolve_signing_identity(find_identity_output, team):\n33|    \"\"\"Return the Developer ID Application SHA-1 for team.\n34|\n35|    Parses `security find-identity -v -p codesigning` output. Apple\n36|    Development and other-team identities are ignored. Zero or several\n37|    matches fail so release signing never silently picks a wrong key.\n38|    \"\"\"\n39|    matches = []\n40|    for line in find_identity_output.splitlines():\n41|        if 'Developer ID Application:' not in line or f'({team})' not in line:\n42|            continue\n43|        found = re.search(r'\\b([A-F0-9]{40})\\b', line)\n44|        if found:\n45|            matches.append(found.group(1))\n46|    if not matches:\n47|        raise ValueError(f'No Developer ID Application identity for team {team}')\n48|    if len(matches) > 1:\n49|        raise ValueError(f'Multiple Developer ID Application identities for team {team}; remove the stale certificate')\n50|    return matches[0]\n51|\n52|def verify_appcast(path, dmg, tag, build):\n53|    root = ET.parse(path).getroot()\n54|    items = root.findall('./channel/item')\n55|    if len(items) != 1:\n56|        raise ValueError('Expected one current release in appcast')\n57|    item = items[0]\n58|    if item.findtext(NS + 'version') != build:\n59|        raise ValueError('Appcast build does not match app build')\n60|    if item.findtext(NS + 'shortVersionString') != tag[1:]:\n61|        raise ValueError('Appcast release version mismatch')\n62|    enclosure = item.find('enclosure')\n63|    if enclosure is None or enclosure.get('url') != f'https://github.com/{REPO}/releases/download/{tag}/RunnerControl.dmg':\n64|        raise ValueError('Unexpected download URL')\n65|    signature = base64.b64decode(enclosure.get(NS + 'edSignature', ''), validate=True)\n66|    if len(signature) != 64 or int(enclosure.get('length', '0')) != dmg.stat().st_size:\n67|        raise ValueError('Missing signature or archive length mismatch')\n68|    minimum = item.findtext(NS + 'minimumSystemVersion')\n69|    if not minimum or int(minimum.split('.')[0]) < 14:\n70|        raise ValueError('Missing minimum macOS requirement')\n71|\n72|def main():\n73|    parser = argparse.ArgumentParser()\n74|    sub = parser.add_subparsers(dest='command', required=True)\n75|    prep = sub.add_parser('prepare')\n76|    prep.add_argument('--config', type=Path, required=True)\n77|    prep.add_argument('--tag', required=True)\n78|    prep.add_argument('--run', type=int, required=True)\n79|    prep.add_argument('--attempt', type=int, required=True)\n80|    verify = sub.add_parser('verify')\n81|    verify.add_argument('--appcast', type=Path, required=True)\n82|    verify.add_argument('--dmg', type=Path, required=True)\n83|    verify.add_argument('--tag', required=True)\n84|    verify.add_argument('--build', required=True)\n85|    sig = sub.add_parser('signing-identity')\n86|    sig.add_argument('--team', required=True)\n87|    args = parser.parse_args()\n88|    if args.command == 'prepare':\n89|        data = prepare(json.loads(args.config.read_text()), args.tag, args.run, args.attempt)\n90|        args.config.write_text(json.dumps(data, indent=2) + '\\n')\n91|        print(data['project_version'])\n92|    elif args.command == 'signing-identity':\n93|        print(resolve_signing_identity(sys.stdin.read(), args.team))\n94|    else:\n95|        verify_appcast(args.appcast, args.dmg, args.tag, args.build)\n96|        print('Appcast identity, signature presence, size and minimum OS verified')\n97|\n98|if __name__ == '__main__':\n99|    main()","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c45f","stream":{"kind":"session","id":"01a0a811-e233-7700-9f73-d0f94294967e"},"sequence":138,"recorded_at":1780531400000271,"record_type":"event","durability":"durable","causation_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","run_stream":{"kind":"run","id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d"},"task_stream":{"kind":"task","id":"01a0a812-47f1-7773-8ee9-c93df93a3287"},"task_id":"01a0a812-47f1-7773-8ee9-c93df93a3287","event":{"kind":"completed","task_id":"01a0a812-47f1-7773-8ee9-c93df93a3287"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c461","stream":{"kind":"session","id":"01a0a811-e233-7700-9f73-d0f94294967e"},"sequence":139,"recorded_at":1780531400000273,"record_type":"event","durability":"durable","causation_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","run_stream":{"kind":"run","id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d"},"task_stream":{"kind":"task","id":"01a0a812-46eb-78b2-828d-53e269401dfa"},"task_id":"01a0a812-46eb-78b2-828d-53e269401dfa","event":{"kind":"output","task_id":"01a0a812-46eb-78b2-828d-53e269401dfa","chunk":"Read text file `Scripts/release.sh`.\n1|#!/bin/bash\n2|# Build, notarize and package. Never publishes a failed/unnotarized build.\n3|set -euo pipefail\n4|root=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n5|cd \"$root\"\n6|: \"${RELEASE_TAG:?Set RELEASE_TAG to an existing vMAJOR.MINOR.PATCH tag}\"\n7|: \"${GITHUB_RUN_NUMBER:?Use the GitHub release workflow for monotonic build numbers}\"\n8|: \"${GITHUB_RUN_ATTEMPT:?Missing workflow run attempt}\"\n9|: \"${IOS_APP_MANAGER:?Set IOS_APP_MANAGER to the pinned generator binary}\"\n10|./Scripts/release-preflight.sh\n11|build=\"$(python3 Scripts/release_metadata.py prepare --config ios-app-manager.json --tag \"$RELEASE_TAG\" --run \"$GITHUB_RUN_NUMBER\" --attempt \"$GITHUB_RUN_ATTEMPT\")\"\n12|\"$IOS_APP_MANAGER\" generate macos-app --config ios-app-manager.json\n13|tuist generate --no-open\n14|release_root=\"$root/.temp/release-$build\"\n15|mkdir -p \"$release_root/dist\" \"$release_root/image\"\n16|archive=\"$release_root/RunnerControl.xcarchive\"\n17|xcodebuild -workspace RunnerControl.xcworkspace -scheme RunnerControl -configuration Release \\\n18|  -destination 'generic/platform=macOS' -archivePath \"$archive\" \\\n19|  -derivedDataPath \"$release_root/DerivedData\" \\\n20|  CONFIGURATION_BUILD_DIR=\"$release_root/products\" \\\n21|  CODE_SIGN_IDENTITY='Developer ID Application' DEVELOPMENT_TEAM=262RZ595FP \\\n22|  CODE_SIGN_STYLE=Manual ENABLE_HARDENED_RUNTIME=YES \\\n23|  OTHER_CODE_SIGN_FLAGS='--timestamp' archive > \"$release_root/archive.log\" 2>&1\n24|cat > \"$release_root/ExportOptions.plist\" <<'PLIST'\n25|<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n26|<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n27|<plist version=\"1.0\"><dict>\n28|<key>method</key><string>developer-id</string>\n29|<key>teamID</key><string>262RZ595FP</string>\n30|<key>signingStyle</key><string>manual</string>\n31|<key>signingCertificate</key><string>Developer ID Application</string>\n32|</dict></plist>\n33|PLIST\n34|xcodebuild -exportArchive -archivePath \"$archive\" -exportPath \"$release_root/export\" \\\n35|  -exportOptionsPlist \"$release_root/ExportOptions.plist\" > \"$release_root/export.log\" 2>&1\n36|app=\"$release_root/export/RunnerControl.app\"\n37|codesign --verify --deep --strict \"$app\"\n38|metadata=\"$(codesign -dvv \"$app\" 2>&1)\"\n39|grep -q 'TeamIdentifier=262RZ595FP' <<< \"$metadata\"\n40|grep -q 'Authority=Developer ID Application:' <<< \"$metadata\"\n41|notarize() {\n42|  local artifact=\"$1\" result=\"$2\"\n43|  xcrun notarytool submit \"$artifact\" --keychain-profile \"${NOTARY_PROFILE:-RunnerControl-notary}\" \\\n44|    --wait --timeout 30m --output-format json > \"$result\"\n45|  python3 - \"$result\" <<'PY'\n46|import json,sys\n47|r=json.load(open(sys.argv[1]))\n48|if r.get('status') != 'Accepted':\n49|    raise SystemExit('Apple did not accept this submission: ' + str(r))\n50|PY\n51|}\n52|ditto -c -k --keepParent \"$app\" \"$release_root/RunnerControl.zip\"\n53|notarize \"$release_root/RunnerControl.zip\" \"$release_root/app-notary.json\"\n54|xcrun stapler staple \"$app\"\n55|xcrun stapler validate \"$app\"\n56|spctl --assess --type execute --verbose \"$app\"\n57|ditto \"$app\" \"$release_root/image/RunnerControl.app\"\n58|ln -s /Applications \"$release_root/image/Applications\"\n59|hdiutil create -volname 'Runner Control' -srcfolder \"$release_root/image\" -fs APFS \\\n60|  -format ULFO \"$release_root/dist/RunnerControl.dmg\"\n61|signing_identity=\"$(security find-identity -v -p codesigning | python3 Scripts/release_metadata.py signing-identity --team 262RZ595FP)\"\n62|codesign --force --timestamp --sign \"$signing_identity\" \"$release_root/dist/RunnerControl.dmg\"\n63|notarize \"$release_root/dist/RunnerControl.dmg\" \"$release_root/dmg-notary.json\"\n64|xcrun stapler staple \"$release_root/dist/RunnerControl.dmg\"\n65|xcrun stapler validate \"$release_root/dist/RunnerControl.dmg\"\n66|sparkle_bin=\"$(./Scripts/sparkle-tools.sh)\"\n67|\"$sparkle_bin/generate_appcast\" --account works.relux.runnercontrol \\\n68|  --maximum-versions 1 --maximum-deltas 0 \\\n69|  --download-url-prefix \"https://github.com/relux-works/runner-control/releases/download/$RELEASE_TAG/\" \\\n70|  --link 'https://github.com/relux-works/runner-control' \"$release_root/dist\"\n71|python3 Scripts/release_metadata.py verify --appcast \"$release_root/dist/appcast.xml\" \\\n72|  --dmg \"$release_root/dist/RunnerControl.dmg\" --tag \"$RELEASE_TAG\" --build \"$build\"\n73|(cd \"$release_root/dist\" && shasum -a 256 RunnerControl.dmg appcast.xml > SHA256SUMS)\n74|if [ -n \"${GITHUB_OUTPUT:-}\" ]; then printf 'dist=%s\\n' \"$release_root/dist\" >> \"$GITHUB_OUTPUT\"; fi\n75|printf 'Notarized release assets: %s\\n' \"$release_root/dist\"","final_result":true}}}
