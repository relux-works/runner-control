}-${{ github.run_attempt }}\n75|          path: |\n76|            .temp/release-*/archive.log\n77|            .temp/release-*/export.log\n78|            .temp/release-*/*-notary.json\n79|          if-no-files-found: ignore\n80|          retention-days: 14","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c473","stream":{"kind":"session","id":"01a0a811-e233-7700-9f73-d0f94294967e"},"sequence":148,"recorded_at":1780531400000291,"record_type":"event","durability":"durable","causation_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","run_stream":{"kind":"run","id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d"},"call_id":"call_01a0a812413671d486a6fe3703b147f7","text":"Read text file `Scripts/release.sh`.\n1|#!/bin/bash\n2|# Build, notarize and package. Never publishes a failed/unnotarized build.\n3|set -euo pipefail\n4|root=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n5|cd \"$root\"\n6|: \"${RELEASE_TAG:?Set RELEASE_TAG to an existing vMAJOR.MINOR.PATCH tag}\"\n7|: \"${GITHUB_RUN_NUMBER:?Use the GitHub release workflow for monotonic build numbers}\"\n8|: \"${GITHUB_RUN_ATTEMPT:?Missing workflow run attempt}\"\n9|: \"${IOS_APP_MANAGER:?Set IOS_APP_MANAGER to the pinned generator binary}\"\n10|./Scripts/release-preflight.sh\n11|build=\"$(python3 Scripts/release_metadata.py prepare --config ios-app-manager.json --tag \"$RELEASE_TAG\" --run \"$GITHUB_RUN_NUMBER\" --attempt \"$GITHUB_RUN_ATTEMPT\")\"\n12|\"$IOS_APP_MANAGER\" generate macos-app --config ios-app-manager.json\n13|tuist generate --no-open\n14|release_root=\"$root/.temp/release-$build\"\n15|mkdir -p \"$release_root/dist\" \"$release_root/image\"\n16|archive=\"$release_root/RunnerControl.xcarchive\"\n17|xcodebuild -workspace RunnerControl.xcworkspace -scheme RunnerControl -configuration Release \\\n18|  -destination 'generic/platform=macOS' -archivePath \"$archive\" \\\n19|  -derivedDataPath \"$release_root/DerivedData\" \\\n20|  CONFIGURATION_BUILD_DIR=\"$release_root/products\" \\\n21|  CODE_SIGN_IDENTITY='Developer ID Application' DEVELOPMENT_TEAM=262RZ595FP \\\n22|  CODE_SIGN_STYLE=Manual ENABLE_HARDENED_RUNTIME=YES \\\n23|  OTHER_CODE_SIGN_FLAGS='--timestamp' archive > \"$release_root/archive.log\" 2>&1\n24|cat > \"$release_root/ExportOptions.plist\" <<'PLIST'\n25|<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n26|<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n27|<plist version=\"1.0\"><dict>\n28|<key>method</key><string>developer-id</string>\n29|<key>teamID</key><string>262RZ595FP</string>\n30|<key>signingStyle</key><string>manual</string>\n31|<key>signingCertificate</key><string>Developer ID Application</string>\n32|</dict></plist>\n33|PLIST\n34|xcodebuild -exportArchive -archivePath \"$archive\" -exportPath \"$release_root/export\" \\\n35|  -exportOptionsPlist \"$release_root/ExportOptions.plist\" > \"$release_root/export.log\" 2>&1\n36|app=\"$release_root/export/RunnerControl.app\"\n37|codesign --verify --deep --strict \"$app\"\n38|metadata=\"$(codesign -dvv \"$app\" 2>&1)\"\n39|grep -q 'TeamIdentifier=262RZ595FP' <<< \"$metadata\"\n40|grep -q 'Authority=Developer ID Application:' <<< \"$metadata\"\n41|notarize() {\n42|  local artifact=\"$1\" result=\"$2\"\n43|  xcrun notarytool submit \"$artifact\" --keychain-profile \"${NOTARY_PROFILE:-RunnerControl-notary}\" \\\n44|    --wait --timeout 30m --output-format json > \"$result\"\n45|  python3 - \"$result\" <<'PY'\n46|import json,sys\n47|r=json.load(open(sys.argv[1]))\n48|if r.get('status') != 'Accepted':\n49|    raise SystemExit('Apple did not accept this submission: ' + str(r))\n50|PY\n51|}\n52|ditto -c -k --keepParent \"$app\" \"$release_root/RunnerControl.zip\"\n53|notarize \"$release_root/RunnerControl.zip\" \"$release_root/app-notary.json\"\n54|xcrun stapler staple \"$app\"\n55|xcrun stapler validate \"$app\"\n56|spctl --assess --type execute --verbose \"$app\"\n57|ditto \"$app\" \"$release_root/image/RunnerControl.app\"\n58|ln -s /Applications \"$release_root/image/Applications\"\n59|hdiutil create -volname 'Runner Control' -srcfolder \"$release_root/image\" -fs APFS \\\n60|  -format ULFO \"$release_root/dist/RunnerControl.dmg\"\n61|signing_identity=\"$(security find-identity -v -p codesigning | python3 Scripts/release_metadata.py signing-identity --team 262RZ595FP)\"\n62|codesign --force --timestamp --sign \"$signing_identity\" \"$release_root/dist/RunnerControl.dmg\"\n63|notarize \"$release_root/dist/RunnerControl.dmg\" \"$release_root/dmg-notary.json\"\n64|xcrun stapler staple \"$release_root/dist/RunnerControl.dmg\"\n65|xcrun stapler validate \"$release_root/dist/RunnerControl.dmg\"\n66|sparkle_bin=\"$(./Scripts/sparkle-tools.sh)\"\n67|\"$sparkle_bin/generate_appcast\" --account works.relux.runnercontrol \\\n68|  --maximum-versions 1 --maximum-deltas 0 \\\n69|  --download-url-prefix \"https://github.com/relux-works/runner-control/releases/download/$RELEASE_TAG/\" \\\n70|  --link 'https://github.com/relux-works/runner-control' \"$release_root/dist\"\n71|python3 Scripts/release_metadata.py verify --appcast \"$release_root/dist/appcast.xml\" \\\n72|  --dmg \"$release_root/dist/RunnerControl.dmg\" --tag \"$RELEASE_TAG\" --build \"$build\"\n73|(cd \"$release_root/dist\" && shasum -a 256 RunnerControl.dmg appcast.xml > SHA256SUMS)\n74|if [ -n \"${GITHUB_OUTPUT:-}\" ]; then printf 'dist=%s\\n' \"$release_root/dist\" >> \"$GITHUB_OUTPUT\"; fi\n75|printf 'Notarized release assets: %s\\n' \"$release_root/dist\"","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c475","stream":{"kind":"session","id":"01a0a811-e233-7700-9f73-d0f94294967e"},"sequence":149,"recorded_at":1780531400000293,"record_type":"event","durability":"durable","causation_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","run_stream":{"kind":"run","id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d"},"call_id":"call_01a0a812421d70f6ad837e08d9d112d9","text":"Read text file `Scripts/release-preflight.sh`.\n1|#!/bin/bash\n2|set -euo pipefail\n3|for tool in xcodebuild xcrun codesign security hdiutil tuist gh python3; do\n4|  command -v \"$tool\" >/dev/null || { echo \"Missing release tool: $tool\" >&2; exit 1; }\n5|done\n6|identities=\"$(security find-identity -v -p codesigning | grep -E 'Developer ID Application:.*\\(262RZ595FP\\)' || true)\"\n7|if [ -z \"$identities\" ]; then\n8|  echo 'Missing Developer ID Application identity with private key for team 262RZ595FP.' >&2\n9|  echo 'An Account Holder must issue it; Apple Development or another team cannot be substituted.' >&2\n10|  exit 1\n11|fi\n12|if [ \"$(printf '%s\\n' \"$identities\" | grep -c .)\" -gt 1 ]; then\n13|  echo 'Multiple Developer ID Application identities for team 262RZ595FP; remove the stale certificate so release signing is unambiguous.' >&2\n14|  exit 1\n15|fi\n16|profile=\"${NOTARY_PROFILE:-RunnerControl-notary}\"\n17|history_err=\"$(mktemp)\"\n18|if ! xcrun notarytool history --keychain-profile \"$profile\" --output-format json >/dev/null 2>\"$history_err\"; then\n19|  if grep -q 'keychainLocked' \"$history_err\"; then\n20|    echo \"The login keychain is locked in this session, so notarytool profile '$profile' cannot be read.\" >&2\n21|    echo 'Unlock the login keychain on macbook-iv (console login as the runner user) and re-run Release DMG via workflow_dispatch with the existing tag. Credentials are never printed or exported.' >&2\n22|  elif grep -q 'No Keychain password item found for profile' \"$history_err\"; then\n23|    echo \"notarytool profile '$profile' is missing from the login keychain.\" >&2\n24|    echo \"Recreate it locally with 'xcrun notarytool store-credentials' (see RELEASING.md), then re-run Release DMG via workflow_dispatch with the existing tag.\" >&2\n25|  else\n26|    echo \"notarytool history failed for profile '$profile':\" >&2\n27|    head -n 5 \"$history_err\" >&2 || true\n28|  fi\n29|  rm -f \"$history_err\"\n30|  exit 1\n31|fi\n32|rm -f \"$history_err\"\n33|root=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n34|cd \"$root\"\n35|sparkle_bin=\"$(\"$root/Scripts/sparkle-tools.sh\")\"\n36|actual=\"$(\"$sparkle_bin/generate_keys\" --account works.relux.runnercontrol -p)\"\n37|expected=\"$(python3 -c 'import json; print(json.load(open(\"ios-app-manager.json\"))[\"macos\"][\"info_plist\"][\"SUPublicEDKey\"])')\"\n38|[ \"$actual\" = \"$expected\" ] || { echo 'Sparkle signing key is missing or does not match the app public key.' >&2; exit 1; }\n39|printf \"Release prerequisites verified (team 262RZ595FP, notary profile '%s').\\n\" \"$profile\"","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c477","stream":{"kind":"session","id":"01a0a811-e233-7700-9f73-d0f94294967e"},"sequence":150,"recorded_at":1780531400000295,"record_type":"event","durability":"durable","causation_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","run_stream":{"kind":"run","id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d"},"call_id":"call_01a0a81242ea770290b921ff0fc8b2f3","text":"Read text file `Scripts/release_metadata.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Validate release identity and appcast metadata without handling private keys.\"\"\"\n3|import argparse\n4|import base64\n5|import json\n6|from pathlib import Path\n7|import re\n8|import sys\n9|import xml.etree.ElementTree as ET\n10|\n11|REPO = 'relux-works/runner-control'\n12|FEED = f'https://github.com/{REPO}/releases/latest/download/appcast.xml'\n13|NS = '{http://www.andymatuschak.org/xml-namespaces/sparkle}'\n14|\n15|def prepare(config, tag, run, attempt):\n16|    if not re.fullmatch(r'v\\d+\\.\\d+\\.\\d+', tag):\n17|        raise ValueError('Release tag must be vMAJOR.MINOR.PATCH')\n18|    if config['marketing_version'] != tag[1:]:\n19|        raise ValueError('Tag must match marketing_version in ios-app-manager.json')\n20|    if config['bundle_id'] != 'works.relux.runnercontrol' or config['team_id'] != '262RZ595FP':\n21|        raise ValueError('Unexpected bundle ID or signing team')\n22|    if not 1 <= run <= 9899 or not 1 <= attempt <= 99:\n23|        raise ValueError('Invalid release run/attempt number')\n24|    if config['macos']['info_plist']['SUFeedURL'] != FEED:\n25|        raise ValueError('Unexpected public update feed')\n26|    key = base64.b64decode(config['macos']['info_plist']['SUPublicEDKey'], validate=True)\n27|    if len(key) != 32:\n28|        raise ValueError('Invalid Sparkle public key')\n29|    config['project_version'] = f'{100 + run}.{attempt}'\n30|    return config\n31|\n32|def resolve_signing_identity(find_identity_output, team):\n33|    \"\"\"Return the Developer ID Application SHA-1 for team.\n34|\n35|    Parses `security find-identity -v -p codesigning` output. Apple\n36|    Development and other-team identities are ignored. Zero or several\n37|    matches fail so release signing never silently picks a wrong key.\n38|    \"\"\"\n39|    matches = []\n40|    for line in find_identity_output.splitlines():\n41|        if 'Developer ID Application:' not in line or f'({team})' not in line:\n42|            continue\n43|        found = re.search(r'\\b([A-F0-9]{40})\\b', line)\n44|        if found:\n45|            matches.append(found.group(1))\n46|    if not matches:\n47|        raise ValueError(f'No Developer ID Application identity for team {team}')\n48|    if len(matches) > 1:\n49|        raise ValueError(f'Multiple Developer ID Application identities for team {team}; remove the stale certificate')\n50|    return matches[0]\n51|\n52|def verify_appcast(path, dmg, tag, build):\n53|    root = ET.parse(path).getroot()\n54|    items = root.findall('./channel/item')\n55|    if len(items) != 1:\n56|        raise ValueError('Expected one current release in appcast')\n57|    item = items[0]\n58|    if item.findtext(NS + 'version') != build:\n59|        raise ValueError('Appcast build does not match app build')\n60|    if item.findtext(NS + 'shortVersionString') != tag[1:]:\n61|        raise ValueError('Appcast release version mismatch')\n62|    enclosure = item.find('enclosure')\n63|    if enclosure is None or enclosure.get('url') != f'https://github.com/{REPO}/releases/download/{tag}/RunnerControl.dmg':\n64|        raise ValueError('Unexpected download URL')\n65|    signature = base64.b64decode(enclosure.get(NS + 'edSignature', ''), validate=True)\n66|    if len(signature) != 64 or int(enclosure.get('length', '0')) != dmg.stat().st_size:\n67|        raise ValueError('Missing signature or archive length mismatch')\n68|    minimum = item.findtext(NS + 'minimumSystemVersion')\n69|    if not minimum or int(minimum.split('.')[0]) < 14:\n70|        raise ValueError('Missing minimum macOS requirement')\n71|\n72|def main():\n73|    parser = argparse.ArgumentParser()\n74|    sub = parser.add_subparsers(dest='command', required=True)\n75|    prep = sub.add_parser('prepare')\n76|    prep.add_argument('--config', type=Path, required=True)\n77|    prep.add_argument('--tag', required=True)\n78|    prep.add_argument('--run', type=int, required=True)\n79|    prep.add_argument('--attempt', type=int, required=True)\n80|    verify = sub.add_parser('verify')\n81|    verify.add_argument('--appcast', type=Path, required=True)\n82|    verify.add_argument('--dmg', type=Path, required=True)\n83|    verify.add_argument('--tag', required=True)\n84|    verify.add_argument('--build', required=True)\n85|    sig = sub.add_parser('signing-identity')\n86|    sig.add_argument('--team', required=True)\n87|    args = parser.parse_args()\n88|    if args.command == 'prepare':\n89|        data = prepare(json.loads(args.config.read_text()), args.tag, args.run, args.attempt)\n90|        args.config.write_text(json.dumps(data, indent=2) + '\\n')\n91|        print(data['project_version'])\n92|    elif args.command == 'signing-identity':\n93|        print(resolve_signing_identity(sys.stdin.read(), args.team))\n94|    else:\n95|        verify_appcast(args.appcast, args.dmg, args.tag, args.build)\n96|        print('Appcast identity, signature presence, size and minimum OS verified')\n97|\n98|if __name__ == '__main__':\n99|    main()","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c479","stream":{"kind":"session","id":"01a0a811-e233-7700-9f73-d0f94294967e"},"sequence":151,"recorded_at":1780531400000297,"record_type":"event","durability":"durable","causation_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","run_stream":{"kind":"run","id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d"},"call_id":"call_01a0a81243b57599906c6a1efe01ad12","text":"Read text file `Scripts/tests/test_release_preflight.py`.\n1|\"\"\"Drive Scripts/release-preflight.sh with stubbed macOS tools.\n2|\n3|Each test builds an isolated repo root (preflight + sparkle-tools scripts,\n4|minimal ios-app-manager.json, stub Sparkle tools so no download happens) and\n5|a stub bin dir shadowing xcrun/security. Real python3/bash/grep run from PATH.\n6|No credentials enter the fixtures.\n7|\"\"\"\n8|import base64\n9|import json\n10|import os\n11|from pathlib import Path\n12|import shutil\n13|import subprocess\n14|import tempfile\n15|import unittest\n16|\n17|REPO = Path(__file__).parents[2]\n18|PUBKEY = base64.b64encode(bytes(32)).decode()\n19|WRONG_PUBKEY = base64.b64encode(bytes(range(32))).decode()\n20|TEAM_LINE = '  3) 267D90FC976A48CF830BE7F41AE612999E025054 \"Developer ID Application: Relux Works, LLC (262RZ595FP)\"'\n21|OTHER_LINES = ('  1) 7FB8D981868F2637B75DFD098A1F87E0CC11158D \"Apple Development: Ivan Oparin (45W9YW7M6V)\"\\n'\n22|               '  4) C8448515B5871071F90EB0168A79DCD35E7CA9FE \"Developer ID Application: SKL VC DMCC (4Y4UJAT8QR)\"')\n23|\n24|\n25|def write_exe(path, content):\n26|    path.write_text(content)\n27|    path.chmod(0o755)\n28|\n29|\n30|class PreflightHarness(unittest.TestCase):\n31|    def setUp(self):\n32|        self.tmp = tempfile.TemporaryDirectory()\n33|        root = Path(self.tmp.name)\n34|        scripts = root / 'Scripts'\n35|        scripts.mkdir()\n36|        for name in ('release-preflight.sh', 'sparkle-tools.sh'):\n37|            shutil.copy(REPO / 'Scripts' / name, scripts / name)\n38|        (root / 'ios-app-manager.json').write_text(json.dumps(\n39|            {'macos': {'info_plist': {'SUPublicEDKey': PUBKEY}}}))\n40|        sparkle_bin = root / '.temp' / 'tools' / 'Sparkle-2.10.0' / 'bin'\n41|        sparkle_bin.mkdir(parents=True)\n42|        write_exe(sparkle_bin / 'generate_appcast', '#!/bin/sh\\nexit 0\\n')\n43|        self.sparkle_bin = sparkle_bin\n44|        self.bindir = root / 'bin'\n45|        self.bindir.mkdir()\n46|        for tool in ('xcodebuild', 'codesign', 'hdiutil', 'tuist', 'gh'):\n47|            write_exe(self.bindir / tool, '#!/bin/sh\\nexit 0\\n')\n48|        self.root = root\n49|\n50|    def tearDown(self):\n51|        self.tmp.cleanup()\n52|\n53|    def run_preflight(self, security_out, xcrun_script, sparkle_key=PUBKEY, profile=None):\n54|        write_exe(self.bindir / 'security', '#!/bin/sh\\ncat <<\\'EOF\\'\\n' + security_out + '\\nEOF\\n')\n55|        write_exe(self.bindir / 'xcrun', xcrun_script)\n56|        write_exe(self.sparkle_bin / 'generate_keys', '#!/bin/sh\\necho ' + sparkle_key + '\\n')\n57|        env = dict(os.environ)\n58|        env['PATH'] = str(self.bindir) + os.pathsep + env['PATH']\n59|        if profile is None:\n60|            env.pop('NOTARY_PROFILE', None)\n61|        else:\n62|            env['NOTARY_PROFILE'] = profile\n63|        return subprocess.run(['bash', str(self.root / 'Scripts' / 'release-preflight.sh')],\n64|                              capture_output=True, text=True, timeout=60, env=env, cwd=self.tmp.name)\n65|\n66|\n67|class ReleasePreflightTests(PreflightHarness):\n68|    def test_preflight_passes_with_valid_credentials(self):\n69|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, '#!/bin/sh\\nexit 0\\n')\n70|        self.assertEqual(r.returncode, 0, r.stderr)\n71|        self.assertIn('Release prerequisites verified', r.stdout)\n72|        self.assertIn('RunnerControl-notary', r.stdout)\n73|\n74|    def test_locked_keychain_fails_with_unlock_guidance(self):\n75|        stub = ('#!/bin/sh\\necho \\'Error: keychainLocked(keychainName: \"default\", keychainURL: nil)'\n76|                ' Use Keychain Access or the `security unlock-keychain` command line tool'\n77|                ' to unlock the default keychain.\\' >&2\\nexit 1\\n')\n78|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, stub)\n79|        self.assertNotEqual(r.returncode, 0)\n80|        self.assertIn('locked', r.stderr)\n81|        self.assertIn('workflow_dispatch', r.stderr)\n82|        self.assertIn('RunnerControl-notary', r.stderr)\n83|\n84|    def test_missing_profile_names_profile_without_locked_guidance(self):\n85|        stub = ('#!/bin/sh\\necho \"Error: No Keychain password item found for profile: Custom-Profile-9\" >&2\\n'\n86|                'echo \"Run \\'notarytool store-credentials\\' to create another credential profile.\" >&2\\nexit 1\\n')\n87|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, stub, profile='Custom-Profile-9')\n88|        self.assertNotEqual(r.returncode, 0)\n89|        self.assertIn('Custom-Profile-9', r.stderr)\n90|        self.assertIn('store-credentials', r.stderr)\n91|        self.assertIn('missing from the login keychain', r.stderr)\n92|        self.assertNotIn('locked', r.stderr)\n93|\n94|    def test_missing_identity_rejected(self):\n95|        r = self.run_preflight(OTHER_LINES, '#!/bin/sh\\nexit 0\\n')\n96|        self.assertNotEqual(r.returncode, 0)\n97|        self.assertIn('Missing Developer ID Application identity', r.stderr)\n98|\n99|    def test_multiple_team_identities_rejected(self):\n100|        second = TEAM_LINE.replace('267D90FC976A48CF830BE7F41AE612999E025054',\n101|                                   'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA').replace('  3)', '  5)')\n102|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE + '\\n' + second, '#!/bin/sh\\nexit 0\\n')\n103|        self.assertNotEqual(r.returncode, 0)\n104|        self.assertIn('Multiple Developer ID Application identities', r.stderr)\n105|\n106|    def test_sparkle_key_mismatch_rejected(self):\n107|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, '#!/bin/sh\\nexit 0\\n', sparkle_key=WRONG_PUBKEY)\n108|        self.assertNotEqual(r.returncode, 0)\n109|        self.assertIn('Sparkle signing key', r.stderr)\n110|\n111|\n112|if __name__ == '__main__':\n113|    unittest.main()","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
