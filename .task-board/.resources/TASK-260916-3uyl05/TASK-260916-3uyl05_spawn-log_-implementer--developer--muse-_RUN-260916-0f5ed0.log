{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c469","stream":{"kind":"session","id":"01a0a811-e233-7700-9f73-d0f94294967e"},"sequence":143,"recorded_at":1780531400000281,"record_type":"event","durability":"durable","causation_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","run_stream":{"kind":"run","id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d"},"task_stream":{"kind":"task","id":"01a0a812-466e-7483-8743-b60f2bd81d5d"},"task_id":"01a0a812-466e-7483-8743-b60f2bd81d5d","event":{"kind":"output","task_id":"01a0a812-466e-7483-8743-b60f2bd81d5d","chunk":"Read text file `.github/workflows/release.yml`.\n1|name: Release DMG\n2|on:\n3|  push:\n4|    tags: ['v*']\n5|  workflow_dispatch:\n6|    inputs:\n7|      tag:\n8|        description: Existing vMAJOR.MINOR.PATCH tag on main\n9|        required: true\n10|        type: string\n11|permissions:\n12|  contents: write\n13|concurrency:\n14|  group: runner-control-release\n15|  cancel-in-progress: false\n16|jobs:\n17|  release:\n18|    runs-on: [self-hosted, macOS, ARM64, macbook-iv]\n19|    environment: release\n20|    timeout-minutes: 90\n21|    env:\n22|      RELEASE_TAG: ${{ inputs.tag || github.ref_name }}\n23|      NOTARY_PROFILE: RunnerControl-notary\n24|      GH_TOKEN: ${{ github.token }}\n25|    steps:\n26|      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n27|        with:\n28|          ref: ${{ inputs.tag || github.ref }}\n29|          fetch-depth: 0\n30|      - name: Validate trusted release tag\n31|        shell: bash\n32|        run: |\n33|          [[ \"$RELEASE_TAG\" =~ ^v[0-9]+\\.[0-9]+\\.[0-9]+$ ]]\n34|          test \"$(git rev-parse HEAD)\" = \"$(git rev-parse \"$RELEASE_TAG^{commit}\")\"\n35|          git merge-base --is-ancestor HEAD origin/main\n36|          if gh release view \"$RELEASE_TAG\" >/dev/null 2>&1; then\n37|            echo 'Release already exists. Inspect it before retrying; no published assets are overwritten.' >&2\n38|            exit 1\n39|          fi\n40|      - name: Release prerequisites\n41|        run: ./Scripts/release-preflight.sh\n42|      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n43|        with:\n44|          go-version: '1.25.5'\n45|          cache: false\n46|      - name: Build pinned scaffold generator\n47|        shell: bash\n48|        run: |\n49|          git clone https://github.com/relux-works/skill-ios-app-manager.git \"$RUNNER_TEMP/runner-control-generator-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT\"\n50|          cd \"$RUNNER_TEMP/runner-control-generator-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT\"\n51|          git checkout --detach 755a29538dfe0867671ac4291b016bf42d93a299\n52|          cd tuist-starter\n53|          env -u GOROOT go build -o \"$RUNNER_TEMP/runner-control-ios-app-manager\" ./cmd/ios-app-manager\n54|          echo \"IOS_APP_MANAGER=$RUNNER_TEMP/runner-control-ios-app-manager\" >> \"$GITHUB_ENV\"\n55|      - name: Unit tests\n56|        run: |\n57|          swift test --package-path Packages/RunnerControlCore --scratch-path \"$RUNNER_TEMP/runner-control-release-tests\"\n58|          python3 -m unittest discover -s Scripts/tests -v\n59|      - name: Build, notarize, staple and sign appcast\n60|        id: package\n61|        run: ./Scripts/release.sh\n62|      - name: Publish complete GitHub Release\n63|        env:\n64|          RELEASE_DIST: ${{ steps.package.outputs.dist }}\n65|        shell: bash\n66|        run: |\n67|          gh release create \"$RELEASE_TAG\" --verify-tag --draft --title \"Runner Control $RELEASE_TAG\" --generate-notes\n68|          gh release upload \"$RELEASE_TAG\" \"$RELEASE_DIST/RunnerControl.dmg\" \"$RELEASE_DIST/appcast.xml\" \"$RELEASE_DIST/SHA256SUMS\"\n69|          gh release edit \"$RELEASE_TAG\" --draft=false --latest\n70|      - name: Preserve release logs\n71|        if: always()\n72|        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n73|        with:\n74|          name: release-diagnostics-${{ github.run_id }}-${{ github.run_attempt }}\n75|          path: |\n76|            .temp/release-*/archive.log\n77|            .temp/release-*/export.log\n78|            .temp/release-*/*-notary.json\n79|          if-no-files-found: ignore\n80|          retention-days: 14","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c46b","stream":{"kind":"session","id":"01a0a811-e233-7700-9f73-d0f94294967e"},"sequence":144,"recorded_at":1780531400000283,"record_type":"event","durability":"durable","causation_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","run_stream":{"kind":"run","id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d"},"task_stream":{"kind":"task","id":"01a0a812-466e-7483-8743-b60f2bd81d5d"},"task_id":"01a0a812-466e-7483-8743-b60f2bd81d5d","event":{"kind":"completed","task_id":"01a0a812-466e-7483-8743-b60f2bd81d5d"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c46d","stream":{"kind":"session","id":"01a0a811-e233-7700-9f73-d0f94294967e"},"sequence":145,"recorded_at":1780531400000285,"record_type":"event","durability":"durable","causation_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","run_stream":{"kind":"run","id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d"},"task_stream":{"kind":"task","id":"01a0a812-489c-7b80-932c-68ec8fd403a0"},"task_id":"01a0a812-489c-7b80-932c-68ec8fd403a0","event":{"kind":"output","task_id":"01a0a812-489c-7b80-932c-68ec8fd403a0","chunk":"Read text file `Scripts/tests/test_release_preflight.py`.\n1|\"\"\"Drive Scripts/release-preflight.sh with stubbed macOS tools.\n2|\n3|Each test builds an isolated repo root (preflight + sparkle-tools scripts,\n4|minimal ios-app-manager.json, stub Sparkle tools so no download happens) and\n5|a stub bin dir shadowing xcrun/security. Real python3/bash/grep run from PATH.\n6|No credentials enter the fixtures.\n7|\"\"\"\n8|import base64\n9|import json\n10|import os\n11|from pathlib import Path\n12|import shutil\n13|import subprocess\n14|import tempfile\n15|import unittest\n16|\n17|REPO = Path(__file__).parents[2]\n18|PUBKEY = base64.b64encode(bytes(32)).decode()\n19|WRONG_PUBKEY = base64.b64encode(bytes(range(32))).decode()\n20|TEAM_LINE = '  3) 267D90FC976A48CF830BE7F41AE612999E025054 \"Developer ID Application: Relux Works, LLC (262RZ595FP)\"'\n21|OTHER_LINES = ('  1) 7FB8D981868F2637B75DFD098A1F87E0CC11158D \"Apple Development: Ivan Oparin (45W9YW7M6V)\"\\n'\n22|               '  4) C8448515B5871071F90EB0168A79DCD35E7CA9FE \"Developer ID Application: SKL VC DMCC (4Y4UJAT8QR)\"')\n23|\n24|\n25|def write_exe(path, content):\n26|    path.write_text(content)\n27|    path.chmod(0o755)\n28|\n29|\n30|class PreflightHarness(unittest.TestCase):\n31|    def setUp(self):\n32|        self.tmp = tempfile.TemporaryDirectory()\n33|        root = Path(self.tmp.name)\n34|        scripts = root / 'Scripts'\n35|        scripts.mkdir()\n36|        for name in ('release-preflight.sh', 'sparkle-tools.sh'):\n37|            shutil.copy(REPO / 'Scripts' / name, scripts / name)\n38|        (root / 'ios-app-manager.json').write_text(json.dumps(\n39|            {'macos': {'info_plist': {'SUPublicEDKey': PUBKEY}}}))\n40|        sparkle_bin = root / '.temp' / 'tools' / 'Sparkle-2.10.0' / 'bin'\n41|        sparkle_bin.mkdir(parents=True)\n42|        write_exe(sparkle_bin / 'generate_appcast', '#!/bin/sh\\nexit 0\\n')\n43|        self.sparkle_bin = sparkle_bin\n44|        self.bindir = root / 'bin'\n45|        self.bindir.mkdir()\n46|        for tool in ('xcodebuild', 'codesign', 'hdiutil', 'tuist', 'gh'):\n47|            write_exe(self.bindir / tool, '#!/bin/sh\\nexit 0\\n')\n48|        self.root = root\n49|\n50|    def tearDown(self):\n51|        self.tmp.cleanup()\n52|\n53|    def run_preflight(self, security_out, xcrun_script, sparkle_key=PUBKEY, profile=None):\n54|        write_exe(self.bindir / 'security', '#!/bin/sh\\ncat <<\\'EOF\\'\\n' + security_out + '\\nEOF\\n')\n55|        write_exe(self.bindir / 'xcrun', xcrun_script)\n56|        write_exe(self.sparkle_bin / 'generate_keys', '#!/bin/sh\\necho ' + sparkle_key + '\\n')\n57|        env = dict(os.environ)\n58|        env['PATH'] = str(self.bindir) + os.pathsep + env['PATH']\n59|        if profile is None:\n60|            env.pop('NOTARY_PROFILE', None)\n61|        else:\n62|            env['NOTARY_PROFILE'] = profile\n63|        return subprocess.run(['bash', str(self.root / 'Scripts' / 'release-preflight.sh')],\n64|                              capture_output=True, text=True, timeout=60, env=env, cwd=self.tmp.name)\n65|\n66|\n67|class ReleasePreflightTests(PreflightHarness):\n68|    def test_preflight_passes_with_valid_credentials(self):\n69|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, '#!/bin/sh\\nexit 0\\n')\n70|        self.assertEqual(r.returncode, 0, r.stderr)\n71|        self.assertIn('Release prerequisites verified', r.stdout)\n72|        self.assertIn('RunnerControl-notary', r.stdout)\n73|\n74|    def test_locked_keychain_fails_with_unlock_guidance(self):\n75|        stub = ('#!/bin/sh\\necho \\'Error: keychainLocked(keychainName: \"default\", keychainURL: nil)'\n76|                ' Use Keychain Access or the `security unlock-keychain` command line tool'\n77|                ' to unlock the default keychain.\\' >&2\\nexit 1\\n')\n78|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, stub)\n79|        self.assertNotEqual(r.returncode, 0)\n80|        self.assertIn('locked', r.stderr)\n81|        self.assertIn('workflow_dispatch', r.stderr)\n82|        self.assertIn('RunnerControl-notary', r.stderr)\n83|\n84|    def test_missing_profile_names_profile_without_locked_guidance(self):\n85|        stub = ('#!/bin/sh\\necho \"Error: No Keychain password item found for profile: Custom-Profile-9\" >&2\\n'\n86|                'echo \"Run \\'notarytool store-credentials\\' to create another credential profile.\" >&2\\nexit 1\\n')\n87|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, stub, profile='Custom-Profile-9')\n88|        self.assertNotEqual(r.returncode, 0)\n89|        self.assertIn('Custom-Profile-9', r.stderr)\n90|        self.assertIn('store-credentials', r.stderr)\n91|        self.assertIn('missing from the login keychain', r.stderr)\n92|        self.assertNotIn('locked', r.stderr)\n93|\n94|    def test_missing_identity_rejected(self):\n95|        r = self.run_preflight(OTHER_LINES, '#!/bin/sh\\nexit 0\\n')\n96|        self.assertNotEqual(r.returncode, 0)\n97|        self.assertIn('Missing Developer ID Application identity', r.stderr)\n98|\n99|    def test_multiple_team_identities_rejected(self):\n100|        second = TEAM_LINE.replace('267D90FC976A48CF830BE7F41AE612999E025054',\n101|                                   'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA').replace('  3)', '  5)')\n102|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE + '\\n' + second, '#!/bin/sh\\nexit 0\\n')\n103|        self.assertNotEqual(r.returncode, 0)\n104|        self.assertIn('Multiple Developer ID Application identities', r.stderr)\n105|\n106|    def test_sparkle_key_mismatch_rejected(self):\n107|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, '#!/bin/sh\\nexit 0\\n', sparkle_key=WRONG_PUBKEY)\n108|        self.assertNotEqual(r.returncode, 0)\n109|        self.assertIn('Sparkle signing key', r.stderr)\n110|\n111|\n112|if __name__ == '__main__':\n113|    unittest.main()","final_result":true}}}
