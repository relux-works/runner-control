{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cadd","stream":{"kind":"session","id":"01a0a811-e233-7700-9f73-d0f94294967e"},"sequence":969,"recorded_at":1780531400001933,"record_type":"event","durability":"durable","causation_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","run_stream":{"kind":"run","id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d"},"task_stream":{"kind":"task","id":"01a0a816-f1e7-7373-9190-8a9fe5f49e87"},"task_id":"01a0a816-f1e7-7373-9190-8a9fe5f49e87","event":{"kind":"output","task_id":"01a0a816-f1e7-7373-9190-8a9fe5f49e87","chunk":"edited\nchanged lines: lines 112-115\n--- original\n+++ updated\n@@\n-    def test_sparkle_key_mismatch_rejected(self):\n-        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, '#!/bin/sh\\nexit 0\\n', sparkle_key=WRONG_PUBKEY)\n-        self.assertNotEqual(r.returncode, 0)\n-        self.assertIn('Sparkle signing key', r.stderr)\n+    def test_sparkle_key_mismatch_rejected(self):\n+        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, '#!/bin/sh\\nexit 0\\n', sparkle_key=WRONG_PUBKEY)\n+        self.assertNotEqual(r.returncode, 0)\n+        self.assertIn('Sparkle signing key', r.stderr)\n+\n+    def test_failed_identity_read_with_empty_output_is_unknown_not_missing(self):\n+        r = self.run_preflight('', '#!/bin/sh\\nexit 0\\n',\n+                               security_exit=42, security_err='security: read failed')\n+        self.assertNotEqual(r.returncode, 0)\n+        self.assertIn('Could not read signing identities', r.stderr)\n+        self.assertNotIn('Missing Developer ID Application identity', r.stderr)\n+        self.assertNotIn('Release prerequisites verified', r.stdout)\n+\n+    def test_failed_identity_read_with_partial_output_is_not_verified(self):\n+        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, '#!/bin/sh\\nexit 0\\n',\n+                               security_exit=42, security_err='security: read failed')\n+        self.assertNotEqual(r.returncode, 0)\n+        self.assertIn('Could not read signing identities', r.stderr)\n+        self.assertNotIn('Release prerequisites verified', r.stdout)\n","final_result":true}}}
