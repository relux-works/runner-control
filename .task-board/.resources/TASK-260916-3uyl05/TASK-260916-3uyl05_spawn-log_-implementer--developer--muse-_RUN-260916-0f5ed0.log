{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c465","stream":{"kind":"session","id":"01a0a811-e233-7700-9f73-d0f94294967e"},"sequence":141,"recorded_at":1780531400000277,"record_type":"event","durability":"durable","causation_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d","run_stream":{"kind":"run","id":"d4ea5ec8-93af-4409-aa5b-edfe86e8078d"},"task_stream":{"kind":"task","id":"01a0a812-476d-7a22-be0f-03cf6b77e8bd"},"task_id":"01a0a812-476d-7a22-be0f-03cf6b77e8bd","event":{"kind":"output","task_id":"01a0a812-476d-7a22-be0f-03cf6b77e8bd","chunk":"Read text file `Scripts/release-preflight.sh`.\n1|#!/bin/bash\n2|set -euo pipefail\n3|for tool in xcodebuild xcrun codesign security hdiutil tuist gh python3; do\n4|  command -v \"$tool\" >/dev/null || { echo \"Missing release tool: $tool\" >&2; exit 1; }\n5|done\n6|identities=\"$(security find-identity -v -p codesigning | grep -E 'Developer ID Application:.*\\(262RZ595FP\\)' || true)\"\n7|if [ -z \"$identities\" ]; then\n8|  echo 'Missing Developer ID Application identity with private key for team 262RZ595FP.' >&2\n9|  echo 'An Account Holder must issue it; Apple Development or another team cannot be substituted.' >&2\n10|  exit 1\n11|fi\n12|if [ \"$(printf '%s\\n' \"$identities\" | grep -c .)\" -gt 1 ]; then\n13|  echo 'Multiple Developer ID Application identities for team 262RZ595FP; remove the stale certificate so release signing is unambiguous.' >&2\n14|  exit 1\n15|fi\n16|profile=\"${NOTARY_PROFILE:-RunnerControl-notary}\"\n17|history_err=\"$(mktemp)\"\n18|if ! xcrun notarytool history --keychain-profile \"$profile\" --output-format json >/dev/null 2>\"$history_err\"; then\n19|  if grep -q 'keychainLocked' \"$history_err\"; then\n20|    echo \"The login keychain is locked in this session, so notarytool profile '$profile' cannot be read.\" >&2\n21|    echo 'Unlock the login keychain on macbook-iv (console login as the runner user) and re-run Release DMG via workflow_dispatch with the existing tag. Credentials are never printed or exported.' >&2\n22|  elif grep -q 'No Keychain password item found for profile' \"$history_err\"; then\n23|    echo \"notarytool profile '$profile' is missing from the login keychain.\" >&2\n24|    echo \"Recreate it locally with 'xcrun notarytool store-credentials' (see RELEASING.md), then re-run Release DMG via workflow_dispatch with the existing tag.\" >&2\n25|  else\n26|    echo \"notarytool history failed for profile '$profile':\" >&2\n27|    head -n 5 \"$history_err\" >&2 || true\n28|  fi\n29|  rm -f \"$history_err\"\n30|  exit 1\n31|fi\n32|rm -f \"$history_err\"\n33|root=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n34|cd \"$root\"\n35|sparkle_bin=\"$(\"$root/Scripts/sparkle-tools.sh\")\"\n36|actual=\"$(\"$sparkle_bin/generate_keys\" --account works.relux.runnercontrol -p)\"\n37|expected=\"$(python3 -c 'import json; print(json.load(open(\"ios-app-manager.json\"))[\"macos\"][\"info_plist\"][\"SUPublicEDKey\"])')\"\n38|[ \"$actual\" = \"$expected\" ] || { echo 'Sparkle signing key is missing or does not match the app public key.' >&2; exit 1; }\n39|printf \"Release prerequisites verified (team 262RZ595FP, notary profile '%s').\\n\" \"$profile\"","final_result":true}}}
