n { RunnerRegistration.Action.stepStarted(\"applyRepositoryAccess\") }\n745|            let auth = try await currentUserToken(generation: gen)\n746|            guard !isStale(gen) else { return }\n747|            _ = syncServerBinding(auth.identity.serverHost)\n748|            guard !isStale(gen) else { return }\n749|            guard let group else {\n750|                throw RunnerRegistration.RegistrationError.invalidDraft(\n751|                    \"Resolve the dedicated group first.\"\n752|                )\n753|            }\n754|            try RunnerRegistration.Gates.authorizeGroupMutation(\n755|                targetGroupID: groupID, resolvedGroupID: group.id,\n756|                allowFlag: draft.allowGroupMutation\n757|            )\n758|            guard !isStale(gen) else { return }\n759|            try await api.setGroupRepositories(\n760|                config: auth.config, token: auth.token, org: org, groupID: group.id, selectedRepositoryIDs: ids\n761|            )\n762|            guard !isStale(gen) else { return }\n763|            let confirmed = try await api.fetchGroupRepositories(\n764|                config: auth.config, token: auth.token, org: org, groupID: group.id\n765|            )\n766|            guard !isStale(gen) else { return }\n767|            // The confirmed list is complete (every page followed). It must\n768|            // equal the request exactly; otherwise the draft keeps the\n769|            // requested selection and the step fails instead of claiming a\n770|            // partial write as success.\n771|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: ids, confirmed: confirmed)\n772|            guard !isStale(gen) else { return }\n773|            if var current = self.draft {\n774|                current.selectedRepositoryIDs = Set(confirmed)\n775|                self.draft = current\n776|            }\n777|            await action { RunnerRegistration.Action.repositoryAccessApplied(confirmed) }\n778|            guard !isStale(gen) else { return }\n779|            await action { RunnerRegistration.Action.permissionDismissed }\n780|            pendingRepositoryIDs = nil\n781|            pendingTargetGroupID = nil\n782|            await finishStep(\"applyRepositoryAccess\", generation: gen)\n783|        } catch {\n784|            await fail(error, step: \"applyRepositoryAccess\", generation: gen)\n785|        }\n786|    }\n787|\n788|    private func applyLabels(_ labels: [String]) async {\n789|        let gen = generation\n790|        guard workingOwner == nil else { return }\n791|        guard let draft else {\n792|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyLabels\") }\n793|            return\n794|        }\n795|        let trimmed = labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }\n796|        guard !trimmed.isEmpty else {\n797|            failedStep = \"applyLabels\"\n798|            await action {\n799|                RunnerRegistration.Action.failed(message: \"At least one label is required.\", step: \"applyLabels\")\n800|            }\n801|            return\n802|        }\n803|        guard let installPath else {\n804|            failedStep = \"applyLabels\"\n805|            await action {\n806|                RunnerRegistration.Action.failed(\n807|                    message: \"Register the runner first so labels target this installation.\",\n808|                    step: \"applyLabels\"\n809|                )\n810|            }\n811|            return\n812|        }\n813|        workingOwner = gen\n814|        workingStep = \"applyLabels\"\n815|        pendingLabels = trimmed\n816|        await action { RunnerRegistration.Action.stepStarted(\"applyLabels\") }\n817|        let directory = URL(fileURLWithPath: installPath)\n818|        do {\n819|            // Label writes require this operation's verified local identity\n820|            // on the authenticated server — checked before any runner-list or\n821|            // label network. A remote name match alone never authorizes\n822|            // mutating another runner, and a foreign-server ID never\n823|            // authorizes writes on this session's server.\n824|            let auth = try await currentUserToken(generation: gen)\n825|            guard !isStale(gen) else { return }\n826|            _ = syncServerBinding(auth.identity.serverHost)\n827|            guard !isStale(gen) else { return }\n828|            let local = await installer.readLocalRegistration(directory: directory)\n829|            let configured = await installer.hasCompleted(\n830|                RunnerInstallerService.stepConfigured, directory: directory\n831|            )\n832|            let localAgentID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n833|                local: local, configured: configured, draft: draft,\n834|                serverHost: auth.identity.serverHost\n835|            )\n836|            guard !isStale(gen) else { return }\n837|            // Re-bind on every write: the stored ID is never trusted across\n838|            // edits, retries, or remote drift. A missing agent fails with\n839|            // not-found; a contradictory list fails with mismatch. Neither\n840|            // guesses by name.\n841|            let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n842|            guard !isStale(gen) else { return }\n843|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n844|            let bound = try RunnerRegistration.Gates.boundRemoteRunnerID(\n845|                localAgentID: localAgentID, name: wanted, runners: runners\n846|            )\n847|            guard let runnerID = bound else {\n848|                throw RunnerRegistration.RegistrationError.remoteRunnerNotFound(\n849|                    \"GitHub does not list agent \\(localAgentID) for this scope yet; refusing to guess '\\(wanted)' by name. Retry after registration converges.\"\n850|                )\n851|            }\n852|            try await api.setRunnerLabels(\n853|                config: auth.config, token: auth.token, scope: draft.scope, runnerID: runnerID, labels: trimmed\n854|            )\n855|            guard !isStale(gen) else { return }\n856|            self.runnerID = runnerID\n857|            if var current = self.draft {\n858|                current.labels = trimmed\n859|                self.draft = current\n860|            }\n861|            await action { RunnerRegistration.Action.labelsApplied(trimmed) }\n862|            pendingLabels = nil\n863|            await finishStep(\"applyLabels\", generation: gen)\n864|        } catch {\n865|            await fail(error, step: \"applyLabels\", generation: gen)\n866|        }\n867|    }\n868|\n869|    // MARK: - Retry / cancel / reset\n870|\n871|    private func retry() async {\n872|        guard workingOwner == nil else { return }\n873|        guard let step = failedStep else { return }\n874|        switch step {\n875|        case \"resolveGroup\": await resolveGroup()\n876|        case \"prepareDownload\": await prepareDownload()\n877|        case \"downloadAndInstall\": await downloadAndInstall()\n878|        case \"registerRunner\": await registerRunner()\n879|        case \"setupService\": await setupService()\n880|        case \"applyRepositoryAccess\":\n881|            if let ids = pendingRepositoryIDs, let target = pendingTargetGroupID {\n882|                await applyRepositoryAccess(groupID: target, ids: ids)\n883|            }\n884|        case \"applyLabels\":\n885|            if let labels = pendingLabels { await applyLabels(labels) }\n886|        default:\n887|            return\n888|        }\n889|    }\n890|\n891|    private func cancel() async {\n892|        // New generation takes over the UI lock immediately; the abandoned\n893|        // operation's directory lease (if any) stays held until that side\n894|        // effect settles, and its stale exit mutates nothing.\n895|        generation += 1\n896|        workingOwner = nil\n897|        workingStep = nil\n898|        if let draft {\n899|            await registrationTokens.delete(scopeKey: Self.tokenScopeKey(draft: draft))\n900|        }\n901|        failedStep = nil\n902|        pendingRepositoryIDs = nil\n903|        pendingTargetGroupID = nil\n904|        pendingLabels = nil\n905|        await action { RunnerRegistration.Action.cancelled }\n906|    }\n907|\n908|    private func reset() async {\n909|        // Same ownership handoff as cancel: the UI lock moves to the fresh\n910|        // generation at once; live side effects keep their directory leases\n911|        // and their stale exits mutate nothing.\n912|        generation += 1\n913|        workingOwner = nil\n914|        workingStep = nil\n915|        if let draft {\n916|            await registrationTokens.delete(scopeKey: Self.tokenScopeKey(draft: draft))\n917|        }\n918|        draft = nil\n919|        group = nil\n920|        asset = nil\n921|        installPath = nil\n922|        runnerID = nil\n923|        failedStep = nil\n924|        pendingRepositoryIDs = nil\n925|        pendingTargetGroupID = nil\n926|        pendingLabels = nil\n927|        boundServerHost = nil\n928|        await action { RunnerRegistration.Action.didReset }\n929|    }\n930|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
