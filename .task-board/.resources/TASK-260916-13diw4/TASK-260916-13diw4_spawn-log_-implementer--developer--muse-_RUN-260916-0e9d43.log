{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7f3","stream":{"kind":"session","id":"01a0a8f3-c96c-76f0-b402-07e24facc60e"},"sequence":596,"recorded_at":1780531400001187,"record_type":"event","durability":"durable","causation_id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049","run_stream":{"kind":"run","id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049"},"task_stream":{"kind":"task","id":"01a0a8f7-7902-7291-b0ce-9f0dca21a56a"},"task_id":"01a0a8f7-7902-7291-b0ce-9f0dca21a56a","event":{"kind":"output","task_id":"01a0a8f7-7902-7291-b0ce-9f0dca21a56a","chunk":"edited\nchanged lines: lines 62-94\n--- original\n+++ updated\n@@\n-    /// Canonical lease key for a directory. Both Flow-derived URLs (from a\n-    /// stored install path) and `directory(for:)` URLs map to the same key\n-    /// for the same on-disk location.\n-    nonisolated static func leaseKey(for directory: URL) -> String {\n-        URL(fileURLWithPath: directory.path).standardizedFileURL.path\n-    }\n-\n-    /// Acquires exclusive ownership of `directory`. Synchronous: callers must\n-    /// invoke it before their first await so the check-and-insert is atomic\n-    /// under actor isolation. Throws a retryable `directoryBusy` when another\n-    /// live operation already owns the directory; different directories never\n-    /// conflict.\n-    private func acquireLease(for directory: URL) throws {\n-        let key = Self.leaseKey(for: directory)\n-        guard !activeDirectories.contains(key) else {\n-            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n-        }\n-        activeDirectories.insert(key)\n-    }\n-\n-    private func releaseLease(for directory: URL) {\n-        activeDirectories.remove(Self.leaseKey(for: directory))\n-    }\n-\n-    /// Refuses a synchronous mutation (service setup, recovery) while a live\n-    /// async side effect owns the directory. No insert: without an await the\n-    /// caller itself cannot interleave, it only needs to respect leases held\n-    /// by others.\n-    private func requireIdleDirectory(_ directory: URL) throws {\n-        guard !activeDirectories.contains(Self.leaseKey(for: directory)) else {\n-            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n-        }\n-    }\n+    /// Canonical lease key for a directory: physical filesystem identity, not\n+    /// path spelling. Both Flow-derived URLs (from a stored install path)\n+    /// and `directory(for:)` URLs map to the same key for the same on-disk\n+    /// location, including through symlink leaves and symlink ancestors.\n+    /// Not-yet-created leaves canonicalize via their nearest existing\n+    /// ancestor, so `/tmp`-vs-`/private/tmp` spellings of one directory map\n+    /// to one key before the leaf exists.\n+    nonisolated static func leaseKey(for directory: URL) -> String {\n+        let standardized = URL(fileURLWithPath: directory.path).standardizedFileURL\n+        let files = FileManager.default\n+        var base = standardized\n+        var suffix: [String] = []\n+        while true {\n+            if files.fileExists(atPath: base.path) || Self.isSymlink(atPath: base.path) {\n+                break\n+            }\n+            let parent = base.deletingLastPathComponent()\n+            if parent.path == base.path { break }\n+            suffix.insert(base.lastPathComponent, at: 0)\n+            base = parent\n+        }\n+        let resolvedBase = base.resolvingSymlinksInPath().path\n+        if suffix.isEmpty {\n+            return URL(fileURLWithPath: resolvedBase).standardizedFileURL.path\n+        }\n+        var url = URL(fileURLWithPath: resolvedBase, isDirectory: true)\n+        for component in suffix { url.appendPathComponent(component) }\n+        return url.standardizedFileURL.path\n+    }\n+\n+    private nonisolated static func isSymlink(atPath path: String) -> Bool {\n+        (try? FileManager.default.destinationOfSymbolicLink(atPath: path)) != nil\n+    }\n+\n+    /// Refuses Finder-alias installation paths before any side effect. A\n+    /// Finder alias is not a transparent directory like a symlink: operating\n+    /// through its spelling would not operate on the target, so alias\n+    /// spellings are rejected instead of being canonicalized. Symlinks are\n+    /// resolved by `leaseKey`, not refused here.\n+    nonisolated static func ensureNoAlias(at directory: URL) throws {\n+        var current = URL(fileURLWithPath: directory.path).standardizedFileURL\n+        while true {\n+            if FileManager.default.fileExists(atPath: current.path),\n+               (try? current.resourceValues(forKeys: [.isAliasFileKey]))?.isAliasFile == true {\n+                throw RunnerRegistration.RegistrationError.invalidDraft(\n+                    \"Installation path '\\(directory.path)' resolves through a Finder alias at '\\(current.path)'. Choose a direct folder path instead of an alias.\"\n+                )\n+            }\n+            let parent = current.deletingLastPathComponent()\n+            if parent.path == current.path { break }\n+            current = parent\n+        }\n+    }\n+\n+    /// Acquires exclusive ownership of `directory`. Synchronous: callers must\n+    /// invoke it before their first await so the check-and-insert is atomic\n+    /// under actor isolation. Throws a retryable `directoryBusy` when another\n+    /// live operation already owns the directory; different physical\n+    /// directories never conflict. Returns the originally acquired canonical\n+    /// key; the caller must hold it across awaits and release that exact key.\n+    private func acquireLease(for directory: URL) throws -> String {\n+        try Self.ensureNoAlias(at: directory)\n+        let key = Self.leaseKey(for: directory)\n+        guard !activeDirectories.contains(key) else {\n+            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n+        }\n+        activeDirectories.insert(key)\n+        return key\n+    }\n+\n+    private func releaseLease(_ key: String) {\n+        activeDirectories.remove(key)\n+    }\n+\n+    /// Refuses a synchronous mutation (service setup, recovery) while a live\n+    /// async side effect owns the directory. No insert: without an await the\n+    /// caller itself cannot interleave, it only needs to respect leases held\n+    /// by others. Uses the same canonical identity as acquisition.\n+    private func requireIdleDirectory(_ directory: URL) throws {\n+        try Self.ensureNoAlias(at: directory)\n+        guard !activeDirectories.contains(Self.leaseKey(for: directory)) else {\n+            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n+        }\n+    }\n","final_result":true}}}
