low.apply(RunnerRegistration.Effect.registerRunner) }\n17|    await executor.waitStarted()\n18|    var edited = orgDraft()\n19|    edited.runnerName = \"renamed-runner\"\n20|    edited.installDirName = \"alias-install\"\n21|    try FileManager.default.createSymbolicLink(\n22|        at: h.installRoot.appendingPathComponent(\"alias-install\"),\n23|        withDestinationURL: h.installRoot.appendingPathComponent(\"macbook-test\"))\n24|    _ = await h.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n25|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n26|    _ = await h.flow.apply(RunnerRegistration.Effect.registerRunner)\n27|    let callsWhileOldRuns = await executor.configCalls.count\n28|    await executor.release()\n29|    _ = await old.value\n30|    #expect(callsWhileOldRuns == 1, \"An identity edit must not allow a second config.sh while the first still owns this directory\")\n31|    let state = RunnerRegistration.State()\n32|    for action in registrationActions(h.logger) { await state.reduce(with: action) }\n33|    let directory = await h.installer.directory(for: edited.installDirName)\n34|    let local = await h.installer.readLocalRegistration(directory: directory)\n35|    #expect(!state.completedSteps.contains(\"registerRunner\") || local?.agentName == edited.runnerName,\n36|            \"New registration is attested complete but old in-flight config overwrites .runner afterwards\")\n37|}","final_result":true}}}
