{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f9","stream":{"kind":"session","id":"01a0a8f3-c96c-76f0-b402-07e24facc60e"},"sequence":215,"recorded_at":1780531400000425,"record_type":"event","durability":"durable","causation_id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049","run_stream":{"kind":"run","id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049"},"call_id":"call_01a0a8f44877707c8794bb08c6f19d02","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n1|import CryptoKit\n2|import Foundation\n3|\n4|/// Filesystem installer for downloaded GitHub Actions runners.\n5|///\n6|/// Production path: download bytes → SHA-256 verify → tar extract →\n7|/// `bin/runsvc.sh` copied into the root and chmodded (as official `svc.sh`\n8|/// would) → exact `config.sh` invocation → manual LaunchAgent plist.\n9|/// All side effects stay below `installRoot`; tests inject a temporary root,\n10|/// a fake downloader, and fixtures instead of touching production runners.\n11|public actor RunnerInstallerService {\n12|    public static let markerFileName = \".runnercontrol-install.json\"\n13|    public static let installOS = \"osx\"\n14|\n15|    private let installRoot: URL\n16|    private let downloader: @Sendable (URL) async throws -> Data\n17|    private let executor: any CommandExecuting\n18|    private let currentArch: @Sendable () -> String\n19|    private let hasher: @Sendable (Data) -> String\n20|\n21|    public init(\n22|        installRoot: URL? = nil,\n23|        downloader: (@Sendable (URL) async throws -> Data)? = nil,\n24|        executor: (any CommandExecuting)? = nil,\n25|        currentArch: (@Sendable () -> String)? = nil,\n26|        hasher: (@Sendable (Data) -> String)? = nil\n27|    ) {\n28|        self.installRoot = installRoot\n29|            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/GitHubActions\")\n30|        self.downloader = downloader ?? { url in\n31|            let (data, _) = try await URLSession.shared.data(from: url)\n32|            return data\n33|        }\n34|        self.executor = executor ?? CommandExecutor()\n35|        self.currentArch = currentArch ?? {\n36|            #if arch(arm64)\n37|            return \"arm64\"\n38|            #else\n39|            return \"x64\"\n40|            #endif\n41|        }\n42|        self.hasher = hasher ?? { data in\n43|            SHA256.hash(data: data).map { String(format: \"%02x\", $0) }.joined()\n44|        }\n45|    }\n46|\n47|    public nonisolated var root: URL { installRoot }\n48|    public nonisolated var architecture: String { currentArch() }\n49|\n50|    /// Canonical installation directories with a live mutating side effect\n51|    /// (download/extract/config/service/recovery). Acquired synchronously\n52|    /// before the first await and released only when the owning operation\n53|    /// settles, so actor reentrancy can never admit two mutations of one\n54|    /// directory. Abandoning a UI generation does not release this resource;\n55|    /// only the settling side effect does.\n56|    private var activeDirectories: Set<String> = []\n57|\n58|    public func directory(for installDirName: String) -> URL {\n59|        installRoot.appendingPathComponent(installDirName)\n60|    }\n61|\n62|    /// Canonical lease key for a directory. Both Flow-derived URLs (from a\n63|    /// stored install path) and `directory(for:)` URLs map to the same key\n64|    /// for the same on-disk location.\n65|    nonisolated static func leaseKey(for directory: URL) -> String {\n66|        URL(fileURLWithPath: directory.path).standardizedFileURL.path\n67|    }\n68|\n69|    /// Acquires exclusive ownership of `directory`. Synchronous: callers must\n70|    /// invoke it before their first await so the check-and-insert is atomic\n71|    /// under actor isolation. Throws a retryable `directoryBusy` when another\n72|    /// live operation already owns the directory; different directories never\n73|    /// conflict.\n74|    private func acquireLease(for directory: URL) throws {\n75|        let key = Self.leaseKey(for: directory)\n76|        guard !activeDirectories.contains(key) else {\n77|            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n78|        }\n79|        activeDirectories.insert(key)\n80|    }\n81|\n82|    private func releaseLease(for directory: URL) {\n83|        activeDirectories.remove(Self.leaseKey(for: directory))\n84|    }\n85|\n86|    /// Refuses a synchronous mutation (service setup, recovery) while a live\n87|    /// async side effect owns the directory. No insert: without an await the\n88|    /// caller itself cannot interleave, it only needs to respect leases held\n89|    /// by others.\n90|    private func requireIdleDirectory(_ directory: URL) throws {\n91|        guard !activeDirectories.contains(Self.leaseKey(for: directory)) else {\n92|            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n93|        }\n94|    }\n95|\n96|    // MARK: - Idempotency markers\n97|\n98|    public struct Marker: Codable, Sendable, Equatable {\n99|        public var scopeKey: String\n100|        public var completedSteps: Set<String>\n101|        /// Server the directory was configured against (`.runner` host is\n102|        /// authoritative; this records the config-time expectation so a\n103|        /// group/server change cannot reuse an old configured marker).\n104|        public var serverHost: String?\n105|        /// Dedicated group passed to `config.sh --runnergroup` (org scope).\n106|        /// `.runner` does not record it, so the marker must: a group-name\n107|        /// edit never claims the old group's configuration as its own.\n108|        public var groupName: String?\n109|        public init(\n110|            scopeKey: String, completedSteps: Set<String> = [],\n111|            serverHost: String? = nil, groupName: String? = nil\n112|        ) {\n113|            self.scopeKey = scopeKey; self.completedSteps = completedSteps\n114|            self.serverHost = serverHost; self.groupName = groupName\n115|        }\n116|    }\n117|\n118|    public static let stepDownloaded = \"downloaded\"\n119|    public static let stepInstalled = \"installed\"\n120|    public static let stepConfigured = \"configured\"\n121|    public static let stepServiceReady = \"serviceReady\"\n122|\n123|    public func loadMarker(directory: URL) -> Marker? {\n124|        let url = directory.appendingPathComponent(Self.markerFileName)\n125|        guard let data = try? Data(contentsOf: url) else { return nil }\n126|        return try? JSONDecoder().decode(Marker.self, from: data)\n127|    }\n128|\n129|    private func storeMarker(_ marker: Marker, directory: URL) throws {\n130|        let data = try JSONEncoder().encode(marker)\n131|        try data.write(to: directory.appendingPathComponent(Self.markerFileName), options: .atomic)\n132|    }\n133|\n134|    public func markCompleted(\n135|        _ step: String, directory: URL, scopeKey: String,\n136|        serverHost: String? = nil, groupName: String? = nil\n137|    ) throws {\n138|        var marker = loadMarker(directory: directory) ?? Marker(scopeKey: scopeKey)\n139|        marker.completedSteps.insert(step)\n140|        if let serverHost { marker.serverHost = serverHost }\n141|        if let groupName { marker.groupName = groupName }\n142|        try storeMarker(marker, directory: directory)\n143|    }\n144|\n145|    public func hasCompleted(_ step: String, directory: URL) -> Bool {\n146|        loadMarker(directory: directory)?.completedSteps.contains(step) == true\n147|    }\n148|\n149|    // MARK: - Install\n150|\n151|    /// Downloads, verifies, and extracts the official package. Idempotent:\n152|    /// a completed `installed` marker with matching scope and server skips\n153|    /// the work. Refuses to overwrite an already-registered directory (no\n154|    /// duplicates).\n155|    public func downloadAndInstall(\n156|        asset: RunnerRegistration.DownloadAsset,\n157|        draft: RunnerRegistration.Draft,\n158|        serverHost: String? = nil\n159|    ) async throws -> URL {\n160|        try RunnerRegistration.Gates.validateNoSpace(\n161|            installDirName: draft.installDirName, workFolder: draft.workFolder\n162|        )\n163|        let directory = self.directory(for: draft.installDirName)\n164|        if directory.path.contains(\" \") {\n165|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n166|        }\n167|        // Exclusive ownership for the whole mutation, acquired before the\n168|        // first await (reuse check included): a same-directory retry while\n169|        // this install is live is refused retryably instead of starting a\n170|        // second download/extract over the same directory.\n171|        try acquireLease(for: directory)\n172|        defer { releaseLease(for: directory) }\n173|        let files = FileManager.default\n174|        if let marker = loadMarker(directory: directory),\n175|           marker.completedSteps.contains(Self.stepInstalled),\n176|           marker.scopeKey == draft.scope.scopeKey,\n177|           Self.markerServerMatches(marker: marker, serverHost: serverHost),\n178|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n179|            return directory\n180|        }\n181|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n182|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: draft.runnerName)\n183|        }\n184|        let bytes: Data\n185|        do {\n186|            bytes = try await downloader(asset.downloadURL)\n187|        } catch {\n188|            throw RunnerRegistration.RegistrationError.network(\"Runner download failed: \\(error.localizedDescription)\")\n189|        }\n190|        // Fail closed: the official downloads endpoint documents\n191|        // `sha256_checksum`, and an install without a verified digest is\n192|        // refused rather than trusted on TLS alone.\n193|        guard let expected = asset.sha256Checksum, !expected.isEmpty else {\n194|            throw RunnerRegistration.RegistrationError.integrityMismatch\n195|        }\n196|        let actual = hasher(bytes)\n197|        guard actual.lowercased() == expected.lowercased() else {\n198|            throw RunnerRegistration.RegistrationError.integrityMismatch\n199|        }\n200|        try files.createDirectory(at: directory, withIntermediateDirectories: true)\n201|        let archive = files.temporaryDirectory.appendingPathComponent(UUID().uuidString + \"-\" + asset.filename)\n202|        defer { try? files.removeItem(at: archive) }\n203|        try bytes.write(to: archive, options: .atomic)\n204|        let result = try await executor.run(\"/usr/bin/tar\", [\"-xzf\", archive.path, \"-C\", directory.path])\n205|        guard result.code == 0 else {\n206|            throw RunnerRegistration.RegistrationError.network(\n207|                \"Runner archive extraction failed: \\(String(result.output.prefix(300)))\"\n208|            )\n209|        }\n210|        // Official packages keep runsvc.sh under bin/ until svc.sh installs it;\n211|        // a bare extraction leaves the root copy absent, so install it here.\n212|        try installRunsvc(directory: directory)\n213|        try markCompleted(\n214|            Self.stepDownloaded, directory: directory,\n215|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n216|        )\n217|        try markCompleted(\n218|            Self.stepInstalled, directory: directory,\n219|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n220|        )\n221|        return directory\n222|    }\n223|\n224|    /// Server binding for install reuse. A marker written without a server\n225|    /// (pre-revision-4) never satisfies a server-bound request: the next\n226|    /// install re-verifies instead of reusing unknown provenance. Direct\n227|    /// installer calls without a server (unit fixtures) keep the legacy\n228|    /// scope-only reuse.\n229|    static func markerServerMatches(marker: Marker, serverHost: String?) -> Bool {\n230|        guard let want = serverHost else { return true }\n231|        guard let have = marker.serverHost else { return false }\n232|        return RunnerRegistration.OperationIdentity.normalizeServerHost(have)\n233|            == RunnerRegistration.OperationIdentity.normalizeServerHost(want)\n234|    }\n235|\n236|    /// Copies official `bin/runsvc.sh` into the installation root and makes\n237|    /// it executable, mirroring what official `svc.sh install` would do.\n238|    public func installRunsvc(directory: URL) throws {\n239|        let files = FileManager.default\n240|        let source = directory.appendingPathComponent(\"bin/runsvc.sh\")\n241|        let target = directory.appendingPathComponent(\"runsvc.sh\")\n242|        guard files.fileExists(atPath: source.path) else {\n243|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing bin/runsvc.sh.\")\n244|        }\n245|        if files.fileExists(atPath: target.path) {\n246|            try files.removeItem(at: target)\n247|        }\n248|        try files.copyItem(at: source, to: target)\n249|        try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: target.path)\n250|    }\n251|\n252|    // MARK: - Configure\n253|\n254|    /// Runs the exact `config.sh` invocation. Skips when a previous attempt\n255|    /// already registered this directory (marker + `.runner` present), so\n256|    /// retries never create orphan or duplicate GitHub registrations.\n257|    /// Returns the local agent ID read back from `.runner`.\n258|    @discardableResult\n259|    public func runConfig(\n260|        directory: URL,\n261|        scopeURL: String,\n262|        token: String,\n263|        draft: RunnerRegistration.Draft,\n264|        runnerGroup: String?\n265|    ) async throws -> Int64? {\n266|        try await runConfig(\n267|            directory: directory, scopeURL: scopeURL, token: token,\n268|            draft: draft, runnerGroup: runnerGroup, replace: draft.allowReplace\n269|        )\n270|    }\n271|\n272|    /// Explicit-`replace` variant. Production callers pass\n273|    /// `draft.allowReplace`; tests drive both values.\n274|    @discardableResult\n275|    public func runConfig(\n276|        directory: URL,\n277|        scopeURL: String,\n278|        token: String,\n279|        draft: RunnerRegistration.Draft,\n280|        runnerGroup: String?,\n281|        replace: Bool\n282|    ) async throws -> Int64? {\n283|        let files = FileManager.default\n284|        let scopeHost = URL(string: scopeURL)?.host ?? \"\"\n285|        // Exclusive ownership for the whole config, acquired before the\n286|        // first await (resume checks included): a same-directory retry while\n287|        // this config.sh is live is refused retryably instead of invoking a\n288|        // second config.sh over the same .runner. The lease is released only\n289|        // when this operation settles; an abandoned UI generation never\n290|        // releases it.\n291|        try acquireLease(for: directory)\n292|        defer { releaseLease(for: directory) }\n293|        if hasCompleted(Self.stepConfigured, directory: directory),\n294|           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n295|            // Idempotent resume never returns a stale ID: the existing\n296|            // configuration must still match this draft on this server.\n297|            let local = readLocalRegistration(directory: directory)\n298|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n299|                local: local, configured: true, draft: draft, serverHost: scopeHost\n300|            )\n301|            try Self.verifyConfiguredGroup(\n302|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n303|            )\n304|            return verified\n305|        }\n306|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n307|           hasCompleted(Self.stepConfigured, directory: directory) {\n308|            let local = readLocalRegistration(directory: directory)\n309|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n310|                local: local, configured: true, draft: draft, serverHost: scopeHost\n311|            )\n312|            try Self.verifyConfiguredGroup(\n313|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n314|            )\n315|            return verified\n316|        }\n317|        let spec = RunnerRegistration.ConfigSpec(\n318|            scopeURL: scopeURL, token: token, name: draft.runnerName,\n319|            workFolder: draft.workFolder, labels: draft.labels,\n320|            runnerGroup: runnerGroup, replace: replace\n321|        )\n322|        let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n323|        let executable = directory.appendingPathComponent(\"config.sh\").path\n324|        guard files.fileExists(atPath: executable) else {\n325|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n326|        }\n327|        let result = try await executor.run(executable, args)\n328|        guard result.code == 0 else {\n329|            // Never echo the token: config output may repeat arguments.\n330|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [token])\n331|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n332|        }\n333|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n334|            throw RunnerRegistration.RegistrationError.configFailed(\n335|                \"config.sh reported success but .runner is missing.\"\n336|            )\n337|        }\n338|        try markCompleted(\n339|            Self.stepConfigured, directory: directory, scopeKey: draft.scope.scopeKey,\n340|            serverHost: scopeHost, groupName: runnerGroup\n341|        )\n342|        return readAgentID(directory: directory)\n343|    }\n344|\n345|    /// `.runner` does not record the org group, so the configured marker\n346|    /// does. A resume whose marker names another group (or predates group\n347|    /// recording) refuses instead of claiming the old group's configuration\n348|    /// as the new draft's. Repository scope never configures a group.\n349|    static func verifyConfiguredGroup(\n350|        marker: Marker?, runnerGroup: String?, draft: RunnerRegistration.Draft\n351|    ) throws {\n352|        switch draft.scope {\n353|        case .repository:\n354|            return\n355|        case .organization:\n356|            break\n357|        }\n358|        let wanted = (runnerGroup ?? draft.groupName).trimmingCharacters(in: .whitespacesAndNewlines)\n359|        guard let have = marker?.groupName?.trimmingCharacters(in: .whitespacesAndNewlines),\n360|              !have.isEmpty else {\n361|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n362|                \"Directory '\\(draft.installDirName)' was configured before group recording. Reconfigure for group '\\(wanted)' instead of reusing the old configuration.\"\n363|            )\n364|        }\n365|        guard have == wanted else {\n366|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n367|                \"Local registration was configured for group '\\(have)', not '\\(wanted)'. Reconfigure instead of reusing the old group's configuration.\"\n368|            )\n369|        }\n370|    }\n371|\n372|    // MARK: - Dedicated-group ownership\n373|\n374|    public static let ownershipFileName = \".runnercontrol-groups.json\"\n375|\n376|    private func ownershipFile() -> URL {\n377|        installRoot.appendingPathComponent(Self.ownershipFileName)\n378|    }\n379|\n380|    private static func ownershipKey(serverHost: String, org: String, name: String) -> String {\n381|        \"\\(RunnerRegistration.OperationIdentity.normalizeServerHost(serverHost))\\u{0}\\(org.lowercased())\\u{0}\\(name)\"\n382|    }\n383|\n384|    /// Returns the locally recorded dedicated-group ID for\n385|    /// `server` + `org` + `name`, or nil when this Mac never created (or\n386|    /// took over) that group on that server. Name matches on GitHub alone\n387|    /// never count as ownership, and ownership on one server never\n388|    /// authorizes adoption on another.\n389|    public func loadOwnedGroupID(serverHost: String, org: String, name: String) -> Int64? {\n390|        guard let data = try? Data(contentsOf: ownershipFile()),\n391|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n392|        return table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)]\n393|    }\n394|\n395|    public func saveOwnedGroupID(serverHost: String, org: String, name: String, groupID: Int64) throws {\n396|        let file = ownershipFile()\n397|        var table: [String: Int64] = [:]\n398|        if let data = try? Data(contentsOf: file),\n399|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n400|            table = decoded\n401|        }\n402|        table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)] = groupID\n403|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n404|        let data = try JSONEncoder().encode(table)\n405|        try data.write(to: file, options: .atomic)\n406|    }\n407|\n408|    /// Reads the local `.runner` identity without touching credentials.\n409|    /// Returns nil only when the file is missing or unparseable; a present\n410|    /// but incomplete file returns a partial struct so verification can name\n411|    /// the exact missing field instead of crashing.\n412|    public func readLocalRegistration(directory: URL) -> RunnerRegistration.LocalRegistration? {\n413|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n414|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n415|        var agentID: Int64?\n416|        if let id = object[\"agentId\"] as? Int64 { agentID = id }\n417|        else if let id = object[\"agentId\"] as? Int { agentID = Int64(id) }\n418|        else if let id = object[\"agentId\"] as? NSNumber { agentID = id.int64Value }\n419|        return RunnerRegistration.LocalRegistration(\n420|            agentID: agentID,\n421|            agentName: object[\"agentName\"] as? String,\n422|            gitHubURL: object[\"gitHubUrl\"] as? String,\n423|            workFolder: object[\"workFolder\"] as? String\n424|        )\n425|    }\n426|\n427|    /// Reads the local agent ID from `.runner` without touching credentials.\n428|    public func readAgentID(directory: URL) -> Int64? {\n429|        readLocalRegistration(directory: directory)?.agentID\n430|    }\n431|\n432|    // MARK: - Manual LaunchAgent\n433|\n434|    /// Writes the manual service plist (RunAtLoad off for new runners) and\n435|    /// validates it matches the directory. Never bootstraps the service:\n436|    /// enabling is the user's separate action.\n437|    @discardableResult\n438|    public func setupService(directory: URL, label: String) throws -> URL {\n439|        guard !directory.path.contains(\" \") else {\n440|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n441|        }\n442|        // Never rewrite the service while a live install/config owns the\n443|        // directory; the caller retries after that operation settles.\n444|        try requireIdleDirectory(directory)\n445|        let files = FileManager.default\n446|        guard files.fileExists(atPath: directory.appendingPathComponent(\"runsvc.sh\").path) else {\n447|            throw RunnerRegistration.RegistrationError.network(\n448|                \"runsvc.sh is missing; reinstall before setting up the service.\"\n449|            )\n450|        }\n451|        let plist = directory.appendingPathComponent(\"manual-service.plist\")\n452|        let payload: [String: Any] = [\n453|            \"Label\": label,\n454|            \"ProgramArguments\": [directory.appendingPathComponent(\"runsvc.sh\").path],\n455|            \"WorkingDirectory\": directory.path,\n456|            \"RunAtLoad\": false\n457|        ]\n458|        let data = try PropertyListSerialization.data(fromPropertyList: payload, format: .xml, options: 0)\n459|        try data.write(to: plist, options: .atomic)\n460|        let scopeKey = loadMarker(directory: directory)?.scopeKey ?? \"\"\n461|        try markCompleted(Self.stepServiceReady, directory: directory, scopeKey: scopeKey)\n462|        return plist\n463|    }\n464|\n465|    /// Removes a failed partial install so retries start clean. Refuses to\n466|    /// touch directories that already hold a registration (`.runner`) or an\n467|    /// unknown marker scope: recovery never deletes a working runner.\n468|    public func recoverPartialInstall(directory: URL, scopeKey: String) throws {\n469|        let files = FileManager.default\n470|        guard files.fileExists(atPath: directory.path) else { return }\n471|        // Never delete a directory a live operation still owns; the caller\n472|        // retries after that operation settles.\n473|        try requireIdleDirectory(directory)\n474|        guard !files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n475|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: directory.lastPathComponent)\n476|        }\n477|        if let marker = loadMarker(directory: directory), marker.scopeKey != scopeKey {\n478|            throw RunnerRegistration.RegistrationError.alreadyInstalled(path: directory.path)\n479|        }\n480|        try files.removeItem(at: directory)\n481|    }\n482|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4fb","stream":{"kind":"session","id":"01a0a8f3-c96c-76f0-b402-07e24facc60e"},"sequence":216,"recorded_at":1780531400000427,"record_type":"event","durability":"durable","causation_id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049","run_stream":{"kind":"run","id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049"},"call_id":"call_01a0a8f449a97068a5b6fe7f6f4b3af2","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension RunnerRegistration {\n5|    public protocol IFlow: Relux.Flow {}\n6|\n7|    public actor Flow {\n8|        public let dispatcher: Relux.Dispatcher\n9|        private let api: GitHubRunnerAPIClient\n10|        private let installer: RunnerInstallerService\n11|        private let registrationTokens: any RunnerRegistrationTokenStoring\n12|        private let userStore: any GitHubCredentialStoring\n13|        private let identities: any GitHubSessionIdentityStoring\n14|        private let refresher: GitHubTokenRefresh\n15|        private let configProvider: @Sendable (String?) throws -> GitHubAuth.AppConfig\n16|        private let now: @Sendable () -> Date\n17|\n18|        private var generation = 0\n19|        /// Operation owner: the generation that holds the busy lock, or nil\n20|        /// when idle. Every step sets it to its starting generation before\n21|        /// its first await; every success/failure/cancel exit clears it only\n22|        /// when the exiting generation still owns it. A stale generation\n23|        /// never mutates a newer owner's lock, step, or failure state.\n24|        /// Abandoning a generation releases this UI lock so nonconflicting\n25|        /// work can start, but never releases the installer's per-directory\n26|        /// lease: a live side effect keeps owning its directory until it\n27|        /// settles.\n28|        private var workingOwner: Int?\n29|        private var workingStep: String?\n30|        private var draft: Draft?\n31|        private var group: RunnerGroup?\n32|        private var asset: DownloadAsset?\n33|        private var installPath: String?\n34|        private var runnerID: Int64?\n35|        private var failedStep: String?\n36|        private var pendingRepositoryIDs: Set<Int64>?\n37|        private var pendingTargetGroupID: Int64?\n38|        private var pendingLabels: [String]?\n39|        /// Authenticated server the cached progress is bound to. A session\n40|        /// change invalidates server-bound caches before any reuse, so a\n41|        /// group/runner ID from one server never authorizes writes on another.\n42|        private var boundServerHost: String?\n43|\n44|        public init(\n45|            api: GitHubRunnerAPIClient,\n46|            installer: RunnerInstallerService,\n47|            registrationTokens: any RunnerRegistrationTokenStoring,\n48|            userStore: any GitHubCredentialStoring,\n49|            identityStore: any GitHubSessionIdentityStoring,\n50|            refresher: GitHubTokenRefresh,\n51|            configProvider: (@Sendable (String?) throws -> GitHubAuth.AppConfig)? = nil,\n52|            now: (@Sendable () -> Date)? = nil,\n53|            dispatcher: Relux.Dispatcher? = nil\n54|        ) async {\n55|            self.api = api\n56|            self.installer = installer\n57|            self.registrationTokens = registrationTokens\n58|            self.userStore = userStore\n59|            self.identities = identityStore\n60|            self.refresher = refresher\n61|            self.configProvider = configProvider ?? { host in\n62|                try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\")\n63|            }\n64|            self.now = now ?? Date.init\n65|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n66|        }\n67|\n68|        /// Deterministic LaunchAgent label for a draft. Always carries the\n69|        /// `actions.runner.` prefix discovery requires.\n70|        public nonisolated static func serviceLabel(draft: Draft) -> String {\n71|            let scope = draft.scope.detail.replacingOccurrences(of: \"/\", with: \"-\")\n72|            let raw = \"actions.runner.\\(scope).\\(draft.installDirName)\"\n73|            let allowed = CharacterSet.alphanumerics.union(CharacterSet(charactersIn: \".-\"))\n74|            return raw.unicodeScalars.map { allowed.contains($0) ? String($0) : \"-\" }.joined()\n75|        }\n76|\n77|        public nonisolated static func tokenScopeKey(draft: Draft) -> String {\n78|            \"\\(draft.scope.scopeKey):\\(draft.installDirName)\"\n79|        }\n80|    }\n81|}\n82|\n83|/// Authenticated user token for wizard API calls. Never logged.\n84|private struct FlowUserToken: Sendable {\n85|    let config: GitHubAuth.AppConfig\n86|    let token: String\n87|    let identity: GitHubSessionIdentity\n88|}\n89|\n90|extension RunnerRegistration.Flow: RunnerRegistration.IFlow {\n91|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n92|        guard let effect = effect as? RunnerRegistration.Effect else { return .success }\n93|        switch effect {\n94|        case .beginDraft(let draft): await beginDraft(draft)\n95|        case .updateDraft(let draft): await updateDraft(draft)\n96|        case .resolveGroup: await resolveGroup()\n97|        case .prepareDownload: await prepareDownload()\n98|        case .downloadAndInstall: await downloadAndInstall()\n99|        case .registerRunner: await registerRunner()\n100|        case .setupService: await setupService()\n101|        case .applyRepositoryAccess(let groupID, let ids): await applyRepositoryAccess(groupID: groupID, ids: ids)\n102|        case .applyLabels(let labels): await applyLabels(labels)\n103|        case .retry: await retry()\n104|        case .cancel: await cancel()\n105|        case .reset: await reset()\n106|        case .dismissPermission: await action { RunnerRegistration.Action.permissionDismissed }\n107|        }\n108|        return .success\n109|    }\n110|\n111|    private func isStale(_ gen: Int) -> Bool { generation != gen }\n112|\n113|    // MARK: - Draft\n114|\n115|    private func beginDraft(_ draft: RunnerRegistration.Draft) async {\n116|        do {\n117|            try RunnerRegistration.Gates.validateDraft(draft)\n118|        } catch {\n119|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"beginDraft\") }\n120|            return\n121|        }\n122|        // A new draft abandons any in-flight completion: the old operation's\n123|        // success must never be attributed to the new draft. Already-started\n124|        // filesystem side effects keep their directory lease until they\n125|        // settle; only their completion ownership is revoked via the\n126|        // generation bump, and the UI lock is released for the new draft.\n127|        let abandoned = workingOwner != nil\n128|        if abandoned {\n129|            generation += 1\n130|            workingOwner = nil\n131|            workingStep = nil\n132|        }\n133|        self.draft = draft\n134|        group = nil\n135|        asset = nil\n136|        installPath = nil\n137|        runnerID = nil\n138|        failedStep = nil\n139|        pendingRepositoryIDs = nil\n140|        pendingTargetGroupID = nil\n141|        pendingLabels = nil\n142|        boundServerHost = nil\n143|        await action { RunnerRegistration.Action.draftBegan(draft) }\n144|        if abandoned {\n145|            await action { RunnerRegistration.Action.cancelled }\n146|        }\n147|    }\n148|\n149|    private func updateDraft(_ draft: RunnerRegistration.Draft) async {\n150|        do {\n151|            try RunnerRegistration.Gates.validateDraft(draft)\n152|        } catch {\n153|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"updateDraft\") }\n154|            return\n155|        }\n156|        // Identity edits while working abandon the in-flight operation via\n157|        // the generation bump. Selections stay editable without cancelling\n158|        // unrelated steps — except the mutation they feed: a labels edit\n159|        // abandons in-flight applyLabels and a repository edit abandons\n160|        // in-flight applyRepositoryAccess, so an older completion can never\n161|        // overwrite the newer visible selection or report it as applied.\n162|        // Stale completions observe the bump at their next await boundary\n163|        // and emit nothing.\n164|        var abandoned = false\n165|        if let old = self.draft {\n166|            if workingOwner != nil, shouldAbandonInFlight(old: old, new: draft) {\n167|                generation += 1\n168|                workingOwner = nil\n169|                workingStep = nil\n170|                abandoned = true\n171|            }\n172|            invalidateProgress(old: old, new: draft)\n173|        }\n174|        self.draft = draft\n175|        await action { RunnerRegistration.Action.draftUpdated(draft) }\n176|        if abandoned {\n177|            await action { RunnerRegistration.Action.cancelled }\n178|        }\n179|    }\n180|\n181|    /// Invalidates cached success-progress bound to the changed identity\n182|    /// fields. Scope/install/name/group/work-folder edits never reuse\n183|    /// another registration's evidence; editable selections re-target pending\n184|    /// retries to the visible values instead. Mirrors the reducer's\n185|    /// invalidation. Group is part of the config identity (`--runnergroup`):\n186|    /// a group edit drops registration evidence as well, so the old group's\n187|    /// configuration is never claimed as the new draft's success.\n188|    private func invalidateProgress(old: RunnerRegistration.Draft, new: RunnerRegistration.Draft) {\n189|        if old.scope != new.scope {\n190|            group = nil\n191|            asset = nil\n192|            installPath = nil\n193|            runnerID = nil\n194|            pendingRepositoryIDs = nil\n195|            pendingTargetGroupID = nil\n196|            pendingLabels = nil\n197|            failedStep = nil\n198|            return\n199|        }\n200|        if old.installDirName != new.installDirName {\n201|            installPath = nil\n202|            runnerID = nil\n203|            pendingLabels = nil\n204|            if [\"downloadAndInstall\", \"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n205|                failedStep = nil\n206|            }\n207|        }\n208|        let oldName = old.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n209|        let newName = new.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n210|        if oldName != newName {\n211|            runnerID = nil\n212|            pendingLabels = nil\n213|            if [\"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n214|                failedStep = nil\n215|            }\n216|        }\n217|        let oldIsOrg: Bool = if case .organization = old.scope { true } else { false }\n218|        let newIsOrg: Bool = if case .organization = new.scope { true } else { false }\n219|        if oldIsOrg || newIsOrg {\n220|            let oldGroup = old.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n221|            let newGroup = new.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n222|            if oldGroup != newGroup {\n223|                group = nil\n224|                runnerID = nil\n225|                pendingRepositoryIDs = nil\n226|                pendingTargetGroupID = nil\n227|                pendingLabels = nil\n228|                if [\"resolveGroup\", \"applyRepositoryAccess\", \"registerRunner\", \"setupService\", \"applyLabels\"]\n229|                    .contains(failedStep ?? \"\") {\n230|                    failedStep = nil\n231|                }\n232|            }\n233|        }\n234|        if old.workFolder != new.workFolder {\n235|            runnerID = nil\n236|            pendingLabels = nil\n237|            if [\"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n238|                failedStep = nil\n239|            }\n240|        }\n241|        // Editable selections stay live: a retry after an edit applies the\n242|        // visible values, never the stale attempt's.\n243|        if old.labels != new.labels, !new.labels.isEmpty {\n244|            pendingLabels = new.labels\n245|        }\n246|        if old.selectedRepositoryIDs != new.selectedRepositoryIDs {\n247|            pendingRepositoryIDs = new.selectedRepositoryIDs\n248|        }\n249|    }\n250|\n251|    /// True when an edit must abandon the in-flight step: any identity\n252|    /// change, plus a selection change for the mutation it feeds.\n253|    private func shouldAbandonInFlight(old: RunnerRegistration.Draft, new: RunnerRegistration.Draft) -> Bool {\n254|        if RunnerRegistration.Gates.identityFieldsChanged(old: old, new: new) { return true }\n255|        if workingStep == \"applyLabels\", old.labels != new.labels { return true }\n256|        if workingStep == \"applyRepositoryAccess\", old.selectedRepositoryIDs != new.selectedRepositoryIDs {\n257|            return true\n258|        }\n259|        return false\n260|    }\n261|\n262|    // MARK: - Auth\n263|\n264|    private func currentUserToken(generation gen: Int) async throws -> FlowUserToken {\n265|        guard let identity = await identities.load() else {\n266|            throw RunnerRegistration.RegistrationError.notAuthenticated\n267|        }\n268|        let config = try configProvider(identity.serverHost)\n269|        guard var record = await userStore.load(\n270|            serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID\n271|        ) else {\n272|            throw RunnerRegistration.RegistrationError.notAuthenticated\n273|        }\n274|        guard !isStale(gen) else { throw CancellationError() }\n275|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n276|            do {\n277|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n278|            } catch is CancellationError {\n279|                throw CancellationError()\n280|            } catch let error as GitHubAuth.AuthError {\n281|                switch error {\n282|                case .revoked, .unauthorized, .tokenRefreshFailed:\n283|                    throw RunnerRegistration.RegistrationError.unauthorized\n284|                default:\n285|                    break\n286|                }\n287|            }\n288|            guard !isStale(gen) else { throw CancellationError() }\n289|        }\n290|        return FlowUserToken(config: config, token: record.accessToken, identity: identity)\n291|    }\n292|\n293|    /// Binds cached progress to the authenticated server. When the session\n294|    /// server changes between steps, server-bound caches (group, asset,\n295|    /// runner ID, pendings) are dropped before any reuse, so an ID from one\n296|    /// server never authorizes writes on another. Returns false when the\n297|    /// binding changed and the caller must re-resolve instead of reusing.\n298|    @discardableResult\n299|    private func syncServerBinding(_ host: String) -> Bool {\n300|        let normalized = RunnerRegistration.OperationIdentity.normalizeServerHost(host)\n301|        if let bound = boundServerHost,\n302|           RunnerRegistration.OperationIdentity.normalizeServerHost(bound) == normalized {\n303|            return true\n304|        }\n305|        if boundServerHost != nil {\n306|            group = nil\n307|            asset = nil\n308|            runnerID = nil\n309|            pendingRepositoryIDs = nil\n310|            pendingTargetGroupID = nil\n311|            pendingLabels = nil\n312|            failedStep = nil\n313|            boundServerHost = normalized\n314|            return false\n315|        }\n316|        boundServerHost = normalized\n317|        return true\n318|    }\n319|\n320|    /// Generation-owned failure exit. Only the generation that still holds\n321|    /// the lock may record its failure and release it; a stale failure\n322|    /// (abandoned, cancelled, or reset while suspended) mutates nothing, so\n323|    /// it can never unlock a newer operation or plant its failedStep.\n324|    private func fail(_ error: Error, step: String, generation gen: Int) async {\n325|        guard workingOwner == gen else { return }\n326|        failedStep = step\n327|        workingOwner = nil\n328|        workingStep = nil\n329|        if error is CancellationError { return }\n330|        if let reg = error as? RunnerRegistration.RegistrationError {\n331|            switch reg {\n332|            case .missingPermission, .forbidden:\n333|                await action {\n334|                    RunnerRegistration.Action.permissionDenied(message: reg.localizedDescription, step: step)\n335|                }\n336|                return\n337|            default:\n338|                break\n339|            }\n340|        }\n341|        let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n342|        await action { RunnerRegistration.Action.failed(message: message, step: step) }\n343|    }\n344|\n345|    /// Generation-owned success exit. Only the generation that still holds\n346|    /// the lock may attest its step and release it; a stale success emits\n347|    /// nothing and mutates nothing.\n348|    private func finishStep(_ step: String, generation gen: Int) async {\n349|        guard workingOwner == gen else { return }\n350|        failedStep = nil\n351|        workingOwner = nil\n352|        workingStep = nil\n353|        await action { RunnerRegistration.Action.stepFinished(step) }\n354|    }\n355|\n356|    // MARK: - Group\n357|\n358|    private func resolveGroup() async {\n359|        let gen = generation\n360|        guard workingOwner == nil else { return }\n361|        guard let draft else {\n362|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"resolveGroup\") }\n363|            return\n364|        }\n365|        do {\n366|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n367|        } catch {\n368|            failedStep = \"resolveGroup\"\n369|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"resolveGroup\") }\n370|            return\n371|        }\n372|        guard case .organization(let org) = draft.scope else { return }\n373|        workingOwner = gen\n374|        workingStep = \"resolveGroup\"\n375|        await action { RunnerRegistration.Action.stepStarted(\"resolveGroup\") }\n376|        do {\n377|            let auth = try await currentUserToken(generation: gen)\n378|            guard !isStale(gen) else { return }\n379|            _ = syncServerBinding(auth.identity.serverHost)\n380|            guard !isStale(gen) else { return }\n381|            let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n382|            guard !isStale(gen) else { return }\n383|            let name = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n384|            let resolved: RunnerRegistration.RunnerGroup\n385|            if let existing = groups.first(where: { $0.name == name }) {\n386|                // Name alone never authorizes adoption: require a locally\n387|                // recorded ownership entry on this server or explicit\n388|                // takeover confirmation.\n389|                let owned = await installer.loadOwnedGroupID(\n390|                    serverHost: auth.identity.serverHost, org: org, name: name\n391|                )\n392|                try RunnerRegistration.Gates.authorizeGroupTakeover(\n393|                    groupName: name, existingID: existing.id,\n394|                    ownedID: owned, allowTakeover: draft.allowGroupTakeover\n395|                )\n396|                if owned != existing.id {\n397|                    try await installer.saveOwnedGroupID(\n398|                        serverHost: auth.identity.serverHost, org: org, name: name, groupID: existing.id\n399|                    )\n400|                }\n401|                guard !isStale(gen) else { return }\n402|                // A pre-existing group may deny public repos (GitHub default\n403|                // false), which would silently drop selected public repos.\n404|                if existing.allowsPublicRepositories {\n405|                    resolved = existing\n406|                } else {\n407|                    resolved = try await api.updateGroupAllowsPublic(\n408|                        config: auth.config, token: auth.token, org: org,\n409|                        groupID: existing.id, allowsPublic: true\n410|                    )\n411|                }\n412|            } else {\n413|                resolved = try await api.createGroup(\n414|                    config: auth.config, token: auth.token, org: org,\n415|                    name: name, selectedRepositoryIDs: draft.selectedRepositoryIDs,\n416|                    allowsPublicRepositories: true\n417|                )\n418|                guard !isStale(gen) else { return }\n419|                try await installer.saveOwnedGroupID(\n420|                    serverHost: auth.identity.serverHost, org: org, name: name, groupID: resolved.id\n421|                )\n422|            }\n423|            guard !isStale(gen) else { return }\n424|            let repoIDs = try await api.fetchGroupRepositories(\n425|                config: auth.config, token: auth.token, org: org, groupID: resolved.id\n426|            )\n427|            guard !isStale(gen) else { return }\n428|            group = resolved\n429|            await action { RunnerRegistration.Action.groupResolved(resolved, repositoryIDs: repoIDs) }\n430|            guard !isStale(gen) else { return }\n431|            await action { RunnerRegistration.Action.permissionDismissed }\n432|            await finishStep(\"resolveGroup\", generation: gen)\n433|        } catch {\n434|            await fail(error, step: \"resolveGroup\", generation: gen)\n435|        }\n436|    }\n437|\n438|    // MARK: - Download\n439|\n440|    private func prepareDownload() async {\n441|        let gen = generation\n442|        guard workingOwner == nil else { return }\n443|        guard let draft else {\n444|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"prepareDownload\") }\n445|            return\n446|        }\n447|        workingOwner = gen\n448|        workingStep = \"prepareDownload\"\n449|        await action { RunnerRegistration.Action.stepStarted(\"prepareDownload\") }\n450|        do {\n451|            let auth = try await currentUserToken(generation: gen)\n452|            guard !isStale(gen) else { return }\n453|            _ = syncServerBinding(auth.identity.serverHost)\n454|            guard !isStale(gen) else { return }\n455|            let found = try await prepareDownloadInner(draft: draft, auth: auth, generation: gen)\n456|            guard !isStale(gen) else { return }\n457|            asset = found\n458|            await action { RunnerRegistration.Action.downloadReady(found) }\n459|            await finishStep(\"prepareDownload\", generation: gen)\n460|        } catch {\n461|            await fail(error, step: \"prepareDownload\", generation: gen)\n462|        }\n463|    }\n464|\n465|    private func prepareDownloadInner(\n466|        draft: RunnerRegistration.Draft, auth: FlowUserToken, generation gen: Int\n467|    ) async throws -> RunnerRegistration.DownloadAsset {\n468|        guard !isStale(gen) else { throw CancellationError() }\n469|        let assets = try await api.fetchDownloads(config: auth.config, token: auth.token, scope: draft.scope)\n470|        guard !isStale(gen) else { throw CancellationError() }\n471|        return try RunnerRegistration.Gates.selectDownload(\n472|            osName: RunnerInstallerService.installOS,\n473|            arch: installer.architecture,\n474|            from: assets\n475|        )\n476|    }\n477|\n478|    // MARK: - Install\n479|\n480|    private func downloadAndInstall() async {\n481|        let gen = generation\n482|        guard workingOwner == nil else { return }\n483|        guard let draft else {\n484|            await action {\n485|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"downloadAndInstall\")\n486|            }\n487|            return\n488|        }\n489|        workingOwner = gen\n490|        workingStep = \"downloadAndInstall\"\n491|        await action { RunnerRegistration.Action.stepStarted(\"downloadAndInstall\") }\n492|        do {\n493|            // Bind to the authenticated server before touching the cache: a\n494|            // session change drops the old server's asset instead of reusing\n495|            // it. The same auth serves the whole step; no mid-step reload\n496|            // may mix servers.\n497|            let auth = try await currentUserToken(generation: gen)\n498|            guard !isStale(gen) else { return }\n499|            _ = syncServerBinding(auth.identity.serverHost)\n500|            guard !isStale(gen) else { return }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
