{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c681","stream":{"kind":"session","id":"01a0a8f3-c96c-76f0-b402-07e24facc60e"},"sequence":411,"recorded_at":1780531400000817,"record_type":"event","durability":"durable","causation_id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049","run_stream":{"kind":"run","id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049"},"task_stream":{"kind":"task","id":"01a0a8f5-2a9d-76a1-abb1-58b03eb1f5b5"},"task_id":"01a0a8f5-2a9d-76a1-abb1-58b03eb1f5b5","event":{"kind":"output","task_id":"01a0a8f5-2a9d-76a1-abb1-58b03eb1f5b5","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Models.swift`.\n(207 line(s) above)\n208|\n209|extension RunnerRegistration {\n210|    public enum RegistrationError: LocalizedError, Sendable, Equatable {\n211|        case notAuthenticated\n212|        case missingPermission(String)\n213|        case invalidDraft(String)\n214|        case noSpacePath(String)\n215|        case downloadMismatch(osName: String, arch: String)\n216|        case integrityMismatch\n217|        case groupScopeNotConfirmed\n218|        case refusesSharedGroup(groupID: Int64)\n219|        case groupNameTaken(name: String, groupID: Int64)\n220|        case groupNotApplicable\n221|        case alreadyInstalled(path: String)\n222|        case alreadyRegistered(name: String)\n223|        case remoteNameTaken(name: String)\n224|        case unverifiedRegistration(String)\n225|        case remoteIdentityMismatch(String)\n226|        case remoteRunnerNotFound(String)\n227|        case confirmationMismatch(String)\n228|        case network(String)\n229|        case unauthorized\n230|        case forbidden(String)\n231|        case rateLimited\n232|        case configFailed(String)\n233|        case cancelled\n234|        /// Same-directory mutation refused while another operation owns the\n235|        /// installation directory. Retryable: the owner releases the lease\n236|        /// when it settles, independently of UI generation abandonment.\n237|        case directoryBusy(path: String)\n238|\n239|        public var errorDescription: String? {\n240|            switch self {\n241|            case .notAuthenticated:\n242|                \"Sign in with GitHub first. Registration needs an authenticated session.\"\n243|            case .missingPermission(let text):\n244|                text.isEmpty ? \"Missing GitHub permission for this step.\" : text\n245|            case .invalidDraft(let text):\n246|                text\n247|            case .noSpacePath(let text):\n248|                text\n249|            case .downloadMismatch(let osName, let arch):\n250|                \"No official runner package for os=\\(osName) arch=\\(arch). Refusing substitute builds.\"\n251|            case .integrityMismatch:\n252|                \"Download integrity check failed (SHA-256 mismatch). Refusing to install.\"\n253|            case .groupScopeNotConfirmed:\n254|                \"Repository access changes need explicit confirmation for the dedicated group.\"\n255|            case .refusesSharedGroup(let groupID):\n256|                \"Refusing to change group \\(groupID): it is not this Mac's dedicated group.\"\n257|            case .groupNameTaken(let name, let groupID):\n258|                \"Group '\\(name)' already exists (id \\(groupID)) and is not this Mac's dedicated group. Choose a different name or explicitly confirm takeover.\"\n259|            case .groupNotApplicable:\n260|                \"Runner groups apply to organization runners only. Repository runners use separate installations.\"\n261|            case .alreadyInstalled(let path):\n262|                \"Installation already exists at \\(path). Resume or remove it before retrying.\"\n263|            case .alreadyRegistered(let name):\n264|                \"Runner '\\(name)' is already registered here. Reuse it instead of creating a duplicate.\"\n265|            case .remoteNameTaken(let name):\n266|                \"Runner '\\(name)' already exists in GitHub. Choose a different name or explicitly allow replace; refusing to silently replace another registration.\"\n267|            case .unverifiedRegistration(let text):\n268|                text.isEmpty ? \"No verified local registration for this installation. Refusing to touch a runner that is not this Mac's installation.\" : text\n269|            case .remoteIdentityMismatch(let text):\n270|                text.isEmpty ? \"GitHub's runner list contradicts this installation's identity. Refusing to adopt another runner.\" : text\n271|            case .remoteRunnerNotFound(let text):\n272|                text.isEmpty ? \"GitHub does not list this installation yet. Refusing to guess by name.\" : text\n273|            case .confirmationMismatch(let text):\n274|                text.isEmpty ? \"GitHub confirmed different repositories than requested. Refusing to report partial access as complete.\" : text\n275|            case .network(let text):\n276|                text\n277|            case .unauthorized:\n278|                \"Session expired or revoked (401). Sign in again.\"\n279|            case .forbidden(let text):\n280|                text.isEmpty ? \"Access forbidden (403).\" : text\n281|            case .rateLimited:\n282|                \"GitHub rate limit reached. Retry later; local runners keep working.\"\n283|            case .configFailed(let text):\n284|                text.isEmpty ? \"Runner configuration failed.\" : text\n285|            case .cancelled:\n286|                \"Registration cancelled.\"\n287|            case .directoryBusy(let path):\n288|                \"Installation directory '\\(path)' is busy with another operation. Retry after it settles; no second operation was started.\"\n289|            }\n290|        }\n291|    }\n292|}","final_result":true}}}
