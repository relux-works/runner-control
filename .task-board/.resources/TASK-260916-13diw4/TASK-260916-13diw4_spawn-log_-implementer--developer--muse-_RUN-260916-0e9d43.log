second download/extract over the same directory.\n222|        try acquireLease(for: directory)\n223|        defer { releaseLease(for: directory) }\n224|        let files = FileManager.default\n225|        if let marker = loadMarker(directory: directory),\n226|           marker.completedSteps.contains(Self.stepInstalled),\n227|           marker.scopeKey == draft.scope.scopeKey,\n228|           Self.markerServerMatches(marker: marker, serverHost: serverHost),\n229|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n(more lines below)","final_result":true}}}
