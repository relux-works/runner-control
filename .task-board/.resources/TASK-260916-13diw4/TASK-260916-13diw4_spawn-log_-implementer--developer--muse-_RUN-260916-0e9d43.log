{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c599","stream":{"kind":"session","id":"01a0a8f3-c96c-76f0-b402-07e24facc60e"},"sequence":295,"recorded_at":1780531400000585,"record_type":"event","durability":"durable","causation_id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049","run_stream":{"kind":"run","id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049"},"call_id":"call_01a0a8f46f8570c7ac1879a67b068d2d","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n1|import CryptoKit\n2|import Foundation\n3|import Testing\n4|import Relux\n5|@testable import RunnerControlCore\n6|\n7|// MARK: - Registration harness (production entry points, controlled IO)\n8|\n9|// TestTransport, jsonResponse, and testConfig are shared from GitHubTransportTests.\n10|\n11|private struct RegistrationHarness {\n12|    let flow: RunnerRegistration.Flow\n13|    let logger: Relux.Testing.Logger\n14|    let transport: TestTransport\n15|    let userStore: GitHubKeychainStore\n16|    let identities: InMemoryGitHubSessionIdentityStore\n17|    let registrationTokens: RunnerRegistrationTokenStore\n18|    let installer: RunnerInstallerService\n19|    let home: URL\n20|    let installRoot: URL\n21|}\n22|\n23|private func registrationHarness(\n24|    transport: TestTransport,\n25|    downloader: (@Sendable (URL) async throws -> Data)? = nil,\n26|    executor: (any CommandExecuting)? = nil,\n27|    arch: String = \"arm64\",\n28|    seedAuth: Bool = true\n29|) async -> RegistrationHarness {\n30|    let logger = Relux.Testing.Logger()\n31|    let dispatcher = Relux.Dispatcher(logger: logger)\n32|    let userStore = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n33|    let identities = InMemoryGitHubSessionIdentityStore()\n34|    if seedAuth {\n35|        await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n36|        try? await userStore.save(\n37|            GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n38|            serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n39|        )\n40|    }\n41|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"RegHome-\" + UUID().uuidString)\n42|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n43|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n44|    let archCopy = arch\n45|    let installer = RunnerInstallerService(\n46|        installRoot: installRoot,\n47|        downloader: downloader,\n48|        executor: executor,\n49|        currentArch: { archCopy }\n50|    )\n51|    let api = GitHubRunnerAPIClient(transport: transport)\n52|    let registrationTokens = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n53|    let refresher = GitHubTokenRefresh(transport: transport, store: userStore)\n54|    let flow = await RunnerRegistration.Flow(\n55|        api: api, installer: installer, registrationTokens: registrationTokens,\n56|        userStore: userStore, identityStore: identities, refresher: refresher,\n57|        configProvider: { _ in testConfig }, dispatcher: dispatcher\n58|    )\n59|    return RegistrationHarness(\n60|        flow: flow, logger: logger, transport: transport, userStore: userStore,\n61|        identities: identities, registrationTokens: registrationTokens,\n62|        installer: installer, home: home, installRoot: installRoot\n63|    )\n64|}\n65|\n66|private func registrationActions(_ logger: Relux.Testing.Logger) -> [RunnerRegistration.Action] {\n67|    logger.actions.compactMap { $0 as? RunnerRegistration.Action }\n68|}\n69|\n70|private func lastFailure(_ logger: Relux.Testing.Logger) -> (message: String, step: String)? {\n71|    for action in registrationActions(logger).reversed() {\n72|        switch action {\n73|        case .failed(let message, let step): return (message, step)\n74|        case .permissionDenied(let message, let step): return (message, step)\n75|        default: break\n76|        }\n77|    }\n78|    return nil\n79|}\n80|\n81|private func orgDraft(\n82|    name: String = \"macbook-test\",\n83|    dir: String = \"macbook-test\",\n84|    group: String = \"RunnerControl-Mac\",\n85|    repos: Set<Int64> = [9],\n86|    allowGroup: Bool = true,\n87|    allowTakeover: Bool = false,\n88|    allowReplace: Bool = false\n89|) -> RunnerRegistration.Draft {\n90|    RunnerRegistration.Draft(\n91|        scope: .organization(org: \"acme\"),\n92|        runnerName: name,\n93|        labels: [\"self-hosted\", \"macOS\"],\n94|        installDirName: dir,\n95|        workFolder: \"_work\",\n96|        groupName: group,\n97|        selectedRepositoryIDs: repos,\n98|        allowGroupMutation: allowGroup,\n99|        allowGroupTakeover: allowTakeover,\n100|        allowReplace: allowReplace\n101|    )\n102|}\n103|\n104|private func repoDraft(dir: String = \"personal-app\", allowReplace: Bool = false) -> RunnerRegistration.Draft {\n105|    RunnerRegistration.Draft(\n106|        scope: .repository(owner: \"octo\", name: \"app\"),\n107|        runnerName: \"personal-runner\",\n108|        labels: [\"self-hosted\", \"macOS\"],\n109|        installDirName: dir,\n110|        workFolder: \"_work\",\n111|        allowGroupMutation: false,\n112|        allowGroupTakeover: false,\n113|        allowReplace: allowReplace\n114|    )\n115|}\n116|\n117|/// The downloads endpoint returns a bare JSON array, not an object.\n118|private func downloadsArrayPayload(_ assets: [[String: Any]]) -> GitHubHTTPResponse {\n119|    // swiftlint:disable:next force_try\n120|    let data = try! JSONSerialization.data(withJSONObject: assets)\n121|    return GitHubHTTPResponse(status: 200, body: data)\n122|}\n123|\n124|/// Typed group fixture: heterogeneous literals (Int/String/Bool) need an\n125|/// explicit `[String: Any]` context to compile.\n126|private func groupPayload(id: Int64, name: String, visibility: String, allowsPublic: Bool) -> [String: Any] {\n127|    [\"id\": id, \"name\": name, \"visibility\": visibility, \"allows_public_repositories\": allowsPublic]\n128|}\n129|\n130|private func groupsListPayload(_ groups: [[String: Any]]) -> GitHubHTTPResponse {\n131|    jsonResponse([\"runner_groups\": groups])\n132|}\n133|\n134|// MARK: - Fixture package (real tarball, controlled filesystem)\n135|\n136|/// Builds a minimal official-shaped runner package and packs it with the\n137|/// real system tar. Scripts keep their executable bit inside the archive.\n138|private struct FixturePackage {\n139|    let bytes: Data\n140|    let sha256ViaSystem: String\n141|\n142|    static func make(withRealConfigScript: Bool = true) async throws -> FixturePackage {\n143|        let files = FileManager.default\n144|        let src = files.temporaryDirectory.appendingPathComponent(\"FixtureSrc-\" + UUID().uuidString)\n145|        let bin = src.appendingPathComponent(\"bin\")\n146|        try files.createDirectory(at: bin, withIntermediateDirectories: true)\n147|        try \"#!/bin/sh\\nexec \\\"$(dirname \\\"$0\\\")/../run.sh\\\" \\\"$@\\\"\\n\".write(to: bin.appendingPathComponent(\"runsvc.sh\"), atomically: true, encoding: .utf8)\n148|        try \"#!/bin/sh\\necho runner\\n\".write(to: src.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n149|        if withRealConfigScript {\n150|            let script = \"\"\"\n151|            #!/bin/sh\n152|            DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n153|            NAME=\"\"\n154|            while [ $# -gt 0 ]; do\n155|              case \"$1\" in\n156|                --name) NAME=\"$2\"; shift 2;;\n157|                *) shift;;\n158|              esac\n159|            done\n160|            printf '{\"agentId\":4242,\"agentName\":\"%s\",\"gitHubUrl\":\"https://github.com/acme\",\"workFolder\":\"_work\"}' \"$NAME\" > \"$DIR/.runner\"\n161|            \"\"\"\n162|            try script.write(to: src.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n163|        } else {\n164|            try \"#!/bin/sh\\nexit 0\\n\".write(to: src.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n165|        }\n166|        for path in [\"bin/runsvc.sh\", \"run.sh\", \"config.sh\"] {\n167|            try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: src.appendingPathComponent(path).path)\n168|        }\n169|        let archive = files.temporaryDirectory.appendingPathComponent(\"fixture-\" + UUID().uuidString + \".tar.gz\")\n170|        defer { try? files.removeItem(at: src) }\n171|        defer { try? files.removeItem(at: archive) }\n172|        let executor = CommandExecutor()\n173|        let packed = try await executor.run(\"/usr/bin/tar\", [\"-czf\", archive.path, \"-C\", src.path, \".\"])\n174|        guard packed.code == 0 else { throw RunnerError.message(\"fixture tar failed: \\(packed.output)\") }\n175|        let bytes = try Data(contentsOf: archive)\n176|        // Independent oracle: system shasum pins the production CryptoKit hasher.\n177|        let hashed = try await executor.run(\"/usr/bin/shasum\", [\"-a\", \"256\", archive.path])\n178|        guard hashed.code == 0 else { throw RunnerError.message(\"shasum missing: \\(hashed.output)\") }\n179|        let digest = hashed.output.split(separator: \" \").first.map(String.init) ?? \"\"\n180|        guard digest.count == 64 else { throw RunnerError.message(\"bad shasum output: \\(hashed.output)\") }\n181|        return FixturePackage(bytes: bytes, sha256ViaSystem: digest)\n182|    }\n183|}\n184|\n185|private func fixtureDownloader(_ bytes: Data) -> @Sendable (URL) async throws -> Data {\n186|    let copy = bytes\n187|    return { _ in copy }\n188|}\n189|\n190|/// Records config.sh argv and simulates a successful registration by writing\n191|/// `.runner`. Delegates every other command (tar) to the real executor.\n192|private actor SplitExecutor: CommandExecuting {\n193|    private(set) var configCalls: [[String]] = []\n194|    var failure: CommandResult?\n195|    private let real = CommandExecutor()\n196|    private let gitHubURL: String\n197|\n198|    init(gitHubURL: String = \"https://github.com/acme\") {\n199|        self.gitHubURL = gitHubURL\n200|    }\n201|\n202|    func run(_ executable: String, _ arguments: [String]) async throws -> CommandResult {\n203|        if executable.hasSuffix(\"config.sh\") {\n204|            configCalls.append(arguments)\n205|            if let failure { return failure }\n206|            let dir = URL(fileURLWithPath: executable).deletingLastPathComponent()\n207|            var name = \"unnamed\"\n208|            var work = \"_work\"\n209|            var index = arguments.startIndex\n210|            while index < arguments.endIndex {\n211|                if arguments[index] == \"--name\", arguments.index(after: index) < arguments.endIndex {\n212|                    name = arguments[arguments.index(after: index)]\n213|                }\n214|                if arguments[index] == \"--work\", arguments.index(after: index) < arguments.endIndex {\n215|                    work = arguments[arguments.index(after: index)]\n216|                }\n217|                index = arguments.index(after: index)\n218|            }\n219|            let payload = [\"agentId\": 4242, \"agentName\": name, \"gitHubUrl\": gitHubURL, \"workFolder\": work] as [String: Any]\n220|            let data = try JSONSerialization.data(withJSONObject: payload)\n221|            try data.write(to: dir.appendingPathComponent(\".runner\"), options: .atomic)\n222|            return CommandResult(code: 0, output: \"Configured\")\n223|        }\n224|        return try await real.run(executable, arguments)\n225|    }\n226|}\n227|\n228|// MARK: - Reducer and pure gates\n229|\n230|@Test @MainActor func registrationReducerRetainsPermissionErrorAcrossDraftEdits() async {\n231|    let state = RunnerRegistration.State()\n232|    await state.reduce(with: ForeignAction())\n233|    #expect(state.phase == .idle)\n234|    let draft = orgDraft()\n235|    await state.reduce(with: RunnerRegistration.Action.draftBegan(draft))\n236|    #expect(state.phase == .drafting)\n237|    await state.reduce(with: RunnerRegistration.Action.permissionDenied(message: \"Missing permission: X\", step: \"resolveGroup\"))\n238|    #expect(state.permissionError == \"Missing permission: X\")\n239|    // Draft edits must retain the permission error by design.\n240|    var edited = draft\n241|    edited.runnerName = \"renamed\"\n242|    await state.reduce(with: RunnerRegistration.Action.draftUpdated(edited))\n243|    #expect(state.permissionError == \"Missing permission: X\")\n244|    #expect(state.draft?.runnerName == \"renamed\")\n245|    await state.reduce(with: RunnerRegistration.Action.permissionDismissed)\n246|    #expect(state.permissionError == nil)\n247|    await state.reduce(with: RunnerRegistration.Action.registered(runnerID: 11, localAgentID: 4242))\n248|    #expect(state.runnerID == 11)\n249|    await state.cleanup()\n250|    #expect(state.phase == .idle)\n251|    #expect(state.draft == nil)\n252|}\n253|\n254|@Test func configInvocationIsExactAndOrdered() {\n255|    let orgSpec = RunnerRegistration.ConfigSpec(\n256|        scopeURL: \"https://github.com/acme\", token: \"TOKEN\",\n257|        name: \"mac1\", workFolder: \"_work\",\n258|        labels: [\"self-hosted\", \"macOS\"], runnerGroup: \"RunnerControl-Mac\",\n259|        replace: true\n260|    )\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c59b","stream":{"kind":"session","id":"01a0a8f3-c96c-76f0-b402-07e24facc60e"},"sequence":296,"recorded_at":1780531400000587,"record_type":"event","durability":"durable","causation_id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049","run_stream":{"kind":"run","id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049"},"call_id":"call_01a0a8f4719c7579a4c5b1825237f11a","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(2549 line(s) above)\n2550|// R4 findings (repeat-of R3-F1) as committed named regressions through the\n2551|// production Flow entry point.\n2552|\n2553|// Reviewer-only tests appended to the immutable candidate in a disposable copy.\n2554|@Test @MainActor func reviewerRetryCannotRunTwoConfigsInSameDirectory() async throws {\n2555|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2556|    let executor = ConfigLatchExecutor()\n2557|    let transport = TestTransport([\n2558|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2559|        runnersListPayload([]),\n2560|        jsonResponse([\"token\": \"REG-OLD\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2561|        runnersListPayload([]),\n2562|        jsonResponse([\"token\": \"REG-NEW\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2563|        runnersListPayload([[\"id\": 4242, \"name\": \"renamed-runner\", \"labels\": []]])\n2564|    ])\n2565|    let h = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor)\n2566|    defer { try? FileManager.default.removeItem(at: h.home) }\n2567|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2568|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2569|    let old = Task { await h.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2570|    await executor.waitStarted()\n2571|    var edited = orgDraft()\n2572|    edited.runnerName = \"renamed-runner\"\n2573|    _ = await h.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2574|    _ = await h.flow.apply(RunnerRegistration.Effect.registerRunner)\n2575|    let callsWhileOldRuns = await executor.configCalls.count\n2576|    await executor.release()\n2577|    _ = await old.value\n2578|    #expect(callsWhileOldRuns == 1, \"An identity edit must not allow a second config.sh while the first still owns this directory\")\n2579|    let state = RunnerRegistration.State()\n2580|    for action in registrationActions(h.logger) { await state.reduce(with: action) }\n2581|    let directory = await h.installer.directory(for: edited.installDirName)\n2582|    let local = await h.installer.readLocalRegistration(directory: directory)\n2583|    #expect(!state.completedSteps.contains(\"registerRunner\") || local?.agentName == edited.runnerName,\n2584|            \"New registration is attested complete but old in-flight config overwrites .runner afterwards\")\n2585|}\n2586|\n2587|private actor ReviewTwoDownloads {\n2588|    private var count = 0\n2589|    private var started: Set<Int> = []\n2590|    private var startWaiters: [Int: CheckedContinuation<Void, Never>] = [:]\n2591|    private var releases: [Int: CheckedContinuation<Void, Never>] = [:]\n2592|    func download(_ bytes: Data) async throws -> Data {\n2593|        count += 1\n2594|        let n = count\n2595|        started.insert(n)\n2596|        startWaiters.removeValue(forKey: n)?.resume()\n2597|        await withCheckedContinuation { releases[n] = $0 }\n2598|        if n == 1 { throw GitHubTransportError.invalidResponse }\n2599|        return bytes\n2600|    }\n2601|    func waitStarted(_ n: Int) async {\n2602|        if started.contains(n) { return }\n2603|        await withCheckedContinuation { startWaiters[n] = $0 }\n2604|    }\n2605|    func release(_ n: Int) { releases.removeValue(forKey: n)?.resume() }\n2606|}\n2607|\n2608|@Test func reviewerStaleFailureCannotUnlockNewOperation() async throws {\n2609|    let package = try await FixturePackage.make()\n2610|    let latch = ReviewTwoDownloads()\n2611|    let transport = TestTransport([\n2612|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2613|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))\n2614|    ])\n2615|    let h = await registrationHarness(transport: transport, downloader: { _ in try await latch.download(package.bytes) })\n2616|    defer { try? FileManager.default.removeItem(at: h.home) }\n2617|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2618|    let old = Task { await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2619|    await latch.waitStarted(1)\n2620|    var edited = orgDraft()\n2621|    edited.installDirName = \"new-install\"\n2622|    _ = await h.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2623|    let current = Task { await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2624|    await latch.waitStarted(2)\n2625|    await latch.release(1)\n2626|    _ = await old.value\n2627|    let before = await transport.requests.count\n2628|    _ = await h.flow.apply(RunnerRegistration.Effect.prepareDownload)\n2629|    let after = await transport.requests.count\n2630|    await latch.release(2)\n2631|    _ = await current.value\n2632|    #expect(after == before, \"Old generation's catch must not clear the current operation's working lock\")\n2633|}\n2634|\n2635|// MARK: - R5: lifecycle ownership across begin/update/cancel/reset\n2636|\n2637|// Latch downloader: suspends the FIRST download so an abandoning edit can\n2638|// land while an install is in flight; later downloads pass through. Counts\n2639|// every call so tests prove a refused retry started no second download.\n2640|private actor CountingLatchDownloader {\n2641|    private let bytes: Data\n2642|    private(set) var calls = 0\n2643|    private var latched = false\n2644|    var started = false\n2645|    private var waiter: CheckedContinuation<Void, Never>?\n2646|    private var releaseWaiter: CheckedContinuation<Void, Never>?\n2647|    init(bytes: Data) { self.bytes = bytes }\n2648|    func download(_ url: URL) async throws -> Data {\n2649|        calls += 1\n2650|        if !latched {\n2651|            latched = true\n2652|            started = true\n2653|            waiter?.resume(); waiter = nil\n2654|            await withCheckedContinuation { releaseWaiter = $0 }\n2655|        }\n2656|        return bytes\n2657|    }\n2658|    func waitStarted() async {\n2659|        if started { return }\n2660|        await withCheckedContinuation { waiter = $0 }\n2661|    }\n2662|    func release() { releaseWaiter?.resume(); releaseWaiter = nil }\n2663|}\n2664|\n2665|@Test @MainActor func beginDraftDuringDownloadKeepsDirectoryLease() async throws {\n2666|    // R5/R4-F1 at the beginDraft boundary: a new draft for the SAME directory\n2667|    // releases the UI lock but never the live install's directory lease. A\n2668|    // same-directory retry while the first install runs is refused retryably\n2669|    // (no second download); after the first settles stale, retry reuses it.\n2670|    let package = try await FixturePackage.make()\n2671|    let downloads = CountingLatchDownloader(bytes: package.bytes)\n2672|    let transport = TestTransport([\n2673|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2674|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2675|    ])\n2676|    let harness = await registrationHarness(\n2677|        transport: transport, downloader: { url in try await downloads.download(url) }\n2678|    )\n2679|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2680|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2681|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2682|    await downloads.waitStarted()\n2683|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2684|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2685|    #expect(await downloads.calls == 1, \"Second download must not start while the first owns this directory\")\n2686|    #expect(lastFailure(harness.logger)?.step == \"downloadAndInstall\")\n2687|    #expect(lastFailure(harness.logger)?.message.contains(\"busy\") ?? false)\n2688|    await downloads.release()\n2689|    _ = await old.value\n2690|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n2691|    #expect(await downloads.calls == 1, \"Retry after settle reuses the install instead of downloading again\")\n2692|    let state = RunnerRegistration.State()\n2693|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2694|    #expect(state.installPath != nil)\n2695|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n2696|}\n2697|\n2698|@Test @MainActor func resetDuringDownloadKeepsDirectoryLeaseUntilSettled() async throws {\n2699|    // R5/R4-F1 at the reset boundary: reset releases the UI lock at once,\n2700|    // but the live install keeps its directory lease until it settles. A\n2701|    // same-directory install for the fresh draft is refused while live and\n2702|    // reuses the settled install on retry.\n2703|    let package = try await FixturePackage.make()\n2704|    let downloads = CountingLatchDownloader(bytes: package.bytes)\n2705|    let transport = TestTransport([\n2706|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2707|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2708|    ])\n2709|    let harness = await registrationHarness(\n2710|        transport: transport, downloader: { url in try await downloads.download(url) }\n2711|    )\n2712|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2713|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2714|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2715|    await downloads.waitStarted()\n2716|    _ = await harness.flow.apply(RunnerRegistration.Effect.reset)\n2717|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2718|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2719|    #expect(await downloads.calls == 1, \"Second download must not start while the reset-abandoned install is live\")\n2720|    #expect(lastFailure(harness.logger)?.message.contains(\"busy\") ?? false)\n2721|    await downloads.release()\n2722|    _ = await old.value\n2723|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n2724|    #expect(await downloads.calls == 1, \"Retry after settle reuses the install instead of downloading again\")\n2725|    let state = RunnerRegistration.State()\n2726|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2727|    #expect(state.installPath != nil)\n2728|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n2729|}\n2730|\n2731|@Test @MainActor func cancelDuringConfigKeepsLeaseAndRecoversAfterSettle() async throws {\n2732|    // R5/R4-F1 at the cancel boundary: cancel releases the UI lock at once,\n2733|    // but the live config.sh keeps its directory lease. A same-directory\n2734|    // register while it runs starts no second config (busy, token deleted);\n2735|    // after it settles stale, retry resumes the verified registration.\n2736|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2737|    let executor = ConfigLatchExecutor()\n2738|    let transport = TestTransport([\n2739|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2740|        runnersListPayload([]),\n2741|        jsonResponse([\"token\": \"REG-OLD\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2742|        runnersListPayload([]),\n2743|        jsonResponse([\"token\": \"REG-BUSY\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2744|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2745|    ])\n2746|    let harness = await registrationHarness(\n2747|        transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor\n2748|    )\n2749|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2750|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2751|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2752|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2753|    await executor.waitStarted()\n2754|    _ = await harness.flow.apply(RunnerRegistration.Effect.cancel)\n2755|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n2756|    #expect(await executor.configCalls.count == 1, \"Second config.sh must not run while the cancelled config still owns this directory\")\n2757|    #expect(lastFailure(harness.logger)?.step == \"registerRunner\")\n2758|    #expect(lastFailure(harness.logger)?.message.contains(\"busy\") ?? false)\n2759|    await executor.release()\n2760|    _ = await old.value\n2761|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n2762|    let actions = registrationActions(harness.logger)\n2763|    #expect(actions.contains {\n2764|        if case .registered(let runnerID, let localAgentID) = $0 {\n2765|            runnerID == 4242 && localAgentID == 4242\n2766|        } else { false }\n2767|    })\n2768|    let state = RunnerRegistration.State()\n2769|    for item in actions { await state.reduce(with: item) }\n2770|    #expect(state.completedSteps.contains(\"registerRunner\"))\n2771|    let scopeKey = RunnerRegistration.Flow.tokenScopeKey(draft: orgDraft())\n2772|    #expect(await harness.registrationTokens.load(scopeKey: scopeKey) == nil, \"Both minted tokens are deleted\")\n2773|}\n2774|\n2775|@Test @MainActor func nonconflictingInstallProceedsWhileOtherDirectoryRuns() async throws {\n2776|    // R5 lease scope: the lease is per-directory, not global. While an\n2777|    // install for dirA is live (then abandoned), an install for dirB\n2778|    // proceeds; the old completion stays unattested for the new draft.\n2779|    let package = try await FixturePackage.make()\n2780|    let downloads = CountingLatchDownloader(bytes: package.bytes)\n2781|    let transport = TestTransport([\n2782|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2783|    ])\n2784|    let harness = await registrationHarness(\n2785|        transport: transport, downloader: { url in try await downloads.download(url) }\n2786|    )\n2787|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2788|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2789|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2790|    await downloads.waitStarted()\n2791|    var moved = orgDraft()\n2792|    moved.installDirName = \"new-install\"\n2793|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(moved))\n2794|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2795|    #expect(await downloads.calls == 2, \"Nonconflicting directory must not be blocked by another live install\")\n2796|    let mid = RunnerRegistration.State()\n2797|    for item in registrationActions(harness.logger) { await mid.reduce(with: item) }\n2798|    #expect(mid.installPath?.hasSuffix(\"new-install\") ?? false)\n2799|    #expect(mid.completedSteps.contains(\"downloadAndInstall\"))\n2800|    await downloads.release()\n2801|    _ = await old.value\n2802|    let state = RunnerRegistration.State()\n2803|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2804|    #expect(state.installPath?.hasSuffix(\"new-install\") ?? false)\n2805|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n2806|    let installed = registrationActions(harness.logger).filter {\n2807|        if case .installed = $0 { true } else { false }\n2808|    }\n2809|    #expect(installed.count == 1, \"Abandoned install must not attest a second path\")\n2810|}\n2811|\n2812|@Test @MainActor func staleRegisterFailureDoesNotUnlockOrPlantFailure() async throws {\n2813|    // R5/R4-F2 for the register step: while a config.sh is live, the draft\n2814|    // moves to another directory and that install completes. When the old\n2815|    // config then fails, its stale exit records nothing: no failure is\n2816|    // planted and no success is revoked.\n2817|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2818|    let executor = ConfigLatchExecutor(failure: CommandResult(code: 1, output: \"config exploded\"))\n2819|    let transport = TestTransport([\n2820|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2821|        runnersListPayload([]),\n2822|        jsonResponse([\"token\": \"REG-OLD\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2823|    ])\n2824|    let harness = await registrationHarness(\n2825|        transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor\n2826|    )\n2827|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2828|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2829|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2830|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2831|    await executor.waitStarted()\n2832|    var moved = orgDraft()\n2833|    moved.installDirName = \"new-install\"\n2834|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(moved))\n2835|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2836|    await executor.release()\n2837|    _ = await old.value\n2838|    #expect(lastFailure(harness.logger) == nil, \"Stale register failure must not plant a failure for the new draft\")\n2839|    let state = RunnerRegistration.State()\n2840|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2841|    #expect(state.installPath?.hasSuffix(\"new-install\") ?? false)\n2842|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n2843|    #expect(state.failedStep == nil)\n2844|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
