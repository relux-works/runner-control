{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c521","stream":{"kind":"session","id":"01a0a8f3-c96c-76f0-b402-07e24facc60e"},"sequence":235,"recorded_at":1780531400000465,"record_type":"event","durability":"durable","causation_id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049","run_stream":{"kind":"run","id":"cf0d70f9-80e9-40d1-b7e2-9ab1aef0f049"},"task_stream":{"kind":"task","id":"01a0a8f4-590a-7191-97b4-7e7383529436"},"task_id":"01a0a8f4-590a-7191-97b4-7e7383529436","event":{"kind":"output","task_id":"01a0a8f4-590a-7191-97b4-7e7383529436","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n(499 line(s) above)\n500|            guard !isStale(gen) else { return }\n501|            let serverHost = auth.identity.serverHost\n502|            let resolved: RunnerRegistration.DownloadAsset\n503|            if let asset {\n504|                resolved = asset\n505|            } else {\n506|                resolved = try await prepareDownloadInner(draft: draft, auth: auth, generation: gen)\n507|                guard !isStale(gen) else { return }\n508|                asset = resolved\n509|                await action { RunnerRegistration.Action.downloadReady(resolved) }\n510|            }\n511|            guard !isStale(gen) else { return }\n512|            let directory = try await installer.downloadAndInstall(\n513|                asset: resolved, draft: draft, serverHost: serverHost\n514|            )\n515|            guard !isStale(gen) else { return }\n516|            installPath = directory.path\n517|            await action { RunnerRegistration.Action.installed(path: directory.path) }\n518|            await finishStep(\"downloadAndInstall\", generation: gen)\n519|        } catch {\n520|            await fail(error, step: \"downloadAndInstall\", generation: gen)\n521|        }\n522|    }\n523|\n524|    // MARK: - Register\n525|\n526|    private func registerRunner() async {\n527|        let gen = generation\n528|        guard workingOwner == nil else { return }\n529|        guard let draft else {\n530|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"registerRunner\") }\n531|            return\n532|        }\n533|        guard let installPath else {\n534|            failedStep = \"registerRunner\"\n535|            await action {\n536|                RunnerRegistration.Action.failed(message: \"Install the runner package first.\", step: \"registerRunner\")\n537|            }\n538|            return\n539|        }\n540|        workingOwner = gen\n541|        workingStep = \"registerRunner\"\n542|        await action { RunnerRegistration.Action.stepStarted(\"registerRunner\") }\n543|        let directory = URL(fileURLWithPath: installPath)\n544|        let scopeKey = Self.tokenScopeKey(draft: draft)\n545|        do {\n546|            // The whole step — including idempotent resume — is bound to one\n547|            // authenticated server. Resume verifies the full local identity\n548|            // (server/scope/agent/name/work-folder/group) before any success:\n549|            // a drifted or re-targeted draft never adopts the old marker.\n550|            let auth = try await currentUserToken(generation: gen)\n551|            guard !isStale(gen) else { return }\n552|            _ = syncServerBinding(auth.identity.serverHost)\n553|            guard !isStale(gen) else { return }\n554|            let serverHost = auth.identity.serverHost\n555|            if await installer.hasCompleted(RunnerInstallerService.stepConfigured, directory: directory) {\n556|                let local = await installer.readLocalRegistration(directory: directory)\n557|                let localID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n558|                    local: local, configured: true, draft: draft, serverHost: serverHost\n559|                )\n560|                let marker = await installer.loadMarker(directory: directory)\n561|                let groupName: String?\n562|                switch draft.scope {\n563|                case .organization:\n564|                    groupName = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n565|                case .repository:\n566|                    groupName = nil\n567|                }\n568|                try RunnerInstallerService.verifyConfiguredGroup(\n569|                    marker: marker, runnerGroup: groupName, draft: draft\n570|                )\n571|                let remoteID = try await resolveBoundRemoteRunnerID(\n572|                    draft: draft, localAgentID: localID, auth: auth, generation: gen\n573|                )\n574|                guard !isStale(gen) else { return }\n575|                runnerID = remoteID\n576|                await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: localID) }\n577|                await finishStep(\"registerRunner\", generation: gen)\n578|                return\n579|            }\n580|            guard !isStale(gen) else { return }\n581|            // Duplicate guard before any token is minted: without explicit\n582|            // replace consent a remote name match refuses the run so config\n583|            // can never silently replace another machine's registration.\n584|            // The list is complete (every page followed); a duplicate that\n585|            // appears after this check still fails at config.sh, which omits\n586|            // `--replace` unless the user explicitly allowed it.\n587|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n588|            let existing = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n589|            guard !isStale(gen) else { return }\n590|            try RunnerRegistration.Gates.rejectRemoteDuplicate(\n591|                name: wanted, isTaken: existing.contains(where: { $0.name == wanted }),\n592|                allowReplace: draft.allowReplace\n593|            )\n594|            guard !isStale(gen) else { return }\n595|            let created = try await api.createRegistrationToken(\n596|                config: auth.config, token: auth.token, scope: draft.scope\n597|            )\n598|            guard !isStale(gen) else { return }\n599|            let scoped = RunnerRegistration.ScopedToken(\n600|                token: created.token, expiresAt: created.expiresAt, obtainedAt: now()\n601|            )\n602|            try await registrationTokens.save(scoped, scopeKey: scopeKey)\n603|            guard !isStale(gen) else { return }\n604|            let groupName: String?\n605|            switch draft.scope {\n606|            case .organization: groupName = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n607|            case .repository: groupName = nil\n608|            }\n609|            let localID: Int64?\n610|            do {\n611|                localID = try await installer.runConfig(\n612|                    directory: directory,\n613|                    scopeURL: draft.scope.configURL(serverHost: auth.identity.serverHost),\n614|                    token: created.token,\n615|                    draft: draft,\n616|                    runnerGroup: groupName\n617|                )\n618|            } catch {\n619|                await registrationTokens.delete(scopeKey: scopeKey)\n620|                throw error\n621|            }\n622|            // The single-use token is consumed by config.sh: delete it before\n623|            // any follow-up API call so a post-config failure (review F6)\n624|            // reports the error without retaining the token.\n625|            await registrationTokens.delete(scopeKey: scopeKey)\n626|            guard !isStale(gen) else { return }\n627|            // Bind the remote ID to the verified local agent, never to a\n628|            // bare name match: a same-name foreign runner must fail here\n629|            // instead of becoming this installation's identity.\n630|            let verifiedLocal: RunnerRegistration.LocalRegistration? = await installer.readLocalRegistration(\n631|                directory: directory\n632|            )\n633|            let verifiedConfigured = await installer.hasCompleted(\n634|                RunnerInstallerService.stepConfigured, directory: directory\n635|            )\n636|            let verifiedID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n637|                local: verifiedLocal,\n638|                configured: verifiedConfigured && localID != nil,\n639|                draft: draft,\n640|                serverHost: serverHost\n641|            )\n642|            let remoteID = try await resolveBoundRemoteRunnerID(\n643|                draft: draft, localAgentID: verifiedID, auth: auth, generation: gen\n644|            )\n645|            guard !isStale(gen) else { return }\n646|            runnerID = remoteID\n647|            await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: verifiedID) }\n648|            guard !isStale(gen) else { return }\n649|            await action { RunnerRegistration.Action.permissionDismissed }\n650|            await finishStep(\"registerRunner\", generation: gen)\n651|        } catch {\n652|            await fail(error, step: \"registerRunner\", generation: gen)\n653|        }\n654|    }\n655|\n656|    /// Binds the complete remote runner list to the verified local agent ID.\n657|    /// Returns nil when this agent is not listed yet (convergence, retryable);\n658|    /// throws when the list contradicts the local identity. The step's own\n659|    /// auth is reused: no mid-step session reload may mix servers.\n660|    private func resolveBoundRemoteRunnerID(\n661|        draft: RunnerRegistration.Draft, localAgentID: Int64,\n662|        auth: FlowUserToken, generation gen: Int\n663|    ) async throws -> Int64? {\n664|        guard !isStale(gen) else { throw CancellationError() }\n665|        let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n666|        let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n667|        return try RunnerRegistration.Gates.boundRemoteRunnerID(\n668|            localAgentID: localAgentID, name: wanted, runners: runners\n669|        )\n670|    }\n671|\n672|    // MARK: - Service\n673|\n674|    private func setupService() async {\n675|        let gen = generation\n676|        guard workingOwner == nil else { return }\n677|        guard let draft, let installPath else {\n678|            failedStep = \"setupService\"\n679|            await action {\n680|                RunnerRegistration.Action.failed(message: \"Register the runner first.\", step: \"setupService\")\n681|            }\n682|            return\n683|        }\n684|        workingOwner = gen\n685|        workingStep = \"setupService\"\n686|        await action { RunnerRegistration.Action.stepStarted(\"setupService\") }\n687|        let directory = URL(fileURLWithPath: installPath)\n688|        do {\n689|            // Service setup never declares registration complete on its own:\n690|            // it requires this operation's verified configured local identity\n691|            // on the authenticated server.\n692|            let auth = try await currentUserToken(generation: gen)\n693|            guard !isStale(gen) else { return }\n694|            _ = syncServerBinding(auth.identity.serverHost)\n695|            guard !isStale(gen) else { return }\n696|            let local = await installer.readLocalRegistration(directory: directory)\n697|            let configured = await installer.hasCompleted(\n698|                RunnerInstallerService.stepConfigured, directory: directory\n699|            )\n700|            _ = try RunnerRegi