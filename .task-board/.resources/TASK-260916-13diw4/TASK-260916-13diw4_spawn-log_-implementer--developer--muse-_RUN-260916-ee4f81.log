{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c563","stream":{"kind":"session","id":"01a0a92d-72d5-7050-8a68-2291f8904dd8"},"sequence":268,"recorded_at":1780531400000531,"record_type":"event","durability":"durable","causation_id":"78df6718-13a7-44bd-a557-df1400b3b946","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"78df6718-13a7-44bd-a557-df1400b3b946","run_stream":{"kind":"run","id":"78df6718-13a7-44bd-a557-df1400b3b946"},"call_id":"call_01a0a92e43f3742a8d5b72511b9d0ecb","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n1|import CryptoKit\n2|import Foundation\n3|\n4|/// Filesystem installer for downloaded GitHub Actions runners.\n5|///\n6|/// Production path: download bytes → SHA-256 verify → tar extract →\n7|/// `bin/runsvc.sh` copied into the root and chmodded (as official `svc.sh`\n8|/// would) → exact `config.sh` invocation → manual LaunchAgent plist.\n9|/// All side effects stay below `installRoot`; tests inject a temporary root,\n10|/// a fake downloader, and fixtures instead of touching production runners.\n11|public actor RunnerInstallerService {\n12|    public static let markerFileName = \".runnercontrol-install.json\"\n13|    public static let installOS = \"osx\"\n14|\n15|    private let installRoot: URL\n16|    private let downloader: @Sendable (URL) async throws -> Data\n17|    private let executor: any CommandExecuting\n18|    private let currentArch: @Sendable () -> String\n19|    private let hasher: @Sendable (Data) -> String\n20|    /// Test seam for filesystem case-equivalence: nil (production) queries\n21|    /// the real volume; non-nil forces the assumed sensitivity. Follows the\n22|    /// existing downloader/executor/arch/hasher injection pattern.\n23|    private let caseSensitivityOverride: Bool?\n24|\n25|    public init(\n26|        installRoot: URL? = nil,\n27|        downloader: (@Sendable (URL) async throws -> Data)? = nil,\n28|        executor: (any CommandExecuting)? = nil,\n29|        currentArch: (@Sendable () -> String)? = nil,\n30|        hasher: (@Sendable (Data) -> String)? = nil,\n31|        caseSensitivityOverride: Bool? = nil\n32|    ) {\n33|        self.installRoot = installRoot\n34|            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/GitHubActions\")\n35|        self.caseSensitivityOverride = caseSensitivityOverride\n36|        self.downloader = downloader ?? { url in\n37|            let (data, _) = try await URLSession.shared.data(from: url)\n38|            return data\n39|        }\n40|        self.executor = executor ?? CommandExecutor()\n41|        self.currentArch = currentArch ?? {\n42|            #if arch(arm64)\n43|            return \"arm64\"\n44|            #else\n45|            return \"x64\"\n46|            #endif\n47|        }\n48|        self.hasher = hasher ?? { data in\n49|            SHA256.hash(data: data).map { String(format: \"%02x\", $0) }.joined()\n50|        }\n51|    }\n52|\n53|    public nonisolated var root: URL { installRoot }\n54|    public nonisolated var architecture: String { currentArch() }\n55|\n56|    /// Canonical installation directories with a live mutating side effect\n57|    /// (download/extract/config/service/recovery). Acquired synchronously\n58|    /// before the first await and released only when the owning operation\n59|    /// settles, so actor reentrancy can never admit two mutations of one\n60|    /// directory. Abandoning a UI generation does not release this resource;\n61|    /// only the settling side effect does.\n62|    private var activeDirectories: Set<String> = []\n63|\n64|    public func directory(for installDirName: String) -> URL {\n65|        installRoot.appendingPathComponent(installDirName)\n66|    }\n67|\n68|    /// Canonical lease key for a directory: physical filesystem identity, not\n69|    /// path spelling. Both Flow-derived URLs (from a stored install path)\n70|    /// and `directory(for:)` URLs map to the same key for the same on-disk\n71|    /// location, including through symlink leaves and symlink ancestors.\n72|    /// Not-yet-created leaves canonicalize via their nearest existing\n73|    /// ancestor, so `/tmp`-vs-`/private/tmp` spellings of one directory map\n74|    /// to one key before the leaf exists. On case-insensitive volumes the key\n75|    /// is additionally case-folded (POSIX locale), so `macbook-test` and\n76|    /// `MACBOOK-TEST` share one lease while the leaf is still absent; the\n77|    /// fold matches the on-disk spelling `resolvingSymlinksInPath` returns\n78|    /// after creation, keeping identity stable before/after creation.\n79|    /// Case-sensitive volumes keep distinct keys per spelling. The\n80|    /// sensitivity comes from the real volume unless `caseSensitiveOverride`\n81|    /// forces it (tests only).\n82|    nonisolated static func leaseKey(for directory: URL, caseSensitiveOverride: Bool? = nil) -> String {\n83|        let standardized = URL(fileURLWithPath: directory.path).standardizedFileURL\n84|        let files = FileManager.default\n85|        var base = standardized\n86|        var suffix: [String] = []\n87|        while true {\n88|            if files.fileExists(atPath: base.path) || Self.isSymlink(atPath: base.path) {\n89|                break\n90|            }\n91|            let parent = base.deletingLastPathComponent()\n92|            if parent.path == base.path { break }\n93|            suffix.insert(base.lastPathComponent, at: 0)\n94|            base = parent\n95|        }\n96|        let resolvedBase = base.resolvingSymlinksInPath().path\n97|        let canonical: String\n98|        if suffix.isEmpty {\n99|            canonical = URL(fileURLWithPath: resolvedBase).standardizedFileURL.path\n100|        } else {\n101|            var url = URL(fileURLWithPath: resolvedBase, isDirectory: true)\n102|            for component in suffix { url.appendPathComponent(component) }\n103|            canonical = url.standardizedFileURL.path\n104|        }\n105|        let sensitive: Bool\n106|        if let override = caseSensitiveOverride {\n107|            sensitive = override\n108|        } else {\n109|            sensitive = Self.isCaseSensitiveVolume(\n110|                at: URL(fileURLWithPath: resolvedBase, isDirectory: true)\n111|            )\n112|        }\n113|        guard !sensitive else { return canonical }\n114|        return canonical.lowercased(with: Locale(identifier: \"en_US_POSIX\"))\n115|    }\n116|\n117|    /// True only when the volume containing `url` reports case-sensitive\n118|    /// names. Unknown or unreadable volumes fail closed toward alias safety\n119|    /// (reported insensitive, so spellings fold): on a truly sensitive\n120|    /// volume that only over-serializes distinct spellings into a retryable\n121|    /// `directoryBusy`, while the reverse would admit concurrent mutations\n122|    /// of one physical directory.\n123|    nonisolated static func isCaseSensitiveVolume(at url: URL) -> Bool {\n124|        (try? url.resourceValues(forKeys: [.volumeSupportsCaseSensitiveNamesKey]))\n125|            .flatMap(\\.volumeSupportsCaseSensitiveNames) == true\n126|    }\n127|\n128|    private nonisolated static func isSymlink(atPath path: String) -> Bool {\n129|        (try? FileManager.default.destinationOfSymbolicLink(atPath: path)) != nil\n130|    }\n131|\n132|    /// Refuses Finder-alias installation paths before any side effect. A\n133|    /// Finder alias is not a transparent directory like a symlink: operating\n134|    /// through its spelling would not operate on the target, so alias\n135|    /// spellings are rejected instead of being canonicalized. Symlinks are\n136|    /// resolved by `leaseKey`, not refused here — and must be excluded\n137|    /// explicitly because `isAliasFileKey` is also true for symlinks such as\n138|    /// the system `/var` and `/tmp` links every temporary path resolves\n139|    /// through.\n140|    nonisolated static func ensureNoAlias(at directory: URL) throws {\n141|        var current = URL(fileURLWithPath: directory.path).standardizedFileURL\n142|        while true {\n143|            if FileManager.default.fileExists(atPath: current.path),\n144|               !isSymlink(atPath: current.path),\n145|               (try? current.resourceValues(forKeys: [.isAliasFileKey]))?.isAliasFile == true {\n146|                throw RunnerRegistration.RegistrationError.invalidDraft(\n147|                    \"Installation path '\\(directory.path)' resolves through a Finder alias at '\\(current.path)'. Choose a direct folder path instead of an alias.\"\n148|                )\n149|            }\n150|            let parent = current.deletingLastPathComponent()\n151|            if parent.path == current.path { break }\n152|            current = parent\n153|        }\n154|    }\n155|\n156|    /// Acquires exclusive ownership of `directory`. Synchronous: callers must\n157|    /// invoke it before their first await so the check-and-insert is atomic\n158|    /// under actor isolation. Throws a retryable `directoryBusy` when another\n159|    /// live operation already owns the directory; different physical\n160|    /// directories never conflict. Returns the originally acquired canonical\n161|    /// key; the caller must hold it across awaits and release that exact key.\n162|    private func acquireLease(for directory: URL) throws -> String {\n163|        try Self.ensureNoAlias(at: directory)\n164|        let key = Self.leaseKey(for: directory, caseSensitiveOverride: caseSensitivityOverride)\n165|        guard !activeDirectories.contains(key) else {\n166|            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n167|        }\n168|        activeDirectories.insert(key)\n169|        return key\n170|    }\n171|\n172|    private func releaseLease(_ key: String) {\n173|        activeDirectories.remove(key)\n174|    }\n175|\n176|    /// Refuses a synchronous mutation (service setup, recovery) while a live\n177|    /// async side effect owns the directory. No insert: without an await the\n178|    /// caller itself cannot interleave, it only needs to respect leases held\n179|    /// by others. Uses the same canonical identity as acquisition.\n180|    private func requireIdleDirectory(_ directory: URL) throws {\n181|        try Self.ensureNoAlias(at: directory)\n182|        let key = Self.leaseKey(for: directory, caseSensitiveOverride: caseSensitivityOverride)\n183|        guard !activeDirectories.contains(key) else {\n184|            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n185|        }\n186|    }\n187|\n188|    // MARK: - Idempotency markers\n189|\n190|    public struct Marker: Codable, Sendable, Equatable {\n191|        public var scopeKey: String\n192|        public var completedSteps: Set<String>\n193|        /// Server the directory was configured against (`.runner` host is\n194|        /// authoritative; this records the config-time expectation so a\n195|        /// group/server change cannot reuse an old configured marker).\n196|        public var serverHost: String?\n197|        /// Dedicated group passed to `config.sh --runnergroup` (org scope).\n198|        /// `.runner` does not record it, so the marker must: a group-name\n199|        /// edit never claims the old group's configuration as its own.\n200|        public var groupName: String?\n201|        public init(\n202|            scopeKey: String, completedSteps: Set<String> = [],\n203|            serverHost: String? = nil, groupName: String? = nil\n204|        ) {\n205|            self.scopeKey = scopeKey; self.completedSteps = completedSteps\n206|            self.serverHost = serverHost; self.groupName = groupName\n207|        }\n208|    }\n209|\n210|    public static let stepDownloaded = \"downloaded\"\n211|    public static let stepInstalled = \"installed\"\n212|    public static let stepConfigured = \"configured\"\n213|    public static let stepServiceReady = \"serviceReady\"\n214|\n215|    public func loadMarker(directory: URL) -> Marker? {\n216|        let url = directory.appendingPathComponent(Self.markerFileName)\n217|        guard let data = try? Data(contentsOf: url) else { return nil }\n218|        return try? JSONDecoder().decode(Marker.self, from: data)\n219|    }\n220|\n221|    private func storeMarker(_ marker: Marker, directory: URL) throws {\n222|        let data = try JSONEncoder().encode(marker)\n223|        try data.write(to: directory.appendingPathComponent(Self.markerFileName), options: .atomic)\n224|    }\n225|\n226|    public func markCompleted(\n227|        _ step: String, directory: URL, scopeKey: String,\n228|        serverHost: String? = nil, groupName: String? = nil\n229|    ) throws {\n230|        var marker = loadMarker(directory: directory) ?? Marker(scopeKey: scopeKey)\n231|        marker.completedSteps.insert(step)\n232|        if let serverHost { marker.serverHost = serverHost }\n233|        if let groupName { marker.groupName = groupName }\n234|        try storeMarker(marker, directory: directory)\n235|    }\n236|\n237|    public func hasCompleted(_ step: String, directory: URL) -> Bool {\n238|        loadMarker(directory: directory)?.completedSteps.contains(step) == true\n239|    }\n240|\n241|    // MARK: - Install\n242|\n243|    /// Downloads, verifies, and extracts the official package. Idempotent:\n244|    /// a completed `installed` marker with matching scope and server skips\n245|    /// the work. Refuses to overwrite an already-registered directory (no\n246|    /// duplicates).\n247|    public func downloadAndInstall(\n248|        asset: RunnerRegistration.DownloadAsset,\n249|        draft: RunnerRegistration.Draft,\n250|        serverHost: String? = nil\n251|    ) async throws -> URL {\n252|        try RunnerRegistration.Gates.validateNoSpace(\n253|            installDirName: draft.installDirName, workFolder: draft.workFolder\n254|        )\n255|        let directory = self.directory(for: draft.installDirName)\n256|        if directory.path.contains(\" \") {\n257|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n258|        }\n259|        // Exclusive ownership for the whole mutation, acquired before the\n260|        // first await (reuse check included): a same-directory retry while\n261|        // this install is live is refused retryably instead of starting a\n262|        // second download/extract over the same directory. The originally\n263|        // acquired canonical key is held across awaits and released exactly.\n264|        let lease = try acquireLease(for: directory)\n265|        defer { releaseLease(lease) }\n266|        let files = FileManager.default\n267|        if let marker = loadMarker(directory: directory),\n268|           marker.completedSteps.contains(Self.stepInstalled),\n269|           marker.scopeKey == draft.scope.scopeKey,\n270|           Self.markerServerMatches(marker: marker, serverHost: serverHost),\n271|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n272|            return directory\n273|        }\n274|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n275|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: draft.runnerName)\n276|        }\n277|        let bytes: Data\n278|        do {\n279|            bytes = try await downloader(asset.downloadURL)\n280|        } catch {\n281|            throw RunnerRegistration.RegistrationError.network(\"Runner download failed: \\(error.localizedDescription)\")\n282|        }\n283|        // Fail closed: the official downloads endpoint documents\n284|        // `sha256_checksum`, and an install without a verified digest is\n285|        // refused rather than trusted on TLS alone.\n286|        guard let expected = asset.sha256Checksum, !expected.isEmpty else {\n287|            throw RunnerRegistration.RegistrationError.integrityMismatch\n288|        }\n289|        let actual = hasher(bytes)\n290|        guard actual.lowercased() == expected.lowercased() else {\n291|            throw RunnerRegistration.RegistrationError.integrityMismatch\n292|        }\n293|        try files.createDirectory(at: directory, withIntermediateDirectories: true)\n294|        let archive = files.temporaryDirectory.appendingPathComponent(UUID().uuidString + \"-\" + asset.filename)\n295|        defer { try? files.removeItem(at: archive) }\n296|        try bytes.write(to: archive, options: .atomic)\n297|        let result = try await executor.run(\"/usr/bin/tar\", [\"-xzf\", archive.path, \"-C\", directory.path])\n298|        guard result.code == 0 else {\n299|            throw RunnerRegistration.RegistrationError.network(\n300|                \"Runner archive extraction failed: \\(String(result.output.prefix(300)))\"\n301|            )\n302|        }\n303|        // Official packages keep runsvc.sh under bin/ until svc.sh installs it;\n304|        // a bare extraction leaves the root copy absent, so install it here.\n305|        try installRunsvc(directory: directory)\n306|        try markCompleted(\n307|            Self.stepDownloaded, directory: directory,\n308|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n309|        )\n310|        try markCompleted(\n311|            Self.stepInstalled, directory: directory,\n312|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n313|        )\n314|        return directory\n315|    }\n316|\n317|    /// Server binding for install reuse. A marker written without a server\n318|    /// (pre-revision-4) never satisfies a server-bound request: the next\n319|    /// install re-verifies instead of reusing unknown provenance. Direct\n320|    /// installer calls without a server (unit fixtures) keep the legacy\n321|    /// scope-only reuse.\n322|    static func markerServerMatches(marker: Marker, serverHost: String?) -> Bool {\n323|        guard let want = serverHost else { return true }\n324|        guard let have = marker.serverHost else { return false }\n325|        return RunnerRegistration.OperationIdentity.normalizeServerHost(have)\n326|            == RunnerRegistration.OperationIdentity.normalizeServerHost(want)\n327|    }\n328|\n329|    /// Copies official `bin/runsvc.sh` into the installation root and makes\n330|    /// it executable, mirroring what official `svc.sh install` would do.\n331|    public func installRunsvc(directory: URL) throws {\n332|        let files = FileManager.default\n333|        let source = directory.appendingPathComponent(\"bin/runsvc.sh\")\n334|        let target = directory.appendingPathComponent(\"runsvc.sh\")\n335|        guard files.fileExists(atPath: source.path) else {\n336|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing bin/runsvc.sh.\")\n337|        }\n338|        if files.fileExists(atPath: target.path) {\n339|            try files.removeItem(at: target)\n340|        }\n341|        try files.copyItem(at: source, to: target)\n342|        try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: target.path)\n343|    }\n344|\n345|    // MARK: - Configure\n346|\n347|    /// Runs the exact `config.sh` invocation. Skips when a previous attempt\n348|    /// already registered this directory (marker + `.runner` present), so\n349|    /// retries never create orphan or duplicate GitHub registrations.\n350|    /// Returns the local agent ID read back from `.runner`.\n351|    @discardableResult\n352|    public func runConfig(\n353|        directory: URL,\n354|        scopeURL: String,\n355|        token: String,\n356|        draft: RunnerRegistration.Draft,\n357|        runnerGroup: String?\n358|    ) async throws -> Int64? {\n359|        try await runConfig(\n360|            directory: directory, scopeURL: scopeURL, token: token,\n361|            draft: draft, runnerGroup: runnerGroup, replace: draft.allowReplace\n362|        )\n363|    }\n364|\n365|    /// Explicit-`replace` variant. Production callers pass\n366|    /// `draft.allowReplace`; tests drive both values.\n367|    @discardableResult\n368|    public func runConfig(\n369|        directory: URL,\n370|        scopeURL: String,\n371|        token: String,\n372|        draft: RunnerRegistration.Draft,\n373|        runnerGroup: String?,\n374|        replace: Bool\n375|    ) async throws -> Int64? {\n376|        let files = FileManager.default\n377|        let scopeHost = URL(string: scopeURL)?.host ?? \"\"\n378|        // Exclusive ownership for the whole config, acquired before the\n379|        // first await (resume checks included): a same-directory retry while\n380|        // this config.sh is live is refused retryably instead of invoking a\n381|        // second config.sh over the same .runner. The lease is released only\n382|        // when this operation settles; an abandoned UI generation never\n383|        // releases it. The originally acquired canonical key is held across\n384|        // awaits and released exactly.\n385|        let lease = try acquireLease(for: directory)\n386|        defer { releaseLease(lease) }\n387|        if hasCompleted(Self.stepConfigured, directory: directory),\n388|           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n389|            // Idempotent resume never returns a stale ID: the existing\n390|            // configuration must still match this draft on this server.\n391|            let local = readLocalRegistration(directory: directory)\n392|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n393|                local: local, configured: true, draft: draft, serverHost: scopeHost\n394|            )\n395|            try Self.verifyConfiguredGroup(\n396|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n397|            )\n398|            return verified\n399|        }\n400|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n401|           hasCompleted(Self.stepConfigured, directory: directory) {\n402|            let local = readLocalRegistration(directory: directory)\n403|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n404|                local: local, configured: true, draft: draft, serverHost: scopeHost\n405|            )\n406|            try Self.verifyConfiguredGroup(\n407|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n408|            )\n409|            return verified\n410|        }\n411|        let spec = RunnerRegistration.ConfigSpec(\n412|            scopeURL: scopeURL, token: token, name: draft.runnerName,\n413|            workFolder: draft.workFolder, labels: draft.labels,\n414|            runnerGroup: runnerGroup, replace: replace\n415|        )\n416|        let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n417|        let executable = directory.appendingPathComponent(\"config.sh\").path\n418|        guard files.fileExists(atPath: executable) else {\n419|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n420|        }\n421|        let result = try await executor.run(executable, args)\n422|        guard result.code == 0 else {\n423|            // Never echo the token: config output may repeat arguments.\n424|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [token])\n425|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n426|        }\n427|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n428|            throw RunnerRegistration.RegistrationError.configFailed(\n429|                \"config.sh reported success but .runner is missing.\"\n430|            )\n431|        }\n432|        try markCompleted(\n433|            Self.stepConfigured, directory: directory, scopeKey: draft.scope.scopeKey,\n434|            serverHost: scopeHost, groupName: runnerGroup\n435|        )\n436|        return readAgentID(directory: directory)\n437|    }\n438|\n439|    /// `.runner` does not record the org group, so the configured marker\n440|    /// does. A resume whose marker names another group (or predates group\n441|    /// recording) refuses instead of claiming the old group's configuration\n442|    /// as the new draft's. Repository scope never configures a group.\n443|    static func verifyConfiguredGroup(\n444|        marker: Marker?, runnerGroup: String?, draft: RunnerRegistration.Draft\n445|    ) throws {\n446|        switch draft.scope {\n447|        case .repository:\n448|            return\n449|        case .organization:\n450|            break\n451|        }\n452|        let wanted = (runnerGroup ?? draft.groupName).trimmingCharacters(in: .whitespacesAndNewlines)\n453|        guard let have = marker?.groupName?.trimmingCharacters(in: .whitespacesAndNewlines),\n454|              !have.isEmpty else {\n455|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n456|                \"Directory '\\(draft.installDirName)' was configured before group recording. Reconfigure for group '\\(wanted)' instead of reusing the old configuration.\"\n457|            )\n458|        }\n459|        guard have == wanted else {\n460|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n461|                \"Local registration was configured for group '\\(have)', not '\\(wanted)'. Reconfigure instead of reusing the old group's configuration.\"\n462|            )\n463|        }\n464|    }\n465|\n466|    // MARK: - Dedicated-group ownership\n467|\n468|    public static let ownershipFileName = \".runnercontrol-groups.json\"\n469|\n470|    private func ownershipFile() -> URL {\n471|        installRoot.appendingPathComponent(Self.ownershipFileName)\n472|    }\n473|\n474|    private static func ownershipKey(serverHost: String, org: String, name: String) -> String {\n475|        \"\\(RunnerRegistration.OperationIdentity.normalizeServerHost(serverHost))\\u{0}\\(org.lowercased())\\u{0}\\(name)\"\n476|    }\n477|\n478|    /// Returns the locally recorded dedicated-group ID for\n479|    /// `server` + `org` + `name`, or nil when this Mac never created (or\n480|    /// took over) that group on that server. Name matches on GitHub alone\n481|    /// never count as ownership, and ownership on one server never\n482|    /// authorizes adoption on another.\n483|    public func loadOwnedGroupID(serverHost: String, org: String, name: String) -> Int64? {\n484|        guard let data = try? Data(contentsOf: ownershipFile()),\n485|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n486|        return table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)]\n487|    }\n488|\n489|    public func saveOwnedGroupID(serverHost: String, org: String, name: String, groupID: Int64) throws {\n490|        let file = ownershipFile()\n491|        var table: [String: Int64] = [:]\n492|        if let data = try? Data(contentsOf: file),\n493|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n494|            table = decoded\n495|        }\n496|        table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)] = groupID\n497|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n498|        let data = try JSONEncoder().encode(table)\n499|        try data.write(to: file, options: .atomic)\n500|    }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
