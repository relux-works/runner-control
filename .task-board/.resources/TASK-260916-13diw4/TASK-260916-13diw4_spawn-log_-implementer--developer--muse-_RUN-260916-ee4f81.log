{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c92f","stream":{"kind":"session","id":"01a0a92d-72d5-7050-8a68-2291f8904dd8"},"sequence":754,"recorded_at":1780531400001503,"record_type":"event","durability":"durable","causation_id":"78df6718-13a7-44bd-a557-df1400b3b946","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"78df6718-13a7-44bd-a557-df1400b3b946","run_stream":{"kind":"run","id":"78df6718-13a7-44bd-a557-df1400b3b946"},"task_stream":{"kind":"task","id":"01a0a931-adbf-72e2-a15c-0b1516652ce3"},"task_id":"01a0a931-adbf-72e2-a15c-0b1516652ce3","event":{"kind":"output","task_id":"01a0a931-adbf-72e2-a15c-0b1516652ce3","chunk":"edited\nchanged lines: lines 50-124\n--- original\n+++ updated\n@@\n-    /// Canonical installation directories with a live mutating side effect\n-    /// (download/extract/config/service/recovery). Acquired synchronously\n-    /// before the first await and released only when the owning operation\n-    /// settles, so actor reentrancy can never admit two mutations of one\n-    /// directory. Abandoning a UI generation does not release this resource;\n-    /// only the settling side effect does.\n-    private var activeDirectories: Set<String> = []\n-\n-    public func directory(for installDirName: String) -> URL {\n-        installRoot.appendingPathComponent(installDirName)\n-    }\n-\n-    /// Canonical lease key for a directory: physical filesystem identity, not\n-    /// path spelling. Both Flow-derived URLs (from a stored install path)\n-    /// and `directory(for:)` URLs map to the same key for the same on-disk\n-    /// location, including through symlink leaves and symlink ancestors.\n-    /// Not-yet-created leaves canonicalize via their nearest existing\n-    /// ancestor, so `/tmp`-vs-`/private/tmp` spellings of one directory map\n-    /// to one key before the leaf exists. On case-insensitive volumes the key\n-    /// is additionally case-folded (POSIX locale), so `macbook-test` and\n-    /// `MACBOOK-TEST` share one lease while the leaf is still absent; the\n-    /// fold matches the on-disk spelling `resolvingSymlinksInPath` returns\n-    /// after creation, keeping identity stable before/after creation.\n-    /// Case-sensitive volumes keep distinct keys per spelling. The\n-    /// sensitivity comes from the real volume unless `caseSensitiveOverride`\n-    /// forces it (tests only).\n-    nonisolated static func leaseKey(for directory: URL, caseSensitiveOverride: Bool? = nil) -> String {\n-        let standardized = URL(fileURLWithPath: directory.path).standardizedFileURL\n-        let files = FileManager.default\n-        var base = standardized\n-        var suffix: [String] = []\n-        while true {\n-            if files.fileExists(atPath: base.path) || Self.isSymlink(atPath: base.path) {\n-                break\n-            }\n-            let parent = base.deletingLastPathComponent()\n-            if parent.path == base.path { break }\n-            suffix.insert(base.lastPathComponent, at: 0)\n-            base = parent\n-        }\n-        let resolvedBase = base.resolvingSymlinksInPath().path\n-        let canonical: String\n-        if suffix.isEmpty {\n-            canonical = URL(fileURLWithPath: resolvedBase).standardizedFileURL.path\n-        } else {\n-            var url = URL(fileURLWithPath: resolvedBase, isDirectory: true)\n-            for component in suffix { url.appendPathComponent(component) }\n-            canonical = url.standardizedFileURL.path\n-        }\n-        let sensitive: Bool\n-        if let override = caseSensitiveOverride {\n-            sensitive = override\n-        } else {\n-            sensitive = Self.isCaseSensitiveVolume(\n-                at: URL(fileURLWithPath: resolvedBase, isDirectory: true)\n-            )\n-        }\n-        guard !sensitive else { return canonical }\n-        return canonical.lowercased(with: Locale(identifier: \"en_US_POSIX\"))\n-    }\n-\n-    /// True only when the volume containing `url` reports case-sensitive\n-    /// names. Unknown or unreadable volumes fail closed toward alias safety\n-    /// (reported insensitive, so spellings fold): on a truly sensitive\n-    /// volume that only over-serializes distinct spellings into a retryable\n-    /// `directoryBusy`, while the reverse would admit concurrent mutations\n-    /// of one physical directory.\n-    nonisolated static func isCaseSensitiveVolume(at url: URL) -> Bool {\n-        (try? url.resourceValues(forKeys: [.volumeSupportsCaseSensitiveNamesKey]))\n-            .flatMap(\\.volumeSupportsCaseSensitiveNames) == true\n-    }\n-\n-    private nonisolated static func isSymlink(atPath path: String) -> Bool {\n-        (try? FileManager.default.destinationOfSymbolicLink(atPath: path)) != nil\n-    }\n+    /// Single installer-wide mutation lease. The registration wizard runs\n+    /// ONE active mutating installer operation per app instance\n+    /// (download/extract, config.sh, service setup, partial recovery),\n+    /// for ANY directory. Acquired synchronously before the first await and\n+    /// released only when the owning operation settles, so actor reentrancy\n+    /// can never admit two concurrent mutations — no path-identity\n+    /// comparison, and therefore no filesystem-alias bypass class\n+    /// (symlinks, case variants, Unicode equivalences). Abandoning a UI\n+    /// generation does not release this resource; only the settling side\n+    /// effect does. Ordinary start/stop of already-installed runners and\n+    /// multiple installed CI runners are unaffected: they never take this\n+    /// lease.\n+    private var activeOperation: UUID?\n+    /// Directory the lease owner is mutating. Diagnostic only: refusal never\n+    /// compares paths, it refuses whenever a lease is held.\n+    private var activePath: String?\n+\n+    public func directory(for installDirName: String) -> URL {\n+        installRoot.appendingPathComponent(installDirName)\n+    }\n+\n+    private nonisolated static func isSymlink(atPath path: String) -> Bool {\n+        (try? FileManager.default.destinationOfSymbolicLink(atPath: path)) != nil\n+    }\n","final_result":true}}}
