{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9bb","stream":{"kind":"session","id":"01a0a92d-72d5-7050-8a68-2291f8904dd8"},"sequence":824,"recorded_at":1780531400001643,"record_type":"event","durability":"durable","causation_id":"78df6718-13a7-44bd-a557-df1400b3b946","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"78df6718-13a7-44bd-a557-df1400b3b946","run_stream":{"kind":"run","id":"78df6718-13a7-44bd-a557-df1400b3b946"},"task_stream":{"kind":"task","id":"01a0a932-005b-7f10-ae93-6a21b577bfad"},"task_id":"01a0a932-005b-7f10-ae93-6a21b577bfad","event":{"kind":"output","task_id":"01a0a932-005b-7f10-ae93-6a21b577bfad","chunk":"edited\nchanged lines: lines 210-216\n--- original\n+++ updated\n@@\n-        // Exclusive ownership for the whole mutation, acquired before the\n-        // first await (reuse check included): a same-directory retry while\n-        // this install is live is refused retryably instead of starting a\n-        // second download/extract over the same directory. The originally\n-        // acquired canonical key is held across awaits and released exactly.\n-        let lease = try acquireLease(for: directory)\n-        defer { releaseLease(lease) }\n+        // Installer-wide ownership for the whole mutation, acquired before\n+        // the first await (reuse check included): any second mutation while\n+        // this install is live — same directory or not — is refused\n+        // retryably instead of starting a second download/extract. The owner\n+        // token is held across awaits and only that exact token releases.\n+        let lease = try acquireMutationLease(for: directory)\n+        defer { releaseMutationLease(lease) }\n","final_result":true}}}
