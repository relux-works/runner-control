{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c779","stream":{"kind":"session","id":"01a0a92d-72d5-7050-8a68-2291f8904dd8"},"sequence":535,"recorded_at":1780531400001065,"record_type":"event","durability":"durable","causation_id":"78df6718-13a7-44bd-a557-df1400b3b946","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"78df6718-13a7-44bd-a557-df1400b3b946","run_stream":{"kind":"run","id":"78df6718-13a7-44bd-a557-df1400b3b946"},"task_stream":{"kind":"task","id":"01a0a92f-5191-7503-a7d4-6058a2dc97dd"},"task_id":"01a0a92f-5191-7503-a7d4-6058a2dc97dd","event":{"kind":"output","task_id":"01a0a92f-5191-7503-a7d4-6058a2dc97dd","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n1|import CryptoKit\n2|import Foundation\n3|import Testing\n4|import Relux\n5|@testable import RunnerControlCore\n6|\n7|// MARK: - Registration harness (production entry points, controlled IO)\n8|\n9|// TestTransport, jsonResponse, and testConfig are shared from GitHubTransportTests.\n10|\n11|private struct RegistrationHarness {\n12|    let flow: RunnerRegistration.Flow\n13|    let logger: Relux.Testing.Logger\n14|    let transport: TestTransport\n15|    let userStore: GitHubKeychainStore\n16|    let identities: InMemoryGitHubSessionIdentityStore\n17|    let registrationTokens: RunnerRegistrationTokenStore\n18|    let installer: RunnerInstallerService\n19|    let home: URL\n20|    let installRoot: URL\n21|}\n22|\n23|private func registrationHarness(\n24|    transport: TestTransport,\n25|    downloader: (@Sendable (URL) async throws -> Data)? = nil,\n26|    executor: (any CommandExecuting)? = nil,\n27|    arch: String = \"arm64\",\n28|    seedAuth: Bool = true,\n29|    caseSensitivityOverride: Bool? = nil\n30|) async -> RegistrationHarness {\n31|    let logger = Relux.Testing.Logger()\n32|    let dispatcher = Relux.Dispatcher(logger: logger)\n33|    let userStore = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n34|    let identities = InMemoryGitHubSessionIdentityStore()\n35|    if seedAuth {\n36|        await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n37|        try? await userStore.save(\n38|            GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n39|            serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n40|        )\n41|    }\n42|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"RegHome-\" + UUID().uuidString)\n43|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n44|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n45|    let archCopy = arch\n46|    let installer = RunnerInstallerService(\n47|        installRoot: installRoot,\n48|        downloader: downloader,\n49|        executor: executor,\n50|        currentArch: { archCopy },\n51|        caseSensitivityOverride: caseSensitivityOverride\n52|    )\n53|    let api = GitHubRunnerAPIClient(transport: transport)\n54|    let registrationTokens = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n55|    let refresher = GitHubTokenRefresh(transport: transport, store: userStore)\n56|    let flow = await RunnerRegistration.Flow(\n57|        api: api, installer: installer, registrationTokens: registrationTokens,\n58|        userStore: userStore, identityStore: identities, refresher: refresher,\n59|        configProvider: { _ in testConfig }, dispatcher: dispatcher\n60|    )\n61|    return RegistrationHarness(\n62|        flow: flow, logger: logger, transport: transport, userStore: userStore,\n63|        identities: identities, registrationTokens: registrationTokens,\n64|        installer: installer, home: home, installRoot: installRoot\n65|    )\n66|}\n67|\n68|private func registrationActions(_ logger: Relux.Testing.Logger) -> [RunnerRegistration.Action] {\n69|    logger.actions.compactMap { $0 as? RunnerRegistration.Action }\n70|}\n71|\n72|private func lastFailure(_ logger: Relux.Testing.Logger) -> (message: String, step: String)? {\n73|    for action in registrationActions(logger).reversed() {\n74|        switch action {\n75|        case .failed(let message, let step): return (message, step)\n76|        case .permissionDenied(let message, let step): return (message, step)\n77|        default: break\n78|        }\n79|    }\n80|    return nil\n81|}\n82|\n83|private func orgDraft(\n84|    name: String = \"macbook-test\",\n85|    dir: String = \"macbook-test\",\n86|    group: String = \"RunnerControl-Mac\",\n87|    repos: Set<Int64> = [9],\n88|    allowGroup: Bool = true,\n89|    allowTakeover: Bool = false,\n90|    allowReplace: Bool = false\n91|) -> RunnerRegistration.Draft {\n92|    RunnerRegistration.Draft(\n93|        scope: .organization(org: \"acme\"),\n94|        runnerName: name,\n95|        labels: [\"self-hosted\", \"macOS\"],\n96|        installDirName: dir,\n97|        workFolder: \"_work\",\n98|        groupName: group,\n99|        selectedRepositoryIDs: repos,\n100|        allowGroupMutation: allowGroup,\n101|        allowGroupTakeover: allowTakeover,\n102|        allowReplace: allowReplace\n103|    )\n104|}\n105|\n106|private func repoDraft(dir: String = \"personal-app\", allowReplace: Bool = false) -> RunnerRegistration.Draft {\n107|    RunnerRegistration.Draft(\n108|        scope: .repository(owner: \"octo\", name: \"app\"),\n109|        runnerName: \"personal-runner\",\n110|        labels: [\"self-hosted\", \"macOS\"],\n(more lines below)","final_result":true}}}
