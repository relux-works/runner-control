{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c697","stream":{"kind":"session","id":"01a0a92d-72d5-7050-8a68-2291f8904dd8"},"sequence":422,"recorded_at":1780531400000839,"record_type":"event","durability":"durable","causation_id":"78df6718-13a7-44bd-a557-df1400b3b946","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"78df6718-13a7-44bd-a557-df1400b3b946","run_stream":{"kind":"run","id":"78df6718-13a7-44bd-a557-df1400b3b946"},"task_stream":{"kind":"task","id":"01a0a92e-9a41-7442-b558-38e2ab91812e"},"task_id":"01a0a92e-9a41-7442-b558-38e2ab91812e","event":{"kind":"output","task_id":"01a0a92e-9a41-7442-b558-38e2ab91812e","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(2548 line(s) above)\n2549|// MARK: - R5: operation owner + directory lease (verbatim reviewer R4 attacks)\n2550|\n2551|// Adopted verbatim from TASK-260916-13diw4_review-attacks-rev4.swift: the two\n2552|// R4 findings (repeat-of R3-F1) as committed named regressions through the\n2553|// production Flow entry point.\n2554|\n2555|// Reviewer-only tests appended to the immutable candidate in a disposable copy.\n2556|@Test @MainActor func reviewerRetryCannotRunTwoConfigsInSameDirectory() async throws {\n2557|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2558|    let executor = ConfigLatchExecutor()\n2559|    let transport = TestTransport([\n2560|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2561|        runnersListPayload([]),\n2562|        jsonResponse([\"token\": \"REG-OLD\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2563|        runnersListPayload([]),\n2564|        jsonResponse([\"token\": \"REG-NEW\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2565|        runnersListPayload([[\"id\": 4242, \"name\": \"renamed-runner\", \"labels\": []]])\n2566|    ])\n2567|    let h = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor)\n2568|    defer { try? FileManager.default.removeItem(at: h.home) }\n2569|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2570|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2571|    let old = Task { await h.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2572|    await executor.waitStarted()\n2573|    var edited = orgDraft()\n2574|    edited.runnerName = \"renamed-runner\"\n2575|    _ = await h.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2576|    _ = await h.flow.apply(RunnerRegistration.Effect.registerRunner)\n2577|    let callsWhileOldRuns = await executor.configCalls.count\n2578|    await executor.release()\n2579|    _ = await old.value\n2580|    #expect(callsWhileOldRuns == 1, \"An identity edit must not allow a second config.sh while the first still owns this directory\")\n2581|    let state = RunnerRegistration.State()\n2582|    for action in registrationActions(h.logger) { await state.reduce(with: action) }\n2583|    let directory = await h.installer.directory(for: edited.installDirName)\n2584|    let local = await h.installer.readLocalRegistration(directory: directory)\n2585|    #expect(!state.completedSteps.contains(\"registerRunner\") || local?.agentName == edited.runnerName,\n2586|            \"New registration is attested complete but old in-flight config overwrites .runner afterwards\")\n2587|}\n2588|\n2589|private actor ReviewTwoDownloads {\n2590|    private var count = 0\n2591|    private var started: Set<Int> = []\n2592|    private var startWaiters: [Int: CheckedContinuation<Void, Never>] = [:]\n2593|    private var releases: [Int: CheckedContinuation<Void, Never>] = [:]\n2594|    func download(_ bytes: Data) async throws -> Data {\n2595|        count += 1\n2596|        let n = count\n2597|        started.insert(n)\n2598|        startWaiters.removeValue(forKey: n)?.resume()\n2599|        await withCheckedContinuation { releases[n] = $0 }\n2600|        if n == 1 { throw GitHubTransportError.invalidResponse }\n2601|        return bytes\n2602|    }\n2603|    func waitStarted(_ n: Int) async {\n2604|        if started.contains(n) { return }\n2605|        await withCheckedContinuation { startWaiters[n] = $0 }\n2606|    }\n2607|    func release(_ n: Int) { releases.removeValue(forKey: n)?.resume() }\n2608|}\n2609|\n2610|@Test func reviewerStaleFailureCannotUnlockNewOperation() async throws {\n2611|    let package = try await FixturePackage.make()\n2612|    let latch = ReviewTwoDownloads()\n2613|    let transport = TestTransport([\n2614|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2615|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))\n2616|    ])\n2617|    let h = await registrationHarness(transport: transport, downloader: { _ in try await latch.download(package.bytes) })\n2618|    defer { try? FileManager.default.removeItem(at: h.home) }\n2619|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2620|    let old = Task { await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2621|    await latch.waitStarted(1)\n2622|    var edited = orgDraft()\n2623|    edited.installDirName = \"new-install\"\n2624|    _ = await h.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2625|    let current = Task { await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2626|    await latch.waitStarted(2)\n2627|    await latch.release(1)\n2628|    _ = await old.value\n2629|    let before = await transport.requests.count\n2630|    _ = await h.flow.apply(RunnerRegistration.Effect.prepareDownload)\n2631|    let after = await transport.requests.count\n2632|    await latch.release(2)\n2633|    _ = await current.value\n2634|    #expect(after == before, \"Old generation's catch must not clear the current operation's working lock\")\n2635|}\n2636|\n2637|// MARK: - R5: lifecycle ownership across begin/update/cancel/reset\n2638|\n2639|// Latch downloader: suspends the FIRST download so an abandoning edit can\n2640|// land while an install is in flight; later downloads pass through. Counts\n2641|// every call so tests prove a refused retry started no second download.\n2642|private actor CountingLatchDownloader {\n2643|    private let bytes: Data\n2644|    private(set) var calls = 0\n2645|    private var latched = false\n2646|    var started = false\n2647|    private var waiter: CheckedContinuation<Void, Never>?\n2648|    private var releaseWaiter: CheckedContinuation<Void, Never>?\n2649|    init(bytes: Data) { self.bytes = bytes }\n2650|    func download(_ url: URL) async throws -> Data {\n2651|        calls += 1\n2652|        if !latched {\n2653|            latched = true\n2654|            started = true\n2655|            waiter?.resume(); waiter = nil\n2656|            await withCheckedContinuation { releaseWaiter = $0 }\n2657|        }\n2658|        return bytes\n2659|    }\n2660|    func waitStarted() async {\n2661|        if started { return }\n2662|        await withCheckedContinuation { waiter = $0 }\n2663|    }\n2664|    func release() { releaseWaiter?.resume(); releaseWaiter = nil }\n2665|}\n2666|\n2667|@Test @MainActor func beginDraftDuringDownloadKeepsDirectoryLease() async throws {\n2668|    // R5/R4-F1 at the beginDraft boundary: a new draft for the SAME directory\n2669|    // releases the UI lock but never the live install's directory lease. A\n2670|    // same-directory retry while the first install runs is refused retryably\n2671|    // (no second download); after the first settles stale, retry reuses it.\n2672|    let package = try await FixturePackage.make()\n2673|    let downloads = CountingLatchDownloader(bytes: package.bytes)\n2674|    let transport = TestTransport([\n2675|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2676|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2677|    ])\n2678|    let harness = await registrationHarness(\n2679|        transport: transport, downloader: { url in try await downloads.download(url) }\n2680|    )\n2681|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2682|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2683|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2684|    await downloads.waitStarted()\n2685|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2686|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2687|    #expect(await downloads.calls == 1, \"Second download must not start while the first owns this directory\")\n2688|    #expect(lastFailure(harness.logger)?.step == \"downloadAndInstall\")\n2689|    #expect(lastFailure(harness.logger)?.message.contains(\"busy\") ?? false)\n2690|    await downloads.release()\n2691|    _ = await old.value\n2692|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n2693|    #expect(await downloads.calls == 1, \"Retry after settle reuses the install instead of downloading again\")\n2694|    let state = RunnerRegistration.State()\n2695|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2696|    #expect(state.installPath != nil)\n2697|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n2698|}\n2699|\n2700|@Test @MainActor func resetDuringDownloadKeepsDirectoryLeaseUntilSettled() async throws {\n2701|    // R5/R4-F1 at the reset boundary: reset releases the UI lock at once,\n2702|    // but the live install keeps its directory lease until it settles. A\n2703|    // same-directory install for the fresh draft is refused while live and\n2704|    // reuses the settled install on retry.\n2705|    let package = try await FixturePackage.make()\n2706|    let downloads = CountingLatchDownloader(bytes: package.bytes)\n2707|    let transport = TestTransport([\n2708|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2709|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2710|    ])\n2711|    let harness = await registrationHarness(\n2712|        transport: transport, downloader: { url in try await downloads.download(url) }\n2713|    )\n2714|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2715|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2716|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2717|    await downloads.waitStarted()\n2718|    _ = await harness.flow.apply(RunnerRegistration.Effect.reset)\n2719|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2720|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2721|    #expect(await downloads.calls == 1, \"Second download must not start while the reset-abandoned install is live\")\n2722|    #expect(lastFailure(harness.logger)?.message.contains(\"busy\") ?? false)\n2723|    await downloads.release()\n2724|    _ = await old.value\n2725|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n2726|    #expect(await downloads.calls == 1, \"Retry after settle reuses the install instead of downloading again\")\n2727|    let state = RunnerRegistration.State()\n2728|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2729|    #expect(state.installPath != nil)\n2730|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n2731|}\n2732|\n2733|@Test @MainActor func cancelDuringConfigKeepsLeaseAndRecoversAfterSettle() async throws {\n2734|    // R5/R4-F1 at the cancel boundary: cancel releases the UI lock at once,\n2735|    // but the live config.sh keeps its directory lease. A same-directory\n2736|    // register while it runs starts no second config (busy, token deleted);\n2737|    // after it settles stale, retry resumes the verified registration.\n2738|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2739|    let executor = ConfigLatchExecutor()\n2740|    let transport = TestTransport([\n2741|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2742|        runnersListPayload([]),\n2743|        jsonResponse([\"token\": \"REG-OLD\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2744|        runnersListPayload([]),\n2745|        jsonResponse([\"token\": \"REG-BUSY\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2746|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2747|    ])\n2748|    let harness = await registrationHarness(\n2749|        transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor\n2750|    )\n2751|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2752|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2753|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2754|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2755|    await executor.waitStarted()\n2756|    _ = await harness.flow.apply(RunnerRegistration.Effect.cancel)\n2757|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n2758|    #expect(await executor.configCalls.count == 1, \"Second config.sh must not run while the cancelled config still owns this directory\")\n2759|    #expect(lastFailure(harness.logger)?.step == \"registerRunner\")\n2760|    #expect(lastFailure(harness.logger)?.message.contains(\"busy\") ?? false)\n2761|    await executor.release()\n2762|    _ = await old.value\n2763|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n2764|    let actions = registrationActions(harness.logger)\n2765|    #expect(actions.contains {\n2766|        if case .registered(let runnerID, let localAgentID) = $0 {\n2767|            runnerID == 4242 && localAgentID == 4242\n2768|        } else { false }\n2769|    })\n2770|    let state = RunnerRegistration.State()\n2771|    for item in actions { await state.reduce(with: item) }\n2772|    #expect(state.completedSteps.contains(\"registerRunner\"))\n2773|    let scopeKey = RunnerRegistration.Flow.tokenScopeKey(draft: orgDraft())\n2774|    #expect(await harness.registrationTokens.load(scopeKey: scopeKey) == nil, \"Both minted tokens are deleted\")\n2775|}\n2776|\n2777|@Test @MainActor func nonconflictingInstallProceedsWhileOtherDirectoryRuns() async throws {\n2778|    // R5 lease scope: the lease is per-directory, not global. While an\n2779|    // install for dirA is live (then abandoned), an install for dirB\n2780|    // proceeds; the old completion stays unattested for the new draft.\n2781|    let package = try await FixturePackage.make()\n2782|    let downloads = CountingLatchDownloader(bytes: package.bytes)\n2783|    let transport = TestTransport([\n2784|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2785|    ])\n2786|    let harness = await registrationHarness(\n2787|        transport: transport, downloader: { url in try await downloads.download(url) }\n2788|    )\n2789|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2790|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2791|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2792|    await downloads.waitStarted()\n2793|    var moved = orgDraft()\n2794|    moved.installDirName = \"new-install\"\n2795|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(moved))\n2796|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2797|    #expect(await downloads.calls == 2, \"Nonconflicting directory must not be blocked by another live install\")\n2798|    let mid = RunnerRegistration.State()\n2799|    for item in registrationActions(harness.logger) { await mid.reduce(with: item) }\n2800|    #expect(mid.installPath?.hasSuffix(\"new-install\") ?? false)\n2801|    #expect(mid.completedSteps.contains(\"downloadAndInstall\"))\n2802|    await downloads.release()\n2803|    _ = await old.value\n2804|    let state = RunnerRegistration.State()\n2805|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2806|    #expect(state.installPath?.hasSuffix(\"new-install\") ?? false)\n2807|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n2808|    let installed = registrationActions(harness.logger).filter {\n2809|        if case .installed = $0 { true } else { false }\n2810|    }\n2811|    #expect(installed.count == 1, \"Abandoned install must not attest a second path\")\n2812|}\n2813|\n2814|@Test @MainActor func staleRegisterFailureDoesNotUnlockOrPlantFailure() async throws {\n2815|    // R5/R4-F2 for the register step: while a config.sh is live, the draft\n2816|    // moves to another directory and that install completes. When the old\n2817|    // config then fails, its stale exit records nothing: no failure is\n2818|    // planted and no success is revoked.\n2819|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2820|    let executor = ConfigLatchExecutor(failure: CommandResult(code: 1, output: \"config exploded\"))\n2821|    let transport = TestTransport([\n2822|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2823|        runnersListPayload([]),\n2824|        jsonResponse([\"token\": \"REG-OLD\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2825|    ])\n2826|    let harness = await registrationHarness(\n2827|        transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor\n2828|    )\n2829|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2830|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2831|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2832|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2833|    await executor.waitStarted()\n2834|    var moved = orgDraft()\n2835|    moved.installDirName = \"new-install\"\n2836|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(moved))\n2837|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2838|    await executor.release()\n2839|    _ = await old.value\n2840|    #expect(lastFailure(harness.logger) == nil, \"Stale register failure must not plant a failure for the new draft\")\n2841|    let state = RunnerRegistration.State()\n2842|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2843|    #expect(state.installPath?.hasSuffix(\"new-install\") ?? false)\n2844|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n2845|    #expect(state.failedStep == nil)\n2846|}\n2847|\n2848|// MARK: - R6: canonical directory lease (repeat-of R4-F1 / R5-F1)\n2849|\n2850|/// Bounded latch wait: polls the config latch's started flag so a config.sh\n2851|/// that never starts (for example a gate error thrown before the latch)\n2852|/// becomes a reported failure carrying the Flow diagnostics instead of an\n2853|/// infinite hang. The timeout is generous — latches normally fire in well\n2854|/// under a second — and the regression assertions below are unchanged.\n2855|private func waitForConfigStart(_ executor: ConfigLatchExecutor, timeoutSeconds: Double) async -> Bool {\n2856|    let deadline = Date().addingTimeInterval(timeoutSeconds)\n2857|    while true {\n2858|        if await executor.started { return true }\n2859|        if Date() >= deadline { return false }\n2860|        try? await Task.sleep(nanoseconds: 50_000_000)\n2861|    }\n2862|}\n2863|\n2864|@Test @MainActor func reviewerSymlinkAliasCannotBypassDirectoryLease() async throws {\n2865|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2866|    let executor = ConfigLatchExecutor()\n2867|    let transport = TestTransport([\n2868|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2869|        runnersListPayload([]),\n2870|        jsonResponse([\"token\": \"REG-OLD\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2871|        runnersListPayload([]),\n2872|        jsonResponse([\"token\": \"REG-NEW\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2873|        runnersListPayload([[\"id\": 4242, \"name\": \"renamed-runner\", \"labels\": []]])\n2874|    ])\n2875|    let h = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor)\n2876|    defer { try? FileManager.default.removeItem(at: h.home) }\n2877|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2878|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2879|    // Gate errors before the latch must fail fast with diagnostics, never\n2880|    // hang in the wait below: without an install the register step cannot\n2881|    // reach config.sh.\n2882|    if let setupFailure = lastFailure(h.logger) {\n2883|        #expect(\n2884|            Bool(false),\n2885|            \"Setup failed before the config latch: [\\(setupFailure.step)] \\(setupFailure.message)\"\n2886|        )\n2887|        return\n2888|    }\n2889|    let old = Task { await h.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2890|    guard await waitForConfigStart(executor, timeoutSeconds: 30) else {\n2891|        let detail = lastFailure(h.logger).map { \"[\\($0.step)] \\($0.message)\" } ?? \"no Flow failure recorded\"\n2892|        #expect(Bool(false), \"config.sh never started within 30s; Flow failure: \\(detail)\")\n2893|        await executor.release()\n2894|        _ = await old.value\n2895|        return\n2896|    }\n2897|    var edited = orgDraft()\n2898|    edited.runnerName = \"renamed-runner\"\n2899|    edited.installDirName = \"alias-install\"\n2900|    try FileManager.default.createSymbolicLink(\n2901|        at: h.installRoot.appendingPathComponent(\"alias-install\"),\n2902|        withDestinationURL: h.installRoot.appendingPathComponent(\"macbook-test\"))\n2903|    _ = await h.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2904|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2905|    _ = await h.flow.apply(RunnerRegistration.Effect.registerRunner)\n2906|    let callsWhileOldRuns = await executor.configCalls.count\n2907|    await executor.release()\n2908|    _ = await old.value\n2909|    #expect(callsWhileOldRuns == 1, \"An identity edit must not allow a second config.sh while the first still owns this directory\")\n2910|    let state = RunnerRegistration.State()\n2911|    for action in registrationActions(h.logger) { await state.reduce(with: action) }\n2912|    let directory = await h.installer.directory(for: edited.installDirName)\n2913|    let local = await h.installer.readLocalRegistration(directory: directory)\n2914|    #expect(!state.completedSteps.contains(\"registerRunner\") || local?.agentName == edited.runnerName,\n2915|            \"New registration is attested complete but old in-flight config overwrites .runner afterwards\")\n2916|}\n2917|\n2918|@Test func leaseKeyCanonicalizesSymlinkAncestorsForMissingLeaf() throws {\n2919|    // R6 ancestor control: nearest-existing-ancestor resolution maps one\n2920|    // physical directory to one lease key before the leaf exists, while\n2921|    // different physical directories keep different keys.\n2922|    let files = FileManager.default\n2923|    let root = files.temporaryDirectory.appendingPathComponent(\"LeaseAncestor-\" + UUID().uuidString)\n2924|    let real = root.appendingPathComponent(\"real\")\n2925|    try files.createDirectory(at: real, withIntermediateDirectories: true)\n2926|    defer { try? files.removeItem(at: root) }\n2927|    try files.createSymbolicLink(at: root.appendingPathComponent(\"link\"), withDestinationURL: real)\n2928|    let viaReal = RunnerInstallerService.leaseKey(\n2929|        for: real.appendingPathComponent(\"missing-leaf\"))\n2930|    let viaLink = RunnerInstallerService.leaseKey(\n2931|        for: root.appendingPathComponent(\"link\").appendingPathComponent(\"missing-leaf\"))\n2932|    #expect(viaReal == viaLink, \"One physical dir must map to one lease key through a symlink ancestor\")\n2933|    let other = RunnerInstallerService.leaseKey(for: root.appendingPathComponent(\"other-dir\"))\n2934|    #expect(other != viaReal, \"Different physical dirs must keep different leases\")\n2935|}\n2936|\n2937|private actor DownloadCounter {\n2938|    private let bytes: Data\n2939|    private(set) var calls = 0\n2940|    init(bytes: Data) { self.bytes = bytes }\n2941|    func download(_ url: URL) async throws -> Data {\n2942|        calls += 1\n2943|        return bytes\n2944|    }\n2945|}\n2946|\n2947|// MARK: - R7: missing-leaf case-equivalence (repeat-of R5-F1 / R6-F1)\n2948|\n2949|@Test @MainActor func reviewerCaseAliasMissingLeafCannotBypassDirectoryLease() async throws {\n2950|    // Adopted rev6 attack: same production entry (Flow.apply), spellings,\n2951|    // refusal assertions (calls==1, busy) and retry-reuse assertion, with\n2952|    // one ordering correction — the physical-identity (inode) proof runs\n2953|    // after the original settles instead of while the refused second is\n2954|    // still pending. On fixed code the directory is absent at that point\n2955|    // (the refused operation creates nothing; the first download is still\n2956|    // latched before its mkdir), so attributesOfItem would throw instead of\n2957|    // asserting. No correct fix can satisfy both the absent-leaf premise\n2958|    // and a present-leaf inode check with only a refused operation between\n2959|    // them; proving same-inode after settle keeps the alias premise while\n2960|    // the calls==1/busy assertions prove the refusal.\n2961|    let package = try await FixturePackage.make()\n2962|    let downloads = CountingLatchDownloader(bytes: package.bytes)\n2963|    let transport = TestTransport([\n2964|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2965|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2966|    ])\n2967|    let harness = await registrationHarness(\n2968|        transport: transport, downloader: { url in try await downloads.download(url) }\n2969|    )\n2970|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2971|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2972|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2973|    let deadline = Date().addingTimeInterval(10)\n2974|    while !(await downloads.started) && Date() < deadline { try? await Task.sleep(nanoseconds: 10_000_000) }\n2975|    guard await downloads.started else { #expect(Bool(false), \"Download never started\"); await downloads.release(); _ = await old.value; return }\n2976|    #expect(!FileManager.default.fileExists(atPath: harness.installRoot.appendingPathComponent(\"macbook-test\").path))\n2977|    var aliasDraft = orgDraft()\n2978|    aliasDraft.installDirName = \"MACBOOK-TEST\"\n2979|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(aliasDraft))\n2980|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2981|    #expect(await downloads.calls == 1, \"Second download must not start while the first owns this directory\")\n2982|    #expect(lastFailure(harness.logger)?.step == \"downloadAndInstall\")\n2983|    #expect(lastFailure(harness.logger)?.message.contains(\"busy\") ?? false)\n2984|    await downloads.release()\n2985|    _ = await old.value\n2986|    let lower = harness.installRoot.appendingPathComponent(\"macbook-test\")\n2987|    let upper = harness.installRoot.appendingPathComponent(\"MACBOOK-TEST\")\n2988|    let lowerInode = try FileManager.default.attributesOfItem(atPath: lower.path)[.systemFileNumber] as? NSNumber\n2989|    let upperInode = try FileManager.default.attributesOfItem(atPath: upper.path)[.systemFileNumber] as? NSNumber\n2990|    #expect(lowerInode != nil && lowerInode == upperInode, \"Attack spellings must address the same filesystem directory\")\n2991|    print(\"case-alias evidence: calls=\\(await downloads.calls), lowerInode=\\(String(describing: lowerInode)), upperInode=\\(String(describing: upperInode))\")\n2992|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n2993|    #expect(await downloads.calls == 1, \"Retry after settle reuses the install instead of downloading again\")\n2994|    let state = RunnerRegistration.State()\n2995|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2996|    #expect(state.installPath != nil)\n2997|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n2998|}\n2999|\n3000|@Test @MainActor func caseSensitiveVolumeKeepsDistinctDirectoryLeases() async throws {\n3001|    // R7 scope control through the production Flow entry point: with a\n3002|    // forced case-sensitive volume the same two spellings are two\n3003|    // directories, so the second install proceeds instead of refusing.\n3004|    // Host-independent: sensitivity is forced via the installer seam, so\n3005|    // this passes on case-insensitive hosts too. Bounded start poll (no\n3006|    // leaked continuation) so a gate error fails fast instead of hanging.\n3007|    let package = try await FixturePackage.make()\n3008|    let downloads = CountingLatchDownloader(bytes: package.bytes)\n3009|    let transport = TestTransport([\n3010|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n3011|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n3012|    ])\n3013|    let harness = await registrationHarness(\n3014|        transport: transport, downloader: { url in try await downloads.download(url) },\n3015|        caseSensitivityOverride: true\n3016|    )\n3017|    defer { try? FileManager.default.removeItem(at: harness.home) }\n3018|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n3019|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n3020|    let deadline = Date().addingTimeInterval(10)\n3021|    while !(await downloads.started) && Date() < deadline { try? await Task.sleep(nanoseconds: 10_000_000) }\n3022|    guard await downloads.started else { #expect(Bool(false), \"Download never started\"); await downloads.release(); _ = await old.value; return }\n3023|    var aliasDraft = orgDraft()\n3024|    aliasDraft.installDirName = \"MACBOOK-TEST\"\n3025|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(aliasDraft))\n3026|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n3027|    #expect(await downloads.calls == 2, \"Case-sensitive spellings must keep distinct leases\")\n3028|    #expect(lastFailure(harness.logger) == nil, \"Distinct directories must not report busy\")\n3029|    await downloads.release()\n3030|    _ = await old.value\n3031|}\n3032|\n3033|@Test func leaseKeyCaseFoldingFollowsVolumeSensitivity() throws {\n3034|    // R7 unit control for the canonical lease owner: forced-insensitive\n3035|    // folds missing-leaf case aliases to one key with before/after-creation\n3036|    // stability; forced-sensitive keeps them distinct; the production\n3037|    // default follows the real volume either way (host-independent).\n3038|    let files = FileManager.default\n3039|    let root = files.temporaryDirectory.appendingPathComponent(\"LeaseCase-\" + UUID().uuidString)\n3040|    try files.createDirectory(at: root, withIntermediateDirectories: true)\n3041|    defer { try? files.removeItem(at: root) }\n3042|    let lower = root.appendingPathComponent(\"macbook-test\")\n3043|    let upper = root.appendingPathComponent(\"MACBOOK-TEST\")\n3044|    #expect(\n3045|        RunnerInstallerService.leaseKey(for: lower, caseSensitiveOverride: false)\n3046|            == RunnerInstallerService.leaseKey(for: upper, caseSensitiveOverride: false),\n3047|        \"Case-insensitive volumes must fold missing-leaf aliases to one lease key\"\n3048|    )\n3049|    #expect(\n3050|        RunnerInstallerService.leaseKey(for: lower, caseSensitiveOverride: true)\n3051|            != RunnerInstallerService.leaseKey(for: upper, caseSensitiveOverride: true),\n3052|        \"Case-sensitive volumes must keep distinct leases per spelling\"\n3053|    )\n3054|    let beforeUpper = RunnerInstallerService.leaseKey(for: upper, caseSensitiveOverride: false)\n3055|    try files.createDirectory(at: lower, withIntermediateDirectories: true)\n3056|    let afterUpper = RunnerInstallerService.leaseKey(for: upper, caseSensitiveOverride: false)\n3057|    #expect(beforeUpper == afterUpper, \"Lease identity must stay stable before/after creation\")\n3058|    let realLower = RunnerInstallerService.leaseKey(for: lower)\n3059|    let realUpper = RunnerInstallerService.leaseKey(for: upper)\n3060|    if RunnerInstallerService.isCaseSensitiveVolume(at: root) {\n3061|        #expect(realLower != realUpper, \"Production default must preserve distinct spellings on sensitive volumes\")\n3062|    } else {\n3063|        #expect(realLower == realUpper, \"Production default must unify aliases on insensitive volumes\")\n3064|    }\n3065|}\n3066|\n3067|@Test @MainActor func finderAliasInstallFolderIsRefusedBeforeDownload() async throws {\n3068|    // R6 alias control: a Finder-alias install folder is refused before any\n3069|    // download side effect, through the production Flow entry point.\n3070|    let package = try await FixturePackage.make()\n3071|    let counter = DownloadCounter(bytes: package.bytes)\n3072|    let transport = TestTransport([\n3073|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n3074|    ])\n3075|    let h = await registrationHarness(\n3076|        transport: transport, downloader: { url in try await counter.download(url) }\n3077|    )\n3078|    defer { try? FileManager.default.removeItem(at: h.home) }\n3079|    let target = h.home.appendingPathComponent(\"real-target\")\n3080|    try FileManager.default.createDirectory(at: target, withIntermediateDirectories: true)\n3081|    let aliasURL = h.installRoot.appendingPathComponent(\"alias-dir\")\n3082|    let bookmark = try target.bookmarkData(options: .suitableForBookmarkFile)\n3083|    try URL.writeBookmarkData(bookmark, to: aliasURL)\n3084|    var draft = orgDraft()\n3085|    draft.installDirName = \"alias-dir\"\n3086|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n3087|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n3088|    #expect(await counter.calls == 0, \"Alias path must be refused before any download side effect\")\n3089|    let failure = lastFailure(h.logger)\n3090|    #expect(failure?.step == \"downloadAndInstall\")\n3091|    #expect(failure?.message.contains(\"alias\") ?? false)\n3092|}","final_result":true}}}
