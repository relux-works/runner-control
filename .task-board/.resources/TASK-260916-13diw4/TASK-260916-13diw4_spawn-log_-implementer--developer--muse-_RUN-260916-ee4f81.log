{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c98f","stream":{"kind":"session","id":"01a0a92d-72d5-7050-8a68-2291f8904dd8"},"sequence":802,"recorded_at":1780531400001599,"record_type":"event","durability":"durable","causation_id":"78df6718-13a7-44bd-a557-df1400b3b946","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"78df6718-13a7-44bd-a557-df1400b3b946","run_stream":{"kind":"run","id":"78df6718-13a7-44bd-a557-df1400b3b946"},"task_stream":{"kind":"task","id":"01a0a931-e926-7050-acd1-50fb3b7c94ca"},"task_id":"01a0a931-e926-7050-acd1-50fb3b7c94ca","event":{"kind":"output","task_id":"01a0a931-e926-7050-acd1-50fb3b7c94ca","chunk":"edited\nchanged lines: lines 100-130\n--- original\n+++ updated\n@@\n-    /// Acquires exclusive ownership of `directory`. Synchronous: callers must\n-    /// invoke it before their first await so the check-and-insert is atomic\n-    /// under actor isolation. Throws a retryable `directoryBusy` when another\n-    /// live operation already owns the directory; different physical\n-    /// directories never conflict. Returns the originally acquired canonical\n-    /// key; the caller must hold it across awaits and release that exact key.\n-    private func acquireLease(for directory: URL) throws -> String {\n-        try Self.ensureNoAlias(at: directory)\n-        let key = Self.leaseKey(for: directory, caseSensitiveOverride: caseSensitivityOverride)\n-        guard !activeDirectories.contains(key) else {\n-            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n-        }\n-        activeDirectories.insert(key)\n-        return key\n-    }\n-\n-    private func releaseLease(_ key: String) {\n-        activeDirectories.remove(key)\n-    }\n-\n-    /// Refuses a synchronous mutation (service setup, recovery) while a live\n-    /// async side effect owns the directory. No insert: without an await the\n-    /// caller itself cannot interleave, it only needs to respect leases held\n-    /// by others. Uses the same canonical identity as acquisition.\n-    private func requireIdleDirectory(_ directory: URL) throws {\n-        try Self.ensureNoAlias(at: directory)\n-        let key = Self.leaseKey(for: directory, caseSensitiveOverride: caseSensitivityOverride)\n-        guard !activeDirectories.contains(key) else {\n-            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n-        }\n-    }\n+    /// Acquires the installer-wide mutation lease for `directory`.\n+    /// Synchronous: callers must invoke it before their first await so the\n+    /// check-and-set is atomic under actor isolation. Throws a retryable\n+    /// `installerBusy` whenever ANY live operation holds the lease,\n+    /// regardless of directory — there is no path comparison to bypass.\n+    /// Returns the owner token; the caller must hold it across awaits and\n+    /// release that exact token when the operation settles.\n+    private func acquireMutationLease(for directory: URL) throws -> UUID {\n+        try Self.ensureNoAlias(at: directory)\n+        guard activeOperation == nil else {\n+            throw RunnerRegistration.RegistrationError.installerBusy(path: directory.path)\n+        }\n+        let token = UUID()\n+        activeOperation = token\n+        activePath = directory.path\n+        return token\n+    }\n+\n+    /// Releases the installer-wide lease, but only for its exact owner. A\n+    /// token that does not match the current owner releases nothing, so a\n+    /// stale or foreign completion can never unlock a newer operation.\n+    private func releaseMutationLease(_ token: UUID) {\n+        guard activeOperation == token else { return }\n+        activeOperation = nil\n+        activePath = nil\n+    }\n+\n+    /// Refuses a synchronous mutation (service setup, recovery) while the\n+    /// installer lease is held by a live async side effect. No insert:\n+    /// without an await the caller itself cannot interleave, it only needs\n+    /// to respect the lease held by another operation. Refuses for ANY\n+    /// directory while ANY mutation is live.\n+    private func requireIdleInstaller(_ directory: URL) throws {\n+        try Self.ensureNoAlias(at: directory)\n+        guard activeOperation == nil else {\n+            throw RunnerRegistration.RegistrationError.installerBusy(path: directory.path)\n+        }\n+    }\n","final_result":true}}}
