{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9ef","stream":{"kind":"session","id":"01a0a92d-72d5-7050-8a68-2291f8904dd8"},"sequence":850,"recorded_at":1780531400001695,"record_type":"event","durability":"durable","causation_id":"78df6718-13a7-44bd-a557-df1400b3b946","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"78df6718-13a7-44bd-a557-df1400b3b946","run_stream":{"kind":"run","id":"78df6718-13a7-44bd-a557-df1400b3b946"},"task_stream":{"kind":"task","id":"01a0a932-1463-7091-960f-30ebc10ef04b"},"task_id":"01a0a932-1463-7091-960f-30ebc10ef04b","event":{"kind":"output","task_id":"01a0a932-1463-7091-960f-30ebc10ef04b","chunk":"edited\nchanged lines: lines 329-337\n--- original\n+++ updated\n@@\n-        // Exclusive ownership for the whole config, acquired before the\n-        // first await (resume checks included): a same-directory retry while\n-        // this config.sh is live is refused retryably instead of invoking a\n-        // second config.sh over the same .runner. The lease is released only\n-        // when this operation settles; an abandoned UI generation never\n-        // releases it. The originally acquired canonical key is held across\n-        // awaits and released exactly.\n-        let lease = try acquireLease(for: directory)\n-        defer { releaseLease(lease) }\n+        // Installer-wide ownership for the whole config, acquired before the\n+        // first await (resume checks included): any second mutation while\n+        // this config.sh is live is refused retryably instead of invoking\n+        // another config.sh. The lease is released only when this operation\n+        // settles; an abandoned UI generation never releases it. The owner\n+        // token is held across awaits and only that exact token releases.\n+        let lease = try acquireMutationLease(for: directory)\n+        defer { releaseMutationLease(lease) }\n","final_result":true}}}
