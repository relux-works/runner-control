{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdcb","stream":{"kind":"session","id":"01a0a92d-72d5-7050-8a68-2291f8904dd8"},"sequence":1344,"recorded_at":1780531400002683,"record_type":"event","durability":"durable","causation_id":"78df6718-13a7-44bd-a557-df1400b3b946","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"78df6718-13a7-44bd-a557-df1400b3b946","run_stream":{"kind":"run","id":"78df6718-13a7-44bd-a557-df1400b3b946"},"task_stream":{"kind":"task","id":"01a0a933-dc08-76c3-ae9c-c4b793a4a9e2"},"task_id":"01a0a933-dc08-76c3-ae9c-c4b793a4a9e2","event":{"kind":"output","task_id":"01a0a933-dc08-76c3-ae9c-c4b793a4a9e2","chunk":"edited\nchanged lines: lines 3004-3071\n--- original\n+++ updated\n@@\n-@Test @MainActor func caseSensitiveVolumeKeepsDistinctDirectoryLeases() async throws {\n-    // R7 scope control through the production Flow entry point: with a\n-    // forced case-sensitive volume the same two spellings are two\n-    // directories, so the second install proceeds instead of refusing.\n-    // Host-independent: sensitivity is forced via the installer seam, so\n-    // this passes on case-insensitive hosts too. Bounded start poll (no\n-    // leaked continuation) so a gate error fails fast instead of hanging.\n-    let package = try await FixturePackage.make()\n-    let downloads = CountingLatchDownloader(bytes: package.bytes)\n-    let transport = TestTransport([\n-        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n-        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n-    ])\n-    let harness = await registrationHarness(\n-        transport: transport, downloader: { url in try await downloads.download(url) },\n-        caseSensitivityOverride: true\n-    )\n-    defer { try? FileManager.default.removeItem(at: harness.home) }\n-    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n-    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n-    let deadline = Date().addingTimeInterval(10)\n-    while !(await downloads.started) && Date() < deadline { try? await Task.sleep(nanoseconds: 10_000_000) }\n-    guard await downloads.started else { #expect(Bool(false), \"Download never started\"); await downloads.release(); _ = await old.value; return }\n-    var aliasDraft = orgDraft()\n-    aliasDraft.installDirName = \"MACBOOK-TEST\"\n-    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(aliasDraft))\n-    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n-    #expect(await downloads.calls == 2, \"Case-sensitive spellings must keep distinct leases\")\n-    #expect(lastFailure(harness.logger) == nil, \"Distinct directories must not report busy\")\n-    await downloads.release()\n-    _ = await old.value\n-}\n-\n-@Test func leaseKeyCaseFoldingFollowsVolumeSensitivity() throws {\n-    // R7 unit control for the canonical lease owner: forced-insensitive\n-    // folds missing-leaf case aliases to one key with before/after-creation\n-    // stability; forced-sensitive keeps them distinct; the production\n-    // default follows the real volume either way (host-independent).\n-    let files = FileManager.default\n-    let root = files.temporaryDirectory.appendingPathComponent(\"LeaseCase-\" + UUID().uuidString)\n-    try files.createDirectory(at: root, withIntermediateDirectories: true)\n-    defer { try? files.removeItem(at: root) }\n-    let lower = root.appendingPathComponent(\"macbook-test\")\n-    let upper = root.appendingPathComponent(\"MACBOOK-TEST\")\n-    #expect(\n-        RunnerInstallerService.leaseKey(for: lower, caseSensitiveOverride: false)\n-            == RunnerInstallerService.leaseKey(for: upper, caseSensitiveOverride: false),\n-        \"Case-insensitive volumes must fold missing-leaf aliases to one lease key\"\n-    )\n-    #expect(\n-        RunnerInstallerService.leaseKey(for: lower, caseSensitiveOverride: true)\n-            != RunnerInstallerService.leaseKey(for: upper, caseSensitiveOverride: true),\n-        \"Case-sensitive volumes must keep distinct leases per spelling\"\n-    )\n-    let beforeUpper = RunnerInstallerService.leaseKey(for: upper, caseSensitiveOverride: false)\n-    try files.createDirectory(at: lower, withIntermediateDirectories: true)\n-    let afterUpper = RunnerInstallerService.leaseKey(for: upper, caseSensitiveOverride: false)\n-    #expect(beforeUpper == afterUpper, \"Lease identity must stay stable before/after creation\")\n-    let realLower = RunnerInstallerService.leaseKey(for: lower)\n-    let realUpper = RunnerInstallerService.leaseKey(for: upper)\n-    if RunnerInstallerService.isCaseSensitiveVolume(at: root) {\n-        #expect(realLower != realUpper, \"Production default must preserve distinct spellings on sensitive volumes\")\n-    } else {\n-        #expect(realLower == realUpper, \"Production default must unify aliases on insensitive volumes\")\n-    }\n-}\n-\n-@Test @MainActor func finderAliasInstallFolderIsRefusedBeforeDownload() async throws {\n+// R8: the R7 forced-sensitive concurrency control and the lease-key\n+// folding unit test are removed with the per-path lease identity they\n+// covered. Case-alias concurrency is still proven through the production\n+// Flow by reviewerCaseAliasMissingLeafCannotBypassDirectoryLease and\n+// reviewerUnicodeCaseAliasCannotBypassDirectoryLease; deliberate\n+// serialization of distinct directories by\n+// secondInstallForAnyDirectoryRefusedWhileInstallerBusy.\n+\n+@Test @MainActor func finderAliasInstallFolderIsRefusedBeforeDownload() async throws {\n","final_result":true}}}
