{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5fd","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":345,"recorded_at":1780531400000685,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8b3-8127-7453-930f-f2dd07474c19"},"task_id":"01a0a8b3-8127-7453-930f-f2dd07474c19","event":{"kind":"output","task_id":"01a0a8b3-8127-7453-930f-f2dd07474c19","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Gates.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Validation gates. Each gate refuses a concrete invalid class; negative\n5|    /// tests narrow every one of them.\n6|    public enum Gates {\n7|        /// Refuses install/work paths containing spaces. GitHub's own setup has\n8|        /// a known defect with spaced paths; the wizard never reproduces it.\n9|        public static func validateNoSpace(installDirName: String, workFolder: String) throws {\n10|            if installDirName.contains(\" \") {\n11|                throw RegistrationError.noSpacePath(\"Installation folder name must not contain spaces.\")\n12|            }\n13|            if installDirName.contains(\"/\") || installDirName.isEmpty {\n14|                throw RegistrationError.invalidDraft(\"Installation folder name is invalid.\")\n15|            }\n16|            if workFolder.contains(\" \") {\n17|                throw RegistrationError.noSpacePath(\"Work folder must not contain spaces.\")\n18|            }\n19|            if workFolder.isEmpty || workFolder.contains(\"/\") {\n20|                throw RegistrationError.invalidDraft(\"Work folder name is invalid.\")\n21|            }\n22|        }\n23|\n24|        /// Validates the full draft before any network or filesystem mutation.\n25|        public static func validateDraft(_ draft: Draft) throws {\n26|            let name = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n27|            guard !name.isEmpty else {\n28|                throw RegistrationError.invalidDraft(\"Runner name must not be empty.\")\n29|            }\n30|            guard name.count <= 64 else {\n31|                throw RegistrationError.invalidDraft(\"Runner name is too long (max 64 characters).\")\n32|            }\n33|            let labels = draft.labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }\n34|            guard !labels.isEmpty else {\n35|                throw RegistrationError.invalidDraft(\"At least one label is required.\")\n36|            }\n37|            for label in labels {\n38|                guard !label.isEmpty else {\n39|                    throw RegistrationError.invalidDraft(\"Labels must not be empty.\")\n40|                }\n41|                guard label.count <= 100 else {\n42|                    throw RegistrationError.invalidDraft(\"Label '\\(label)' is too long (max 100 characters).\")\n43|                }\n44|            }\n45|            try validateNoSpace(installDirName: draft.installDirName, workFolder: draft.workFolder)\n46|            switch draft.scope {\n47|            case .organization:\n48|                let group = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n49|                guard !group.isEmpty else {\n50|                    throw RegistrationError.invalidDraft(\"Organization runners need a dedicated per-Mac group name.\")\n51|                }\n52|            case .repository:\n53|                break\n54|            }\n55|        }\n56|\n57|        /// Picks the architecture-matched official asset. Refuses any\n58|        /// substitute: both OS and architecture must match exactly.\n59|        public static func selectDownload(\n60|            osName: String, arch: String, from assets: [DownloadAsset]\n61|        ) throws -> DownloadAsset {\n62|            guard let match = assets.first(where: { $0.osName == osName && $0.architecture == arch }) else {\n63|                throw RegistrationError.downloadMismatch(osName: osName, arch: arch)\n64|            }\n65|            return match\n66|        }\n67|\n68|        /// Authorizes a group mutation only when the UI explicitly scoped it\n69|        /// AND the target is this run's resolved dedicated group. Never\n70|        /// mutates unrelated or shared groups.\n71|        public static func authorizeGroupMutation(\n72|            targetGroupID: Int64, resolvedGroupID: Int64?, allowFlag: Bool\n73|        ) throws {\n74|            guard allowFlag else { throw RegistrationError.groupScopeNotConfirmed }\n75|            guard let resolved = resolvedGroupID, resolved == targetGroupID else {\n76|                throw RegistrationError.refusesSharedGroup(groupID: targetGroupID)\n77|            }\n78|        }\n79|\n80|        /// Repository scope never touches groups: personal repos get separate\n81|        /// installations without shared-group coupling.\n82|        public static func requireOrganizationScope(_ scope: Scope) throws {\n83|            if case .organization = scope { return }\n84|            throw RegistrationError.groupNotApplicable\n85|        }\n86|\n87|        /// Ownership check for a pre-existing group with the requested name.\n88|        /// A name match alone never authorizes adoption: the caller must show\n89|        /// either a locally recorded ownership entry for the same group ID or\n90|        /// an explicit UI takeover confirmation.\n91|        public static func authorizeGroupTakeover(\n92|            groupName: String, existingID: Int64, ownedID: Int64?, allowTakeover: Bool\n93|        ) throws {\n94|            if let owned = ownedID, owned == existingID { return }\n95|            guard allowTakeover else {\n96|                throw RegistrationError.groupNameTaken(name: groupName, groupID: existingID)\n97|            }\n98|        }\n99|\n100|        /// Duplicate-name guard run before any registration token is minted.\n101|        /// Without explicit replace consent a remote name match refuses the\n102|        /// run so `config.sh` can never silently replace another machine.\n103|        public static func rejectRemoteDuplicate(name: String, isTaken: Bool, allowReplace: Bool) throws {\n104|            guard isTaken, !allowReplace else { return }\n105|            throw RegistrationError.remoteNameTaken(name: name)\n106|        }\n107|\n108|        /// Verifies the local `.runner` identity belongs to this draft's\n109|        /// operation. Returns the verified local agent ID. Refuses anything\n110|        /// else: an unconfigured directory, a missing or unreadable agent ID,\n111|        /// a name mismatch, or a scope mismatch. A remote name match alone\n112|        /// never authorizes writes to another runner.\n113|        public static func verifiedLocalAgentID(\n114|            local: LocalRegistration?, configured: Bool, draft: Draft\n115|        ) throws -> Int64 {\n116|            guard configured else {\n117|                throw RegistrationError.unverifiedRegistration(\n118|                    \"Directory '\\(draft.installDirName)' was never configured by this wizard. Register it first; refusing a planted or foreign registration.\"\n119|                )\n120|            }\n121|            guard let local, let agentID = local.agentID else {\n122|                throw RegistrationError.unverifiedRegistration(\n123|                    \"No verified local registration for '\\(draft.runnerName)': install and register this directory first; refusing to touch a runner that is not this installation.\"\n124|                )\n125|            }\n126|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n127|            guard let name = local.agentName, name == wanted else {\n128|                throw RegistrationError.unverifiedRegistration(\n129|                    \"Local registration is for '\\(local.agentName ?? \"unknown\")', not '\\(wanted)'. Refusing to use another registration's identity.\"\n130|                )\n131|            }\n132|            guard let address = local.gitHubURL, scopeMatches(address: address, scope: draft.scope) else {\n133|                throw RegistrationError.unverifiedRegistration(\n134|                    \"Local registration points at '\\(local.gitHubURL ?? \"unknown\")', not this draft's scope. Refusing to use another registration's identity.\"\n135|                )\n136|            }\n137|            return agentID\n138|        }\n139|\n140|        /// Matches a `.runner` gitHubUrl against a draft scope by URL path,\n141|        /// mirroring RunnerDiscovery's parsing (one component for an org, two\n142|        /// for owner/repo). GitHub logins compare case-insensitively.\n143|        public static func scopeMatches(address: String, scope: Scope) -> Bool {\n144|            guard let url = URL(string: address), url.scheme == \"https\" else { return false }\n145|            let components = url.pathComponents.filter { $0 != \"/\" }.map { $0.lowercased() }\n146|            switch scope {\n147|            case .organization(let org):\n148|                return components == [org.lowercased()]\n149|            case .repository(let owner, let name):\n150|                return components == [owner.lowercased(), name.lowercased()]\n151|            }\n152|        }\n153|\n154|        /// Binds the complete remote runner list to the verified local agent\n155|        /// ID. Returns the bound runner ID, or nil when this agent is not\n156|        /// listed yet (retryable convergence, never an error by itself).\n157|        /// Throws when the list contradicts the local identity — a same-name\n158|        /// foreign runner or a renamed local agent — instead of guessing.\n159|        public static func boundRemoteRunnerID(\n160|            localAgentID: Int64, name: String, runners: [RegisteredRunner]\n161|        ) throws -> Int64? {\n162|            if let exact = runners.first(where: { $0.id == localAgentID }) {\n163|                guard exact.name == name else {\n164|                    throw RegistrationError.remoteIdentityMismatch(\n165|                        \"GitHub lists agent \\(localAgentID) as '\\(exact.name)', not '\\(name)'. Refusing to write to a mismatched registration.\"\n166|                    )\n167|                }\n168|                return exact.id\n169|            }\n170|            if let foreign = runners.first(where: { $0.name == name }) {\n171|                throw RegistrationError.remoteIdentityMismatch(\n172|                    \"This installation is agent \\(localAgentID), but GitHub shows '\\(name)' as agent \\(foreign.id). Refusing to adopt another runner's identity.\"\n173|                )\n174|            }\n175|            return nil\n176|        }\n177|\n178|        /// Confirms a repository-access write against the complete confirmed\n179|        /// list. Any difference — missing or extra IDs — fails closed instead\n180|        /// of reporting partial access as complete.\n181|        public static func confirmRepositoryIDs(requested: Set<Int64>, confirmed: [Int64]) throws {\n182|            guard Set(confirmed) == requested else {\n183|                throw RegistrationError.confirmationMismatch(\n184|                    \"GitHub confirmed repositories \\(confirmed.sorted()) but \\(requested.sorted()) was requested. Refusing to report partial access as complete.\"\n185|                )\n186|            }\n187|        }\n188|    }\n189|\n190|    /// Exact `config.sh` invocation inputs.\n191|    public struct ConfigSpec: Sendable, Equatable {\n192|        let scopeURL: String\n193|        let token: String\n194|        let name: String\n195|        let workFolder: String\n196|        let labels: [String]\n197|        let runnerGroup: String?\n198|        /// Explicit `--replace`. Production sets it only from\n199|        /// `Draft.allowReplace`; default invocations omit the flag so a\n200|        /// duplicate name fails instead of stealing another registration.\n201|        let replace: Bool\n202|    }\n203|\n204|    /// Exact `config.sh` invocation builder. Argument order is fixed and\n205|    /// covered by tests; production runs this exact array.\n206|    public enum ConfigInvocation {\n207|        public static func arguments(_ spec: ConfigSpec) -> [String] {\n208|            var args = [\n209|                \"--url\", spec.scopeURL,\n210|                \"--token\", spec.token,\n211|                \"--name\", spec.name,\n212|                \"--work\", spec.workFolder,\n213|                \"--labels\", spec.labels.joined(separator: \",\")\n214|            ]\n215|            if let group = spec.runnerGroup, !group.isEmpty {\n216|                args += [\"--runnergroup\", group]\n217|            }\n218|            args += [\"--unattended\"]\n219|            if spec.replace {\n220|                args += [\"--replace\"]\n221|            }\n222|            return args\n223|        }\n224|    }\n225|}","final_result":true}}}
