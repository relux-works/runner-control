{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d2e3","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":1996,"recorded_at":1780531400003987,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8be-b85a-7382-b2f7-ae5d479d11fc"},"task_id":"01a0a8be-b85a-7382-b2f7-ae5d479d11fc","event":{"kind":"output","task_id":"01a0a8be-b85a-7382-b2f7-ae5d479d11fc","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(187 line(s) above)\n188|/// Records config.sh argv and simulates a successful registration by writing\n189|/// `.runner`. Delegates every other command (tar) to the real executor.\n190|private actor SplitExecutor: CommandExecuting {\n191|    private(set) var configCalls: [[String]] = []\n192|    var failure: CommandResult?\n193|    private let real = CommandExecutor()\n194|    private let gitHubURL: String\n195|\n196|    init(gitHubURL: String = \"https://github.com/acme\") {\n197|        self.gitHubURL = gitHubURL\n198|    }\n199|\n200|    func run(_ executable: String, _ arguments: [String]) async throws -> CommandResult {\n201|        if executable.hasSuffix(\"config.sh\") {\n202|            configCalls.append(arguments)\n203|            if let failure { return failure }\n204|            let dir = URL(fileURLWithPath: executable).deletingLastPathComponent()\n205|            var name = \"unnamed\"\n206|            var index = arguments.startIndex\n207|            while index < arguments.endIndex {\n208|                if arguments[index] == \"--name\", arguments.index(after: index) < arguments.endIndex {\n209|                    name = arguments[arguments.index(after: index)]\n210|                }\n211|                index = arguments.index(after: index)\n212|            }\n213|            let payload = [\"agentId\": 4242, \"agentName\": name, \"gitHubUrl\": gitHubURL, \"workFolder\": \"_work\"] as [String: Any]\n214|            let data = try JSONSerialization.data(withJSONObject: payload)\n215|            try data.write(to: dir.appendingPathComponent(\".runner\"), options: .atomic)\n216|            return CommandResult(code: 0, output: \"Configured\")\n217|        }\n218|        return try await real.run(executable, arguments)\n219|    }\n220|}\n221|\n222|// MARK: - Reducer and pure gates\n(more lines below)","final_result":true}}}
