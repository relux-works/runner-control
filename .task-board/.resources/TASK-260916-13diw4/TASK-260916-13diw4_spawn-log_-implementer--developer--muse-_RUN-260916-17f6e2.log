ctions = registrationActions(harness.logger)\n1078|    #expect(actions.contains {\n1079|        if case .permissionDenied(let message, _) = $0, message.contains(\"Self-hosted runners/write\") { true } else { false }\n1080|    })\n1081|}\n1082|\n1083|// MARK: - Group ownership (name alone never authorizes)\n1084|\n1085|@Test func existingGroupNameWithoutTakeoverIsRefused() async {\n1086|    let transport = TestTransport([\n1087|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n1088|    ])\n1089|    let harness = await registrationHarness(transport: transport)\n1090|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1091|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1092|    let failure = lastFailure(harness.logger)\n1093|    #expect(failure?.step == \"resolveGroup\")\n1094|    #expect((failure?.message.contains(\"already exists\") ?? false))\n1095|    #expect((failure?.message.contains(\"takeover\") ?? false))\n1096|    // No mutation followed the refused adoption: no POST, PATCH, or PUT.\n1097|    let writes = await transport.requests.filter { $0.method != \"GET\" }\n1098|    #expect(writes.isEmpty)\n1099|    #expect(await harness.installer.loadOwnedGroupID(org: \"acme\", name: \"RunnerControl-Mac\") == nil)\n1100|}\n1101|\n1102|@Test func ownedGroupResolvesWithoutRetakeover() async throws {\n1103|    // First run creates the group and records ownership on this Mac.\n1104|    let first = TestTransport([\n1105|        groupsListPayload([groupPayload(id: 1, name: \"Default\", visibility: \"all\", allowsPublic: true)]),\n1106|        jsonResponse(groupPayload(id: 7, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true), status: 201),\n1107|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1108|    ])\n1109|    let harness = await registrationHarness(transport: first)\n1110|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1111|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1112|    #expect(await harness.installer.loadOwnedGroupID(org: \"acme\", name: \"RunnerControl-Mac\") == 7)\n1113|    // Second run (fresh Flow, same install root) reuses the owned group\n1114|    // without asking for takeover again.\n1115|    let second = TestTransport([\n1116|        groupsListPayload([\n1117|            groupPayload(id: 1, name: \"Default\", visibility: \"all\", allowsPublic: true),\n1118|            groupPayload(id: 7, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true),\n1119|        ]),\n(more lines below)","final_result":true}}}
