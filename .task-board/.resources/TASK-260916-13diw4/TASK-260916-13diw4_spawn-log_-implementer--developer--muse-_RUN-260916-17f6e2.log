{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c949","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":767,"recorded_at":1780531400001529,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8b7-7fcc-77c1-a3b2-866b0e899b94"},"task_id":"01a0a8b7-7fcc-77c1-a3b2-866b0e899b94","event":{"kind":"output","task_id":"01a0a8b7-7fcc-77c1-a3b2-866b0e899b94","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(1082 line(s) above)\n1083|// MARK: - Group ownership (name alone never authorizes)\n1084|\n1085|@Test func existingGroupNameWithoutTakeoverIsRefused() async {\n1086|    let transport = TestTransport([\n1087|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n1088|    ])\n1089|    let harness = await registrationHarness(transport: transport)\n1090|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1091|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1092|    let failure = lastFailure(harness.logger)\n1093|    #expect(failure?.step == \"resolveGroup\")\n1094|    #expect((failure?.message.contains(\"already exists\") ?? false))\n1095|    #expect((failure?.message.contains(\"takeover\") ?? false))\n1096|    // No mutation followed the refused adoption: no POST, PATCH, or PUT.\n1097|    let writes = await transport.requests.filter { $0.method != \"GET\" }\n1098|    #expect(writes.isEmpty)\n1099|    #expect(await harness.installer.loadOwnedGroupID(org: \"acme\", name: \"RunnerControl-Mac\") == nil)\n1100|}\n1101|\n1102|@Test func ownedGroupResolvesWithoutRetakeover() async throws {\n1103|    // First run creates the group and records ownership on this Mac.\n1104|    let first = TestTransport([\n1105|        groupsListPayload([groupPayload(id: 1, name: \"Default\", visibility: \"all\", allowsPublic: true)]),\n1106|        jsonResponse(groupPayload(id: 7, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true), status: 201),\n1107|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1108|    ])\n1109|    let harness = await registrationHarness(transport: first)\n1110|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1111|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1112|    #expect(await harness.installer.loadOwnedGroupID(org: \"acme\", name: \"RunnerControl-Mac\") == 7)\n1113|    // Second run (fresh Flow, same install root) reuses the owned group\n1114|    // without asking for takeover again.\n1115|    let second = TestTransport([\n1116|        groupsListPayload([\n1117|            groupPayload(id: 1, name: \"Default\", visibility: \"all\", allowsPublic: true),\n1118|            groupPayload(id: 7, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true),\n1119|        ]),\n1120|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1121|    ])\n1122|    let logger = Relux.Testing.Logger()\n1123|    let dispatcher = Relux.Dispatcher(logger: logger)\n1124|    let api = GitHubRunnerAPIClient(transport: second)\n1125|    let refresher = GitHubTokenRefresh(transport: second, store: harness.userStore)\n1126|    let identities = InMemoryGitHubSessionIdentityStore()\n1127|    await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n1128|    let flow = await RunnerRegistration.Flow(\n1129|        api: api, installer: harness.installer, registrationTokens: harness.registrationTokens,\n1130|        userStore: harness.userStore, identityStore: identities, refresher: refresher,\n1131|        configProvider: { _ in testConfig }, dispatcher: dispatcher\n1132|    )\n1133|    _ = await flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1134|    _ = await flow.apply(RunnerRegistration.Effect.resolveGroup)\n1135|    let resolved = logger.actions.compactMap { $0 as? RunnerRegistration.Action }.compactMap { action -> Int64? in\n1136|        if case .groupResolved(let group, _) = action { group.id } else { nil }\n1137|    }\n1138|    #expect(resolved == [7])\n1139|    #expect(await second.requests.filter { $0.method == \"POST\" }.isEmpty)\n1140|}\n1141|\n1142|@Test func takeoverRecordsOwnershipForRetries() async throws {\n1143|    let transport = TestTransport([\n1144|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n1145|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1146|    ])\n1147|    let harness = await registrationHarness(transport: transport)\n1148|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1149|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1150|    #expect(await harness.installer.loadOwnedGroupID(org: \"acme\", name: \"RunnerControl-Mac\") == 5)\n1151|}\n1152|\n1153|// MARK: - Public repositories (allows_public_repositories)\n1154|\n1155|@Test func resolvePatchesDeniedPublicReposOnOwnedGroup() async throws {\n1156|    let transport = TestTransport([\n1157|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: false)]),\n1158|        jsonResponse(groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)),\n1159|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1160|    ])\n1161|    let harness = await registrationHarness(transport: transport)\n1162|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1163|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1164|    let patches = await transport.requests.filter { $0.method == \"PATCH\" }\n1165|    #expect(patches.count == 1)\n1166|    #expect(patches.first?.url.path.contains(\"/orgs/acme/actions/runner-groups/5\") ?? false)\n1167|    let body = try JSONDecoder().decode([String: JSONAny].self, from: patches.first?.body ?? Data())\n1168|    #expect(body[\"allows_public_repositories\"]?.bool == true)\n1169|    let resolved = registrationActions(harness.logger).compactMap { action -> RunnerRegistration.RunnerGroup? in\n1170|        if case .groupResolved(let group, _) = action { group } else { nil }\n1171|    }\n1172|    #expect(resolved.first?.allowsPublicRepositories == true)\n1173|}\n1174|\n1175|@Test func resolveSkipsPatchWhenPublicReposAllowed() async {\n1176|    let transport = TestTransport([\n1177|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n1178|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1179|    ])\n1180|    let harness = await registrationHarness(transport: transport)\n1181|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1182|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1183|    #expect(await transport.requests.filter { $0.method == \"PATCH\" }.isEmpty)\n1184|}\n1185|\n1186|// MARK: - Remote duplicate names (no silent --replace)\n1187|\n1188|@Test func remoteDuplicateWithoutReplaceIsRefusedBeforeToken() async throws {\n1189|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1190|    let executor = SplitExecutor()\n1191|    let transport = TestTransport([\n1192|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1193|        runnersListPayload([[\"id\": 99, \"name\": \"macbook-test\", \"labels\": []]]),\n1194|    ])\n1195|    let harness = await registrationHarness(\n1196|        transport: transport,\n1197|        downloader: fixtureDownloader(package.bytes),\n1198|        executor: executor\n1199|    )\n1200|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1201|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1202|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n1203|    let failure = lastFailure(harness.logger)\n1204|    #expect(failure?.step == \"registerRunner\")\n1205|    #expect((failure?.message.contains(\"already exists in GitHub\") ?? false))\n1206|    // No registration token was minted and config.sh never ran.\n1207|    let tokenPosts = await transport.requests.filter {\n1208|        $0.method == \"POST\" && $0.url.path.contains(\"registration-token\")\n1209|    }\n1210|    #expect(tokenPosts.isEmpty)\n1211|    #expect(await executor.configCalls.isEmpty)\n1212|}\n(more lines below)","final_result":true}}}
