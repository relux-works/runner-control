n38|        )\n39|    }\n40|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"RegHome-\" + UUID().uuidString)\n41|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n42|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n43|    let archCopy = arch\n44|    let installer = RunnerInstallerService(\n45|        installRoot: installRoot,\n46|        downloader: downloader,\n47|        executor: executor,\n48|        currentArch: { archCopy }\n49|    )\n50|    let api = GitHubRunnerAPIClient(transport: transport)\n51|    let registrationTokens = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n52|    let refresher = GitHubTokenRefresh(transport: transport, store: userStore)\n53|    let flow = await RunnerRegistration.Flow(\n54|        api: api, installer: installer, registrationTokens: registrationTokens,\n55|        userStore: userStore, identityStore: identities, refresher: refresher,\n56|        configProvider: { _ in testConfig }, dispatcher: dispatcher\n57|    )\n58|    return RegistrationHarness(\n59|        flow: flow, logger: logger, transport: transport, userStore: userStore,\n60|        registrationTokens: registrationTokens, installer: installer, home: home, installRoot: installRoot\n61|    )\n62|}\n63|\n64|private func registrationActions(_ logger: Relux.Testing.Logger) -> [RunnerRegistration.Action] {\n65|    logger.actions.compactMap { $0 as? RunnerRegistration.Action }\n66|}\n67|\n68|private func lastFailure(_ logger: Relux.Testing.Logger) -> (message: String, step: String)? {\n69|    for action in registrationActions(logger).reversed() {\n70|        switch action {\n71|        case .failed(let message, let step): return (message, step)\n72|        case .permissionDenied(let message, let step): return (message, step)\n73|        default: break\n74|        }\n75|    }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
