{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d27f","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":1946,"recorded_at":1780531400003887,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8be-74bc-75c2-92d4-3b42319b03bf"},"task_id":"01a0a8be-74bc-75c2-92d4-3b42319b03bf","event":{"kind":"output","task_id":"01a0a8be-74bc-75c2-92d4-3b42319b03bf","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(841 line(s) above)\n842|private func runnersListPayload(_ runners: [[String: Any]]) -> GitHubHTTPResponse {\n843|    jsonResponse([\"runners\": runners])\n844|}\n845|\n846|@Test func orgWizardEndToEndDeletesTokenAndLeaksNothing() async throws {\n847|    let package = try await FixturePackage.make(withRealConfigScript: false)\n848|    let executor = SplitExecutor()\n849|    let transport = TestTransport([\n850|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n851|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n852|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n853|        runnersListPayload([]),\n854|        jsonResponse([\"token\": \"REG-SECRET-1\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n855|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": [[\"name\": \"self-hosted\"], [\"name\": \"macOS\"]]]]),\n856|    ])\n857|    let harness = await registrationHarness(\n858|        transport: transport,\n859|        downloader: fixtureDownloader(package.bytes),\n860|        executor: executor\n861|    )\n862|    let draft = orgDraft(allowTakeover: true)\n863|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n864|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n865|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n866|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n867|    _ = await harness.flow.apply(RunnerRegistration.Effect.setupService)\n868|    let actions = registrationActions(harness.logger)\n869|    let registered = actions.compactMap { action -> (Int64?, Int64?)? in\n870|        if case .registered(let runnerID, let localID) = action { (runnerID, localID) } else { nil }\n871|    }\n872|    // Real IDs: remote GitHub runner ID bound to the verified local agent ID.\n873|    #expect(registered.last?.0 == 4242)\n874|    #expect(registered.last?.1 == 4242)\n875|    #expect(actions.contains { if case .serviceReady = $0 { true } else { false } })\n876|    // The short-lived registration token is deleted immediately after use.\n877|    let scopeKey = RunnerRegistration.Flow.tokenScopeKey(draft: draft)\n878|    #expect(await harness.registrationTokens.load(scopeKey: scopeKey) == nil)\n879|    // No secret leakage: the registration token appears nowhere in\n880|    // dispatched actions, request URLs, headers, or bodies.\n881|    let haystack = actions.map { String(describing: $0) }.joined(separator: \"\\n\")\n882|    #expect(!haystack.contains(\"REG-SECRET-1\"))\n883|    for request in await transport.requests {\n884|        #expect(!request.url.absoluteString.contains(\"REG-SECRET-1\"))\n885|        #expect(!request.headers.values.joined().contains(\"REG-SECRET-1\"))\n886|        if let body = request.body {\n887|            #expect(!String(decoding: body, as: UTF8.self).contains(\"REG-SECRET-1\"))\n888|        }\n889|    }\n890|    // The token reached exactly one place: the config.sh argv in memory.\n891|    let calls = await executor.configCalls\n892|    #expect(calls.count == 1)\n893|    #expect(calls.first?.contains(\"REG-SECRET-1\") ?? false)\n894|    #expect(calls.first?.contains(\"--runnergroup\") ?? false)\n895|    // Wizard output is discoverable and launchable by production code.\n896|    #expect(RunnerDiscovery.installed(home: harness.home).count == 1)\n897|}\n898|\n899|@Test func repoWizardOmitsRunnerGroup() async throws {\n900|    let package = try await FixturePackage.make(withRealConfigScript: false)\n901|    let executor = SplitExecutor(gitHubURL: \"https://github.com/octo/app\")\n902|    let transport = TestTransport([\n903|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n904|        runnersListPayload([]),\n905|        jsonResponse([\"token\": \"REG-SECRET-2\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n906|        runnersListPayload([[\"id\": 4242, \"name\": \"personal-runner\", \"labels\": [[\"name\": \"self-hosted\"]]]]),\n907|    ])\n908|    let harness = await registrationHarness(\n909|        transport: transport,\n910|        downloader: fixtureDownloader(package.bytes),\n911|        executor: executor\n912|    )\n913|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(repoDraft()))\n914|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n915|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n916|    let calls = await executor.configCalls\n917|    #expect(calls.count == 1)\n918|    #expect(!(calls.first?.contains(\"--runnergroup\") ?? true))\n919|    let requests = await transport.requests\n920|    #expect(requests.allSatisfy { !$0.url.path.contains(\"runner-groups\") })\n921|    #expect(requests.contains { $0.url.path.contains(\"/repos/octo/app/actions/runners/registration-token\") })\n922|}\n923|\n924|@Test func retryResumesFailedDownloadWithoutDuplicates() async throws {\n925|    let package = try await FixturePackage.make()\n926|    actor Flaky {\n927|        let bytes: Data\n928|        var calls = 0\n929|        init(bytes: Data) { self.bytes = bytes }\n930|        func next(_ url: URL) async throws -> Data {\n931|            calls += 1\n932|            if calls == 1 { throw URLError(.notConnectedToInternet) }\n933|            return bytes\n934|        }\n935|    }\n936|    let flaky = Flaky(bytes: package.bytes)\n937|    let transport = TestTransport([downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))])\n938|    let harness = await registrationHarness(\n939|        transport: transport,\n940|        downloader: { url in try await flaky.next(url) }\n941|    )\n942|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n943|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n944|    #expect(lastFailure(harness.logger)?.step == \"downloadAndInstall\")\n945|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n946|    let actions = registrationActions(harness.logger)\n947|    #expect(actions.contains { if case .installed = $0 { true } else { false } })\n948|    // The asset resolved once; the retry resumed the download, not the lookup.\n949|    #expect(await transport.requests.count == 1)\n950|    #expect(await flaky.calls == 2)\n951|    let directory = await harness.installer.directory(for: \"macbook-test\")\n952|    #expect(FileManager.default.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path))\n953|}\n954|\n955|@Test func registerIsIdempotentAcrossRetries() async throws {\n956|    let package = try await FixturePackage.make(withRealConfigScript: false)\n957|    let executor = SplitExecutor()\n958|    let transport = TestTransport([\n959|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n960|        runnersListPayload([]),\n961|        jsonResponse([\"token\": \"REG-SECRET-3\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n962|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n963|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n964|    ])\n965|    let harness = await registrationHarness(\n966|        transport: transport,\n967|        downloader: fixtureDownloader(package.bytes),\n968|        executor: executor\n969|    )\n970|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n971|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n972|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n973|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n974|    let tokenPosts = await transport.requests.filter {\n975|        $0.method == \"POST\" && $0.url.path.contains(\"registration-token\")\n976|    }\n977|    // The retry minted no second token and ran config.sh exactly once:\n978|    // no orphan or duplicate GitHub registrations.\n979|    #expect(tokenPosts.count == 1)\n980|    #expect(await executor.configCalls.count == 1)\n981|    let registered = registrationActions(harness.logger).filter {\n982|        if case .registered = $0 { true } else { false }\n983|    }\n984|    #expect(registered.count == 2)\n985|}\n986|\n987|@Test func failedConfigDeletesTokenAndReportsScrubbedError() async throws {\n988|    let package = try await FixturePackage.make(withRealConfigScript: false)\n989|    let executor = SplitExecutor()\n990|    await executor.setFailure(CommandResult(code: 1, output: \"bad --token REG-SECRET-9\"))\n991|    let transport = TestTransport([\n992|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n993|        runnersListPayload([]),\n994|        jsonResponse([\"token\": \"REG-SECRET-9\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n995|    ])\n996|    let harness = await registrationHarness(\n997|        transport: transport,\n998|        downloader: fixtureDownloader(package.bytes),\n999|        executor: executor\n1000|    )\