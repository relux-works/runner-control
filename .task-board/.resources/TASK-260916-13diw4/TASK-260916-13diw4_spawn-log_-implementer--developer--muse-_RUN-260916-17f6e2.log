{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c73f","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":506,"recorded_at":1780531400001007,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8b3-cd96-7f72-9ec4-674259a626e4"},"task_id":"01a0a8b3-cd96-7f72-9ec4-674259a626e4","event":{"kind":"output","task_id":"01a0a8b3-cd96-7f72-9ec4-674259a626e4","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(1299 line(s) above)\n1300|    #expect(puts.count == 1)\n1301|    #expect(puts.first?.url.path.contains(\"/orgs/acme/actions/runners/4242/labels\") ?? false)\n1302|}\n1303|\n1304|// MARK: - R2 regressions: list URLs, identity, invalidation, pagination, service gate\n1305|\n1306|/// Builds a paginated list page with an optional `Link: rel=\"next\"` header.\n1307|private func pagedResponse(_ object: Any, next: String? = nil) -> GitHubHTTPResponse {\n1308|    // Static test literals always serialize.\n1309|    // swiftlint:disable:next force_try\n1310|    let data = try! JSONSerialization.data(withJSONObject: object)\n1311|    var headers: [String: String] = [:]\n1312|    if let next { headers[\"Link\"] = \"<\\(next)>; rel=\\\"next\\\"\" }\n1313|    return GitHubHTTPResponse(status: 200, headers: headers, body: data)\n1314|}\n1315|\n1316|private func hasPerPageQuery(_ url: URL) -> Bool {\n1317|    URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems?.contains(\n1318|        URLQueryItem(name: \"per_page\", value: \"100\")\n1319|    ) == true\n1320|}\n1321|\n1322|@Test func orgListRequestsUseQueryNotEncodedPath() async throws {\n1323|    // R2-F1: list requests must carry per_page as a real query, not as an\n1324|    // encoded \"%3F\" segment of the path GitHub never parses.\n1325|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1326|    let transport = TestTransport([\n1327|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n1328|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1329|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1330|        runnersListPayload([]),\n1331|        jsonResponse([\"token\": \"REG-SECRET-8\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n1332|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n1333|    ])\n1334|    let harness = await registrationHarness(\n1335|        transport: transport,\n1336|        downloader: fixtureDownloader(package.bytes),\n1337|        executor: SplitExecutor()\n1338|    )\n1339|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1340|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1341|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1342|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1343|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n1344|    let lists = await transport.requests.filter {\n1345|        $0.method == \"GET\" && ($0.url.path.contains(\"runner-groups\") || $0.url.path.hasSuffix(\"/actions/runners\"))\n1346|    }\n1347|    // Groups list, group repositories, runners pre-check, runners post-config.\n1348|    #expect(lists.count == 4)\n1349|    for request in lists {\n1350|        #expect(!request.url.absoluteString.contains(\"%3F\"))\n1351|        #expect(hasPerPageQuery(request.url))\n1352|    }\n1353|    #expect(lists.first?.url.path == \"/orgs/acme/actions/runner-groups\")\n1354|    #expect(lists.contains { $0.url.path == \"/orgs/acme/actions/runners\" })\n1355|}\n1356|\n1357|@Test func repoRunnerListRequestUsesQueryNotEncodedPath() async throws {\n1358|    // R2-F1 (repository scope): same query contract on the repo list route.\n1359|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1360|    let transport = TestTransport([\n1361|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1362|        runnersListPayload([]),\n1363|        jsonResponse([\"token\": \"REG-SECRET-9\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n1364|        runnersListPayload([[\"id\": 4242, \"name\": \"personal-runner\", \"labels\": []]]),\n1365|    ])\n1366|    let harness = await registrationHarness(\n1367|        transport: transport,\n1368|        downloader: fixtureDownloader(package.bytes),\n1369|        executor: SplitExecutor(gitHubURL: \"https://github.com/octo/app\")\n1370|    )\n1371|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1372|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(repoDraft()))\n1373|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1374|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n1375|    let lists = await transport.requests.filter {\n1376|        $0.method == \"GET\" && $0.url.path.hasSuffix(\"/actions/runners\")\n1377|    }\n1378|    #expect(lists.count == 2)\n1379|    for request in lists {\n1380|        #expect(request.url.path == \"/repos/octo/app/actions/runners\")\n1381|        #expect(!request.url.absoluteString.contains(\"%3F\"))\n1382|        #expect(hasPerPageQuery(request.url))\n1383|    }\n1384|}\n1385|\n1386|@Test func labelsWithoutLocalRegistrationAreRefused() async {\n1387|    // R2-F2 (repeat-of rev1/F5): a remote name match alone never authorizes\n1388|    // a label write. Refused before any network: no GET, no PUT.\n1389|    let transport = TestTransport([\n1390|        runnersListPayload([[\"id\": 77, \"name\": \"macbook-test\", \"labels\": []]]),\n1391|        jsonResponse([\"labels\": [[\"name\": \"gpu\"]]]),\n1392|    ])\n1393|    let harness = await registrationHarness(transport: transport)\n1394|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1395|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1396|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"]))\n1397|    #expect(lastFailure(harness.logger)?.step == \"applyLabels\")\n1398|    #expect(await transport.requests.isEmpty)\n1399|    #expect(!registrationActions(harness.logger).contains { if case .labelsApplied = $0 { true } else { false } })\n1400|}\n1401|\n1402|@Test func labelsWithMismatchedRemoteIdentityAreRefused() async throws {\n1403|    // R2-F2: this installation is agent 4242; a same-name foreign 77 in the\n1404|    // list must fail the write instead of becoming the PUT target.\n1405|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1406|    let transport = TestTransport([\n1407|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1408|        runnersListPayload([]),\n1409|        jsonResponse([\"token\": \"REG-SECRET-10\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n1410|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n1411|        runnersListPayload([[\"id\": 77, \"name\": \"macbook-test\", \"labels\": []]]),\n1412|        jsonResponse([\"labels\": [[\"name\": \"gpu\"]]]),\n1413|    ])\n1414|    let harness = await registrationHarness(\n1415|        transport: transport,\n1416|        downloader: fixtureDownloader(package.bytes),\n1417|        executor: SplitExecutor()\n1418|    )\n1419|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1420|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1421|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1422|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n1423|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"]))\n1424|    let failure = lastFailure(harness.logger)\n1425|    #expect(failure?.step == \"applyLabels\")\n1426|    #expect(failure?.message.contains(\"agent 77\") ?? false)\n1427|    let foreignWrites = await transport.requests.filter {\n1428|        $0.method == \"PUT\" && $0.url.path.contains(\"/77/labels\")\n1429|    }\n1430|    #expect(foreignWrites.isEmpty)\n1431|    #expect(await transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1432|}\n1433|\n1434|@Test func registerRefusesMismatchedRemoteIdentity() async throws {\n1435|    // R2-F2 at registration: config wrote agent 4242 but GitHub shows the\n1436|    // name as foreign agent 77. The run fails instead of adopting 77, and\n1437|    // the consumed token is still deleted.\n1438|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1439|    let transport = TestTransport([\n1440|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1441|        runnersListPayload([]),\n1442|        jsonResponse([\"token\": \"REG-SECRET-11\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n1443|        runnersListPayload([[\"id\": 77, \"name\": \"macbook-test\", \"labels\": []]]),\n1444|    ])\n1445|    let harness = await registrationHarness(\n1446|        transport: transport,\n1447|        downloader: fixtureDownloader(package.bytes),\n1448|        executor: SplitExecutor()\n1449|    )\n1450|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1451|    let draft = orgDraft()\n1452|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n1453|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1454|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n1455|    let failure = lastFailure(harness.logger)\n1456|    #expect(failure?.step == \"registerRunner\")\n1457|    #expect(failure?.message.contains(\"agent 77\") ?? false)\n1458|    #expect(!registrationActions(harness.logger).contains { if case .registered = $0 { true } else { false } })\n1459|    let scopeKey = RunnerRegistration.Flow.tokenScopeKey(draft: draft)\n1460|    #expect(await harness.registrationTokens.load(scopeKey: scopeKey) == nil)\n1461|}\n1462|\n1463|@Test func registerReportsNilWhenAgentNotYetListed() async throws {\n1464|    // Convergence case: config wrote agent 4242 but GitHub does not list it\n1465|    // yet. Registration succeeds with a nil remote ID (retryable) instead of\n1466|    // failing or guessing a same-name entry.\n1467|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1468|    let transport = TestTransport([\n1469|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1470|        runnersListPayload([]),\n1471|        jsonResponse([\"token\": \"REG-SECRET-12\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n1472|        runnersListPayload([[\"id\": 77, \"name\": \"other-runner\", \"labels\": []]]),\n1473|    ])\n1474|    let harness = await registrationHarness(\n1475|        transport: transport,\n1476|        downloader: fixtureDownloader(package.bytes),\n1477|        executor: SplitExecutor()\n1478|    )\n1479|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1480|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1481|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1482|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n1483|    let registered = registrationActions(harness.logger).compactMap { action -> (Int64?, Int64?)? in\n1484|        if case .registered(let runnerID, let localID) = action { (runnerID, localID) } else { nil }\n1485|    }\n1486|    #expect(registered.count == 1)\n1487|    #expect(registered.first?.0 == nil)\n1488|    #expect(registered.first?.1 == 4242)\n1489|    #expect(registrationActions(harness.logger).contains {\n1490|        if case .stepFinished(let step) = $0, step == \"registerRunner\" { true } else { false }\n1491|    })\n1492|}\n1493|\n1494|@Test func labelsRefusePlantedUnconfiguredRegistration() async throws {\n1495|    // R2-F2: a matching `.runner` planted without this wizard's configured\n1496|    // marker is not this operation's registration. Refused without a PUT.\n1497|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1498|    let transport = TestTransport([\n1499|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1500|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n1501|        jsonResponse([\"labels\": [[\"name\": \"gpu\"]]]),\n1502|    ])\n1503|    let harness = await registrationHarness(\n1504|        transport: transport,\n1505|        downloader: fixtureDownloader(package.bytes),\n1506|        executor: SplitExecutor()\n1507|    )\n1508|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1509|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1510|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1511|    let directory = await harness.installer.directory(for: \"macbook-test\")\n1512|    try Data(#\"{\"agentId\":4242,\"agentName\":\"macbook-test\",\"gitHubUrl\":\"https://github.com/acme\",\"workFolder\":\"_work\"}\"#.utf8)\n1513|        .write(to: directory.appendingPathComponent(\".runner\"))\n1514|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"]))\n1515|    let failure = lastFailure(harness.logger)\n1516|    #expect(failure?.step == \"applyLabels\")\n1517|    #expect(failure?.message.contains(\"never configured\") ?? false)\n1518|    #expect(await transport