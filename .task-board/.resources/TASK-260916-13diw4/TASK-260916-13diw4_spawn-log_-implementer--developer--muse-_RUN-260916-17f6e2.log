{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c64f","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":386,"recorded_at":1780531400000767,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8b3-8dbe-7e33-be7a-1fa19df16e5a"},"task_id":"01a0a8b3-8dbe-7e33-be7a-1fa19df16e5a","event":{"kind":"output","task_id":"01a0a8b3-8dbe-7e33-be7a-1fa19df16e5a","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+State+Reducer.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension RunnerRegistration.State {\n5|    public func reduce(with action: any Relux.Action) async {\n6|        guard let action = action as? RunnerRegistration.Action else { return }\n7|        if reduceDraftAction(action) { return }\n8|        if reduceProgressAction(action) { return }\n9|        await reduceResultAction(action)\n10|    }\n11|\n12|    /// Draft lifecycle actions. Returns true when the action was handled.\n13|    private func reduceDraftAction(_ action: RunnerRegistration.Action) -> Bool {\n14|        switch action {\n15|        case .draftBegan(let draft):\n16|            self.draft = draft\n17|            phase = .drafting\n18|            error = nil\n19|            failedStep = nil\n20|        case .draftUpdated(let draft):\n21|            if let old = self.draft {\n22|                invalidateProgress(old: old, new: draft)\n23|            }\n24|            self.draft = draft\n25|            // Draft edits retain the permission error by design.\n26|            if error != nil, permissionError == nil {\n27|                error = nil\n28|                failedStep = nil\n29|            }\n30|        case .cancelled:\n31|            working = false\n32|            error = nil\n33|            failedStep = nil\n34|        default:\n35|            return false\n36|        }\n37|        return true\n38|    }\n39|\n40|    /// Invalidates cached progress bound to the changed identity fields, so a\n41|    /// scope/install/name/group edit never displays another registration's\n42|    /// evidence as this draft's. Mirrors the Flow's invalidation.\n43|    private func invalidateProgress(old: RunnerRegistration.Draft, new: RunnerRegistration.Draft) {\n44|        if old.scope != new.scope {\n45|            group = nil\n46|            groupRepositoryIDs = []\n47|            asset = nil\n48|            installPath = nil\n49|            runnerID = nil\n50|            localAgentID = nil\n51|            completedSteps = []\n52|            failedStep = nil\n53|            if phase == .done { phase = .drafting }\n54|            return\n55|        }\n56|        if old.installDirName != new.installDirName {\n57|            installPath = nil\n58|            runnerID = nil\n59|            localAgentID = nil\n60|            completedSteps.subtract([\"downloadAndInstall\", \"registerRunner\", \"setupService\", \"applyLabels\"])\n61|            if [\"downloadAndInstall\", \"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n62|                failedStep = nil\n63|            }\n64|            if phase == .done { phase = .drafting }\n65|        }\n66|        let oldName = old.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n67|        let newName = new.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n68|        if oldName != newName {\n69|            runnerID = nil\n70|            localAgentID = nil\n71|            completedSteps.subtract([\"registerRunner\", \"setupService\", \"applyLabels\"])\n72|            if [\"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n73|                failedStep = nil\n74|            }\n75|            if phase == .done { phase = .drafting }\n76|        }\n77|        if case .organization = old.scope {\n78|            let oldGroup = old.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n79|            let newGroup = new.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n80|            if oldGroup != newGroup {\n81|                group = nil\n82|                groupRepositoryIDs = []\n83|                completedSteps.subtract([\"resolveGroup\", \"applyRepositoryAccess\"])\n84|                if [\"resolveGroup\", \"applyRepositoryAccess\"].contains(failedStep ?? \"\") {\n85|                    failedStep = nil\n86|                }\n87|            }\n88|        }\n89|        if old.workFolder != new.workFolder {\n90|            runnerID = nil\n91|            localAgentID = nil\n92|            completedSteps.subtract([\"registerRunner\", \"applyLabels\"])\n93|            if [\"registerRunner\", \"applyLabels\"].contains(failedStep ?? \"\") {\n94|                failedStep = nil\n95|            }\n96|            if phase == .done { phase = .drafting }\n97|        }\n98|    }\n99|\n100|    /// Step progress actions. Returns true when the action was handled.\n101|    private func reduceProgressAction(_ action: RunnerRegistration.Action) -> Bool {\n102|        switch action {\n103|        case .stepStarted(let step):\n104|            working = true\n105|            error = nil\n106|            failedStep = nil\n107|            reducePhase(step)\n108|        case .stepFinished(let step):\n109|            working = false\n110|            completedSteps.insert(step)\n111|        case .permissionDismissed:\n112|            permissionError = nil\n113|        default:\n114|            return false\n115|        }\n116|        return true\n117|    }\n118|\n119|    private func reducePhase(_ step: String) {\n120|        switch step {\n121|        case \"resolveGroup\": phase = .resolvingGroup\n122|        case \"prepareDownload\": phase = .preparingDownload\n123|        case \"downloadAndInstall\": phase = .installing\n124|        case \"registerRunner\": phase = .registering\n125|        case \"setupService\": phase = .settingUpService\n126|        default: break\n127|        }\n128|    }\n129|\n130|    /// Fetched results, failures, and reset.\n131|    private func reduceResultAction(_ action: RunnerRegistration.Action) async {\n132|        if reduceFetchResult(action) { return }\n133|        switch action {\n134|        case .failed(let message, let step):\n135|            working = false\n136|            error = message\n137|            failedStep = step\n138|        case .permissionDenied(let message, let step):\n139|            working = false\n140|            error = message\n141|            failedStep = step\n142|            permissionError = message\n143|        case .didReset:\n144|            await cleanup()\n145|        default:\n146|            break\n147|        }\n148|    }\n149|\n150|    /// Fetched values applied to state. Returns true when handled.\n151|    private func reduceFetchResult(_ action: RunnerRegistration.Action) -> Bool {\n152|        switch action {\n153|        case .groupResolved(let group, let repositoryIDs):\n154|            self.group = group\n155|            groupRepositoryIDs = repositoryIDs\n156|        case .downloadReady(let asset):\n157|            self.asset = asset\n158|        case .installed(let path):\n159|            installPath = path\n160|        case .registered(let runnerID, let localAgentID):\n161|            self.runnerID = runnerID\n162|            self.localAgentID = localAgentID\n163|        case .serviceReady:\n164|            phase = .done\n165|        case .repositoryAccessApplied(let ids):\n166|            groupRepositoryIDs = ids\n167|            syncDraftRepositories(ids)\n168|        case .labelsApplied(let labels):\n169|            syncDraftLabels(labels)\n170|        default:\n171|            return false\n172|        }\n173|        return true\n174|    }\n175|\n176|    private func syncDraftRepositories(_ ids: [Int64]) {\n177|        if var current = draft {\n178|            current.selectedRepositoryIDs = Set(ids)\n179|            draft = current\n180|        }\n181|    }\n182|\n183|    private func syncDraftLabels(_ labels: [String]) {\n184|        if var current = draft {\n185|            current.labels = labels\n186|            draft = current\n187|        }\n188|    }\n189|}","final_result":true}}}
