irectory.path\n+            await action { RunnerRegistration.Action.installed(path: directory.path) }\n+            await finishStep(\"downloadAndInstall\", generation: gen)\n+        } catch {\n+            working = false\n+            await fail(error, step: \"downloadAndInstall\", generation: gen)\n+        }\n+    }\n","final_result":true}}}
