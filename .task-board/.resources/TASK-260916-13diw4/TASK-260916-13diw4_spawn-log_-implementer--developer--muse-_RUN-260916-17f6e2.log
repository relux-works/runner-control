ity, alignment: .leading)\n89|        }\n90|        .frame(width: 640, height: 560)\n91|    }\n92|\n93|    private var header: some View {\n94|        VStack(alignment: .leading, spacing: 3) {\n95|            Text(\"Новый раннер на этом Mac\").font(.system(size: 15, weight: .semibold))\n96|            Text(\"Официальная сборка GitHub под вашу архитектуру, регистрация без терминала.\")\n97|                .font(.callout).foregroundStyle(.secondary)\n98|        }\n99|    }\n100|\n101|    private var githubRequired: some View {\n102|        HStack(alignment: .top, spacing: 8) {\n103|            Image(systemName: \"person.crop.circle.badge.exclamationmark\").foregroundStyle(.orange)\n104|            VStack(alignment: .leading, spacing: 2) {\n105|                Text(\"Войдите через GitHub во вкладке «GitHub», затем вернитесь сюда.\")\n106|                Text(\"Регистрация требует подтверждённой сессии.\")\n107|            }\n108|            .font(.callout)\n109|        }\n110|        .padding(10)\n111|        .background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n112|    }\n113|\n114|    private var footer: some View {\n115|        HStack(spacing: 8) {\n116|            if props.working {\n117|                Button(\"Отмена\", action: reactions.cancel)\n118|                    .buttonStyle(.bordered)\n119|                    .accessibilityIdentifier(\"Registration cancel button\")\n120|            } else if props.phase != .idle {\n121|                Button(\"Сбросить\", action: reactions.reset)\n122|                    .buttonStyle(.plain).foregroundStyle(.secondary)\n123|                    .accessibilityIdentifier(\"Registration reset button\")\n124|            }\n125|            Spacer()\n126|            Button(\"Закрыть\", action: reactions.close)\n127|                .buttonStyle(.bordered)\n128|                .accessibilityIdentifier(\"Registration close button\")\n129|        }\n130|    }\n131|}\n132|\n133|/// Wizard input form: scope, runner identity, and group access.\n134|private struct WizardForm: View {\n135|    typealias Props = RunnerRegistrationPage.Props\n136|    typealias Reactions = RunnerRegistrationPage.Reactions\n137|    typealias ScopeKind = RunnerRegistrationPage.ScopeKind\n138|\n139|    let props: Props\n140|    let reactions: Reactions\n141|\n142|    var body: some View {\n143|        VStack(alignment: .leading, spacing: 16) {\n144|            scopeSection\n145|            runnerSection\n146|            if props.scopeKind == .organization {\n147|                groupSection\n148|            }\n149|        }\n150|    }\n151|\n152|    private var scopeSection: some View {\n153|        VStack(alignment: .leading, spacing: 8) {\n154|            Text(\"Область регистрации\").font(.system(size: 13, weight: .semibold))\n155|            Picker(\"Область\", selection: Binding(\n156|                get: { props.scopeKind },\n157|                set: reactions.scopeKindChanged\n158|            )) {\n159|                Text(\"Организация\").tag(ScopeKind.organization)\n160|                Text(\"Репозиторий\").tag(ScopeKind.repository)\n161|            }\n162|            .pickerStyle(.segmented)\n163|            .frame(width: 320)\n164|            .accessibilityIdentifier(\"Registration scope picker\")\n165|            if props.scopeKind == .organization {\n166|                labeledField(\n167|                    \"Организация\", text: props.org, set: reactions.orgChanged,\n168|                    placeholder: \"acme\", id: \"Registration org field\"\n169|                )\n170|            } else {\n171|                HStack(spacing: 8) {\n172|                    labeledField(\n173|                        \"Владелец\", text: props.repoOwner, set: reactions.repoOwnerChanged,\n174|                        placeholder: \"octo\", id: \"Registration repo owner field\"\n175|                    )\n176|                    labeledField(\n177|                        \"Репозиторий\", text: props.repoName, set: reactions.repoNameChanged,\n178|                        placeholder: \"app\", id: \"Registration repo name field\"\n179|                    )\n180|                }\n181|                Text(\"Личные репозитории получают отдельную установку без общих групп.\")\n182|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n183|            }\n184|        }\n185|    }\n186|\n187|    private var runnerSection: some View {\n188|        VStack(alignment: .leading, spacing: 8) {\n189|            Text(\"Раннер\").font(.system(size: 13, weight: .semibold))\n190|            labeledField(\n191|                \"Имя раннера\", text: props.runnerName, set: reactions.runnerNameChanged,\n192|                placeholder: Host.current().localizedName ?? \"macbook\",\n193|                id: \"Registration runner name field\"\n194|            )\n195|            labeledField(\n196|                \"Метки (через запятую)\", text: props.labelsText, set: reactions.labelsChanged,\n197|                placeholder: \"self-hosted, macOS\", id: \"Registration labels field\"\n198|            )\n199|            HStack(spacing: 8) {\n200|                labeledField(\n201|                    \"Папка установки\", text: props.installDirName, set: reactions.installDirChanged,\n202|                    placeholder: \"macbook-iv\", id: \"Registration install dir field\"\n203|                )\n204|                labeledField(\n205|                    \"Рабочая папка\", text: props.workFolder, set: reactions.workFolderChanged,\n206|                    placeholder: \"_work\", id: \"Registration work folder field\"\n207|                )\n208|            }\n209|            VStack(alignment: .leading, spacing: 2) {\n210|                Text(\"Пути без пробелов: ~/Library/GitHubActions/<папка>.\")\n211|                Text(\"Повторный запуск продолжает с места остановки и не создаёт дубликатов.\")\n212|            }\n213|            .font(.system(size: 11)).foregroundStyle(.secondary)\n214|            Toggle(\n215|                \"Заменить регистрацию GitHub с таким же именем (опасно для других Mac)\",\n216|                isOn: Binding(get: { props.allowReplace }, set: reactions.allowReplaceChanged)\n217|            )\n218|            .font(.callout)\n219|            .accessibilityIdentifier(\"Registration allow replace toggle\")\n220|        }\n221|    }\n222|\n223|    private var groupSection: some View {\n224|        VStack(alignment: .leading, spacing: 8) {\n225|            Text(\"Группа и доступ к репозиториям\").font(.system(size: 13, weight: .semibold))\n226|            labeledField(\n227|                \"Группа этого Mac\", text: props.groupName, set: reactions.groupNameChanged,\n228|                placeholder: \"RunnerControl-Mac\", id: \"Registration group name field\"\n229|            )\n230|            if let group = props.group {\n231|                VStack(alignment: .leading, spacing: 2) {\n232|                    Text(\"Группа: \\(group.name) · id \\(group.id) · \\(group.visibility).\")\n233|                    Text(\"Доступ: \\(props.groupRepositoryIDs.count) репозиториев · публичные: \\(group.allowsPublicRepositories ? \"да\" : \"нет\").\")\n234|                }\n235|                .font(.callout).foregroundStyle(.secondary)\n236|            } else {\n237|                Text(\"Группа создаётся только для этого Mac. Чужие и общие группы приложение не изменяет.\")\n238|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n239|            }\n240|            Toggle(\n241|                \"Разрешаю изменять доступ только для указанной группы этого Mac\",\n242|                isOn: Binding(get: { props.allowGroupMutation }, set: reactions.allowGroupMutationChanged)\n243|            )\n244|            .font(.callout)\n245|            .accessibilityIdentifier(\"Registration allow group mutation toggle\")\n246|            Toggle(\n247|                \"Группа с таким именем уже существует, и это группа этого Mac (перенять)\",\n248|                isOn: Binding(get: { props.allowGroupTakeover }, set: reactions.allowGroupTakeoverChanged)\n249|            )\n250|            .font(.callout)\n251|            .accessibilityIdentifier(\"Registration allow group takeover toggle\")\n252|            if props.repositories.isEmpty {\n253|                Text(\"Репозитории выбранной установки появятся здесь после входа.\")\n254|                    .font(.callout).foregroundStyle(.secondary)\n255|            } else {\n256|                VStack(alignment: .leading, spacing: 6) {\n257|                    ForEach(props.repositories) { repo in\n258|                        Toggle(\n259|                            repo.fullName,\n260|                            isOn: Binding(\n261|                                get: { props.selectedRepositoryIDs.contains(repo.id) },\n262|                                set: { enabled in\n263|                                    var next = props.selectedRepositoryIDs\n264|                                    if enabled { next.insert(repo.id) } else { next.remove(repo.id) }\n265|                                    reactions.repositoriesChanged(next)\n266|                                }\n267|                            )\n268|                        )\n269|                        .font(.callout)\n270|                    }\n271|                }\n272|                if props.group != nil {\n273|                    Button(\"Применить доступ к репозиториям\", action: reactions.applyRepositoryAccess)\n274|                        .buttonStyle(.bordered)\n275|                        .disabled(props.working || !props.allowGroupMutation)\n276|                        .accessibilityIdentifier(\"Registration apply repo access button\")\n277|                }\n278|            }\n279|        }\n280|    }\n281|\n282|    private func labeledField(\n283|        _ title: String, text: String, set: @escaping (String) -> Void,\n284|        placeholder: String, id: String\n285|    ) -> some View {\n286|        VStack(alignment: .leading, spacing: 4) {\n287|            Text(title).font(.system(size: 11)).foregroundStyle(.secondary)\n288|            TextField(placeholder, text: Binding(get: { text }, set: set))\n289|                .textFieldStyle(.roundedBorder)\n290|                .accessibilityIdentifier(id)\n291|        }\n292|    }\n293|}\n294|\n295|/// Wizard step buttons with per-step completion state.\n296|private struct WizardSteps: View {\n297|    typealias Props = RunnerRegistrationPage.Props\n298|    typealias Reactions = RunnerRegistrationPage.Reactions\n299|\n300|    let props: Props\n301|    let reactions: Reactions\n302|\n303|    var body: some View {\n304|        VStack(alignment: .leading, spacing: 8) {\n305|            Text(\"Шаги\").font(.system(size: 13, weight: .semibold))\n306|            stepRow(\n307|                title: \"Черновик\", done: props.phase != .idle,\n308|                action: reactions.beginDraft, button: \"Начать\",\n309|                id: \"Registration begin button\"\n310|            )\n311|            if props.scopeKind == .organization {\n312|                stepRow(\n313|                    title: \"Группа этого Mac\",\n314|                    done: props.completedSteps.contains(\"resolveGroup\"),\n315|                    action: reactions.resolveGroup, button: \"Найти или создать\",\n316|                    id: \"Registration resolve group button\"\n317|                )\n318|            }\n319|            stepRow(\n320|                title: \"Загрузка и проверка сборки\",\n321|                done: props.completedSteps.contains(\"downloadAndInstall\"),\n322|                action: reactions.downloadAndInstall, button: \"Загрузить и установить\",\n323|                id: \"Registration install button\",\n324|                detail: props.assetFilename ?? props.installPath\n325|            )\n326|            stepRow(\n327|                title: \"Регистрация\",\n328|                done: props.completedSteps.contains(\"registerRunner\"),\n329|                action: reactions.registerRunner, button: \"Зарегистрировать\",\n330|                id: \"Registration register button\",\n331|                detail: props.runnerID.map { \"id \\($0)\" }\n332|            )\n333|            stepRow(\n334|                title: \"Служба (автозапуск выключен)\",\n335|                done: props.completedSteps.contains(\"setupService\"),\n336|                action: reactions.setupService, button: \"Настроить службу\",\n337|                id: \"Registration setup service button\",\n338|                detail: props.completedSteps.contains(\"registerRunner\") ? nil : \"Сначала зарегистрируйте раннер\",\n339|                enabled: props.completedSteps.contains(\"registerRunner\")\n340|            )\n341|            HStack(spacing: 8) {\n342|                Button(\"Метки: применить текущие\", action: reactions.applyLabels)\n343|                    .buttonStyle(.bordered).controlSize(.small)\n344|                    .disabled(props.working || props.runnerID == nil)\n345|                    .accessibilityIdentifier(\"Registration apply labels button\")\n346|                if props.failedStep != nil {\n347|                    Button(\"Повторить шаг\", action: reactions.retry)\n348|                        .buttonStyle(.borderedProminent).tint(.teal).controlSize(.small)\n349|                        .disabled(props.working)\n350|                        .accessibilityIdentifier(\"Registration retry button\")\n351|                }\n352|                if props.working {\n353|                    ProgressView().controlSize(.small)\n354|                }\n355|            }\n356|        }\n357|    }\n358|\n359|    private func stepRow(\n360|        title: String, done: Bool, action: @escaping () -> Void,\n361|        button: String, id: String, detail: String? = nil, enabled: Bool = true\n362|    ) -> some View {\n363|        HStack(spacing: 8) {\n364|            Image(systemName: done ? \"checkmark.circle.fill\" : \"circle\")\n365|                .foregroundStyle(done ? .green : .secondary)\n366|            VStack(alignment: .leading, spacing: 2) {\n367|                Text(title).font(.callout)\n368|                if let detail {\n369|                    Text(detail).font(.system(size: 11)).foregroundStyle(.secondary).lineLimit(2)\n370|                }\n371|            }\n372|            Spacer()\n373|            Button(button, action: action)\n374|                .buttonStyle(.bordered).controlSize(.small)\n375|                .disabled(props.working || !props.githubConnected || !enabled)\n376|                .accessibilityIdentifier(id)\n377|        }\n378|    }\n379|}\n380|\n381|/// Wizard outcome: retained permission errors, step errors, and completion.\n382|private struct WizardStatus: View {\n383|    typealias Props = RunnerRegistrationPage.Props\n384|    typealias Reactions = RunnerRegistrationPage.Reactions\n385|\n386|    let props: Props\n387|    let reactions: Reactions\n388|\n389|    var body: some View {\n390|        VStack(alignment: .leading, spacing: 16) {\n391|            if let permission = props.permissionError {\n392|                permissionView(permission)\n393|            } else if let error = props.error {\n394|                errorView(error)\n395|            }\n396|            if props.phase == .done {\n397|                doneView\n398|            }\n399|        }\n400|    }\n401|\n402|    private func permissionView(_ message: String) -> some View {\n403|        VStack(alignment: .leading, spacing: 8) {\n404|            HStack(alignment: .top, spacing: 8) {\n405|                Image(systemName: \"lock.triangle.fill\").foregroundStyle(.red)\n406|                Text(message).font(.callout).textSelection(.enabled)\n407|                Spacer(minLength: 0)\n408|            }\n409|            HStack(spacing: 8) {\n410|                Button(\"Повторить шаг\", action: reactions.retry)\n411|                    .buttonStyle(.borderedProminent).tint(.teal).controlSize(.small)\n412|                    .disabled(props.working)\n413|                Button(\"Скрыть\", action: reactions.dismissPermission)\n414|                    .buttonStyle(.plain).font(.callout).foregroundStyle(.secondary)\n415|            }\n416|            Text(\"Ошибка прав сохранена и не стирается правками черновика.\")\n417|                .font(.system(size: 11)).foregroundStyle(.secondary)\n418|        }\n419|        .padding(10)\n420|        .background(.red.opacity(0.07), in: RoundedRectangle(cornerRadius: 10))\n421|    }\n422|\n423|    private func errorView(_ message: String) -> some View {\n424|        HStack(alignment: .top, spacing: 8) {\n425|            Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n426|            Text(message).font(.caption).textSelection(.enabled).lineLimit(6)\n427|            Spacer(minLength: 0)\n428|        }\n429|        .padding(10)\n430|        .background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n431|    }\n432|\n433|    private var doneView: some View {\n434|        VStack(alignment: .leading, spacing: 6) {\n435|            HStack(spacing: 8) {\n436|                Image(systemName: \"checkmark.seal.fill\").foregroundStyle(.green)\n437|                Text(\"Раннер зарегистрирован\").font(.callout.weight(.medium))\n438|            }\n439|            if let path = props.installPath {\n440|                Text(path).font(.system(size: 11)).foregroundStyle(.secondary).textSelection(.enabled)\n441|            }\n442|            Text(\"Включите его во вкладке «Раннеры», когда будете готовы. Токен регистрации уже удалён.\")\n443|                .font(.system(size: 11)).foregroundStyle(.secondary)\n444|        }\n445|        .padding(10)\n446|        .background(.green.opacity(0.07), in: RoundedRectangle(cornerRadius: 10))\n447|    }\n448|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
