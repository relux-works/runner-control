{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bb","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":312,"recorded_at":1780531400000619,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"call_id":"call_01a0a8b370527459b49456aa5078c3a9","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension RunnerRegistration {\n5|    public protocol IFlow: Relux.Flow {}\n6|\n7|    public actor Flow {\n8|        public let dispatcher: Relux.Dispatcher\n9|        private let api: GitHubRunnerAPIClient\n10|        private let installer: RunnerInstallerService\n11|        private let registrationTokens: any RunnerRegistrationTokenStoring\n12|        private let userStore: any GitHubCredentialStoring\n13|        private let identities: any GitHubSessionIdentityStoring\n14|        private let refresher: GitHubTokenRefresh\n15|        private let configProvider: @Sendable (String?) throws -> GitHubAuth.AppConfig\n16|        private let now: @Sendable () -> Date\n17|\n18|        private var generation = 0\n19|        private var working = false\n20|        private var draft: Draft?\n21|        private var group: RunnerGroup?\n22|        private var asset: DownloadAsset?\n23|        private var installPath: String?\n24|        private var runnerID: Int64?\n25|        private var failedStep: String?\n26|        private var pendingRepositoryIDs: Set<Int64>?\n27|        private var pendingTargetGroupID: Int64?\n28|        private var pendingLabels: [String]?\n29|\n30|        public init(\n31|            api: GitHubRunnerAPIClient,\n32|            installer: RunnerInstallerService,\n33|            registrationTokens: any RunnerRegistrationTokenStoring,\n34|            userStore: any GitHubCredentialStoring,\n35|            identityStore: any GitHubSessionIdentityStoring,\n36|            refresher: GitHubTokenRefresh,\n37|            configProvider: (@Sendable (String?) throws -> GitHubAuth.AppConfig)? = nil,\n38|            now: (@Sendable () -> Date)? = nil,\n39|            dispatcher: Relux.Dispatcher? = nil\n40|        ) async {\n41|            self.api = api\n42|            self.installer = installer\n43|            self.registrationTokens = registrationTokens\n44|            self.userStore = userStore\n45|            self.identities = identityStore\n46|            self.refresher = refresher\n47|            self.configProvider = configProvider ?? { host in\n48|                try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\")\n49|            }\n50|            self.now = now ?? Date.init\n51|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n52|        }\n53|\n54|        /// Deterministic LaunchAgent label for a draft. Always carries the\n55|        /// `actions.runner.` prefix discovery requires.\n56|        public nonisolated static func serviceLabel(draft: Draft) -> String {\n57|            let scope = draft.scope.detail.replacingOccurrences(of: \"/\", with: \"-\")\n58|            let raw = \"actions.runner.\\(scope).\\(draft.installDirName)\"\n59|            let allowed = CharacterSet.alphanumerics.union(CharacterSet(charactersIn: \".-\"))\n60|            return raw.unicodeScalars.map { allowed.contains($0) ? String($0) : \"-\" }.joined()\n61|        }\n62|\n63|        public nonisolated static func tokenScopeKey(draft: Draft) -> String {\n64|            \"\\(draft.scope.scopeKey):\\(draft.installDirName)\"\n65|        }\n66|    }\n67|}\n68|\n69|/// Authenticated user token for wizard API calls. Never logged.\n70|private struct FlowUserToken: Sendable {\n71|    let config: GitHubAuth.AppConfig\n72|    let token: String\n73|    let identity: GitHubSessionIdentity\n74|}\n75|\n76|extension RunnerRegistration.Flow: RunnerRegistration.IFlow {\n77|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n78|        guard let effect = effect as? RunnerRegistration.Effect else { return .success }\n79|        switch effect {\n80|        case .beginDraft(let draft): await beginDraft(draft)\n81|        case .updateDraft(let draft): await updateDraft(draft)\n82|        case .resolveGroup: await resolveGroup()\n83|        case .prepareDownload: await prepareDownload()\n84|        case .downloadAndInstall: await downloadAndInstall()\n85|        case .registerRunner: await registerRunner()\n86|        case .setupService: await setupService()\n87|        case .applyRepositoryAccess(let groupID, let ids): await applyRepositoryAccess(groupID: groupID, ids: ids)\n88|        case .applyLabels(let labels): await applyLabels(labels)\n89|        case .retry: await retry()\n90|        case .cancel: await cancel()\n91|        case .reset: await reset()\n92|        case .dismissPermission: await action { RunnerRegistration.Action.permissionDismissed }\n93|        }\n94|        return .success\n95|    }\n96|\n97|    private func isStale(_ gen: Int) -> Bool { generation != gen }\n98|\n99|    // MARK: - Draft\n100|\n101|    private func beginDraft(_ draft: RunnerRegistration.Draft) async {\n102|        do {\n103|            try RunnerRegistration.Gates.validateDraft(draft)\n104|        } catch {\n105|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"beginDraft\") }\n106|            return\n107|        }\n108|        self.draft = draft\n109|        group = nil\n110|        asset = nil\n111|        installPath = nil\n112|        runnerID = nil\n113|        failedStep = nil\n114|        await action { RunnerRegistration.Action.draftBegan(draft) }\n115|    }\n116|\n117|    private func updateDraft(_ draft: RunnerRegistration.Draft) async {\n118|        do {\n119|            try RunnerRegistration.Gates.validateDraft(draft)\n120|        } catch {\n121|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"updateDraft\") }\n122|            return\n123|        }\n124|        if let old = self.draft {\n125|            invalidateProgress(old: old, new: draft)\n126|        }\n127|        self.draft = draft\n128|        await action { RunnerRegistration.Action.draftUpdated(draft) }\n129|    }\n130|\n131|    /// Invalidates cached success-progress bound to the changed identity\n132|    /// fields. Scope/install/name/group edits never reuse another\n133|    /// registration's evidence; editable selections re-target pending retries\n134|    /// to the visible values instead. Mirrors the reducer's invalidation.\n135|    private func invalidateProgress(old: RunnerRegistration.Draft, new: RunnerRegistration.Draft) {\n136|        if old.scope != new.scope {\n137|            group = nil\n138|            asset = nil\n139|            installPath = nil\n140|            runnerID = nil\n141|            pendingRepositoryIDs = nil\n142|            pendingTargetGroupID = nil\n143|            pendingLabels = nil\n144|            failedStep = nil\n145|            return\n146|        }\n147|        if old.installDirName != new.installDirName {\n148|            installPath = nil\n149|            runnerID = nil\n150|            pendingLabels = nil\n151|            if [\"downloadAndInstall\", \"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n152|                failedStep = nil\n153|            }\n154|        }\n155|        let oldName = old.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n156|        let newName = new.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n157|        if oldName != newName {\n158|            runnerID = nil\n159|            pendingLabels = nil\n160|            if [\"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n161|                failedStep = nil\n162|            }\n163|        }\n164|        if case .organization = old.scope {\n165|            let oldGroup = old.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n166|            let newGroup = new.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n167|            if oldGroup != newGroup {\n168|                group = nil\n169|                pendingRepositoryIDs = nil\n170|                pendingTargetGroupID = nil\n171|                if [\"resolveGroup\", \"applyRepositoryAccess\"].contains(failedStep ?? \"\") {\n172|                    failedStep = nil\n173|                }\n174|            }\n175|        }\n176|        if old.workFolder != new.workFolder {\n177|            runnerID = nil\n178|            pendingLabels = nil\n179|            if [\"registerRunner\", \"applyLabels\"].contains(failedStep ?? \"\") {\n180|                failedStep = nil\n181|            }\n182|        }\n183|        // Editable selections stay live: a retry after an edit applies the\n184|        // visible values, never the stale attempt's.\n185|        if old.labels != new.labels, !new.labels.isEmpty {\n186|            pendingLabels = new.labels\n187|        }\n188|        if old.selectedRepositoryIDs != new.selectedRepositoryIDs {\n189|            pendingRepositoryIDs = new.selectedRepositoryIDs\n190|        }\n191|    }\n192|\n193|    // MARK: - Auth\n194|\n195|    private func currentUserToken(generation gen: Int) async throws -> FlowUserToken {\n196|        guard let identity = await identities.load() else {\n197|            throw RunnerRegistration.RegistrationError.notAuthenticated\n198|        }\n199|        let config = try configProvider(identity.serverHost)\n200|        guard var record = await userStore.load(\n201|            serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID\n202|        ) else {\n203|            throw RunnerRegistration.RegistrationError.notAuthenticated\n204|        }\n205|        guard !isStale(gen) else { throw CancellationError() }\n206|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n207|            do {\n208|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n209|            } catch is CancellationError {\n210|                throw CancellationError()\n211|            } catch let error as GitHubAuth.AuthError {\n212|                switch error {\n213|                case .revoked, .unauthorized, .tokenRefreshFailed:\n214|                    throw RunnerRegistration.RegistrationError.unauthorized\n215|                default:\n216|                    break\n217|                }\n218|            }\n219|            guard !isStale(gen) else { throw CancellationError() }\n220|        }\n221|        return FlowUserToken(config: config, token: record.accessToken, identity: identity)\n222|    }\n223|\n224|    private func fail(_ error: Error, step: String, generation gen: Int) async {\n225|        guard !isStale(gen) else { return }\n226|        failedStep = step\n227|        if error is CancellationError { return }\n228|        if let reg = error as? RunnerRegistration.RegistrationError {\n229|            switch reg {\n230|            case .missingPermission, .forbidden:\n231|                await action {\n232|                    RunnerRegistration.Action.permissionDenied(message: reg.localizedDescription, step: step)\n233|                }\n234|                return\n235|            default:\n236|                break\n237|            }\n238|        }\n239|        let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n240|        await action { RunnerRegistration.Action.failed(message: message, step: step) }\n241|    }\n242|\n243|    private func finishStep(_ step: String, generation gen: Int) async {\n244|        guard !isStale(gen) else { return }\n245|        failedStep = nil\n246|        working = false\n247|        await action { RunnerRegistration.Action.stepFinished(step) }\n248|    }\n249|\n250|    // MARK: - Group\n251|\n252|    private func resolveGroup() async {\n253|        let gen = generation\n254|        guard !working else { return }\n255|        guard let draft else {\n256|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"resolveGroup\") }\n257|            return\n258|        }\n259|        do {\n260|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n261|        } catch {\n262|            failedStep = \"resolveGroup\"\n263|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"resolveGroup\") }\n264|            return\n265|        }\n266|        guard case .organization(let org) = draft.scope else { return }\n267|        working = true\n268|        await action { RunnerRegistration.Action.stepStarted(\"resolveGroup\") }\n269|        do {\n270|            let auth = try await currentUserToken(generation: gen)\n271|            guard !isStale(gen) else { return }\n272|            let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n273|            guard !isStale(gen) else { return }\n274|            let name = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n275|            let resolved: RunnerRegistration.RunnerGroup\n276|            if let existing = groups.first(where: { $0.name == name }) {\n277|                // Name alone never authorizes adoption: require a locally\n278|                // recorded ownership entry or explicit takeover confirmation.\n279|                let owned = await installer.loadOwnedGroupID(org: org, name: name)\n280|                try RunnerRegistration.Gates.authorizeGroupTakeover(\n281|                    groupName: name, existingID: existing.id,\n282|                    ownedID: owned, allowTakeover: draft.allowGroupTakeover\n283|                )\n284|                if owned != existing.id {\n285|                    try await installer.saveOwnedGroupID(org: org, name: name, groupID: existing.id)\n286|                }\n287|                guard !isStale(gen) else { return }\n288|                // A pre-existing group may deny public repos (GitHub default\n289|                // false), which would silently drop selected public repos.\n290|                if existing.allowsPublicRepositories {\n291|                    resolved = existing\n292|                } else {\n293|                    resolved = try await api.updateGroupAllowsPublic(\n294|                        config: auth.config, token: auth.token, org: org,\n295|                        groupID: existing.id, allowsPublic: true\n296|                    )\n297|                }\n298|            } else {\n299|                resolved = try await api.createGroup(\n300|                    config: auth.config, token: auth.token, org: org,\n301|                    name: name, selectedRepositoryIDs: draft.selectedRepositoryIDs,\n302|                    allowsPublicRepositories: true\n303|                )\n304|                guard !isStale(gen) else { return }\n305|                try await installer.saveOwnedGroupID(org: org, name: name, groupID: resolved.id)\n306|            }\n307|            guard !isStale(gen) else { return }\n308|            let repoIDs = try await api.fetchGroupRepositories(\n309|                config: auth.config, token: auth.token, org: org, groupID: resolved.id\n310|            )\n311|            guard !isStale(gen) else { return }\n312|            group = resolved\n313|            await action { RunnerRegistration.Action.groupResolved(resolved, repositoryIDs: repoIDs) }\n314|            guard !isStale(gen) else { return }\n315|            await action { RunnerRegistration.Action.permissionDismissed }\n316|            await finishStep(\"resolveGroup\", generation: gen)\n317|        } catch {\n318|            working = false\n319|            await fail(error, step: \"resolveGroup\", generation: gen)\n320|        }\n321|    }\n322|\n323|    // MARK: - Download\n324|\n325|    private func prepareDownload() async {\n326|        let gen = generation\n327|        guard !working else { return }\n328|        guard let draft else {\n329|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"prepareDownload\") }\n330|            return\n331|        }\n332|        working = true\n333|        await action { RunnerRegistration.Action.stepStarted(\"prepareDownload\") }\n334|        do {\n335|            let found = try await prepareDownloadInner(draft: draft, generation: gen)\n336|            guard !isStale(gen) else { return }\n337|            asset = found\n338|            await action { RunnerRegistration.Action.downloadReady(found) }\n339|            await finishStep(\"prepareDownload\", generation: gen)\n340|        } catch {\n341|            working = false\n342|            await fail(error, step: \"prepareDownload\", generation: gen)\n343|        }\n344|    }\n345|\n346|    private func prepareDownloadInner(\n347|        draft: RunnerRegistration.Draft, generation gen: Int\n348|    ) async throws -> RunnerRegistration.DownloadAsset {\n349|        let auth = try await currentUserToken(generation: gen)\n350|        guard !isStale(gen) else { throw CancellationError() }\n351|        let assets = try await api.fetchDownloads(config: auth.config, token: auth.token, scope: draft.scope)\n352|        guard !isStale(gen) else { throw CancellationError() }\n353|        return try RunnerRegistration.Gates.selectDownload(\n354|            osName: RunnerInstallerService.installOS,\n355|            arch: installer.architecture,\n356|            from: assets\n357|        )\n358|    }\n359|\n360|    // MARK: - Install\n361|\n362|    private func downloadAndInstall() async {\n363|        let gen = generation\n364|        guard !working else { return }\n365|        guard let draft else {\n366|            await action {\n367|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"downloadAndInstall\")\n368|            }\n369|            return\n370|        }\n371|        working = true\n372|        await action { RunnerRegistration.Action.stepStarted(\"downloadAndInstall\") }\n373|        do {\n374|            let resolved: RunnerRegistration.DownloadAsset\n375|            if let asset {\n376|                resolved = asset\n377|            } else {\n378|                resolved = try await prepareDownloadInner(draft: draft, generation: gen)\n379|                guard !isStale(gen) else { return }\n380|                asset = resolved\n381|                await action { RunnerRegistration.Action.downloadReady(resolved) }\n382|            }\n383|            guard !isStale(gen) else { return }\n384|            let directory = try await installer.downloadAndInstall(asset: resolved, draft: draft)\n385|            guard !isStale(gen) else { return }\n386|            installPath = directory.path\n387|            await action { RunnerRegistration.Action.installed(path: directory.path) }\n388|            await finishStep(\"downloadAndInstall\", generation: gen)\n389|        } catch {\n390|            working = false\n391|            await fail(error, step: \"downloadAndInstall\", generation: gen)\n392|        }\n393|    }\n394|\n395|    // MARK: - Register\n396|\n397|    private func registerRunner() async {\n398|        let gen = generation\n399|        guard !working else { return }\n400|        guard let draft else {\n401|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"registerRunner\") }\n402|            return\n403|        }\n404|        guard let installPath else {\n405|            failedStep = \"registerRunner\"\n406|            await action {\n407|                RunnerRegistration.Action.failed(message: \"Install the runner package first.\", step: \"registerRunner\")\n408|            }\n409|            return\n410|        }\n411|        working = true\n412|        await action { RunnerRegistration.Action.stepStarted(\"registerRunner\") }\n413|        let directory = URL(fileURLWithPath: installPath)\n414|        let scopeKey = Self.tokenScopeKey(draft: draft)\n415|        do {\n416|            // Idempotent resume: an already-configured directory never mints\n417|            // a second registration token or a duplicate GitHub registration.\n418|            // The local identity is verified against the current draft first:\n419|            // a renamed or rescoped draft never adopts the old registration.\n420|            if await installer.hasCompleted(RunnerInstallerService.stepConfigured, directory: directory) {\n421|                let local = await installer.readLocalRegistration(directory: directory)\n422|                let localID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n423|                    local: local, configured: true, draft: draft\n424|                )\n425|                let remoteID = try await resolveBoundRemoteRunnerID(\n426|                    draft: draft, localAgentID: localID, generation: gen\n427|                )\n428|                guard !isStale(gen) else { return }\n429|                runnerID = remoteID\n430|                await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: localID) }\n431|                await finishStep(\"registerRunner\", generation: gen)\n432|                return\n433|            }\n434|            let auth = try await currentUserToken(generation: gen)\n435|            guard !isStale(gen) else { return }\n436|            // Duplicate guard before any token is minted: without explicit\n437|            // replace consent a remote name match refuses the run so config\n438|            // can never silently replace another machine's registration.\n439|            // The list is complete (every page followed); a duplicate that\n440|            // appears after this check still fails at config.sh, which omits\n441|            // `--replace` unless the user explicitly allowed it.\n442|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n443|            let existing = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n444|            guard !isStale(gen) else { return }\n445|            try RunnerRegistration.Gates.rejectRemoteDuplicate(\n446|                name: wanted, isTaken: existing.contains(where: { $0.name == wanted }),\n447|                allowReplace: draft.allowReplace\n448|            )\n449|            guard !isStale(gen) else { return }\n450|            let created = try await api.createRegistrationToken(\n451|                config: auth.config, token: auth.token, scope: draft.scope\n452|            )\n453|            guard !isStale(gen) else { return }\n454|            let scoped = RunnerRegistration.ScopedToken(\n455|                token: created.token, expiresAt: created.expiresAt, obtainedAt: now()\n456|            )\n457|            try await registrationTokens.save(scoped, scopeKey: scopeKey)\n458|            guard !isStale(gen) else { return }\n459|            let groupName: String?\n460|            switch draft.scope {\n461|            case .organization: groupName = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n462|            case .repository: groupName = nil\n463|            }\n464|            let localID: Int64?\n465|            do {\n466|                localID = try await installer.runConfig(\n467|                    directory: directory,\n468|                    scopeURL: draft.scope.configURL(serverHost: auth.identity.serverHost),\n469|                    token: created.token,\n470|                    draft: draft,\n471|                    runnerGroup: groupName\n472|                )\n473|            } catch {\n474|                await registrationTokens.delete(scopeKey: scopeKey)\n475|                throw error\n476|            }\n477|            // The single-use token is consumed by config.sh: delete it before\n478|            // any follow-up API call so a post-config failure (review F6)\n479|            // reports the error without retaining the token.\n480|            await registrationTokens.delete(scopeKey: scopeKey)\n481|            guard !isStale(gen) else { return }\n482|            // Bind the remote ID to the verified local agent, never to a\n483|            // bare name match: a same-name foreign runner must fail here\n484|            // instead of becoming this installation's identity.\n485|            let verifiedLocal: RunnerRegistration.LocalRegistration? = await installer.readLocalRegistration(\n486|                directory: directory\n487|            )\n488|            let verifiedConfigured = await installer.hasCompleted(\n489|                RunnerInstallerService.stepConfigured, directory: directory\n490|            )\n491|            let verifiedID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n492|                local: verifiedLocal,\n493|                configured: verifiedConfigured && localID != nil,\n494|                draft: draft\n495|            )\n496|            let remoteID = try await resolveBoundRemoteRunnerID(\n497|                draft: draft, localAgentID: verifiedID, generation: gen\n498|            )\n499|            guard !isStale(gen) else { return }\n500|            runnerID = remoteID\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
