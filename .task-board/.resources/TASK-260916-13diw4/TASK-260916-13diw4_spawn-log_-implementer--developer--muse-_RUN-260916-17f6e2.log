 logger = Relux.Testing.Logger()\n2146|    let dispatcher = Relux.Dispatcher(logger: logger)\n2147|    let latch = LatchTransport(inner: inner, needle: needle)\n2148|    let userStore = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n2149|    let identities = InMemoryGitHubSessionIdentityStore()\n2150|    await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n2151|    try? await userStore.save(\n2152|        GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n2153|        serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n2154|    )\n2155|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"RegHome-\" + UUID().uuidString)\n2156|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n2157|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n2158|    let installer = RunnerInstallerService(\n2159|        installRoot: installRoot, downloader: downloader, executor: executor, currentArch: { \"arm64\" }\n2160|    )\n2161|    let api = GitHubRunnerAPIClient(transport: latch)\n2162|    let registrationTokens = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n2163|    let refresher = GitHubTokenRefresh(transport: latch, store: userStore)\n2164|    let flow = await RunnerRegistration.Flow(\n2165|        api: api, installer: installer, registrationTokens: registrationTokens,\n2166|        userStore: userStore, identityStore: identities, refresher: refresher,\n2167|        configProvider: { _ in testConfig }, dispatcher: dispatcher\n2168|    )\n2169|    let harness = RegistrationHarness(\n2170|        flow: flow, logger: logger, transport: inner, userStore: userStore,\n2171|        identities: identities, registrationTokens: registrationTokens,\n2172|        installer: installer, home: home, installRoot: installRoot\n2173|    )\n2174|    return (harness, latch)\n2175|}\n2176|\n2177|@Test @MainActor func inFlightRegistrationCannotAttributeOldConfigToNewDraft() async throws {\n2178|    // R3-F1 class at the registration boundary: config suspends, the draft\n2179|    // renames, the old config's success must not become the new draft's.\n2180|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2181|    let executor = ConfigLatchExecutor()\n2182|    let transport = TestTransport([\n2183|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2184|        runnersListPayload([]),\n2185|        jsonResponse([\"token\": \"REG-SECRET-R4\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2186|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2187|    ])\n2188|    let harness = await registrationHarness(\n2189|        transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor\n2190|    )\n2191|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2192|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2193|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2194|    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2195|    await executor.waitStarted()\n2196|    var renamed = orgDraft()\n2197|    renamed.runnerName = \"renamed-runner\"\n2198|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(renamed))\n2199|    await executor.release()\n2200|    _ = await operation.value\n2201|    let state = RunnerRegistration.State()\n2202|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2203|    #expect(state.draft?.runnerName == \"renamed-runner\")\n2204|    #expect(state.runnerID == nil)\n2205|    #expect(!state.completedSteps.contains(\"registerRunner\"))\n2206|    #expect(!registrationActions(harness.logger).contains { if case .registered = $0 { true } else { false } })\n2207|}\n2208|\n2209|@Test @MainActor func inFlightGroupCannotResolveForEditedDraft() async throws {\n2210|    // R3-F1 class at the group boundary: the groups list suspends, the\n2211|    // draft re-targets another group, the old resolution must not land.\n2212|    let inner = TestTransport([\n2213|        groupsListPayload([groupPayload(id: 1, name: \"Default\", visibility: \"all\", allowsPublic: true)]),\n2214|        jsonResponse(groupPayload(id: 7, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true), status: 201),\n2215|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n2216|    ])\n2217|    let (harness, latch) = await latchedHarness(inner: inner, needle: \"runner-groups\")\n2218|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2219|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2220|    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.resolveGroup) }\n2221|    await latch.waitStarted()\n2222|    var edited = orgDraft()\n2223|    edited.groupName = \"Other-Mac\"\n2224|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2225|    await latch.release()\n2226|    _ = await operation.value\n2227|    let state = RunnerRegistration.State()\n2228|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2229|    #expect(state.draft?.groupName == \"Other-Mac\")\n2230|    #expect(state.group == nil)\n2231|    #expect(!state.completedSteps.contains(\"resolveGroup\"))\n2232|}\n2233|\n2234|@Test func inFlightLabelsCannotWriteForEditedDraft() async throws {\n2235|    // R3-F1 class at the labels boundary: the runners list suspends, the\n2236|    // draft renames, no PUT may target the old binding for the new draft.\n2237|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2238|    let inner = TestTransport([\n2239|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2240|        runnersListPayload([]),\n2241|        jsonResponse([\"token\": \"REG-SECRET-R4L\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2242|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2243|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2244|        jsonResponse([\"labels\": [[\"name\": \"gpu\"]]]),\n2245|    ])\n2246|    let (harness, latch) = await latchedHarness(\n2247|        inner: inner, needle: \"/actions/runners\",\n2248|        downloader: fixtureDownloader(package.bytes), executor: SplitExecutor()\n2249|    )\n(more lines below)","final_result":true}}}
