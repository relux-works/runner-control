cted PUBLIC repos work.\n477|    #expect(body[\"allows_public_repositories\"]?.bool == true)\n478|    // Creation records ownership for later resolves on this Mac.\n479|    #expect(await harness.installer.loadOwnedGroupID(org: \"acme\", name: \"RunnerControl-Mac\") == 7)\n480|}\n481|\n482|/// Minimal JSON reader for asserting request bodies without DTO coupling.\n483|private enum JSONAny: Decodable {\n484|    case string(String)\n485|    case ints([Int64])\n486|    case bool(Bool)\n487|    case other\n488|    var string: String? { if case .string(let value) = self { value } else { nil } }\n489|    var ints: [Int64]? { if case .ints(let values) = self { values } else { nil } }\n(more lines below)","final_result":true}}}
