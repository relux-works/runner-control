{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c605","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":349,"recorded_at":1780531400000693,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"call_id":"call_01a0a8b37a79740f9a6e6de9269d9024","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n(499 line(s) above)\n500|            runnerID = remoteID\n501|            await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: verifiedID) }\n502|            guard !isStale(gen) else { return }\n503|            await action { RunnerRegistration.Action.permissionDismissed }\n504|            await finishStep(\"registerRunner\", generation: gen)\n505|        } catch {\n506|            working = false\n507|            await fail(error, step: \"registerRunner\", generation: gen)\n508|        }\n509|    }\n510|\n511|    /// Binds the complete remote runner list to the verified local agent ID.\n512|    /// Returns nil when this agent is not listed yet (convergence, retryable);\n513|    /// throws when the list contradicts the local identity.\n514|    private func resolveBoundRemoteRunnerID(\n515|        draft: RunnerRegistration.Draft, localAgentID: Int64, generation gen: Int\n516|    ) async throws -> Int64? {\n517|        let auth = try await currentUserToken(generation: gen)\n518|        guard !isStale(gen) else { throw CancellationError() }\n519|        let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n520|        let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n521|        return try RunnerRegistration.Gates.boundRemoteRunnerID(\n522|            localAgentID: localAgentID, name: wanted, runners: runners\n523|        )\n524|    }\n525|\n526|    // MARK: - Service\n527|\n528|    private func setupService() async {\n529|        let gen = generation\n530|        guard !working else { return }\n531|        guard let draft, let installPath else {\n532|            failedStep = \"setupService\"\n533|            await action {\n534|                RunnerRegistration.Action.failed(message: \"Register the runner first.\", step: \"setupService\")\n535|            }\n536|            return\n537|        }\n538|        // Service setup never declares registration complete on its own: it\n539|        // requires this operation's verified configured local identity.\n540|        let directory = URL(fileURLWithPath: installPath)\n541|        do {\n542|            let local = await installer.readLocalRegistration(directory: directory)\n543|            let configured = await installer.hasCompleted(\n544|                RunnerInstallerService.stepConfigured, directory: directory\n545|            )\n546|            _ = try RunnerRegistration.Gates.verifiedLocalAgentID(\n547|                local: local, configured: configured, draft: draft\n548|            )\n549|        } catch {\n550|            failedStep = \"setupService\"\n551|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"setupService\") }\n552|            return\n553|        }\n554|        working = true\n555|        await action { RunnerRegistration.Action.stepStarted(\"setupService\") }\n556|        do {\n557|            let label = Self.serviceLabel(draft: draft)\n558|            let plist = try await installer.setupService(directory: directory, label: label)\n559|            guard !isStale(gen) else { return }\n560|            await action { RunnerRegistration.Action.serviceReady(plistPath: plist.path) }\n561|            await finishStep(\"setupService\", generation: gen)\n562|        } catch {\n563|            working = false\n564|            await fail(error, step: \"setupService\", generation: gen)\n565|        }\n566|    }\n567|\n568|    // MARK: - Editable access and labels\n569|\n570|    private func applyRepositoryAccess(groupID: Int64, ids: Set<Int64>) async {\n571|        let gen = generation\n572|        guard !working else { return }\n573|        guard let draft else {\n574|            await action {\n575|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyRepositoryAccess\")\n576|            }\n577|            return\n578|        }\n579|        do {\n580|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n581|            guard case .organization(let org) = draft.scope else { return }\n582|            guard let group else {\n583|                failedStep = \"applyRepositoryAccess\"\n584|                await action {\n585|                    RunnerRegistration.Action.failed(\n586|                        message: \"Resolve the dedicated group first.\", step: \"applyRepositoryAccess\"\n587|                    )\n588|                }\n589|                return\n590|            }\n591|            try RunnerRegistration.Gates.authorizeGroupMutation(\n592|                targetGroupID: groupID, resolvedGroupID: group.id,\n593|                allowFlag: draft.allowGroupMutation\n594|            )\n595|            working = true\n596|            pendingRepositoryIDs = ids\n597|            pendingTargetGroupID = groupID\n598|            await action { RunnerRegistration.Action.stepStarted(\"applyRepositoryAccess\") }\n599|            let auth = try await currentUserToken(generation: gen)\n600|            guard !isStale(gen) else { return }\n601|            try await api.setGroupRepositories(\n602|                config: auth.config, token: auth.token, org: org, groupID: group.id, selectedRepositoryIDs: ids\n603|            )\n604|            guard !isStale(gen) else { return }\n605|            let confirmed = try await api.fetchGroupRepositories(\n606|                config: auth.config, token: auth.token, org: org, groupID: group.id\n607|            )\n608|            guard !isStale(gen) else { return }\n609|            // The confirmed list is complete (every page followed). It must\n610|            // equal the request exactly; otherwise the draft keeps the\n611|            // requested selection and the step fails instead of claiming a\n612|            // partial write as success.\n613|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: ids, confirmed: confirmed)\n614|            if var current = self.draft {\n615|                current.selectedRepositoryIDs = Set(confirmed)\n616|                self.draft = current\n617|            }\n618|            await action { RunnerRegistration.Action.repositoryAccessApplied(confirmed) }\n619|            guard !isStale(gen) else { return }\n620|            await action { RunnerRegistration.Action.permissionDismissed }\n621|            pendingRepositoryIDs = nil\n622|            pendingTargetGroupID = nil\n623|            await finishStep(\"applyRepositoryAccess\", generation: gen)\n624|        } catch {\n625|            working = false\n626|            await fail(error, step: \"applyRepositoryAccess\", generation: gen)\n627|        }\n628|    }\n629|\n630|    private func applyLabels(_ labels: [String]) async {\n631|        let gen = generation\n632|        guard !working else { return }\n633|        guard let draft else {\n634|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyLabels\") }\n635|            return\n636|        }\n637|        let trimmed = labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }\n638|        guard !trimmed.isEmpty else {\n639|            failedStep = \"applyLabels\"\n640|            await action {\n641|                RunnerRegistration.Action.failed(message: \"At least one label is required.\", step: \"applyLabels\")\n642|            }\n643|            return\n644|        }\n645|        // Label writes require this operation's verified local identity —\n646|        // checked before any network. A remote name match alone never\n647|        // authorizes mutating another runner.\n648|        guard let installPath else {\n649|            failedStep = \"applyLabels\"\n650|            await action {\n651|                RunnerRegistration.Action.failed(\n652|                    message: \"Register the runner first so labels target this installation.\",\n653|                    step: \"applyLabels\"\n654|                )\n655|            }\n656|            return\n657|        }\n658|        let directory = URL(fileURLWithPath: installPath)\n659|        let localAgentID: Int64\n660|        do {\n661|            let local = await installer.readLocalRegistration(directory: directory)\n662|            let configured = await installer.hasCompleted(\n663|                RunnerInstallerService.stepConfigured, directory: directory\n664|            )\n665|            localAgentID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n666|                local: local, configured: configured, draft: draft\n667|            )\n668|        } catch {\n669|            failedStep = \"applyLabels\"\n670|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"applyLabels\") }\n671|            return\n672|        }\n673|        working = true\n674|        pendingLabels = trimmed\n675|        await action { RunnerRegistration.Action.stepStarted(\"applyLabels\") }\n676|        do {\n677|            // Re-bind on every write: the stored ID is never trusted across\n678|            // edits, retries, or remote drift. A missing agent fails with\n679|            // not-found; a contradictory list fails with mismatch. Neither\n680|            // guesses by name.\n681|            let auth = try await currentUserToken(generation: gen)\n682|            guard !isStale(gen) else { return }\n683|            let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n684|            guard !isStale(gen) else { return }\n685|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n686|            let bound = try RunnerRegistration.Gates.boundRemoteRunnerID(\n687|                localAgentID: localAgentID, name: wanted, runners: runners\n688|            )\n689|            guard let runnerID = bound else {\n690|                throw RunnerRegistration.RegistrationError.remoteRunnerNotFound(\n691|                    \"GitHub does not list agent \\(localAgentID) for this scope yet; refusing to guess '\\(wanted)' by name. Retry after registration converges.\"\n692|                )\n693|            }\n694|            try await api.setRunnerLabels(\n695|                config: auth.config, token: auth.token, scope: draft.scope, runnerID: runnerID, labels: trimmed\n696|            )\n697|            guard !isStale(gen) else { return }\n698|            self.runnerID = runnerID\n699|            if var current = self.draft {\n700|                current.labels = trimmed\n701|                self.draft = current\n702|            }\n703|            await action { RunnerRegistration.Action.labelsApplied(trimmed) }\n704|            pendingLabels = nil\n705|            await finishStep(\"applyLabels\", generation: gen)\n706|        } catch {\n707|            working = false\n708|            await fail(error, step: \"applyLabels\", generation: gen)\n709|        }\n710|    }\n711|\n712|    // MARK: - Retry / cancel / reset\n713|\n714|    private func retry() async {\n715|        guard !working else { return }\n716|        guard let step = failedStep else { return }\n717|        switch step {\n718|        case \"resolveGroup\": await resolveGroup()\n719|        case \"prepareDownload\": await prepareDownload()\n720|        case \"downloadAndInstall\": await downloadAndInstall()\n721|        case \"registerRunner\": await registerRunner()\n722|        case \"setupService\": await setupService()\n723|        case \"applyRepositoryAccess\":\n724|            if let ids = pendingRepositoryIDs, let target = pendingTargetGroupID {\n725|                await applyRepositoryAccess(groupID: target, ids: ids)\n726|            }\n727|        case \"applyLabels\":\n728|            if let labels = pendingLabels { await applyLabels(labels) }\n729|        default:\n730|            return\n731|        }\n732|    }\n733|\n734|    private func cancel() async {\n735|        generation += 1\n736|        working = false\n737|        if let draft {\n738|            await registrationTokens.delete(scopeKey: Self.tokenScopeKey(draft: draft))\n739|        }\n740|        failedStep = nil\n741|        pendingRepositoryIDs = nil\n742|        pendingTargetGroupID = nil\n743|        pendingLabels = nil\n744|        await action { RunnerRegistration.Action.cancelled }\n745|    }\n746|\n747|    private func reset() async {\n748|        generation += 1\n749|        working = false\n750|        if let draft {\n751|            await registrationTokens.delete(scopeKey: Self.tokenScopeKey(draft: draft))\n752|        }\n753|        draft = nil\n754|        group = nil\n755|        asset = nil\n756|        installPath = nil\n757|        runnerID = nil\n758|        failedStep = nil\n759|        pendingRepositoryIDs = nil\n760|        pendingTargetGroupID = nil\n761|        pendingLabels = nil\n762|        await action { RunnerRegistration.Action.didReset }\n763|    }\n764|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c607","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":350,"recorded_at":1780531400000695,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"call_id":"call_01a0a8b37cce71dcb2772d867932dab2","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Gates.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Validation gates. Each gate refuses a concrete invalid class; negative\n5|    /// tests narrow every one of them.\n6|    public enum Gates {\n7|        /// Refuses install/work paths containing spaces. GitHub's own setup has\n8|        /// a known defect with spaced paths; the wizard never reproduces it.\n9|        public static func validateNoSpace(installDirName: String, workFolder: String) throws {\n10|            if installDirName.contains(\" \") {\n11|                throw RegistrationError.noSpacePath(\"Installation folder name must not contain spaces.\")\n12|            }\n13|            if installDirName.contains(\"/\") || installDirName.isEmpty {\n14|                throw RegistrationError.invalidDraft(\"Installation folder name is invalid.\")\n15|            }\n16|            if workFolder.contains(\" \") {\n17|                throw RegistrationError.noSpacePath(\"Work folder must not contain spaces.\")\n18|            }\n19|            if workFolder.isEmpty || workFolder.contains(\"/\") {\n20|                throw RegistrationError.invalidDraft(\"Work folder name is invalid.\")\n21|            }\n22|        }\n23|\n24|        /// Validates the full draft before any network or filesystem mutation.\n25|        public static func validateDraft(_ draft: Draft) throws {\n26|            let name = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n27|            guard !name.isEmpty else {\n28|                throw RegistrationError.invalidDraft(\"Runner name must not be empty.\")\n29|            }\n30|            guard name.count <= 64 else {\n31|                throw RegistrationError.invalidDraft(\"Runner name is too long (max 64 characters).\")\n32|            }\n33|            let labels = draft.labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }\n34|            guard !labels.isEmpty else {\n35|                throw RegistrationError.invalidDraft(\"At least one label is required.\")\n36|            }\n37|            for label in labels {\n38|                guard !label.isEmpty else {\n39|                    throw RegistrationError.invalidDraft(\"Labels must not be empty.\")\n40|                }\n41|                guard label.count <= 100 else {\n42|                    throw RegistrationError.invalidDraft(\"Label '\\(label)' is too long (max 100 characters).\")\n43|                }\n44|            }\n45|            try validateNoSpace(installDirName: draft.installDirName, workFolder: draft.workFolder)\n46|            switch draft.scope {\n47|            case .organization:\n48|                let group = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n49|                guard !group.isEmpty else {\n50|                    throw RegistrationError.invalidDraft(\"Organization runners need a dedicated per-Mac group name.\")\n51|                }\n52|            case .repository:\n53|                break\n54|            }\n55|        }\n56|\n57|        /// Picks the architecture-matched official asset. Refuses any\n58|        /// substitute: both OS and architecture must match exactly.\n59|        public static func selectDownload(\n60|            osName: String, arch: String, from assets: [DownloadAsset]\n61|        ) throws -> DownloadAsset {\n62|            guard let match = assets.first(where: { $0.osName == osName && $0.architecture == arch }) else {\n63|                throw RegistrationError.downloadMismatch(osName: osName, arch: arch)\n64|            }\n65|            return match\n66|        }\n67|\n68|        /// Authorizes a group mutation only when the UI explicitly scoped it\n69|        /// AND the target is this run's resolved dedicated group. Never\n70|        /// mutates unrelated or shared groups.\n71|        public static func authorizeGroupMutation(\n72|            targetGroupID: Int64, resolvedGroupID: Int64?, allowFlag: Bool\n73|        ) throws {\n74|            guard allowFlag else { throw RegistrationError.groupScopeNotConfirmed }\n75|            guard let resolved = resolvedGroupID, resolved == targetGroupID else {\n76|                throw RegistrationError.refusesSharedGroup(groupID: targetGroupID)\n77|            }\n78|        }\n79|\n80|        /// Repository scope never touches groups: personal repos get separate\n81|        /// installations without shared-group coupling.\n82|        public static func requireOrganizationScope(_ scope: Scope) throws {\n83|            if case .organization = scope { return }\n84|            throw RegistrationError.groupNotApplicable\n85|        }\n86|\n87|        /// Ownership check for a pre-existing group with the requested name.\n88|        /// A name match alone never authorizes adoption: the caller must show\n89|        /// either a locally recorded ownership entry for the same group ID or\n90|        /// an explicit UI takeover confirmation.\n91|        public static func authorizeGroupTakeover(\n92|            groupName: String, existingID: Int64, ownedID: Int64?, allowTakeover: Bool\n93|        ) throws {\n94|            if let owned = ownedID, owned == existingID { return }\n95|            guard allowTakeover else {\n96|                throw RegistrationError.groupNameTaken(name: groupName, groupID: existingID)\n97|            }\n98|        }\n99|\n100|        /// Duplicate-name guard run before any registration token is minted.\n101|        /// Without explicit replace consent a remote name match refuses the\n102|        /// run so `config.sh` can never silently replace another machine.\n103|        public static func rejectRemoteDuplicate(name: String, isTaken: Bool, allowReplace: Bool) throws {\n104|            guard isTaken, !allowReplace else { return }\n105|            throw RegistrationError.remoteNameTaken(name: name)\n106|        }\n107|\n108|        /// Verifies the local `.runner` identity belongs to this draft's\n109|        /// operation. Returns the verified local agent ID. Refuses anything\n110|        /// else: an unconfigured directory, a missing or unreadable agent ID,\n111|        /// a name mismatch, or a scope mismatch. A remote name match alone\n112|        /// never authorizes writes to another runner.\n113|        public static func verifiedLocalAgentID(\n114|            local: LocalRegistration?, configured: Bool, draft: Draft\n115|        ) throws -> Int64 {\n116|            guard configured else {\n117|                throw RegistrationError.unverifiedRegistration(\n118|                    \"Directory '\\(draft.installDirName)' was never configured by this wizard. Register it first; refusing a planted or foreign registration.\"\n119|                )\n120|            }\n121|            guard let local, let agentID = local.agentID else {\n122|                throw RegistrationError.unverifiedRegistration(\n123|                    \"No verified local registration for '\\(draft.runnerName)': install and register this directory first; refusing to touch a runner that is not this installation.\"\n124|                )\n125|            }\n126|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n127|            guard let name = local.agentName, name == wanted else {\n128|                throw RegistrationError.unverifiedRegistration(\n129|                    \"Local registration is for '\\(local.agentName ?? \"unknown\")', not '\\(wanted)'. Refusing to use another registration's identity.\"\n130|                )\n131|            }\n132|            guard let address = local.gitHubURL, scopeMatches(address: address, scope: draft.scope) else {\n133|                throw RegistrationError.unverifiedRegistration(\n134|                    \"Local registration points at '\\(local.gitHubURL ?? \"unknown\")', not this draft's scope. Refusing to use another registration's identity.\"\n135|                )\n136|            }\n137|            return agentID\n138|        }\n139|\n140|        /// Matches a `.runner` gitHubUrl against a draft scope by URL path,\n141|        /// mirroring RunnerDiscovery's parsing (one component for an org, two\n142|        /// for owner/repo). GitHub logins compare case-insensitively.\n143|        public static func scopeMatches(address: String, scope: Scope) -> Bool {\n144|            guard let url = URL(string: address), url.scheme == \"https\" else { return false }\n145|            let components = url.pathComponents.filter { $0 != \"/\" }.map { $0.lowercased() }\n146|            switch scope {\n147|            case .organization(let org):\n148|                return components == [org.lowercased()]\n149|            case .repository(let owner, let name):\n150|                return components == [owner.lowercased(), name.lowercased()]\n151|            }\n152|        }\n153|\n154|        /// Binds the complete remote runner list to the verified local agent\n155|        /// ID. Returns the bound runner ID, or nil when this agent is not\n156|        /// listed yet (retryable convergence, never an error by itself).\n157|        /// Throws when the list contradicts the local identity — a same-name\n158|        /// foreign runner or a renamed local agent — instead of guessing.\n159|        public static func boundRemoteRunnerID(\n160|            localAgentID: Int64, name: String, runners: [RegisteredRunner]\n161|        ) throws -> Int64? {\n162|            if let exact = runners.first(where: { $0.id == localAgentID }) {\n163|                guard exact.name == name else {\n164|                    throw RegistrationError.remoteIdentityMismatch(\n165|                        \"GitHub lists agent \\(localAgentID) as '\\(exact.name)', not '\\(name)'. Refusing to write to a mismatched registration.\"\n166|                    )\n167|                }\n168|                return exact.id\n169|            }\n170|            if let foreign = runners.first(where: { $0.name == name }) {\n171|                throw RegistrationError.remoteIdentityMismatch(\n172|                    \"This installation is agent \\(localAgentID), but GitHub shows '\\(name)' as agent \\(foreign.id). Refusing to adopt another runner's identity.\"\n173|                )\n174|            }\n175|            return nil\n176|        }\n177|\n178|        /// Confirms a repository-access write against the complete confirmed\n179|        /// list. Any difference — missing or extra IDs — fails closed instead\n180|        /// of reporting partial access as complete.\n181|        public static func confirmRepositoryIDs(requested: Set<Int64>, confirmed: [Int64]) throws {\n182|            guard Set(confirmed) == requested else {\n183|                throw RegistrationError.confirmationMismatch(\n184|                    \"GitHub confirmed repositories \\(confirmed.sorted()) but \\(requested.sorted()) was requested. Refusing to report partial access as complete.\"\n185|                )\n186|            }\n187|        }\n188|    }\n189|\n190|    /// Exact `config.sh` invocation inputs.\n191|    public struct ConfigSpec: Sendable, Equatable {\n192|        let scopeURL: String\n193|        let token: String\n194|        let name: String\n195|        let workFolder: String\n196|        let labels: [String]\n197|        let runnerGroup: String?\n198|        /// Explicit `--replace`. Production sets it only from\n199|        /// `Draft.allowReplace`; default invocations omit the flag so a\n200|        /// duplicate name fails instead of stealing another registration.\n201|        let replace: Bool\n202|    }\n203|\n204|    /// Exact `config.sh` invocation builder. Argument order is fixed and\n205|    /// covered by tests; production runs this exact array.\n206|    public enum ConfigInvocation {\n207|        public static func arguments(_ spec: ConfigSpec) -> [String] {\n208|            var args = [\n209|                \"--url\", spec.scopeURL,\n210|                \"--token\", spec.token,\n211|                \"--name\", spec.name,\n212|                \"--work\", spec.workFolder,\n213|                \"--labels\", spec.labels.joined(separator: \",\")\n214|            ]\n215|            if let group = spec.runnerGroup, !group.isEmpty {\n216|                args += [\"--runnergroup\", group]\n217|            }\n218|            args += [\"--unattended\"]\n219|            if spec.replace {\n220|                args += [\"--replace\"]\n221|            }\n222|            return args\n223|        }\n224|    }\n225|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c609","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":351,"recorded_at":1780531400000697,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"call_id":"call_01a0a8b37e65758587a0ec1effa7dc79","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Models.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Registration scope. One wizard run registers exactly one scope:\n5|    /// an organization (shared, via a dedicated per-Mac group) or a single\n6|    /// personal repository (separate installation, no group).\n7|    public enum Scope: Sendable, Equatable, Hashable {\n8|        case organization(org: String)\n9|        case repository(owner: String, name: String)\n10|\n11|        /// REST path prefix below the API base URL, e.g. `orgs/acme` or `repos/acme/app`.\n12|        public var apiPrefix: String {\n13|            switch self {\n14|            case .organization(let org): \"orgs/\\(org)\"\n15|            case .repository(let owner, let name): \"repos/\\(owner)/\\(name)\"\n16|            }\n17|        }\n18|\n19|        /// Short key for token-store accounts and markers. Never contains secrets.\n20|        public var scopeKey: String {\n21|            switch self {\n22|            case .organization(let org): \"org:\\(org)\"\n23|            case .repository(let owner, let name): \"repo:\\(owner)/\\(name)\"\n24|            }\n25|        }\n26|\n27|        /// URL passed to `config.sh --url`. Enterprise hosts keep their own server.\n28|        public func configURL(serverHost: String) -> String {\n29|            let host = serverHost == \"github.com\" || serverHost == \"www.github.com\"\n30|                ? \"https://github.com\"\n31|                : \"https://\\(serverHost)\"\n32|            switch self {\n33|            case .organization(let org): return \"\\(host)/\\(org)\"\n34|            case .repository(let owner, let name): return \"\\(host)/\\(owner)/\\(name)\"\n35|            }\n36|        }\n37|\n38|        /// Detail line shown in UI, e.g. `acme` or `acme/app`.\n39|        public var detail: String {\n40|            switch self {\n41|            case .organization(let org): org\n42|            case .repository(let owner, let name): \"\\(owner)/\\(name)\"\n43|            }\n44|        }\n45|    }\n46|\n47|    /// User-editable wizard input. Holds no tokens.\n48|    public struct Draft: Sendable, Equatable {\n49|        public var scope: Scope\n50|        public var runnerName: String\n51|        public var labels: [String]\n52|        public var installDirName: String\n53|        public var workFolder: String\n54|        /// Dedicated per-Mac group name for org scope. Ignored for repo scope.\n55|        public var groupName: String\n56|        public var selectedRepositoryIDs: Set<Int64>\n57|        /// Explicit UI scope: user confirmed that group mutations apply only\n58|        /// to the resolved dedicated group. Never implied.\n59|        public var allowGroupMutation: Bool\n60|        /// Explicit takeover: user confirmed that a pre-existing group with\n61|        /// the same name is this Mac's dedicated group. Name alone never\n62|        /// authorizes adopting or editing a shared group.\n63|        public var allowGroupTakeover: Bool\n64|        /// Explicit replace: user confirmed that config may replace an\n65|        /// existing GitHub registration with the same runner name. Without\n66|        /// it the wizard refuses remote duplicates instead of silently\n67|        /// stealing another machine's registration via `--replace`.\n68|        public var allowReplace: Bool\n69|\n70|        public init(\n71|            scope: Scope,\n72|            runnerName: String,\n73|            labels: [String] = [\"self-hosted\", \"macOS\"],\n74|            installDirName: String,\n75|            workFolder: String = \"_work\",\n76|            groupName: String = \"\",\n77|            selectedRepositoryIDs: Set<Int64> = [],\n78|            allowGroupMutation: Bool = false,\n79|            allowGroupTakeover: Bool = false,\n80|            allowReplace: Bool = false\n81|        ) {\n82|            self.scope = scope\n83|            self.runnerName = runnerName\n84|            self.labels = labels\n85|            self.installDirName = installDirName\n86|            self.workFolder = workFolder\n87|            self.groupName = groupName\n88|            self.selectedRepositoryIDs = selectedRepositoryIDs\n89|            self.allowGroupMutation = allowGroupMutation\n90|            self.allowGroupTakeover = allowGroupTakeover\n91|            self.allowReplace = allowReplace\n92|        }\n93|\n94|        /// Default per-Mac group name derived from the Mac name.\n95|        public static func defaultGroupName(hostName: String) -> String {\n96|            let trimmed = hostName.trimmingCharacters(in: .whitespacesAndNewlines)\n97|            let base = trimmed.isEmpty ? \"Mac\" : trimmed\n98|            return \"RunnerControl-\\(base)\"\n99|        }\n100|    }\n101|\n102|    /// Official runner download asset as returned by the downloads endpoint.\n103|    public struct DownloadAsset: Sendable, Equatable {\n104|        public let osName: String\n105|        public let architecture: String\n106|        public let downloadURL: URL\n107|        public let filename: String\n108|        public let sha256Checksum: String?\n109|        public init(osName: String, architecture: String, downloadURL: URL, filename: String, sha256Checksum: String?) {\n110|            self.osName = osName; self.architecture = architecture\n111|            self.downloadURL = downloadURL; self.filename = filename\n112|            self.sha256Checksum = sha256Checksum\n113|        }\n114|    }\n115|\n116|    /// Runner group summary. Repository access is fetched separately.\n117|    /// `allowsPublicRepositories` mirrors GitHub's `allows_public_repositories`\n118|    /// flag: without it a `selected`-visibility group silently denies every\n119|    /// selected public repository.\n120|    public struct RunnerGroup: Sendable, Equatable {\n121|        public let id: Int64\n122|        public let name: String\n123|        public let visibility: String\n124|        public let allowsPublicRepositories: Bool\n125|        public init(id: Int64, name: String, visibility: String, allowsPublicRepositories: Bool = false) {\n126|            self.id = id; self.name = name; self.visibility = visibility\n127|            self.allowsPublicRepositories = allowsPublicRepositories\n128|        }\n129|    }\n130|\n131|    /// Registered runner identity fetched from GitHub after config.\n132|    public struct RegisteredRunner: Sendable, Equatable {\n133|        public let id: Int64\n134|        public let name: String\n135|        public let labels: [String]\n136|        public init(id: Int64, name: String, labels: [String]) {\n137|            self.id = id; self.name = name; self.labels = labels\n138|        }\n139|    }\n140|\n141|    /// Local `.runner` identity, read without touching credentials.\n142|    /// Every field is optional because a missing, corrupt, or foreign file\n143|    /// must fail verification explicitly instead of crashing the wizard.\n144|    public struct LocalRegistration: Sendable, Equatable {\n145|        public let agentID: Int64?\n146|        public let agentName: String?\n147|        public let gitHubURL: String?\n148|        public let workFolder: String?\n149|        public init(agentID: Int64?, agentName: String?, gitHubURL: String?, workFolder: String?) {\n150|            self.agentID = agentID; self.agentName = agentName\n151|            self.gitHubURL = gitHubURL; self.workFolder = workFolder\n152|        }\n153|    }\n154|}\n155|\n156|extension RunnerRegistration {\n157|    public enum RegistrationError: LocalizedError, Sendable, Equatable {\n158|        case notAuthenticated\n159|        case missingPermission(String)\n160|        case invalidDraft(String)\n161|        case noSpacePath(String)\n162|        case downloadMismatch(osName: String, arch: String)\n163|        case integrityMismatch\n164|        case groupScopeNotConfirmed\n165|        case refusesSharedGroup(groupID: Int64)\n166|        case groupNameTaken(name: String, groupID: Int64)\n167|        case groupNotApplicable\n168|        case alreadyInstalled(path: String)\n169|        case alreadyRegistered(name: String)\n170|        case remoteNameTaken(name: String)\n171|        case unverifiedRegistration(String)\n172|        case remoteIdentityMismatch(String)\n173|        case remoteRunnerNotFound(String)\n174|        case confirmationMismatch(String)\n175|        case network(String)\n176|        case unauthorized\n177|        case forbidden(String)\n178|        case rateLimited\n179|        case configFailed(String)\n180|        case cancelled\n181|\n182|        public var errorDescription: String? {\n183|            switch self {\n184|            case .notAuthenticated:\n185|                \"Sign in with GitHub first. Registration needs an authenticated session.\"\n186|            case .missingPermission(let text):\n187|                text.isEmpty ? \"Missing GitHub permission for this step.\" : text\n188|            case .invalidDraft(let text):\n189|                text\n190|            case .noSpacePath(let text):\n191|                text\n192|            case .downloadMismatch(let osName, let arch):\n193|                \"No official runner package for os=\\(osName) arch=\\(arch). Refusing substitute builds.\"\n194|            case .integrityMismatch:\n195|                \"Download integrity check failed (SHA-256 mismatch). Refusing to install.\"\n196|            case .groupScopeNotConfirmed:\n197|                \"Repository access changes need explicit confirmation for the dedicated group.\"\n198|            case .refusesSharedGroup(let groupID):\n199|                \"Refusing to change group \\(groupID): it is not this Mac's dedicated group.\"\n200|            case .groupNameTaken(let name, let groupID):\n201|                \"Group '\\(name)' already exists (id \\(groupID)) and is not this Mac's dedicated group. Choose a different name or explicitly confirm takeover.\"\n202|            case .groupNotApplicable:\n203|                \"Runner groups apply to organization runners only. Repository runners use separate installations.\"\n204|            case .alreadyInstalled(let path):\n205|                \"Installation already exists at \\(path). Resume or remove it before retrying.\"\n206|            case .alreadyRegistered(let name):\n207|                \"Runner '\\(name)' is already registered here. Reuse it instead of creating a duplicate.\"\n208|            case .remoteNameTaken(let name):\n209|                \"Runner '\\(name)' already exists in GitHub. Choose a different name or explicitly allow replace; refusing to silently replace another registration.\"\n210|            case .unverifiedRegistration(let text):\n211|                text.isEmpty ? \"No verified local registration for this installation. Refusing to touch a runner that is not this Mac's installation.\" : text\n212|            case .remoteIdentityMismatch(let text):\n213|                text.isEmpty ? \"GitHub's runner list contradicts this installation's identity. Refusing to adopt another runner.\" : text\n214|            case .remoteRunnerNotFound(let text):\n215|                text.isEmpty ? \"GitHub does not list this installation yet. Refusing to guess by name.\" : text\n216|            case .confirmationMismatch(let text):\n217|                text.isEmpty ? \"GitHub confirmed different repositories than requested. Refusing to report partial access as complete.\" : text\n218|            case .network(let text):\n219|                text\n220|            case .unauthorized:\n221|                \"Session expired or revoked (401). Sign in again.\"\n222|            case .forbidden(let text):\n223|                text.isEmpty ? \"Access forbidden (403).\" : text\n224|            case .rateLimited:\n225|                \"GitHub rate limit reached. Retry later; local runners keep working.\"\n226|            case .configFailed(let text):\n227|                text.isEmpty ? \"Runner configuration failed.\" : text\n228|            case .cancelled:\n229|                \"Registration cancelled.\"\n230|            }\n231|        }\n232|    }\n233|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
