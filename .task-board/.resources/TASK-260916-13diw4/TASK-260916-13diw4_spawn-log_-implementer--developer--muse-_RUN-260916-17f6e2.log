|    for (local, configured, label) in cases {\n1904|        do {\n1905|            _ = try RunnerRegistration.Gates.verifiedLocalAgentID(local: local, configured: configured, draft: draft)\n1906|            Issue.record(\"verifiedLocalAgentID admitted \\(label)\")\n1907|        } catch let error as RunnerRegistration.RegistrationError {\n1908|            guard case .unverifiedRegistration = error else {\n1909|                Issue.record(\"wrong error for \\(label): \\(error)\")\n1910|                continue\n1911|            }\n1912|        } catch {\n1913|            Issue.record(\"unexpected error for \\(label): \\(error)\")\n1914|        }\n1915|    }\n1916|    #expect(RunnerRegistration.Gates.scopeMatches(address: \"https://github.com/ACME/\", scope: .organization(org: \"acme\")))\n1917|    #expect(!RunnerRegistration.Gates.scopeMatches(address: \"https://github.com/acme/app\", scope: .organization(org: \"acme\")))\n1918|    #expect(RunnerRegistration.Gates.scopeMatches(address: \"https://ghe.example.com/octo/app\", scope: .repository(owner: \"octo\", name: \"app\")))\n1919|    #expect(!RunnerRegistration.Gates.scopeMatches(address: \"http://github.com/acme\", scope: .organization(org: \"acme\")))\n1920|}\n1921|\n1922|@Test func boundRemoteRunnerIDBindsByID() {\n1923|    // Pure-gate pin for R2-F2: ID binding with fail-closed mismatch/absence.\n1924|    let runners = [\n1925|        RunnerRegistration.RegisteredRunner(id: 4242, name: \"macbook-test\", labels: []),\n1926|        RunnerRegistration.RegisteredRunner(id: 77, name: \"other-runner\", labels: []),\n1927|    ]\n1928|    do {\n1929|        let bound = try RunnerRegistration.Gates.boundRemoteRunnerID(\n1930|            localAgentID: 4242, name: \"macbook-test\", runners: runners\n1931|        )\n1932|        #expect(bound == 4242)\n1933|        let missing = try RunnerRegistration.Gates.boundRemoteRunnerID(\n1934|            localAgentID: 9999, name: \"ghost-runner\", runners: runners\n1935|        )\n1936|        #expect(missing == nil)\n1937|    } catch {\n1938|        Issue.record(\"unexpected error for exact/absent binding: \\(error)\")\n1939|    }\n1940|    do {\n1941|        _ = try RunnerRegistration.Gates.boundRemoteRunnerID(\n1942|            localAgentID: 9999, name: \"other-runner\",\n1943|            runners: [RunnerRegistration.RegisteredRunner(id: 77, name: \"other-runner\", labels: [])]\n1944|        )\n1945|        Issue.record(\"boundRemoteRunnerID adopted a same-name foreign runner\")\n1946|    } catch let error as RunnerRegistration.RegistrationError {\n1947|        guard case .remoteIdentityMismatch = error else {\n1948|            Issue.record(\"wrong error for foreign name match: \\(error)\")\n1949|            return\n1950|        }\n1951|    } catch {\n1952|        Issue.record(\"unexpected error: \\(error)\")\n1953|    }\n1954|    do {\n1955|        _ = try RunnerRegistration.Gates.boundRemoteRunnerID(\n1956|            localAgentID: 4242, name: \"renamed\",\n1957|            runners: [RunnerRegistration.RegisteredRunner(id: 4242, name: \"macbook-test\", labels: [])]\n1958|        )\n1959|        Issue.record(\"boundRemoteRunnerID admitted a renamed local agent\")\n1960|    } catch let error as RunnerRegistration.RegistrationError {\n1961|        guard case .remoteIdentityMismatch = error else {\n1962|            Issue.record(\"wrong error for renamed agent: \\(error)\")\n1963|            return\n1964|        }\n1965|    } catch {\n1966|        Issue.record(\"unexpected error: \\(error)\")\n1967|    }\n1968|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
