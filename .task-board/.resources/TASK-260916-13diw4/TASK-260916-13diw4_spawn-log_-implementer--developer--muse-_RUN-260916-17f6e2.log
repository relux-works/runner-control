{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cecb","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":1472,"recorded_at":1780531400002939,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8bb-a545-73f2-b66d-7893bef7704a"},"task_id":"01a0a8bb-a545-73f2-b66d-7893bef7704a","event":{"kind":"output","task_id":"01a0a8bb-a545-73f2-b66d-7893bef7704a","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n(474 line(s) above)\n475|            )\n476|            guard !isStale(gen) else { return }\n477|            installPath = directory.path\n478|            await action { RunnerRegistration.Action.installed(path: directory.path) }\n479|            await finishStep(\"downloadAndInstall\", generation: gen)\n480|        } catch {\n481|            working = false\n482|            await fail(error, step: \"downloadAndInstall\", generation: gen)\n483|        }\n484|    }\n485|\n486|    // MARK: - Register\n487|\n488|    private func registerRunner() async {\n489|        let gen = generation\n490|        guard !working else { return }\n491|        guard let draft else {\n492|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"registerRunner\") }\n493|            return\n494|        }\n495|        guard let installPath else {\n496|            failedStep = \"registerRunner\"\n497|            await action {\n498|                RunnerRegistration.Action.failed(message: \"Install the runner package first.\", step: \"registerRunner\")\n499|            }\n500|            return\n501|        }\n502|        working = true\n503|        await action { RunnerRegistration.Action.stepStarted(\"registerRunner\") }\n504|        let directory = URL(fileURLWithPath: installPath)\n505|        let scopeKey = Self.tokenScopeKey(draft: draft)\n506|        do {\n507|            // Idempotent resume: an already-configured directory never mints\n508|            // a second registration token or a duplicate GitHub registration.\n509|            // The local identity is verified against the current draft first:\n510|            // a renamed or rescoped draft never adopts the old registration.\n511|            if await installer.hasCompleted(RunnerInstallerService.stepConfigured, directory: directory) {\n512|                let local = await installer.readLocalRegistration(directory: directory)\n513|                let localID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n514|                    local: local, configured: true, draft: draft\n515|                )\n516|                let remoteID = try await resolveBoundRemoteRunnerID(\n517|                    draft: draft, localAgentID: localID, generation: gen\n518|                )\n519|                guard !isStale(gen) else { return }\n520|                runnerID = remoteID\n521|                await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: localID) }\n522|                await finishStep(\"registerRunner\", generation: gen)\n523|                return\n524|            }\n525|            let auth = try await currentUserToken(generation: gen)\n526|            guard !isStale(gen) else { return }\n527|            // Duplicate guard before any token is minted: without explicit\n528|            // replace consent a remote name match refuses the run so config\n529|            // can never silently replace another machine's registration.\n530|            // The list is complete (every page followed); a duplicate that\n531|            // appears after this check still fails at config.sh, which omits\n532|            // `--replace` unless the user explicitly allowed it.\n533|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n534|            let existing = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n535|            guard !isStale(gen) else { return }\n536|            try RunnerRegistration.Gates.rejectRemoteDuplicate(\n537|                name: wanted, isTaken: existing.contains(where: { $0.name == wanted }),\n538|                allowReplace: draft.allowReplace\n539|            )\n540|            guard !isStale(gen) else { return }\n541|            let created = try await api.createRegistrationToken(\n542|                config: auth.config, token: auth.token, scope: draft.scope\n543|            )\n544|            guard !isStale(gen) else { return }\n545|            let scoped = RunnerRegistration.ScopedToken(\n546|                token: created.token, expiresAt: created.expiresAt, obtainedAt: now()\n547|            )\n548|            try await registrationTokens.save(scoped, scopeKey: scopeKey)\n549|            guard !isStale(gen) else { return }\n550|            let groupName: String?\n551|            switch draft.scope {\n552|            case .organization: groupName = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n553|            case .repository: groupName = nil\n554|            }\n555|            let localID: Int64?\n556|            do {\n557|                localID = try await installer.runConfig(\n558|                    directory: directory,\n559|                    scopeURL: draft.scope.configURL(serverHost: auth.identity.serverHost),\n560|                    token: created.token,\n561|                    draft: draft,\n562|                    runnerGroup: groupName\n563|                )\n564|            } catch {\n565|                await registrationTokens.delete(scopeKey: scopeKey)\n566|                throw error\n567|            }\n568|            // The single-use token is consumed by config.sh: delete it before\n569|            // any follow-up API call so a post-config failure (review F6)\n570|            // reports the error without retaining the token.\n571|            await registrationTokens.delete(scopeKey: scopeKey)\n572|            guard !isStale(gen) else { return }\n573|            // Bind the remote ID to the verified local agent, never to a\n574|            // bare name match: a same-name foreign runner must fail here\n575|            // instead of becoming this installation's identity.\n576|            let verifiedLocal: RunnerRegistration.LocalRegistration? = await installer.readLocalRegistration(\n577|                directory: directory\n578|            )\n579|            let verifiedConfigured = await installer.hasCompleted(\n580|                RunnerInstallerService.stepConfigured, directory: directory\n581|            )\n582|            let verifiedID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n583|                local: verifiedLocal,\n584|                configured: verifiedConfigured && localID != nil,\n585|                draft: draft\n586|            )\n587|            let remoteID = try await resolveBoundRemoteRunnerID(\n588|                draft: draft, localAgentID: verifiedID, generation: gen\n589|            )\n590|            guard !isStale(gen) else { return }\n591|            runnerID = remoteID\n592|            await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: verifiedID) }\n593|            guard !isStale(gen) else { return }\n594|            await action { RunnerRegistration.Action.permissionDismissed }\n595|            await finishStep(\"registerRunner\", generation: gen)\n596|        } catch {\n597|            working = false\n598|            await fail(error, step: \"registerRunner\", generation: gen)\n599|        }\n600|    }\n601|\n602|    /// Binds the complete remote runner list to the verified local agent ID.\n603|    /// Returns nil when this agent is not listed yet (convergence, retryable);\n604|    /// throws when the list contradicts the local identity.\n605|    private func resolveBoundRemoteRunnerID(\n606|        draft: RunnerRegistration.Draft, localAgentID: Int64, generation gen: Int\n607|    ) async throws -> Int64? {\n608|        let auth = try await currentUserToken(generation: gen)\n609|        guard !isStale(gen) else { throw CancellationError() }\n610|        let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n611|        let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n612|        return try RunnerRegistration.Gates.boundRemoteRunnerID(\n613|            localAgentID: localAgentID, name: wanted, runners: runners\n614|        )\n615|    }\n616|\n617|    // MARK: - Service\n618|\n619|    private func setupService() async {\n620|        let gen = generation\n621|        guard !working else { return }\n622|        guard let draft, let installPath else {\n623|            failedStep = \"setupService\"\n624|            await action {\n625|                RunnerRegistration.Action.failed(message: \"Register the runner first.\", step: \"setupService\")\n626|            }\n627|            return\n628|        }\n629|        // Service setup never declares registration complete on its own: it\n630|        // requires this operation's verified configured local identity.\n631|        let directory = URL(fileURLWithPath: installPath)\n632|        do {\n633|            let local = await installer.readLocalRegistration(directory: directory)\n634|            let configured = await installer.hasCompleted(\n635|                RunnerInstallerService.stepConfigured, directory: directory\n636|            )\n637|            _ = try RunnerRegistration.Gates.verifiedLocalAgentID(\n638|                local: local, configured: configured, draft: draft\n639|            )\n640|        } catch {\n641|            failedStep = \"setupService\"\n642|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"setupService\") }\n643|            return\n644|        }\n645|        working = true\n646|        await action { RunnerRegistration.Action.stepStarted(\"setupService\") }\n647|        do {\n648|            let label = Self.serviceLabel(draft: draft)\n649|            let plist = try await installer.setupService(directory: directory, label: label)\n650|            guard !isStale(gen) else { return }\n651|            await action { RunnerRegistration.Action.serviceReady(plistPath: plist.path) }\n652|            await finishStep(\"setupService\", generation: gen)\n653|        } catch {\n654|            working = false\n(more lines below)","final_result":true}}}
