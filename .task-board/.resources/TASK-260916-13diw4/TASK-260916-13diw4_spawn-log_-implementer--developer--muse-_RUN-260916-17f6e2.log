{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd9f","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":1322,"recorded_at":1780531400002639,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8ba-f76d-7880-8175-b385d6933702"},"task_id":"01a0a8ba-f76d-7880-8175-b385d6933702","event":{"kind":"output","task_id":"01a0a8ba-f76d-7880-8175-b385d6933702","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n(309 line(s) above)\n310|\n311|    private func finishStep(_ step: String, generation gen: Int) async {\n312|        guard !isStale(gen) else { return }\n313|        failedStep = nil\n314|        working = false\n315|        await action { RunnerRegistration.Action.stepFinished(step) }\n316|    }\n317|\n318|    // MARK: - Group\n319|\n320|    private func resolveGroup() async {\n321|        let gen = generation\n322|        guard !working else { return }\n323|        guard let draft else {\n324|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"resolveGroup\") }\n325|            return\n326|        }\n327|        do {\n328|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n329|        } catch {\n330|            failedStep = \"resolveGroup\"\n331|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"resolveGroup\") }\n332|            return\n333|        }\n334|        guard case .organization(let org) = draft.scope else { return }\n335|        working = true\n336|        await action { RunnerRegistration.Action.stepStarted(\"resolveGroup\") }\n337|        do {\n338|            let auth = try await currentUserToken(generation: gen)\n339|            guard !isStale(gen) else { return }\n340|            let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n341|            guard !isStale(gen) else { return }\n342|            let name = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n343|            let resolved: RunnerRegistration.RunnerGroup\n344|            if let existing = groups.first(where: { $0.name == name }) {\n345|                // Name alone never authorizes adoption: require a locally\n346|                // recorded ownership entry or explicit takeover confirmation.\n347|                let owned = await installer.loadOwnedGroupID(org: org, name: name)\n348|                try RunnerRegistration.Gates.authorizeGroupTakeover(\n349|                    groupName: name, existingID: existing.id,\n350|                    ownedID: owned, allowTakeover: draft.allowGroupTakeover\n351|                )\n352|                if owned != existing.id {\n353|                    try await installer.saveOwnedGroupID(org: org, name: name, groupID: existing.id)\n354|                }\n355|                guard !isStale(gen) else { return }\n356|                // A pre-existing group may deny public repos (GitHub default\n357|                // false), which would silently drop selected public repos.\n358|                if existing.allowsPublicRepositories {\n359|                    resolved = existing\n360|                } else {\n361|                    resolved = try await api.updateGroupAllowsPublic(\n362|                        config: auth.config, token: auth.token, org: org,\n363|                        groupID: existing.id, allowsPublic: true\n364|                    )\n365|                }\n366|            } else {\n367|                resolved = try await api.createGroup(\n368|                    config: auth.config, token: auth.token, org: org,\n369|                    name: name, selectedRepositoryIDs: draft.selectedRepositoryIDs,\n370|                    allowsPublicRepositories: true\n371|                )\n372|                guard !isStale(gen) else { return }\n373|                try await installer.saveOwnedGroupID(org: org, name: name, groupID: resolved.id)\n374|            }\n375|            guard !isStale(gen) else { return }\n376|            let repoIDs = try await api.fetchGroupRepositories(\n377|                config: auth.config, token: auth.token, org: org, groupID: resolved.id\n378|            )\n379|            guard !isStale(gen) else { return }\n380|            group = resolved\n381|            await action { RunnerRegistration.Action.groupResolved(resolved, repositoryIDs: repoIDs) }\n382|            guard !isStale(gen) else { return }\n383|            await action { RunnerRegistration.Action.permissionDismissed }\n384|            await finishStep(\"resolveGroup\", generation: gen)\n385|        } catch {\n386|            working = false\n387|            await fail(error, step: \"resolveGroup\", generation: gen)\n388|        }\n389|    }\n(more lines below)","final_result":true}}}
