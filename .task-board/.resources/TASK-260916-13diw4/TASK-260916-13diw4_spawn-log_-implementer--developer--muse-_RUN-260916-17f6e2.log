{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d6c5","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":2493,"recorded_at":1780531400004981,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8c1-b621-7fe2-891d-a21d42cf5fff"},"task_id":"01a0a8c1-b621-7fe2-891d-a21d42cf5fff","event":{"kind":"output","task_id":"01a0a8c1-b621-7fe2-891d-a21d42cf5fff","chunk":"edited\nchanged lines: lines 2243-2276\n--- original\n+++ updated\n@@\n-@Test func inFlightLabelsCannotWriteForEditedDraft() async throws {\n-    // R3-F1 class at the labels boundary: the runners list suspends, the\n-    // draft renames, no PUT may target the old binding for the new draft.\n-    let package = try await FixturePackage.make(withRealConfigScript: false)\n-    let inner = TestTransport([\n-        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n-        runnersListPayload([]),\n-        jsonResponse([\"token\": \"REG-SECRET-R4L\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n-        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n-        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n-        jsonResponse([\"labels\": [[\"name\": \"gpu\"]]]),\n-    ])\n-    let (harness, latch) = await latchedHarness(\n-        inner: inner, needle: \"/actions/runners\",\n-        downloader: fixtureDownloader(package.bytes), executor: SplitExecutor()\n-    )\n-    defer { try? FileManager.default.removeItem(at: harness.home) }\n-    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n-    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n-    // First runners-list call (duplicate guard) trips the latch; release it\n-    // immediately so registration completes, then re-latch is unnecessary:\n-    // the latch fires once, so suspend the labels fetch with a fresh latch.\n-    await latch.release()\n-    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n-    // Fresh latch for the labels step: rebuild the flow-bound latch by\n-    // suspending via a second wrapper is unnecessary — instead verify the\n-    // sequential rename refusal, which shares the same generation gate.\n-    var renamed = orgDraft()\n-    renamed.runnerName = \"renamed-runner\"\n-    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(renamed))\n-    _ = await harness.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"]))\n-    #expect(lastFailure(harness.logger)?.step == \"applyLabels\")\n-    #expect(await inner.requests.filter { $0.method == \"PUT\" }.isEmpty)\n-}\n+@Test @MainActor func inFlightLabelsCannotWriteForEditedDraft() async throws {\n+    // R3-F1 class at the labels boundary: the labels runners-list fetch\n+    // suspends (the two registration fetches pass through), the draft\n+    // renames, and the stale write is dropped before any PUT.\n+    let package = try await FixturePackage.make(withRealConfigScript: false)\n+    let inner = TestTransport([\n+        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n+        runnersListPayload([]),\n+        jsonResponse([\"token\": \"REG-SECRET-R4L\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n+        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n+        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n+        jsonResponse([\"labels\": [[\"name\": \"gpu\"]]]),\n+    ])\n+    let (harness, latch) = await latchedHarness(\n+        inner: inner, needle: \"/actions/runners\", skip: 2,\n+        downloader: fixtureDownloader(package.bytes), executor: SplitExecutor()\n+    )\n+    defer { try? FileManager.default.removeItem(at: harness.home) }\n+    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n+    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n+    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n+    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"])) }\n+    await latch.waitStarted()\n+    var renamed = orgDraft()\n+    renamed.runnerName = \"renamed-runner\"\n+    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(renamed))\n+    await latch.release()\n+    _ = await operation.value\n+    let state = RunnerRegistration.State()\n+    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n+    #expect(state.draft?.runnerName == \"renamed-runner\")\n+    #expect(await inner.requests.filter { $0.method == \"PUT\" }.isEmpty)\n+    #expect(!registrationActions(harness.logger).contains { if case .labelsApplied = $0 { true } else { false } })\n+}\n","final_result":true}}}
