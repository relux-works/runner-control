{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb2d","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":1009,"recorded_at":1780531400002013,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8b9-86ab-7283-8086-ac549c4ce875"},"task_id":"01a0a8b9-86ab-7283-8086-ac549c4ce875","event":{"kind":"output","task_id":"01a0a8b9-86ab-7283-8086-ac549c4ce875","chunk":"edited\nchanged lines: lines 256-280\n--- original\n+++ updated\n@@\n-    private static func ownershipKey(org: String, name: String) -> String {\n-        \"\\(org.lowercased())\\u{0}\\(name)\"\n-    }\n-\n-    /// Returns the locally recorded dedicated-group ID for `org` + `name`,\n-    /// or nil when this Mac never created (or took over) that group. Name\n-    /// matches on GitHub alone never count as ownership.\n-    public func loadOwnedGroupID(org: String, name: String) -> Int64? {\n-        guard let data = try? Data(contentsOf: ownershipFile()),\n-              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n-        return table[Self.ownershipKey(org: org, name: name)]\n-    }\n-\n-    public func saveOwnedGroupID(org: String, name: String, groupID: Int64) throws {\n-        let file = ownershipFile()\n-        var table: [String: Int64] = [:]\n-        if let data = try? Data(contentsOf: file),\n-           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n-            table = decoded\n-        }\n-        table[Self.ownershipKey(org: org, name: name)] = groupID\n-        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n-        let data = try JSONEncoder().encode(table)\n-        try data.write(to: file, options: .atomic)\n-    }\n+    private static func ownershipKey(serverHost: String, org: String, name: String) -> String {\n+        \"\\(RunnerRegistration.OperationIdentity.normalizeServerHost(serverHost))\\u{0}\\(org.lowercased())\\u{0}\\(name)\"\n+    }\n+\n+    /// Returns the locally recorded dedicated-group ID for\n+    /// `server` + `org` + `name`, or nil when this Mac never created (or\n+    /// took over) that group on that server. Name matches on GitHub alone\n+    /// never count as ownership, and ownership on one server never\n+    /// authorizes adoption on another.\n+    public func loadOwnedGroupID(serverHost: String, org: String, name: String) -> Int64? {\n+        guard let data = try? Data(contentsOf: ownershipFile()),\n+              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n+        return table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)]\n+    }\n+\n+    public func saveOwnedGroupID(serverHost: String, org: String, name: String, groupID: Int64) throws {\n+        let file = ownershipFile()\n+        var table: [String: Int64] = [:]\n+        if let data = try? Data(contentsOf: file),\n+           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n+            table = decoded\n+        }\n+        table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)] = groupID\n+        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n+        let data = try JSONEncoder().encode(table)\n+        try data.write(to: file, options: .atomic)\n+    }\n","final_result":true}}}
