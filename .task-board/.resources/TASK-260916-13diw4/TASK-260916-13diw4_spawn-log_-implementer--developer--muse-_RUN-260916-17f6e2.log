ry await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n341|            guard !isStale(gen) else { return }\n342|            let name = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n343|            let resolved: RunnerRegistration.RunnerGroup\n344|            if let existing = groups.first(where: { $0.name == name }) {\n345|                // Name alone never authorizes adoption: require a locally\n346|                // recorded ownership entry or explicit takeover confirmation.\n347|                let owned = await installer.loadOwnedGroupID(org: org, name: name)\n348|                try RunnerRegistration.Gates.authorizeGroupTakeover(\n349|                    groupName: name, existingID: existing.id,\n350|                    ownedID: owned, allowTakeover: draft.allowGroupTakeover\n351|                )\n352|                if owned != existing.id {\n353|                    try await installer.saveOwnedGroupID(org: org, name: name, groupID: existing.id)\n354|                }\n355|                guard !isStale(gen) else { return }\n356|                // A pre-existing group may deny public repos (GitHub default\n357|                // false), which would silently drop selected public repos.\n358|                if existing.allowsPublicRepositories {\n359|                    resolved = existing\n360|                } else {\n361|                    resolved = try await api.updateGroupAllowsPublic(\n362|                        config: auth.config, token: auth.token, org: org,\n363|                        groupID: existing.id, allowsPublic: true\n364|                    )\n365|                }\n366|            } else {\n367|                resolved = try await api.createGroup(\n368|                    config: auth.config, token: auth.token, org: org,\n369|                    name: name, selectedRepositoryIDs: draft.selectedRepositoryIDs,\n370|                    allowsPublicRepositories: true\n371|                )\n372|                guard !isStale(gen) else { return }\n373|                try await installer.saveOwnedGroupID(org: org, name: name, groupID: resolved.id)\n374|            }\n375|            guard !isStale(gen) else { return }\n376|            let repoIDs = try await api.fetchGroupRepositories(\n377|                config: auth.config, token: auth.token, org: org, groupID: resolved.id\n378|            )\n379|            guard !isStale(gen) else { return }\n380|            group = resolved\n381|            await action { RunnerRegistration.Action.groupResolved(resolved, repositoryIDs: repoIDs) }\n382|            guard !isStale(gen) else { return }\n383|            await action { RunnerRegistration.Action.permissionDismissed }\n384|            await finishStep(\"resolveGroup\", generation: gen)\n385|        } catch {\n386|            working = false\n387|            await fail(error, step: \"resolveGroup\", generation: gen)\n388|        }\n389|    }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
