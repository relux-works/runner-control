ectory.appendingPathComponent(Self.markerFileName), options: .atomic)\n78|    }\n79|\n80|    public func markCompleted(_ step: String, directory: URL, scopeKey: String) throws {\n81|        var marker = loadMarker(directory: directory) ?? Marker(scopeKey: scopeKey)\n82|        marker.completedSteps.insert(step)\n83|        try storeMarker(marker, directory: directory)\n84|    }\n85|\n86|    public func hasCompleted(_ step: String, directory: URL) -> Bool {\n87|        loadMarker(directory: directory)?.completedSteps.contains(step) == true\n88|    }\n89|\n90|    // MARK: - Install\n91|\n92|    /// Downloads, verifies, and extracts the official package. Idempotent:\n93|    /// a completed `installed` marker with matching scope skips the work.\n94|    /// Refuses to overwrite an already-registered directory (no duplicates).\n95|    public func downloadAndInstall(\n96|        asset: RunnerRegistration.DownloadAsset,\n97|        draft: RunnerRegistration.Draft\n98|    ) async throws -> URL {\n99|        try RunnerRegistration.Gates.validateNoSpace(\n100|            installDirName: draft.installDirName, workFolder: draft.workFolder\n101|        )\n102|        let directory = self.directory(for: draft.installDirName)\n103|        if directory.path.contains(\" \") {\n104|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n105|        }\n106|        let files = FileManager.default\n107|        if let marker = loadMarker(directory: directory),\n108|           marker.completedSteps.contains(Self.stepInstalled),\n109|           marker.scopeKey == draft.scope.scopeKey,\n110|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n111|            return directory\n112|        }\n113|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n114|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: draft.runnerName)\n115|        }\n116|        let bytes: Data\n117|        do {\n118|            bytes = try await downloader(asset.downloadURL)\n119|        } catch {\n120|            throw RunnerRegistration.RegistrationError.network(\"Runner download failed: \\(error.localizedDescription)\")\n121|        }\n122|        // Fail closed: the official downloads endpoint documents\n123|        // `sha256_checksum`, and an install without a verified digest is\n124|        // refused rather than trusted on TLS alone.\n125|        guard let expected = asset.sha256Checksum, !expected.isEmpty else {\n126|            throw RunnerRegistration.RegistrationError.integrityMismatch\n127|        }\n128|        let actual = hasher(bytes)\n129|        guard actual.lowercased() == expected.lowercased() else {\n130|            throw RunnerRegistration.RegistrationError.integrityMismatch\n131|        }\n132|        try files.createDirectory(at: directory, withIntermediateDirectories: true)\n133|        let archive = files.temporaryDirectory.appendingPathComponent(UUID().uuidString + \"-\" + asset.filename)\n134|        defer { try? files.removeItem(at: archive) }\n135|        try bytes.write(to: archive, options: .atomic)\n136|        let result = try await executor.run(\"/usr/bin/tar\", [\"-xzf\", archive.path, \"-C\", directory.path])\n137|        guard result.code == 0 else {\n138|            throw RunnerRegistration.RegistrationError.network(\n139|                \"Runner archive extraction failed: \\(String(result.output.prefix(300)))\"\n140|            )\n141|        }\n142|        // Official packages keep runsvc.sh under bin/ until svc.sh installs it;\n143|        // a bare extraction leaves the root copy absent, so install it here.\n144|        try installRunsvc(directory: directory)\n145|        try markCompleted(Self.stepDownloaded, directory: directory, scopeKey: draft.scope.scopeKey)\n146|        try markCompleted(Self.stepInstalled, directory: directory, scopeKey: draft.scope.scopeKey)\n147|        return directory\n148|    }\n149|\n150|    /// Copies official `bin/runsvc.sh` into the installation root and makes\n151|    /// it executable, mirroring what official `svc.sh install` would do.\n152|    public func installRunsvc(directory: URL) throws {\n153|        let files = FileManager.default\n154|        let source = directory.appendingPathComponent(\"bin/runsvc.sh\")\n155|        let target = directory.appendingPathComponent(\"runsvc.sh\")\n156|        guard files.fileExists(atPath: source.path) else {\n157|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing bin/runsvc.sh.\")\n158|        }\n159|        if files.fileExists(atPath: target.path) {\n160|            try files.removeItem(at: target)\n161|        }\n162|        try files.copyItem(at: source, to: target)\n163|        try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: target.path)\n164|    }\n165|\n166|    // MARK: - Configure\n167|\n168|    /// Runs the exact `config.sh` invocation. Skips when a previous attempt\n169|    /// already registered this directory (marker + `.runner` present), so\n170|    /// retries never create orphan or duplicate GitHub registrations.\n171|    /// Returns the local agent ID read back from `.runner`.\n172|    @discardableResult\n173|    public func runConfig(\n174|        directory: URL,\n175|        scopeURL: String,\n176|        token: String,\n177|        draft: RunnerRegistration.Draft,\n178|        runnerGroup: String?\n179|    ) async throws -> Int64? {\n180|        try await runConfig(\n181|            directory: directory, scopeURL: scopeURL, token: token,\n182|            draft: draft, runnerGroup: runnerGroup, replace: draft.allowReplace\n183|        )\n184|    }\n185|\n186|    /// Explicit-`replace` variant. Production callers pass\n187|    /// `draft.allowReplace`; tests drive both values.\n188|    @discardableResult\n189|    public func runConfig(\n190|        directory: URL,\n191|        scopeURL: String,\n192|        token: String,\n193|        draft: RunnerRegistration.Draft,\n194|        runnerGroup: String?,\n195|        replace: Bool\n196|    ) async throws -> Int64? {\n197|        let files = FileManager.default\n198|        if hasCompleted(Self.stepConfigured, directory: directory),\n199|           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n200|            return readAgentID(directory: directory)\n201|        }\n202|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n203|           hasCompleted(Self.stepConfigured, directory: directory) {\n204|            return readAgentID(directory: directory)\n205|        }\n206|        let spec = RunnerRegistration.ConfigSpec(\n207|            scopeURL: scopeURL, token: token, name: draft.runnerName,\n208|            workFolder: draft.workFolder, labels: draft.labels,\n209|            runnerGroup: runnerGroup, replace: replace\n210|        )\n211|        let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n212|        let executable = directory.appendingPathComponent(\"config.sh\").path\n213|        guard files.fileExists(atPath: executable) else {\n214|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n215|        }\n216|        let result = try await executor.run(executable, args)\n217|        guard result.code == 0 else {\n218|            // Never echo the token: config output may repeat arguments.\n219|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [token])\n220|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n221|        }\n222|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n223|            throw RunnerRegistration.RegistrationError.configFailed(\n224|                \"config.sh reported success but .runner is missing.\"\n225|            )\n226|        }\n227|        try markCompleted(Self.stepConfigured, directory: directory, scopeKey: draft.scope.scopeKey)\n228|        return readAgentID(directory: directory)\n229|    }\n230|\n231|    // MARK: - Dedicated-group ownership\n232|\n233|    public static let ownershipFileName = \".runnercontrol-groups.json\"\n234|\n235|    private func ownershipFile() -> URL {\n236|        installRoot.appendingPathComponent(Self.ownershipFileName)\n237|    }\n238|\n239|    private static func ownershipKey(org: String, name: String) -> String {\n240|        \"\\(org.lowercased())\\u{0}\\(name)\"\n241|    }\n242|\n243|    /// Returns the locally recorded dedicated-group ID for `org` + `name`,\n244|    /// or nil when this Mac never created (or took over) that group. Name\n245|    /// matches on GitHub alone never count as ownership.\n246|    public func loadOwnedGroupID(org: String, name: String) -> Int64? {\n247|        guard let data = try? Data(contentsOf: ownershipFile()),\n248|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n249|        return table[Self.ownershipKey(org: org, name: name)]\n250|    }\n251|\n252|    public func saveOwnedGroupID(org: String, name: String, groupID: Int64) throws {\n253|        let file = ownershipFile()\n254|        var table: [String: Int64] = [:]\n255|        if let data = try? Data(contentsOf: file),\n256|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n257|            table = decoded\n258|        }\n259|        table[Self.ownershipKey(org: org, name: name)] = groupID\n260|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n261|        let data = try JSONEncoder().encode(table)\n262|        try data.write(to: file, options: .atomic)\n263|    }\n264|\n265|    /// Reads the local `.runner` identity without touching credentials.\n266|    /// Returns nil only when the file is missing or unparseable; a present\n267|    /// but incomplete file returns a partial struct so verification can name\n268|    /// the exact missing field instead of crashing.\n269|    public func readLocalRegistration(directory: URL) -> RunnerRegistration.LocalRegistration? {\n270|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n271|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n272|        var agentID: Int64?\n273|        if let id = object[\"agentId\"] as? Int64 { agentID = id }\n274|        else if let id = object[\"agentId\"] as? Int { agentID = Int64(id) }\n275|        else if let id = object[\"agentId\"] as? NSNumber { agentID = id.int64Value }\n276|        return RunnerRegistration.LocalRegistration(\n277|            agentID: agentID,\n278|            agentName: object[\"agentName\"] as? String,\n279|            gitHubURL: object[\"gitHubUrl\"] as? String,\n280|            workFolder: object[\"workFolder\"] as? String\n281|        )\n282|    }\n283|\n284|    /// Reads the local agent ID from `.runner` without touching credentials.\n285|    public func readAgentID(directory: URL) -> Int64? {\n286|        readLocalRegistration(directory: directory)?.agentID\n287|    }\n288|\n289|    // MARK: - Manual LaunchAgent\n290|\n291|    /// Writes the manual service plist (RunAtLoad off for new runners) and\n292|    /// validates it matches the directory. Never bootstraps the service:\n293|    /// enabling is the user's separate action.\n294|    @discardableResult\n295|    public func setupService(directory: URL, label: String) throws -> URL {\n296|        guard !directory.path.contains(\" \") else {\n297|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n298|        }\n299|        let files = FileManager.default\n300|        guard files.fileExists(atPath: directory.appendingPathComponent(\"runsvc.sh\").path) else {\n301|            throw RunnerRegistration.RegistrationError.network(\n302|                \"runsvc.sh is missing; reinstall before setting up the service.\"\n303|            )\n304|        }\n305|        let plist = directory.appendingPathComponent(\"manual-service.plist\")\n306|        let payload: [String: Any] = [\n307|            \"Label\": label,\n308|            \"ProgramArguments\": [directory.appendingPathComponent(\"runsvc.sh\").path],\n309|            \"WorkingDirectory\": directory.path,\n310|            \"RunAtLoad\": false\n311|        ]\n312|        let data = try PropertyListSerialization.data(fromPropertyList: payload, format: .xml, options: 0)\n313|        try data.write(to: plist, options: .atomic)\n314|        let scopeKey = loadMarker(directory: directory)?.scopeKey ?? \"\"\n315|        try markCompleted(Self.stepServiceReady, directory: directory, scopeKey: scopeKey)\n316|        return plist\n317|    }\n318|\n319|    /// Removes a failed partial install so retries start clean. Refuses to\n320|    /// touch directories that already hold a registration (`.runner`) or an\n321|    /// unknown marker scope: recovery never deletes a working runner.\n322|    public func recoverPartialInstall(directory: URL, scopeKey: String) throws {\n323|        let files = FileManager.default\n324|        guard files.fileExists(atPath: directory.path) else { return }\n325|        guard !files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n326|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: directory.lastPathComponent)\n327|        }\n328|        if let marker = loadMarker(directory: directory), marker.scopeKey != scopeKey {\n329|            throw RunnerRegistration.RegistrationError.alreadyInstalled(path: directory.path)\n330|        }\n331|        try files.removeItem(at: directory)\n332|    }\n333|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c693","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":420,"recorded_at":1780531400000835,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"call_id":"call_01a0a8b393f8768b936b2e420793315c","text":"Read text file `Targets/RunnerControl/Sources/RunnerRegistrationContainer.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|/// Wizard composition root. Edits local draft fields, dispatches production\n5|/// `RunnerRegistration.Effect`s, and never holds tokens.\n6|struct RunnerRegistrationContainer: View {\n7|    @ObservedObject var registration: RunnerRegistration.State\n8|    @ObservedObject var github: GitHubAuth.State\n9|    let close: () -> Void\n10|\n11|    @State private var scopeKind: RunnerRegistrationPage.ScopeKind = .organization\n12|    @State private var org = \"\"\n13|    @State private var repoOwner = \"\"\n14|    @State private var repoName = \"\"\n15|    @State private var runnerName = Host.current().localizedName ?? \"\"\n16|    @State private var labelsText = \"self-hosted, macOS\"\n17|    @State private var installDirName = \"\"\n18|    @State private var workFolder = \"_work\"\n19|    @State private var groupName = RunnerRegistration.Draft.defaultGroupName(\n20|        hostName: Host.current().localizedName ?? \"\"\n21|    )\n22|    @State private var allowGroupMutation = false\n23|    @State private var allowGroupTakeover = false\n24|    @State private var allowReplace = false\n25|    @State private var selectedRepositoryIDs: Set<Int64> = []\n26|    @State private var seeded = false\n27|\n28|    private static func parseLabels(_ text: String) -> [String] {\n29|        text.split(separator: \",\").map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }\n30|    }\n31|\n32|    private var currentDraft: RunnerRegistration.Draft {\n33|        let scope: RunnerRegistration.Scope\n34|        switch scopeKind {\n35|        case .organization:\n36|            scope = .organization(org: org.trimmingCharacters(in: .whitespacesAndNewlines))\n37|        case .repository:\n38|            scope = .repository(\n39|                owner: repoOwner.trimmingCharacters(in: .whitespacesAndNewlines),\n40|                name: repoName.trimmingCharacters(in: .whitespacesAndNewlines)\n41|            )\n42|        }\n43|        return RunnerRegistration.Draft(\n44|            scope: scope,\n45|            runnerName: runnerName.trimmingCharacters(in: .whitespacesAndNewlines),\n46|            labels: Self.parseLabels(labelsText),\n47|            installDirName: installDirName.trimmingCharacters(in: .whitespacesAndNewlines),\n48|            workFolder: workFolder.trimmingCharacters(in: .whitespacesAndNewlines),\n49|            groupName: groupName.trimmingCharacters(in: .whitespacesAndNewlines),\n50|            selectedRepositoryIDs: selectedRepositoryIDs,\n51|            allowGroupMutation: allowGroupMutation,\n52|            allowGroupTakeover: allowGroupTakeover,\n53|            allowReplace: allowReplace\n54|        )\n55|    }\n56|\n57|    var body: some View {\n58|        RunnerRegistrationPage(\n59|            props: .init(\n60|                phase: registration.phase,\n61|                working: registration.working,\n62|                scopeKind: scopeKind,\n63|                org: org,\n64|                repoOwner: repoOwner,\n65|                repoName: repoName,\n66|                runnerName: runnerName,\n67|                labelsText: labelsText,\n68|                installDirName: installDirName,\n69|                workFolder: workFolder,\n70|                groupName: groupName,\n71|                allowGroupMutation: allowGroupMutation,\n72|                allowGroupTakeover: allowGroupTakeover,\n73|                allowReplace: allowReplace,\n74|                selectedRepositoryIDs: selectedRepositoryIDs,\n75|                repositories: github.repositories,\n76|                installations: github.installations,\n77|                githubConnected: isConnected,\n78|                githubUsername: github.username,\n79|                group: registration.group,\n80|                groupRepositoryIDs: registration.groupRepositoryIDs,\n81|                assetFilename: registration.asset?.filename,\n82|                installPath: registration.installPath,\n83|                runnerID: registration.runnerID,\n84|                localAgentID: registration.localAgentID,\n85|                completedSteps: registration.completedSteps,\n86|                error: registration.error,\n87|                failedStep: registration.failedStep,\n88|                permissionError: registration.permissionError\n89|            ),\n90|            reactions: .init(\n91|                scopeKindChanged: { scopeKind = $0; pushDraft() },\n92|                orgChanged: { org = $0; pushDraft() },\n93|                repoOwnerChanged: { repoOwner = $0; pushDraft() },\n94|                repoNameChanged: { repoName = $0; pushDraft() },\n95|                runnerNameChanged: { runnerName = $0; pushDraft() },\n96|                labelsChanged: { labelsText = $0; pushDraft() },\n97|                installDirChanged: { installDirName = $0; pushDraft() },\n98|                workFolderChanged: { workFolder = $0; pushDraft() },\n99|                groupNameChanged: { groupName = $0; pushDraft() },\n100|                allowGroupMutationChanged: { allowGroupMutation = $0; pushDraft() },\n101|                allowGroupTakeoverChanged: { allowGroupTakeover = $0; pushDraft() },\n102|                allowReplaceChanged: { allowReplace = $0; pushDraft() },\n103|                repositoriesChanged: { ids in\n104|                    selectedRepositoryIDs = ids\n105|                    Task { await action { GitHubAuth.Effect.selectRepositories(ids) } }\n106|                    pushDraft()\n107|                },\n108|                beginDraft: { Task { await action { RunnerRegistration.Effect.beginDraft(currentDraft) } } },\n109|                resolveGroup: { Task { await action { RunnerRegistration.Effect.resolveGroup } } },\n110|                downloadAndInstall: { Task { await action { RunnerRegistration.Effect.downloadAndInstall } } },\n111|                registerRunner: { Task { await action { RunnerRegistration.Effect.registerRunner } } },\n112|                setupService: { Task { await action { RunnerRegistration.Effect.setupService } } },\n113|                applyRepositoryAccess: {\n114|                    let target = registration.group?.id ?? -1\n115|                    let effect = RunnerRegistration.Effect.applyRepositoryAccess(\n116|                        groupID: target, repositories: selectedRepositoryIDs\n117|                    )\n118|                    Task { await action { effect } }\n119|                },\n120|                applyLabels: {\n121|                    let labels = Self.parseLabels(labelsText)\n122|                    Task { await action { RunnerRegistration.Effect.applyLabels(labels) } }\n123|                },\n124|                retry: { Task { await action { RunnerRegistration.Effect.retry } } },\n125|                cancel: { Task { await action { RunnerRegistration.Effect.cancel } } },\n126|                reset: { Task { await action { RunnerRegistration.Effect.reset } } },\n127|                dismissPermission: { Task { await action { RunnerRegistration.Effect.dismissPermission } } },\n128|                close: close\n129|            )\n130|        )\n131|        .onAppear(perform: seedFromGitHub)\n132|    }\n133|\n134|    private var isConnected: Bool {\n135|        if case .connected = github.connection { return true }\n136|        return false\n137|    }\n138|\n139|    /// Pushes field edits into the draft once the wizard has begun, so step\n140|    /// buttons always run the visible values. Before the first begin the\n141|    /// draft does not exist yet and edits stay local.\n142|    private func pushDraft() {\n143|        guard registration.phase != .idle else { return }\n144|        let draft = currentDraft\n145|        Task { await action { RunnerRegistration.Effect.updateDraft(draft) } }\n146|    }\n147|\n148|    /// Seeds org/owner from the selected GitHub installation once.\n149|    private func seedFromGitHub() {\n150|        guard !seeded else { return }\n151|        seeded = true\n152|        if installDirName.isEmpty {\n153|            installDirName = (Host.current().localizedName ?? \"runner\")\n154|                .lowercased()\n155|                .replacingOccurrences(of: \" \", with: \"-\")\n156|        }\n157|        guard let id = github.selectedInstallationID,\n158|              let installation = github.installations.first(where: { $0.id == id }) else { return }\n159|        if org.isEmpty, installation.accountType == \"Organization\" {\n160|            org = installation.account\n161|            scopeKind = .organization\n162|        } else if repoOwner.isEmpty {\n163|            repoOwner = installation.account\n164|            scopeKind = .repository\n165|        }\n166|        if selectedRepositoryIDs.isEmpty {\n167|            selectedRepositoryIDs = github.selectedRepositoryIDs\n168|        }\n169|    }\n170|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
