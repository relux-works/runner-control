{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d665","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":2445,"recorded_at":1780531400004885,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8c1-78f6-7092-a5db-76451aacb7c1"},"task_id":"01a0a8c1-78f6-7092-a5db-76451aacb7c1","event":{"kind":"output","task_id":"01a0a8c1-78f6-7092-a5db-76451aacb7c1","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(2248 line(s) above)\n2249|    )\n2250|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2251|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2252|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2253|    // First runners-list call (duplicate guard) trips the latch; release it\n2254|    // immediately so registration completes, then re-latch is unnecessary:\n2255|    // the latch fires once, so suspend the labels fetch with a fresh latch.\n2256|    await latch.release()\n2257|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n2258|    // Fresh latch for the labels step: rebuild the flow-bound latch by\n2259|    // suspending via a second wrapper is unnecessary — instead verify the\n2260|    // sequential rename refusal, which shares the same generation gate.\n2261|    var renamed = orgDraft()\n2262|    renamed.runnerName = \"renamed-runner\"\n2263|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(renamed))\n2264|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"]))\n2265|    #expect(lastFailure(harness.logger)?.step == \"applyLabels\")\n2266|    #expect(await inner.requests.filter { $0.method == \"PUT\" }.isEmpty)\n2267|}\n2268|\n2269|@Test @MainActor func nonIdentityEditDuringInstallDoesNotCancel() async throws {\n2270|    // Editable selections never abandon in-flight work: a labels edit while\n2271|    // downloading still completes the install for the visible draft.\n2272|    let package = try await FixturePackage.make()\n2273|    let latch = ReviewDownloadLatch()\n2274|    let transport = TestTransport([downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))])\n2275|    let harness = await registrationHarness(transport: transport, downloader: { _ in await latch.download(package.bytes) })\n2276|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2277|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2278|    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2279|    await latch.waitStarted()\n2280|    var edited = orgDraft()\n2281|    edited.labels = [\"self-hosted\", \"macOS\", \"gpu\"]\n2282|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2283|    await latch.release()\n2284|    _ = await operation.value\n2285|    let state = RunnerRegistration.State()\n2286|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2287|    #expect(state.draft?.labels.contains(\"gpu\") == true)\n2288|    #expect(state.installPath != nil)\n2289|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n2290|}\n2291|\n2292|@Test func serverChangeBetweenStepsInvalidatesGroupAndRunner() async throws {\n2293|    // R3-F2 session class: after resolving on github.com, the session moves\n2294|    // to another server. Cached group/runner progress must not authorize\n2295|    // writes there; the step re-resolves instead of reusing.\n2296|    let transport = TestTransport([\n2297|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n2298|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n2299|    ])\n2300|    let harness = await registrationHarness(transport: transport)\n2301|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2302|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n2303|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n2304|    await harness.identities.save(GitHubSessionIdentity(serverHost: \"enterprise.example\", userID: 7, clientID: testConfig.clientID, username: \"octo\"))\n2305|    try? await harness.userStore.save(\n2306|        GitHubAuth.TokenRecord(accessToken: \"enterprise-token\", refreshToken: \"refresh-e\", expiresAt: Date().addingTimeInterval(3600)),\n2307|        serverHost: \"enterprise.example\", userID: 7, clientID: testConfig.clientID\n2308|    )\n(more lines below)","final_result":true}}}
