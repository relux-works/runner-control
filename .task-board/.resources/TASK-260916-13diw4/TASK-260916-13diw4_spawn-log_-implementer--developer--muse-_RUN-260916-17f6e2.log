{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c55d","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":265,"recorded_at":1780531400000525,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"call_id":"call_01a0a8b34d0072309c39158392136059","text":"Read text file `/tmp/rev34/attacks-rev3.swift`.\n1|\n2|private actor ReviewDownloadLatch {\n3|    var started = false\n4|    var waiter: CheckedContinuation<Void, Never>?\n5|    var releaseWaiter: CheckedContinuation<Void, Never>?\n6|    func download(_ bytes: Data) async -> Data {\n7|        started = true\n8|        waiter?.resume(); waiter = nil\n9|        await withCheckedContinuation { releaseWaiter = $0 }\n10|        return bytes\n11|    }\n12|    func waitStarted() async {\n13|        if started { return }\n14|        await withCheckedContinuation { waiter = $0 }\n15|    }\n16|    func release() { releaseWaiter?.resume(); releaseWaiter = nil }\n17|}\n18|\n19|@Test @MainActor func reviewerInFlightInstallCannotRepopulateChangedDraft() async throws {\n20|    let package = try await FixturePackage.make()\n21|    let latch = ReviewDownloadLatch()\n22|    let transport = TestTransport([downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))])\n23|    let harness = await registrationHarness(transport: transport, downloader: { _ in await latch.download(package.bytes) })\n24|    defer { try? FileManager.default.removeItem(at: harness.home) }\n25|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n26|    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n27|    await latch.waitStarted()\n28|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(repoDraft(dir: \"new-install\")))\n29|    await latch.release()\n30|    _ = await operation.value\n31|    let state = RunnerRegistration.State()\n32|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n33|    #expect(state.draft?.installDirName == \"new-install\")\n34|    #expect(state.installPath == nil, \"Old async install must not attest the new draft\")\n35|    #expect(!state.completedSteps.contains(\"downloadAndInstall\"))\n36|}\n37|\n38|@Test func reviewerForeignServerIdentityCannotAuthorizeLabels() async throws {\n39|    let package = try await FixturePackage.make(withRealConfigScript: false)\n40|    let transport = TestTransport([\n41|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n42|        runnersListPayload([]),\n43|        jsonResponse([\"token\": \"REG-SECRET\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n44|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n45|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n46|        jsonResponse([\"labels\": [[\"name\": \"gpu\"]]])\n47|    ])\n48|    let harness = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: SplitExecutor())\n49|    defer { try? FileManager.default.removeItem(at: harness.home) }\n50|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n51|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n52|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n53|    let directory = await harness.installer.directory(for: \"macbook-test\")\n54|    try Data(#\"{\"agentId\":4242,\"agentName\":\"macbook-test\",\"gitHubUrl\":\"https://enterprise.example/acme\",\"workFolder\":\"_work\"}\"#.utf8).write(to: directory.appendingPathComponent(\".runner\"))\n55|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"]))\n56|    #expect(await transport.requests.filter { $0.method == \"PUT\" }.isEmpty, \"Foreign server ID must not authorize github.com writes\")\n57|    #expect(lastFailure(harness.logger)?.step == \"applyLabels\")\n58|}\n59|\n60|@Test func reviewerChangedWorkFolderCannotReuseConfiguredSuccess() async throws {\n61|    let package = try await FixturePackage.make(withRealConfigScript: false)\n62|    let transport = TestTransport([\n63|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n64|        runnersListPayload([]),\n65|        jsonResponse([\"token\": \"REG-SECRET\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n66|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n67|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]])\n68|    ])\n69|    let harness = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: SplitExecutor())\n70|    defer { try? FileManager.default.removeItem(at: harness.home) }\n71|    var draft = orgDraft()\n72|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n73|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n74|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n75|    draft.workFolder = \"new_work\"\n76|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(draft))\n77|    let before = registrationActions(harness.logger).count\n78|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n79|    let after = Array(registrationActions(harness.logger).dropFirst(before))\n80|    #expect(!after.contains { if case .registered = $0 { true } else { false } }, \"Old _work configuration is not new_work success\")\n81|    #expect(lastFailure(harness.logger)?.step == \"registerRunner\")\n82|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
