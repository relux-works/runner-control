matches on GitHub alone\n263|    /// never count as ownership, and ownership on one server never\n264|    /// authorizes adoption on another.\n265|    public func loadOwnedGroupID(serverHost: String, org: String, name: String) -> Int64? {\n266|        guard let data = try? Data(contentsOf: ownershipFile()),\n267|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n268|        return table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)]\n269|    }\n270|\n271|    public func saveOwnedGroupID(serverHost: String, org: String, name: String, groupID: Int64) throws {\n272|        let file = ownershipFile()\n273|        var table: [String: Int64] = [:]\n274|        if let data = try? Data(contentsOf: file),\n275|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n276|            table = decoded\n277|        }\n278|        table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)] = groupID\n279|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n280|        let data = try JSONEncoder().encode(table)\n281|        try data.write(to: file, options: .atomic)\n282|    }\n283|\n284|    /// Reads the local `.runner` identity without touching credentials.\n285|    /// Returns nil only when the file is missing or unparseable; a present\n286|    /// but incomplete file returns a partial struct so verification can name\n287|    /// the exact missing field instead of crashing.\n288|    public func readLocalRegistration(directory: URL) -> RunnerRegistration.LocalRegistration? {\n289|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n290|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n291|        var agentID: Int64?\n292|        if let id = object[\"agentId\"] as? Int64 { agentID = id }\n293|        else if let id = object[\"agentId\"] as? Int { agentID = Int64(id) }\n294|        else if let id = object[\"agentId\"] as? NSNumber { agentID = id.int64Value }\n295|        return RunnerRegistration.LocalRegistration(\n296|            agentID: agentID,\n297|            agentName: object[\"agentName\"] as? String,\n298|            gitHubURL: object[\"gitHubUrl\"] as? String,\n(more lines below)","final_result":true}}}
