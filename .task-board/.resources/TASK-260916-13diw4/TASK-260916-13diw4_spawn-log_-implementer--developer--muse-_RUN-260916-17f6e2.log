{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf91","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":1571,"recorded_at":1780531400003137,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8bc-0a71-7610-85c9-2456d6578cfd"},"task_id":"01a0a8bc-0a71-7610-85c9-2456d6578cfd","event":{"kind":"output","task_id":"01a0a8bc-0a71-7610-85c9-2456d6578cfd","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n(631 line(s) above)\n632|    }\n633|\n634|    // MARK: - Service\n635|\n636|    private func setupService() async {\n637|        let gen = generation\n638|        guard !working else { return }\n639|        guard let draft, let installPath else {\n640|            failedStep = \"setupService\"\n641|            await action {\n642|                RunnerRegistration.Action.failed(message: \"Register the runner first.\", step: \"setupService\")\n643|            }\n644|            return\n645|        }\n646|        // Service setup never declares registration complete on its own: it\n647|        // requires this operation's verified configured local identity.\n648|        let directory = URL(fileURLWithPath: installPath)\n649|        do {\n650|            let local = await installer.readLocalRegistration(directory: directory)\n651|            let configured = await installer.hasCompleted(\n652|                RunnerInstallerService.stepConfigured, directory: directory\n653|            )\n654|            _ = try RunnerRegistration.Gates.verifiedLocalAgentID(\n655|                local: local, configured: configured, draft: draft\n656|            )\n657|        } catch {\n658|            failedStep = \"setupService\"\n659|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"setupService\") }\n660|            return\n661|        }\n662|        working = true\n663|        await action { RunnerRegistration.Action.stepStarted(\"setupService\") }\n664|        do {\n665|            let label = Self.serviceLabel(draft: draft)\n666|            let plist = try await installer.setupService(directory: directory, label: label)\n667|            guard !isStale(gen) else { return }\n668|            await action { RunnerRegistration.Action.serviceReady(plistPath: plist.path) }\n669|            await finishStep(\"setupService\", generation: gen)\n670|        } catch {\n671|            working = false\n672|            await fail(error, step: \"setupService\", generation: gen)\n673|        }\n674|    }\n675|\n676|    // MARK: - Editable access and labels\n677|\n678|    private func applyRepositoryAccess(groupID: Int64, ids: Set<Int64>) async {\n679|        let gen = generation\n680|        guard !working else { return }\n681|        guard let draft else {\n682|            await action {\n683|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyRepositoryAccess\")\n684|            }\n685|            return\n686|        }\n687|        do {\n688|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n689|            guard case .organization(let org) = draft.scope else { return }\n690|            guard let group else {\n691|                failedStep = \"applyRepositoryAccess\"\n692|                await action {\n693|                    RunnerRegistration.Action.failed(\n694|                        message: \"Resolve the dedicated group first.\", step: \"applyRepositoryAccess\"\n695|                    )\n696|                }\n697|                return\n698|            }\n699|            try RunnerRegistration.Gates.authorizeGroupMutation(\n700|                targetGroupID: groupID, resolvedGroupID: group.id,\n701|                allowFlag: draft.allowGroupMutation\n702|            )\n703|            working = true\n704|            pendingRepositoryIDs = ids\n705|            pendingTargetGroupID = groupID\n706|            await action { RunnerRegistration.Action.stepStarted(\"applyRepositoryAccess\") }\n707|            let auth = try await currentUserToken(generation: gen)\n708|            guard !isStale(gen) else { return }\n709|            try await api.setGroupRepositories(\n710|                config: auth.config, token: auth.token, org: org, groupID: group.id, selectedRepositoryIDs: ids\n711|            )\n712|            guard !isStale(gen) else { return }\n713|            let confirmed = try await api.fetchGroupRepositories(\n714|                config: auth.config, token: auth.token, org: org, groupID: group.id\n715|            )\n716|            guard !isStale(gen) else { return }\n717|            // The confirmed list is complete (every page followed). It must\n718|            // equal the request exactly; otherwise the draft keeps the\n719|            // requested selection and the step fails instead of claiming a\n720|            // partial write as success.\n721|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: ids, confirmed: confirmed)\n722|            if var current = self.draft {\n723|                current.selectedRepositoryIDs = Set(confirmed)\n724|                self.draft = current\n725|            }\n726|            await action { RunnerRegistration.Action.repositoryAccessApplied(confirmed) }\n727|            guard !isStale(gen) else { return }\n728|            await action { RunnerRegistration.Action.permissionDismissed }\n729|            pendingRepositoryIDs = nil\n730|            pendingTargetGroupID = nil\n731|            await finishStep(\"applyRepositoryAccess\", generation: gen)\n732|        } catch {\n733|            working = false\n734|            await fail(error, step: \"applyRepositoryAccess\", generation: gen)\n735|        }\n736|    }\n737|\n738|    private func applyLabels(_ labels: [String]) async {\n739|        let gen = generation\n740|        guard !working else { return }\n741|        guard let draft else {\n742|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyLabels\") }\n743|            return\n744|        }\n745|        let trimmed = labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }\n746|        guard !trimmed.isEmpty else {\n747|            failedStep = \"applyLabels\"\n748|            await action {\n749|                RunnerRegistration.Action.failed(message: \"At least one label is required.\", step: \"applyLabels\")\n750|            }\n751|            return\n752|        }\n753|        // Label writes require this operation's verified local identity —\n754|        // checked before any network. A remote name match alone never\n755|        // authorizes mutating another runner.\n756|        guard let installPath else {\n757|            failedStep = \"applyLabels\"\n758|            await action {\n759|                RunnerRegistration.Action.failed(\n760|                    message: \"Register the runner first so labels target this installation.\",\n761|                    step: \"applyLabels\"\n762|                )\n763|            }\n764|            return\n765|        }\n766|        let directory = URL(fileURLWithPath: installPath)\n767|        let localAgentID: Int64\n768|        do {\n769|            let local = await installer.readLocalRegistration(directory: directory)\n770|            let configured = await installer.hasCompleted(\n771|                RunnerInstallerService.stepConfigured, directory: directory\n772|            )\n773|            localAgentID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n774|                local: local, configured: configured, draft: draft\n775|            )\n776|        } catch {\n777|            failedStep = \"applyLabels\"\n778|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"applyLabels\") }\n779|            return\n780|        }\n781|        working = true\n782|        pendingLabels = trimmed\n783|        await action { RunnerRegistration.Action.stepStarted(\"applyLabels\") }\n784|        do {\n785|            // Re-bind on every write: the stored ID is never trusted across\n786|            // edits, retries, or remote drift. A missing agent fails with\n787|            // not-found; a contradictory list fails with mismatch. Neither\n788|            // guesses by name.\n789|            let auth = try await currentUserToken(generation: gen)\n790|            guard !isStale(gen) else { return }\n791|            let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n792|            guard !isStale(gen) else { return }\n793|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n794|            let bound = try RunnerRegistration.Gates.boundRemoteRunnerID(\n795|                localAgentID: localAgentID, name: wanted, runners: runners\n796|            )\n797|            guard let runnerID = bound else {\n798|                throw RunnerRegistration.RegistrationError.remoteRunnerNotFound(\n799|                    \"GitHub does not list agent \\(localAgentID) for this scope yet; refusing to guess '\\(wanted)' by name. Retry after registration converges.\"\n800|                )\n801|            }\n802|            try await api.setRunnerLabels(\n803|                config: auth.config, token: auth.token, scope: draft.scope, runnerID: runnerID, labels: trimmed\n804|            )\n805|            guard !isStale(gen) else { return }\n806|            self.runnerID = runnerID\n807|            if var current = self.draft {\n808|                current.labels = trimmed\n809|                self.draft = current\n810|            }\n811|            await action { RunnerRegistration.Action.labelsApplied(trimmed) }\n812|            pendingLabels = nil\n813|            await finishStep(\"applyLabels\", generation: gen)\n814|        } catch {\n815|            working = false\n816|            await fail(error, step: \"applyLabels\", generation: gen)\n817|        }\n818|    }\n819|\n820|    // MARK: - Retry / cancel / reset\n821|\n822|    private func retry() async {\n823|        guard !working else { return }\n824|        guard let step = failedStep else { return }\n825|        switch step {\n826|        case \"resolveGroup\": await resolveGroup()\n827|        case \"prepareDownload\": await prepareDownload()\n828|        case \"downloadAndInstall\": await downloadAndInstall()\n829|        case \"registerRunner\": await registerRunner()\n830|        case \"setupService\": await setupService()\n831|        case \"applyRepositoryAccess\":\n832|            if let ids = pendingRepositoryIDs, let target = pendingTargetGroupID {\n833|                await applyRepositoryAccess(groupID: target, ids: ids)\n834|            }\n835|        case \"applyLabels\":\n836|            if let labels = pendingLabels { await applyLabels(labels) }\n837|        default:\n838|            return\n839|        }\n840|    }\n841|\n842|    private func cancel() async {\n843|        generation += 1\n844|        working = false\n845|        if let draft {\n846|            await registrationTokens.delete(scopeKey: Self.tokenScopeKey(draft: draft))\n847|        }\n848|        failedStep = nil\n849|        pendingRepositoryIDs = nil\n850|        pendingTargetGroupID = nil\n851|        pendingLabels = nil\n(more lines below)","final_result":true}}}
