{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb5f","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":1034,"recorded_at":1780531400002063,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8b9-de4d-7cf1-bf78-0c6781ca214e"},"task_id":"01a0a8b9-de4d-7cf1-bf78-0c6781ca214e","event":{"kind":"output","task_id":"01a0a8b9-de4d-7cf1-bf78-0c6781ca214e","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n(89 line(s) above)\n90|    }\n91|\n92|    public func markCompleted(\n93|        _ step: String, directory: URL, scopeKey: String,\n94|        serverHost: String? = nil, groupName: String? = nil\n95|    ) throws {\n96|        var marker = loadMarker(directory: directory) ?? Marker(scopeKey: scopeKey)\n97|        marker.completedSteps.insert(step)\n98|        if let serverHost { marker.serverHost = serverHost }\n99|        if let groupName { marker.groupName = groupName }\n100|        try storeMarker(marker, directory: directory)\n101|    }\n102|\n103|    public func hasCompleted(_ step: String, directory: URL) -> Bool {\n104|        loadMarker(directory: directory)?.completedSteps.contains(step) == true\n105|    }\n106|\n107|    // MARK: - Install\n108|\n109|    /// Downloads, verifies, and extracts the official package. Idempotent:\n110|    /// a completed `installed` marker with matching scope skips the work.\n111|    /// Refuses to overwrite an already-registered directory (no duplicates).\n112|    public func downloadAndInstall(\n113|        asset: RunnerRegistration.DownloadAsset,\n114|        draft: RunnerRegistration.Draft\n115|    ) async throws -> URL {\n116|        try RunnerRegistration.Gates.validateNoSpace(\n117|            installDirName: draft.installDirName, workFolder: draft.workFolder\n118|        )\n119|        let directory = self.directory(for: draft.installDirName)\n120|        if directory.path.contains(\" \") {\n121|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n122|        }\n123|        let files = FileManager.default\n124|        if let marker = loadMarker(directory: directory),\n125|           marker.completedSteps.contains(Self.stepInstalled),\n126|           marker.scopeKey == draft.scope.scopeKey,\n127|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n128|            return directory\n129|        }\n130|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n131|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: draft.runnerName)\n132|        }\n133|        let bytes: Data\n134|        do {\n135|            bytes = try await downloader(asset.downloadURL)\n136|        } catch {\n137|            throw RunnerRegistration.RegistrationError.network(\"Runner download failed: \\(error.localizedDescription)\")\n138|        }\n139|        // Fail closed: the official downloads endpoint documents\n140|        // `sha256_checksum`, and an install without a verified digest is\n141|        // refused rather than trusted on TLS alone.\n142|        guard let expected = asset.sha256Checksum, !expected.isEmpty else {\n143|            throw RunnerRegistration.RegistrationError.integrityMismatch\n144|        }\n145|        let actual = hasher(bytes)\n146|        guard actual.lowercased() == expected.lowercased() else {\n147|            throw RunnerRegistration.RegistrationError.integrityMismatch\n148|        }\n149|        try files.createDirectory(at: directory, withIntermediateDirectories: true)\n150|        let archive = files.temporaryDirectory.appendingPathComponent(UUID().uuidString + \"-\" + asset.filename)\n151|        defer { try? files.removeItem(at: archive) }\n152|        try bytes.write(to: archive, options: .atomic)\n153|        let result = try await executor.run(\"/usr/bin/tar\", [\"-xzf\", archive.path, \"-C\", directory.path])\n154|        guard result.code == 0 else {\n155|            throw RunnerRegistration.RegistrationError.network(\n156|                \"Runner archive extraction failed: \\(String(result.output.prefix(300)))\"\n157|            )\n158|        }\n159|        // Official packages keep runsvc.sh under bin/ until svc.sh installs it;\n160|        // a bare extraction leaves the root copy absent, so install it here.\n161|        try installRunsvc(directory: directory)\n162|        try markCompleted(Self.stepDownloaded, directory: directory, scopeKey: draft.scope.scopeKey)\n163|        try markCompleted(Self.stepInstalled, directory: directory, scopeKey: draft.scope.scopeKey)\n164|        return directory\n165|    }\n166|\n167|    /// Copies official `bin/runsvc.sh` into the installation root and makes\n168|    /// it executable, mirroring what official `svc.sh install` would do.\n169|    public func installRunsvc(directory: URL) throws {\n170|        let files = FileManager.default\n171|        let source = directory.appendingPathComponent(\"bin/runsvc.sh\")\n172|        let target = directory.appendingPathComponent(\"runsvc.sh\")\n173|        guard files.fileExists(atPath: source.path) else {\n174|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing bin/runsvc.sh.\")\n175|        }\n176|        if files.fileExists(atPath: target.path) {\n177|            try files.removeItem(at: target)\n178|        }\n179|        try files.copyItem(at: source, to: target)\n180|        try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: target.path)\n181|    }\n182|\n183|    // MARK: - Configure\n184|\n185|    /// Runs the exact `config.sh` invocation. Skips when a previous attempt\n186|    /// already registered this directory (marker + `.runner` present), so\n187|    /// retries never create orphan or duplicate GitHub registrations.\n188|    /// Returns the local agent ID read back from `.runner`.\n189|    @discardableResult\n190|    public func runConfig(\n191|        directory: URL,\n192|        scopeURL: String,\n193|        token: String,\n194|        draft: RunnerRegistration.Draft,\n195|        runnerGroup: String?\n196|    ) async throws -> Int64? {\n197|        try await runConfig(\n198|            directory: directory, scopeURL: scopeURL, token: token,\n199|            draft: draft, runnerGroup: runnerGroup, replace: draft.allowReplace\n200|        )\n201|    }\n202|\n203|    /// Explicit-`replace` variant. Production callers pass\n204|    /// `draft.allowReplace`; tests drive both values.\n205|    @discardableResult\n206|    public func runConfig(\n207|        directory: URL,\n208|        scopeURL: String,\n209|        token: String,\n210|        draft: RunnerRegistration.Draft,\n211|        runnerGroup: String?,\n212|        replace: Bool\n213|    ) async throws -> Int64? {\n214|        let files = FileManager.default\n215|        if hasCompleted(Self.stepConfigured, directory: directory),\n216|           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n217|            return readAgentID(directory: directory)\n218|        }\n219|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n220|           hasCompleted(Self.stepConfigured, directory: directory) {\n221|            return readAgentID(directory: directory)\n222|        }\n223|        let spec = RunnerRegistration.ConfigSpec(\n224|            scopeURL: scopeURL, token: token, name: draft.runnerName,\n225|            workFolder: draft.workFolder, labels: draft.labels,\n226|            runnerGroup: runnerGroup, replace: replace\n227|        )\n228|        let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n229|        let executable = directory.appendingPathComponent(\"config.sh\").path\n230|        guard files.fileExists(atPath: executable) else {\n231|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n232|        }\n233|        let result = try await executor.run(executable, args)\n234|        guard result.code == 0 else {\n235|            // Never echo the token: config output may repeat arguments.\n236|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [token])\n237|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n238|        }\n239|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n(more lines below)","final_result":true}}}
