     boundServerHost = normalized\n+            return false\n+        }\n+        boundServerHost = normalized\n+        return true\n+    }\n+\n+    private func fail(_ error: Error, step: String, generation gen: Int) async {\n+        guard !isStale(gen) else { return }\n+        failedStep = step\n+        if error is CancellationError { return }\n","final_result":true}}}
