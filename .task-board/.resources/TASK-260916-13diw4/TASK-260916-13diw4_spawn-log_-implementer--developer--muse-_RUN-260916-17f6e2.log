{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c79f","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":554,"recorded_at":1780531400001103,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"call_id":"call_01a0a8b3eb1b763c950bc69473f5afef","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubRunnerAPIClient.swift`.\n1|import Foundation\n2|\n3|/// GitHub REST client for self-hosted runner registration. Takes the user\n4|/// token explicitly per call; never stores it.\n5|public actor GitHubRunnerAPIClient {\n6|    private let transport: any GitHubHTTPTransport\n7|\n8|    public init(transport: any GitHubHTTPTransport) {\n9|        self.transport = transport\n10|    }\n11|\n12|    private func authorizedHeaders(token: String) throws -> [String: String] {\n13|        let header: String\n14|        do {\n15|            header = try GitHubAuth.PATGuard.authorizationHeader(token: token)\n16|        } catch {\n17|            throw GitHubAuth.AuthError.patNotSupported\n18|        }\n19|        return [\"Accept\": \"application/vnd.github+json\", \"Authorization\": header]\n20|    }\n21|\n22|    /// Builds a list URL with real query items. Query strings must never be\n23|    /// smuggled through `appendingPathComponent`: Foundation percent-encodes\n24|    /// the `?` into the path (`%3F`) and GitHub never sees the parameters.\n25|    private func listURL(\n26|        config: GitHubAuth.AppConfig, path: String, queryItems: [URLQueryItem]\n27|    ) throws -> URL {\n28|        let base = config.apiBaseURL.appendingPathComponent(path)\n29|        guard var components = URLComponents(url: base, resolvingAgainstBaseURL: false) else {\n30|            throw RunnerRegistration.RegistrationError.network(\"Invalid GitHub API URL for \\(path).\")\n31|        }\n32|        components.queryItems = queryItems\n33|        guard let url = components.url else {\n34|            throw RunnerRegistration.RegistrationError.network(\"Invalid GitHub API URL for \\(path).\")\n35|        }\n36|        return url\n37|    }\n38|\n39|    private func send(\n40|        method: String,\n41|        config: GitHubAuth.AppConfig,\n42|        path: String,\n43|        token: String,\n44|        body: Data? = nil\n45|    ) async throws -> GitHubHTTPResponse {\n46|        let url = config.apiBaseURL.appendingPathComponent(path)\n47|        return try await perform(method: method, url: url, token: token, body: body)\n48|    }\n49|\n50|    private func perform(\n51|        method: String,\n52|        url: URL,\n53|        token: String,\n54|        body: Data? = nil\n55|    ) async throws -> GitHubHTTPResponse {\n56|        let headers = try authorizedHeaders(token: token)\n57|        var all = headers\n58|        if body != nil { all[\"Content-Type\"] = \"application/json\" }\n59|        let request = GitHubHTTPRequest(\n60|            method: method,\n61|            url: url,\n62|            headers: all,\n63|            body: body\n64|        )\n65|        let response: GitHubHTTPResponse\n66|        do {\n67|            response = try await transport.send(request)\n68|        } catch {\n69|            throw RunnerRegistration.RegistrationError.network(\n70|                GitHubTransportError.offline.localizedDescription\n71|            )\n72|        }\n73|        switch response.status {\n74|        // 204 is the documented success for PUT …/repositories; rejecting\n75|        // it fails every production repository-access update (review F2).\n76|        case 200, 201, 204:\n77|            return response\n78|        case 401:\n79|            throw RunnerRegistration.RegistrationError.unauthorized\n80|        case 403:\n81|            throw RunnerRegistration.RegistrationError.forbidden(\n82|                String(String(decoding: response.body, as: UTF8.self).prefix(300))\n83|            )\n84|        case 404:\n85|            throw RunnerRegistration.RegistrationError.network(\"GitHub resource not found (404): \\(url.path).\")\n86|        case 422:\n87|            throw RunnerRegistration.RegistrationError.network(\n88|                \"GitHub rejected the request (422): \" +\n89|                    String(String(decoding: response.body, as: UTF8.self).prefix(300))\n90|            )\n91|        default:\n92|            if response.status == 429\n93|                || String(decoding: response.body, as: UTF8.self).lowercased().contains(\"rate limit\") {\n94|                throw RunnerRegistration.RegistrationError.rateLimited\n95|            }\n96|            throw RunnerRegistration.RegistrationError.network(\n97|                \"GitHub request failed (HTTP \\(response.status)).\"\n98|            )\n99|        }\n100|    }\n101|\n102|    private func decode<T: Decodable>(_ type: T.Type, from response: GitHubHTTPResponse) throws -> T {\n103|        do {\n104|            return try JSONDecoder().decode(type, from: response.body)\n105|        } catch {\n106|            throw RunnerRegistration.RegistrationError.network(\n107|                GitHubTransportError.invalidResponse.localizedDescription\n108|            )\n109|        }\n110|    }\n111|\n112|    // MARK: - Pagination (complete lists, never first-page-only)\n113|\n114|    private static let listPageSize = \"100\"\n115|    /// Hard stop against a non-terminating `Link` chain. Any failure —\n116|    /// including hitting this cap — throws, so a partial list is never\n117|    /// presented as a complete confirmation.\n118|    private static let maxListPages = 100\n119|\n120|    private static func listQuery() -> [URLQueryItem] {\n121|        [URLQueryItem(name: \"per_page\", value: listPageSize)]\n122|    }\n123|\n124|    /// Parses the `Link` header's `rel=\"next\"` URL. Returns nil when there is\n125|    /// no next page. Refuses non-HTTPS or off-host URLs instead of following\n126|    /// a crafted redirect.\n127|    static func nextPageURL(headers: [String: String], allowedHost: String?) -> URL? {\n128|        guard let link = headers.first(where: { $0.key.lowercased() == \"link\" })?.value else { return nil }\n129|        for part in link.split(separator: \",\") {\n130|            let segments = part.split(separator: \";\").map {\n131|                $0.trimmingCharacters(in: .whitespacesAndNewlines)\n132|            }\n133|            guard segments.count >= 2 else { continue }\n134|            let raw = segments[0]\n135|            guard raw.hasPrefix(\"<\"), raw.hasSuffix(\">\") else { continue }\n136|            let candidate = String(raw.dropFirst().dropLast())\n137|            let isNext = segments.dropFirst().contains {\n138|                $0.replacingOccurrences(of: \"\\\"\", with: \"\").replacingOccurrences(of: \"'\", with: \"\") == \"rel=next\"\n139|            }\n140|            guard isNext, let url = URL(string: candidate) else { continue }\n141|            guard url.scheme == \"https\",\n142|                  url.host?.lowercased() == allowedHost?.lowercased() else { continue }\n143|            return url\n144|        }\n145|        return nil\n146|    }\n147|\n148|    /// Follows every page of a list endpoint, starting at `path`. Throws on\n149|    /// any failed page so callers fail closed instead of acting on a partial\n150|    /// list.\n151|    private func getAllPages(\n152|        config: GitHubAuth.AppConfig,\n153|        path: String,\n154|        token: String\n155|    ) async throws -> [GitHubHTTPResponse] {\n156|        var pages: [GitHubHTTPResponse] = []\n157|        var url: URL? = try listURL(config: config, path: path, queryItems: Self.listQuery())\n158|        while let current = url {\n159|            guard pages.count < Self.maxListPages else {\n160|                throw RunnerRegistration.RegistrationError.network(\n161|                    \"GitHub list pagination did not terminate for \\(path).\"\n162|                )\n163|            }\n164|            let response = try await perform(method: \"GET\", url: current, token: token)\n165|            pages.append(response)\n166|            url = Self.nextPageURL(headers: response.headers, allowedHost: config.apiBaseURL.host)\n167|        }\n168|        return pages\n169|    }\n170|\n171|    // MARK: - Downloads\n172|\n173|    public func fetchDownloads(\n174|        config: GitHubAuth.AppConfig,\n175|        token: String,\n176|        scope: RunnerRegistration.Scope\n177|    ) async throws -> [RunnerRegistration.DownloadAsset] {\n178|        let response: GitHubHTTPResponse\n179|        do {\n180|            response = try await send(\n181|                method: \"GET\", config: config,\n182|                path: \"\\(scope.apiPrefix)/actions/runners/downloads\", token: token\n183|            )\n184|        } catch let error as RunnerRegistration.RegistrationError {\n185|            if case .forbidden(let text) = error {\n186|                throw RunnerRegistration.RegistrationError.missingPermission(readHelp(scope: scope, detail: text))\n187|            }\n188|            throw error\n189|        }\n190|        let decoded = try decode([RunnerDownloadDTO].self, from: response)\n191|        return decoded.compactMap { dto -> RunnerRegistration.DownloadAsset? in\n192|            guard let url = URL(string: dto.downloadURL) else { return nil }\n193|            return .init(\n194|                osName: dto.osName, architecture: dto.architecture,\n195|                downloadURL: url, filename: dto.filename,\n196|                sha256Checksum: dto.sha256Checksum\n197|            )\n198|        }\n199|    }\n200|\n201|    // MARK: - Registration token (short-lived, single use)\n202|\n203|    public func createRegistrationToken(\n204|        config: GitHubAuth.AppConfig,\n205|        token: String,\n206|        scope: RunnerRegistration.Scope\n207|    ) async throws -> (token: String, expiresAt: Date?) {\n208|        let response: GitHubHTTPResponse\n209|        do {\n210|            response = try await send(\n211|                method: \"POST\", config: config,\n212|                path: \"\\(scope.apiPrefix)/actions/runners/registration-token\", token: token\n213|            )\n214|        } catch let error as RunnerRegistration.RegistrationError {\n215|            if case .forbidden(let text) = error {\n216|                throw RunnerRegistration.RegistrationError.missingPermission(permissionHelp(scope: scope, detail: text))\n217|            }\n218|            throw error\n219|        }\n220|        let decoded = try decode(RegistrationTokenDTO.self, from: response)\n221|        guard !decoded.token.isEmpty else {\n222|            throw RunnerRegistration.RegistrationError.network(\n223|                GitHubTransportError.invalidResponse.localizedDescription\n224|            )\n225|        }\n226|        var expiresAt: Date?\n227|        if let raw = decoded.expiresAt {\n228|            expiresAt = ISO8601DateFormatter().date(from: raw)\n229|        }\n230|        return (decoded.token, expiresAt)\n231|    }\n232|\n233|    private func permissionHelp(scope: RunnerRegistration.Scope, detail: String) -> String {\n234|        writeHelp(scope: scope, detail: detail)\n235|    }\n236|\n237|    private func readHelp(scope: RunnerRegistration.Scope, detail: String) -> String {\n238|        let need: String\n239|        switch scope {\n240|        case .organization:\n241|            need = \"Self-hosted runners/read for the organization\"\n242|        case .repository:\n243|            need = \"Administration/read for the repository\"\n244|        }\n245|        let suffix = detail.isEmpty ? \"\" : \" GitHub says: \\(detail)\"\n246|        return \"Missing permission: \\(need).\\(suffix)\"\n247|    }\n248|\n249|    private func writeHelp(scope: RunnerRegistration.Scope, detail: String) -> String {\n250|        let need: String\n251|        switch scope {\n252|        case .organization:\n253|            need = \"Self-hosted runners/write for the organization\"\n254|        case .repository:\n255|            need = \"Administration/write for the repository\"\n256|        }\n257|        let suffix = detail.isEmpty ? \"\" : \" GitHub says: \\(detail)\"\n258|        return \"Missing permission: \\(need).\\(suffix)\"\n259|    }\n260|\n261|    private func groupReadHelp(org: String, detail: String) -> String {\n262|        let suffix = detail.isEmpty ? \"\" : \" GitHub says: \\(detail)\"\n263|        return \"Missing permission: Self-hosted runners/read for the organization \\(org).\\(suffix)\"\n264|    }\n265|\n266|    // MARK: - Runners (fetch real IDs)\n267|\n268|    public func fetchRunners(\n269|        config: GitHubAuth.AppConfig,\n270|        token: String,\n271|        scope: RunnerRegistration.Scope\n272|    ) async throws -> [RunnerRegistration.RegisteredRunner] {\n273|        let pages: [GitHubHTTPResponse]\n274|        do {\n275|            pages = try await getAllPages(\n276|                config: config,\n277|                path: \"\\(scope.apiPrefix)/actions/runners\", token: token\n278|            )\n279|        } catch let error as RunnerRegistration.RegistrationError {\n280|            if case .forbidden(let text) = error {\n281|                throw RunnerRegistration.RegistrationError.missingPermission(readHelp(scope: scope, detail: text))\n282|            }\n283|            throw error\n284|        }\n285|        return try pages.flatMap { page in\n286|            try decode(RunnersListDTO.self, from: page).runners.map {\n287|                RunnerRegistration.RegisteredRunner(id: $0.id, name: $0.name, labels: $0.labels.map(\\.name))\n288|            }\n289|        }\n290|    }\n291|\n292|    // MARK: - Runner groups (org only)\n293|\n294|    public func fetchGroups(\n295|        config: GitHubAuth.AppConfig,\n296|        token: String,\n297|        org: String\n298|    ) async throws -> [RunnerRegistration.RunnerGroup] {\n299|        let pages: [GitHubHTTPResponse]\n300|        do {\n301|            pages = try await getAllPages(\n302|                config: config,\n303|                path: \"orgs/\\(org)/actions/runner-groups\", token: token\n304|            )\n305|        } catch let error as RunnerRegistration.RegistrationError {\n306|            if case .forbidden(let text) = error {\n307|                throw RunnerRegistration.RegistrationError.missingPermission(groupReadHelp(org: org, detail: text))\n308|            }\n309|            throw error\n310|        }\n311|        return try pages.flatMap { page in\n312|            try decode(RunnerGroupsListDTO.self, from: page).runnerGroups.map {\n313|                RunnerRegistration.RunnerGroup(\n314|                    id: $0.id, name: $0.name, visibility: $0.visibility,\n315|                    allowsPublicRepositories: $0.allowsPublicRepositories ?? false\n316|                )\n317|            }\n318|        }\n319|    }\n320|\n321|    public func createGroup(\n322|        config: GitHubAuth.AppConfig,\n323|        token: String,\n324|        org: String,\n325|        name: String,\n326|        selectedRepositoryIDs: Set<Int64>,\n327|        allowsPublicRepositories: Bool = true\n328|    ) async throws -> RunnerRegistration.RunnerGroup {\n329|        let payload = CreateGroupDTO(\n330|            name: name, visibility: \"selected\",\n331|            selectedRepositoryIDs: Array(selectedRepositoryIDs).sorted(),\n332|            allowsPublicRepositories: allowsPublicRepositories\n333|        )\n334|        let body = try JSONEncoder().encode(payload)\n335|        let response: GitHubHTTPResponse\n336|        do {\n337|            response = try await send(\n338|                method: \"POST\", config: config,\n339|                path: \"orgs/\\(org)/actions/runner-groups\", token: token, body: body\n340|            )\n341|        } catch let error as RunnerRegistration.RegistrationError {\n342|            if case .forbidden(let text) = error {\n343|                throw RunnerRegistration.RegistrationError.missingPermission(\n344|                    permissionHelp(scope: .organization(org: org), detail: text)\n345|                )\n346|            }\n347|            throw error\n348|        }\n349|        let decoded = try decode(RunnerGroupDTO.self, from: response)\n350|        return .init(\n351|            id: decoded.id, name: decoded.name, visibility: decoded.visibility,\n352|            allowsPublicRepositories: decoded.allowsPublicRepositories ?? allowsPublicRepositories\n353|        )\n354|    }\n355|\n356|    /// Enables selected public repositories on an owned dedicated group.\n357|    /// GitHub defaults `allows_public_repositories` to false, which silently\n358|    /// denies every selected public repo; dedicated per-Mac groups always\n359|    /// opt in because `selected` visibility still bounds access to the\n360|    /// chosen repository IDs.\n361|    public func updateGroupAllowsPublic(\n362|        config: GitHubAuth.AppConfig,\n363|        token: String,\n364|        org: String,\n365|        groupID: Int64,\n366|        allowsPublic: Bool\n367|    ) async throws -> RunnerRegistration.RunnerGroup {\n368|        let payload = UpdateGroupDTO(allowsPublicRepositories: allowsPublic)\n369|        let body = try JSONEncoder().encode(payload)\n370|        let response: GitHubHTTPResponse\n371|        do {\n372|            response = try await send(\n373|                method: \"PATCH\", config: config,\n374|                path: \"orgs/\\(org)/actions/runner-groups/\\(groupID)\", token: token, body: body\n375|            )\n376|        } catch let error as RunnerRegistration.RegistrationError {\n377|            if case .forbidden(let text) = error {\n378|                throw RunnerRegistration.RegistrationError.missingPermission(\n379|                    permissionHelp(scope: .organization(org: org), detail: text)\n380|                )\n381|            }\n382|            throw error\n383|        }\n384|        let decoded = try decode(RunnerGroupDTO.self, from: response)\n385|        return .init(\n386|            id: decoded.id, name: decoded.name, visibility: decoded.visibility,\n387|            allowsPublicRepositories: decoded.allowsPublicRepositories ?? allowsPublic\n388|        )\n389|    }\n390|\n391|    public func fetchGroupRepositories(\n392|        config: GitHubAuth.AppConfig,\n393|        token: String,\n394|        org: String,\n395|        groupID: Int64\n396|    ) async throws -> [Int64] {\n397|        let pages: [GitHubHTTPResponse]\n398|        do {\n399|            pages = try await getAllPages(\n400|                config: config,\n401|                path: \"orgs/\\(org)/actions/runner-groups/\\(groupID)/repositories\", token: token\n402|            )\n403|        } catch let error as RunnerRegistration.RegistrationError {\n404|            if case .forbidden(let text) = error {\n405|                throw RunnerRegistration.RegistrationError.missingPermission(groupReadHelp(org: org, detail: text))\n406|            }\n407|            throw error\n408|        }\n409|        return try pages.flatMap { page in\n410|            try decode(GroupRepositoriesDTO.self, from: page).repositories.map(\\.id)\n411|        }\n412|    }\n413|\n414|    public func setGroupRepositories(\n415|        config: GitHubAuth.AppConfig,\n416|        token: String,\n417|        org: String,\n418|        groupID: Int64,\n419|        selectedRepositoryIDs: Set<Int64>\n420|    ) async throws {\n421|        let payload = SetGroupRepositoriesDTO(selectedRepositoryIDs: Array(selectedRepositoryIDs).sorted())\n422|        let body = try JSONEncoder().encode(payload)\n423|        do {\n424|            _ = try await send(\n425|                method: \"PUT\", config: config,\n426|                path: \"orgs/\\(org)/actions/runner-groups/\\(groupID)/repositories\", token: token, body: body\n427|            )\n428|        } catch let error as RunnerRegistration.RegistrationError {\n429|            if case .forbidden(let text) = error {\n430|                throw RunnerRegistration.RegistrationError.missingPermission(\n431|                    permissionHelp(scope: .organization(org: org), detail: text)\n432|                )\n433|            }\n434|            throw error\n435|        }\n436|    }\n437|\n438|    // MARK: - Labels (editable after registration)\n439|\n440|    public func setRunnerLabels(\n441|        config: GitHubAuth.AppConfig,\n442|        token: String,\n443|        scope: RunnerRegistration.Scope,\n444|        runnerID: Int64,\n445|        labels: [String]\n446|    ) async throws {\n447|        let payload = SetLabelsDTO(labels: labels)\n448|        let body = try JSONEncoder().encode(payload)\n449|        do {\n450|            _ = try await send(\n451|                method: \"PUT\", config: config,\n452|                path: \"\\(scope.apiPrefix)/actions/runners/\\(runnerID)/labels\", token: token, body: body\n453|            )\n454|        } catch let error as RunnerRegistration.RegistrationError {\n455|            if case .forbidden(let text) = error {\n456|                throw RunnerRegistration.RegistrationError.missingPermission(writeHelp(scope: scope, detail: text))\n457|            }\n458|            throw error\n459|        }\n460|    }\n461|}\n462|\n463|// MARK: - DTOs\n464|\n465|private struct RunnerDownloadDTO: Decodable, Sendable {\n466|    let osName: String\n467|    let architecture: String\n468|    let downloadURL: String\n469|    let filename: String\n470|    let sha256Checksum: String?\n471|\n472|    private enum CodingKeys: String, CodingKey {\n473|        case osName = \"os\"\n474|        case architecture\n475|        case downloadURL = \"download_url\"\n476|        case filename\n477|        case sha256Checksum = \"sha256_checksum\"\n478|    }\n479|}\n480|\n481|private struct RegistrationTokenDTO: Decodable, Sendable {\n482|    let token: String\n483|    let expiresAt: String?\n484|\n485|    private enum CodingKeys: String, CodingKey {\n486|        case token\n487|        case expiresAt = \"expires_at\"\n488|    }\n489|}\n490|\n491|private struct RunnersListDTO: Decodable, Sendable {\n492|    let runners: [RunnerDTO]\n493|}\n494|\n495|private struct RunnerDTO: Decodable, Sendable {\n496|    let id: Int64\n497|    let name: String\n498|    let labels: [LabelDTO]\n499|}\n500|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
