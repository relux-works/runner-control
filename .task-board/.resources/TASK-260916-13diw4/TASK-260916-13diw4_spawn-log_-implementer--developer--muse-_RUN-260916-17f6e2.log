ct(text.contains(\"[REDACTED]\"))\n752|    }\n753|}\n754|\n755|private extension SplitExecutor {\n756|    func setFailure(_ result: CommandResult) { failure = result }\n757|}\n758|\n759|@Test func runConfigExecutesRealScript() async throws {\n760|    // The fixture config.sh is a real executable shell script: production\n761|    // runConfig must execute it (not only a fake) and read back `.runner`.\n762|    let package = try await FixturePackage.make(withRealConfigScript: true)\n763|    let harness = await registrationHarness(\n764|        transport: TestTransport([]), downloader: fixtureDownloader(package.bytes)\n765|    )\n766|    let draft = orgDraft()\n767|    let asset = RunnerRegistration.DownloadAsset(\n768|        osName: \"osx\", architecture: \"arm64\",\n769|        downloadURL: URL(string: \"https://example.com/x.tar.gz\")!,\n(more lines below)","final_result":true}}}
