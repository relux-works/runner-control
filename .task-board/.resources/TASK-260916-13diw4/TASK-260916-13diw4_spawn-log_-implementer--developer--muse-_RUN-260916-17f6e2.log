252|            } catch let error as GitHubAuth.AuthError {\n253|                switch error {\n254|                case .revoked, .unauthorized, .tokenRefreshFailed:\n255|                    throw RunnerRegistration.RegistrationError.unauthorized\n256|                default:\n257|                    break\n258|                }\n259|            }\n260|            guard !isStale(gen) else { throw CancellationError() }\n261|        }\n262|        return FlowUserToken(config: config, token: record.accessToken, identity: identity)\n263|    }\n264|\n265|    private func fail(_ error: Error, step: String, generation gen: Int) async {\n266|        guard !isStale(gen) else { return }\n267|        failedStep = step\n268|        if error is CancellationError { return }\n269|        if let reg = error as? RunnerRegistration.RegistrationError {\n270|            switch reg {\n271|            case .missingPermission, .forbidden:\n272|                await action {\n273|                    RunnerRegistration.Action.permissionDenied(message: reg.localizedDescription, step: step)\n274|                }\n275|                return\n276|            default:\n277|                break\n278|            }\n279|        }\n280|        let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n281|        await action { RunnerRegistration.Action.failed(message: message, step: step) }\n282|    }\n283|\n284|    private func finishStep(_ step: String, generation gen: Int) async {\n285|        guard !isStale(gen) else { return }\n286|        failedStep = nil\n287|        working = false\n288|        await action { RunnerRegistration.Action.stepFinished(step) }\n289|    }\n290|\n291|    // MARK: - Group\n292|\n293|    private func resolveGroup() async {\n294|        let gen = generation\n295|        guard !working else { return }\n296|        guard let draft else {\n297|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"resolveGroup\") }\n298|            return\n299|        }\n300|        do {\n301|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n302|        } catch {\n303|            failedStep = \"resolveGroup\"\n304|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"resolveGroup\") }\n305|            return\n306|        }\n307|        guard case .organization(let org) = draft.scope else { return }\n308|        working = true\n309|        await action { RunnerRegistration.Action.stepStarted(\"resolveGroup\") }\n310|        do {\n311|            let auth = try await currentUserToken(generation: gen)\n312|            guard !isStale(gen) else { return }\n313|            let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n314|            guard !isStale(gen) else { return }\n315|            let name = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n316|            let resolved: RunnerRegistration.RunnerGroup\n317|            if let existing = groups.first(where: { $0.name == name }) {\n318|                // Name alone never authorizes adoption: require a locally\n319|                // recorded ownership entry or explicit takeover confirmation.\n320|                let owned = await installer.loadOwnedGroupID(org: org, name: name)\n321|                try RunnerRegistration.Gates.authorizeGroupTakeover(\n322|                    groupName: name, existingID: existing.id,\n323|                    ownedID: owned, allowTakeover: draft.allowGroupTakeover\n324|                )\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
