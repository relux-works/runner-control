{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca11","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":867,"recorded_at":1780531400001729,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8b8-0b0e-7d12-bb4d-76d57d73a5e3"},"task_id":"01a0a8b8-0b0e-7d12-bb4d-76d57d73a5e3","event":{"kind":"output","task_id":"01a0a8b8-0b0e-7d12-bb4d-76d57d73a5e3","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(337 line(s) above)\n338|@Test func installerRefusesSpacesWithoutDownloading() async {\n339|    actor Probe {\n340|        var count = 0\n341|        func next(_ url: URL) async throws -> Data { count += 1; return Data() }\n342|    }\n343|    let probe = Probe()\n344|    let downloader: @Sendable (URL) async throws -> Data = { url in try await probe.next(url) }\n345|    let harness = await registrationHarness(transport: TestTransport([]), downloader: downloader)\n346|    var draft = orgDraft()\n347|    draft.installDirName = \"has space\"\n348|    let asset = RunnerRegistration.DownloadAsset(\n349|        osName: \"osx\", architecture: \"arm64\",\n350|        downloadURL: URL(string: \"https://example.com/x.tar.gz\")!,\n351|        filename: \"x.tar.gz\", sha256Checksum: nil\n352|    )\n353|    do {\n354|        _ = try await harness.installer.downloadAndInstall(asset: asset, draft: draft)\n355|        Issue.record(\"installer admitted spaced path\")\n356|    } catch let error as RunnerRegistration.RegistrationError {\n357|        guard case .noSpacePath = error else { Issue.record(\"wrong error: \\(error)\"); return }\n358|    } catch {\n359|        Issue.record(\"unexpected error: \\(error)\")\n360|    }\n361|    #expect(await probe.count == 0)\n362|}\n363|\n364|@Test func beginDraftRequiresNameAndLabels() async {\n365|    let harness = await registrationHarness(transport: TestTransport([]))\n366|    var nameless = orgDraft()\n367|    nameless.runnerName = \"   \"\n368|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(nameless))\n369|    #expect(lastFailure(harness.logger)?.step == \"beginDraft\")\n370|    var labelless = orgDraft()\n371|    labelless.labels = []\n372|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(labelless))\n373|    #expect(registrationActions(harness.logger).filter {\n374|        if case .failed = $0 { true } else { false }\n375|    }.count == 2)\n376|}\n377|\n378|@Test func unauthenticatedWizardFailsClosedWithoutNetwork() async {\n379|    let transport = TestTransport([])\n380|    let harness = await registrationHarness(transport: transport, seedAuth: false)\n381|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n382|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n383|    let failure = lastFailure(harness.logger)\n384|    #expect(failure?.step == \"resolveGroup\")\n385|    #expect((failure?.message.contains(\"Sign in\") ?? false))\n386|    #expect(await transport.requests.isEmpty)\n387|}\n388|\n389|// MARK: - Download selection (architecture-matched, official only)\n390|\n391|private func downloadAssets(checksum: String) -> [[String: Any]] {\n392|    [\n393|        [\"os\": \"linux\", \"architecture\": \"x64\", \"download_url\": \"https://example.com/linux.tar.gz\", \"filename\": \"linux.tar.gz\"],\n394|        [\"os\": \"osx\", \"architecture\": \"x64\", \"download_url\": \"https://example.com/osx-x64.tar.gz\", \"filename\": \"osx-x64.tar.gz\", \"sha256_checksum\": \"x64sum\"],\n395|        [\"os\": \"osx\", \"architecture\": \"arm64\", \"download_url\": \"https://example.com/osx-arm64.tar.gz\", \"filename\": \"osx-arm64.tar.gz\", \"sha256_checksum\": checksum],\n396|    ]\n397|}\n398|\n399|@Test func prepareDownloadSelectsArchMatchedAsset() async {\n400|    let transport = TestTransport([downloadsArrayPayload(downloadAssets(checksum: \"arm64sum\"))])\n401|    let harness = await registrationHarness(transport: transport)\n402|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n403|    _ = await harness.flow.apply(RunnerRegistration.Effect.prepareDownload)\n404|    let ready = registrationActions(harness.logger).compactMap { action -> RunnerRegistration.DownloadAsset? in\n405|        if case .downloadReady(let asset) = action { asset } else { nil }\n406|    }\n407|    #expect(ready.count == 1)\n408|    #expect(ready.first?.architecture == \"arm64\")\n409|    #expect(ready.first?.osName == \"osx\")\n410|    let requests = await transport.requests\n411|    #expect(requests.count == 1)\n412|    #expect(requests.first?.url.path.hasSuffix(\"/orgs/acme/actions/runners/downloads\") ?? false)\n413|    #expect(requests.first?.headers[\"Authorization\"] == \"Bearer [REDACTED]\")\n414|}\n415|\n416|@Test func prepareDownloadRefusesSubstituteArch() async {\n417|    let assets = [\n418|        [\"os\": \"osx\", \"architecture\": \"x64\", \"download_url\": \"https://example.com/osx-x64.tar.gz\", \"filename\": \"osx-x64.tar.gz\", \"sha256_checksum\": \"x64sum\"],\n419|        [\"os\": \"linux\", \"architecture\": \"arm64\", \"download_url\": \"https://example.com/linux.tar.gz\", \"filename\": \"linux.tar.gz\"],\n420|    ]\n421|    let transport = TestTransport([downloadsArrayPayload(assets)])\n422|    let harness = await registrationHarness(transport: transport, arch: \"arm64\")\n423|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n424|    _ = await harness.flow.apply(RunnerRegistration.Effect.prepareDownload)\n425|    let failure = lastFailure(harness.logger)\n426|    #expect(failure?.step == \"prepareDownload\")\n427|    #expect((failure?.message.contains(\"arm64\") ?? false))\n428|    #expect(FileManager.default.fileExists(atPath: harness.installRoot.appendingPathComponent(\"macbook-test\").path) == false)\n429|}\n430|\n431|// MARK: - Groups (dedicated per-Mac, explicit scope)\n432|\n433|@Test func orgResolveGroupFindsExistingWithoutCreating() async {\n434|    let transport = TestTransport([\n435|        groupsListPayload([\n436|            groupPayload(id: 1, name: \"Default\", visibility: \"all\", allowsPublic: true),\n437|            groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true),\n438|        ]),\n439|        jsonResponse([\"repositories\": [[\"id\": 9], [\"id\": 10]]]),\n440|    ])\n441|    let harness = await registrationHarness(transport: transport)\n442|    // Explicit takeover: this Mac adopts the pre-existing same-name group.\n443|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n444|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n445|    let resolved = registrationActions(harness.logger).compactMap { action -> (RunnerRegistration.RunnerGroup, [Int64])? in\n446|        if case .groupResolved(let group, let ids) = action { (group, ids) } else { nil }\n447|    }\n448|    #expect(resolved.count == 1)\n449|    #expect(resolved.first?.0.id == 5)\n450|    #expect(resolved.first?.0.allowsPublicRepositories == true)\n451|    #expect(resolved.first?.1.sorted() == [9, 10])\n452|    let requests = await transport.requests\n453|    #expect(requests.filter { $0.method == \"POST\" }.isEmpty)\n454|}\n455|\n456|@Test func orgResolveGroupCreatesWithSelectedRepos() async throws {\n457|    let transport = TestTransport([\n(more lines below)","final_result":true}}}
