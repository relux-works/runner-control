{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c719","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":487,"recorded_at":1780531400000969,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"call_id":"call_01a0a8b3b77d73b7a513be5d0a51b741","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n1|import CryptoKit\n2|import Foundation\n3|import Testing\n4|import Relux\n5|@testable import RunnerControlCore\n6|\n7|// MARK: - Registration harness (production entry points, controlled IO)\n8|\n9|// TestTransport, jsonResponse, and testConfig are shared from GitHubTransportTests.\n10|\n11|private struct RegistrationHarness {\n12|    let flow: RunnerRegistration.Flow\n13|    let logger: Relux.Testing.Logger\n14|    let transport: TestTransport\n15|    let userStore: GitHubKeychainStore\n16|    let registrationTokens: RunnerRegistrationTokenStore\n17|    let installer: RunnerInstallerService\n18|    let home: URL\n19|    let installRoot: URL\n20|}\n21|\n22|private func registrationHarness(\n23|    transport: TestTransport,\n24|    downloader: (@Sendable (URL) async throws -> Data)? = nil,\n25|    executor: (any CommandExecuting)? = nil,\n26|    arch: String = \"arm64\",\n27|    seedAuth: Bool = true\n28|) async -> RegistrationHarness {\n29|    let logger = Relux.Testing.Logger()\n30|    let dispatcher = Relux.Dispatcher(logger: logger)\n31|    let userStore = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n32|    let identities = InMemoryGitHubSessionIdentityStore()\n33|    if seedAuth {\n34|        await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n35|        try? await userStore.save(\n36|            GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n37|            serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n38|        )\n39|    }\n40|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"RegHome-\" + UUID().uuidString)\n41|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n42|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n43|    let archCopy = arch\n44|    let installer = RunnerInstallerService(\n45|        installRoot: installRoot,\n46|        downloader: downloader,\n47|        executor: executor,\n48|        currentArch: { archCopy }\n49|    )\n50|    let api = GitHubRunnerAPIClient(transport: transport)\n51|    let registrationTokens = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n52|    let refresher = GitHubTokenRefresh(transport: transport, store: userStore)\n53|    let flow = await RunnerRegistration.Flow(\n54|        api: api, installer: installer, registrationTokens: registrationTokens,\n55|        userStore: userStore, identityStore: identities, refresher: refresher,\n56|        configProvider: { _ in testConfig }, dispatcher: dispatcher\n57|    )\n58|    return RegistrationHarness(\n59|        flow: flow, logger: logger, transport: transport, userStore: userStore,\n60|        registrationTokens: registrationTokens, installer: installer, home: home, installRoot: installRoot\n61|    )\n62|}\n63|\n64|private func registrationActions(_ logger: Relux.Testing.Logger) -> [RunnerRegistration.Action] {\n65|    logger.actions.compactMap { $0 as? RunnerRegistration.Action }\n66|}\n67|\n68|private func lastFailure(_ logger: Relux.Testing.Logger) -> (message: String, step: String)? {\n69|    for action in registrationActions(logger).reversed() {\n70|        switch action {\n71|        case .failed(let message, let step): return (message, step)\n72|        case .permissionDenied(let message, let step): return (message, step)\n73|        default: break\n74|        }\n75|    }\n76|    return nil\n77|}\n78|\n79|private func orgDraft(\n80|    name: String = \"macbook-test\",\n81|    dir: String = \"macbook-test\",\n82|    group: String = \"RunnerControl-Mac\",\n83|    repos: Set<Int64> = [9],\n84|    allowGroup: Bool = true,\n85|    allowTakeover: Bool = false,\n86|    allowReplace: Bool = false\n87|) -> RunnerRegistration.Draft {\n88|    RunnerRegistration.Draft(\n89|        scope: .organization(org: \"acme\"),\n90|        runnerName: name,\n91|        labels: [\"self-hosted\", \"macOS\"],\n92|        installDirName: dir,\n93|        workFolder: \"_work\",\n94|        groupName: group,\n95|        selectedRepositoryIDs: repos,\n96|        allowGroupMutation: allowGroup,\n97|        allowGroupTakeover: allowTakeover,\n98|        allowReplace: allowReplace\n99|    )\n100|}\n101|\n102|private func repoDraft(dir: String = \"personal-app\", allowReplace: Bool = false) -> RunnerRegistration.Draft {\n103|    RunnerRegistration.Draft(\n104|        scope: .repository(owner: \"octo\", name: \"app\"),\n105|        runnerName: \"personal-runner\",\n106|        labels: [\"self-hosted\", \"macOS\"],\n107|        installDirName: dir,\n108|        workFolder: \"_work\",\n109|        allowGroupMutation: false,\n110|        allowGroupTakeover: false,\n111|        allowReplace: allowReplace\n112|    )\n113|}\n114|\n115|/// The downloads endpoint returns a bare JSON array, not an object.\n116|private func downloadsArrayPayload(_ assets: [[String: Any]]) -> GitHubHTTPResponse {\n117|    // swiftlint:disable:next force_try\n118|    let data = try! JSONSerialization.data(withJSONObject: assets)\n119|    return GitHubHTTPResponse(status: 200, body: data)\n120|}\n121|\n122|/// Typed group fixture: heterogeneous literals (Int/String/Bool) need an\n123|/// explicit `[String: Any]` context to compile.\n124|private func groupPayload(id: Int64, name: String, visibility: String, allowsPublic: Bool) -> [String: Any] {\n125|    [\"id\": id, \"name\": name, \"visibility\": visibility, \"allows_public_repositories\": allowsPublic]\n126|}\n127|\n128|private func groupsListPayload(_ groups: [[String: Any]]) -> GitHubHTTPResponse {\n129|    jsonResponse([\"runner_groups\": groups])\n130|}\n131|\n132|// MARK: - Fixture package (real tarball, controlled filesystem)\n133|\n134|/// Builds a minimal official-shaped runner package and packs it with the\n135|/// real system tar. Scripts keep their executable bit inside the archive.\n136|private struct FixturePackage {\n137|    let bytes: Data\n138|    let sha256ViaSystem: String\n139|\n140|    static func make(withRealConfigScript: Bool = true) async throws -> FixturePackage {\n141|        let files = FileManager.default\n142|        let src = files.temporaryDirectory.appendingPathComponent(\"FixtureSrc-\" + UUID().uuidString)\n143|        let bin = src.appendingPathComponent(\"bin\")\n144|        try files.createDirectory(at: bin, withIntermediateDirectories: true)\n145|        try \"#!/bin/sh\\nexec \\\"$(dirname \\\"$0\\\")/../run.sh\\\" \\\"$@\\\"\\n\".write(to: bin.appendingPathComponent(\"runsvc.sh\"), atomically: true, encoding: .utf8)\n146|        try \"#!/bin/sh\\necho runner\\n\".write(to: src.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n147|        if withRealConfigScript {\n148|            let script = \"\"\"\n149|            #!/bin/sh\n150|            DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n151|            NAME=\"\"\n152|            while [ $# -gt 0 ]; do\n153|              case \"$1\" in\n154|                --name) NAME=\"$2\"; shift 2;;\n155|                *) shift;;\n156|              esac\n157|            done\n158|            printf '{\"agentId\":4242,\"agentName\":\"%s\",\"gitHubUrl\":\"https://github.com/acme\",\"workFolder\":\"_work\"}' \"$NAME\" > \"$DIR/.runner\"\n159|            \"\"\"\n160|            try script.write(to: src.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n161|        } else {\n162|            try \"#!/bin/sh\\nexit 0\\n\".write(to: src.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n163|        }\n164|        for path in [\"bin/runsvc.sh\", \"run.sh\", \"config.sh\"] {\n165|            try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: src.appendingPathComponent(path).path)\n166|        }\n167|        let archive = files.temporaryDirectory.appendingPathComponent(\"fixture-\" + UUID().uuidString + \".tar.gz\")\n168|        defer { try? files.removeItem(at: src) }\n169|        defer { try? files.removeItem(at: archive) }\n170|        let executor = CommandExecutor()\n171|        let packed = try await executor.run(\"/usr/bin/tar\", [\"-czf\", archive.path, \"-C\", src.path, \".\"])\n172|        guard packed.code == 0 else { throw RunnerError.message(\"fixture tar failed: \\(packed.output)\") }\n173|        let bytes = try Data(contentsOf: archive)\n174|        // Independent oracle: system shasum pins the production CryptoKit hasher.\n175|        let hashed = try await executor.run(\"/usr/bin/shasum\", [\"-a\", \"256\", archive.path])\n176|        guard hashed.code == 0 else { throw RunnerError.message(\"shasum missing: \\(hashed.output)\") }\n177|        let digest = hashed.output.split(separator: \" \").first.map(String.init) ?? \"\"\n178|        guard digest.count == 64 else { throw RunnerError.message(\"bad shasum output: \\(hashed.output)\") }\n179|        return FixturePackage(bytes: bytes, sha256ViaSystem: digest)\n180|    }\n181|}\n182|\n183|private func fixtureDownloader(_ bytes: Data) -> @Sendable (URL) async throws -> Data {\n184|    let copy = bytes\n185|    return { _ in copy }\n186|}\n187|\n188|/// Records config.sh argv and simulates a successful registration by writing\n189|/// `.runner`. Delegates every other command (tar) to the real executor.\n190|private actor SplitExecutor: CommandExecuting {\n191|    private(set) var configCalls: [[String]] = []\n192|    var failure: CommandResult?\n193|    private let real = CommandExecutor()\n194|    private let gitHubURL: String\n195|\n196|    init(gitHubURL: String = \"https://github.com/acme\") {\n197|        self.gitHubURL = gitHubURL\n198|    }\n199|\n200|    func run(_ executable: String, _ arguments: [String]) async throws -> CommandResult {\n201|        if executable.hasSuffix(\"config.sh\") {\n202|            configCalls.append(arguments)\n203|            if let failure { return failure }\n204|            let dir = URL(fileURLWithPath: executable).deletingLastPathComponent()\n205|            var name = \"unnamed\"\n206|            var index = arguments.startIndex\n207|            while index < arguments.endIndex {\n208|                if arguments[index] == \"--name\", arguments.index(after: index) < arguments.endIndex {\n209|                    name = arguments[arguments.index(after: index)]\n210|                }\n211|                index = arguments.index(after: index)\n212|            }\n213|            let payload = [\"agentId\": 4242, \"agentName\": name, \"gitHubUrl\": gitHubURL, \"workFolder\": \"_work\"] as [String: Any]\n214|            let data = try JSONSerialization.data(withJSONObject: payload)\n215|            try data.write(to: dir.appendingPathComponent(\".runner\"), options: .atomic)\n216|            return CommandResult(code: 0, output: \"Configured\")\n217|        }\n218|        return try await real.run(executable, arguments)\n219|    }\n220|}\n221|\n222|// MARK: - Reducer and pure gates\n223|\n224|@Test @MainActor func registrationReducerRetainsPermissionErrorAcrossDraftEdits() async {\n225|    let state = RunnerRegistration.State()\n226|    await state.reduce(with: ForeignAction())\n227|    #expect(state.phase == .idle)\n228|    let draft = orgDraft()\n229|    await state.reduce(with: RunnerRegistration.Action.draftBegan(draft))\n230|    #expect(state.phase == .drafting)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
