rRegistration.Effect.downloadAndInstall)\n1004|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n1005|    let failure = lastFailure(harness.logger)\n1006|    #expect(failure?.step == \"registerRunner\")\n1007|    #expect(!(failure?.message.contains(\"REG-SECRET-9\") ?? true))\n1008|    let scopeKey = RunnerRegistration.Flow.tokenScopeKey(draft: draft)\n1009|    #expect(await harness.registrationTokens.load(scopeKey: scopeKey) == nil)\n1010|    _ = await harness.flow.apply(RunnerRegistration.Effect.cancel)\n1011|    #expect(registrationActions(harness.logger).contains { if case .cancelled = $0 { true } else { false } })\n1012|}\n1013|\n1014|@Test func postConfigAPIFailureDeletesTokenAndReportsError() async throws {\n1015|    // Review F6 regression: the single-use token is consumed by config.sh,\n1016|    // so a failing follow-up API call must report the error without\n1017|    // retaining the token.\n1018|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1019|    let executor = SplitExecutor()\n1020|    let transport = TestTransport([\n1021|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1022|        runnersListPayload([]),\n1023|        jsonResponse([\"token\": \"REG-SECRET-6\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n1024|        GitHubHTTPResponse(status: 500, body: Data(\"boom\".utf8)),\n1025|    ])\n1026|    let harness = await registrationHarness(\n1027|        transport: transport,\n1028|        downloader: fixtureDownloader(package.bytes),\n1029|        executor: executor\n1030|    )\n1031|    let draft = orgDraft()\n1032|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n1033|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1034|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n1035|    let failure = lastFailure(harness.logger)\n1036|    #expect(failure?.step == \"registerRunner\")\n1037|    #expect((failure?.message.contains(\"500\") ?? false))\n1038|    #expect(await executor.configCalls.count == 1)\n1039|    let scopeKey = RunnerRegistration.Flow.tokenScopeKey(draft: draft)\n1040|    #expect(await harness.registrationTokens.load(scopeKey: scopeKey) == nil)\n1041|}\n1042|\n1043|// MARK: - Permission errors (retained, explicit clear)\n1044|\n1045|@Test @MainActor func permissionErrorRetainedAcrossEditsUntilRetrySucceeds() async {\n1046|    let transport = TestTransport([\n1047|        GitHubHTTPResponse(status: 403, body: Data(\"Resource not accessible by integration\".utf8)),\n1048|    ])\n1049|    let harness = await registrationHarness(transport: transport)\n1050|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1051|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1052|    var edited = orgDraft(allowTakeover: true)\n1053|    edited.runnerName = \"renamed-mac\"\n1054|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n1055|    let state = RunnerRegistration.State()\n1056|    for action in registrationActions(harness.logger) { await state.reduce(with: action) }\n1057|    #expect(state.permissionError?.contains(\"Missing permission\") ?? false)\n1058|    #expect(state.draft?.runnerName == \"renamed-mac\")\n1059|    // Access granted later: retry succeeds and clears the retained error.\n1060|    await transport.append(groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]))\n1061|    await transport.append(jsonResponse([\"repositories\": [[\"id\": 9]]]))\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
