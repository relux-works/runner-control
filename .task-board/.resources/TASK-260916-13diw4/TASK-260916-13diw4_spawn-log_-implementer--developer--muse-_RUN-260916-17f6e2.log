ar completedSteps: Set<String> = []\n29|        @Published public internal(set) var error: String?\n30|        @Published public internal(set) var failedStep: String?\n31|        /// Retained permission errors (403/missing rights). Draft edits never\n32|        /// clear them; only an explicit retry, reset, or dismiss does.\n33|        @Published public internal(set) var permissionError: String?\n34|\n35|        public init() {}\n36|\n37|        public func cleanup() async {\n38|            phase = .idle\n39|            draft = nil\n40|            working = false\n41|            group = nil\n42|            groupRepositoryIDs = []\n43|            asset = nil\n44|            installPath = nil\n45|            runnerID = nil\n46|            localAgentID = nil\n47|            completedSteps = []\n48|            error = nil\n49|            failedStep = nil\n50|            permissionError = nil\n51|        }\n52|    }\n53|\n54|    public enum Action: Relux.Action {\n55|        case draftBegan(Draft)\n56|        case draftUpdated(Draft)\n57|        case stepStarted(String)\n58|        case stepFinished(String)\n59|        case groupResolved(RunnerGroup, repositoryIDs: [Int64])\n60|        case downloadReady(DownloadAsset)\n61|        case installed(path: String)\n62|        case registered(runnerID: Int64?, localAgentID: Int64?)\n63|        case serviceReady(plistPath: String)\n64|        case repositoryAccessApplied([Int64])\n65|        case labelsApplied([String])\n66|        case failed(message: String, step: String)\n67|        case permissionDenied(message: String, step: String)\n68|        case permissionDismissed\n69|        case cancelled\n70|        case didReset\n71|    }\n72|\n73|    public enum Effect: Relux.Effect {\n74|        case beginDraft(Draft)\n75|        case updateDraft(Draft)\n76|        case resolveGroup\n77|        case prepareDownload\n78|        case downloadAndInstall\n79|        case registerRunner\n80|        case setupService\n81|        case applyRepositoryAccess(groupID: Int64, repositories: Set<Int64>)\n82|        case applyLabels([String])\n83|        case retry\n84|        case cancel\n85|        case reset\n86|        case dismissPermission\n87|    }\n88|}","final_result":true}}}
