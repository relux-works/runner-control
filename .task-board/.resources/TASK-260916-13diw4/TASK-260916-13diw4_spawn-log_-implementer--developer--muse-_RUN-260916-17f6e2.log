{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c76d","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":529,"recorded_at":1780531400001053,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"call_id":"call_01a0a8b3e2167380b3e9bcc89fed779c","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(1554 line(s) above)\n1555|@Test @MainActor func scopeChangeClearsCompletedStepsInState() async {\n1556|    // R2-F3 (reducer): a scope edit drops group/install/runner progress and\n1557|    // demotes a done wizard back to drafting instead of displaying another\n1558|    // registration's evidence.\n1559|    let state = RunnerRegistration.State()\n1560|    await state.reduce(with: RunnerRegistration.Action.draftBegan(orgDraft()))\n1561|    await state.reduce(with: RunnerRegistration.Action.groupResolved(\n1562|        RunnerRegistration.RunnerGroup(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublicRepositories: true),\n1563|        repositoryIDs: [9]\n1564|    ))\n1565|    await state.reduce(with: RunnerRegistration.Action.stepFinished(\"resolveGroup\"))\n1566|    await state.reduce(with: RunnerRegistration.Action.installed(path: \"/tmp/macbook-test\"))\n1567|    await state.reduce(with: RunnerRegistration.Action.stepFinished(\"downloadAndInstall\"))\n1568|    await state.reduce(with: RunnerRegistration.Action.registered(runnerID: 4242, localAgentID: 4242))\n1569|    await state.reduce(with: RunnerRegistration.Action.stepFinished(\"registerRunner\"))\n1570|    await state.reduce(with: RunnerRegistration.Action.serviceReady(plistPath: \"/tmp/macbook-test/manual-service.plist\"))\n1571|    #expect(state.phase == .done)\n1572|    await state.reduce(with: RunnerRegistration.Action.draftUpdated(repoDraft()))\n1573|    #expect(state.completedSteps.isEmpty)\n1574|    #expect(state.group == nil)\n1575|    #expect(state.groupRepositoryIDs.isEmpty)\n1576|    #expect(state.installPath == nil)\n1577|    #expect(state.runnerID == nil)\n1578|    #expect(state.localAgentID == nil)\n1579|    #expect(state.phase == .drafting)\n1580|    #expect(state.draft?.scope == .repository(owner: \"octo\", name: \"app\"))\n1581|}\n1582|\n1583|@Test func installDirChangeKeepsGroupButRequiresFreshInstall() async throws {\n1584|    // R2-F3 (selective): an install-dir edit keeps the resolved group but\n1585|    // drops install/registration progress, so the next register refuses to\n1586|    // reuse the old directory while repo access still applies to the group.\n1587|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1588|    let transport = TestTransport([\n1589|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n1590|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1591|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1592|        runnersListPayload([]),\n1593|        jsonResponse([\"token\": \"REG-SECRET-14\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n1594|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n1595|        GitHubHTTPResponse(status: 204, body: Data()),\n1596|        jsonResponse([\"repositories\": [[\"id\": 9], [\"id\": 10]]]),\n1597|    ])\n1598|    let harness = await registrationHarness(\n1599|        transport: transport,\n1600|        downloader: fixtureDownloader(package.bytes),\n1601|        executor: SplitExecutor()\n1602|    )\n1603|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1604|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1605|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1606|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1607|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n1608|    var edited = orgDraft(allowTakeover: true)\n1609|    edited.installDirName = \"second-dir\"\n1610|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n1611|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n1612|    let failure = lastFailure(harness.logger)\n1613|    #expect(failure?.step == \"registerRunner\")\n1614|    #expect(failure?.message.contains(\"Install the runner package first\") ?? false)\n1615|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyRepositoryAccess(groupID: 5, repositories: [9, 10]))\n1616|    let applied = registrationActions(harness.logger).compactMap { action -> [Int64]? in\n1617|        if case .repositoryAccessApplied(let ids) = action { ids } else { nil }\n1618|    }\n1619|    #expect(applied.last?.sorted() == [9, 10])\n1620|    #expect(await transport.requests.filter { $0.method == \"PUT\" }.count == 1)\n1621|}\n1622|\n1623|@Test func groupNameChangeInvalidatesResolvedGroup() async {\n1624|    // R2-F3 (selective): a group-name edit drops the resolved group, so repo\n1625|    // access against the old ID is refused until the new group resolves.\n1626|    let transport = TestTransport([\n1627|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n1628|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1629|    ])\n1630|    let harness = await registrationHarness(transport: transport)\n1631|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1632|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1633|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1634|    var edited = orgDraft(allowTakeover: true)\n1635|    edited.groupName = \"Other-Mac\"\n1636|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n1637|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyRepositoryAccess(groupID: 5, repositories: [9]))\n1638|    let failure = lastFailure(harness.logger)\n1639|    #expect(failure?.step == \"applyRepositoryAccess\")\n1640|    #expect(failure?.message.contains(\"Resolve the dedicated group first\") ?? false)\n1641|    #expect(await transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n1642|}\n1643|\n1644|@Test func retryAfterScopeChangeIsNoop() async throws {\n1645|    // R2-F3 (retry): a scope edit clears the failed step, so retry cannot\n1646|    // re-run the old scope's failure against the new draft.\n1647|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1648|    let transport = TestTransport([\n1649|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1650|        runnersListPayload([[\"id\": 99, \"name\": \"macbook-test\", \"labels\": []]]),\n1651|    ])\n1652|    let harness = await registrationHarness(\n1653|        transport: transport,\n1654|        downloader: fixtureDownloader(package.bytes),\n1655|        executor: SplitExecutor()\n1656|    )\n1657|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1658|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1659|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1660|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n1661|    #expect(lastFailure(harness.logger)?.step == \"registerRunner\")\n1662|    let before = await transport.requests.count\n1663|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(repoDraft()))\n1664|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n1665|    #expect(await transport.requests.count == before)\n1666|}\n1667|\n1668|@Test func repositoryConfirmationFollowsPagination() async throws {\n1669|    // R2-F4: the confirm read follows every page. A first page of [9] with a\n1670|    // next link plus a second page of [10] confirms [9, 10], not [9].\n1671|    let transport = TestTransport([\n1672|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n1673|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1674|        GitHubHTTPResponse(status: 204, body: Data()),\n1675|        pagedResponse(\n1676|            [\"total_count\": 2, \"repositories\": [[\"id\": 9]]],\n1677|            next: \"https://api.github.com/orgs/acme/actions/runner-groups/5/repositories?per_page=100&page=2\"\n1678|        ),\n1679|        jsonResponse([\"total_count\": 2, \"repositories\": [[\"id\": 10]]]),\n1680|    ])\n1681|    let harness = await registrationHarness(transport: transport)\n1682|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1683|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1684|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1685|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyRepositoryAccess(groupID: 5, repositories: [9, 10]))\n1686|    let confirmed = registrationActions(harness.logger).compactMap { action -> [Int64]? in\n1687|        if case .repositoryAccessApplied(let ids) = action { ids } else { nil }\n1688|    }\n1689|    #expect(confirmed.last.map(Set.init) == Set<Int64>([9, 10]))\n1690|    #expect(await transport.requests.contains { $0.url.query?.contains(\"page=2\") == true })\n1691|}\n1692|\n1693|@Test func repositoryConfirmationMismatchIsRefused() async {\n1694|    // R2-F4: a complete confirm of [9] against requested [9, 10] fails\n1695|    // instead of reporting partial access as success. Both directions —\n1696|    // missing and extra IDs — fail closed.\n1697|    let transport = TestTransport([\n1698|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n1699|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1700|        GitHubHTTPResponse(status: 204, body: Data()),\n1701|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1702|    ])\n1703|    let harness = await registrationHarness(transport: transport)\n1704|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1705|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1706|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1707|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyRepositoryAccess(groupID: 5, repositories: [9, 10]))\n1708|    let failure = lastFailure(harness.logger)\n1709|    #expect(failure?.step == \"applyRepositoryAccess\")\n1710|    #expect(failure?.message.contains(\"confirmed repositories\") ?? false)\n1711|    #expect(!registrationActions(harness.logger).contains {\n1712|        if case .repositoryAccessApplied = $0 { true } else { false }\n1713|    })\n1714|    // Extra-IDs direction: confirm [9, 10] against requested [9] also fails.\n1715|    let extra = TestTransport([\n1716|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n1717|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1718|        GitHubHTTPResponse(status: 204, body: Data()),\n1719|        jsonResponse([\"repositories\": [[\"id\": 9], [\"id\": 10]]]),\n1720|    ])\n1721|    let second = await registrationHarness(transport: extra)\n1722|    defer { try? FileManager.default.removeItem(at: second.home) }\n1723|    _ = await second.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1724|    _ = await second.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1725|    _ = await second.flow.apply(RunnerRegistration.Effect.applyRepositoryAccess(groupID: 5, repositories: [9]))\n1726|    #expect(lastFailure(second.logger)?.step == \"applyRepositoryAccess\")\n1727|    #expect(!registrationActions(second.logger).contains {\n1728|        if case .repositoryAccessApplied = $0 { true } else { false }\n1729|    })\n1730|}\n1731|\n1732|@Test func scopeChangeRefreshesDownloadAsset() async throws {\n1733|    // R2-F3: a scope edit drops the resolved download asset, so the next\n1734|    // install fetches the new scope's download list instead of reusing the\n1735|    // old scope's asset.\n1736|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1737|    let transport = TestTransport([\n1738|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1739|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1740|    ])\n1741|    let harness = await registrationHarness(\n1742|        transport: transport,\n1743|        downloader: fixtureDownloader(package.bytes)\n1744|    )\n1745|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1746|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1747|    _ = await harness.flow.apply(RunnerRegistration.Effect.prepareDownload)\n1748|    var edited = orgDraft()\n1749|    edited.scope = .repository(owner: \"octo\", name: \"app\")\n1750|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n1751|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1752|    let downloads = await transport.requests.filter { $0.url.path.hasSuffix(\"/actions/runners/downloads\") }\n1753|    #expect(downloads.count == 2)\n1754|    #expect(downloads.contains { $0.url.path == \"/repos/octo/app/actions/runners/downloads\" })\n1755|}\n1756|\n1757|@Test func repositorySecondPageFailurePreservesUnknown() async {\n1758|    // R2-F4: a failed second page fails the step. No partial IDs are\n1759|    // applied, synced, or reported.\n1760|    let transport = TestTransport([\n1761|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n1762|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1763|        GitHubHTTPResponse(status: 204, body: Data()),\n1764|        pagedResponse(\n1765|            [\"total_count\": 2, \"repositories\": [[\"id\": 9]]],\n1766|            next: \"https://api.github.com/orgs/acme/actions/runner-groups/5/repositories?per_page=100&page=2\"\n1767|        ),\n1768|        GitHubHTTPResponse(status: 500, body: Data(\"boom\".utf8)),\n1769|    ])\n1770|    let harness = await registrationHarness(transport: transport)\n1771|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1772|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1773|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1774|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyRepositoryAccess(groupID: 5, repositories: [9, 10]))\n1775|    #expect(lastFailure(harness.logger)?.step == \"applyRepositoryAccess\")\n1776|    #expect(!registrationActions(harness.logger).contains {\n1777|        if case .repositoryAccessApplied = $0 { true } else { false }\n1778|    })\n1779|}\n1780|\n1781|@Test func runnerListFollowsPaginationForDuplicateGuard() async throws {\n1782|    // R2-F4: the pre-token duplicate guard sees the complete runner list. A\n1783|    // same-name runner on page 2 refuses the run before any token is minted.\n1784|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1785|    let executor = SplitExecutor()\n1786|    let transport = TestTransport([\n1787|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1788|        pagedResponse(\n1789|            [\"runners\": [[\"id\": 1, \"name\": \"other-runner\", \"labels\": []]]],\n1790|            next: \"https://api.github.com/orgs/acme/actions/runners?per_page=100&page=2\"\n1791|        ),\n1792|        runnersListPayload([[\"id\": 99, \"name\": \"macbook-test\", \"labels\": []]]),\n1793|    ])\n1794|    let harness = await registrationHarness(\n1795|        transport: transport,\n1796|        downloader: fixtureDownloader(package.bytes),\n1797|        executor: executor\n1798|    )\n1799|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1800|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1801|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1802|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n1803|    let failure = lastFailure(harness.logger)\n1804|    #expect(failure?.step == \"registerRunner\")\n1805|    #expect(failure?.message.contains(\"already exists in GitHub\") ?? false)\n1806|    #expect(await transport.requests.filter {\n1807|        $0.method == \"POST\" && $0.url.path.contains(\"registration-token\")\n1808|    }.isEmpty)\n1809|    #expect(await executor.configCalls.isEmpty)\n1810|    #expect(await transport.requests.contains { $0.url.query?.contains(\"page=2\") == true })\n1811|}\n1812|\n1813|@Test func groupListFollowsPagination() async {\n1814|    // R2-F4: group resolution sees the complete group list. A dedicated\n1815|    // group on page 2 resolves without creating a duplicate.\n1816|    let transport = TestTransport([\n1817|        pagedResponse(\n1818|            [\"runner_groups\": [[\"id\": 1, \"name\": \"Default\", \"visibility\": \"all\", \"allows_public_repositories\": true]]],\n1819|            next: \"https://api.github.com/orgs/acme/actions/runner-groups?per_page=100&page=2\"\n1820|        ),\n1821|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n1822|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1823|    ])\n1824|    let harness = await registrationHarness(transport: transport)\n1825|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1826|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1827|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1828|    let resolved = registrationActions(harness.logger).compactMap { action -> Int64? in\n1829|        if case .groupResolved(let group, _) = action { group.id } else { nil }\n1830|    }\n1831|    #expect(resolved == [5])\n1832|    #expect(await transport.requests.filter { $0.method == \"POST\" }.isEmpty)\n1833|    #expect(await transport.requests.contains { $0.url.query?.contains(\"page=2\") == true })\n1834|}\n1835|\n1836|@Test func serviceCannotClaimDoneBeforeRegistration() async throws {\n1837|    // R2-F5: setup without registration fails. No serviceReady, no plist,\n1838|    // no done phase from an unregistered install.\n1839|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1840|    let transport = TestTransport([downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))])\n1841|    let harness = await registrationHarness(\n1842|        transport: transport,\n1843|        downloader: fixtureDownloader(package.bytes),\n1844|        executor: SplitExecutor()\n1845|    )\n1846|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1847|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1848|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1849|    _ = await harness.flow.apply(RunnerRegistration.Effect.setupService)\n1850|    #expect(lastFailure(harness.logger)?.step == \"setupService\")\n1851|    #expect(!registrationActions(harness.logger).contains { if case .serviceReady = $0 { true } else { false } })\n1852|    #expect(!FileManager.default.fileExists(atPath: harness.installRoot.appendingPathComponent(\"macbook-test/manual-service.plist\").path))\n1853|}\n1854|\n1855|@Test func serviceRefusesMismatchedLocalRegistration() async throws {\n1856|    // R2-F5: a configured marker for another registration's `.runner` (wrong\n1857|    // name) refuses service setup instead of completing the wrong identity.\n1858|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1859|    let transport = TestTransport([downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))])\n1860|    let harness = await registrationHarness(\n1861|        transport: transport,\n1862|        downloader: fixtureDownloader(package.bytes),\n1863|        executor: SplitExecutor()\n1864|    )\n1865|    defer { try? FileManager.default.removeItem(at: harness.home) }\n1866|    let draft = orgDraft()\n1867|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n1868|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1869|    let directory = await harness.installer.directory(for: draft.installDirName)\n1870|    try await harness.installer.markCompleted(\n1871|        RunnerInstallerService.stepConfigured, directory: directory, scopeKey: draft.scope.scopeKey\n1872|    )\n1873|    try Data(#\"{\"agentId\":4242,\"agentName\":\"someone-else\",\"gitHubUrl\":\"https://github.com/acme\",\"workFolder\":\"_work\"}\"#.utf8)\n1874|        .write(to: directory.appendingPathComponent(\".runner\"))\n1875|    _ = await harness.flow.apply(RunnerRegistration.Effect.setupService)\n1876|    let failure = lastFailure(harness.logger)\n1877|    #expect(failure?.step == \"setupService\")\n1878|    #expect(failure?.message.contains(\"someone-else\") ?? false)\n1879|    #expect(!FileManager.default.fileExists(atPath: directory.appendingPathComponent(\"manual-service.plist\").path))\n1880|}\n1881|\n1882|@Test func verifiedLocalAgentIDRefusesEachMismatchClass() {\n1883|    // Pure-gate pin for R2-F2/R2-F5: every unverified member fails, the\n1884|    // matching member binds.\n1885|    let draft = orgDraft()\n1886|    let matching = RunnerRegistration.LocalRegistration(\n1887|        agentID: 4242, agentName: \"macbook-test\",\n1888|        gitHubURL: \"https://github.com/acme\", workFolder: \"_work\"\n1889|    )\n1890|    let verified = try? RunnerRegistration.Gates.verifiedLocalAgentID(local: matching, configured: true, draft: draft)\n1891|    #expect(verified == 4242)\n1892|    let cases: [(RunnerRegistration.LocalRegistration?, Bool, String)] = [\n1893|        (nil, true, \"missing file\"),\n1894|        (RunnerRegistration.LocalRegistration(agentID: nil, agentName: \"macbook-test\", gitHubURL: \"https://github.com/acme\", workFolder: \"_work\"), true, \"missing agentID\"),\n1895|        (RunnerRegistration.LocalRegistration(agentID: 4242, agentName: \"someone-else\", gitHubURL: \"https://github.com/acme\", workFolder: \"_work\"), true, \"wrong name\"),\n1896|        (RunnerRegistration.LocalRegistration(agentID: 4242, agentName: \"macbook-test\", gitHubURL: \"https://github.com/other/repo\", workFolder: \"_work\"), true, \"wrong scope\"),\n1897|        (matching, false, \"unconfigured marker\"),\n1898|    ]\n1899|    for (local, configured, label) in cases {\n1900|        do {\n1901|            _ = try RunnerRegistration.Gates.verifiedLocalAgentID(local: local, configured: configured, draft: draft)\n1902|            Issue.record(\"verifiedLocalAgentID admitted \\(label)\")\n1903|        } catch let error as RunnerRegistration.RegistrationError {\n1904|            guard case .unverifiedRegistration = error else {\n1905|                Issue.record(\"wrong error for \\(label): \\(error)\")\n1906|                continue\n1907|            }\n1908|        } catch {\n1909|            Issue.record(\"unexpected error for \\(label): \\(error)\")\n1910|        }\n1911|    }\n1912|    #expect(RunnerRegistration.Gates.scopeMatches(address: \"https://github.com/ACME/\", scope: .organization(org: \"acme\")))\n1913|    #expect(!RunnerRegistration.Gates.scopeMatches(address: \"https://github.com/acme/app\", scope: .organization(org: \"acme\")))\n1914|    #expect(RunnerRegistration.Gates.scopeMatches(address: \"https://ghe.example.com/octo/app\", scope: .repository(owner: \"octo\", name: \"app\")))\n1915|    #expect(!RunnerRegistration.Gates.scopeMatches(address: \"http://github.com/acme\", scope: .organization(org: \"acme\")))\n1916|}\n1917|\n1918|@Test func boundRemoteRunnerIDBindsByID() {\n1919|    // Pure-gate pin for R2-F2: ID binding with fail-closed mismatch/absence.\n1920|    let runners = [\n1921|        RunnerRegistration.RegisteredRunner(id: 4242, name: \"macbook-test\", labels: []),\n1922|        RunnerRegistration.RegisteredRunner(id: 77, name: \"other-runner\", labels: []),\n1923|    ]\n1924|    do {\n1925|        let bound = try RunnerRegistration.Gates.boundRemoteRunnerID(\n1926|            localAgentID: 4242, name: \"macbook-test\", runners: runners\n1927|        )\n1928|        #expect(bound == 4242)\n1929|        let missing = try RunnerRegistration.Gates.boundRemoteRunnerID(\n1930|            localAgentID: 9999, name: \"ghost-runner\", runners: runners\n1931|        )\n1932|        #expect(missing == nil)\n1933|    } catch {\n1934|        Issue.record(\"unexpected error for exact/absent binding: \\(error)\")\n1935|    }\n1936|    do {\n1937|        _ = try RunnerRegistration.Gates.boundRemoteRunnerID(\n1938|            localAgentID: 9999, name: \"other-runner\",\n1939|            runners: [RunnerRegistration.RegisteredRunner(id: 77, name: \"other-runner\", labels: [])]\n1940|        )\n1941|        Issue.record(\"boundRemoteRunnerID adopted a same-name foreign runner\")\n1942|    } catch let error as RunnerRegistration.RegistrationError {\n1943|        guard case .remoteIdentityMismatch = error else {\n1944|            Issue.record(\"wrong error for foreign name match: \\(error)\")\n1945|            return\n1946|        }\n1947|    } catch {\n1948|        Issue.record(\"unexpected error: \\(error)\")\n1949|    }\n1950|    do {\n1951|        _ = try RunnerRegistration.Gates.boundRemoteRunnerID(\n1952|            localAgentID: 4242, name: \"renamed\",\n1953|            runners: [RunnerRegistration.RegisteredRunner(id: 4242, name: \"macbook-test\", labels: [])]\n1954|        )\n1955|        Issue.record(\"boundRemoteRunnerID admitted a renamed local agent\")\n1956|    } catch let error as RunnerRegistration.RegistrationError {\n1957|        guard case .remoteIdentityMismatch = error else {\n1958|            Issue.record(\"wrong error for renamed agent: \\(error)\")\n1959|            return\n1960|        }\n1961|    } catch {\n1962|        Issue.record(\"unexpected error: \\(error)\")\n1963|    }\n1964|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
