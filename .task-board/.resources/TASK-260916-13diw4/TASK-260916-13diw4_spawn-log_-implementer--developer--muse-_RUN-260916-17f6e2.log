{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d023","stream":{"kind":"session","id":"01a0a8b2-a089-7723-8537-dec58af692fc"},"sequence":1644,"recorded_at":1780531400003283,"record_type":"event","durability":"durable","causation_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f","run_stream":{"kind":"run","id":"1f98f4d5-2046-45d7-b0a2-84eb8d173d9f"},"task_stream":{"kind":"task","id":"01a0a8bc-94e7-7180-80cd-cfa3fc919b98"},"task_id":"01a0a8bc-94e7-7180-80cd-cfa3fc919b98","event":{"kind":"output","task_id":"01a0a8bc-94e7-7180-80cd-cfa3fc919b98","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n(722 line(s) above)\n723|            guard !isStale(gen) else { return }\n724|            let confirmed = try await api.fetchGroupRepositories(\n725|                config: auth.config, token: auth.token, org: org, groupID: group.id\n726|            )\n727|            guard !isStale(gen) else { return }\n728|            // The confirmed list is complete (every page followed). It must\n729|            // equal the request exactly; otherwise the draft keeps the\n730|            // requested selection and the step fails instead of claiming a\n731|            // partial write as success.\n732|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: ids, confirmed: confirmed)\n733|            if var current = self.draft {\n734|                current.selectedRepositoryIDs = Set(confirmed)\n735|                self.draft = current\n736|            }\n737|            await action { RunnerRegistration.Action.repositoryAccessApplied(confirmed) }\n738|            guard !isStale(gen) else { return }\n739|            await action { RunnerRegistration.Action.permissionDismissed }\n740|            pendingRepositoryIDs = nil\n741|            pendingTargetGroupID = nil\n742|            await finishStep(\"applyRepositoryAccess\", generation: gen)\n743|        } catch {\n744|            working = false\n745|            await fail(error, step: \"applyRepositoryAccess\", generation: gen)\n746|        }\n747|    }\n748|\n749|    private func applyLabels(_ labels: [String]) async {\n750|        let gen = generation\n751|        guard !working else { return }\n752|        guard let draft else {\n753|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyLabels\") }\n754|            return\n755|        }\n756|        let trimmed = labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }\n757|        guard !trimmed.isEmpty else {\n758|            failedStep = \"applyLabels\"\n759|            await action {\n760|                RunnerRegistration.Action.failed(message: \"At least one label is required.\", step: \"applyLabels\")\n761|            }\n762|            return\n763|        }\n764|        // Label writes require this operation's verified local identity —\n765|        // checked before any network. A remote name match alone never\n766|        // authorizes mutating another runner.\n767|        guard let installPath else {\n768|            failedStep = \"applyLabels\"\n769|            await action {\n770|                RunnerRegistration.Action.failed(\n771|                    message: \"Register the runner first so labels target this installation.\",\n772|                    step: \"applyLabels\"\n773|                )\n774|            }\n775|            return\n776|        }\n777|        let directory = URL(fileURLWithPath: installPath)\n778|        let localAgentID: Int64\n779|        do {\n780|            let local = await installer.readLocalRegistration(directory: directory)\n781|            let configured = await installer.hasCompleted(\n782|                RunnerInstallerService.stepConfigured, directory: directory\n783|            )\n784|            localAgentID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n785|                local: local, configured: configured, draft: draft\n786|            )\n787|        } catch {\n788|            failedStep = \"applyLabels\"\n789|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"applyLabels\") }\n790|            return\n791|        }\n792|        working = true\n793|        pendingLabels = trimmed\n794|        await action { RunnerRegistration.Action.stepStarted(\"applyLabels\") }\n795|        do {\n796|            // Re-bind on every write: the stored ID is never trusted across\n797|            // edits, retries, or remote drift. A missing agent fails with\n798|            // not-found; a contradictory list fails with mismatch. Neither\n799|            // guesses by name.\n800|            let auth = try await currentUserToken(generation: gen)\n801|            guard !isStale(gen) else { return }\n802|            let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n803|            guard !isStale(gen) else { return }\n804|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n805|            let bound = try RunnerRegistration.Gates.boundRemoteRunnerID(\n806|                localAgentID: localAgentID, name: wanted, runners: runners\n807|            )\n808|            guard let runnerID = bound else {\n809|                throw RunnerRegistration.RegistrationError.remoteRunnerNotFound(\n810|                    \"GitHub does not list agent \\(localAgentID) for this scope yet; refusing to guess '\\(wanted)' by name. Retry after registration converges.\"\n811|                )\n812|            }\n813|            try await api.setRunnerLabels(\n814|                config: auth.config, token: auth.token, scope: draft.scope, runnerID: runnerID, labels: trimmed\n815|            )\n816|            guard !isStale(gen) else { return }\n817|            self.runnerID = runnerID\n818|            if var current = self.draft {\n819|                current.labels = trimmed\n820|                self.draft = current\n821|            }\n822|            await action { RunnerRegistration.Action.labelsApplied(trimmed) }\n823|            pendingLabels = nil\n824|            await finishStep(\"applyLabels\", generation: gen)\n825|        } catch {\n826|            working = false\n827|            await fail(error, step: \"applyLabels\", generation: gen)\n828|        }\n829|    }\n830|\n831|    // MARK: - Retry / cancel / reset\n832|\n833|    private func retry() async {\n834|        guard !working else { return }\n835|        guard let step = failedStep else { return }\n836|        switch step {\n837|        case \"resolveGroup\": await resolveGroup()\n838|        case \"prepareDownload\": await prepareDownload()\n839|        case \"downloadAndInstall\": await downloadAndInstall()\n840|        case \"registerRunner\": await registerRunner()\n841|        case \"setupService\": await setupService()\n842|        case \"applyRepositoryAccess\":\n(more lines below)","final_result":true}}}
