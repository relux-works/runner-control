    /// Fetches the real GitHub runner ID by matching the registered name.
    /// Returns nil when the runner list does not (yet) contain it.
    private func resolveRemoteRunnerID(draft: RunnerRegistration.Draft, generation gen: Int) async throws -> Int64? {
        let auth = try await currentUserToken(generation: gen)
        guard !isStale(gen) else { throw CancellationError() }
        let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)
        let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)
        return runners.first(where: { $0.name == wanted })?.id
    }

