    return plist\n520|    }\n521|\n522|    /// Removes a failed partial install so retries start clean. Refuses to\n523|    /// touch directories that already hold a registration (`.runner`) or an\n524|    /// unknown marker scope: recovery never deletes a working runner.\n525|    public func recoverPartialInstall(directory: URL, scopeKey: String) throws {\n526|        let files = FileManager.default\n527|        guard files.fileExists(atPath: directory.path) else { return }\n528|        // Never delete a directory a live operation still owns; the caller\n529|        // retries after that operation settles.\n530|        try requireIdleDirectory(directory)\n531|        guard !files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n532|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: directory.lastPathComponent)\n533|        }\n534|        if let marker = loadMarker(directory: directory), marker.scopeKey != scopeKey {\n535|            throw RunnerRegistration.RegistrationError.alreadyInstalled(path: directory.path)\n536|        }\n537|        try files.removeItem(at: directory)\n538|    }\n539|}","final_result":true}}}
