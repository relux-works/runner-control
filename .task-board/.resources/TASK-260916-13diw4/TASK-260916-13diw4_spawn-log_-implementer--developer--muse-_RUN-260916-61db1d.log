{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8eb","stream":{"kind":"session","id":"01a0a91f-5a05-7370-bf74-ffa98261cad4"},"sequence":720,"recorded_at":1780531400001435,"record_type":"event","durability":"durable","causation_id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb","run_stream":{"kind":"run","id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb"},"task_stream":{"kind":"task","id":"01a0a924-58ca-7ec2-b625-cc05b8393e26"},"task_id":"01a0a924-58ca-7ec2-b625-cc05b8393e26","event":{"kind":"output","task_id":"01a0a924-58ca-7ec2-b625-cc05b8393e26","chunk":"edited\nchanged lines: lines 68-96\n--- original\n+++ updated\n@@\n-    /// Canonical lease key for a directory: physical filesystem identity, not\n-    /// path spelling. Both Flow-derived URLs (from a stored install path)\n-    /// and `directory(for:)` URLs map to the same key for the same on-disk\n-    /// location, including through symlink leaves and symlink ancestors.\n-    /// Not-yet-created leaves canonicalize via their nearest existing\n-    /// ancestor, so `/tmp`-vs-`/private/tmp` spellings of one directory map\n-    /// to one key before the leaf exists.\n-    nonisolated static func leaseKey(for directory: URL) -> String {\n-        let standardized = URL(fileURLWithPath: directory.path).standardizedFileURL\n-        let files = FileManager.default\n-        var base = standardized\n-        var suffix: [String] = []\n-        while true {\n-            if files.fileExists(atPath: base.path) || Self.isSymlink(atPath: base.path) {\n-                break\n-            }\n-            let parent = base.deletingLastPathComponent()\n-            if parent.path == base.path { break }\n-            suffix.insert(base.lastPathComponent, at: 0)\n-            base = parent\n-        }\n-        let resolvedBase = base.resolvingSymlinksInPath().path\n-        if suffix.isEmpty {\n-            return URL(fileURLWithPath: resolvedBase).standardizedFileURL.path\n-        }\n-        var url = URL(fileURLWithPath: resolvedBase, isDirectory: true)\n-        for component in suffix { url.appendPathComponent(component) }\n-        return url.standardizedFileURL.path\n-    }\n+    /// Canonical lease key for a directory: physical filesystem identity, not\n+    /// path spelling. Both Flow-derived URLs (from a stored install path)\n+    /// and `directory(for:)` URLs map to the same key for the same on-disk\n+    /// location, including through symlink leaves and symlink ancestors.\n+    /// Not-yet-created leaves canonicalize via their nearest existing\n+    /// ancestor, so `/tmp`-vs-`/private/tmp` spellings of one directory map\n+    /// to one key before the leaf exists. On case-insensitive volumes the key\n+    /// is additionally case-folded (POSIX locale), so `macbook-test` and\n+    /// `MACBOOK-TEST` share one lease while the leaf is still absent; the\n+    /// fold matches the on-disk spelling `resolvingSymlinksInPath` returns\n+    /// after creation, keeping identity stable before/after creation.\n+    /// Case-sensitive volumes keep distinct keys per spelling. The\n+    /// sensitivity comes from the real volume unless `caseSensitiveOverride`\n+    /// forces it (tests only).\n+    nonisolated static func leaseKey(for directory: URL, caseSensitiveOverride: Bool? = nil) -> String {\n+        let standardized = URL(fileURLWithPath: directory.path).standardizedFileURL\n+        let files = FileManager.default\n+        var base = standardized\n+        var suffix: [String] = []\n+        while true {\n+            if files.fileExists(atPath: base.path) || Self.isSymlink(atPath: base.path) {\n+                break\n+            }\n+            let parent = base.deletingLastPathComponent()\n+            if parent.path == base.path { break }\n+            suffix.insert(base.lastPathComponent, at: 0)\n+            base = parent\n+        }\n+        let resolvedBase = base.resolvingSymlinksInPath().path\n+        let canonical: String\n+        if suffix.isEmpty {\n+            canonical = URL(fileURLWithPath: resolvedBase).standardizedFileURL.path\n+        } else {\n+            var url = URL(fileURLWithPath: resolvedBase, isDirectory: true)\n+            for component in suffix { url.appendPathComponent(component) }\n+            canonical = url.standardizedFileURL.path\n+        }\n+        let sensitive: Bool\n+        if let override = caseSensitiveOverride {\n+            sensitive = override\n+        } else {\n+            sensitive = Self.isCaseSensitiveVolume(\n+                at: URL(fileURLWithPath: resolvedBase, isDirectory: true)\n+            )\n+        }\n+        guard !sensitive else { return canonical }\n+        return canonical.lowercased(with: Locale(identifier: \"en_US_POSIX\"))\n+    }\n+\n+    /// True only when the volume containing `url` reports case-sensitive\n+    /// names. Unknown or unreadable volumes fail closed toward alias safety\n+    /// (reported insensitive, so spellings fold): on a truly sensitive\n+    /// volume that only over-serializes distinct spellings into a retryable\n+    /// `directoryBusy`, while the reverse would admit concurrent mutations\n+    /// of one physical directory.\n+    nonisolated static func isCaseSensitiveVolume(at url: URL) -> Bool {\n+        (try? url.resourceValues(forKeys: [.volumeSupportsCaseSensitiveNamesKey]))\n+            .flatMap(\\.volumeSupportsCaseSensitiveNames) == true\n+    }\n","final_result":true}}}
