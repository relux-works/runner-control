mesKey])\\n  print(\\\"volumeSupportsCaseSensitiveNames /=\\\\\\\\(String(describing: vals.volumeSupportsCaseSensitiveNames))\\\")\\n} catch { print(\\\"resourceValues / error: \\\\\\\\(error)\\\") }\\n// resolvingSymlinks case preservation for missing leaf\\nlet lower = tmp.appendingPathComponent(\\\"macbook-test\\\")\\nlet upper = tmp.appendingPathComponent(\\\"MACBOOK-TEST\\\")\\nprint(\\\"lower resolving=\\\\\\\\(lower.resolvingSymlinksInPath().path)\\\")\\nprint(\\\"upper resolving=\\\\\\\\(upper.resolvingSymlinksInPath().path)\\\")\\n// create lower, then check upper resolution + fileExists\\ntry fm.createDirectory(at: lower, withIntermediateDirectories: true)\\nprint(\\\"after create lower exists upper? \\\\\\\\(fm.fileExists(atPath: upper.path))\\\")\\nprint(\\\"after create lower resolving=\\\\\\\\(lower.resolvingSymlinksInPath().path)\\\")\\nprint(\\\"after create upper resolving=\\\\\\\\(upper.resolvingSymlinksInPath().path)\\\")\\nlet la = try fm.attributesOfItem(atPath: lower.path)[.systemFileNumber]\\nlet ua = try fm.attributesOfItem(atPath: upper.path)[.systemFileNumber]\\nprint(\\\"inodes lower=\\\\\\\\(String(describing: la)) upper=\\\\\\\\(String(describing: ua)) equal=\\\\\\\\(String(describing: (la as? NSNumber) == (ua as? NSNumber)))\\\")\\n// standardized?\\nprint(\\\"lower standardized=\\\\\\\\(URL(fileURLWithPath: lower.path).standardizedFileURL.path)\\\")\\nprint(\\\"upper standardized=\\\\\\\\(URL(fileURLWithPath: upper.path).standardizedFileURL.path)\\\")\\n// ancestor /TMP case variant\\nlet fakeUpper = URL(fileURLWithPath: \\\"/TMP\\\")\\nprint(\\\"/TMP exists? \\\\\\\\(fm.fileExists(atPath: fakeUpper.path)) resolving=\\\\\\\\(fakeUpper.resolvingSymlinksInPath().path)\\\")\\ntry? fm.removeItem(at: tmp)\\n''')\\nwith tempfile.NamedTemporaryFile(suffix=\\\".swift\\\", delete=False, mode='w') as f:\\n    f.write(swift_code)\\n    path=f.name\\nprint(\\\"probe file\\\", path)\\nr=subprocess.run([\\\"swift\\\", path], capture_output=True, text=True, timeout=60)\\nprint(\\\"STDOUT:\\\\n\\\", r.stdout)\\nprint(\\\"STDERR:\\\\n\\\", r.stderr[-2000:])\\nprint(\\\"RC\\\", r.returncode)\\nPY\",\n  \"description\": \"Probe filesystem case semantics via Swift\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"probe file /var/folders/v5/c7x5kxfd2dvc6gmb1772xdp00000gn/T/tmp5k6lrt79.swift\\nSTDOUT:\\n tmp=/var/folders/v5/c7x5kxfd2dvc6gmb1772xdp00000gn/T/CaseProbe-3239510C-4EAE-47A3-8326-0416AA8CDC1E\\nvolumeSupportsCaseSensitiveNames tmp=Optional(false)\\nvolumeSupportsCaseSensitiveNames /tmp=Optional(false)\\nvolumeSupportsCaseSensitiveNames /=Optional(false)\\nlower resolving=/var/folders/v5/c7x5kxfd2dvc6gmb1772xdp00000gn/T/CaseProbe-3239510C-4EAE-47A3-8326-0416AA8CDC1E/macbook-test\\nupper resolving=/var/folders/v5/c7x5kxfd2dvc6gmb1772xdp00000gn/T/CaseProbe-3239510C-4EAE-47A3-8326-0416AA8CDC1E/MACBOOK-TEST\\nafter create lower exists upper? true\\nafter create lower resolving=/var/folders/v5/c7x5kxfd2dvc6gmb1772xdp00000gn/T/CaseProbe-3239510C-4EAE-47A3-8326-0416AA8CDC1E/macbook-test\\nafter create upper resolving=/var/folders/v5/c7x5kxfd2dvc6gmb1772xdp00000gn/T/CaseProbe-3239510C-4EAE-47A3-8326-0416AA8CDC1E/macbook-test\\ninodes lower=Optional(460498981) upper=Optional(460498981) equal=true\\nlower standardized=/var/folders/v5/c7x5kxfd2dvc6gmb1772xdp00000gn/T/CaseProbe-3239510C-4EAE-47A3-8326-0416AA8CDC1E/macbook-test\\nupper standardized=/var/folders/v5/c7x5kxfd2dvc6gmb1772xdp00000gn/T/CaseProbe-3239510C-4EAE-47A3-8326-0416AA8CDC1E/MACBOOK-TEST\\n/TMP exists? true resolving=/tmp\\n\\nSTDERR:\\n \\nRC 0\\n\",\n  \"original_output_bytes\": 1284,\n  \"original_output_tokens\": 321,\n  \"truncated\": false\n}","final_result":true}}}
