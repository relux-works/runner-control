.apply(RunnerRegistration.Effect.downloadAndInstall) }\n18|    let deadline = Date().addingTimeInterval(10)\n19|    while !(await downloads.started) && Date() < deadline { try? await Task.sleep(nanoseconds: 10_000_000) }\n20|    guard await downloads.started else { #expect(Bool(false), \"Download never started\"); await downloads.release(); _ = await old.value; return }\n21|    #expect(!FileManager.default.fileExists(atPath: harness.installRoot.appendingPathComponent(\"macbook-test\").path))\n22|    var aliasDraft = orgDraft()\n23|    aliasDraft.installDirName = \"MACBOOK-TEST\"\n24|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(aliasDraft))\n25|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n26|    let lower = harness.installRoot.appendingPathComponent(\"macbook-test\")\n27|    let upper = harness.installRoot.appendingPathComponent(\"MACBOOK-TEST\")\n28|    let lowerInode = try FileManager.default.attributesOfItem(atPath: lower.path)[.systemFileNumber] as? NSNumber\n29|    let upperInode = try FileManager.default.attributesOfItem(atPath: upper.path)[.systemFileNumber] as? NSNumber\n30|    #expect(lowerInode != nil && lowerInode == upperInode, \"Attack spellings must address the same filesystem directory\")\n31|    print(\"case-alias evidence: calls=\\(await downloads.calls), lowerInode=\\(String(describing: lowerInode)), upperInode=\\(String(describing: upperInode))\")\n32|    #expect(await downloads.calls == 1, \"Second download must not start while the first owns this directory\")\n33|    #expect(lastFailure(harness.logger)?.step == \"downloadAndInstall\")\n34|    #expect(lastFailure(harness.logger)?.message.contains(\"busy\") ?? false)\n35|    await downloads.release()\n36|    _ = await old.value\n37|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n38|    #expect(await downloads.calls == 1, \"Retry after settle reuses the install instead of downloading again\")\n39|    let state = RunnerRegistration.State()\n40|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n41|    #expect(state.installPath != nil)\n42|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n43|}\n44|","final_result":true}}}
