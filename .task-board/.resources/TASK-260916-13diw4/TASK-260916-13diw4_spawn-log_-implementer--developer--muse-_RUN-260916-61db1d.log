{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5d5","stream":{"kind":"session","id":"01a0a91f-5a05-7370-bf74-ffa98261cad4"},"sequence":325,"recorded_at":1780531400000645,"record_type":"event","durability":"durable","causation_id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb","run_stream":{"kind":"run","id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb"},"task_stream":{"kind":"task","id":"01a0a920-6b64-7513-a886-9dfe16194f76"},"task_id":"01a0a920-6b64-7513-a886-9dfe16194f76","event":{"kind":"output","task_id":"01a0a920-6b64-7513-a886-9dfe16194f76","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(2869 line(s) above)\n2870|        jsonResponse([\"token\": \"REG-NEW\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2871|        runnersListPayload([[\"id\": 4242, \"name\": \"renamed-runner\", \"labels\": []]])\n2872|    ])\n2873|    let h = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor)\n2874|    defer { try? FileManager.default.removeItem(at: h.home) }\n2875|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2876|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2877|    // Gate errors before the latch must fail fast with diagnostics, never\n2878|    // hang in the wait below: without an install the register step cannot\n2879|    // reach config.sh.\n2880|    if let setupFailure = lastFailure(h.logger) {\n2881|        #expect(\n2882|            Bool(false),\n2883|            \"Setup failed before the config latch: [\\(setupFailure.step)] \\(setupFailure.message)\"\n2884|        )\n2885|        return\n2886|    }\n2887|    let old = Task { await h.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2888|    guard await waitForConfigStart(executor, timeoutSeconds: 30) else {\n2889|        let detail = lastFailure(h.logger).map { \"[\\($0.step)] \\($0.message)\" } ?? \"no Flow failure recorded\"\n2890|        #expect(Bool(false), \"config.sh never started within 30s; Flow failure: \\(detail)\")\n2891|        await executor.release()\n2892|        _ = await old.value\n2893|        return\n2894|    }\n2895|    var edited = orgDraft()\n2896|    edited.runnerName = \"renamed-runner\"\n2897|    edited.installDirName = \"alias-install\"\n2898|    try FileManager.default.createSymbolicLink(\n2899|        at: h.installRoot.appendingPathComponent(\"alias-install\"),\n2900|        withDestinationURL: h.installRoot.appendingPathComponent(\"macbook-test\"))\n2901|    _ = await h.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2902|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2903|    _ = await h.flow.apply(RunnerRegistration.Effect.registerRunner)\n2904|    let callsWhileOldRuns = await executor.configCalls.count\n2905|    await executor.release()\n2906|    _ = await old.value\n2907|    #expect(callsWhileOldRuns == 1, \"An identity edit must not allow a second config.sh while the first still owns this directory\")\n2908|    let state = RunnerRegistration.State()\n2909|    for action in registrationActions(h.logger) { await state.reduce(with: action) }\n2910|    let directory = await h.installer.directory(for: edited.installDirName)\n2911|    let local = await h.installer.readLocalRegistration(directory: directory)\n2912|    #expect(!state.completedSteps.contains(\"registerRunner\") || local?.agentName == edited.runnerName,\n2913|            \"New registration is attested complete but old in-flight config overwrites .runner afterwards\")\n2914|}\n2915|\n2916|@Test func leaseKeyCanonicalizesSymlinkAncestorsForMissingLeaf() throws {\n2917|    // R6 ancestor control: nearest-existing-ancestor resolution maps one\n2918|    // physical directory to one lease key before the leaf exists, while\n2919|    // different physical directories keep different keys.\n2920|    let files = FileManager.default\n2921|    let root = files.temporaryDirectory.appendingPathComponent(\"LeaseAncestor-\" + UUID().uuidString)\n2922|    let real = root.appendingPathComponent(\"real\")\n2923|    try files.createDirectory(at: real, withIntermediateDirectories: true)\n2924|    defer { try? files.removeItem(at: root) }\n2925|    try files.createSymbolicLink(at: root.appendingPathComponent(\"link\"), withDestinationURL: real)\n2926|    let viaReal = RunnerInstallerService.leaseKey(\n2927|        for: real.appendingPathComponent(\"missing-leaf\"))\n2928|    let viaLink = RunnerInstallerService.leaseKey(\n2929|        for: root.appendingPathComponent(\"link\").appendingPathComponent(\"missing-leaf\"))\n2930|    #expect(viaReal == viaLink, \"One physical dir must map to one lease key through a symlink ancestor\")\n2931|    let other = RunnerInstallerService.leaseKey(for: root.appendingPathComponent(\"other-dir\"))\n2932|    #expect(other != viaReal, \"Different physical dirs must keep different leases\")\n2933|}\n2934|\n2935|private actor DownloadCounter {\n2936|    private let bytes: Data\n2937|    private(set) var calls = 0\n2938|    init(bytes: Data) { self.bytes = bytes }\n2939|    func download(_ url: URL) async throws -> Data {\n2940|        calls += 1\n2941|        return bytes\n2942|    }\n2943|}\n2944|\n2945|@Test @MainActor func finderAliasInstallFolderIsRefusedBeforeDownload() async throws {\n2946|    // R6 alias control: a Finder-alias install folder is refused before any\n2947|    // download side effect, through the production Flow entry point.\n2948|    let package = try await FixturePackage.make()\n2949|    let counter = DownloadCounter(bytes: package.bytes)\n2950|    let transport = TestTransport([\n2951|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2952|    ])\n2953|    let h = await registrationHarness(\n2954|        transport: transport, downloader: { url in try await counter.download(url) }\n2955|    )\n2956|    defer { try? FileManager.default.removeItem(at: h.home) }\n2957|    let target = h.home.appendingPathComponent(\"real-target\")\n2958|    try FileManager.default.createDirectory(at: target, withIntermediateDirectories: true)\n2959|    let aliasURL = h.installRoot.appendingPathComponent(\"alias-dir\")\n2960|    let bookmark = try target.bookmarkData(options: .suitableForBookmarkFile)\n2961|    try URL.writeBookmarkData(bookmark, to: aliasURL)\n2962|    var draft = orgDraft()\n2963|    draft.installDirName = \"alias-dir\"\n2964|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n2965|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2966|    #expect(await counter.calls == 0, \"Alias path must be refused before any download side effect\")\n2967|    let failure = lastFailure(h.logger)\n2968|    #expect(failure?.step == \"downloadAndInstall\")\n2969|    #expect(failure?.message.contains(\"alias\") ?? false)\n2970|}","final_result":true}}}
