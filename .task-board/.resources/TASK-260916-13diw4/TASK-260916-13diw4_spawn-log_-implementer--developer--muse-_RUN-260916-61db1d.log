y:\\n  group: runner-control-release\\n  cancel-in-progress: false\\njobs:\\n  release:\\n    runs-on: [self-hosted, macOS, ARM64, macbook-iv]\\n    environment: release\\n    timeout-minutes: 90\\n    env:\\n      RELEASE_TAG: ${{ inputs.tag || github.ref_name }}\\n      NOTARY_PROFILE: RunnerControl-notary\\n      GH_TOKEN: ${{ github.token }}\\n    steps:\\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\\n        with:\\n          ref: ${{ inputs.tag || github.ref }}\\n          fetch-depth: 0\\n      - name: Validate trusted release tag\\n        shell: bash\\n        run: |\\n          [[ \\\"$RELEASE_TAG\\\" =~ ^v[0-9]+\\\\.[0-9]+\\\\.[0-9]+$ ]]\\n          test \\\"$(git rev-parse HEAD)\\\" = \\\"$(git rev-parse \\\"$RELEASE_TAG^{commit}\\\")\\\"\\n          git merge-base --is-ancestor HEAD origin/main\\n          if gh release view \\\"$RELEASE_TAG\\\" >/dev/null 2>&1; then\\n            echo 'Release already exists. Inspect it before retrying; no published assets are overwritten.' >&2\\n            exit 1\\n          fi\\n      - name: Release prerequisites\\n        run: ./Scripts/release-preflight.sh\\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\\n        with:\\n          go-version: '1.25.5'\\n          cache: false\\n      - name: Build pinned scaffold generator\\n        shell: bash\\n        run: |\\n          git clone https://github.com/relux-works/skill-ios-app-manager.git \\\"$RUNNER_TEMP/runner-control-generator-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT\\\"\\n          cd \\\"$RUNNER_TEMP/runner-control-generator-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT\\\"\\n          git checkout --detach 755a29538dfe0867671ac4291b016bf42d93a299\\n          cd tuist-starter\\n          env -u GOROOT go build -o \\\"$RUNNER_TEMP/runner-control-ios-app-manager\\\" ./cmd/ios-app-manager\\n          echo \\\"IOS_APP_MANAGER=$RUNNER_TEMP/runner-control-ios-app-manager\\\" >> \\\"$GITHUB_ENV\\\"\\n      - name: Unit tests\\n        run: |\\n          swift test --package-path Packages/RunnerControlCore --scratch-path \\\"$RUNNER_TEMP/runner-control-release-tests\\\"\\n          python3 -m unittest discover -s Scripts/tests -v\\n      - name: Build, notarize, staple and sign appcast\\n        id: package\\n        run: ./Scripts/release.sh\\n      - name: Publish complete GitHub Release\\n        env:\\n          RELEASE_DIST: ${{ steps.package.outputs.dist }}\\n\",\n  \"original_output_bytes\": 3128,\n  \"original_output_tokens\": 782,\n  \"truncated\": false\n}","final_result":true}}}
