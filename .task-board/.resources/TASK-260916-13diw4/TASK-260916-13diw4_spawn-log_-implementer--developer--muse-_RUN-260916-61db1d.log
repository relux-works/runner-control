c release(_ n: Int) { releases.removeValue(forKey: n)?.resume() }\n2606|}\n2607|\n2608|@Test func reviewerStaleFailureCannotUnlockNewOperation() async throws {\n2609|    let package = try await FixturePackage.make()\n2610|    let latch = ReviewTwoDownloads()\n2611|    let transport = TestTransport([\n2612|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2613|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))\n2614|    ])\n2615|    let h = await registrationHarness(transport: transport, downloader: { _ in try await latch.download(package.bytes) })\n2616|    defer { try? FileManager.default.removeItem(at: h.home) }\n2617|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2618|    let old = Task { await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2619|    await latch.waitStarted(1)\n2620|    var edited = orgDraft()\n2621|    edited.installDirName = \"new-install\"\n2622|    _ = await h.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2623|    let current = Task { await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2624|    await latch.waitStarted(2)\n2625|    await latch.release(1)\n2626|    _ = await old.value\n2627|    let before = await transport.requests.count\n2628|    _ = await h.flow.apply(RunnerRegistration.Effect.prepareDownload)\n2629|    let after = await transport.requests.count\n2630|    await latch.release(2)\n2631|    _ = await current.value\n2632|    #expect(after == before, \"Old generation's catch must not clear the current operation's working lock\")\n2633|}\n2634|\n2635|// MARK: - R5: lifecycle ownership across begin/update/cancel/reset\n2636|\n2637|// Latch downloader: suspends the FIRST download so an abandoning edit can\n2638|// land while an install is in flight; later downloads pass through. Counts\n2639|// every call so tests prove a refused retry started no second download.\n2640|private actor CountingLatchDownloader {\n2641|    private let bytes: Data\n2642|    private(set) var calls = 0\n2643|    private var latched = false\n2644|    var started = false\n2645|    private var waiter: CheckedContinuation<Void, Never>?\n2646|    private var releaseWaiter: CheckedContinuation<Void, Never>?\n2647|    init(bytes: Data) { self.bytes = bytes }\n2648|    func download(_ url: URL) async throws -> Data {\n2649|        calls += 1\n2650|        if !latched {\n2651|            latched = true\n2652|            started = true\n2653|            waiter?.resume(); waiter = nil\n2654|            await withCheckedContinuation { releaseWaiter = $0 }\n2655|        }\n2656|        return bytes\n2657|    }\n2658|    func waitStarted() async {\n2659|        if started { return }\n2660|        await withCheckedContinuation { waiter = $0 }\n2661|    }\n2662|    func release() { releaseWaiter?.resume(); releaseWaiter = nil }\n2663|}\n2664|\n2665|@Test @MainActor func beginDraftDuringDownloadKeepsDirectoryLease() async throws {\n2666|    // R5/R4-F1 at the beginDraft boundary: a new draft for the SAME directory\n2667|    // releases the UI lock but never the live install's directory lease. A\n2668|    // same-directory retry while the first install runs is refused retryably\n2669|    // (no second download); after the first settles stale, retry reuses it.\n2670|    let package = try await FixturePackage.make()\n2671|    let downloads = CountingLatchDownloader(bytes: package.bytes)\n2672|    let transport = TestTransport([\n2673|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2674|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2675|    ])\n2676|    let harness = await registrationHarness(\n2677|        transport: transport, downloader: { url in try await downloads.download(url) }\n2678|    )\n2679|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2680|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2681|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2682|    await downloads.waitStarted()\n2683|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2684|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2685|    #expect(await downloads.calls == 1, \"Second download must not start while the first owns this directory\")\n2686|    #expect(lastFailure(harness.logger)?.step == \"downloadAndInstall\")\n2687|    #expect(lastFailure(harness.logger)?.message.contains(\"busy\") ?? false)\n2688|    await downloads.release()\n2689|    _ = await old.value\n2690|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n2691|    #expect(await downloads.calls == 1, \"Retry after settle reuses the install instead of downloading again\")\n2692|    let state = RunnerRegistration.State()\n2693|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2694|    #expect(state.installPath != nil)\n2695|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n2696|}\n2697|\n2698|@Test @MainActor func resetDuringDownloadKeepsDirectoryLeaseUntilSettled() async throws {\n2699|    // R5/R4-F1 at the reset boundary: reset releases the UI lock at once,\n2700|    // but the live install keeps its directory lease until it settles. A\n2701|    // same-directory install for the fresh draft is refused while live and\n2702|    // reuses the settled install on retry.\n2703|    let package = try await FixturePackage.make()\n2704|    let downloads = CountingLatchDownloader(bytes: package.bytes)\n2705|    let transport = TestTransport([\n2706|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2707|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2708|    ])\n2709|    let harness = await registrationHarness(\n2710|        transport: transport, downloader: { url