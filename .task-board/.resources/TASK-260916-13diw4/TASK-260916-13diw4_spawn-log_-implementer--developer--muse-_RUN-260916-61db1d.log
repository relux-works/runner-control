allDirName = \"alias-dir\"\n2966|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n2967|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2968|    #expect(await counter.calls == 0, \"Alias path must be refused before any download side effect\")\n2969|    let failure = lastFailure(h.logger)\n2970|    #expect(failure?.step == \"downloadAndInstall\")\n2971|    #expect(failure?.message.contains(\"alias\") ?? false)\n2972|}","final_result":true}}}
