\"registerRunner\"))\n2771|    let scopeKey = RunnerRegistration.Flow.tokenScopeKey(draft: orgDraft())\n2772|    #expect(await harness.registrationTokens.load(scopeKey: scopeKey) == nil, \"Both minted tokens are deleted\")\n2773|}\n2774|\n2775|@Test @MainActor func nonconflictingInstallProceedsWhileOtherDirectoryRuns() async throws {\n2776|    // R5 lease scope: the lease is per-directory, not global. While an\n2777|    // install for dirA is live (then abandoned), an install for dirB\n2778|    // proceeds; the old completion stays unattested for the new draft.\n2779|    let package = try await FixturePackage.make()\n2780|    let downloads = CountingLatchDownloader(bytes: package.bytes)\n2781|    let transport = TestTransport([\n2782|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2783|    ])\n2784|    let harness = await registrationHarness(\n2785|        transport: transport, downloader: { url in try await downloads.download(url) }\n2786|    )\n2787|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2788|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2789|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2790|    await downloads.waitStarted()\n2791|    var moved = orgDraft()\n2792|    moved.installDirName = \"new-install\"\n2793|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(moved))\n2794|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2795|    #expect(await downloads.calls == 2, \"Nonconflicting directory must not be blocked by another live install\")\n2796|    let mid = RunnerRegistration.State()\n2797|    for item in registrationActions(harness.logger) { await mid.reduce(with: item) }\n2798|    #expect(mid.installPath?.hasSuffix(\"new-install\") ?? false)\n2799|    #expect(mid.completedSteps.contains(\"downloadAndInstall\"))\n2800|    await downloads.release()\n2801|    _ = await old.value\n2802|    let state = RunnerRegistration.State()\n2803|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2804|    #expect(state.installPath?.hasSuffix(\"new-install\") ?? false)\n2805|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n2806|    let installed = registrationActions(harness.logger).filter {\n2807|        if case .installed = $0 { true } else { false }\n2808|    }\n2809|    #expect(installed.count == 1, \"Abandoned install must not attest a second path\")\n2810|}\n2811|\n2812|@Test @MainActor func staleRegisterFailureDoesNotUnlockOrPlantFailure() async throws {\n2813|    // R5/R4-F2 for the register step: while a config.sh is live, the draft\n2814|    // moves to another directory and that install completes. When the old\n2815|    // config then fails, its stale exit records nothing: no failure is\n2816|    // planted and no success is revoked.\n2817|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2818|    let executor = ConfigLatchExecutor(failure: CommandResult(code: 1, output: \"config exploded\"))\n2819|    let transport = TestTransport([\n2820|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2821|        runnersListPayload([]),\n2822|        jsonResponse([\"token\": \"REG-OLD\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2823|    ])\n2824|    let harness = await registrationHarness(\n2825|        transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor\n2826|    )\n2827|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2828|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2829|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2830|    let old = Task { await harness.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2831|    await executor.waitStarted()\n2832|    var moved = orgDraft()\n2833|    moved.installDirName = \"new-install\"\n2834|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(moved))\n2835|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2836|    await executor.release()\n2837|    _ = await old.value\n2838|    #expect(lastFailure(harness.logger) == nil, \"Stale register failure must not plant a failure for the new draft\")\n2839|    let state = RunnerRegistration.State()\n2840|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2841|    #expect(state.installPath?.hasSuffix(\"new-install\") ?? false)\n2842|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n2843|    #expect(state.failedStep == nil)\n2844|}\n2845|\n2846|// MARK: - R6: canonical directory lease (repeat-of R4-F1 / R5-F1)\n2847|\n2848|/// Bounded latch wait: polls the config latch's started flag so a config.sh\n2849|/// that never starts (for example a gate error thrown before the latch)\n2850|/// becomes a reported failure carrying the Flow diagnostics instead of an\n2851|/// infinite hang. The timeout is generous — latches normally fire in well\n2852|/// under a second — and the regression assertions below are unchanged.\n2853|private func waitForConfigStart(_ executor: ConfigLatchExecutor, timeoutSeconds: Double) async -> Bool {\n2854|    let deadline = Date().addingTimeInterval(timeoutSeconds)\n2855|    while true {\n2856|        if await executor.started { return true }\n2857|        if Date() >= deadline { return false }\n2858|        try? await Task.sleep(nanoseconds: 50_000_000)\n2859|    }\n2860|}\n2861|\n2862|@Test @MainActor func reviewerSymlinkAliasCannotBypassDirectoryLease() async throws {\n2863|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2864|    let executor = ConfigLatchExecutor()\n2865|    let transport = TestTransport([\n2866|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2867|        runnersListPayload([]),\n2868|        jsonResponse([\"token\": \"REG-OLD\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2869|        runnersListPayload([]),\n2870|        jsonResponse([\"token\": \"REG-NEW\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2871|        runnersListPayload([[\"id\": 4242, \"name\": \"renamed-runner\", \"labels\": []]])\n2872|    ])\n2873|    let h = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor)\n2874|    defer { try? FileManager.default.removeItem(at: h.home) }\n2875|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2876|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2877|    // Gate errors before the latch must fail fast with diagnostics, never\n2878|    // hang in the wait below: without an install the register step cannot\n2879|    // reach config.sh.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
