{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c51d","stream":{"kind":"session","id":"01a0a91f-5a05-7370-bf74-ffa98261cad4"},"sequence":233,"recorded_at":1780531400000461,"record_type":"event","durability":"durable","causation_id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb","run_stream":{"kind":"run","id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb"},"task_stream":{"kind":"task","id":"01a0a91f-eed8-70e3-ad6e-0887b2473a15"},"task_id":"01a0a91f-eed8-70e3-ad6e-0887b2473a15","event":{"kind":"output","task_id":"01a0a91f-eed8-70e3-ad6e-0887b2473a15","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n1|import CryptoKit\n2|import Foundation\n3|\n4|/// Filesystem installer for downloaded GitHub Actions runners.\n5|///\n6|/// Production path: download bytes → SHA-256 verify → tar extract →\n7|/// `bin/runsvc.sh` copied into the root and chmodded (as official `svc.sh`\n8|/// would) → exact `config.sh` invocation → manual LaunchAgent plist.\n9|/// All side effects stay below `installRoot`; tests inject a temporary root,\n10|/// a fake downloader, and fixtures instead of touching production runners.\n11|public actor RunnerInstallerService {\n12|    public static let markerFileName = \".runnercontrol-install.json\"\n13|    public static let installOS = \"osx\"\n14|\n15|    private let installRoot: URL\n16|    private let downloader: @Sendable (URL) async throws -> Data\n17|    private let executor: any CommandExecuting\n18|    private let currentArch: @Sendable () -> String\n19|    private let hasher: @Sendable (Data) -> String\n20|\n21|    public init(\n22|        installRoot: URL? = nil,\n23|        downloader: (@Sendable (URL) async throws -> Data)? = nil,\n24|        executor: (any CommandExecuting)? = nil,\n25|        currentArch: (@Sendable () -> String)? = nil,\n26|        hasher: (@Sendable (Data) -> String)? = nil\n27|    ) {\n28|        self.installRoot = installRoot\n29|            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/GitHubActions\")\n30|        self.downloader = downloader ?? { url in\n31|            let (data, _) = try await URLSession.shared.data(from: url)\n32|            return data\n33|        }\n34|        self.executor = executor ?? CommandExecutor()\n35|        self.currentArch = currentArch ?? {\n36|            #if arch(arm64)\n37|            return \"arm64\"\n38|            #else\n39|            return \"x64\"\n40|            #endif\n41|        }\n42|        self.hasher = hasher ?? { data in\n43|            SHA256.hash(data: data).map { String(format: \"%02x\", $0) }.joined()\n44|        }\n45|    }\n46|\n47|    public nonisolated var root: URL { installRoot }\n48|    public nonisolated var architecture: String { currentArch() }\n49|\n50|    /// Canonical installation directories with a live mutating side effect\n51|    /// (download/extract/config/service/recovery). Acquired synchronously\n52|    /// before the first await and released only when the owning operation\n53|    /// settles, so actor reentrancy can never admit two mutations of one\n54|    /// directory. Abandoning a UI generation does not release this resource;\n55|    /// only the settling side effect does.\n56|    private var activeDirectories: Set<String> = []\n57|\n58|    public func directory(for installDirName: String) -> URL {\n59|        installRoot.appendingPathComponent(installDirName)\n60|    }\n61|\n62|    /// Canonical lease key for a directory: physical filesystem identity, not\n63|    /// path spelling. Both Flow-derived URLs (from a stored install path)\n64|    /// and `directory(for:)` URLs map to the same key for the same on-disk\n65|    /// location, including through symlink leaves and symlink ancestors.\n66|    /// Not-yet-created leaves canonicalize via their nearest existing\n67|    /// ancestor, so `/tmp`-vs-`/private/tmp` spellings of one directory map\n68|    /// to one key before the leaf exists.\n69|    nonisolated static func leaseKey(for directory: URL) -> String {\n70|        let standardized = URL(fileURLWithPath: directory.path).standardizedFileURL\n71|        let files = FileManager.default\n72|        var base = standardized\n73|        var suffix: [String] = []\n74|        while true {\n75|            if files.fileExists(atPath: base.path) || Self.isSymlink(atPath: base.path) {\n76|                break\n77|            }\n78|            let parent = base.deletingLastPathComponent()\n79|            if parent.path == base.path { break }\n80|            suffix.insert(base.lastPathComponent, at: 0)\n81|            base = parent\n82|        }\n83|        let resolvedBase = base.resolvingSymlinksInPath().path\n84|        if suffix.isEmpty {\n85|            return URL(fileURLWithPath: resolvedBase).standardizedFileURL.path\n86|        }\n87|        var url = URL(fileURLWithPath: resolvedBase, isDirectory: true)\n88|        for component in suffix { url.appendPathComponent(component) }\n89|        return url.standardizedFileURL.path\n90|    }\n91|\n92|    private nonisolated static func isSymlink(atPath path: String) -> Bool {\n93|        (try? FileManager.default.destinationOfSymbolicLink(atPath: path)) != nil\n94|    }\n95|\n96|    /// Refuses Finder-alias installation paths before any side effect. A\n97|    /// Finder alias is not a transparent directory like a symlink: operating\n98|    /// through its spelling would not operate on the target, so alias\n99|    /// spellings are rejected instead of being canonicalized. Symlinks are\n100|    /// resolved by `leaseKey`, not refused here — and must be excluded\n101|    /// explicitly because `isAliasFileKey` is also true for symlinks such as\n102|    /// the system `/var` and `/tmp` links every temporary path resolves\n103|    /// through.\n104|    nonisolated static func ensureNoAlias(at directory: URL) throws {\n105|        var current = URL(fileURLWithPath: directory.path).standardizedFileURL\n106|        while true {\n107|            if FileManager.default.fileExists(atPath: current.path),\n108|               !isSymlink(atPath: current.path),\n109|               (try? current.resourceValues(forKeys: [.isAliasFileKey]))?.isAliasFile == true {\n110|                throw RunnerRegistration.RegistrationError.invalidDraft(\n111|                    \"Installation path '\\(directory.path)' resolves through a Finder alias at '\\(current.path)'. Choose a direct folder path instead of an alias.\"\n112|                )\n113|            }\n114|            let parent = current.deletingLastPathComponent()\n115|            if parent.path == current.path { break }\n116|            current = parent\n117|        }\n118|    }\n119|\n120|    /// Acquires exclusive ownership of `directory`. Synchronous: callers must\n121|    /// invoke it before their first await so the check-and-insert is atomic\n122|    /// under actor isolation. Throws a retryable `directoryBusy` when another\n123|    /// live operation already owns the directory; different physical\n124|    /// directories never conflict. Returns the originally acquired canonical\n125|    /// key; the caller must hold it across awaits and release that exact key.\n126|    private func acquireLease(for directory: URL) throws -> String {\n127|        try Self.ensureNoAlias(at: directory)\n128|        let key = Self.leaseKey(for: directory)\n129|        guard !activeDirectories.contains(key) else {\n130|            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n131|        }\n132|        activeDirectories.insert(key)\n133|        return key\n134|    }\n135|\n136|    private func releaseLease(_ key: String) {\n137|        activeDirectories.remove(key)\n138|    }\n139|\n140|    /// Refuses a synchronous mutation (service setup, recovery) while a live\n141|    /// async side effect owns the directory. No insert: without an await the\n142|    /// caller itself cannot interleave, it only needs to respect leases held\n143|    /// by others. Uses the same canonical identity as acquisition.\n144|    private func requireIdleDirectory(_ directory: URL) throws {\n145|        try Self.ensureNoAlias(at: directory)\n146|        guard !activeDirectories.contains(Self.leaseKey(for: directory)) else {\n147|            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n148|        }\n149|    }\n150|\n151|    // MARK: - Idempotency markers\n152|\n153|    public struct Marker: Codable, Sendable, Equatable {\n154|        public var scopeKey: String\n155|        public var completedSteps: Set<String>\n156|        /// Server the directory was configured against (`.runner` host is\n157|        /// authoritative; this records the config-time expectation so a\n158|        /// group/server change cannot reuse an old configured marker).\n159|        public var serverHost: String?\n160|        /// Dedicated group passed to `config.sh --runnergroup` (org scope).\n161|        /// `.runner` does not record it, so the marker must: a group-name\n162|        /// edit never claims the old group's configuration as its own.\n163|        public var groupName: String?\n164|        public init(\n165|            scopeKey: String, completedSteps: Set<String> = [],\n166|            serverHost: String? = nil, groupName: String? = nil\n167|        ) {\n168|            self.scopeKey = scopeKey; self.completedSteps = completedSteps\n169|            self.serverHost = serverHost; self.groupName = groupName\n170|        }\n171|    }\n172|\n173|    public static let stepDownloaded = \"downloaded\"\n174|    public static let stepInstalled = \"installed\"\n175|    public static let stepConfigured = \"configured\"\n176|    public static let stepServiceReady = \"serviceReady\"\n177|\n178|    public func loadMarker(directory: URL) -> Marker? {\n179|        let url = directory.appendingPathComponent(Self.markerFileName)\n180|        guard let data = try? Data(contentsOf: url) else { return nil }\n181|        return try? JSONDecoder().decode(Marker.self, from: data)\n182|    }\n183|\n184|    private func storeMarker(_ marker: Marker, directory: URL) throws {\n185|        let data = try JSONEncoder().encode(marker)\n186|        try data.write(to: directory.appendingPathComponent(Self.markerFileName), options: .atomic)\n187|    }\n188|\n189|    public func markCompleted(\n190|        _ step: String, directory: URL, scopeKey: String,\n191|        serverHost: String? = nil, groupName: String? = nil\n192|    ) throws {\n193|        var marker = loadMarker(directory: directory) ?? Marker(scopeKey: scopeKey)\n194|        marker.completedSteps.insert(step)\n195|        if let serverHost { marker.serverHost = serverHost }\n196|        if let groupName { marker.groupName = groupName }\n197|        try storeMarker(marker, directory: directory)\n198|    }\n199|\n200|    public func hasCompleted(_ step: String, directory: URL) -> Bool {\n201|        loadMarker(directory: directory)?.completedSteps.contains(step) == true\n202|    }\n203|\n204|    // MARK: - Install\n205|\n206|    /// Downloads, verifies, and extracts the official package. Idempotent:\n207|    /// a completed `installed` marker with matching scope and server skips\n208|    /// the work. Refuses to overwrite an already-registered directory (no\n209|    /// duplicates).\n210|    public func downloadAndInstall(\n211|        asset: RunnerRegistration.DownloadAsset,\n212|        draft: RunnerRegistration.Draft,\n213|        serverHost: String? = nil\n214|    ) async throws -> URL {\n215|        try RunnerRegistration.Gates.validateNoSpace(\n216|            installDirName: draft.installDirName, workFolder: draft.workFolder\n217|        )\n218|        let directory = self.directory(for: draft.installDirName)\n219|        if directory.path.contains(\" \") {\n220|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n221|        }\n222|        // Exclusive ownership for the whole mutation, acquired before the\n223|        // first await (reuse check included): a same-directory retry while\n224|        // this install is live is refused retryably instead of starting a\n225|        // second download/extract over the same directory. The originally\n226|        // acquired canonical key is held across awaits and released exactly.\n227|        let lease = try acquireLease(for: directory)\n228|        defer { releaseLease(lease) }\n229|        let files = FileManager.default\n230|        if let marker = loadMarker(directory: directory),\n231|           marker.completedSteps.contains(Self.stepInstalled),\n232|           marker.scopeKey == draft.scope.scopeKey,\n233|           Self.markerServerMatches(marker: marker, serverHost: serverHost),\n234|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n235|            return directory\n236|        }\n237|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n238|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: draft.runnerName)\n239|        }\n240|        let bytes: Data\n241|        do {\n242|            bytes = try await downloader(asset.downloadURL)\n243|        } catch {\n244|            throw RunnerRegistration.RegistrationError.network(\"Runner download failed: \\(error.localizedDescription)\")\n245|        }\n246|        // Fail closed: the official downloads endpoint documents\n247|        // `sha256_checksum`, and an install without a verified digest is\n248|        // refused rather than trusted on TLS alone.\n249|        guard let expected = asset.sha256Checksum, !expected.isEmpty else {\n250|            throw RunnerRegistration.RegistrationError.integrityMismatch\n251|        }\n252|        let actual = hasher(bytes)\n253|        guard actual.lowercased() == expected.lowercased() else {\n254|            throw RunnerRegistration.RegistrationError.integrityMismatch\n255|        }\n256|        try files.createDirectory(at: directory, withIntermediateDirectories: true)\n257|        let archive = files.temporaryDirectory.appendingPathComponent(UUID().uuidString + \"-\" + asset.filename)\n258|        defer { try? files.removeItem(at: archive) }\n259|        try bytes.write(to: archive, options: .atomic)\n260|        let result = try await executor.run(\"/usr/bin/tar\", [\"-xzf\", archive.path, \"-C\", directory.path])\n261|        guard result.code == 0 else {\n262|            throw RunnerRegistration.RegistrationError.network(\n263|                \"Runner archive extraction failed: \\(String(result.output.prefix(300)))\"\n264|            )\n265|        }\n266|        // Official packages keep runsvc.sh under bin/ until svc.sh installs it;\n267|        // a bare extraction leaves the root copy absent, so install it here.\n268|        try installRunsvc(directory: directory)\n269|        try markCompleted(\n270|            Self.stepDownloaded, directory: directory,\n271|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n272|        )\n273|        try markCompleted(\n274|            Self.stepInstalled, directory: directory,\n275|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n276|        )\n277|        return directory\n278|    }\n279|\n280|    /// Server binding for install reuse. A marker written without a server\n281|    /// (pre-revision-4) never satisfies a server-bound request: the next\n282|    /// install re-verifies instead of reusing unknown provenance. Direct\n283|    /// installer calls without a server (unit fixtures) keep the legacy\n284|    /// scope-only reuse.\n285|    static func markerServerMatches(marker: Marker, serverHost: String?) -> Bool {\n286|        guard let want = serverHost else { return true }\n287|        guard let have = marker.serverHost else { return false }\n288|        return RunnerRegistration.OperationIdentity.normalizeServerHost(have)\n289|            == RunnerRegistration.OperationIdentity.normalizeServerHost(want)\n290|    }\n291|\n292|    /// Copies official `bin/runsvc.sh` into the installation root and makes\n293|    /// it executable, mirroring what official `svc.sh install` would do.\n294|    public func installRunsvc(directory: URL) throws {\n295|        let files = FileManager.default\n296|        let source = directory.appendingPathComponent(\"bin/runsvc.sh\")\n297|        let target = directory.appendingPathComponent(\"runsvc.sh\")\n298|        guard files.fileExists(atPath: source.path) else {\n299|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing bin/runsvc.sh.\")\n300|        }\n301|        if files.fileExists(atPath: target.path) {\n302|            try files.removeItem(at: target)\n303|        }\n304|        try files.copyItem(at: source, to: target)\n305|        try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: target.path)\n306|    }\n307|\n308|    // MARK: - Configure\n309|\n310|    /// Runs the exact `config.sh` invocation. Skips when a previous attempt\n311|    /// already registered this directory (marker + `.runner` present), so\n312|    /// retries never create orphan or duplicate GitHub registrations.\n313|    /// Returns the local agent ID read back from `.runner`.\n314|    @discardableResult\n315|    public func runConfig(\n316|        directory: URL,\n317|        scopeURL: String,\n318|        token: String,\n319|        draft: RunnerRegistration.Draft,\n320|        runnerGroup: String?\n321|    ) async throws -> Int64? {\n322|        try await runConfig(\n323|            directory: directory, scopeURL: scopeURL, token: token,\n324|            draft: draft, runnerGroup: runnerGroup, replace: draft.allowReplace\n325|        )\n326|    }\n327|\n328|    /// Explicit-`replace` variant. Production callers pass\n329|    /// `draft.allowReplace`; tests drive both values.\n330|    @discardableResult\n331|    public func runConfig(\n332|        directory: URL,\n333|        scopeURL: String,\n334|        token: String,\n335|        draft: RunnerRegistration.Draft,\n336|        runnerGroup: String?,\n337|        replace: Bool\n338|    ) async throws -> Int64? {\n339|        let files = FileManager.default\n340|        let scopeHost = URL(string: scopeURL)?.host ?? \"\"\n341|        // Exclusive ownership for the whole config, acquired before the\n342|        // first await (resume checks included): a same-directory retry while\n343|        // this config.sh is live is refused retryably instead of invoking a\n344|        // second config.sh over the same .runner. The lease is released only\n345|        // when this operation settles; an abandoned UI generation never\n346|        // releases it. The originally acquired canonical key is held across\n347|        // awaits and released exactly.\n348|        let lease = try acquireLease(for: directory)\n349|        defer { releaseLease(lease) }\n350|        if hasCompleted(Self.stepConfigured, directory: directory),\n351|           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n352|            // Idempotent resume never returns a stale ID: the existing\n353|            // configuration must still match this draft on this server.\n354|            let local = readLocalRegistration(directory: directory)\n355|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n356|                local: local, configured: true, draft: draft, serverHost: scopeHost\n357|            )\n358|            try Self.verifyConfiguredGroup(\n359|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n360|            )\n361|            return verified\n362|        }\n363|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n364|           hasCompleted(Self.stepConfigured, directory: directory) {\n365|            let local = readLocalRegistration(directory: directory)\n366|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n367|                local: local, configured: true, draft: draft, serverHost: scopeHost\n368|            )\n369|            try Self.verifyConfiguredGroup(\n370|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n371|            )\n372|            return verified\n373|        }\n374|        let spec = RunnerRegistration.ConfigSpec(\n375|            scopeURL: scopeURL, token: token, name: draft.runnerName,\n376|            workFolder: draft.workFolder, labels: draft.labels,\n377|            runnerGroup: runnerGroup, replace: replace\n378|        )\n379|        let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n380|        let executable = directory.appendingPathComponent(\"config.sh\").path\n381|        guard files.fileExists(atPath: executable) else {\n382|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n383|        }\n384|        let result = try await executor.run(executable, args)\n385|        guard result.code == 0 else {\n386|            // Never echo the token: config output may repeat arguments.\n387|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [token])\n388|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n389|        }\n390|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n391|            throw RunnerRegistration.RegistrationError.configFailed(\n392|                \"config.sh reported success but .runner is missing.\"\n393|            )\n394|        }\n395|        try markCompleted(\n396|            Self.stepConfigured, directory: directory, scopeKey: draft.scope.scopeKey,\n397|            serverHost: scopeHost, groupName: runnerGroup\n398|        )\n399|        return readAgentID(directory: directory)\n400|    }\n401|\n402|    /// `.runner` does not record the org group, so the configured marker\n403|    /// does. A resume whose marker names another group (or predates group\n404|    /// recording) refuses instead of claiming the old group's configuration\n405|    /// as the new draft's. Repository scope never configures a group.\n406|    static func verifyConfiguredGroup(\n407|        marker: Marker?, runnerGroup: String?, draft: RunnerRegistration.Draft\n408|    ) throws {\n409|        switch draft.scope {\n410|        case .repository:\n411|            return\n412|        case .organization:\n413|            break\n414|        }\n415|        let wanted = (runnerGroup ?? draft.groupName).trimmingCharacters(in: .whitespacesAndNewlines)\n416|        guard let have = marker?.groupName?.trimmingCharacters(in: .whitespacesAndNewlines),\n417|              !have.isEmpty else {\n418|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n419|                \"Directory '\\(draft.installDirName)' was configured before group recording. Reconfigure for group '\\(wanted)' instead of reusing the old configuration.\"\n420|            )\n421|        }\n422|        guard have == wanted else {\n423|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n424|                \"Local registration was configured for group '\\(have)', not '\\(wanted)'. Reconfigure instead of reusing the old group's configuration.\"\n425|            )\n426|        }\n427|    }\n428|\n429|    // MARK: - Dedicated-group ownership\n430|\n431|    public static let ownershipFileName = \".runnercontrol-groups.json\"\n432|\n433|    private func ownershipFile() -> URL {\n434|        installRoot.appendingPathComponent(Self.ownershipFileName)\n435|    }\n436|\n437|    private static func ownershipKey(serverHost: String, org: String, name: String) -> String {\n438|        \"\\(RunnerRegistration.OperationIdentity.normalizeServerHost(serverHost))\\u{0}\\(org.lowercased())\\u{0}\\(name)\"\n439|    }\n440|\n441|    /// Returns the locally recorded dedicated-group ID for\n442|    /// `server` + `org` + `name`, or nil when this Mac never created (or\n443|    /// took over) that group on that server. Name matches on GitHub alone\n444|    /// never count as ownership, and ownership on one server never\n445|    /// authorizes adoption on another.\n446|    public func loadOwnedGroupID(serverHost: String, org: String, name: String) -> Int64? {\n447|        guard let data = try? Data(contentsOf: ownershipFile()),\n448|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n449|        return table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)]\n450|    }\n451|\n452|    public func saveOwnedGroupID(serverHost: String, org: String, name: String, groupID: Int64) throws {\n453|        let file = ownershipFile()\n454|        var table: [String: Int64] = [:]\n455|        if let data = try? Data(contentsOf: file),\n456|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n457|            table = decoded\n458|        }\n459|        table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)] = groupID\n460|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n461|        let data = try JSONEncoder().encode(table)\n462|        try data.write(to: file, options: .atomic)\n463|    }\n464|\n465|    /// Reads the local `.runner` identity without touching credentials.\n466|    /// Returns nil only when the file is missing or unparseable; a present\n467|    /// but incomplete file returns a partial struct so verification can name\n468|    /// the exact missing field instead of crashing.\n469|    public func readLocalRegistration(directory: URL) -> RunnerRegistration.LocalRegistration? {\n470|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n471|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n472|        var agentID: Int64?\n473|        if let id = object[\"agentId\"] as? Int64 { agentID = id }\n474|        else if let id = object[\"agentId\"] as? Int { agentID = Int64(id) }\n475|        else if let id = object[\"agentId\"] as? NSNumber { agentID = id.int64Value }\n476|        return RunnerRegistration.LocalRegistration(\n477|            agentID: agentID,\n478|            agentName: object[\"agentName\"] as? String,\n479|            gitHubURL: object[\"gitHubUrl\"] as? String,\n480|            workFolder: object[\"workFolder\"] as? String\n481|        )\n482|    }\n483|\n484|    /// Reads the local agent ID from `.runner` without touching credentials.\n485|    public func readAgentID(directory: URL) -> Int64? {\n486|        readLocalRegistration(directory: directory)?.agentID\n487|    }\n488|\n489|    // MARK: - Manual LaunchAgent\n490|\n491|    /// Writes the manual service plist (RunAtLoad off for new runners) and\n492|    /// validates it matches the directory. Never bootstraps the service:\n493|    /// enabling is the user's separate action.\n494|    @discardableResult\n495|    public func setupService(directory: URL, label: String) throws -> URL {\n496|        guard !directory.path.contains(\" \") else {\n497|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n498|        }\n499|        // Never rewrite the service while a live install/config owns the\n500|        // directory; the caller retries after that operation settles.\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c51f","stream":{"kind":"session","id":"01a0a91f-5a05-7370-bf74-ffa98261cad4"},"sequence":234,"recorded_at":1780531400000463,"record_type":"event","durability":"durable","causation_id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb","run_stream":{"kind":"run","id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb"},"task_stream":{"kind":"task","id":"01a0a91f-eed8-70e3-ad6e-0887b2473a15"},"task_id":"01a0a91f-eed8-70e3-ad6e-0887b2473a15","event":{"kind":"completed","task_id":"01a0a91f-eed8-70e3-ad6e-0887b2473a15"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c521","stream":{"kind":"session","id":"01a0a91f-5a05-7370-bf74-ffa98261cad4"},"sequence":235,"recorded_at":1780531400000465,"record_type":"event","durability":"durable","causation_id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb","run_stream":{"kind":"run","id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb"},"call_id":"call_01a0a91feadf736abe57af79c2a65b03","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n1|import CryptoKit\n2|import Foundation\n3|\n4|/// Filesystem installer for downloaded GitHub Actions runners.\n5|///\n6|/// Production path: download bytes → SHA-256 verify → tar extract →\n7|/// `bin/runsvc.sh` copied into the root and chmodded (as official `svc.sh`\n8|/// would) → exact `config.sh` invocation → manual LaunchAgent plist.\n9|/// All side effects stay below `installRoot`; tests inject a temporary root,\n10|/// a fake downloader, and fixtures instead of touching production runners.\n11|public actor RunnerInstallerService {\n12|    public static let markerFileName = \".runnercontrol-install.json\"\n13|    public static let installOS = \"osx\"\n14|\n15|    private let installRoot: URL\n16|    private let downloader: @Sendable (URL) async throws -> Data\n17|    private let executor: any CommandExecuting\n18|    private let currentArch: @Sendable () -> String\n19|    private let hasher: @Sendable (Data) -> String\n20|\n21|    public init(\n22|        installRoot: URL? = nil,\n23|        downloader: (@Sendable (URL) async throws -> Data)? = nil,\n24|        executor: (any CommandExecuting)? = nil,\n25|        currentArch: (@Sendable () -> String)? = nil,\n26|        hasher: (@Sendable (Data) -> String)? = nil\n27|    ) {\n28|        self.installRoot = installRoot\n29|            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/GitHubActions\")\n30|        self.downloader = downloader ?? { url in\n31|            let (data, _) = try await URLSession.shared.data(from: url)\n32|            return data\n33|        }\n34|        self.executor = executor ?? CommandExecutor()\n35|        self.currentArch = currentArch ?? {\n36|            #if arch(arm64)\n37|            return \"arm64\"\n38|            #else\n39|            return \"x64\"\n40|            #endif\n41|        }\n42|        self.hasher = hasher ?? { data in\n43|            SHA256.hash(data: data).map { String(format: \"%02x\", $0) }.joined()\n44|        }\n45|    }\n46|\n47|    public nonisolated var root: URL { installRoot }\n48|    public nonisolated var architecture: String { currentArch() }\n49|\n50|    /// Canonical installation directories with a live mutating side effect\n51|    /// (download/extract/config/service/recovery). Acquired synchronously\n52|    /// before the first await and released only when the owning operation\n53|    /// settles, so actor reentrancy can never admit two mutations of one\n54|    /// directory. Abandoning a UI generation does not release this resource;\n55|    /// only the settling side effect does.\n56|    private var activeDirectories: Set<String> = []\n57|\n58|    public func directory(for installDirName: String) -> URL {\n59|        installRoot.appendingPathComponent(installDirName)\n60|    }\n61|\n62|    /// Canonical lease key for a directory: physical filesystem identity, not\n63|    /// path spelling. Both Flow-derived URLs (from a stored install path)\n64|    /// and `directory(for:)` URLs map to the same key for the same on-disk\n65|    /// location, including through symlink leaves and symlink ancestors.\n66|    /// Not-yet-created leaves canonicalize via their nearest existing\n67|    /// ancestor, so `/tmp`-vs-`/private/tmp` spellings of one directory map\n68|    /// to one key before the leaf exists.\n69|    nonisolated static func leaseKey(for directory: URL) -> String {\n70|        let standardized = URL(fileURLWithPath: directory.path).standardizedFileURL\n71|        let files = FileManager.default\n72|        var base = standardized\n73|        var suffix: [String] = []\n74|        while true {\n75|            if files.fileExists(atPath: base.path) || Self.isSymlink(atPath: base.path) {\n76|                break\n77|            }\n78|            let parent = base.deletingLastPathComponent()\n79|            if parent.path == base.path { break }\n80|            suffix.insert(base.lastPathComponent, at: 0)\n81|            base = parent\n82|        }\n83|        let resolvedBase = base.resolvingSymlinksInPath().path\n84|        if suffix.isEmpty {\n85|            return URL(fileURLWithPath: resolvedBase).standardizedFileURL.path\n86|        }\n87|        var url = URL(fileURLWithPath: resolvedBase, isDirectory: true)\n88|        for component in suffix { url.appendPathComponent(component) }\n89|        return url.standardizedFileURL.path\n90|    }\n91|\n92|    private nonisolated static func isSymlink(atPath path: String) -> Bool {\n93|        (try? FileManager.default.destinationOfSymbolicLink(atPath: path)) != nil\n94|    }\n95|\n96|    /// Refuses Finder-alias installation paths before any side effect. A\n97|    /// Finder alias is not a transparent directory like a symlink: operating\n98|    /// through its spelling would not operate on the target, so alias\n99|    /// spellings are rejected instead of being canonicalized. Symlinks are\n100|    /// resolved by `leaseKey`, not refused here — and must be excluded\n101|    /// explicitly because `isAliasFileKey` is also true for symlinks such as\n102|    /// the system `/var` and `/tmp` links every temporary path resolves\n103|    /// through.\n104|    nonisolated static func ensureNoAlias(at directory: URL) throws {\n105|        var current = URL(fileURLWithPath: directory.path).standardizedFileURL\n106|        while true {\n107|            if FileManager.default.fileExists(atPath: current.path),\n108|               !isSymlink(atPath: current.path),\n109|               (try? current.resourceValues(forKeys: [.isAliasFileKey]))?.isAliasFile == true {\n110|                throw RunnerRegistration.RegistrationError.invalidDraft(\n111|                    \"Installation path '\\(directory.path)' resolves through a Finder alias at '\\(current.path)'. Choose a direct folder path instead of an alias.\"\n112|                )\n113|            }\n114|            let parent = current.deletingLastPathComponent()\n115|            if parent.path == current.path { break }\n116|            current = parent\n117|        }\n118|    }\n119|\n120|    /// Acquires exclusive ownership of `directory`. Synchronous: callers must\n121|    /// invoke it before their first await so the check-and-insert is atomic\n122|    /// under actor isolation. Throws a retryable `directoryBusy` when another\n123|    /// live operation already owns the directory; different physical\n124|    /// directories never conflict. Returns the originally acquired canonical\n125|    /// key; the caller must hold it across awaits and release that exact key.\n126|    private func acquireLease(for directory: URL) throws -> String {\n127|        try Self.ensureNoAlias(at: directory)\n128|        let key = Self.leaseKey(for: directory)\n129|        guard !activeDirectories.contains(key) else {\n130|            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n131|        }\n132|        activeDirectories.insert(key)\n133|        return key\n134|    }\n135|\n136|    private func releaseLease(_ key: String) {\n137|        activeDirectories.remove(key)\n138|    }\n139|\n140|    /// Refuses a synchronous mutation (service setup, recovery) while a live\n141|    /// async side effect owns the directory. No insert: without an await the\n142|    /// caller itself cannot interleave, it only needs to respect leases held\n143|    /// by others. Uses the same canonical identity as acquisition.\n144|    private func requireIdleDirectory(_ directory: URL) throws {\n145|        try Self.ensureNoAlias(at: directory)\n146|        guard !activeDirectories.contains(Self.leaseKey(for: directory)) else {\n147|            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n148|        }\n149|    }\n150|\n151|    // MARK: - Idempotency markers\n152|\n153|    public struct Marker: Codable, Sendable, Equatable {\n154|        public var scopeKey: String\n155|        public var completedSteps: Set<String>\n156|        /// Server the directory was configured against (`.runner` host is\n157|        /// authoritative; this records the config-time expectation so a\n158|        /// group/server change cannot reuse an old configured marker).\n159|        public var serverHost: String?\n160|        /// Dedicated group passed to `config.sh --runnergroup` (org scope).\n161|        /// `.runner` does not record it, so the marker must: a group-name\n162|        /// edit never claims the old group's configuration as its own.\n163|        public var groupName: String?\n164|        public init(\n165|            scopeKey: String, completedSteps: Set<String> = [],\n166|            serverHost: String? = nil, groupName: String? = nil\n167|        ) {\n168|            self.scopeKey = scopeKey; self.completedSteps = completedSteps\n169|            self.serverHost = serverHost; self.groupName = groupName\n170|        }\n171|    }\n172|\n173|    public static let stepDownloaded = \"downloaded\"\n174|    public static let stepInstalled = \"installed\"\n175|    public static let stepConfigured = \"configured\"\n176|    public static let stepServiceReady = \"serviceReady\"\n177|\n178|    public func loadMarker(directory: URL) -> Marker? {\n179|        let url = directory.appendingPathComponent(Self.markerFileName)\n180|        guard let data = try? Data(contentsOf: url) else { return nil }\n181|        return try? JSONDecoder().decode(Marker.self, from: data)\n182|    }\n183|\n184|    private func storeMarker(_ marker: Marker, directory: URL) throws {\n185|        let data = try JSONEncoder().encode(marker)\n186|        try data.write(to: directory.appendingPathComponent(Self.markerFileName), options: .atomic)\n187|    }\n188|\n189|    public func markCompleted(\n190|        _ step: String, directory: URL, scopeKey: String,\n191|        serverHost: String? = nil, groupName: String? = nil\n192|    ) throws {\n193|        var marker = loadMarker(directory: directory) ?? Marker(scopeKey: scopeKey)\n194|        marker.completedSteps.insert(step)\n195|        if let serverHost { marker.serverHost = serverHost }\n196|        if let groupName { marker.groupName = groupName }\n197|        try storeMarker(marker, directory: directory)\n198|    }\n199|\n200|    public func hasCompleted(_ step: String, directory: URL) -> Bool {\n201|        loadMarker(directory: directory)?.completedSteps.contains(step) == true\n202|    }\n203|\n204|    // MARK: - Install\n205|\n206|    /// Downloads, verifies, and extracts the official package. Idempotent:\n207|    /// a completed `installed` marker with matching scope and server skips\n208|    /// the work. Refuses to overwrite an already-registered directory (no\n209|    /// duplicates).\n210|    public func downloadAndInstall(\n211|        asset: RunnerRegistration.DownloadAsset,\n212|        draft: RunnerRegistration.Draft,\n213|        serverHost: String? = nil\n214|    ) async throws -> URL {\n215|        try RunnerRegistration.Gates.validateNoSpace(\n216|            installDirName: draft.installDirName, workFolder: draft.workFolder\n217|        )\n218|        let directory = self.directory(for: draft.installDirName)\n219|        if directory.path.contains(\" \") {\n220|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n221|        }\n222|        // Exclusive ownership for the whole mutation, acquired before the\n223|        // first await (reuse check included): a same-directory retry while\n224|        // this install is live is refused retryably instead of starting a\n225|        // second download/extract over the same directory. The originally\n226|        // acquired canonical key is held across awaits and released exactly.\n227|        let lease = try acquireLease(for: directory)\n228|        defer { releaseLease(lease) }\n229|        let files = FileManager.default\n230|        if let marker = loadMarker(directory: directory),\n231|           marker.completedSteps.contains(Self.stepInstalled),\n232|           marker.scopeKey == draft.scope.scopeKey,\n233|           Self.markerServerMatches(marker: marker, serverHost: serverHost),\n234|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n235|            return directory\n236|        }\n237|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n238|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: draft.runnerName)\n239|        }\n240|        let bytes: Data\n241|        do {\n242|            bytes = try await downloader(asset.downloadURL)\n243|        } catch {\n244|            throw RunnerRegistration.RegistrationError.network(\"Runner download failed: \\(error.localizedDescription)\")\n245|        }\n246|        // Fail closed: the official downloads endpoint documents\n247|        // `sha256_checksum`, and an install without a verified digest is\n248|        // refused rather than trusted on TLS alone.\n249|        guard let expected = asset.sha256Checksum, !expected.isEmpty else {\n250|            throw RunnerRegistration.RegistrationError.integrityMismatch\n251|        }\n252|        let actual = hasher(bytes)\n253|        guard actual.lowercased() == expected.lowercased() else {\n254|            throw RunnerRegistration.RegistrationError.integrityMismatch\n255|        }\n256|        try files.createDirectory(at: directory, withIntermediateDirectories: true)\n257|        let archive = files.temporaryDirectory.appendingPathComponent(UUID().uuidString + \"-\" + asset.filename)\n258|        defer { try? files.removeItem(at: archive) }\n259|        try bytes.write(to: archive, options: .atomic)\n260|        let result = try await executor.run(\"/usr/bin/tar\", [\"-xzf\", archive.path, \"-C\", directory.path])\n261|        guard result.code == 0 else {\n262|            throw RunnerRegistration.RegistrationError.network(\n263|                \"Runner archive extraction failed: \\(String(result.output.prefix(300)))\"\n264|            )\n265|        }\n266|        // Official packages keep runsvc.sh under bin/ until svc.sh installs it;\n267|        // a bare extraction leaves the root copy absent, so install it here.\n268|        try installRunsvc(directory: directory)\n269|        try markCompleted(\n270|            Self.stepDownloaded, directory: directory,\n271|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n272|        )\n273|        try markCompleted(\n274|            Self.stepInstalled, directory: directory,\n275|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n276|        )\n277|        return directory\n278|    }\n279|\n280|    /// Server binding for install reuse. A marker written without a server\n281|    /// (pre-revision-4) never satisfies a server-bound request: the next\n282|    /// install re-verifies instead of reusing unknown provenance. Direct\n283|    /// installer calls without a server (unit fixtures) keep the legacy\n284|    /// scope-only reuse.\n285|    static func markerServerMatches(marker: Marker, serverHost: String?) -> Bool {\n286|        guard let want = serverHost else { return true }\n287|        guard let have = marker.serverHost else { return false }\n288|        return RunnerRegistration.OperationIdentity.normalizeServerHost(have)\n289|            == RunnerRegistration.OperationIdentity.normalizeServerHost(want)\n290|    }\n291|\n292|    /// Copies official `bin/runsvc.sh` into the installation root and makes\n293|    /// it executable, mirroring what official `svc.sh install` would do.\n294|    public func installRunsvc(directory: URL) throws {\n295|        let files = FileManager.default\n296|        let source = directory.appendingPathComponent(\"bin/runsvc.sh\")\n297|        let target = directory.appendingPathComponent(\"runsvc.sh\")\n298|        guard files.fileExists(atPath: source.path) else {\n299|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing bin/runsvc.sh.\")\n300|        }\n301|        if files.fileExists(atPath: target.path) {\n302|            try files.removeItem(at: target)\n303|        }\n304|        try files.copyItem(at: source, to: target)\n305|        try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: target.path)\n306|    }\n307|\n308|    // MARK: - Configure\n309|\n310|    /// Runs the exact `config.sh` invocation. Skips when a previous attempt\n311|    /// already registered this directory (marker + `.runner` present), so\n312|    /// retries never create orphan or duplicate GitHub registrations.\n313|    /// Returns the local agent ID read back from `.runner`.\n314|    @discardableResult\n315|    public func runConfig(\n316|        directory: URL,\n317|        scopeURL: String,\n318|        token: String,\n319|        draft: RunnerRegistration.Draft,\n320|        runnerGroup: String?\n321|    ) async throws -> Int64? {\n322|        try await runConfig(\n323|            directory: directory, scopeURL: scopeURL, token: token,\n324|            draft: draft, runnerGroup: runnerGroup, replace: draft.allowReplace\n325|        )\n326|    }\n327|\n328|    /// Explicit-`replace` variant. Production callers pass\n329|    /// `draft.allowReplace`; tests drive both values.\n330|    @discardableResult\n331|    public func runConfig(\n332|        directory: URL,\n333|        scopeURL: String,\n334|        token: String,\n335|        draft: RunnerRegistration.Draft,\n336|        runnerGroup: String?,\n337|        replace: Bool\n338|    ) async throws -> Int64? {\n339|        let files = FileManager.default\n340|        let scopeHost = URL(string: scopeURL)?.host ?? \"\"\n341|        // Exclusive ownership for the whole config, acquired before the\n342|        // first await (resume checks included): a same-directory retry while\n343|        // this config.sh is live is refused retryably instead of invoking a\n344|        // second config.sh over the same .runner. The lease is released only\n345|        // when this operation settles; an abandoned UI generation never\n346|        // releases it. The originally acquired canonical key is held across\n347|        // awaits and released exactly.\n348|        let lease = try acquireLease(for: directory)\n349|        defer { releaseLease(lease) }\n350|        if hasCompleted(Self.stepConfigured, directory: directory),\n351|           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n352|            // Idempotent resume never returns a stale ID: the existing\n353|            // configuration must still match this draft on this server.\n354|            let local = readLocalRegistration(directory: directory)\n355|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n356|                local: local, configured: true, draft: draft, serverHost: scopeHost\n357|            )\n358|            try Self.verifyConfiguredGroup(\n359|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n360|            )\n361|            return verified\n362|        }\n363|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n364|           hasCompleted(Self.stepConfigured, directory: directory) {\n365|            let local = readLocalRegistration(directory: directory)\n366|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n367|                local: local, configured: true, draft: draft, serverHost: scopeHost\n368|            )\n369|            try Self.verifyConfiguredGroup(\n370|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n371|            )\n372|            return verified\n373|        }\n374|        let spec = RunnerRegistration.ConfigSpec(\n375|            scopeURL: scopeURL, token: token, name: draft.runnerName,\n376|            workFolder: draft.workFolder, labels: draft.labels,\n377|            runnerGroup: runnerGroup, replace: replace\n378|        )\n379|        let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n380|        let executable = directory.appendingPathComponent(\"config.sh\").path\n381|        guard files.fileExists(atPath: executable) else {\n382|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n383|        }\n384|        let result = try await executor.run(executable, args)\n385|        guard result.code == 0 else {\n386|            // Never echo the token: config output may repeat arguments.\n387|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [token])\n388|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n389|        }\n390|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n391|            throw RunnerRegistration.RegistrationError.configFailed(\n392|                \"config.sh reported success but .runner is missing.\"\n393|            )\n394|        }\n395|        try markCompleted(\n396|            Self.stepConfigured, directory: directory, scopeKey: draft.scope.scopeKey,\n397|            serverHost: scopeHost, groupName: runnerGroup\n398|        )\n399|        return readAgentID(directory: directory)\n400|    }\n401|\n402|    /// `.runner` does not record the org group, so the configured marker\n403|    /// does. A resume whose marker names another group (or predates group\n404|    /// recording) refuses instead of claiming the old group's configuration\n405|    /// as the new draft's. Repository scope never configures a group.\n406|    static func verifyConfiguredGroup(\n407|        marker: Marker?, runnerGroup: String?, draft: RunnerRegistration.Draft\n408|    ) throws {\n409|        switch draft.scope {\n410|        case .repository:\n411|            return\n412|        case .organization:\n413|            break\n414|        }\n415|        let wanted = (runnerGroup ?? draft.groupName).trimmingCharacters(in: .whitespacesAndNewlines)\n416|        guard let have = marker?.groupName?.trimmingCharacters(in: .whitespacesAndNewlines),\n417|              !have.isEmpty else {\n418|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n419|                \"Directory '\\(draft.installDirName)' was configured before group recording. Reconfigure for group '\\(wanted)' instead of reusing the old configuration.\"\n420|            )\n421|        }\n422|        guard have == wanted else {\n423|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n424|                \"Local registration was configured for group '\\(have)', not '\\(wanted)'. Reconfigure instead of reusing the old group's configuration.\"\n425|            )\n426|        }\n427|    }\n428|\n429|    // MARK: - Dedicated-group ownership\n430|\n431|    public static let ownershipFileName = \".runnercontrol-groups.json\"\n432|\n433|    private func ownershipFile() -> URL {\n434|        installRoot.appendingPathComponent(Self.ownershipFileName)\n435|    }\n436|\n437|    private static func ownershipKey(serverHost: String, org: String, name: String) -> String {\n438|        \"\\(RunnerRegistration.OperationIdentity.normalizeServerHost(serverHost))\\u{0}\\(org.lowercased())\\u{0}\\(name)\"\n439|    }\n440|\n441|    /// Returns the locally recorded dedicated-group ID for\n442|    /// `server` + `org` + `name`, or nil when this Mac never created (or\n443|    /// took over) that group on that server. Name matches on GitHub alone\n444|    /// never count as ownership, and ownership on one server never\n445|    /// authorizes adoption on another.\n446|    public func loadOwnedGroupID(serverHost: String, org: String, name: String) -> Int64? {\n447|        guard let data = try? Data(contentsOf: ownershipFile()),\n448|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n449|        return table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)]\n450|    }\n451|\n452|    public func saveOwnedGroupID(serverHost: String, org: String, name: String, groupID: Int64) throws {\n453|        let file = ownershipFile()\n454|        var table: [String: Int64] = [:]\n455|        if let data = try? Data(contentsOf: file),\n456|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n457|            table = decoded\n458|        }\n459|        table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)] = groupID\n460|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n461|        let data = try JSONEncoder().encode(table)\n462|        try data.write(to: file, options: .atomic)\n463|    }\n464|\n465|    /// Reads the local `.runner` identity without touching credentials.\n466|    /// Returns nil only when the file is missing or unparseable; a present\n467|    /// but incomplete file returns a partial struct so verification can name\n468|    /// the exact missing field instead of crashing.\n469|    public func readLocalRegistration(directory: URL) -> RunnerRegistration.LocalRegistration? {\n470|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n471|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n472|        var agentID: Int64?\n473|        if let id = object[\"agentId\"] as? Int64 { agentID = id }\n474|        else if let id = object[\"agentId\"] as? Int { agentID = Int64(id) }\n475|        else if let id = object[\"agentId\"] as? NSNumber { agentID = id.int64Value }\n476|        return RunnerRegistration.LocalRegistration(\n477|            agentID: agentID,\n478|            agentName: object[\"agentName\"] as? String,\n479|            gitHubURL: object[\"gitHubUrl\"] as? String,\n480|            workFolder: object[\"workFolder\"] as? String\n481|        )\n482|    }\n483|\n484|    /// Reads the local agent ID from `.runner` without touching credentials.\n485|    public func readAgentID(directory: URL) -> Int64? {\n486|        readLocalRegistration(directory: directory)?.agentID\n487|    }\n488|\n489|    // MARK: - Manual LaunchAgent\n490|\n491|    /// Writes the manual service plist (RunAtLoad off for new runners) and\n492|    /// validates it matches the directory. Never bootstraps the service:\n493|    /// enabling is the user's separate action.\n494|    @discardableResult\n495|    public func setupService(directory: URL, label: String) throws -> URL {\n496|        guard !directory.path.contains(\" \") else {\n497|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n498|        }\n499|        // Never rewrite the service while a live install/config owns the\n500|        // directory; the caller retries after that operation settles.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
