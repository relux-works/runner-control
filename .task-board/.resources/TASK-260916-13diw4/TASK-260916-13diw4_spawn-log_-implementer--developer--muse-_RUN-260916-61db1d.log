{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca8d","stream":{"kind":"session","id":"01a0a91f-5a05-7370-bf74-ffa98261cad4"},"sequence":929,"recorded_at":1780531400001853,"record_type":"event","durability":"durable","causation_id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb","run_stream":{"kind":"run","id":"d48d36b9-6599-476a-89c2-ba7d2fcc06eb"},"task_stream":{"kind":"task","id":"01a0a925-5bf3-7fb1-be70-697e3531e1de"},"task_id":"01a0a925-5bf3-7fb1-be70-697e3531e1de","event":{"kind":"output","task_id":"01a0a925-5bf3-7fb1-be70-697e3531e1de","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n(479 line(s) above)\n480|    private func downloadAndInstall() async {\n481|        let gen = generation\n482|        guard workingOwner == nil else { return }\n483|        guard let draft else {\n484|            await action {\n485|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"downloadAndInstall\")\n486|            }\n487|            return\n488|        }\n489|        workingOwner = gen\n490|        workingStep = \"downloadAndInstall\"\n491|        await action { RunnerRegistration.Action.stepStarted(\"downloadAndInstall\") }\n492|        do {\n493|            // Bind to the authenticated server before touching the cache: a\n494|            // session change drops the old server's asset instead of reusing\n495|            // it. The same auth serves the whole step; no mid-step reload\n496|            // may mix servers.\n497|            let auth = try await currentUserToken(generation: gen)\n498|            guard !isStale(gen) else { return }\n499|            _ = syncServerBinding(auth.identity.serverHost)\n500|            guard !isStale(gen) else { return }\n501|            let serverHost = auth.identity.serverHost\n502|            let resolved: RunnerRegistration.DownloadAsset\n503|            if let asset {\n504|                resolved = asset\n505|            } else {\n506|                resolved = try await prepareDownloadInner(draft: draft, auth: auth, generation: gen)\n507|                guard !isStale(gen) else { return }\n508|                asset = resolved\n509|                await action { RunnerRegistration.Action.downloadReady(resolved) }\n510|            }\n511|            guard !isStale(gen) else { return }\n512|            let directory = try await installer.downloadAndInstall(\n513|                asset: resolved, draft: draft, serverHost: serverHost\n514|            )\n515|            guard !isStale(gen) else { return }\n516|            installPath = directory.path\n517|            await action { RunnerRegistration.Action.installed(path: directory.path) }\n518|            await finishStep(\"downloadAndInstall\", generation: gen)\n519|        } catch {\n520|            await fail(error, step: \"downloadAndInstall\", generation: gen)\n521|        }\n522|    }\n523|\n524|    // MARK: - Register\n525|\n526|    private func registerRunner() async {\n527|        let gen = generation\n528|        guard workingOwner == nil else { return }\n529|        guard let draft else {\n530|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"registerRunner\") }\n531|            return\n532|        }\n533|        guard let installPath else {\n534|            failedStep = \"registerRunner\"\n535|            await action {\n536|                RunnerRegistration.Action.failed(message: \"Install the runner package first.\", step: \"registerRunner\")\n537|            }\n538|            return\n539|        }\n540|        workingOwner = gen\n541|        workingStep = \"registerRunner\"\n542|        await action { RunnerRegistration.Action.stepStarted(\"registerRunner\") }\n543|        let directory = URL(fileURLWithPath: installPath)\n544|        let scopeKey = Self.tokenScopeKey(draft: draft)\n545|        do {\n546|            // The whole step — including idempotent resume — is bound to one\n547|            // authenticated server. Resume verifies the full local identity\n548|            // (server/scope/agent/name/work-folder/group) before any success:\n549|            // a drifted or re-targeted draft never adopts the old marker.\n550|            let auth = try await currentUserToken(generation: gen)\n551|            guard !isStale(gen) else { return }\n552|            _ = syncServerBinding(auth.identity.serverHost)\n553|            guard !isStale(gen) else { return }\n554|            let serverHost = auth.identity.serverHost\n555|            if await installer.hasCompleted(RunnerInstallerService.stepConfigured, directory: directory) {\n556|                let local = await installer.readLocalRegistration(directory: directory)\n557|                let localID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n558|                    local: local, configured: true, draft: draft, serverHost: serverHost\n559|                )\n(more lines below)","final_result":true}}}
