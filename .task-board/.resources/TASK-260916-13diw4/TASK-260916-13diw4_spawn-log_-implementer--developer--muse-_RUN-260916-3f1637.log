{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ab","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":304,"recorded_at":1780531400000603,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"task_stream":{"kind":"task","id":"01a0a87c-3418-77f1-a6ce-44b97227a8b0"},"task_id":"01a0a87c-3418-77f1-a6ce-44b97227a8b0","event":{"kind":"output","task_id":"01a0a87c-3418-77f1-a6ce-44b97227a8b0","chunk":"Read text file `Targets/RunnerControl/Sources/RunnerRegistrationContainer.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|/// Wizard composition root. Edits local draft fields, dispatches production\n5|/// `RunnerRegistration.Effect`s, and never holds tokens.\n6|struct RunnerRegistrationContainer: View {\n7|    @ObservedObject var registration: RunnerRegistration.State\n8|    @ObservedObject var github: GitHubAuth.State\n9|    let close: () -> Void\n10|\n11|    @State private var scopeKind: RunnerRegistrationPage.ScopeKind = .organization\n12|    @State private var org = \"\"\n13|    @State private var repoOwner = \"\"\n14|    @State private var repoName = \"\"\n15|    @State private var runnerName = Host.current().localizedName ?? \"\"\n16|    @State private var labelsText = \"self-hosted, macOS\"\n17|    @State private var installDirName = \"\"\n18|    @State private var workFolder = \"_work\"\n19|    @State private var groupName = RunnerRegistration.Draft.defaultGroupName(\n20|        hostName: Host.current().localizedName ?? \"\"\n21|    )\n22|    @State private var allowGroupMutation = false\n23|    @State private var selectedRepositoryIDs: Set<Int64> = []\n24|    @State private var seeded = false\n25|\n26|    private static func parseLabels(_ text: String) -> [String] {\n27|        text.split(separator: \",\").map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }\n28|    }\n29|\n30|    private var currentDraft: RunnerRegistration.Draft {\n31|        let scope: RunnerRegistration.Scope\n32|        switch scopeKind {\n33|        case .organization:\n34|            scope = .organization(org: org.trimmingCharacters(in: .whitespacesAndNewlines))\n35|        case .repository:\n36|            scope = .repository(\n37|                owner: repoOwner.trimmingCharacters(in: .whitespacesAndNewlines),\n38|                name: repoName.trimmingCharacters(in: .whitespacesAndNewlines)\n39|            )\n40|        }\n41|        return RunnerRegistration.Draft(\n42|            scope: scope,\n43|            runnerName: runnerName.trimmingCharacters(in: .whitespacesAndNewlines),\n44|            labels: Self.parseLabels(labelsText),\n45|            installDirName: installDirName.trimmingCharacters(in: .whitespacesAndNewlines),\n46|            workFolder: workFolder.trimmingCharacters(in: .whitespacesAndNewlines),\n47|            groupName: groupName.trimmingCharacters(in: .whitespacesAndNewlines),\n48|            selectedRepositoryIDs: selectedRepositoryIDs,\n49|            allowGroupMutation: allowGroupMutation\n50|        )\n51|    }\n52|\n53|    var body: some View {\n54|        RunnerRegistrationPage(\n55|            props: .init(\n56|                phase: registration.phase,\n57|                working: registration.working,\n58|                scopeKind: scopeKind,\n59|                org: org,\n60|                repoOwner: repoOwner,\n61|                repoName: repoName,\n62|                runnerName: runnerName,\n63|                labelsText: labelsText,\n64|                installDirName: installDirName,\n65|                workFolder: workFolder,\n66|                groupName: groupName,\n67|                allowGroupMutation: allowGroupMutation,\n68|                selectedRepositoryIDs: selectedRepositoryIDs,\n69|                repositories: github.repositories,\n70|                installations: github.installations,\n71|                githubConnected: isConnected,\n72|                githubUsername: github.username,\n73|                group: registration.group,\n74|                groupRepositoryIDs: registration.groupRepositoryIDs,\n75|                assetFilename: registration.asset?.filename,\n76|                installPath: registration.installPath,\n77|                runnerID: registration.runnerID,\n78|                localAgentID: registration.localAgentID,\n79|                completedSteps: registration.completedSteps,\n80|                error: registration.error,\n81|                failedStep: registration.failedStep,\n82|                permissionError: registration.permissionError\n83|            ),\n84|            reactions: .init(\n85|                scopeKindChanged: { scopeKind = $0; pushDraft() },\n86|                orgChanged: { org = $0; pushDraft() },\n87|                repoOwnerChanged: { repoOwner = $0; pushDraft() },\n88|                repoNameChanged: { repoName = $0; pushDraft() },\n89|                runnerNameChanged: { runnerName = $0; pushDraft() },\n90|                labelsChanged: { labelsText = $0; pushDraft() },\n91|                installDirChanged: { installDirName = $0; pushDraft() },\n92|                workFolderChanged: { workFolder = $0; pushDraft() },\n93|                groupNameChanged: { groupName = $0; pushDraft() },\n94|                allowGroupMutationChanged: { allowGroupMutation = $0; pushDraft() },\n95|                repositoriesChanged: { ids in\n96|                    selectedRepositoryIDs = ids\n97|                    Task { await action { GitHubAuth.Effect.selectRepositories(ids) } }\n98|                    pushDraft()\n99|                },\n100|                beginDraft: { Task { await action { RunnerRegistration.Effect.beginDraft(currentDraft) } } },\n101|                resolveGroup: { Task { await action { RunnerRegistration.Effect.resolveGroup } } },\n102|                downloadAndInstall: { Task { await action { RunnerRegistration.Effect.downloadAndInstall } } },\n103|                registerRunner: { Task { await action { RunnerRegistration.Effect.registerRunner } } },\n104|                setupService: { Task { await action { RunnerRegistration.Effect.setupService } } },\n105|                applyRepositoryAccess: {\n106|                    let target = registration.group?.id ?? -1\n107|                    let effect = RunnerRegistration.Effect.applyRepositoryAccess(\n108|                        groupID: target, repositories: selectedRepositoryIDs\n109|                    )\n110|                    Task { await action { effect } }\n111|                },\n112|                applyLabels: {\n113|                    let labels = Self.parseLabels(labelsText)\n114|                    Task { await action { RunnerRegistration.Effect.applyLabels(labels) } }\n115|                },\n116|                retry: { Task { await action { RunnerRegistration.Effect.retry } } },\n117|                cancel: { Task { await action { RunnerRegistration.Effect.cancel } } },\n118|                reset: { Task { await action { RunnerRegistration.Effect.reset } } },\n119|                dismissPermission: { Task { await action { RunnerRegistration.Effect.dismissPermission } } },\n120|                close: close\n121|            )\n122|        )\n123|        .onAppear(perform: seedFromGitHub)\n124|    }\n125|\n126|    private var isConnected: Bool {\n127|        if case .connected = github.connection { return true }\n128|        return false\n129|    }\n130|\n131|    /// Pushes field edits into the draft once the wizard has begun, so step\n132|    /// buttons always run the visible values. Before the first begin the\n133|    /// draft does not exist yet and edits stay local.\n134|    private func pushDraft() {\n135|        guard registration.phase != .idle else { return }\n136|        let draft = currentDraft\n137|        Task { await action { RunnerRegistration.Effect.updateDraft(draft) } }\n138|    }\n139|\n140|    /// Seeds org/owner from the selected GitHub installation once.\n141|    private func seedFromGitHub() {\n142|        guard !seeded else { return }\n143|        seeded = true\n144|        if installDirName.isEmpty {\n145|            installDirName = (Host.current().localizedName ?? \"runner\")\n146|                .lowercased()\n147|                .replacingOccurrences(of: \" \", with: \"-\")\n148|        }\n149|        guard let id = github.selectedInstallationID,\n150|              let installation = github.installations.first(where: { $0.id == id }) else { return }\n151|        if org.isEmpty, installation.accountType == \"Organization\" {\n152|            org = installation.account\n153|            scopeKind = .organization\n154|        } else if repoOwner.isEmpty {\n155|            repoOwner = installation.account\n156|            scopeKind = .repository\n157|        }\n158|        if selectedRepositoryIDs.isEmpty {\n159|            selectedRepositoryIDs = github.selectedRepositoryIDs\n160|        }\n161|    }\n162|}","final_result":true}}}
