{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b7","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":310,"recorded_at":1780531400000615,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"call_id":"call_01a0a87c2c3d7550a123e270c57a5842","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n1|import CryptoKit\n2|import Foundation\n3|import Testing\n4|import Relux\n5|@testable import RunnerControlCore\n6|\n7|// MARK: - Registration harness (production entry points, controlled IO)\n8|\n9|// TestTransport, jsonResponse, and testConfig are shared from GitHubTransportTests.\n10|\n11|private struct RegistrationHarness {\n12|    let flow: RunnerRegistration.Flow\n13|    let logger: Relux.Testing.Logger\n14|    let transport: TestTransport\n15|    let userStore: GitHubKeychainStore\n16|    let registrationTokens: RunnerRegistrationTokenStore\n17|    let installer: RunnerInstallerService\n18|    let home: URL\n19|    let installRoot: URL\n20|}\n21|\n22|private func registrationHarness(\n23|    transport: TestTransport,\n24|    downloader: (@Sendable (URL) async throws -> Data)? = nil,\n25|    executor: (any CommandExecuting)? = nil,\n26|    arch: String = \"arm64\",\n27|    seedAuth: Bool = true\n28|) async -> RegistrationHarness {\n29|    let logger = Relux.Testing.Logger()\n30|    let dispatcher = Relux.Dispatcher(logger: logger)\n31|    let userStore = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n32|    let identities = InMemoryGitHubSessionIdentityStore()\n33|    if seedAuth {\n34|        await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n35|        try? await userStore.save(\n36|            GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n37|            serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n38|        )\n39|    }\n40|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"RegHome-\" + UUID().uuidString)\n41|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n42|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n43|    let archCopy = arch\n44|    let installer = RunnerInstallerService(\n45|        installRoot: installRoot,\n46|        downloader: downloader,\n47|        executor: executor,\n48|        currentArch: { archCopy }\n49|    )\n50|    let api = GitHubRunnerAPIClient(transport: transport)\n51|    let registrationTokens = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n52|    let refresher = GitHubTokenRefresh(transport: transport, store: userStore)\n53|    let flow = await RunnerRegistration.Flow(\n54|        api: api, installer: installer, registrationTokens: registrationTokens,\n55|        userStore: userStore, identityStore: identities, refresher: refresher,\n56|        configProvider: { _ in testConfig }, dispatcher: dispatcher\n57|    )\n58|    return RegistrationHarness(\n59|        flow: flow, logger: logger, transport: transport, userStore: userStore,\n60|        registrationTokens: registrationTokens, installer: installer, home: home, installRoot: installRoot\n61|    )\n62|}\n63|\n64|private func registrationActions(_ logger: Relux.Testing.Logger) -> [RunnerRegistration.Action] {\n65|    logger.actions.compactMap { $0 as? RunnerRegistration.Action }\n66|}\n67|\n68|private func lastFailure(_ logger: Relux.Testing.Logger) -> (message: String, step: String)? {\n69|    for action in registrationActions(logger).reversed() {\n70|        switch action {\n71|        case .failed(let message, let step): return (message, step)\n72|        case .permissionDenied(let message, let step): return (message, step)\n73|        default: break\n74|        }\n75|    }\n76|    return nil\n77|}\n78|\n79|private func orgDraft(\n80|    name: String = \"macbook-test\",\n81|    dir: String = \"macbook-test\",\n82|    group: String = \"RunnerControl-Mac\",\n83|    repos: Set<Int64> = [9],\n84|    allowGroup: Bool = true\n85|) -> RunnerRegistration.Draft {\n86|    RunnerRegistration.Draft(\n87|        scope: .organization(org: \"acme\"),\n88|        runnerName: name,\n89|        labels: [\"self-hosted\", \"macOS\"],\n90|        installDirName: dir,\n91|        workFolder: \"_work\",\n92|        groupName: group,\n93|        selectedRepositoryIDs: repos,\n94|        allowGroupMutation: allowGroup\n95|    )\n96|}\n97|\n98|private func repoDraft(dir: String = \"personal-app\") -> RunnerRegistration.Draft {\n99|    RunnerRegistration.Draft(\n100|        scope: .repository(owner: \"octo\", name: \"app\"),\n101|        runnerName: \"personal-runner\",\n102|        labels: [\"self-hosted\", \"macOS\"],\n103|        installDirName: dir,\n104|        workFolder: \"_work\"\n105|    )\n106|}\n107|\n108|/// The downloads endpoint returns a bare JSON array, not an object.\n109|private func downloadsArrayPayload(_ assets: [[String: Any]]) -> GitHubHTTPResponse {\n110|    // swiftlint:disable:next force_try\n111|    let data = try! JSONSerialization.data(withJSONObject: assets)\n112|    return GitHubHTTPResponse(status: 200, body: data)\n113|}\n114|\n115|// MARK: - Fixture package (real tarball, controlled filesystem)\n116|\n117|/// Builds a minimal official-shaped runner package and packs it with the\n118|/// real system tar. Scripts keep their executable bit inside the archive.\n119|private struct FixturePackage {\n120|    let bytes: Data\n121|    let sha256ViaSystem: String\n122|\n123|    static func make(withRealConfigScript: Bool = true) async throws -> FixturePackage {\n124|        let files = FileManager.default\n125|        let src = files.temporaryDirectory.appendingPathComponent(\"FixtureSrc-\" + UUID().uuidString)\n126|        let bin = src.appendingPathComponent(\"bin\")\n127|        try files.createDirectory(at: bin, withIntermediateDirectories: true)\n128|        try \"#!/bin/sh\\nexec \\\"$(dirname \\\"$0\\\")/../run.sh\\\" \\\"$@\\\"\\n\".write(to: bin.appendingPathComponent(\"runsvc.sh\"), atomically: true, encoding: .utf8)\n129|        try \"#!/bin/sh\\necho runner\\n\".write(to: src.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n130|        if withRealConfigScript {\n131|            let script = \"\"\"\n132|            #!/bin/sh\n133|            DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n134|            NAME=\"\"\n135|            while [ $# -gt 0 ]; do\n136|              case \"$1\" in\n137|                --name) NAME=\"$2\"; shift 2;;\n138|                *) shift;;\n139|              esac\n140|            done\n141|            printf '{\"agentId\":4242,\"agentName\":\"%s\",\"gitHubUrl\":\"https://github.com/acme\",\"workFolder\":\"_work\"}' \"$NAME\" > \"$DIR/.runner\"\n142|            \"\"\"\n143|            try script.write(to: src.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n144|        } else {\n145|            try \"#!/bin/sh\\nexit 0\\n\".write(to: src.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n146|        }\n147|        for path in [\"bin/runsvc.sh\", \"run.sh\", \"config.sh\"] {\n148|            try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: src.appendingPathComponent(path).path)\n149|        }\n150|        let archive = files.temporaryDirectory.appendingPathComponent(\"fixture-\" + UUID().uuidString + \".tar.gz\")\n151|        defer { try? files.removeItem(at: src) }\n152|        defer { try? files.removeItem(at: archive) }\n153|        let executor = CommandExecutor()\n154|        let packed = try await executor.run(\"/usr/bin/tar\", [\"-czf\", archive.path, \"-C\", src.path, \".\"])\n155|        guard packed.code == 0 else { throw RunnerError.message(\"fixture tar failed: \\(packed.output)\") }\n156|        let bytes = try Data(contentsOf: archive)\n157|        // Independent oracle: system shasum pins the production CryptoKit hasher.\n158|        let hashed = try await executor.run(\"/usr/bin/shasum\", [\"-a\", \"256\", archive.path])\n159|        guard hashed.code == 0 else { throw RunnerError.message(\"shasum missing: \\(hashed.output)\") }\n160|        let digest = hashed.output.split(separator: \" \").first.map(String.init) ?? \"\"\n161|        guard digest.count == 64 else { throw RunnerError.message(\"bad shasum output: \\(hashed.output)\") }\n162|        return FixturePackage(bytes: bytes, sha256ViaSystem: digest)\n163|    }\n164|}\n165|\n166|private func fixtureDownloader(_ bytes: Data) -> @Sendable (URL) async throws -> Data {\n167|    let copy = bytes\n168|    return { _ in copy }\n169|}\n170|\n171|/// Records config.sh argv and simulates a successful registration by writing\n172|/// `.runner`. Delegates every other command (tar) to the real executor.\n173|private actor SplitExecutor: CommandExecuting {\n174|    private(set) var configCalls: [[String]] = []\n175|    var failure: CommandResult?\n176|    private let real = CommandExecutor()\n177|\n178|    func run(_ executable: String, _ arguments: [String]) async throws -> CommandResult {\n179|        if executable.hasSuffix(\"config.sh\") {\n180|            configCalls.append(arguments)\n181|            if let failure { return failure }\n182|            let dir = URL(fileURLWithPath: executable).deletingLastPathComponent()\n183|            var name = \"unnamed\"\n184|            var index = arguments.startIndex\n185|            while index < arguments.endIndex {\n186|                if arguments[index] == \"--name\", arguments.index(after: index) < arguments.endIndex {\n187|                    name = arguments[arguments.index(after: index)]\n188|                }\n189|                index = arguments.index(after: index)\n190|            }\n191|            let payload = [\"agentId\": 4242, \"agentName\": name, \"gitHubUrl\": \"https://github.com/acme\", \"workFolder\": \"_work\"] as [String: Any]\n192|            let data = try JSONSerialization.data(withJSONObject: payload)\n193|            try data.write(to: dir.appendingPathComponent(\".runner\"), options: .atomic)\n194|            return CommandResult(code: 0, output: \"Configured\")\n195|        }\n196|        return try await real.run(executable, arguments)\n197|    }\n198|}\n199|\n200|// MARK: - Reducer and pure gates\n201|\n202|@Test @MainActor func registrationReducerRetainsPermissionErrorAcrossDraftEdits() async {\n203|    let state = RunnerRegistration.State()\n204|    await state.reduce(with: ForeignAction())\n205|    #expect(state.phase == .idle)\n206|    let draft = orgDraft()\n207|    await state.reduce(with: RunnerRegistration.Action.draftBegan(draft))\n208|    #expect(state.phase == .drafting)\n209|    await state.reduce(with: RunnerRegistration.Action.permissionDenied(message: \"Missing permission: X\", step: \"resolveGroup\"))\n210|    #expect(state.permissionError == \"Missing permission: X\")\n211|    // Draft edits must retain the permission error by design.\n212|    var edited = draft\n213|    edited.runnerName = \"renamed\"\n214|    await state.reduce(with: RunnerRegistration.Action.draftUpdated(edited))\n215|    #expect(state.permissionError == \"Missing permission: X\")\n216|    #expect(state.draft?.runnerName == \"renamed\")\n217|    await state.reduce(with: RunnerRegistration.Action.permissionDismissed)\n218|    #expect(state.permissionError == nil)\n219|    await state.reduce(with: RunnerRegistration.Action.registered(runnerID: 11, localAgentID: 4242))\n220|    #expect(state.runnerID == 11)\n221|    await state.cleanup()\n222|    #expect(state.phase == .idle)\n223|    #expect(state.draft == nil)\n224|}\n225|\n226|@Test func configInvocationIsExactAndOrdered() {\n227|    let orgSpec = RunnerRegistration.ConfigSpec(\n228|        scopeURL: \"https://github.com/acme\", token: \"TOKEN\",\n229|        name: \"mac1\", workFolder: \"_work\",\n230|        labels: [\"self-hosted\", \"macOS\"], runnerGroup: \"RunnerControl-Mac\"\n231|    )\n232|    let org = RunnerRegistration.ConfigInvocation.arguments(orgSpec)\n233|    #expect(org == [\n234|        \"--url\", \"https://github.com/acme\",\n235|        \"--token\", \"TOKEN\",\n236|        \"--name\", \"mac1\",\n237|        \"--work\", \"_work\",\n238|        \"--labels\", \"self-hosted,macOS\",\n239|        \"--runnergroup\", \"RunnerControl-Mac\",\n240|        \"--unattended\", \"--replace\",\n241|    ])\n242|    let repoSpec = RunnerRegistration.ConfigSpec(\n243|        scopeURL: \"https://github.com/octo/app\", token: \"TOKEN\",\n244|        name: \"r2\", workFolder: \"_work\",\n245|        labels: [\"a\"], runnerGroup: nil\n246|    )\n247|    let repo = RunnerRegistration.ConfigInvocation.arguments(repoSpec)\n248|    #expect(!repo.contains(\"--runnergroup\"))\n249|    #expect(repo == [\n250|        \"--url\", \"https://github.com/octo/app\",\n251|        \"--token\", \"TOKEN\",\n252|        \"--name\", \"r2\",\n253|        \"--work\", \"_work\",\n254|        \"--labels\", \"a\",\n255|        \"--unattended\", \"--replace\",\n256|    ])\n257|}\n258|\n259|@Test func serviceLabelCarriesDiscoveryPrefixAndSanitizes() {\n260|    let label = RunnerRegistration.Flow.serviceLabel(draft: orgDraft())\n261|    #expect(label.hasPrefix(\"actions.runner.\"))\n262|    #expect(!label.contains(\" \"))\n263|    #expect(!label.contains(\"/\"))\n264|    var spaced = orgDraft()\n265|    spaced.installDirName = \"a b/c\"\n266|    #expect(!RunnerRegistration.Flow.serviceLabel(draft: spaced).contains(\" \"))\n267|}\n268|\n269|@Test func scopeURLsAndKeysAreExact() {\n270|    #expect(RunnerRegistration.Scope.organization(org: \"acme\").apiPrefix == \"orgs/acme\")\n271|    #expect(RunnerRegistration.Scope.repository(owner: \"o\", name: \"r\").apiPrefix == \"repos/o/r\")\n272|    #expect(RunnerRegistration.Scope.organization(org: \"acme\").configURL(serverHost: \"github.com\") == \"https://github.com/acme\")\n273|    #expect(RunnerRegistration.Scope.repository(owner: \"o\", name: \"r\").configURL(serverHost: \"ghe.example.com\") == \"https://ghe.example.com/o/r\")\n274|}\n275|\n276|@Test @MainActor func registrationModuleRegistersStateAndFlow() async {\n277|    let transport = TestTransport([])\n278|    let harness = await registrationHarness(transport: transport)\n279|    let state = RunnerRegistration.State()\n280|    let module = RunnerRegistration.Module(state: state, flow: harness.flow)\n281|    #expect(module.states.count == 1)\n282|    #expect(module.sagas.count == 1)\n283|}\n284|\n285|// MARK: - Draft gates (no network before validation)\n286|\n287|@Test(arguments: [\n288|    (\"bad dir\", \"_work\"),\n289|    (\"gooddir\", \"bad work\"),\n290|]) func beginDraftRefusesSpacesBeforeAnyNetwork(dir: String, work: String) async {\n291|    let transport = TestTransport([])\n292|    let harness = await registrationHarness(transport: transport)\n293|    var draft = orgDraft()\n294|    draft.installDirName = dir\n295|    draft.workFolder = work\n296|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n297|    let failure = lastFailure(harness.logger)\n298|    #expect(failure?.step == \"beginDraft\")\n299|    #expect((failure?.message.contains(\"space\") ?? false))\n300|    #expect(await transport.requests.isEmpty)\n301|}\n302|\n303|@Test func installerRefusesSpacesWithoutDownloading() async {\n304|    actor Probe {\n305|        var count = 0\n306|        func next(_ url: URL) async throws -> Data { count += 1; return Data() }\n307|    }\n308|    let probe = Probe()\n309|    let downloader: @Sendable (URL) async throws -> Data = { url in try await probe.next(url) }\n310|    let harness = await registrationHarness(transport: TestTransport([]), downloader: downloader)\n311|    var draft = orgDraft()\n312|    draft.installDirName = \"has space\"\n313|    let asset = RunnerRegistration.DownloadAsset(\n314|        osName: \"osx\", architecture: \"arm64\",\n315|        downloadURL: URL(string: \"https://example.com/x.tar.gz\")!,\n316|        filename: \"x.tar.gz\", sha256Checksum: nil\n317|    )\n318|    do {\n319|        _ = try await harness.installer.downloadAndInstall(asset: asset, draft: draft)\n320|        Issue.record(\"installer admitted spaced path\")\n321|    } catch let error as RunnerRegistration.RegistrationError {\n322|        guard case .noSpacePath = error else { Issue.record(\"wrong error: \\(error)\"); return }\n323|    } catch {\n324|        Issue.record(\"unexpected error: \\(error)\")\n325|    }\n326|    #expect(await probe.count == 0)\n327|}\n328|\n329|@Test func beginDraftRequiresNameAndLabels() async {\n330|    let harness = await registrationHarness(transport: TestTransport([]))\n331|    var nameless = orgDraft()\n332|    nameless.runnerName = \"   \"\n333|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(nameless))\n334|    #expect(lastFailure(harness.logger)?.step == \"beginDraft\")\n335|    var labelless = orgDraft()\n336|    labelless.labels = []\n337|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(labelless))\n338|    #expect(registrationActions(harness.logger).filter {\n339|        if case .failed = $0 { true } else { false }\n340|    }.count == 2)\n341|}\n342|\n343|@Test func unauthenticatedWizardFailsClosedWithoutNetwork() async {\n344|    let transport = TestTransport([])\n345|    let harness = await registrationHarness(transport: transport, seedAuth: false)\n346|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n347|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n348|    let failure = lastFailure(harness.logger)\n349|    #expect(failure?.step == \"resolveGroup\")\n350|    #expect((failure?.message.contains(\"Sign in\") ?? false))\n351|    #expect(await transport.requests.isEmpty)\n352|}\n353|\n354|// MARK: - Download selection (architecture-matched, official only)\n355|\n356|private func downloadAssets(checksum: String) -> [[String: Any]] {\n357|    [\n358|        [\"os\": \"linux\", \"architecture\": \"x64\", \"download_url\": \"https://example.com/linux.tar.gz\", \"filename\": \"linux.tar.gz\"],\n359|        [\"os\": \"osx\", \"architecture\": \"x64\", \"download_url\": \"https://example.com/osx-x64.tar.gz\", \"filename\": \"osx-x64.tar.gz\", \"sha256_checksum\": \"x64sum\"],\n360|        [\"os\": \"osx\", \"architecture\": \"arm64\", \"download_url\": \"https://example.com/osx-arm64.tar.gz\", \"filename\": \"osx-arm64.tar.gz\", \"sha256_checksum\": checksum],\n361|    ]\n362|}\n363|\n364|@Test func prepareDownloadSelectsArchMatchedAsset() async {\n365|    let transport = TestTransport([downloadsArrayPayload(downloadAssets(checksum: \"arm64sum\"))])\n366|    let harness = await registrationHarness(transport: transport)\n367|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n368|    _ = await harness.flow.apply(RunnerRegistration.Effect.prepareDownload)\n369|    let ready = registrationActions(harness.logger).compactMap { action -> RunnerRegistration.DownloadAsset? in\n370|        if case .downloadReady(let asset) = action { asset } else { nil }\n371|    }\n372|    #expect(ready.count == 1)\n373|    #expect(ready.first?.architecture == \"arm64\")\n374|    #expect(ready.first?.osName == \"osx\")\n375|    let requests = await transport.requests\n376|    #expect(requests.count == 1)\n377|    #expect(requests.first?.url.path.hasSuffix(\"/orgs/acme/actions/runners/downloads\") ?? false)\n378|    #expect(requests.first?.headers[\"Authorization\"] == \"Bearer [REDACTED]\")\n379|}\n380|\n381|@Test func prepareDownloadRefusesSubstituteArch() async {\n382|    let assets = [\n383|        [\"os\": \"osx\", \"architecture\": \"x64\", \"download_url\": \"https://example.com/osx-x64.tar.gz\", \"filename\": \"osx-x64.tar.gz\", \"sha256_checksum\": \"x64sum\"],\n384|        [\"os\": \"linux\", \"architecture\": \"arm64\", \"download_url\": \"https://example.com/linux.tar.gz\", \"filename\": \"linux.tar.gz\"],\n385|    ]\n386|    let transport = TestTransport([downloadsArrayPayload(assets)])\n387|    let harness = await registrationHarness(transport: transport, arch: \"arm64\")\n388|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n389|    _ = await harness.flow.apply(RunnerRegistration.Effect.prepareDownload)\n390|    let failure = lastFailure(harness.logger)\n391|    #expect(failure?.step == \"prepareDownload\")\n392|    #expect((failure?.message.contains(\"arm64\") ?? false))\n393|    #expect(FileManager.default.fileExists(atPath: harness.installRoot.appendingPathComponent(\"macbook-test\").path) == false)\n394|}\n395|\n396|// MARK: - Groups (dedicated per-Mac, explicit scope)\n397|\n398|@Test func orgResolveGroupFindsExistingWithoutCreating() async {\n399|    let transport = TestTransport([\n400|        jsonResponse([\"runner_groups\": [\n401|            [\"id\": 1, \"name\": \"Default\", \"visibility\": \"all\"],\n402|            [\"id\": 5, \"name\": \"RunnerControl-Mac\", \"visibility\": \"selected\"],\n403|        ]]),\n404|        jsonResponse([\"repositories\": [[\"id\": 9], [\"id\": 10]]]),\n405|    ])\n406|    let harness = await registrationHarness(transport: transport)\n407|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n408|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n409|    let resolved = registrationActions(harness.logger).compactMap { action -> (RunnerRegistration.RunnerGroup, [Int64])? in\n410|        if case .groupResolved(let group, let ids) = action { (group, ids) } else { nil }\n411|    }\n412|    #expect(resolved.count == 1)\n413|    #expect(resolved.first?.0.id == 5)\n414|    #expect(resolved.first?.1.sorted() == [9, 10])\n415|    let requests = await transport.requests\n416|    #expect(requests.filter { $0.method == \"POST\" }.isEmpty)\n417|}\n418|\n419|@Test func orgResolveGroupCreatesWithSelectedRepos() async throws {\n420|    let transport = TestTransport([\n421|        jsonResponse([\"runner_groups\": [[\"id\": 1, \"name\": \"Default\", \"visibility\": \"all\"]]]),\n422|        jsonResponse([\"id\": 7, \"name\": \"RunnerControl-Mac\", \"visibility\": \"selected\"], status: 201),\n423|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n424|    ])\n425|    let harness = await registrationHarness(transport: transport)\n426|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n427|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n428|    let requests = await transport.requests\n429|    let posts = requests.filter { $0.method == \"POST\" }\n430|    #expect(posts.count == 1)\n431|    let body = try JSONDecoder().decode([String: JSONAny].self, from: posts[0].body ?? Data())\n432|    #expect(body[\"name\"]?.string == \"RunnerControl-Mac\")\n433|    #expect(body[\"visibility\"]?.string == \"selected\")\n434|    #expect(body[\"selected_repository_ids\"]?.ints?.sorted() == [9])\n435|}\n436|\n437|/// Minimal JSON reader for asserting request bodies without DTO coupling.\n438|private enum JSONAny: Decodable {\n439|    case string(String)\n440|    case ints([Int64])\n441|    case other\n442|    var string: String? { if case .string(let value) = self { value } else { nil } }\n443|    var ints: [Int64]? { if case .ints(let values) = self { values } else { nil } }\n444|    init(from decoder: Decoder) throws {\n445|        let container = try decoder.singleValueContainer()\n446|        if let value = try? container.decode(String.self) { self = .string(value); return }\n447|        if let values = try? container.decode([Int64].self) { self = .ints(values); return }\n448|        self = .other\n449|    }\n450|}\n451|\n452|@Test func repoScopeRefusesGroupResolution() async {\n453|    let transport = TestTransport([])\n454|    let harness = await registrationHarness(transport: transport)\n455|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(repoDraft()))\n456|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n457|    let failure = lastFailure(harness.logger)\n458|    #expect(failure?.step == \"resolveGroup\")\n459|    #expect((failure?.message.contains(\"organization\") ?? false))\n460|    #expect(await transport.requests.isEmpty)\n461|}\n462|\n463|private func harnessWithResolvedGroup(allow: Bool) async -> RegistrationHarness {\n464|    let transport = TestTransport([\n465|        jsonResponse([\"runner_groups\": [[\"id\": 5, \"name\": \"RunnerControl-Mac\", \"visibility\": \"selected\"]]]),\n466|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n467|    ])\n468|    let harness = await registrationHarness(transport: transport)\n469|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowGroup: allow)))\n470|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n471|    return harness\n472|}\n473|\n474|@Test func repoAccessWithoutExplicitScopeIsRefused() async {\n475|    let harness = await harnessWithResolvedGroup(allow: false)\n476|    let before = await harness.transport.requests.count\n477|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyRepositoryAccess(groupID: 5, repositories: [9, 10]))\n478|    let failure = lastFailure(harness.logger)\n479|    #expect(failure?.step == \"applyRepositoryAccess\")\n480|    #expect((failure?.message.contains(\"explicit\") ?? false))\n481|    #expect(await harness.transport.requests.count == before)\n482|}\n483|\n484|@Test func repoAccessToForeignGroupIsRefused() async {\n485|    let harness = await harnessWithResolvedGroup(allow: true)\n486|    let before = await harness.transport.requests.count\n487|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyRepositoryAccess(groupID: 1, repositories: [9]))\n488|    let failure = lastFailure(harness.logger)\n489|    #expect(failure?.step == \"applyRepositoryAccess\")\n490|    #expect((failure?.message.contains(\"not this Mac\") ?? false))\n491|    #expect(await harness.transport.requests.count == before)\n492|}\n493|\n494|@Test func repoAccessAppliesAndConfirmsRealIDs() async throws {\n495|    let harness = await harnessWithResolvedGroup(allow: true)\n496|    await harness.transport.append(jsonResponse([:]))\n497|    await harness.transport.append(jsonResponse([\"repositories\": [[\"id\": 9], [\"id\": 10]]]))\n498|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyRepositoryAccess(groupID: 5, repositories: [10, 9]))\n499|    let applied = registrationActions(harness.logger).compactMap { action -> [Int64]? in\n500|        if case .repositoryAccessApplied(let ids) = action { ids } else { nil }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b9","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":311,"recorded_at":1780531400000617,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"call_id":"call_01a0a87c2d837090b127d2cf1df315a8","text":"Read text file `Targets/RunnerControl/Sources/RunnerRegistrationContainer.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|/// Wizard composition root. Edits local draft fields, dispatches production\n5|/// `RunnerRegistration.Effect`s, and never holds tokens.\n6|struct RunnerRegistrationContainer: View {\n7|    @ObservedObject var registration: RunnerRegistration.State\n8|    @ObservedObject var github: GitHubAuth.State\n9|    let close: () -> Void\n10|\n11|    @State private var scopeKind: RunnerRegistrationPage.ScopeKind = .organization\n12|    @State private var org = \"\"\n13|    @State private var repoOwner = \"\"\n14|    @State private var repoName = \"\"\n15|    @State private var runnerName = Host.current().localizedName ?? \"\"\n16|    @State private var labelsText = \"self-hosted, macOS\"\n17|    @State private var installDirName = \"\"\n18|    @State private var workFolder = \"_work\"\n19|    @State private var groupName = RunnerRegistration.Draft.defaultGroupName(\n20|        hostName: Host.current().localizedName ?? \"\"\n21|    )\n22|    @State private var allowGroupMutation = false\n23|    @State private var selectedRepositoryIDs: Set<Int64> = []\n24|    @State private var seeded = false\n25|\n26|    private static func parseLabels(_ text: String) -> [String] {\n27|        text.split(separator: \",\").map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }\n28|    }\n29|\n30|    private var currentDraft: RunnerRegistration.Draft {\n31|        let scope: RunnerRegistration.Scope\n32|        switch scopeKind {\n33|        case .organization:\n34|            scope = .organization(org: org.trimmingCharacters(in: .whitespacesAndNewlines))\n35|        case .repository:\n36|            scope = .repository(\n37|                owner: repoOwner.trimmingCharacters(in: .whitespacesAndNewlines),\n38|                name: repoName.trimmingCharacters(in: .whitespacesAndNewlines)\n39|            )\n40|        }\n41|        return RunnerRegistration.Draft(\n42|            scope: scope,\n43|            runnerName: runnerName.trimmingCharacters(in: .whitespacesAndNewlines),\n44|            labels: Self.parseLabels(labelsText),\n45|            installDirName: installDirName.trimmingCharacters(in: .whitespacesAndNewlines),\n46|            workFolder: workFolder.trimmingCharacters(in: .whitespacesAndNewlines),\n47|            groupName: groupName.trimmingCharacters(in: .whitespacesAndNewlines),\n48|            selectedRepositoryIDs: selectedRepositoryIDs,\n49|            allowGroupMutation: allowGroupMutation\n50|        )\n51|    }\n52|\n53|    var body: some View {\n54|        RunnerRegistrationPage(\n55|            props: .init(\n56|                phase: registration.phase,\n57|                working: registration.working,\n58|                scopeKind: scopeKind,\n59|                org: org,\n60|                repoOwner: repoOwner,\n61|                repoName: repoName,\n62|                runnerName: runnerName,\n63|                labelsText: labelsText,\n64|                installDirName: installDirName,\n65|                workFolder: workFolder,\n66|                groupName: groupName,\n67|                allowGroupMutation: allowGroupMutation,\n68|                selectedRepositoryIDs: selectedRepositoryIDs,\n69|                repositories: github.repositories,\n70|                installations: github.installations,\n71|                githubConnected: isConnected,\n72|                githubUsername: github.username,\n73|                group: registration.group,\n74|                groupRepositoryIDs: registration.groupRepositoryIDs,\n75|                assetFilename: registration.asset?.filename,\n76|                installPath: registration.installPath,\n77|                runnerID: registration.runnerID,\n78|                localAgentID: registration.localAgentID,\n79|                completedSteps: registration.completedSteps,\n80|                error: registration.error,\n81|                failedStep: registration.failedStep,\n82|                permissionError: registration.permissionError\n83|            ),\n84|            reactions: .init(\n85|                scopeKindChanged: { scopeKind = $0; pushDraft() },\n86|                orgChanged: { org = $0; pushDraft() },\n87|                repoOwnerChanged: { repoOwner = $0; pushDraft() },\n88|                repoNameChanged: { repoName = $0; pushDraft() },\n89|                runnerNameChanged: { runnerName = $0; pushDraft() },\n90|                labelsChanged: { labelsText = $0; pushDraft() },\n91|                installDirChanged: { installDirName = $0; pushDraft() },\n92|                workFolderChanged: { workFolder = $0; pushDraft() },\n93|                groupNameChanged: { groupName = $0; pushDraft() },\n94|                allowGroupMutationChanged: { allowGroupMutation = $0; pushDraft() },\n95|                repositoriesChanged: { ids in\n96|                    selectedRepositoryIDs = ids\n97|                    Task { await action { GitHubAuth.Effect.selectRepositories(ids) } }\n98|                    pushDraft()\n99|                },\n100|                beginDraft: { Task { await action { RunnerRegistration.Effect.beginDraft(currentDraft) } } },\n101|                resolveGroup: { Task { await action { RunnerRegistration.Effect.resolveGroup } } },\n102|                downloadAndInstall: { Task { await action { RunnerRegistration.Effect.downloadAndInstall } } },\n103|                registerRunner: { Task { await action { RunnerRegistration.Effect.registerRunner } } },\n104|                setupService: { Task { await action { RunnerRegistration.Effect.setupService } } },\n105|                applyRepositoryAccess: {\n106|                    let target = registration.group?.id ?? -1\n107|                    let effect = RunnerRegistration.Effect.applyRepositoryAccess(\n108|                        groupID: target, repositories: selectedRepositoryIDs\n109|                    )\n110|                    Task { await action { effect } }\n111|                },\n112|                applyLabels: {\n113|                    let labels = Self.parseLabels(labelsText)\n114|                    Task { await action { RunnerRegistration.Effect.applyLabels(labels) } }\n115|                },\n116|                retry: { Task { await action { RunnerRegistration.Effect.retry } } },\n117|                cancel: { Task { await action { RunnerRegistration.Effect.cancel } } },\n118|                reset: { Task { await action { RunnerRegistration.Effect.reset } } },\n119|                dismissPermission: { Task { await action { RunnerRegistration.Effect.dismissPermission } } },\n120|                close: close\n121|            )\n122|        )\n123|        .onAppear(perform: seedFromGitHub)\n124|    }\n125|\n126|    private var isConnected: Bool {\n127|        if case .connected = github.connection { return true }\n128|        return false\n129|    }\n130|\n131|    /// Pushes field edits into the draft once the wizard has begun, so step\n132|    /// buttons always run the visible values. Before the first begin the\n133|    /// draft does not exist yet and edits stay local.\n134|    private func pushDraft() {\n135|        guard registration.phase != .idle else { return }\n136|        let draft = currentDraft\n137|        Task { await action { RunnerRegistration.Effect.updateDraft(draft) } }\n138|    }\n139|\n140|    /// Seeds org/owner from the selected GitHub installation once.\n141|    private func seedFromGitHub() {\n142|        guard !seeded else { return }\n143|        seeded = true\n144|        if installDirName.isEmpty {\n145|            installDirName = (Host.current().localizedName ?? \"runner\")\n146|                .lowercased()\n147|                .replacingOccurrences(of: \" \", with: \"-\")\n148|        }\n149|        guard let id = github.selectedInstallationID,\n150|              let installation = github.installations.first(where: { $0.id == id }) else { return }\n151|        if org.isEmpty, installation.accountType == \"Organization\" {\n152|            org = installation.account\n153|            scopeKind = .organization\n154|        } else if repoOwner.isEmpty {\n155|            repoOwner = installation.account\n156|            scopeKind = .repository\n157|        }\n158|        if selectedRepositoryIDs.isEmpty {\n159|            selectedRepositoryIDs = github.selectedRepositoryIDs\n160|        }\n161|    }\n162|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bb","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":312,"recorded_at":1780531400000619,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"call_id":"call_01a0a87c2e887688a25e934547d7ac10","text":"Read text file `Targets/RunnerControl/Sources/RunnerRegistrationPage.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|/// New-runner wizard. Pure view: all state arrives via props, all actions\n5|/// leave via reactions that dispatch production `RunnerRegistration.Effect`s.\n6|struct RunnerRegistrationPage: View {\n7|    struct Props {\n8|        let phase: RunnerRegistration.Phase\n9|        let working: Bool\n10|        let scopeKind: ScopeKind\n11|        let org: String\n12|        let repoOwner: String\n13|        let repoName: String\n14|        let runnerName: String\n15|        let labelsText: String\n16|        let installDirName: String\n17|        let workFolder: String\n18|        let groupName: String\n19|        let allowGroupMutation: Bool\n20|        let selectedRepositoryIDs: Set<Int64>\n21|        let repositories: [GitHubAuth.Repository]\n22|        let installations: [GitHubAuth.Installation]\n23|        let githubConnected: Bool\n24|        let githubUsername: String?\n25|        let group: RunnerRegistration.RunnerGroup?\n26|        let groupRepositoryIDs: [Int64]\n27|        let assetFilename: String?\n28|        let installPath: String?\n29|        let runnerID: Int64?\n30|        let localAgentID: Int64?\n31|        let completedSteps: Set<String>\n32|        let error: String?\n33|        let failedStep: String?\n34|        let permissionError: String?\n35|    }\n36|\n37|    enum ScopeKind: Hashable {\n38|        case organization\n39|        case repository\n40|    }\n41|\n42|    struct Reactions {\n43|        let scopeKindChanged: (ScopeKind) -> Void\n44|        let orgChanged: (String) -> Void\n45|        let repoOwnerChanged: (String) -> Void\n46|        let repoNameChanged: (String) -> Void\n47|        let runnerNameChanged: (String) -> Void\n48|        let labelsChanged: (String) -> Void\n49|        let installDirChanged: (String) -> Void\n50|        let workFolderChanged: (String) -> Void\n51|        let groupNameChanged: (String) -> Void\n52|        let allowGroupMutationChanged: (Bool) -> Void\n53|        let repositoriesChanged: (Set<Int64>) -> Void\n54|        let beginDraft: () -> Void\n55|        let resolveGroup: () -> Void\n56|        let downloadAndInstall: () -> Void\n57|        let registerRunner: () -> Void\n58|        let setupService: () -> Void\n59|        let applyRepositoryAccess: () -> Void\n60|        let applyLabels: () -> Void\n61|        let retry: () -> Void\n62|        let cancel: () -> Void\n63|        let reset: () -> Void\n64|        let dismissPermission: () -> Void\n65|        let close: () -> Void\n66|    }\n67|\n68|    let props: Props\n69|    let reactions: Reactions\n70|\n71|    var body: some View {\n72|        ScrollView {\n73|            VStack(alignment: .leading, spacing: 16) {\n74|                header\n75|                if !props.githubConnected {\n76|                    githubRequired\n77|                }\n78|                WizardForm(props: props, reactions: reactions)\n79|                WizardSteps(props: props, reactions: reactions)\n80|                WizardStatus(props: props, reactions: reactions)\n81|                footer\n82|            }\n83|            .padding(20)\n84|            .frame(maxWidth: .infinity, alignment: .leading)\n85|        }\n86|        .frame(width: 640, height: 560)\n87|    }\n88|\n89|    private var header: some View {\n90|        VStack(alignment: .leading, spacing: 3) {\n91|            Text(\"Новый раннер на этом Mac\").font(.system(size: 15, weight: .semibold))\n92|            Text(\"Официальная сборка GitHub под вашу архитектуру, регистрация без терминала.\")\n93|                .font(.callout).foregroundStyle(.secondary)\n94|        }\n95|    }\n96|\n97|    private var githubRequired: some View {\n98|        HStack(alignment: .top, spacing: 8) {\n99|            Image(systemName: \"person.crop.circle.badge.exclamationmark\").foregroundStyle(.orange)\n100|            VStack(alignment: .leading, spacing: 2) {\n101|                Text(\"Войдите через GitHub во вкладке «GitHub», затем вернитесь сюда.\")\n102|                Text(\"Регистрация требует подтверждённой сессии.\")\n103|            }\n104|            .font(.callout)\n105|        }\n106|        .padding(10)\n107|        .background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n108|    }\n109|\n110|    private var footer: some View {\n111|        HStack(spacing: 8) {\n112|            if props.working {\n113|                Button(\"Отмена\", action: reactions.cancel)\n114|                    .buttonStyle(.bordered)\n115|                    .accessibilityIdentifier(\"Registration cancel button\")\n116|            } else if props.phase != .idle {\n117|                Button(\"Сбросить\", action: reactions.reset)\n118|                    .buttonStyle(.plain).foregroundStyle(.secondary)\n119|                    .accessibilityIdentifier(\"Registration reset button\")\n120|            }\n121|            Spacer()\n122|            Button(\"Закрыть\", action: reactions.close)\n123|                .buttonStyle(.bordered)\n124|                .accessibilityIdentifier(\"Registration close button\")\n125|        }\n126|    }\n127|}\n128|\n129|/// Wizard input form: scope, runner identity, and group access.\n130|private struct WizardForm: View {\n131|    typealias Props = RunnerRegistrationPage.Props\n132|    typealias Reactions = RunnerRegistrationPage.Reactions\n133|    typealias ScopeKind = RunnerRegistrationPage.ScopeKind\n134|\n135|    let props: Props\n136|    let reactions: Reactions\n137|\n138|    var body: some View {\n139|        VStack(alignment: .leading, spacing: 16) {\n140|            scopeSection\n141|            runnerSection\n142|            if props.scopeKind == .organization {\n143|                groupSection\n144|            }\n145|        }\n146|    }\n147|\n148|    private var scopeSection: some View {\n149|        VStack(alignment: .leading, spacing: 8) {\n150|            Text(\"Область регистрации\").font(.system(size: 13, weight: .semibold))\n151|            Picker(\"Область\", selection: Binding(\n152|                get: { props.scopeKind },\n153|                set: reactions.scopeKindChanged\n154|            )) {\n155|                Text(\"Организация\").tag(ScopeKind.organization)\n156|                Text(\"Репозиторий\").tag(ScopeKind.repository)\n157|            }\n158|            .pickerStyle(.segmented)\n159|            .frame(width: 320)\n160|            .accessibilityIdentifier(\"Registration scope picker\")\n161|            if props.scopeKind == .organization {\n162|                labeledField(\n163|                    \"Организация\", text: props.org, set: reactions.orgChanged,\n164|                    placeholder: \"acme\", id: \"Registration org field\"\n165|                )\n166|            } else {\n167|                HStack(spacing: 8) {\n168|                    labeledField(\n169|                        \"Владелец\", text: props.repoOwner, set: reactions.repoOwnerChanged,\n170|                        placeholder: \"octo\", id: \"Registration repo owner field\"\n171|                    )\n172|                    labeledField(\n173|                        \"Репозиторий\", text: props.repoName, set: reactions.repoNameChanged,\n174|                        placeholder: \"app\", id: \"Registration repo name field\"\n175|                    )\n176|                }\n177|                Text(\"Личные репозитории получают отдельную установку без общих групп.\")\n178|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n179|            }\n180|        }\n181|    }\n182|\n183|    private var runnerSection: some View {\n184|        VStack(alignment: .leading, spacing: 8) {\n185|            Text(\"Раннер\").font(.system(size: 13, weight: .semibold))\n186|            labeledField(\n187|                \"Имя раннера\", text: props.runnerName, set: reactions.runnerNameChanged,\n188|                placeholder: Host.current().localizedName ?? \"macbook\",\n189|                id: \"Registration runner name field\"\n190|            )\n191|            labeledField(\n192|                \"Метки (через запятую)\", text: props.labelsText, set: reactions.labelsChanged,\n193|                placeholder: \"self-hosted, macOS\", id: \"Registration labels field\"\n194|            )\n195|            HStack(spacing: 8) {\n196|                labeledField(\n197|                    \"Папка установки\", text: props.installDirName, set: reactions.installDirChanged,\n198|                    placeholder: \"macbook-iv\", id: \"Registration install dir field\"\n199|                )\n200|                labeledField(\n201|                    \"Рабочая папка\", text: props.workFolder, set: reactions.workFolderChanged,\n202|                    placeholder: \"_work\", id: \"Registration work folder field\"\n203|                )\n204|            }\n205|            VStack(alignment: .leading, spacing: 2) {\n206|                Text(\"Пути без пробелов: ~/Library/GitHubActions/<папка>.\")\n207|                Text(\"Повторный запуск продолжает с места остановки и не создаёт дубликатов.\")\n208|            }\n209|            .font(.system(size: 11)).foregroundStyle(.secondary)\n210|        }\n211|    }\n212|\n213|    private var groupSection: some View {\n214|        VStack(alignment: .leading, spacing: 8) {\n215|            Text(\"Группа и доступ к репозиториям\").font(.system(size: 13, weight: .semibold))\n216|            labeledField(\n217|                \"Группа этого Mac\", text: props.groupName, set: reactions.groupNameChanged,\n218|                placeholder: \"RunnerControl-Mac\", id: \"Registration group name field\"\n219|            )\n220|            if let group = props.group {\n221|                VStack(alignment: .leading, spacing: 2) {\n222|                    Text(\"Группа: \\(group.name) · id \\(group.id) · \\(group.visibility).\")\n223|                    Text(\"Доступ: \\(props.groupRepositoryIDs.count) репозиториев.\")\n224|                }\n225|                .font(.callout).foregroundStyle(.secondary)\n226|            } else {\n227|                Text(\"Группа создаётся только для этого Mac. Чужие и общие группы приложение не изменяет.\")\n228|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n229|            }\n230|            Toggle(\n231|                \"Разрешаю изменять доступ только для указанной группы этого Mac\",\n232|                isOn: Binding(get: { props.allowGroupMutation }, set: reactions.allowGroupMutationChanged)\n233|            )\n234|            .font(.callout)\n235|            .accessibilityIdentifier(\"Registration allow group mutation toggle\")\n236|            if props.repositories.isEmpty {\n237|                Text(\"Репозитории выбранной установки появятся здесь после входа.\")\n238|                    .font(.callout).foregroundStyle(.secondary)\n239|            } else {\n240|                VStack(alignment: .leading, spacing: 6) {\n241|                    ForEach(props.repositories) { repo in\n242|                        Toggle(\n243|                            repo.fullName,\n244|                            isOn: Binding(\n245|                                get: { props.selectedRepositoryIDs.contains(repo.id) },\n246|                                set: { enabled in\n247|                                    var next = props.selectedRepositoryIDs\n248|                                    if enabled { next.insert(repo.id) } else { next.remove(repo.id) }\n249|                                    reactions.repositoriesChanged(next)\n250|                                }\n251|                            )\n252|                        )\n253|                        .font(.callout)\n254|                    }\n255|                }\n256|                if props.group != nil {\n257|                    Button(\"Применить доступ к репозиториям\", action: reactions.applyRepositoryAccess)\n258|                        .buttonStyle(.bordered)\n259|                        .disabled(props.working || !props.allowGroupMutation)\n260|                        .accessibilityIdentifier(\"Registration apply repo access button\")\n261|                }\n262|            }\n263|        }\n264|    }\n265|\n266|    private func labeledField(\n267|        _ title: String, text: String, set: @escaping (String) -> Void,\n268|        placeholder: String, id: String\n269|    ) -> some View {\n270|        VStack(alignment: .leading, spacing: 4) {\n271|            Text(title).font(.system(size: 11)).foregroundStyle(.secondary)\n272|            TextField(placeholder, text: Binding(get: { text }, set: set))\n273|                .textFieldStyle(.roundedBorder)\n274|                .accessibilityIdentifier(id)\n275|        }\n276|    }\n277|}\n278|\n279|/// Wizard step buttons with per-step completion state.\n280|private struct WizardSteps: View {\n281|    typealias Props = RunnerRegistrationPage.Props\n282|    typealias Reactions = RunnerRegistrationPage.Reactions\n283|\n284|    let props: Props\n285|    let reactions: Reactions\n286|\n287|    var body: some View {\n288|        VStack(alignment: .leading, spacing: 8) {\n289|            Text(\"Шаги\").font(.system(size: 13, weight: .semibold))\n290|            stepRow(\n291|                title: \"Черновик\", done: props.phase != .idle,\n292|                action: reactions.beginDraft, button: \"Начать\",\n293|                id: \"Registration begin button\"\n294|            )\n295|            if props.scopeKind == .organization {\n296|                stepRow(\n297|                    title: \"Группа этого Mac\",\n298|                    done: props.completedSteps.contains(\"resolveGroup\"),\n299|                    action: reactions.resolveGroup, button: \"Найти или создать\",\n300|                    id: \"Registration resolve group button\"\n301|                )\n302|            }\n303|            stepRow(\n304|                title: \"Загрузка и проверка сборки\",\n305|                done: props.completedSteps.contains(\"downloadAndInstall\"),\n306|                action: reactions.downloadAndInstall, button: \"Загрузить и установить\",\n307|                id: \"Registration install button\",\n308|                detail: props.assetFilename ?? props.installPath\n309|            )\n310|            stepRow(\n311|                title: \"Регистрация\",\n312|                done: props.completedSteps.contains(\"registerRunner\"),\n313|                action: reactions.registerRunner, button: \"Зарегистрировать\",\n314|                id: \"Registration register button\",\n315|                detail: props.runnerID.map { \"id \\($0)\" }\n316|            )\n317|            stepRow(\n318|                title: \"Служба (автозапуск выключен)\",\n319|                done: props.completedSteps.contains(\"setupService\"),\n320|                action: reactions.setupService, button: \"Настроить службу\",\n321|                id: \"Registration setup service button\"\n322|            )\n323|            HStack(spacing: 8) {\n324|                Button(\"Метки: применить текущие\", action: reactions.applyLabels)\n325|                    .buttonStyle(.bordered).controlSize(.small)\n326|                    .disabled(props.working || props.runnerID == nil)\n327|                    .accessibilityIdentifier(\"Registration apply labels button\")\n328|                if props.failedStep != nil {\n329|                    Button(\"Повторить шаг\", action: reactions.retry)\n330|                        .buttonStyle(.borderedProminent).tint(.teal).controlSize(.small)\n331|                        .disabled(props.working)\n332|                        .accessibilityIdentifier(\"Registration retry button\")\n333|                }\n334|                if props.working {\n335|                    ProgressView().controlSize(.small)\n336|                }\n337|            }\n338|        }\n339|    }\n340|\n341|    private func stepRow(\n342|        title: String, done: Bool, action: @escaping () -> Void,\n343|        button: String, id: String, detail: String? = nil\n344|    ) -> some View {\n345|        HStack(spacing: 8) {\n346|            Image(systemName: done ? \"checkmark.circle.fill\" : \"circle\")\n347|                .foregroundStyle(done ? .green : .secondary)\n348|            VStack(alignment: .leading, spacing: 2) {\n349|                Text(title).font(.callout)\n350|                if let detail {\n351|                    Text(detail).font(.system(size: 11)).foregroundStyle(.secondary).lineLimit(2)\n352|                }\n353|            }\n354|            Spacer()\n355|            Button(button, action: action)\n356|                .buttonStyle(.bordered).controlSize(.small)\n357|                .disabled(props.working || !props.githubConnected)\n358|                .accessibilityIdentifier(id)\n359|        }\n360|    }\n361|}\n362|\n363|/// Wizard outcome: retained permission errors, step errors, and completion.\n364|private struct WizardStatus: View {\n365|    typealias Props = RunnerRegistrationPage.Props\n366|    typealias Reactions = RunnerRegistrationPage.Reactions\n367|\n368|    let props: Props\n369|    let reactions: Reactions\n370|\n371|    var body: some View {\n372|        VStack(alignment: .leading, spacing: 16) {\n373|            if let permission = props.permissionError {\n374|                permissionView(permission)\n375|            } else if let error = props.error {\n376|                errorView(error)\n377|            }\n378|            if props.phase == .done {\n379|                doneView\n380|            }\n381|        }\n382|    }\n383|\n384|    private func permissionView(_ message: String) -> some View {\n385|        VStack(alignment: .leading, spacing: 8) {\n386|            HStack(alignment: .top, spacing: 8) {\n387|                Image(systemName: \"lock.triangle.fill\").foregroundStyle(.red)\n388|                Text(message).font(.callout).textSelection(.enabled)\n389|                Spacer(minLength: 0)\n390|            }\n391|            HStack(spacing: 8) {\n392|                Button(\"Повторить шаг\", action: reactions.retry)\n393|                    .buttonStyle(.borderedProminent).tint(.teal).controlSize(.small)\n394|                    .disabled(props.working)\n395|                Button(\"Скрыть\", action: reactions.dismissPermission)\n396|                    .buttonStyle(.plain).font(.callout).foregroundStyle(.secondary)\n397|            }\n398|            Text(\"Ошибка прав сохранена и не стирается правками черновика.\")\n399|                .font(.system(size: 11)).foregroundStyle(.secondary)\n400|        }\n401|        .padding(10)\n402|        .background(.red.opacity(0.07), in: RoundedRectangle(cornerRadius: 10))\n403|    }\n404|\n405|    private func errorView(_ message: String) -> some View {\n406|        HStack(alignment: .top, spacing: 8) {\n407|            Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n408|            Text(message).font(.caption).textSelection(.enabled).lineLimit(6)\n409|            Spacer(minLength: 0)\n410|        }\n411|        .padding(10)\n412|        .background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n413|    }\n414|\n415|    private var doneView: some View {\n416|        VStack(alignment: .leading, spacing: 6) {\n417|            HStack(spacing: 8) {\n418|                Image(systemName: \"checkmark.seal.fill\").foregroundStyle(.green)\n419|                Text(\"Раннер зарегистрирован\").font(.callout.weight(.medium))\n420|            }\n421|            if let path = props.installPath {\n422|                Text(path).font(.system(size: 11)).foregroundStyle(.secondary).textSelection(.enabled)\n423|            }\n424|            Text(\"Включите его во вкладке «Раннеры», когда будете готовы. Токен регистрации уже удалён.\")\n425|                .font(.system(size: 11)).foregroundStyle(.secondary)\n426|        }\n427|        .padding(10)\n428|        .background(.green.opacity(0.07), in: RoundedRectangle(cornerRadius: 10))\n429|    }\n430|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
