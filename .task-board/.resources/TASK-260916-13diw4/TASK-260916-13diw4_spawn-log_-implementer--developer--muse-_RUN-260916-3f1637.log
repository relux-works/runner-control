{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c54f","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":258,"recorded_at":1780531400000511,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"task_stream":{"kind":"task","id":"01a0a87c-1edb-7a42-8fe6-23ac1c9888fd"},"task_id":"01a0a87c-1edb-7a42-8fe6-23ac1c9888fd","event":{"kind":"output","task_id":"01a0a87c-1edb-7a42-8fe6-23ac1c9888fd","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n(499 line(s) above)\n500|        do {\n501|            let resolved: Int64?\n502|            if let runnerID {\n503|                resolved = runnerID\n504|            } else {\n505|                resolved = try await resolveRemoteRunnerID(draft: draft, generation: gen)\n506|                guard !isStale(gen) else { return }\n507|            }\n508|            guard let runnerID = resolved else {\n509|                failedStep = \"applyLabels\"\n510|                working = false\n511|                await action {\n512|                    RunnerRegistration.Action.failed(\n513|                        message: \"Register the runner first so labels have a real runner ID.\",\n514|                        step: \"applyLabels\"\n515|                    )\n516|                }\n517|                return\n518|            }\n519|            let auth = try await currentUserToken(generation: gen)\n520|            guard !isStale(gen) else { return }\n521|            try await api.setRunnerLabels(\n522|                config: auth.config, token: auth.token, scope: draft.scope, runnerID: runnerID, labels: trimmed\n523|            )\n524|            guard !isStale(gen) else { return }\n525|            self.runnerID = runnerID\n526|            if var current = self.draft {\n527|                current.labels = trimmed\n528|                self.draft = current\n529|            }\n530|            await action { RunnerRegistration.Action.labelsApplied(trimmed) }\n531|            pendingLabels = nil\n532|            await finishStep(\"applyLabels\", generation: gen)\n533|        } catch {\n534|            working = false\n535|            await fail(error, step: \"applyLabels\", generation: gen)\n536|        }\n537|    }\n538|\n539|    // MARK: - Retry / cancel / reset\n540|\n541|    private func retry() async {\n542|        guard !working else { return }\n543|        guard let step = failedStep else { return }\n544|        switch step {\n545|        case \"resolveGroup\": await resolveGroup()\n546|        case \"prepareDownload\": await prepareDownload()\n547|        case \"downloadAndInstall\": await downloadAndInstall()\n548|        case \"registerRunner\": await registerRunner()\n549|        case \"setupService\": await setupService()\n550|        case \"applyRepositoryAccess\":\n551|            if let ids = pendingRepositoryIDs, let target = pendingTargetGroupID {\n552|                await applyRepositoryAccess(groupID: target, ids: ids)\n553|            }\n554|        case \"applyLabels\":\n555|            if let labels = pendingLabels { await applyLabels(labels) }\n556|        default:\n557|            return\n558|        }\n559|    }\n560|\n561|    private func cancel() async {\n562|        generation += 1\n563|        working = false\n564|        if let draft {\n565|            await registrationTokens.delete(scopeKey: Self.tokenScopeKey(draft: draft))\n566|        }\n567|        failedStep = nil\n568|        pendingRepositoryIDs = nil\n569|        pendingTargetGroupID = nil\n570|        pendingLabels = nil\n571|        await action { RunnerRegistration.Action.cancelled }\n572|    }\n573|\n574|    private func reset() async {\n575|        generation += 1\n576|        working = false\n577|        if let draft {\n578|            await registrationTokens.delete(scopeKey: Self.tokenScopeKey(draft: draft))\n579|        }\n580|        draft = nil\n581|        group = nil\n582|        asset = nil\n583|        installPath = nil\n584|        runnerID = nil\n585|        failedStep = nil\n586|        pendingRepositoryIDs = nil\n587|        pendingTargetGroupID = nil\n588|        pendingLabels = nil\n589|        await action { RunnerRegistration.Action.didReset }\n590|    }\n591|}","final_result":true}}}
