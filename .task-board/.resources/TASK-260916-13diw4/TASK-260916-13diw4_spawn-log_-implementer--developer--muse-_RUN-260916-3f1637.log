{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4db","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":200,"recorded_at":1780531400000395,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"task_stream":{"kind":"task","id":"01a0a87c-061e-7b50-aefd-4db3a3de68d8"},"task_id":"01a0a87c-061e-7b50-aefd-4db3a3de68d8","event":{"kind":"output","task_id":"01a0a87c-061e-7b50-aefd-4db3a3de68d8","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Models.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Registration scope. One wizard run registers exactly one scope:\n5|    /// an organization (shared, via a dedicated per-Mac group) or a single\n6|    /// personal repository (separate installation, no group).\n7|    public enum Scope: Sendable, Equatable, Hashable {\n8|        case organization(org: String)\n9|        case repository(owner: String, name: String)\n10|\n11|        /// REST path prefix below the API base URL, e.g. `orgs/acme` or `repos/acme/app`.\n12|        public var apiPrefix: String {\n13|            switch self {\n14|            case .organization(let org): \"orgs/\\(org)\"\n15|            case .repository(let owner, let name): \"repos/\\(owner)/\\(name)\"\n16|            }\n17|        }\n18|\n19|        /// Short key for token-store accounts and markers. Never contains secrets.\n20|        public var scopeKey: String {\n21|            switch self {\n22|            case .organization(let org): \"org:\\(org)\"\n23|            case .repository(let owner, let name): \"repo:\\(owner)/\\(name)\"\n24|            }\n25|        }\n26|\n27|        /// URL passed to `config.sh --url`. Enterprise hosts keep their own server.\n28|        public func configURL(serverHost: String) -> String {\n29|            let host = serverHost == \"github.com\" || serverHost == \"www.github.com\"\n30|                ? \"https://github.com\"\n31|                : \"https://\\(serverHost)\"\n32|            switch self {\n33|            case .organization(let org): return \"\\(host)/\\(org)\"\n34|            case .repository(let owner, let name): return \"\\(host)/\\(owner)/\\(name)\"\n35|            }\n36|        }\n37|\n38|        /// Detail line shown in UI, e.g. `acme` or `acme/app`.\n39|        public var detail: String {\n40|            switch self {\n41|            case .organization(let org): org\n42|            case .repository(let owner, let name): \"\\(owner)/\\(name)\"\n43|            }\n44|        }\n45|    }\n46|\n47|    /// User-editable wizard input. Holds no tokens.\n48|    public struct Draft: Sendable, Equatable {\n49|        public var scope: Scope\n50|        public var runnerName: String\n51|        public var labels: [String]\n52|        public var installDirName: String\n53|        public var workFolder: String\n54|        /// Dedicated per-Mac group name for org scope. Ignored for repo scope.\n55|        public var groupName: String\n56|        public var selectedRepositoryIDs: Set<Int64>\n57|        /// Explicit UI scope: user confirmed that group mutations apply only\n58|        /// to the resolved dedicated group. Never implied.\n59|        public var allowGroupMutation: Bool\n60|\n61|        public init(\n62|            scope: Scope,\n63|            runnerName: String,\n64|            labels: [String] = [\"self-hosted\", \"macOS\"],\n65|            installDirName: String,\n66|            workFolder: String = \"_work\",\n67|            groupName: String = \"\",\n68|            selectedRepositoryIDs: Set<Int64> = [],\n69|            allowGroupMutation: Bool = false\n70|        ) {\n71|            self.scope = scope\n72|            self.runnerName = runnerName\n73|            self.labels = labels\n74|            self.installDirName = installDirName\n75|            self.workFolder = workFolder\n76|            self.groupName = groupName\n77|            self.selectedRepositoryIDs = selectedRepositoryIDs\n78|            self.allowGroupMutation = allowGroupMutation\n79|        }\n80|\n81|        /// Default per-Mac group name derived from the Mac name.\n82|        public static func defaultGroupName(hostName: String) -> String {\n83|            let trimmed = hostName.trimmingCharacters(in: .whitespacesAndNewlines)\n84|            let base = trimmed.isEmpty ? \"Mac\" : trimmed\n85|            return \"RunnerControl-\\(base)\"\n86|        }\n87|    }\n88|\n89|    /// Official runner download asset as returned by the downloads endpoint.\n90|    public struct DownloadAsset: Sendable, Equatable {\n91|        public let osName: String\n92|        public let architecture: String\n93|        public let downloadURL: URL\n94|        public let filename: String\n95|        public let sha256Checksum: String?\n96|        public init(osName: String, architecture: String, downloadURL: URL, filename: String, sha256Checksum: String?) {\n97|            self.osName = osName; self.architecture = architecture\n98|            self.downloadURL = downloadURL; self.filename = filename\n99|            self.sha256Checksum = sha256Checksum\n100|        }\n101|    }\n102|\n103|    /// Runner group summary. Repository access is fetched separately.\n104|    public struct RunnerGroup: Sendable, Equatable {\n105|        public let id: Int64\n106|        public let name: String\n107|        public let visibility: String\n108|        public init(id: Int64, name: String, visibility: String) {\n109|            self.id = id; self.name = name; self.visibility = visibility\n110|        }\n111|    }\n112|\n113|    /// Registered runner identity fetched from GitHub after config.\n114|    public struct RegisteredRunner: Sendable, Equatable {\n115|        public let id: Int64\n116|        public let name: String\n117|        public let labels: [String]\n118|        public init(id: Int64, name: String, labels: [String]) {\n119|            self.id = id; self.name = name; self.labels = labels\n120|        }\n121|    }\n122|}\n123|\n124|extension RunnerRegistration {\n125|    public enum RegistrationError: LocalizedError, Sendable, Equatable {\n126|        case notAuthenticated\n127|        case missingPermission(String)\n128|        case invalidDraft(String)\n129|        case noSpacePath(String)\n130|        case downloadMismatch(osName: String, arch: String)\n131|        case integrityMismatch\n132|        case groupScopeNotConfirmed\n133|        case refusesSharedGroup(groupID: Int64)\n134|        case groupNotApplicable\n135|        case alreadyInstalled(path: String)\n136|        case alreadyRegistered(name: String)\n137|        case network(String)\n138|        case unauthorized\n139|        case forbidden(String)\n140|        case rateLimited\n141|        case configFailed(String)\n142|        case cancelled\n143|\n144|        public var errorDescription: String? {\n145|            switch self {\n146|            case .notAuthenticated:\n147|                \"Sign in with GitHub first. Registration needs an authenticated session.\"\n148|            case .missingPermission(let text):\n149|                text.isEmpty ? \"Missing GitHub permission for this step.\" : text\n150|            case .invalidDraft(let text):\n151|                text\n152|            case .noSpacePath(let text):\n153|                text\n154|            case .downloadMismatch(let osName, let arch):\n155|                \"No official runner package for os=\\(osName) arch=\\(arch). Refusing substitute builds.\"\n156|            case .integrityMismatch:\n157|                \"Download integrity check failed (SHA-256 mismatch). Refusing to install.\"\n158|            case .groupScopeNotConfirmed:\n159|                \"Repository access changes need explicit confirmation for the dedicated group.\"\n160|            case .refusesSharedGroup(let groupID):\n161|                \"Refusing to change group \\(groupID): it is not this Mac's dedicated group.\"\n162|            case .groupNotApplicable:\n163|                \"Runner groups apply to organization runners only. Repository runners use separate installations.\"\n164|            case .alreadyInstalled(let path):\n165|                \"Installation already exists at \\(path). Resume or remove it before retrying.\"\n166|            case .alreadyRegistered(let name):\n167|                \"Runner '\\(name)' is already registered here. Reuse it instead of creating a duplicate.\"\n168|            case .network(let text):\n169|                text\n170|            case .unauthorized:\n171|                \"Session expired or revoked (401). Sign in again.\"\n172|            case .forbidden(let text):\n173|                text.isEmpty ? \"Access forbidden (403).\" : text\n174|            case .rateLimited:\n175|                \"GitHub rate limit reached. Retry later; local runners keep working.\"\n176|            case .configFailed(let text):\n177|                text.isEmpty ? \"Runner configuration failed.\" : text\n178|            case .cancelled:\n179|                \"Registration cancelled.\"\n180|            }\n181|        }\n182|    }\n183|}","final_result":true}}}
