{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc49","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":1151,"recorded_at":1780531400002297,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"task_stream":{"kind":"task","id":"01a0a880-c4a2-7541-89db-cff7c5ca7e9d"},"task_id":"01a0a880-c4a2-7541-89db-cff7c5ca7e9d","event":{"kind":"output","task_id":"01a0a880-c4a2-7541-89db-cff7c5ca7e9d","chunk":"edited\nchanged lines: lines 172-192\n--- original\n+++ updated\n@@\n-    @discardableResult\n-    public func runConfig(\n-        directory: URL,\n-        scopeURL: String,\n-        token: String,\n-        draft: RunnerRegistration.Draft,\n-        runnerGroup: String?\n-    ) async throws -> Int64? {\n-        let files = FileManager.default\n-        if hasCompleted(Self.stepConfigured, directory: directory),\n-           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n-            return readAgentID(directory: directory)\n-        }\n-        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n-           hasCompleted(Self.stepConfigured, directory: directory) {\n-            return readAgentID(directory: directory)\n-        }\n-        let spec = RunnerRegistration.ConfigSpec(\n-            scopeURL: scopeURL, token: token, name: draft.runnerName,\n-            workFolder: draft.workFolder, labels: draft.labels, runnerGroup: runnerGroup\n-        )\n+    @discardableResult\n+    public func runConfig(\n+        directory: URL,\n+        scopeURL: String,\n+        token: String,\n+        draft: RunnerRegistration.Draft,\n+        runnerGroup: String?\n+    ) async throws -> Int64? {\n+        try await runConfig(\n+            directory: directory, scopeURL: scopeURL, token: token,\n+            draft: draft, runnerGroup: runnerGroup, replace: draft.allowReplace\n+        )\n+    }\n+\n+    /// Explicit-`replace` variant. Production callers pass\n+    /// `draft.allowReplace`; tests drive both values.\n+    @discardableResult\n+    public func runConfig(\n+        directory: URL,\n+        scopeURL: String,\n+        token: String,\n+        draft: RunnerRegistration.Draft,\n+        runnerGroup: String?,\n+        replace: Bool\n+    ) async throws -> Int64? {\n+        let files = FileManager.default\n+        if hasCompleted(Self.stepConfigured, directory: directory),\n+           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n+            return readAgentID(directory: directory)\n+        }\n+        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n+           hasCompleted(Self.stepConfigured, directory: directory) {\n+            return readAgentID(directory: directory)\n+        }\n+        let spec = RunnerRegistration.ConfigSpec(\n+            scopeURL: scopeURL, token: token, name: draft.runnerName,\n+            workFolder: draft.workFolder, labels: draft.labels,\n+            runnerGroup: runnerGroup, replace: replace\n+        )\n","final_result":true}}}
