        }\n580|        draft = nil\n581|        group = nil\n582|        asset = nil\n583|        installPath = nil\n584|        runnerID = nil\n585|        failedStep = nil\n586|        pendingRepositoryIDs = nil\n587|        pendingTargetGroupID = nil\n588|        pendingLabels = nil\n589|        await action { RunnerRegistration.Action.didReset }\n590|    }\n591|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c561","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":267,"recorded_at":1780531400000529,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"call_id":"call_01a0a87c17db74d1a60cf699152d8662","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubRunnerAPIClient.swift`.\n1|import Foundation\n2|\n3|/// GitHub REST client for self-hosted runner registration. Takes the user\n4|/// token explicitly per call; never stores it.\n5|public actor GitHubRunnerAPIClient {\n6|    private let transport: any GitHubHTTPTransport\n7|\n8|    public init(transport: any GitHubHTTPTransport) {\n9|        self.transport = transport\n10|    }\n11|\n12|    private func authorizedHeaders(token: String) throws -> [String: String] {\n13|        let header: String\n14|        do {\n15|            header = try GitHubAuth.PATGuard.authorizationHeader(token: token)\n16|        } catch {\n17|            throw GitHubAuth.AuthError.patNotSupported\n18|        }\n19|        return [\"Accept\": \"application/vnd.github+json\", \"Authorization\": header]\n20|    }\n21|\n22|    private func send(\n23|        method: String,\n24|        config: GitHubAuth.AppConfig,\n25|        path: String,\n26|        token: String,\n27|        body: Data? = nil\n28|    ) async throws -> GitHubHTTPResponse {\n29|        let headers = try authorizedHeaders(token: token)\n30|        var all = headers\n31|        if body != nil { all[\"Content-Type\"] = \"application/json\" }\n32|        let request = GitHubHTTPRequest(\n33|            method: method,\n34|            url: config.apiBaseURL.appendingPathComponent(path),\n35|            headers: all,\n36|            body: body\n37|        )\n38|        let response: GitHubHTTPResponse\n39|        do {\n40|            response = try await transport.send(request)\n41|        } catch {\n42|            throw RunnerRegistration.RegistrationError.network(\n43|                GitHubTransportError.offline.localizedDescription\n44|            )\n45|        }\n46|        switch response.status {\n47|        case 200, 201:\n48|            return response\n49|        case 401:\n50|            throw RunnerRegistration.RegistrationError.unauthorized\n51|        case 403:\n52|            throw RunnerRegistration.RegistrationError.forbidden(\n53|                String(String(decoding: response.body, as: UTF8.self).prefix(300))\n54|            )\n55|        case 404:\n56|            throw RunnerRegistration.RegistrationError.network(\"GitHub resource not found (404): \\(path).\")\n57|        case 422:\n58|            throw RunnerRegistration.RegistrationError.network(\n59|                \"GitHub rejected the request (422): \" +\n60|                    String(String(decoding: response.body, as: UTF8.self).prefix(300))\n61|            )\n62|        default:\n63|            if response.status == 429\n64|                || String(decoding: response.body, as: UTF8.self).lowercased().contains(\"rate limit\") {\n65|                throw RunnerRegistration.RegistrationError.rateLimited\n66|            }\n67|            throw RunnerRegistration.RegistrationError.network(\n68|                \"GitHub request failed (HTTP \\(response.status)).\"\n69|            )\n70|        }\n71|    }\n72|\n73|    private func decode<T: Decodable>(_ type: T.Type, from response: GitHubHTTPResponse) throws -> T {\n74|        do {\n75|            return try JSONDecoder().decode(type, from: response.body)\n76|        } catch {\n77|            throw RunnerRegistration.RegistrationError.network(\n78|                GitHubTransportError.invalidResponse.localizedDescription\n79|            )\n80|        }\n81|    }\n82|\n83|    // MARK: - Downloads\n84|\n85|    public func fetchDownloads(\n86|        config: GitHubAuth.AppConfig,\n87|        token: String,\n88|        scope: RunnerRegistration.Scope\n89|    ) async throws -> [RunnerRegistration.DownloadAsset] {\n90|        let response: GitHubHTTPResponse\n91|        do {\n92|            response = try await send(\n93|                method: \"GET\", config: config,\n94|                path: \"\\(scope.apiPrefix)/actions/runners/downloads\", token: token\n95|            )\n96|        } catch let error as RunnerRegistration.RegistrationError {\n97|            if case .forbidden(let text) = error {\n98|                throw RunnerRegistration.RegistrationError.missingPermission(readHelp(scope: scope, detail: text))\n99|            }\n100|            throw error\n101|        }\n102|        let decoded = try decode([RunnerDownloadDTO].self, from: response)\n103|        return decoded.compactMap { dto -> RunnerRegistration.DownloadAsset? in\n104|            guard let url = URL(string: dto.downloadURL) else { return nil }\n105|            return .init(\n106|                osName: dto.osName, architecture: dto.architecture,\n107|                downloadURL: url, filename: dto.filename,\n108|                sha256Checksum: dto.sha256Checksum\n109|            )\n110|        }\n111|    }\n112|\n113|    // MARK: - Registration token (short-lived, single use)\n114|\n115|    public func createRegistrationToken(\n116|        config: GitHubAuth.AppConfig,\n117|        token: String,\n118|        scope: RunnerRegistration.Scope\n119|    ) async throws -> (token: String, expiresAt: Date?) {\n120|        let response: GitHubHTTPResponse\n121|        do {\n122|            response = try await send(\n123|                method: \"POST\", config: config,\n124|                path: \"\\(scope.apiPrefix)/actions/runners/registration-token\", token: token\n125|            )\n126|        } catch let error as RunnerRegistration.RegistrationError {\n127|            if case .forbidden(let text) = error {\n128|                throw RunnerRegistration.RegistrationError.missingPermission(permissionHelp(scope: scope, detail: text))\n129|            }\n130|            throw error\n131|        }\n132|        let decoded = try decode(RegistrationTokenDTO.self, from: response)\n133|        guard !decoded.token.isEmpty else {\n134|            throw RunnerRegistration.RegistrationError.network(\n135|                GitHubTransportError.invalidResponse.localizedDescription\n136|            )\n137|        }\n138|        var expiresAt: Date?\n139|        if let raw = decoded.expiresAt {\n140|            expiresAt = ISO8601DateFormatter().date(from: raw)\n141|        }\n142|        return (decoded.token, expiresAt)\n143|    }\n144|\n145|    private func permissionHelp(scope: RunnerRegistration.Scope, detail: String) -> String {\n146|        writeHelp(scope: scope, detail: detail)\n147|    }\n148|\n149|    private func readHelp(scope: RunnerRegistration.Scope, detail: String) -> String {\n150|        let need: String\n151|        switch scope {\n152|        case .organization:\n153|            need = \"Self-hosted runners/read for the organization\"\n154|        case .repository:\n155|            need = \"Administration/read for the repository\"\n156|        }\n157|        let suffix = detail.isEmpty ? \"\" : \" GitHub says: \\(detail)\"\n158|        return \"Missing permission: \\(need).\\(suffix)\"\n159|    }\n160|\n161|    private func writeHelp(scope: RunnerRegistration.Scope, detail: String) -> String {\n162|        let need: String\n163|        switch scope {\n164|        case .organization:\n165|            need = \"Self-hosted runners/write for the organization\"\n166|        case .repository:\n167|            need = \"Administration/write for the repository\"\n168|        }\n169|        let suffix = detail.isEmpty ? \"\" : \" GitHub says: \\(detail)\"\n170|        return \"Missing permission: \\(need).\\(suffix)\"\n171|    }\n172|\n173|    private func groupReadHelp(org: String, detail: String) -> String {\n174|        let suffix = detail.isEmpty ? \"\" : \" GitHub says: \\(detail)\"\n175|        return \"Missing permission: Self-hosted runners/read for the organization \\(org).\\(suffix)\"\n176|    }\n177|\n178|    // MARK: - Runners (fetch real IDs)\n179|\n180|    public func fetchRunners(\n181|        config: GitHubAuth.AppConfig,\n182|        token: String,\n183|        scope: RunnerRegistration.Scope\n184|    ) async throws -> [RunnerRegistration.RegisteredRunner] {\n185|        let response: GitHubHTTPResponse\n186|        do {\n187|            response = try await send(\n188|                method: \"GET\", config: config,\n189|                path: \"\\(scope.apiPrefix)/actions/runners\", token: token\n190|            )\n191|        } catch let error as RunnerRegistration.RegistrationError {\n192|            if case .forbidden(let text) = error {\n193|                throw RunnerRegistration.RegistrationError.missingPermission(readHelp(scope: scope, detail: text))\n194|            }\n195|            throw error\n196|        }\n197|        let decoded = try decode(RunnersListDTO.self, from: response)\n198|        return decoded.runners.map {\n199|            .init(id: $0.id, name: $0.name, labels: $0.labels.map(\\.name))\n200|        }\n201|    }\n202|\n203|    // MARK: - Runner groups (org only)\n204|\n205|    public func fetchGroups(\n206|        config: GitHubAuth.AppConfig,\n207|        token: String,\n208|        org: String\n209|    ) async throws -> [RunnerRegistration.RunnerGroup] {\n210|        let response: GitHubHTTPResponse\n211|        do {\n212|            response = try await send(\n213|                method: \"GET\", config: config,\n214|                path: \"orgs/\\(org)/actions/runner-groups\", token: token\n215|            )\n216|        } catch let error as RunnerRegistration.RegistrationError {\n217|            if case .forbidden(let text) = error {\n218|                throw RunnerRegistration.RegistrationError.missingPermission(groupReadHelp(org: org, detail: text))\n219|            }\n220|            throw error\n221|        }\n222|        let decoded = try decode(RunnerGroupsListDTO.self, from: response)\n223|        return decoded.runnerGroups.map { .init(id: $0.id, name: $0.name, visibility: $0.visibility) }\n224|    }\n225|\n226|    public func createGroup(\n227|        config: GitHubAuth.AppConfig,\n228|        token: String,\n229|        org: String,\n230|        name: String,\n231|        selectedRepositoryIDs: Set<Int64>\n232|    ) async throws -> RunnerRegistration.RunnerGroup {\n233|        let payload = CreateGroupDTO(\n234|            name: name, visibility: \"selected\",\n235|            selectedRepositoryIDs: Array(selectedRepositoryIDs).sorted()\n236|        )\n237|        let body = try JSONEncoder().encode(payload)\n238|        let response: GitHubHTTPResponse\n239|        do {\n240|            response = try await send(\n241|                method: \"POST\", config: config,\n242|                path: \"orgs/\\(org)/actions/runner-groups\", token: token, body: body\n243|            )\n244|        } catch let error as RunnerRegistration.RegistrationError {\n245|            if case .forbidden(let text) = error {\n246|                throw RunnerRegistration.RegistrationError.missingPermission(\n247|                    permissionHelp(scope: .organization(org: org), detail: text)\n248|                )\n249|            }\n250|            throw error\n251|        }\n252|        let decoded = try decode(RunnerGroupDTO.self, from: response)\n253|        return .init(id: decoded.id, name: decoded.name, visibility: decoded.visibility)\n254|    }\n255|\n256|    public func fetchGroupRepositories(\n257|        config: GitHubAuth.AppConfig,\n258|        token: String,\n259|        org: String,\n260|        groupID: Int64\n261|    ) async throws -> [Int64] {\n262|        let response: GitHubHTTPResponse\n263|        do {\n264|            response = try await send(\n265|                method: \"GET\", config: config,\n266|                path: \"orgs/\\(org)/actions/runner-groups/\\(groupID)/repositories\", token: token\n267|            )\n268|        } catch let error as RunnerRegistration.RegistrationError {\n269|            if case .forbidden(let text) = error {\n270|                throw RunnerRegistration.RegistrationError.missingPermission(groupReadHelp(org: org, detail: text))\n271|            }\n272|            throw error\n273|        }\n274|        let decoded = try decode(GroupRepositoriesDTO.self, from: response)\n275|        return decoded.repositories.map(\\.id)\n276|    }\n277|\n278|    public func setGroupRepositories(\n279|        config: GitHubAuth.AppConfig,\n280|        token: String,\n281|        org: String,\n282|        groupID: Int64,\n283|        selectedRepositoryIDs: Set<Int64>\n284|    ) async throws {\n285|        let payload = SetGroupRepositoriesDTO(selectedRepositoryIDs: Array(selectedRepositoryIDs).sorted())\n286|        let body = try JSONEncoder().encode(payload)\n287|        do {\n288|            _ = try await send(\n289|                method: \"PUT\", config: config,\n290|                path: \"orgs/\\(org)/actions/runner-groups/\\(groupID)/repositories\", token: token, body: body\n291|            )\n292|        } catch let error as RunnerRegistration.RegistrationError {\n293|            if case .forbidden(let text) = error {\n294|                throw RunnerRegistration.RegistrationError.missingPermission(\n295|                    permissionHelp(scope: .organization(org: org), detail: text)\n296|                )\n297|            }\n298|            throw error\n299|        }\n300|    }\n301|\n302|    // MARK: - Labels (editable after registration)\n303|\n304|    public func setRunnerLabels(\n305|        config: GitHubAuth.AppConfig,\n306|        token: String,\n307|        scope: RunnerRegistration.Scope,\n308|        runnerID: Int64,\n309|        labels: [String]\n310|    ) async throws {\n311|        let payload = SetLabelsDTO(labels: labels)\n312|        let body = try JSONEncoder().encode(payload)\n313|        do {\n314|            _ = try await send(\n315|                method: \"PUT\", config: config,\n316|                path: \"\\(scope.apiPrefix)/actions/runners/\\(runnerID)/labels\", token: token, body: body\n317|            )\n318|        } catch let error as RunnerRegistration.RegistrationError {\n319|            if case .forbidden(let text) = error {\n320|                throw RunnerRegistration.RegistrationError.missingPermission(writeHelp(scope: scope, detail: text))\n321|            }\n322|            throw error\n323|        }\n324|    }\n325|}\n326|\n327|// MARK: - DTOs\n328|\n329|private struct RunnerDownloadDTO: Decodable, Sendable {\n330|    let osName: String\n331|    let architecture: String\n332|    let downloadURL: String\n333|    let filename: String\n334|    let sha256Checksum: String?\n335|\n336|    private enum CodingKeys: String, CodingKey {\n337|        case osName = \"os\"\n338|        case architecture\n339|        case downloadURL = \"download_url\"\n340|        case filename\n341|        case sha256Checksum = \"sha256_checksum\"\n342|    }\n343|}\n344|\n345|private struct RegistrationTokenDTO: Decodable, Sendable {\n346|    let token: String\n347|    let expiresAt: String?\n348|\n349|    private enum CodingKeys: String, CodingKey {\n350|        case token\n351|        case expiresAt = \"expires_at\"\n352|    }\n353|}\n354|\n355|private struct RunnersListDTO: Decodable, Sendable {\n356|    let runners: [RunnerDTO]\n357|}\n358|\n359|private struct RunnerDTO: Decodable, Sendable {\n360|    let id: Int64\n361|    let name: String\n362|    let labels: [LabelDTO]\n363|}\n364|\n365|private struct LabelDTO: Decodable, Sendable {\n366|    let name: String\n367|}\n368|\n369|private struct RunnerGroupsListDTO: Decodable, Sendable {\n370|    let runnerGroups: [RunnerGroupDTO]\n371|\n372|    private enum CodingKeys: String, CodingKey {\n373|        case runnerGroups = \"runner_groups\"\n374|    }\n375|}\n376|\n377|private struct RunnerGroupDTO: Decodable, Sendable {\n378|    let id: Int64\n379|    let name: String\n380|    let visibility: String\n381|}\n382|\n383|private struct GroupRepositoriesDTO: Decodable, Sendable {\n384|    let repositories: [GroupRepositoryDTO]\n385|}\n386|\n387|private struct GroupRepositoryDTO: Decodable, Sendable {\n388|    let id: Int64\n389|}\n390|\n391|private struct CreateGroupDTO: Encodable, Sendable {\n392|    let name: String\n393|    let visibility: String\n394|    let selectedRepositoryIDs: [Int64]\n395|\n396|    private enum CodingKeys: String, CodingKey {\n397|        case name\n398|        case visibility\n399|        case selectedRepositoryIDs = \"selected_repository_ids\"\n400|    }\n401|}\n402|\n403|private struct SetGroupRepositoriesDTO: Encodable, Sendable {\n404|    let selectedRepositoryIDs: [Int64]\n405|\n406|    private enum CodingKeys: String, CodingKey {\n407|        case selectedRepositoryIDs = \"selected_repository_ids\"\n408|    }\n409|}\n410|\n411|private struct SetLabelsDTO: Encodable, Sendable {\n412|    let labels: [String]\n413|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c563","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":268,"recorded_at":1780531400000531,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"call_id":"call_01a0a87c18b1724094af1f48f45fb4a3","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n1|import CryptoKit\n2|import Foundation\n3|\n4|/// Filesystem installer for downloaded GitHub Actions runners.\n5|///\n6|/// Production path: download bytes → SHA-256 verify → tar extract →\n7|/// `bin/runsvc.sh` copied into the root and chmodded (as official `svc.sh`\n8|/// would) → exact `config.sh` invocation → manual LaunchAgent plist.\n9|/// All side effects stay below `installRoot`; tests inject a temporary root,\n10|/// a fake downloader, and fixtures instead of touching production runners.\n11|public actor RunnerInstallerService {\n12|    public static let markerFileName = \".runnercontrol-install.json\"\n13|    public static let installOS = \"osx\"\n14|\n15|    private let installRoot: URL\n16|    private let downloader: @Sendable (URL) async throws -> Data\n17|    private let executor: any CommandExecuting\n18|    private let currentArch: @Sendable () -> String\n19|    private let hasher: @Sendable (Data) -> String\n20|\n21|    public init(\n22|        installRoot: URL? = nil,\n23|        downloader: (@Sendable (URL) async throws -> Data)? = nil,\n24|        executor: (any CommandExecuting)? = nil,\n25|        currentArch: (@Sendable () -> String)? = nil,\n26|        hasher: (@Sendable (Data) -> String)? = nil\n27|    ) {\n28|        self.installRoot = installRoot\n29|            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/GitHubActions\")\n30|        self.downloader = downloader ?? { url in\n31|            let (data, _) = try await URLSession.shared.data(from: url)\n32|            return data\n33|        }\n34|        self.executor = executor ?? CommandExecutor()\n35|        self.currentArch = currentArch ?? {\n36|            #if arch(arm64)\n37|            return \"arm64\"\n38|            #else\n39|            return \"x64\"\n40|            #endif\n41|        }\n42|        self.hasher = hasher ?? { data in\n43|            SHA256.hash(data: data).map { String(format: \"%02x\", $0) }.joined()\n44|        }\n45|    }\n46|\n47|    public nonisolated var root: URL { installRoot }\n48|    public nonisolated var architecture: String { currentArch() }\n49|\n50|    public func directory(for installDirName: String) -> URL {\n51|        installRoot.appendingPathComponent(installDirName)\n52|    }\n53|\n54|    // MARK: - Idempotency markers\n55|\n56|    public struct Marker: Codable, Sendable, Equatable {\n57|        public var scopeKey: String\n58|        public var completedSteps: Set<String>\n59|        public init(scopeKey: String, completedSteps: Set<String> = []) {\n60|            self.scopeKey = scopeKey; self.completedSteps = completedSteps\n61|        }\n62|    }\n63|\n64|    public static let stepDownloaded = \"downloaded\"\n65|    public static let stepInstalled = \"installed\"\n66|    public static let stepConfigured = \"configured\"\n67|    public static let stepServiceReady = \"serviceReady\"\n68|\n69|    public func loadMarker(directory: URL) -> Marker? {\n70|        let url = directory.appendingPathComponent(Self.markerFileName)\n71|        guard let data = try? Data(contentsOf: url) else { return nil }\n72|        return try? JSONDecoder().decode(Marker.self, from: data)\n73|    }\n74|\n75|    private func storeMarker(_ marker: Marker, directory: URL) throws {\n76|        let data = try JSONEncoder().encode(marker)\n77|        try data.write(to: directory.appendingPathComponent(Self.markerFileName), options: .atomic)\n78|    }\n79|\n80|    public func markCompleted(_ step: String, directory: URL, scopeKey: String) throws {\n81|        var marker = loadMarker(directory: directory) ?? Marker(scopeKey: scopeKey)\n82|        marker.completedSteps.insert(step)\n83|        try storeMarker(marker, directory: directory)\n84|    }\n85|\n86|    public func hasCompleted(_ step: String, directory: URL) -> Bool {\n87|        loadMarker(directory: directory)?.completedSteps.contains(step) == true\n88|    }\n89|\n90|    // MARK: - Install\n91|\n92|    /// Downloads, verifies, and extracts the official package. Idempotent:\n93|    /// a completed `installed` marker with matching scope skips the work.\n94|    /// Refuses to overwrite an already-registered directory (no duplicates).\n95|    public func downloadAndInstall(\n96|        asset: RunnerRegistration.DownloadAsset,\n97|        draft: RunnerRegistration.Draft\n98|    ) async throws -> URL {\n99|        try RunnerRegistration.Gates.validateNoSpace(\n100|            installDirName: draft.installDirName, workFolder: draft.workFolder\n101|        )\n102|        let directory = self.directory(for: draft.installDirName)\n103|        if directory.path.contains(\" \") {\n104|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n105|        }\n106|        let files = FileManager.default\n107|        if let marker = loadMarker(directory: directory),\n108|           marker.completedSteps.contains(Self.stepInstalled),\n109|           marker.scopeKey == draft.scope.scopeKey,\n110|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n111|            return directory\n112|        }\n113|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n114|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: draft.runnerName)\n115|        }\n116|        let bytes: Data\n117|        do {\n118|            bytes = try await downloader(asset.downloadURL)\n119|        } catch {\n120|            throw RunnerRegistration.RegistrationError.network(\"Runner download failed: \\(error.localizedDescription)\")\n121|        }\n122|        if let expected = asset.sha256Checksum, !expected.isEmpty {\n123|            let actual = hasher(bytes)\n124|            guard actual.lowercased() == expected.lowercased() else {\n125|                throw RunnerRegistration.RegistrationError.integrityMismatch\n126|            }\n127|        }\n128|        try files.createDirectory(at: directory, withIntermediateDirectories: true)\n129|        let archive = files.temporaryDirectory.appendingPathComponent(UUID().uuidString + \"-\" + asset.filename)\n130|        defer { try? files.removeItem(at: archive) }\n131|        try bytes.write(to: archive, options: .atomic)\n132|        let result = try await executor.run(\"/usr/bin/tar\", [\"-xzf\", archive.path, \"-C\", directory.path])\n133|        guard result.code == 0 else {\n134|            throw RunnerRegistration.RegistrationError.network(\n135|                \"Runner archive extraction failed: \\(String(result.output.prefix(300)))\"\n136|            )\n137|        }\n138|        // Official packages keep runsvc.sh under bin/ until svc.sh installs it;\n139|        // a bare extraction leaves the root copy absent, so install it here.\n140|        try installRunsvc(directory: directory)\n141|        try markCompleted(Self.stepDownloaded, directory: directory, scopeKey: draft.scope.scopeKey)\n142|        try markCompleted(Self.stepInstalled, directory: directory, scopeKey: draft.scope.scopeKey)\n143|        return directory\n144|    }\n145|\n146|    /// Copies official `bin/runsvc.sh` into the installation root and makes\n147|    /// it executable, mirroring what official `svc.sh install` would do.\n148|    public func installRunsvc(directory: URL) throws {\n149|        let files = FileManager.default\n150|        let source = directory.appendingPathComponent(\"bin/runsvc.sh\")\n151|        let target = directory.appendingPathComponent(\"runsvc.sh\")\n152|        guard files.fileExists(atPath: source.path) else {\n153|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing bin/runsvc.sh.\")\n154|        }\n155|        if files.fileExists(atPath: target.path) {\n156|            try files.removeItem(at: target)\n157|        }\n158|        try files.copyItem(at: source, to: target)\n159|        try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: target.path)\n160|    }\n161|\n162|    // MARK: - Configure\n163|\n164|    /// Runs the exact `config.sh` invocation. Skips when a previous attempt\n165|    /// already registered this directory (marker + `.runner` present), so\n166|    /// retries never create orphan or duplicate GitHub registrations.\n167|    /// Returns the local agent ID read back from `.runner`.\n168|    @discardableResult\n169|    public func runConfig(\n170|        directory: URL,\n171|        scopeURL: String,\n172|        token: String,\n173|        draft: RunnerRegistration.Draft,\n174|        runnerGroup: String?\n175|    ) async throws -> Int64? {\n176|        let files = FileManager.default\n177|        if hasCompleted(Self.stepConfigured, directory: directory),\n178|           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n179|            return readAgentID(directory: directory)\n180|        }\n181|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n182|           hasCompleted(Self.stepConfigured, directory: directory) {\n183|            return readAgentID(directory: directory)\n184|        }\n185|        let spec = RunnerRegistration.ConfigSpec(\n186|            scopeURL: scopeURL, token: token, name: draft.runnerName,\n187|            workFolder: draft.workFolder, labels: draft.labels, runnerGroup: runnerGroup\n188|        )\n189|        let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n190|        let executable = directory.appendingPathComponent(\"config.sh\").path\n191|        guard files.fileExists(atPath: executable) else {\n192|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n193|        }\n194|        let result = try await executor.run(executable, args)\n195|        guard result.code == 0 else {\n196|            // Never echo the token: config output may repeat arguments.\n197|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [token])\n198|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n199|        }\n200|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n201|            throw RunnerRegistration.RegistrationError.configFailed(\n202|                \"config.sh reported success but .runner is missing.\"\n203|            )\n204|        }\n205|        try markCompleted(Self.stepConfigured, directory: directory, scopeKey: draft.scope.scopeKey)\n206|        return readAgentID(directory: directory)\n207|    }\n208|\n209|    /// Reads the local agent ID from `.runner` without touching credentials.\n210|    public func readAgentID(directory: URL) -> Int64? {\n211|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n212|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n213|        if let id = object[\"agentId\"] as? Int64 { return id }\n214|        if let id = object[\"agentId\"] as? Int { return Int64(id) }\n215|        if let id = object[\"agentId\"] as? NSNumber { return id.int64Value }\n216|        return nil\n217|    }\n218|\n219|    // MARK: - Manual LaunchAgent\n220|\n221|    /// Writes the manual service plist (RunAtLoad off for new runners) and\n222|    /// validates it matches the directory. Never bootstraps the service:\n223|    /// enabling is the user's separate action.\n224|    @discardableResult\n225|    public func setupService(directory: URL, label: String) throws -> URL {\n226|        guard !directory.path.contains(\" \") else {\n227|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n228|        }\n229|        let files = FileManager.default\n230|        guard files.fileExists(atPath: directory.appendingPathComponent(\"runsvc.sh\").path) else {\n231|            throw RunnerRegistration.RegistrationError.network(\n232|                \"runsvc.sh is missing; reinstall before setting up the service.\"\n233|            )\n234|        }\n235|        let plist = directory.appendingPathComponent(\"manual-service.plist\")\n236|        let payload: [String: Any] = [\n237|            \"Label\": label,\n238|            \"ProgramArguments\": [directory.appendingPathComponent(\"runsvc.sh\").path],\n239|            \"WorkingDirectory\": directory.path,\n240|            \"RunAtLoad\": false\n241|        ]\n242|        let data = try PropertyListSerialization.data(fromPropertyList: payload, format: .xml, options: 0)\n243|        try data.write(to: plist, options: .atomic)\n244|        let scopeKey = loadMarker(directory: directory)?.scopeKey ?? \"\"\n245|        try markCompleted(Self.stepServiceReady, directory: directory, scopeKey: scopeKey)\n246|        return plist\n247|    }\n248|\n249|    /// Removes a failed partial install so retries start clean. Refuses to\n250|    /// touch directories that already hold a registration (`.runner`) or an\n251|    /// unknown marker scope: recovery never deletes a working runner.\n252|    public func recoverPartialInstall(directory: URL, scopeKey: String) throws {\n253|        let files = FileManager.default\n254|        guard files.fileExists(atPath: directory.path) else { return }\n255|        guard !files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n256|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: directory.lastPathComponent)\n257|        }\n258|        if let marker = loadMarker(directory: directory), marker.scopeKey != scopeKey {\n259|            throw RunnerRegistration.RegistrationError.alreadyInstalled(path: directory.path)\n260|        }\n261|        try files.removeItem(at: directory)\n262|    }\n263|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c565","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":269,"recorded_at":1780531400000533,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"call_id":"call_01a0a87c1a06741398d86674a40e5c85","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistrationTokenStore.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Short-lived registration token. Lives in Keychain + Flow actor\n5|    /// privates only; never enters Relux state, logs, or diagnostics.\n6|    public struct ScopedToken: Sendable, Equatable, Codable {\n7|        public let token: String\n8|        public let expiresAt: Date?\n9|        public let obtainedAt: Date\n10|        public init(token: String, expiresAt: Date?, obtainedAt: Date = Date()) {\n11|            self.token = token; self.expiresAt = expiresAt; self.obtainedAt = obtainedAt\n12|        }\n13|        public var isExpired: Bool {\n14|            guard let expiresAt else { return false }\n15|            return expiresAt <= Date()\n16|        }\n17|    }\n18|}\n19|\n20|/// Keychain boundary for scoped short-lived registration tokens.\n21|public protocol RunnerRegistrationTokenStoring: Sendable {\n22|    func save(_ token: RunnerRegistration.ScopedToken, scopeKey: String) async throws\n23|    func load(scopeKey: String) async -> RunnerRegistration.ScopedToken?\n24|    func delete(scopeKey: String) async\n25|}\n26|\n27|public actor RunnerRegistrationTokenStore: RunnerRegistrationTokenStoring {\n28|    private let backend: any KeychainBackend\n29|    private let service: String\n30|\n31|    public init(\n32|        service: String = \"works.relux.runnercontrol.runner-registration-token\",\n33|        backend: (any KeychainBackend)? = nil\n34|    ) {\n35|        self.service = service\n36|        self.backend = backend ?? SecurityKeychainBackend()\n37|    }\n38|\n39|    public func save(_ token: RunnerRegistration.ScopedToken, scopeKey: String) async throws {\n40|        let data = try JSONEncoder().encode(token)\n41|        try backend.save(data, service: service, account: scopeKey)\n42|    }\n43|\n44|    public func load(scopeKey: String) async -> RunnerRegistration.ScopedToken? {\n45|        guard let data = backend.load(service: service, account: scopeKey) else { return nil }\n46|        guard let decoded = try? JSONDecoder().decode(RunnerRegistration.ScopedToken.self, from: data) else {\n47|            return nil\n48|        }\n49|        if decoded.isExpired {\n50|            backend.delete(service: service, account: scopeKey)\n51|            return nil\n52|        }\n53|        return decoded\n54|    }\n55|\n56|    public func delete(scopeKey: String) async {\n57|        backend.delete(service: service, account: scopeKey)\n58|    }\n59|}\n60|\n61|/// In-memory registration-token backend for unit tests. Never used in production.\n62|public final class InMemoryRegistrationTokenBackend: KeychainBackend, @unchecked Sendable {\n63|    private let lock = NSLock()\n64|    private var storage: [String: Data] = [:]\n65|    public init() {}\n66|    private func key(service: String, account: String) -> String { \"\\(service)\\u{0}\\(account)\" }\n67|    public func save(_ data: Data, service: String, account: String) throws {\n68|        lock.withLock { storage[key(service: service, account: account)] = data }\n69|    }\n70|    public func load(service: String, account: String) -> Data? {\n71|        lock.withLock { storage[key(service: service, account: account)] }\n72|    }\n73|    public func delete(service: String, account: String) {\n74|        lock.withLock { _ = storage.removeValue(forKey: key(service: service, account: account)) }\n75|    }\n76|    public func deleteMatching(service: String, accountPrefix: String, accountSuffix: String) {\n77|        lock.withLock {\n78|            let prefix = \"\\(service)\\u{0}\\(accountPrefix)\"\n79|            let doomed = storage.keys.filter { $0.hasPrefix(prefix) && $0.hasSuffix(accountSuffix) }\n80|            for key in doomed {\n81|                storage.removeValue(forKey: key)\n82|            }\n83|        }\n84|    }\n85|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
