{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f3","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":212,"recorded_at":1780531400000419,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"call_id":"call_01a0a87bfe6b77aea29201d5b9c01c15","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Models.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Registration scope. One wizard run registers exactly one scope:\n5|    /// an organization (shared, via a dedicated per-Mac group) or a single\n6|    /// personal repository (separate installation, no group).\n7|    public enum Scope: Sendable, Equatable, Hashable {\n8|        case organization(org: String)\n9|        case repository(owner: String, name: String)\n10|\n11|        /// REST path prefix below the API base URL, e.g. `orgs/acme` or `repos/acme/app`.\n12|        public var apiPrefix: String {\n13|            switch self {\n14|            case .organization(let org): \"orgs/\\(org)\"\n15|            case .repository(let owner, let name): \"repos/\\(owner)/\\(name)\"\n16|            }\n17|        }\n18|\n19|        /// Short key for token-store accounts and markers. Never contains secrets.\n20|        public var scopeKey: String {\n21|            switch self {\n22|            case .organization(let org): \"org:\\(org)\"\n23|            case .repository(let owner, let name): \"repo:\\(owner)/\\(name)\"\n24|            }\n25|        }\n26|\n27|        /// URL passed to `config.sh --url`. Enterprise hosts keep their own server.\n28|        public func configURL(serverHost: String) -> String {\n29|            let host = serverHost == \"github.com\" || serverHost == \"www.github.com\"\n30|                ? \"https://github.com\"\n31|                : \"https://\\(serverHost)\"\n32|            switch self {\n33|            case .organization(let org): return \"\\(host)/\\(org)\"\n34|            case .repository(let owner, let name): return \"\\(host)/\\(owner)/\\(name)\"\n35|            }\n36|        }\n37|\n38|        /// Detail line shown in UI, e.g. `acme` or `acme/app`.\n39|        public var detail: String {\n40|            switch self {\n41|            case .organization(let org): org\n42|            case .repository(let owner, let name): \"\\(owner)/\\(name)\"\n43|            }\n44|        }\n45|    }\n46|\n47|    /// User-editable wizard input. Holds no tokens.\n48|    public struct Draft: Sendable, Equatable {\n49|        public var scope: Scope\n50|        public var runnerName: String\n51|        public var labels: [String]\n52|        public var installDirName: String\n53|        public var workFolder: String\n54|        /// Dedicated per-Mac group name for org scope. Ignored for repo scope.\n55|        public var groupName: String\n56|        public var selectedRepositoryIDs: Set<Int64>\n57|        /// Explicit UI scope: user confirmed that group mutations apply only\n58|        /// to the resolved dedicated group. Never implied.\n59|        public var allowGroupMutation: Bool\n60|\n61|        public init(\n62|            scope: Scope,\n63|            runnerName: String,\n64|            labels: [String] = [\"self-hosted\", \"macOS\"],\n65|            installDirName: String,\n66|            workFolder: String = \"_work\",\n67|            groupName: String = \"\",\n68|            selectedRepositoryIDs: Set<Int64> = [],\n69|            allowGroupMutation: Bool = false\n70|        ) {\n71|            self.scope = scope\n72|            self.runnerName = runnerName\n73|            self.labels = labels\n74|            self.installDirName = installDirName\n75|            self.workFolder = workFolder\n76|            self.groupName = groupName\n77|            self.selectedRepositoryIDs = selectedRepositoryIDs\n78|            self.allowGroupMutation = allowGroupMutation\n79|        }\n80|\n81|        /// Default per-Mac group name derived from the Mac name.\n82|        public static func defaultGroupName(hostName: String) -> String {\n83|            let trimmed = hostName.trimmingCharacters(in: .whitespacesAndNewlines)\n84|            let base = trimmed.isEmpty ? \"Mac\" : trimmed\n85|            return \"RunnerControl-\\(base)\"\n86|        }\n87|    }\n88|\n89|    /// Official runner download asset as returned by the downloads endpoint.\n90|    public struct DownloadAsset: Sendable, Equatable {\n91|        public let osName: String\n92|        public let architecture: String\n93|        public let downloadURL: URL\n94|        public let filename: String\n95|        public let sha256Checksum: String?\n96|        public init(osName: String, architecture: String, downloadURL: URL, filename: String, sha256Checksum: String?) {\n97|            self.osName = osName; self.architecture = architecture\n98|            self.downloadURL = downloadURL; self.filename = filename\n99|            self.sha256Checksum = sha256Checksum\n100|        }\n101|    }\n102|\n103|    /// Runner group summary. Repository access is fetched separately.\n104|    public struct RunnerGroup: Sendable, Equatable {\n105|        public let id: Int64\n106|        public let name: String\n107|        public let visibility: String\n108|        public init(id: Int64, name: String, visibility: String) {\n109|            self.id = id; self.name = name; self.visibility = visibility\n110|        }\n111|    }\n112|\n113|    /// Registered runner identity fetched from GitHub after config.\n114|    public struct RegisteredRunner: Sendable, Equatable {\n115|        public let id: Int64\n116|        public let name: String\n117|        public let labels: [String]\n118|        public init(id: Int64, name: String, labels: [String]) {\n119|            self.id = id; self.name = name; self.labels = labels\n120|        }\n121|    }\n122|}\n123|\n124|extension RunnerRegistration {\n125|    public enum RegistrationError: LocalizedError, Sendable, Equatable {\n126|        case notAuthenticated\n127|        case missingPermission(String)\n128|        case invalidDraft(String)\n129|        case noSpacePath(String)\n130|        case downloadMismatch(osName: String, arch: String)\n131|        case integrityMismatch\n132|        case groupScopeNotConfirmed\n133|        case refusesSharedGroup(groupID: Int64)\n134|        case groupNotApplicable\n135|        case alreadyInstalled(path: String)\n136|        case alreadyRegistered(name: String)\n137|        case network(String)\n138|        case unauthorized\n139|        case forbidden(String)\n140|        case rateLimited\n141|        case configFailed(String)\n142|        case cancelled\n143|\n144|        public var errorDescription: String? {\n145|            switch self {\n146|            case .notAuthenticated:\n147|                \"Sign in with GitHub first. Registration needs an authenticated session.\"\n148|            case .missingPermission(let text):\n149|                text.isEmpty ? \"Missing GitHub permission for this step.\" : text\n150|            case .invalidDraft(let text):\n151|                text\n152|            case .noSpacePath(let text):\n153|                text\n154|            case .downloadMismatch(let osName, let arch):\n155|                \"No official runner package for os=\\(osName) arch=\\(arch). Refusing substitute builds.\"\n156|            case .integrityMismatch:\n157|                \"Download integrity check failed (SHA-256 mismatch). Refusing to install.\"\n158|            case .groupScopeNotConfirmed:\n159|                \"Repository access changes need explicit confirmation for the dedicated group.\"\n160|            case .refusesSharedGroup(let groupID):\n161|                \"Refusing to change group \\(groupID): it is not this Mac's dedicated group.\"\n162|            case .groupNotApplicable:\n163|                \"Runner groups apply to organization runners only. Repository runners use separate installations.\"\n164|            case .alreadyInstalled(let path):\n165|                \"Installation already exists at \\(path). Resume or remove it before retrying.\"\n166|            case .alreadyRegistered(let name):\n167|                \"Runner '\\(name)' is already registered here. Reuse it instead of creating a duplicate.\"\n168|            case .network(let text):\n169|                text\n170|            case .unauthorized:\n171|                \"Session expired or revoked (401). Sign in again.\"\n172|            case .forbidden(let text):\n173|                text.isEmpty ? \"Access forbidden (403).\" : text\n174|            case .rateLimited:\n175|                \"GitHub rate limit reached. Retry later; local runners keep working.\"\n176|            case .configFailed(let text):\n177|                text.isEmpty ? \"Runner configuration failed.\" : text\n178|            case .cancelled:\n179|                \"Registration cancelled.\"\n180|            }\n181|        }\n182|    }\n183|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f5","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":213,"recorded_at":1780531400000421,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"call_id":"call_01a0a87bff98760b83d9d7f2b80e48bb","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+State.swift`.\n1|import Combine\n2|import Foundation\n3|import Relux\n4|\n5|extension RunnerRegistration {\n6|    /// Wizard phases. Holds IDs, paths, and errors — never tokens.\n7|    public enum Phase: Sendable, Equatable {\n8|        case idle\n9|        case drafting\n10|        case resolvingGroup\n11|        case preparingDownload\n12|        case installing\n13|        case registering\n14|        case settingUpService\n15|        case done\n16|    }\n17|\n18|    @MainActor public final class State: ObservableObject, Relux.HybridState {\n19|        @Published public internal(set) var phase: Phase = .idle\n20|        @Published public internal(set) var draft: Draft?\n21|        @Published public internal(set) var working: Bool = false\n22|        @Published public internal(set) var group: RunnerGroup?\n23|        @Published public internal(set) var groupRepositoryIDs: [Int64] = []\n24|        @Published public internal(set) var asset: DownloadAsset?\n25|        @Published public internal(set) var installPath: String?\n26|        @Published public internal(set) var runnerID: Int64?\n27|        @Published public internal(set) var localAgentID: Int64?\n28|        @Published public internal(set) var completedSteps: Set<String> = []\n29|        @Published public internal(set) var error: String?\n30|        @Published public internal(set) var failedStep: String?\n31|        /// Retained permission errors (403/missing rights). Draft edits never\n32|        /// clear them; only an explicit retry, reset, or dismiss does.\n33|        @Published public internal(set) var permissionError: String?\n34|\n35|        public init() {}\n36|\n37|        public func cleanup() async {\n38|            phase = .idle\n39|            draft = nil\n40|            working = false\n41|            group = nil\n42|            groupRepositoryIDs = []\n43|            asset = nil\n44|            installPath = nil\n45|            runnerID = nil\n46|            localAgentID = nil\n47|            completedSteps = []\n48|            error = nil\n49|            failedStep = nil\n50|            permissionError = nil\n51|        }\n52|    }\n53|\n54|    public enum Action: Relux.Action {\n55|        case draftBegan(Draft)\n56|        case draftUpdated(Draft)\n57|        case stepStarted(String)\n58|        case stepFinished(String)\n59|        case groupResolved(RunnerGroup, repositoryIDs: [Int64])\n60|        case downloadReady(DownloadAsset)\n61|        case installed(path: String)\n62|        case registered(runnerID: Int64?, localAgentID: Int64?)\n63|        case serviceReady(plistPath: String)\n64|        case repositoryAccessApplied([Int64])\n65|        case labelsApplied([String])\n66|        case failed(message: String, step: String)\n67|        case permissionDenied(message: String, step: String)\n68|        case permissionDismissed\n69|        case cancelled\n70|        case didReset\n71|    }\n72|\n73|    public enum Effect: Relux.Effect {\n74|        case beginDraft(Draft)\n75|        case updateDraft(Draft)\n76|        case resolveGroup\n77|        case prepareDownload\n78|        case downloadAndInstall\n79|        case registerRunner\n80|        case setupService\n81|        case applyRepositoryAccess(groupID: Int64, repositories: Set<Int64>)\n82|        case applyLabels([String])\n83|        case retry\n84|        case cancel\n85|        case reset\n86|        case dismissPermission\n87|    }\n88|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f7","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":214,"recorded_at":1780531400000423,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"call_id":"call_01a0a87c00e875dead2a3911f2d5c76d","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+State+Reducer.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension RunnerRegistration.State {\n5|    public func reduce(with action: any Relux.Action) async {\n6|        guard let action = action as? RunnerRegistration.Action else { return }\n7|        if reduceDraftAction(action) { return }\n8|        if reduceProgressAction(action) { return }\n9|        await reduceResultAction(action)\n10|    }\n11|\n12|    /// Draft lifecycle actions. Returns true when the action was handled.\n13|    private func reduceDraftAction(_ action: RunnerRegistration.Action) -> Bool {\n14|        switch action {\n15|        case .draftBegan(let draft):\n16|            self.draft = draft\n17|            phase = .drafting\n18|            error = nil\n19|            failedStep = nil\n20|        case .draftUpdated(let draft):\n21|            self.draft = draft\n22|            // Draft edits retain the permission error by design.\n23|            if error != nil, permissionError == nil {\n24|                error = nil\n25|                failedStep = nil\n26|            }\n27|        case .cancelled:\n28|            working = false\n29|            error = nil\n30|            failedStep = nil\n31|        default:\n32|            return false\n33|        }\n34|        return true\n35|    }\n36|\n37|    /// Step progress actions. Returns true when the action was handled.\n38|    private func reduceProgressAction(_ action: RunnerRegistration.Action) -> Bool {\n39|        switch action {\n40|        case .stepStarted(let step):\n41|            working = true\n42|            error = nil\n43|            failedStep = nil\n44|            reducePhase(step)\n45|        case .stepFinished(let step):\n46|            working = false\n47|            completedSteps.insert(step)\n48|        case .permissionDismissed:\n49|            permissionError = nil\n50|        default:\n51|            return false\n52|        }\n53|        return true\n54|    }\n55|\n56|    private func reducePhase(_ step: String) {\n57|        switch step {\n58|        case \"resolveGroup\": phase = .resolvingGroup\n59|        case \"prepareDownload\": phase = .preparingDownload\n60|        case \"downloadAndInstall\": phase = .installing\n61|        case \"registerRunner\": phase = .registering\n62|        case \"setupService\": phase = .settingUpService\n63|        default: break\n64|        }\n65|    }\n66|\n67|    /// Fetched results, failures, and reset.\n68|    private func reduceResultAction(_ action: RunnerRegistration.Action) async {\n69|        if reduceFetchResult(action) { return }\n70|        switch action {\n71|        case .failed(let message, let step):\n72|            working = false\n73|            error = message\n74|            failedStep = step\n75|        case .permissionDenied(let message, let step):\n76|            working = false\n77|            error = message\n78|            failedStep = step\n79|            permissionError = message\n80|        case .didReset:\n81|            await cleanup()\n82|        default:\n83|            break\n84|        }\n85|    }\n86|\n87|    /// Fetched values applied to state. Returns true when handled.\n88|    private func reduceFetchResult(_ action: RunnerRegistration.Action) -> Bool {\n89|        switch action {\n90|        case .groupResolved(let group, let repositoryIDs):\n91|            self.group = group\n92|            groupRepositoryIDs = repositoryIDs\n93|        case .downloadReady(let asset):\n94|            self.asset = asset\n95|        case .installed(let path):\n96|            installPath = path\n97|        case .registered(let runnerID, let localAgentID):\n98|            self.runnerID = runnerID\n99|            self.localAgentID = localAgentID\n100|        case .serviceReady:\n101|            phase = .done\n102|        case .repositoryAccessApplied(let ids):\n103|            groupRepositoryIDs = ids\n104|            syncDraftRepositories(ids)\n105|        case .labelsApplied(let labels):\n106|            syncDraftLabels(labels)\n107|        default:\n108|            return false\n109|        }\n110|        return true\n111|    }\n112|\n113|    private func syncDraftRepositories(_ ids: [Int64]) {\n114|        if var current = draft {\n115|            current.selectedRepositoryIDs = Set(ids)\n116|            draft = current\n117|        }\n118|    }\n119|\n120|    private func syncDraftLabels(_ labels: [String]) {\n121|        if var current = draft {\n122|            current.labels = labels\n123|            draft = current\n124|        }\n125|    }\n126|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f9","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":215,"recorded_at":1780531400000425,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"call_id":"call_01a0a87c01f271c2b8a26d2c40fa5a89","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Gates.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Validation gates. Each gate refuses a concrete invalid class; negative\n5|    /// tests narrow every one of them.\n6|    public enum Gates {\n7|        /// Refuses install/work paths containing spaces. GitHub's own setup has\n8|        /// a known defect with spaced paths; the wizard never reproduces it.\n9|        public static func validateNoSpace(installDirName: String, workFolder: String) throws {\n10|            if installDirName.contains(\" \") {\n11|                throw RegistrationError.noSpacePath(\"Installation folder name must not contain spaces.\")\n12|            }\n13|            if installDirName.contains(\"/\") || installDirName.isEmpty {\n14|                throw RegistrationError.invalidDraft(\"Installation folder name is invalid.\")\n15|            }\n16|            if workFolder.contains(\" \") {\n17|                throw RegistrationError.noSpacePath(\"Work folder must not contain spaces.\")\n18|            }\n19|            if workFolder.isEmpty || workFolder.contains(\"/\") {\n20|                throw RegistrationError.invalidDraft(\"Work folder name is invalid.\")\n21|            }\n22|        }\n23|\n24|        /// Validates the full draft before any network or filesystem mutation.\n25|        public static func validateDraft(_ draft: Draft) throws {\n26|            let name = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n27|            guard !name.isEmpty else {\n28|                throw RegistrationError.invalidDraft(\"Runner name must not be empty.\")\n29|            }\n30|            guard name.count <= 64 else {\n31|                throw RegistrationError.invalidDraft(\"Runner name is too long (max 64 characters).\")\n32|            }\n33|            let labels = draft.labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }\n34|            guard !labels.isEmpty else {\n35|                throw RegistrationError.invalidDraft(\"At least one label is required.\")\n36|            }\n37|            for label in labels {\n38|                guard !label.isEmpty else {\n39|                    throw RegistrationError.invalidDraft(\"Labels must not be empty.\")\n40|                }\n41|                guard label.count <= 100 else {\n42|                    throw RegistrationError.invalidDraft(\"Label '\\(label)' is too long (max 100 characters).\")\n43|                }\n44|            }\n45|            try validateNoSpace(installDirName: draft.installDirName, workFolder: draft.workFolder)\n46|            switch draft.scope {\n47|            case .organization:\n48|                let group = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n49|                guard !group.isEmpty else {\n50|                    throw RegistrationError.invalidDraft(\"Organization runners need a dedicated per-Mac group name.\")\n51|                }\n52|            case .repository:\n53|                break\n54|            }\n55|        }\n56|\n57|        /// Picks the architecture-matched official asset. Refuses any\n58|        /// substitute: both OS and architecture must match exactly.\n59|        public static func selectDownload(\n60|            osName: String, arch: String, from assets: [DownloadAsset]\n61|        ) throws -> DownloadAsset {\n62|            guard let match = assets.first(where: { $0.osName == osName && $0.architecture == arch }) else {\n63|                throw RegistrationError.downloadMismatch(osName: osName, arch: arch)\n64|            }\n65|            return match\n66|        }\n67|\n68|        /// Authorizes a group mutation only when the UI explicitly scoped it\n69|        /// AND the target is this run's resolved dedicated group. Never\n70|        /// mutates unrelated or shared groups.\n71|        public static func authorizeGroupMutation(\n72|            targetGroupID: Int64, resolvedGroupID: Int64?, allowFlag: Bool\n73|        ) throws {\n74|            guard allowFlag else { throw RegistrationError.groupScopeNotConfirmed }\n75|            guard let resolved = resolvedGroupID, resolved == targetGroupID else {\n76|                throw RegistrationError.refusesSharedGroup(groupID: targetGroupID)\n77|            }\n78|        }\n79|\n80|        /// Repository scope never touches groups: personal repos get separate\n81|        /// installations without shared-group coupling.\n82|        public static func requireOrganizationScope(_ scope: Scope) throws {\n83|            if case .organization = scope { return }\n84|            throw RegistrationError.groupNotApplicable\n85|        }\n86|    }\n87|\n88|    /// Exact `config.sh` invocation inputs.\n89|    public struct ConfigSpec: Sendable, Equatable {\n90|        let scopeURL: String\n91|        let token: String\n92|        let name: String\n93|        let workFolder: String\n94|        let labels: [String]\n95|        let runnerGroup: String?\n96|    }\n97|\n98|    /// Exact `config.sh` invocation builder. Argument order is fixed and\n99|    /// covered by tests; production runs this exact array.\n100|    public enum ConfigInvocation {\n101|        public static func arguments(_ spec: ConfigSpec) -> [String] {\n102|            var args = [\n103|                \"--url\", spec.scopeURL,\n104|                \"--token\", spec.token,\n105|                \"--name\", spec.name,\n106|                \"--work\", spec.workFolder,\n107|                \"--labels\", spec.labels.joined(separator: \",\")\n108|            ]\n109|            if let group = spec.runnerGroup, !group.isEmpty {\n110|                args += [\"--runnergroup\", group]\n111|            }\n112|            args += [\"--unattended\", \"--replace\"]\n113|            return args\n114|        }\n115|    }\n116|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4fb","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":216,"recorded_at":1780531400000427,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"call_id":"call_01a0a87c031d748bba3737cebe43b428","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension RunnerRegistration {\n5|    public protocol IFlow: Relux.Flow {}\n6|\n7|    public actor Flow {\n8|        public let dispatcher: Relux.Dispatcher\n9|        private let api: GitHubRunnerAPIClient\n10|        private let installer: RunnerInstallerService\n11|        private let registrationTokens: any RunnerRegistrationTokenStoring\n12|        private let userStore: any GitHubCredentialStoring\n13|        private let identities: any GitHubSessionIdentityStoring\n14|        private let refresher: GitHubTokenRefresh\n15|        private let configProvider: @Sendable (String?) throws -> GitHubAuth.AppConfig\n16|        private let now: @Sendable () -> Date\n17|\n18|        private var generation = 0\n19|        private var working = false\n20|        private var draft: Draft?\n21|        private var group: RunnerGroup?\n22|        private var asset: DownloadAsset?\n23|        private var installPath: String?\n24|        private var runnerID: Int64?\n25|        private var failedStep: String?\n26|        private var pendingRepositoryIDs: Set<Int64>?\n27|        private var pendingTargetGroupID: Int64?\n28|        private var pendingLabels: [String]?\n29|\n30|        public init(\n31|            api: GitHubRunnerAPIClient,\n32|            installer: RunnerInstallerService,\n33|            registrationTokens: any RunnerRegistrationTokenStoring,\n34|            userStore: any GitHubCredentialStoring,\n35|            identityStore: any GitHubSessionIdentityStoring,\n36|            refresher: GitHubTokenRefresh,\n37|            configProvider: (@Sendable (String?) throws -> GitHubAuth.AppConfig)? = nil,\n38|            now: (@Sendable () -> Date)? = nil,\n39|            dispatcher: Relux.Dispatcher? = nil\n40|        ) async {\n41|            self.api = api\n42|            self.installer = installer\n43|            self.registrationTokens = registrationTokens\n44|            self.userStore = userStore\n45|            self.identities = identityStore\n46|            self.refresher = refresher\n47|            self.configProvider = configProvider ?? { host in\n48|                try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\")\n49|            }\n50|            self.now = now ?? Date.init\n51|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n52|        }\n53|\n54|        /// Deterministic LaunchAgent label for a draft. Always carries the\n55|        /// `actions.runner.` prefix discovery requires.\n56|        public nonisolated static func serviceLabel(draft: Draft) -> String {\n57|            let scope = draft.scope.detail.replacingOccurrences(of: \"/\", with: \"-\")\n58|            let raw = \"actions.runner.\\(scope).\\(draft.installDirName)\"\n59|            let allowed = CharacterSet.alphanumerics.union(CharacterSet(charactersIn: \".-\"))\n60|            return raw.unicodeScalars.map { allowed.contains($0) ? String($0) : \"-\" }.joined()\n61|        }\n62|\n63|        public nonisolated static func tokenScopeKey(draft: Draft) -> String {\n64|            \"\\(draft.scope.scopeKey):\\(draft.installDirName)\"\n65|        }\n66|    }\n67|}\n68|\n69|/// Authenticated user token for wizard API calls. Never logged.\n70|private struct FlowUserToken: Sendable {\n71|    let config: GitHubAuth.AppConfig\n72|    let token: String\n73|    let identity: GitHubSessionIdentity\n74|}\n75|\n76|extension RunnerRegistration.Flow: RunnerRegistration.IFlow {\n77|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n78|        guard let effect = effect as? RunnerRegistration.Effect else { return .success }\n79|        switch effect {\n80|        case .beginDraft(let draft): await beginDraft(draft)\n81|        case .updateDraft(let draft): await updateDraft(draft)\n82|        case .resolveGroup: await resolveGroup()\n83|        case .prepareDownload: await prepareDownload()\n84|        case .downloadAndInstall: await downloadAndInstall()\n85|        case .registerRunner: await registerRunner()\n86|        case .setupService: await setupService()\n87|        case .applyRepositoryAccess(let groupID, let ids): await applyRepositoryAccess(groupID: groupID, ids: ids)\n88|        case .applyLabels(let labels): await applyLabels(labels)\n89|        case .retry: await retry()\n90|        case .cancel: await cancel()\n91|        case .reset: await reset()\n92|        case .dismissPermission: await action { RunnerRegistration.Action.permissionDismissed }\n93|        }\n94|        return .success\n95|    }\n96|\n97|    private func isStale(_ gen: Int) -> Bool { generation != gen }\n98|\n99|    // MARK: - Draft\n100|\n101|    private func beginDraft(_ draft: RunnerRegistration.Draft) async {\n102|        do {\n103|            try RunnerRegistration.Gates.validateDraft(draft)\n104|        } catch {\n105|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"beginDraft\") }\n106|            return\n107|        }\n108|        self.draft = draft\n109|        group = nil\n110|        asset = nil\n111|        installPath = nil\n112|        runnerID = nil\n113|        failedStep = nil\n114|        await action { RunnerRegistration.Action.draftBegan(draft) }\n115|    }\n116|\n117|    private func updateDraft(_ draft: RunnerRegistration.Draft) async {\n118|        do {\n119|            try RunnerRegistration.Gates.validateDraft(draft)\n120|        } catch {\n121|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"updateDraft\") }\n122|            return\n123|        }\n124|        // A scope change invalidates resolved group/download state.\n125|        if self.draft?.scope != draft.scope {\n126|            group = nil\n127|            asset = nil\n128|        }\n129|        self.draft = draft\n130|        await action { RunnerRegistration.Action.draftUpdated(draft) }\n131|    }\n132|\n133|    // MARK: - Auth\n134|\n135|    private func currentUserToken(generation gen: Int) async throws -> FlowUserToken {\n136|        guard let identity = await identities.load() else {\n137|            throw RunnerRegistration.RegistrationError.notAuthenticated\n138|        }\n139|        let config = try configProvider(identity.serverHost)\n140|        guard var record = await userStore.load(\n141|            serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID\n142|        ) else {\n143|            throw RunnerRegistration.RegistrationError.notAuthenticated\n144|        }\n145|        guard !isStale(gen) else { throw CancellationError() }\n146|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n147|            do {\n148|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n149|            } catch is CancellationError {\n150|                throw CancellationError()\n151|            } catch let error as GitHubAuth.AuthError {\n152|                switch error {\n153|                case .revoked, .unauthorized, .tokenRefreshFailed:\n154|                    throw RunnerRegistration.RegistrationError.unauthorized\n155|                default:\n156|                    break\n157|                }\n158|            }\n159|            guard !isStale(gen) else { throw CancellationError() }\n160|        }\n161|        return FlowUserToken(config: config, token: record.accessToken, identity: identity)\n162|    }\n163|\n164|    private func fail(_ error: Error, step: String, generation gen: Int) async {\n165|        guard !isStale(gen) else { return }\n166|        failedStep = step\n167|        if error is CancellationError { return }\n168|        if let reg = error as? RunnerRegistration.RegistrationError {\n169|            switch reg {\n170|            case .missingPermission, .forbidden:\n171|                await action {\n172|                    RunnerRegistration.Action.permissionDenied(message: reg.localizedDescription, step: step)\n173|                }\n174|                return\n175|            default:\n176|                break\n177|            }\n178|        }\n179|        let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n180|        await action { RunnerRegistration.Action.failed(message: message, step: step) }\n181|    }\n182|\n183|    private func finishStep(_ step: String, generation gen: Int) async {\n184|        guard !isStale(gen) else { return }\n185|        failedStep = nil\n186|        working = false\n187|        await action { RunnerRegistration.Action.stepFinished(step) }\n188|    }\n189|\n190|    // MARK: - Group\n191|\n192|    private func resolveGroup() async {\n193|        let gen = generation\n194|        guard !working else { return }\n195|        guard let draft else {\n196|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"resolveGroup\") }\n197|            return\n198|        }\n199|        do {\n200|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n201|        } catch {\n202|            failedStep = \"resolveGroup\"\n203|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"resolveGroup\") }\n204|            return\n205|        }\n206|        guard case .organization(let org) = draft.scope else { return }\n207|        working = true\n208|        await action { RunnerRegistration.Action.stepStarted(\"resolveGroup\") }\n209|        do {\n210|            let auth = try await currentUserToken(generation: gen)\n211|            guard !isStale(gen) else { return }\n212|            let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n213|            guard !isStale(gen) else { return }\n214|            let name = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n215|            let resolved: RunnerRegistration.RunnerGroup\n216|            if let existing = groups.first(where: { $0.name == name }) {\n217|                resolved = existing\n218|            } else {\n219|                resolved = try await api.createGroup(\n220|                    config: auth.config, token: auth.token, org: org,\n221|                    name: name, selectedRepositoryIDs: draft.selectedRepositoryIDs\n222|                )\n223|            }\n224|            guard !isStale(gen) else { return }\n225|            let repoIDs = try await api.fetchGroupRepositories(\n226|                config: auth.config, token: auth.token, org: org, groupID: resolved.id\n227|            )\n228|            guard !isStale(gen) else { return }\n229|            group = resolved\n230|            await action { RunnerRegistration.Action.groupResolved(resolved, repositoryIDs: repoIDs) }\n231|            guard !isStale(gen) else { return }\n232|            await action { RunnerRegistration.Action.permissionDismissed }\n233|            await finishStep(\"resolveGroup\", generation: gen)\n234|        } catch {\n235|            working = false\n236|            await fail(error, step: \"resolveGroup\", generation: gen)\n237|        }\n238|    }\n239|\n240|    // MARK: - Download\n241|\n242|    private func prepareDownload() async {\n243|        let gen = generation\n244|        guard !working else { return }\n245|        guard let draft else {\n246|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"prepareDownload\") }\n247|            return\n248|        }\n249|        working = true\n250|        await action { RunnerRegistration.Action.stepStarted(\"prepareDownload\") }\n251|        do {\n252|            let found = try await prepareDownloadInner(draft: draft, generation: gen)\n253|            guard !isStale(gen) else { return }\n254|            asset = found\n255|            await action { RunnerRegistration.Action.downloadReady(found) }\n256|            await finishStep(\"prepareDownload\", generation: gen)\n257|        } catch {\n258|            working = false\n259|            await fail(error, step: \"prepareDownload\", generation: gen)\n260|        }\n261|    }\n262|\n263|    private func prepareDownloadInner(\n264|        draft: RunnerRegistration.Draft, generation gen: Int\n265|    ) async throws -> RunnerRegistration.DownloadAsset {\n266|        let auth = try await currentUserToken(generation: gen)\n267|        guard !isStale(gen) else { throw CancellationError() }\n268|        let assets = try await api.fetchDownloads(config: auth.config, token: auth.token, scope: draft.scope)\n269|        guard !isStale(gen) else { throw CancellationError() }\n270|        return try RunnerRegistration.Gates.selectDownload(\n271|            osName: RunnerInstallerService.installOS,\n272|            arch: installer.architecture,\n273|            from: assets\n274|        )\n275|    }\n276|\n277|    // MARK: - Install\n278|\n279|    private func downloadAndInstall() async {\n280|        let gen = generation\n281|        guard !working else { return }\n282|        guard let draft else {\n283|            await action {\n284|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"downloadAndInstall\")\n285|            }\n286|            return\n287|        }\n288|        working = true\n289|        await action { RunnerRegistration.Action.stepStarted(\"downloadAndInstall\") }\n290|        do {\n291|            let resolved: RunnerRegistration.DownloadAsset\n292|            if let asset {\n293|                resolved = asset\n294|            } else {\n295|                resolved = try await prepareDownloadInner(draft: draft, generation: gen)\n296|                guard !isStale(gen) else { return }\n297|                asset = resolved\n298|                await action { RunnerRegistration.Action.downloadReady(resolved) }\n299|            }\n300|            guard !isStale(gen) else { return }\n301|            let directory = try await installer.downloadAndInstall(asset: resolved, draft: draft)\n302|            guard !isStale(gen) else { return }\n303|            installPath = directory.path\n304|            await action { RunnerRegistration.Action.installed(path: directory.path) }\n305|            await finishStep(\"downloadAndInstall\", generation: gen)\n306|        } catch {\n307|            working = false\n308|            await fail(error, step: \"downloadAndInstall\", generation: gen)\n309|        }\n310|    }\n311|\n312|    // MARK: - Register\n313|\n314|    private func registerRunner() async {\n315|        let gen = generation\n316|        guard !working else { return }\n317|        guard let draft else {\n318|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"registerRunner\") }\n319|            return\n320|        }\n321|        guard let installPath else {\n322|            failedStep = \"registerRunner\"\n323|            await action {\n324|                RunnerRegistration.Action.failed(message: \"Install the runner package first.\", step: \"registerRunner\")\n325|            }\n326|            return\n327|        }\n328|        working = true\n329|        await action { RunnerRegistration.Action.stepStarted(\"registerRunner\") }\n330|        let directory = URL(fileURLWithPath: installPath)\n331|        let scopeKey = Self.tokenScopeKey(draft: draft)\n332|        do {\n333|            // Idempotent resume: an already-configured directory never mints\n334|            // a second registration token or a duplicate GitHub registration.\n335|            if await installer.hasCompleted(RunnerInstallerService.stepConfigured, directory: directory) {\n336|                let localID = await installer.readAgentID(directory: directory)\n337|                let remoteID = try await resolveRemoteRunnerID(draft: draft, generation: gen)\n338|                guard !isStale(gen) else { return }\n339|                runnerID = remoteID\n340|                await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: localID) }\n341|                await finishStep(\"registerRunner\", generation: gen)\n342|                return\n343|            }\n344|            let auth = try await currentUserToken(generation: gen)\n345|            guard !isStale(gen) else { return }\n346|            let created = try await api.createRegistrationToken(\n347|                config: auth.config, token: auth.token, scope: draft.scope\n348|            )\n349|            guard !isStale(gen) else { return }\n350|            let scoped = RunnerRegistration.ScopedToken(\n351|                token: created.token, expiresAt: created.expiresAt, obtainedAt: now()\n352|            )\n353|            try await registrationTokens.save(scoped, scopeKey: scopeKey)\n354|            guard !isStale(gen) else { return }\n355|            let groupName: String?\n356|            switch draft.scope {\n357|            case .organization: groupName = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n358|            case .repository: groupName = nil\n359|            }\n360|            let localID: Int64?\n361|            do {\n362|                localID = try await installer.runConfig(\n363|                    directory: directory,\n364|                    scopeURL: draft.scope.configURL(serverHost: auth.identity.serverHost),\n365|                    token: created.token,\n366|                    draft: draft,\n367|                    runnerGroup: groupName\n368|                )\n369|            } catch {\n370|                await registrationTokens.delete(scopeKey: scopeKey)\n371|                throw error\n372|            }\n373|            guard !isStale(gen) else { return }\n374|            let remoteID = try await resolveRemoteRunnerID(draft: draft, generation: gen)\n375|            guard !isStale(gen) else { return }\n376|            await registrationTokens.delete(scopeKey: scopeKey)\n377|            guard !isStale(gen) else { return }\n378|            runnerID = remoteID\n379|            await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: localID) }\n380|            guard !isStale(gen) else { return }\n381|            await action { RunnerRegistration.Action.permissionDismissed }\n382|            await finishStep(\"registerRunner\", generation: gen)\n383|        } catch {\n384|            working = false\n385|            await fail(error, step: \"registerRunner\", generation: gen)\n386|        }\n387|    }\n388|\n389|    /// Fetches the real GitHub runner ID by matching the registered name.\n390|    /// Returns nil when the runner list does not (yet) contain it.\n391|    private func resolveRemoteRunnerID(draft: RunnerRegistration.Draft, generation gen: Int) async throws -> Int64? {\n392|        let auth = try await currentUserToken(generation: gen)\n393|        guard !isStale(gen) else { throw CancellationError() }\n394|        let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n395|        let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n396|        return runners.first(where: { $0.name == wanted })?.id\n397|    }\n398|\n399|    // MARK: - Service\n400|\n401|    private func setupService() async {\n402|        let gen = generation\n403|        guard !working else { return }\n404|        guard let draft, let installPath else {\n405|            await action {\n406|                RunnerRegistration.Action.failed(message: \"Register the runner first.\", step: \"setupService\")\n407|            }\n408|            return\n409|        }\n410|        working = true\n411|        await action { RunnerRegistration.Action.stepStarted(\"setupService\") }\n412|        do {\n413|            let directory = URL(fileURLWithPath: installPath)\n414|            let label = Self.serviceLabel(draft: draft)\n415|            let plist = try await installer.setupService(directory: directory, label: label)\n416|            guard !isStale(gen) else { return }\n417|            await action { RunnerRegistration.Action.serviceReady(plistPath: plist.path) }\n418|            await finishStep(\"setupService\", generation: gen)\n419|        } catch {\n420|            working = false\n421|            await fail(error, step: \"setupService\", generation: gen)\n422|        }\n423|    }\n424|\n425|    // MARK: - Editable access and labels\n426|\n427|    private func applyRepositoryAccess(groupID: Int64, ids: Set<Int64>) async {\n428|        let gen = generation\n429|        guard !working else { return }\n430|        guard let draft else {\n431|            await action {\n432|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyRepositoryAccess\")\n433|            }\n434|            return\n435|        }\n436|        do {\n437|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n438|            guard case .organization(let org) = draft.scope else { return }\n439|            guard let group else {\n440|                failedStep = \"applyRepositoryAccess\"\n441|                await action {\n442|                    RunnerRegistration.Action.failed(\n443|                        message: \"Resolve the dedicated group first.\", step: \"applyRepositoryAccess\"\n444|                    )\n445|                }\n446|                return\n447|            }\n448|            try RunnerRegistration.Gates.authorizeGroupMutation(\n449|                targetGroupID: groupID, resolvedGroupID: group.id,\n450|                allowFlag: draft.allowGroupMutation\n451|            )\n452|            working = true\n453|            pendingRepositoryIDs = ids\n454|            pendingTargetGroupID = groupID\n455|            await action { RunnerRegistration.Action.stepStarted(\"applyRepositoryAccess\") }\n456|            let auth = try await currentUserToken(generation: gen)\n457|            guard !isStale(gen) else { return }\n458|            try await api.setGroupRepositories(\n459|                config: auth.config, token: auth.token, org: org, groupID: group.id, selectedRepositoryIDs: ids\n460|            )\n461|            guard !isStale(gen) else { return }\n462|            let confirmed = try await api.fetchGroupRepositories(\n463|                config: auth.config, token: auth.token, org: org, groupID: group.id\n464|            )\n465|            guard !isStale(gen) else { return }\n466|            if var current = self.draft {\n467|                current.selectedRepositoryIDs = Set(confirmed)\n468|                self.draft = current\n469|            }\n470|            await action { RunnerRegistration.Action.repositoryAccessApplied(confirmed) }\n471|            guard !isStale(gen) else { return }\n472|            await action { RunnerRegistration.Action.permissionDismissed }\n473|            pendingRepositoryIDs = nil\n474|            pendingTargetGroupID = nil\n475|            await finishStep(\"applyRepositoryAccess\", generation: gen)\n476|        } catch {\n477|            working = false\n478|            await fail(error, step: \"applyRepositoryAccess\", generation: gen)\n479|        }\n480|    }\n481|\n482|    private func applyLabels(_ labels: [String]) async {\n483|        let gen = generation\n484|        guard !working else { return }\n485|        guard let draft else {\n486|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyLabels\") }\n487|            return\n488|        }\n489|        let trimmed = labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }\n490|        guard !trimmed.isEmpty else {\n491|            failedStep = \"applyLabels\"\n492|            await action {\n493|                RunnerRegistration.Action.failed(message: \"At least one label is required.\", step: \"applyLabels\")\n494|            }\n495|            return\n496|        }\n497|        working = true\n498|        pendingLabels = trimmed\n499|        await action { RunnerRegistration.Action.stepStarted(\"applyLabels\") }\n500|        do {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
