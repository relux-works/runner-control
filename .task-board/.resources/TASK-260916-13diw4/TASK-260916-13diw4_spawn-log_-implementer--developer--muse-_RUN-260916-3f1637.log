{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ccd5","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":1221,"recorded_at":1780531400002437,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"task_stream":{"kind":"task","id":"01a0a881-16fa-7f73-90d2-b8ccabed9cb8"},"task_id":"01a0a881-16fa-7f73-90d2-b8ccabed9cb8","event":{"kind":"output","task_id":"01a0a881-16fa-7f73-90d2-b8ccabed9cb8","chunk":"edited\nchanged lines: lines 367-371\n--- original\n+++ updated\n@@\n-            let auth = try await currentUserToken(generation: gen)\n-            guard !isStale(gen) else { return }\n-            let created = try await api.createRegistrationToken(\n-                config: auth.config, token: auth.token, scope: draft.scope\n-            )\n+            let auth = try await currentUserToken(generation: gen)\n+            guard !isStale(gen) else { return }\n+            // Duplicate guard before any token is minted: without explicit\n+            // replace consent a remote name match refuses the run so config\n+            // can never silently replace another machine's registration.\n+            // Bound: the runners list is first-page only (per_page=100); a\n+            // duplicate beyond it still fails at config.sh, which omits\n+            // `--replace` unless the user explicitly allowed it.\n+            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n+            let existing = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n+            guard !isStale(gen) else { return }\n+            try RunnerRegistration.Gates.rejectRemoteDuplicate(\n+                name: wanted, isTaken: existing.contains(where: { $0.name == wanted }),\n+                allowReplace: draft.allowReplace\n+            )\n+            guard !isStale(gen) else { return }\n+            let created = try await api.createRegistrationToken(\n+                config: auth.config, token: auth.token, scope: draft.scope\n+            )\n","final_result":true}}}
