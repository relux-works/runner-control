{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5e9","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":335,"recorded_at":1780531400000665,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"task_stream":{"kind":"task","id":"01a0a87c-3f8c-7462-a881-e8ec6babc8c0"},"task_id":"01a0a87c-3f8c-7462-a881-e8ec6babc8c0","event":{"kind":"output","task_id":"01a0a87c-3f8c-7462-a881-e8ec6babc8c0","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(499 line(s) above)\n500|        if case .repositoryAccessApplied(let ids) = action { ids } else { nil }\n501|    }\n502|    #expect(applied.last?.sorted() == [9, 10])\n503|    let puts = await harness.transport.requests.filter { $0.method == \"PUT\" }\n504|    #expect(puts.count == 1)\n505|    #expect(puts.first?.url.path.contains(\"/orgs/acme/actions/runner-groups/5/repositories\") ?? false)\n506|    let body = try JSONDecoder().decode([String: JSONAny].self, from: puts.first?.body ?? Data())\n507|    #expect(body[\"selected_repository_ids\"]?.ints?.sorted() == [9, 10])\n508|}\n509|\n510|// MARK: - Install (integrity, runsvc, idempotency)\n511|\n512|@Test func downloadVerifiesIntegrityAgainstSystemShasum() async throws {\n513|    let package = try await FixturePackage.make()\n514|    let draft = orgDraft()\n515|    let asset = RunnerRegistration.DownloadAsset(\n516|        osName: \"osx\", architecture: \"arm64\",\n517|        downloadURL: URL(string: \"https://example.com/osx-arm64.tar.gz\")!,\n518|        filename: \"osx-arm64.tar.gz\", sha256Checksum: package.sha256ViaSystem\n519|    )\n520|    let harness = await registrationHarness(\n521|        transport: TestTransport([]), downloader: fixtureDownloader(package.bytes)\n522|    )\n523|    let directory = try await harness.installer.downloadAndInstall(asset: asset, draft: draft)\n524|    let files = FileManager.default\n525|    #expect(files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path))\n526|    let runsvc = directory.appendingPathComponent(\"runsvc.sh\")\n527|    #expect(files.fileExists(atPath: runsvc.path))\n528|    let mode = try files.attributesOfItem(atPath: runsvc.path)[.posixPermissions] as? Int\n529|    #expect(mode == 0o755)\n530|    #expect(await harness.installer.hasCompleted(RunnerInstallerService.stepInstalled, directory: directory))\n531|    // Idempotent: a completed install skips the download entirely.\n532|    actor Counting {\n533|        var count = 0\n534|        func next(_ url: URL) async throws -> Data { count += 1; return Data() }\n535|    }\n536|    let counting = Counting()\n537|    let skipper = RunnerInstallerService(\n538|        installRoot: harness.installRoot,\n539|        downloader: { url in try await counting.next(url) },\n540|        currentArch: { \"arm64\" }\n541|    )\n542|    _ = try await skipper.downloadAndInstall(asset: asset, draft: draft)\n543|    #expect(await counting.count == 0)\n544|}\n545|\n546|@Test func downloadRefusesTamperedBytes() async throws {\n547|    let package = try await FixturePackage.make()\n548|    var tampered = package.bytes\n549|    tampered[tampered.count - 1] ^= 0xFF\n550|    let draft = orgDraft()\n551|    let asset = RunnerRegistration.DownloadAsset(\n552|        osName: \"osx\", architecture: \"arm64\",\n553|        downloadURL: URL(string: \"https://example.com/osx-arm64.tar.gz\")!,\n554|        filename: \"osx-arm64.tar.gz\", sha256Checksum: package.sha256ViaSystem\n555|    )\n556|    let harness = await registrationHarness(\n557|        transport: TestTransport([]), downloader: fixtureDownloader(tampered)\n558|    )\n559|    do {\n560|        _ = try await harness.installer.downloadAndInstall(asset: asset, draft: draft)\n561|        Issue.record(\"installer admitted tampered bytes\")\n562|    } catch let error as RunnerRegistration.RegistrationError {\n563|        guard case .integrityMismatch = error else { Issue.record(\"wrong error: \\(error)\"); return }\n564|    }\n565|    let directory = await harness.installer.directory(for: draft.installDirName)\n566|    #expect(FileManager.default.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) == false)\n567|    #expect(await harness.installer.hasCompleted(RunnerInstallerService.stepInstalled, directory: directory) == false)\n568|}\n569|\n570|@Test func downloadRefusesMalformedChecksum() async throws {\n571|    let package = try await FixturePackage.make()\n572|    let draft = orgDraft()\n573|    let asset = RunnerRegistration.DownloadAsset(\n574|        osName: \"osx\", architecture: \"arm64\",\n575|        downloadURL: URL(string: \"https://example.com/osx-arm64.tar.gz\")!,\n576|        filename: \"osx-arm64.tar.gz\", sha256Checksum: \"not-a-sha256\"\n577|    )\n578|    let harness = await registrationHarness(\n579|        transport: TestTransport([]), downloader: fixtureDownloader(package.bytes)\n580|    )\n581|    do {\n582|        _ = try await harness.installer.downloadAndInstall(asset: asset, draft: draft)\n583|        Issue.record(\"installer admitted malformed checksum\")\n584|    } catch let error as RunnerRegistration.RegistrationError {\n585|        guard case .integrityMismatch = error else { Issue.record(\"wrong error: \\(error)\"); return }\n586|    }\n587|}\n588|\n589|@Test func existingRegistrationBlocksFreshInstall() async throws {\n590|    let package = try await FixturePackage.make()\n591|    let harness = await registrationHarness(\n592|        transport: TestTransport([]), downloader: fixtureDownloader(package.bytes)\n593|    )\n594|    let draft = orgDraft()\n595|    let directory = await harness.installer.directory(for: draft.installDirName)\n596|    try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)\n597|    try Data(\"{}\".utf8).write(to: directory.appendingPathComponent(\".runner\"))\n598|    let asset = RunnerRegistration.DownloadAsset(\n599|        osName: \"osx\", architecture: \"arm64\",\n600|        downloadURL: URL(string: \"https://example.com/x.tar.gz\")!,\n601|        filename: \"x.tar.gz\", sha256Checksum: nil\n602|    )\n603|    do {\n604|        _ = try await harness.installer.downloadAndInstall(asset: asset, draft: draft)\n605|        Issue.record(\"installer overwrote a registered directory\")\n606|    } catch let error as RunnerRegistration.RegistrationError {\n607|        guard case .alreadyRegistered = error else { Issue.record(\"wrong error: \\(error)\"); return }\n608|    }\n609|}\n610|\n611|// MARK: - Configure (exact invocation, no secret leakage)\n612|\n613|@Test func runConfigUsesExactInvocation() async throws {\n614|    let package = try await FixturePackage.make(withRealConfigScript: false)\n615|    let executor = SplitExecutor()\n616|    let harness = await registrationHarness(\n617|        transport: TestTransport([]),\n618|        downloader: fixtureDownloader(package.bytes),\n619|        executor: executor\n620|    )\n621|    let draft = orgDraft()\n622|    let asset = RunnerRegistration.DownloadAsset(\n623|        osName: \"osx\", architecture: \"arm64\",\n624|        downloadURL: URL(string: \"https://example.com/x.tar.gz\")!,\n625|        filename: \"x.tar.gz\", sha256Checksum: package.sha256ViaSystem\n626|    )\n627|    let directory = try await harness.installer.downloadAndInstall(asset: asset, draft: draft)\n628|    let agentID = try await harness.installer.runConfig(\n629|        directory: directory, scopeURL: \"https://github.com/acme\",\n630|        token: \"REG-TOKEN\", draft: draft, runnerGroup: \"RunnerControl-Mac\"\n631|    )\n632|    #expect(agentID == 4242)\n633|    let calls = await executor.configCalls\n634|    #expect(calls.count == 1)\n635|    #expect(calls.first == [\n636|        \"--url\", \"https://github.com/acme\",\n637|        \"--token\", \"REG-TOKEN\",\n638|        \"--name\", \"macbook-test\",\n639|        \"--work\", \"_work\",\n640|        \"--labels\", \"self-hosted,macOS\",\n641|        \"--runnergroup\", \"RunnerControl-Mac\",\n642|        \"--unattended\", \"--replace\",\n643|    ])\n644|}\n645|\n646|@Test func runConfigScrubsTokenFromFailure() async throws {\n647|    let package = try await FixturePackage.make(withRealConfigScript: false)\n648|    let executor = SplitExecutor()\n649|    await executor.setFailure(CommandResult(code: 1, output: \"config failed for --token SUPER-SECRET-TOKEN tail\"))\n650|    let harness = await registrationHarness(\n651|        transport: TestTransport([]),\n652|        downloader: fixtureDownloader(package.bytes),\n653|        executor: executor\n654|    )\n655|    let draft = orgDraft()\n656|    let asset = RunnerRegistration.DownloadAsset(\n657|        osName: \"osx\", architecture: \"arm64\",\n658|        downloadURL: URL(string: \"https://example.com/x.tar.gz\")!,\n659|        filename: \"x.tar.gz\", sha256Checksum: package.sha256ViaSystem\n660|    )\n661|    let directory = try await harness.installer.downloadAndInstall(asset: asset, draft: draft)\n662|    do {\n663|        try await harness.installer.runConfig(\n664|            directory: directory, scopeURL: \"https://github.com/acme\",\n665|            token: \"SUPER-SECRET-TOKEN\", draft: draft, runnerGroup: \"RunnerControl-Mac\"\n666|        )\n667|        Issue.record(\"runConfig swallowed a failing script\")\n668|    } catch let error as RunnerRegistration.RegistrationError {\n669|        guard case .configFailed(let text) = error else { Issue.record(\"wrong error: \\(error)\"); return }\n670|        #expect(!text.contains(\"SUPER-SECRET-TOKEN\"))\n671|        #expect(text.contains(\"[REDACTED]\"))\n672|    }\n673|}\n674|\n675|private extension SplitExecutor {\n676|    func setFailure(_ result: CommandResult) { failure = result }\n677|}\n678|\n679|@Test func runConfigExecutesRealScript() async throws {\n680|    // The fixture config.sh is a real executable shell script: production\n681|    // runConfig must execute it (not only a fake) and read back `.runner`.\n682|    let package = try await FixturePackage.make(withRealConfigScript: true)\n683|    let harness = await registrationHarness(\n684|        transport: TestTransport([]), downloader: fixtureDownloader(package.bytes)\n685|    )\n686|    let draft = orgDraft()\n687|    let asset = RunnerRegistration.DownloadAsset(\n688|        osName: \"osx\", architecture: \"arm64\",\n689|        downloadURL: URL(string: \"https://example.com/x.tar.gz\")!,\n690|        filename: \"x.tar.gz\", sha256Checksum: package.sha256ViaSystem\n691|    )\n692|    let directory = try await harness.installer.downloadAndInstall(asset: asset, draft: draft)\n693|    let agentID = try await harness.installer.runConfig(\n694|        directory: directory, scopeURL: \"https://github.com/acme\",\n695|        token: \"REG-TOKEN\", draft: draft, runnerGroup: \"RunnerControl-Mac\"\n696|    )\n697|    #expect(agentID == 4242)\n698|    let data = try Data(contentsOf: directory.appendingPathComponent(\".runner\"))\n699|    let object = try JSONSerialization.jsonObject(with: data) as? [String: Any]\n700|    #expect(object?[\"agentName\"] as? String == \"macbook-test\")\n701|}\n702|\n703|// MARK: - Service (manual LaunchAgent, discovered)\n704|\n705|@Test func setupServiceWritesManualPlistFoundByDiscovery() async throws {\n706|    let package = try await FixturePackage.make()\n707|    let harness = await registrationHarness(\n708|        transport: TestTransport([]), downloader: fixtureDownloader(package.bytes)\n709|    )\n710|    let draft = orgDraft()\n711|    let asset = RunnerRegistration.DownloadAsset(\n712|        osName: \"osx\", architecture: \"arm64\",\n713|        downloadURL: URL(string: \"https://example.com/x.tar.gz\")!,\n714|        filename: \"x.tar.gz\", sha256Checksum: package.sha256ViaSystem\n715|    )\n716|    let directory = try await harness.installer.downloadAndInstall(asset: asset, draft: draft)\n717|    try Data(\"\"\"\n718|    {\"agentId\":4242,\"agentName\":\"macbook-test\",\"gitHubUrl\":\"https://github.com/acme\",\"workFolder\":\"_work\"}\n719|    \"\"\".utf8).write(to: directory.appendingPathComponent(\".runner\"))\n720|    let label = RunnerRegistration.Flow.serviceLabel(draft: draft)\n721|    let plist = try await harness.installer.setupService(directory: directory, label: label)\n722|    let data = try Data(contentsOf: plist)\n723|    let object = try PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any]\n724|    #expect(object?[\"Label\"] as? String == label)\n725|    #expect(object?[\"ProgramArguments\"] as? [String] == [directory.appendingPathComponent(\"runsvc.sh\").path])\n726|    #expect(object?[\"WorkingDirectory\"] as? String == directory.path)\n727|    #expect(object?[\"RunAtLoad\"] as? Bool == false)\n728|    // The wizard output must be visible to production discovery.\n729|    let found = RunnerDiscovery.installed(home: harness.home)\n730|    #expect(found.count == 1)\n731|    #expect(found.first?.title == \"macbook-test\")\n732|    #expect(found.first?.detail == \"acme\")\n733|}\n734|\n735|// MARK: - Recovery and token lifetime\n736|\n737|@Test func recoverPartialInstallRefusesWorkingRunner() async throws {\n738|    let harness = await registrationHarness(transport: TestTransport([]))\n739|    let draft = orgDraft()\n740|    let occupied = await harness.installer.directory(for: draft.installDirName)\n741|    try FileManager.default.createDirectory(at: occupied, withIntermediateDirectories: true)\n742|    try Data(\"{}\".utf8).write(to: occupied.appendingPathComponent(\".runner\"))\n743|    do {\n744|        try await harness.installer.recoverPartialInstall(directory: occupied, scopeKey: draft.scope.scopeKey)\n745|        Issue.record(\"recovery deleted a registered runner\")\n746|    } catch let error as RunnerRegistration.RegistrationError {\n747|        guard case .alreadyRegistered = error else { Issue.record(\"wrong error: \\(error)\"); return }\n748|    }\n749|    #expect(FileManager.default.fileExists(atPath: occupied.path))\n750|    let partial = harness.installRoot.appendingPathComponent(\"partial-dir\")\n751|    try FileManager.default.createDirectory(at: partial, withIntermediateDirectories: true)\n752|    try await harness.installer.recoverPartialInstall(directory: partial, scopeKey: draft.scope.scopeKey)\n753|    #expect(FileManager.default.fileExists(atPath: partial.path) == false)\n754|}\n755|\n756|@Test func registrationTokenStoreExpiresShortLivedToken() async throws {\n757|    let store = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n758|    let live = RunnerRegistration.ScopedToken(token: \"live\", expiresAt: Date().addingTimeInterval(60))\n759|    try await store.save(live, scopeKey: \"org:acme:dir\")\n760|    #expect(await store.load(scopeKey: \"org:acme:dir\") == live)\n761|    let dead = RunnerRegistration.ScopedToken(token: \"dead\", expiresAt: Date().addingTimeInterval(-5))\n762|    try await store.save(dead, scopeKey: \"org:acme:other\")\n763|    #expect(await store.load(scopeKey: \"org:acme:other\") == nil)\n764|    await store.delete(scopeKey: \"org:acme:dir\")\n765|    #expect(await store.load(scopeKey: \"org:acme:dir\") == nil)\n766|}\n767|\n768|// MARK: - End-to-end wizard through production Flow effects\n769|\n770|private func runnersListPayload(_ runners: [[String: Any]]) -> GitHubHTTPResponse {\n771|    jsonResponse([\"runners\": runners])\n772|}\n773|\n774|@Test func orgWizardEndToEndDeletesTokenAndLeaksNothing() async throws {\n775|    let package = try await FixturePackage.make(withRealConfigScript: false)\n776|    let executor = SplitExecutor()\n777|    let transport = TestTransport([\n778|        jsonResponse([\"runner_groups\": [[\"id\": 5, \"name\": \"RunnerControl-Mac\", \"visibility\": \"selected\"]]]),\n779|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n780|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n781|        jsonResponse([\"token\": \"REG-SECRET-1\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n782|        runnersListPayload([[\"id\": 77, \"name\": \"macbook-test\", \"labels\": [[\"name\": \"self-hosted\"], [\"name\": \"macOS\"]]]]),\n783|    ])\n784|    let harness = await registrationHarness(\n785|        transport: transport,\n786|        downloader: fixtureDownloader(package.bytes),\n787|        executor: executor\n788|    )\n789|    let draft = orgDraft()\n790|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n791|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n792|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n793|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n794|    _ = await harness.flow.apply(RunnerRegistration.Effect.setupService)\n795|    let actions = registrationActions(harness.logger)\n796|    let registered = actions.compactMap { action -> (Int64?, Int64?)? in\n797|        if case .registered(let runnerID, let localID) = action { (runnerID, localID) } else { nil }\n798|    }\n799|    // Real IDs: remote GitHub runner ID matched by name + local agent ID from .runner.\n800|    #expect(registered.last?.0 == 77)\n801|    #expect(registered.last?.1 == 4242)\n802|    #expect(actions.contains { if case .serviceReady = $0 { true } else { false } })\n803|    // The short-lived registration token is deleted immediately after use.\n804|    let scopeKey = RunnerRegistration.Flow.tokenScopeKey(draft: draft)\n805|    #expect(await harness.registrationTokens.load(scopeKey: scopeKey) == nil)\n806|    // No secret leakage: the registration token appears nowhere in\n807|    // dispatched actions, request URLs, headers, or bodies.\n808|    let haystack = actions.map { String(describing: $0) }.joined(separator: \"\\n\")\n809|    #expect(!haystack.contains(\"REG-SECRET-1\"))\n810|    for request in await transport.requests {\n811|        #expect(!request.url.absoluteString.contains(\"REG-SECRET-1\"))\n812|        #expect(!request.headers.values.joined().contains(\"REG-SECRET-1\"))\n813|        if let body = request.body {\n814|            #expect(!String(decoding: body, as: UTF8.self).contains(\"REG-SECRET-1\"))\n815|        }\n816|    }\n817|    // The token reached exactly one place: the config.sh argv in memory.\n818|    let calls = await executor.configCalls\n819|    #expect(calls.count == 1)\n820|    #expect(calls.first?.contains(\"REG-SECRET-1\") ?? false)\n821|    #expect(calls.first?.contains(\"--runnergroup\") ?? false)\n822|    // Wizard output is discoverable and launchable by production code.\n823|    #expect(RunnerDiscovery.installed(home: harness.home).count == 1)\n824|}\n825|\n826|@Test func repoWizardOmitsRunnerGroup() async throws {\n827|    let package = try await FixturePackage.make(withRealConfigScript: false)\n828|    let executor = SplitExecutor()\n829|    let transport = TestTransport([\n830|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n831|        jsonResponse([\"token\": \"REG-SECRET-2\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n832|        runnersListPayload([[\"id\": 78, \"name\": \"personal-runner\", \"labels\": [[\"name\": \"self-hosted\"]]]]),\n833|    ])\n834|    let harness = await registrationHarness(\n835|        transport: transport,\n836|        downloader: fixtureDownloader(package.bytes),\n837|        executor: executor\n838|    )\n839|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(repoDraft()))\n840|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n841|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n842|    let calls = await executor.configCalls\n843|    #expect(calls.count == 1)\n844|    #expect(!(calls.first?.contains(\"--runnergroup\") ?? true))\n845|    let requests = await transport.requests\n846|    #expect(requests.allSatisfy { !$0.url.path.contains(\"runner-groups\") })\n847|    #expect(requests.contains { $0.url.path.contains(\"/repos/octo/app/actions/runners/registration-token\") })\n848|}\n849|\n850|@Test func retryResumesFailedDownloadWithoutDuplicates() async throws {\n851|    let package = try await FixturePackage.make()\n852|    actor Flaky {\n853|        let bytes: Data\n854|        var calls = 0\n855|        init(bytes: Data) { self.bytes = bytes }\n856|        func next(_ url: URL) async throws -> Data {\n857|            calls += 1\n858|            if calls == 1 { throw URLError(.notConnectedToInternet) }\n859|            return bytes\n860|        }\n861|    }\n862|    let flaky = Flaky(bytes: package.bytes)\n863|    let transport = TestTransport([downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))])\n864|    let harness = await registrationHarness(\n865|        transport: transport,\n866|        downloader: { url in try await flaky.next(url) }\n867|    )\n868|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n869|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n870|    #expect(lastFailure(harness.logger)?.step == \"downloadAndInstall\")\n871|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n872|    let actions = registrationActions(harness.logger)\n873|    #expect(actions.contains { if case .installed = $0 { true } else { false } })\n874|    // The asset resolved once; the retry resumed the download, not the lookup.\n875|    #expect(await transport.requests.count == 1)\n876|    #expect(await flaky.calls == 2)\n877|    let directory = await harness.installer.directory(for: \"macbook-test\")\n878|    #expect(FileManager.default.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path))\n879|}\n880|\n881|@Test func registerIsIdempotentAcrossRetries() async throws {\n882|    let package = try await FixturePackage.make(withRealConfigScript: false)\n883|    let executor = SplitExecutor()\n884|    let transport = TestTransport([\n885|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n886|        jsonResponse([\"token\": \"REG-SECRET-3\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n887|        runnersListPayload([[\"id\": 77, \"name\": \"macbook-test\", \"labels\": []]]),\n888|        runnersListPayload([[\"id\": 77, \"name\": \"macbook-test\", \"labels\": []]]),\n889|    ])\n890|    let harness = await registrationHarness(\n891|        transport: transport,\n892|        downloader: fixtureDownloader(package.bytes),\n893|        executor: executor\n894|    )\n895|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n896|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n897|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n898|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n899|    let tokenPosts = await transport.requests.filter {\n900|        $0.method == \"POST\" && $0.url.path.contains(\"registration-token\")\n901|    }\n902|    // The retry minted no second token and ran config.sh exactly once:\n903|    // no orphan or duplicate GitHub registrations.\n904|    #expect(tokenPosts.count == 1)\n905|    #expect(await executor.configCalls.count == 1)\n906|    let registered = registrationActions(harness.logger).filter {\n907|        if case .registered = $0 { true } else { false }\n908|    }\n909|    #expect(registered.count == 2)\n910|}\n911|\n912|@Test func failedConfigDeletesTokenAndReportsScrubbedError() async throws {\n913|    let package = try await FixturePackage.make(withRealConfigScript: false)\n914|    let executor = SplitExecutor()\n915|    await executor.setFailure(CommandResult(code: 1, output: \"bad --token REG-SECRET-9\"))\n916|    let transport = TestTransport([\n917|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n918|        jsonResponse([\"token\": \"REG-SECRET-9\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n919|    ])\n920|    let harness = await registrationHarness(\n921|        transport: transport,\n922|        downloader: fixtureDownloader(package.bytes),\n923|        executor: executor\n924|    )\n925|    let draft = orgDraft()\n926|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n927|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n928|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n929|    let failure = lastFailure(harness.logger)\n930|    #expect(failure?.step == \"registerRunner\")\n931|    #expect(!(failure?.message.contains(\"REG-SECRET-9\") ?? true))\n932|    let scopeKey = RunnerRegistration.Flow.tokenScopeKey(draft: draft)\n933|    #expect(await harness.registrationTokens.load(scopeKey: scopeKey) == nil)\n934|    _ = await harness.flow.apply(RunnerRegistration.Effect.cancel)\n935|    #expect(registrationActions(harness.logger).contains { if case .cancelled = $0 { true } else { false } })\n936|}\n937|\n938|// MARK: - Permission errors (retained, explicit clear)\n939|\n940|@Test @MainActor func permissionErrorRetainedAcrossEditsUntilRetrySucceeds() async {\n941|    let transport = TestTransport([\n942|        GitHubHTTPResponse(status: 403, body: Data(\"Resource not accessible by integration\".utf8)),\n943|    ])\n944|    let harness = await registrationHarness(transport: transport)\n945|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n946|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n947|    var edited = orgDraft()\n948|    edited.runnerName = \"renamed-mac\"\n949|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n950|    let state = RunnerRegistration.State()\n951|    for action in registrationActions(harness.logger) { await state.reduce(with: action) }\n952|    #expect(state.permissionError?.contains(\"Missing permission\") ?? false)\n953|    #expect(state.draft?.runnerName == \"renamed-mac\")\n954|    // Access granted later: retry succeeds and clears the retained error.\n955|    await transport.append(jsonResponse([\"runner_groups\": [[\"id\": 5, \"name\": \"RunnerControl-Mac\", \"visibility\": \"selected\"]]]))\n956|    await transport.append(jsonResponse([\"repositories\": [[\"id\": 9]]]))\n957|    let seen = registrationActions(harness.logger).count\n958|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n959|    for action in registrationActions(harness.logger).dropFirst(seen) { await state.reduce(with: action) }\n960|    #expect(state.group?.id == 5)\n961|    #expect(state.permissionError == nil)\n962|}\n963|\n964|@Test func forbiddenGroupCreateNamesRequiredPermission() async {\n965|    let transport = TestTransport([\n966|        jsonResponse([\"runner_groups\": [[\"id\": 1, \"name\": \"Default\", \"visibility\": \"all\"]]]),\n967|        GitHubHTTPResponse(status: 403, body: Data(\"Resource not accessible by integration\".utf8)),\n968|    ])\n969|    let harness = await registrationHarness(transport: transport)\n970|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n971|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n972|    let actions = registrationActions(harness.logger)\n973|    #expect(actions.contains {\n974|        if case .permissionDenied(let message, _) = $0, message.contains(\"Self-hosted runners/write\") { true } else { false }\n975|    })\n976|}\n977|\n978|// MARK: - Labels (editable with real IDs)\n979|\n980|@Test func labelsApplyRequiresRealRunnerIDThenPuts() async throws {\n981|    let transport = TestTransport([\n982|        runnersListPayload([]),\n983|        runnersListPayload([[\"id\": 77, \"name\": \"macbook-test\", \"labels\": []]]),\n984|        jsonResponse([[\"id\": 1, \"name\": \"self-hosted\"]]),\n985|    ])\n986|    let harness = await registrationHarness(transport: transport)\n987|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n988|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyLabels([\"self-hosted\", \"macOS\", \"gpu\"]))\n989|    #expect(lastFailure(harness.logger)?.step == \"applyLabels\")\n990|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n991|    let applied = registrationActions(harness.logger).compactMap { action -> [String]? in\n992|        if case .labelsApplied(let labels) = action { labels } else { nil }\n993|    }\n994|    #expect(applied.last == [\"self-hosted\", \"macOS\", \"gpu\"])\n995|    let puts = await transport.requests.filter { $0.method == \"PUT\" }\n996|    #expect(puts.count == 1)\n997|    #expect(puts.first?.url.path.contains(\"/orgs/acme/actions/runners/77/labels\") ?? false)\n998|}","final_result":true}}}
