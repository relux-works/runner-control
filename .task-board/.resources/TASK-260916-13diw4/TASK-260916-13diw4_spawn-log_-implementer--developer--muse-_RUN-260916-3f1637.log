{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4ef","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":210,"recorded_at":1780531400000415,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"task_stream":{"kind":"task","id":"01a0a87c-0872-7721-b769-32c1e41f3675"},"task_id":"01a0a87c-0872-7721-b769-32c1e41f3675","event":{"kind":"output","task_id":"01a0a87c-0872-7721-b769-32c1e41f3675","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension RunnerRegistration {\n5|    public protocol IFlow: Relux.Flow {}\n6|\n7|    public actor Flow {\n8|        public let dispatcher: Relux.Dispatcher\n9|        private let api: GitHubRunnerAPIClient\n10|        private let installer: RunnerInstallerService\n11|        private let registrationTokens: any RunnerRegistrationTokenStoring\n12|        private let userStore: any GitHubCredentialStoring\n13|        private let identities: any GitHubSessionIdentityStoring\n14|        private let refresher: GitHubTokenRefresh\n15|        private let configProvider: @Sendable (String?) throws -> GitHubAuth.AppConfig\n16|        private let now: @Sendable () -> Date\n17|\n18|        private var generation = 0\n19|        private var working = false\n20|        private var draft: Draft?\n21|        private var group: RunnerGroup?\n22|        private var asset: DownloadAsset?\n23|        private var installPath: String?\n24|        private var runnerID: Int64?\n25|        private var failedStep: String?\n26|        private var pendingRepositoryIDs: Set<Int64>?\n27|        private var pendingTargetGroupID: Int64?\n28|        private var pendingLabels: [String]?\n29|\n30|        public init(\n31|            api: GitHubRunnerAPIClient,\n32|            installer: RunnerInstallerService,\n33|            registrationTokens: any RunnerRegistrationTokenStoring,\n34|            userStore: any GitHubCredentialStoring,\n35|            identityStore: any GitHubSessionIdentityStoring,\n36|            refresher: GitHubTokenRefresh,\n37|            configProvider: (@Sendable (String?) throws -> GitHubAuth.AppConfig)? = nil,\n38|            now: (@Sendable () -> Date)? = nil,\n39|            dispatcher: Relux.Dispatcher? = nil\n40|        ) async {\n41|            self.api = api\n42|            self.installer = installer\n43|            self.registrationTokens = registrationTokens\n44|            self.userStore = userStore\n45|            self.identities = identityStore\n46|            self.refresher = refresher\n47|            self.configProvider = configProvider ?? { host in\n48|                try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\")\n49|            }\n50|            self.now = now ?? Date.init\n51|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n52|        }\n53|\n54|        /// Deterministic LaunchAgent label for a draft. Always carries the\n55|        /// `actions.runner.` prefix discovery requires.\n56|        public nonisolated static func serviceLabel(draft: Draft) -> String {\n57|            let scope = draft.scope.detail.replacingOccurrences(of: \"/\", with: \"-\")\n58|            let raw = \"actions.runner.\\(scope).\\(draft.installDirName)\"\n59|            let allowed = CharacterSet.alphanumerics.union(CharacterSet(charactersIn: \".-\"))\n60|            return raw.unicodeScalars.map { allowed.contains($0) ? String($0) : \"-\" }.joined()\n61|        }\n62|\n63|        public nonisolated static func tokenScopeKey(draft: Draft) -> String {\n64|            \"\\(draft.scope.scopeKey):\\(draft.installDirName)\"\n65|        }\n66|    }\n67|}\n68|\n69|/// Authenticated user token for wizard API calls. Never logged.\n70|private struct FlowUserToken: Sendable {\n71|    let config: GitHubAuth.AppConfig\n72|    let token: String\n73|    let identity: GitHubSessionIdentity\n74|}\n75|\n76|extension RunnerRegistration.Flow: RunnerRegistration.IFlow {\n77|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n78|        guard let effect = effect as? RunnerRegistration.Effect else { return .success }\n79|        switch effect {\n80|        case .beginDraft(let draft): await beginDraft(draft)\n81|        case .updateDraft(let draft): await updateDraft(draft)\n82|        case .resolveGroup: await resolveGroup()\n83|        case .prepareDownload: await prepareDownload()\n84|        case .downloadAndInstall: await downloadAndInstall()\n85|        case .registerRunner: await registerRunner()\n86|        case .setupService: await setupService()\n87|        case .applyRepositoryAccess(let groupID, let ids): await applyRepositoryAccess(groupID: groupID, ids: ids)\n88|        case .applyLabels(let labels): await applyLabels(labels)\n89|        case .retry: await retry()\n90|        case .cancel: await cancel()\n91|        case .reset: await reset()\n92|        case .dismissPermission: await action { RunnerRegistration.Action.permissionDismissed }\n93|        }\n94|        return .success\n95|    }\n96|\n97|    private func isStale(_ gen: Int) -> Bool { generation != gen }\n98|\n99|    // MARK: - Draft\n100|\n101|    private func beginDraft(_ draft: RunnerRegistration.Draft) async {\n102|        do {\n103|            try RunnerRegistration.Gates.validateDraft(draft)\n104|        } catch {\n105|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"beginDraft\") }\n106|            return\n107|        }\n108|        self.draft = draft\n109|        group = nil\n110|        asset = nil\n111|        installPath = nil\n112|        runnerID = nil\n113|        failedStep = nil\n114|        await action { RunnerRegistration.Action.draftBegan(draft) }\n115|    }\n116|\n117|    private func updateDraft(_ draft: RunnerRegistration.Draft) async {\n118|        do {\n119|            try RunnerRegistration.Gates.validateDraft(draft)\n120|        } catch {\n121|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"updateDraft\") }\n122|            return\n123|        }\n124|        // A scope change invalidates resolved group/download state.\n125|        if self.draft?.scope != draft.scope {\n126|            group = nil\n127|            asset = nil\n128|        }\n129|        self.draft = draft\n130|        await action { RunnerRegistration.Action.draftUpdated(draft) }\n131|    }\n132|\n133|    // MARK: - Auth\n134|\n135|    private func currentUserToken(generation gen: Int) async throws -> FlowUserToken {\n136|        guard let identity = await identities.load() else {\n137|            throw RunnerRegistration.RegistrationError.notAuthenticated\n138|        }\n139|        let config = try configProvider(identity.serverHost)\n140|        guard var record = await userStore.load(\n141|            serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID\n142|        ) else {\n143|            throw RunnerRegistration.RegistrationError.notAuthenticated\n144|        }\n145|        guard !isStale(gen) else { throw CancellationError() }\n146|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n147|            do {\n148|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n149|            } catch is CancellationError {\n150|                throw CancellationError()\n151|            } catch let error as GitHubAuth.AuthError {\n152|                switch error {\n153|                case .revoked, .unauthorized, .tokenRefreshFailed:\n154|                    throw RunnerRegistration.RegistrationError.unauthorized\n155|                default:\n156|                    break\n157|                }\n158|            }\n159|            guard !isStale(gen) else { throw CancellationError() }\n160|        }\n161|        return FlowUserToken(config: config, token: record.accessToken, identity: identity)\n162|    }\n163|\n164|    private func fail(_ error: Error, step: String, generation gen: Int) async {\n165|        guard !isStale(gen) else { return }\n166|        failedStep = step\n167|        if error is CancellationError { return }\n168|        if let reg = error as? RunnerRegistration.RegistrationError {\n169|            switch reg {\n170|            case .missingPermission, .forbidden:\n171|                await action {\n172|                    RunnerRegistration.Action.permissionDenied(message: reg.localizedDescription, step: step)\n173|                }\n174|                return\n175|            default:\n176|                break\n177|            }\n178|        }\n179|        let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n180|        await action { RunnerRegistration.Action.failed(message: message, step: step) }\n181|    }\n182|\n183|    private func finishStep(_ step: String, generation gen: Int) async {\n184|        guard !isStale(gen) else { return }\n185|        failedStep = nil\n186|        working = false\n187|        await action { RunnerRegistration.Action.stepFinished(step) }\n188|    }\n189|\n190|    // MARK: - Group\n191|\n192|    private func resolveGroup() async {\n193|        let gen = generation\n194|        guard !working else { return }\n195|        guard let draft else {\n196|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"resolveGroup\") }\n197|            return\n198|        }\n199|        do {\n200|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n201|        } catch {\n202|            failedStep = \"resolveGroup\"\n203|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"resolveGroup\") }\n204|            return\n205|        }\n206|        guard case .organization(let org) = draft.scope else { return }\n207|        working = true\n208|        await action { RunnerRegistration.Action.stepStarted(\"resolveGroup\") }\n209|        do {\n210|            let auth = try await currentUserToken(generation: gen)\n211|            guard !isStale(gen) else { return }\n212|            let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n213|            guard !isStale(gen) else { return }\n214|            let name = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n215|            let resolved: RunnerRegistration.RunnerGroup\n216|            if let existing = groups.first(where: { $0.name == name }) {\n217|                resolved = existing\n218|            } else {\n219|                resolved = try await api.createGroup(\n220|                    config: auth.config, token: auth.token, org: org,\n221|                    name: name, selectedRepositoryIDs: draft.selectedRepositoryIDs\n222|                )\n223|            }\n224|            guard !isStale(gen) else { return }\n225|            let repoIDs = try await api.fetchGroupRepositories(\n226|                config: auth.config, token: auth.token, org: org, groupID: resolved.id\n227|            )\n228|            guard !isStale(gen) else { return }\n229|            group = resolved\n230|            await action { RunnerRegistration.Action.groupResolved(resolved, repositoryIDs: repoIDs) }\n231|            guard !isStale(gen) else { return }\n232|            await action { RunnerRegistration.Action.permissionDismissed }\n233|            await finishStep(\"resolveGroup\", generation: gen)\n234|        } catch {\n235|            working = false\n236|            await fail(error, step: \"resolveGroup\", generation: gen)\n237|        }\n238|    }\n239|\n240|    // MARK: - Download\n241|\n242|    private func prepareDownload() async {\n243|        let gen = generation\n244|        guard !working else { return }\n245|        guard let draft else {\n246|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"prepareDownload\") }\n247|            return\n248|        }\n249|        working = true\n250|        await action { RunnerRegistration.Action.stepStarted(\"prepareDownload\") }\n251|        do {\n252|            let found = try await prepareDownloadInner(draft: draft, generation: gen)\n253|            guard !isStale(gen) else { return }\n254|            asset = found\n255|            await action { RunnerRegistration.Action.downloadReady(found) }\n256|            await finishStep(\"prepareDownload\", generation: gen)\n257|        } catch {\n258|            working = false\n259|            await fail(error, step: \"prepareDownload\", generation: gen)\n260|        }\n261|    }\n262|\n263|    private func prepareDownloadInner(\n264|        draft: RunnerRegistration.Draft, generation gen: Int\n265|    ) async throws -> RunnerRegistration.DownloadAsset {\n266|        let auth = try await currentUserToken(generation: gen)\n267|        guard !isStale(gen) else { throw CancellationError() }\n268|        let assets = try await api.fetchDownloads(config: auth.config, token: auth.token, scope: draft.scope)\n269|        guard !isStale(gen) else { throw CancellationError() }\n270|        return try RunnerRegistration.Gates.selectDownload(\n271|            osName: RunnerInstallerService.installOS,\n272|            arch: installer.architecture,\n273|            from: assets\n274|        )\n275|    }\n276|\n277|    // MARK: - Install\n278|\n279|    private func downloadAndInstall() async {\n280|        let gen = generation\n281|        guard !working else { return }\n282|        guard let draft else {\n283|            await action {\n284|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"downloadAndInstall\")\n285|            }\n286|            return\n287|        }\n288|        working = true\n289|        await action { RunnerRegistration.Action.stepStarted(\"downloadAndInstall\") }\n290|        do {\n291|            let resolved: RunnerRegistration.DownloadAsset\n292|            if let asset {\n293|                resolved = asset\n294|            } else {\n295|                resolved = try await prepareDownloadInner(draft: draft, generation: gen)\n296|                guard !isStale(gen) else { return }\n297|                asset = resolved\n298|                await action { RunnerRegistration.Action.downloadReady(resolved) }\n299|            }\n300|            guard !isStale(gen) else { return }\n301|            let directory = try await installer.downloadAndInstall(asset: resolved, draft: draft)\n302|            guard !isStale(gen) else { return }\n303|            installPath = directory.path\n304|            await action { RunnerRegistration.Action.installed(path: directory.path) }\n305|            await finishStep(\"downloadAndInstall\", generation: gen)\n306|        } catch {\n307|            working = false\n308|            await fail(error, step: \"downloadAndInstall\", generation: gen)\n309|        }\n310|    }\n311|\n312|    // MARK: - Register\n313|\n314|    private func registerRunner() async {\n315|        let gen = generation\n316|        guard !working else { return }\n317|        guard let draft else {\n318|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"registerRunner\") }\n319|            return\n320|        }\n321|        guard let installPath else {\n322|            failedStep = \"registerRunner\"\n323|            await action {\n324|                RunnerRegistration.Action.failed(message: \"Install the runner package first.\", step: \"registerRunner\")\n325|            }\n326|            return\n327|        }\n328|        working = true\n329|        await action { RunnerRegistration.Action.stepStarted(\"registerRunner\") }\n330|        let directory = URL(fileURLWithPath: installPath)\n331|        let scopeKey = Self.tokenScopeKey(draft: draft)\n332|        do {\n333|            // Idempotent resume: an already-configured directory never mints\n334|            // a second registration token or a duplicate GitHub registration.\n335|            if await installer.hasCompleted(RunnerInstallerService.stepConfigured, directory: directory) {\n336|                let localID = await installer.readAgentID(directory: directory)\n337|                let remoteID = try await resolveRemoteRunnerID(draft: draft, generation: gen)\n338|                guard !isStale(gen) else { return }\n339|                runnerID = remoteID\n340|                await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: localID) }\n341|                await finishStep(\"registerRunner\", generation: gen)\n342|                return\n343|            }\n344|            let auth = try await currentUserToken(generation: gen)\n345|            guard !isStale(gen) else { return }\n346|            let created = try await api.createRegistrationToken(\n347|                config: auth.config, token: auth.token, scope: draft.scope\n348|            )\n349|            guard !isStale(gen) else { return }\n350|            let scoped = RunnerRegistration.ScopedToken(\n351|                token: created.token, expiresAt: created.expiresAt, obtainedAt: now()\n352|            )\n353|            try await registrationTokens.save(scoped, scopeKey: scopeKey)\n354|            guard !isStale(gen) else { return }\n355|            let groupName: String?\n356|            switch draft.scope {\n357|            case .organization: groupName = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n358|            case .repository: groupName = nil\n359|            }\n360|            let localID: Int64?\n361|            do {\n362|                localID = try await installer.runConfig(\n363|                    directory: directory,\n364|                    scopeURL: draft.scope.configURL(serverHost: auth.identity.serverHost),\n365|                    token: created.token,\n366|                    draft: draft,\n367|                    runnerGroup: groupName\n368|                )\n369|            } catch {\n370|                await registrationTokens.delete(scopeKey: scopeKey)\n371|                throw error\n372|            }\n373|            guard !isStale(gen) else { return }\n374|            let remoteID = try await resolveRemoteRunnerID(draft: draft, generation: gen)\n375|            guard !isStale(gen) else { return }\n376|            await registrationTokens.delete(scopeKey: scopeKey)\n377|            guard !isStale(gen) else { return }\n378|            runnerID = remoteID\n379|            await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: localID) }\n380|            guard !isStale(gen) else { return }\n381|            await action { RunnerRegistration.Action.permissionDismissed }\n382|            await finishStep(\"registerRunner\", generation: gen)\n383|        } catch {\n384|            working = false\n385|            await fail(error, step: \"registerRunner\", generation: gen)\n386|        }\n387|    }\n388|\n389|    /// Fetches the real GitHub runner ID by matching the registered name.\n390|    /// Returns nil when the runner list does not (yet) contain it.\n391|    private func resolveRemoteRunnerID(draft: RunnerRegistration.Draft, generation gen: Int) async throws -> Int64? {\n392|        let auth = try await currentUserToken(generation: gen)\n393|        guard !isStale(gen) else { throw CancellationError() }\n394|        let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n395|        let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n396|        return runners.first(where: { $0.name == wanted })?.id\n397|    }\n398|\n399|    // MARK: - Service\n400|\n401|    private func setupService() async {\n402|        let gen = generation\n403|        guard !working else { return }\n404|        guard let draft, let installPath else {\n405|            await action {\n406|                RunnerRegistration.Action.failed(message: \"Register the runner first.\", step: \"setupService\")\n407|            }\n408|            return\n409|        }\n410|        working = true\n411|        await action { RunnerRegistration.Action.stepStarted(\"setupService\") }\n412|        do {\n413|            let directory = URL(fileURLWithPath: installPath)\n414|            let label = Self.serviceLabel(draft: draft)\n415|            let plist = try await installer.setupService(directory: directory, label: label)\n416|            guard !isStale(gen) else { return }\n417|            await action { RunnerRegistration.Action.serviceReady(plistPath: plist.path) }\n418|            await finishStep(\"setupService\", generation: gen)\n419|        } catch {\n420|            working = false\n421|            await fail(error, step: \"setupService\", generation: gen)\n422|        }\n423|    }\n424|\n425|    // MARK: - Editable access and labels\n426|\n427|    private func applyRepositoryAccess(groupID: Int64, ids: Set<Int64>) async {\n428|        let gen = generation\n429|        guard !working else { return }\n430|        guard let draft else {\n431|            await action {\n432|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyRepositoryAccess\")\n433|            }\n434|            return\n435|        }\n436|        do {\n437|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n438|            guard case .organization(let org) = draft.scope else { return }\n439|            guard let group else {\n440|                failedStep = \"applyRepositoryAccess\"\n441|                await action {\n442|                    RunnerRegistration.Action.failed(\n443|                        message: \"Resolve the dedicated group first.\", step: \"applyRepositoryAccess\"\n444|                    )\n445|                }\n446|                return\n447|            }\n448|            try RunnerRegistration.Gates.authorizeGroupMutation(\n449|                targetGroupID: groupID, resolvedGroupID: group.id,\n450|                allowFlag: draft.allowGroupMutation\n451|            )\n452|            working = true\n453|            pendingRepositoryIDs = ids\n454|            pendingTargetGroupID = groupID\n455|            await action { RunnerRegistration.Action.stepStarted(\"applyRepositoryAccess\") }\n456|            let auth = try await currentUserToken(generation: gen)\n457|            guard !isStale(gen) else { return }\n458|            try await api.setGroupRepositories(\n459|                config: auth.config, token: auth.token, org: org, groupID: group.id, selectedRepositoryIDs: ids\n460|            )\n461|            guard !isStale(gen) else { return }\n462|            let confirmed = try await api.fetchGroupRepositories(\n463|                config: auth.config, token: auth.token, org: org, groupID: group.id\n464|            )\n465|            guard !isStale(gen) else { return }\n466|            if var current = self.draft {\n467|                current.selectedRepositoryIDs = Set(confirmed)\n468|                self.draft = current\n469|            }\n470|            await action { RunnerRegistration.Action.repositoryAccessApplied(confirmed) }\n471|            guard !isStale(gen) else { return }\n472|            await action { RunnerRegistration.Action.permissionDismissed }\n473|            pendingRepositoryIDs = nil\n474|            pendingTargetGroupID = nil\n475|            await finishStep(\"applyRepositoryAccess\", generation: gen)\n476|        } catch {\n477|            working = false\n478|            await fail(error, step: \"applyRepositoryAccess\", generation: gen)\n479|        }\n480|    }\n481|\n482|    private func applyLabels(_ labels: [String]) async {\n483|        let gen = generation\n484|        guard !working else { return }\n485|        guard let draft else {\n486|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyLabels\") }\n487|            return\n488|        }\n489|        let trimmed = labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }\n490|        guard !trimmed.isEmpty else {\n491|            failedStep = \"applyLabels\"\n492|            await action {\n493|                RunnerRegistration.Action.failed(message: \"At least one label is required.\", step: \"applyLabels\")\n494|            }\n495|            return\n496|        }\n497|        working = true\n498|        pendingLabels = trimmed\n499|        await action { RunnerRegistration.Action.stepStarted(\"applyLabels\") }\n500|        do {\n(more lines below)","final_result":true}}}
