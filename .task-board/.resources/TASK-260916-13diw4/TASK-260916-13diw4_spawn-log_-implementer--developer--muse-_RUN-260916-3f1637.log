{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc75","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":1173,"recorded_at":1780531400002341,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"task_stream":{"kind":"task","id":"01a0a880-d99d-7a62-8339-174ff0a6899d"},"task_id":"01a0a880-d99d-7a62-8339-174ff0a6899d","event":{"kind":"output","task_id":"01a0a880-d99d-7a62-8339-174ff0a6899d","chunk":"edited\nchanged lines: lines 231-232\n--- original\n+++ updated\n@@\n-    /// Reads the local agent ID from `.runner` without touching credentials.\n-    public func readAgentID(directory: URL) -> Int64? {\n+    // MARK: - Dedicated-group ownership\n+\n+    public static let ownershipFileName = \".runnercontrol-groups.json\"\n+\n+    private func ownershipFile() -> URL {\n+        installRoot.appendingPathComponent(Self.ownershipFileName)\n+    }\n+\n+    private static func ownershipKey(org: String, name: String) -> String {\n+        \"\\(org.lowercased())\\u{0}\\(name)\"\n+    }\n+\n+    /// Returns the locally recorded dedicated-group ID for `org` + `name`,\n+    /// or nil when this Mac never created (or took over) that group. Name\n+    /// matches on GitHub alone never count as ownership.\n+    public func loadOwnedGroupID(org: String, name: String) -> Int64? {\n+        guard let data = try? Data(contentsOf: ownershipFile()),\n+              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n+        return table[Self.ownershipKey(org: org, name: name)]\n+    }\n+\n+    public func saveOwnedGroupID(org: String, name: String, groupID: Int64) throws {\n+        let file = ownershipFile()\n+        var table: [String: Int64] = [:]\n+        if let data = try? Data(contentsOf: file),\n+           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n+            table = decoded\n+        }\n+        table[Self.ownershipKey(org: org, name: name)] = groupID\n+        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n+        let data = try JSONEncoder().encode(table)\n+        try data.write(to: file, options: .atomic)\n+    }\n+\n+    /// Reads the local agent ID from `.runner` without touching credentials.\n+    public func readAgentID(directory: URL) -> Int64? {\n","final_result":true}}}
