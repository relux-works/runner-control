{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e3","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":204,"recorded_at":1780531400000403,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"task_stream":{"kind":"task","id":"01a0a87c-0740-7c80-ac66-238def08195f"},"task_id":"01a0a87c-0740-7c80-ac66-238def08195f","event":{"kind":"output","task_id":"01a0a87c-0740-7c80-ac66-238def08195f","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+State+Reducer.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension RunnerRegistration.State {\n5|    public func reduce(with action: any Relux.Action) async {\n6|        guard let action = action as? RunnerRegistration.Action else { return }\n7|        if reduceDraftAction(action) { return }\n8|        if reduceProgressAction(action) { return }\n9|        await reduceResultAction(action)\n10|    }\n11|\n12|    /// Draft lifecycle actions. Returns true when the action was handled.\n13|    private func reduceDraftAction(_ action: RunnerRegistration.Action) -> Bool {\n14|        switch action {\n15|        case .draftBegan(let draft):\n16|            self.draft = draft\n17|            phase = .drafting\n18|            error = nil\n19|            failedStep = nil\n20|        case .draftUpdated(let draft):\n21|            self.draft = draft\n22|            // Draft edits retain the permission error by design.\n23|            if error != nil, permissionError == nil {\n24|                error = nil\n25|                failedStep = nil\n26|            }\n27|        case .cancelled:\n28|            working = false\n29|            error = nil\n30|            failedStep = nil\n31|        default:\n32|            return false\n33|        }\n34|        return true\n35|    }\n36|\n37|    /// Step progress actions. Returns true when the action was handled.\n38|    private func reduceProgressAction(_ action: RunnerRegistration.Action) -> Bool {\n39|        switch action {\n40|        case .stepStarted(let step):\n41|            working = true\n42|            error = nil\n43|            failedStep = nil\n44|            reducePhase(step)\n45|        case .stepFinished(let step):\n46|            working = false\n47|            completedSteps.insert(step)\n48|        case .permissionDismissed:\n49|            permissionError = nil\n50|        default:\n51|            return false\n52|        }\n53|        return true\n54|    }\n55|\n56|    private func reducePhase(_ step: String) {\n57|        switch step {\n58|        case \"resolveGroup\": phase = .resolvingGroup\n59|        case \"prepareDownload\": phase = .preparingDownload\n60|        case \"downloadAndInstall\": phase = .installing\n61|        case \"registerRunner\": phase = .registering\n62|        case \"setupService\": phase = .settingUpService\n63|        default: break\n64|        }\n65|    }\n66|\n67|    /// Fetched results, failures, and reset.\n68|    private func reduceResultAction(_ action: RunnerRegistration.Action) async {\n69|        if reduceFetchResult(action) { return }\n70|        switch action {\n71|        case .failed(let message, let step):\n72|            working = false\n73|            error = message\n74|            failedStep = step\n75|        case .permissionDenied(let message, let step):\n76|            working = false\n77|            error = message\n78|            failedStep = step\n79|            permissionError = message\n80|        case .didReset:\n81|            await cleanup()\n82|        default:\n83|            break\n84|        }\n85|    }\n86|\n87|    /// Fetched values applied to state. Returns true when handled.\n88|    private func reduceFetchResult(_ action: RunnerRegistration.Action) -> Bool {\n89|        switch action {\n90|        case .groupResolved(let group, let repositoryIDs):\n91|            self.group = group\n92|            groupRepositoryIDs = repositoryIDs\n93|        case .downloadReady(let asset):\n94|            self.asset = asset\n95|        case .installed(let path):\n96|            installPath = path\n97|        case .registered(let runnerID, let localAgentID):\n98|            self.runnerID = runnerID\n99|            self.localAgentID = localAgentID\n100|        case .serviceReady:\n101|            phase = .done\n102|        case .repositoryAccessApplied(let ids):\n103|            groupRepositoryIDs = ids\n104|            syncDraftRepositories(ids)\n105|        case .labelsApplied(let labels):\n106|            syncDraftLabels(labels)\n107|        default:\n108|            return false\n109|        }\n110|        return true\n111|    }\n112|\n113|    private func syncDraftRepositories(_ ids: [Int64]) {\n114|        if var current = draft {\n115|            current.selectedRepositoryIDs = Set(ids)\n116|            draft = current\n117|        }\n118|    }\n119|\n120|    private func syncDraftLabels(_ labels: [String]) {\n121|        if var current = draft {\n122|            current.labels = labels\n123|            draft = current\n124|        }\n125|    }\n126|}","final_result":true}}}
