{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c553","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":260,"recorded_at":1780531400000515,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"task_stream":{"kind":"task","id":"01a0a87c-206d-7cd2-8daa-9fe7c0f89f13"},"task_id":"01a0a87c-206d-7cd2-8daa-9fe7c0f89f13","event":{"kind":"output","task_id":"01a0a87c-206d-7cd2-8daa-9fe7c0f89f13","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistrationTokenStore.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Short-lived registration token. Lives in Keychain + Flow actor\n5|    /// privates only; never enters Relux state, logs, or diagnostics.\n6|    public struct ScopedToken: Sendable, Equatable, Codable {\n7|        public let token: String\n8|        public let expiresAt: Date?\n9|        public let obtainedAt: Date\n10|        public init(token: String, expiresAt: Date?, obtainedAt: Date = Date()) {\n11|            self.token = token; self.expiresAt = expiresAt; self.obtainedAt = obtainedAt\n12|        }\n13|        public var isExpired: Bool {\n14|            guard let expiresAt else { return false }\n15|            return expiresAt <= Date()\n16|        }\n17|    }\n18|}\n19|\n20|/// Keychain boundary for scoped short-lived registration tokens.\n21|public protocol RunnerRegistrationTokenStoring: Sendable {\n22|    func save(_ token: RunnerRegistration.ScopedToken, scopeKey: String) async throws\n23|    func load(scopeKey: String) async -> RunnerRegistration.ScopedToken?\n24|    func delete(scopeKey: String) async\n25|}\n26|\n27|public actor RunnerRegistrationTokenStore: RunnerRegistrationTokenStoring {\n28|    private let backend: any KeychainBackend\n29|    private let service: String\n30|\n31|    public init(\n32|        service: String = \"works.relux.runnercontrol.runner-registration-token\",\n33|        backend: (any KeychainBackend)? = nil\n34|    ) {\n35|        self.service = service\n36|        self.backend = backend ?? SecurityKeychainBackend()\n37|    }\n38|\n39|    public func save(_ token: RunnerRegistration.ScopedToken, scopeKey: String) async throws {\n40|        let data = try JSONEncoder().encode(token)\n41|        try backend.save(data, service: service, account: scopeKey)\n42|    }\n43|\n44|    public func load(scopeKey: String) async -> RunnerRegistration.ScopedToken? {\n45|        guard let data = backend.load(service: service, account: scopeKey) else { return nil }\n46|        guard let decoded = try? JSONDecoder().decode(RunnerRegistration.ScopedToken.self, from: data) else {\n47|            return nil\n48|        }\n49|        if decoded.isExpired {\n50|            backend.delete(service: service, account: scopeKey)\n51|            return nil\n52|        }\n53|        return decoded\n54|    }\n55|\n56|    public func delete(scopeKey: String) async {\n57|        backend.delete(service: service, account: scopeKey)\n58|    }\n59|}\n60|\n61|/// In-memory registration-token backend for unit tests. Never used in production.\n62|public final class InMemoryRegistrationTokenBackend: KeychainBackend, @unchecked Sendable {\n63|    private let lock = NSLock()\n64|    private var storage: [String: Data] = [:]\n65|    public init() {}\n66|    private func key(service: String, account: String) -> String { \"\\(service)\\u{0}\\(account)\" }\n67|    public func save(_ data: Data, service: String, account: String) throws {\n68|        lock.withLock { storage[key(service: service, account: account)] = data }\n69|    }\n70|    public func load(service: String, account: String) -> Data? {\n71|        lock.withLock { storage[key(service: service, account: account)] }\n72|    }\n73|    public func delete(service: String, account: String) {\n74|        lock.withLock { _ = storage.removeValue(forKey: key(service: service, account: account)) }\n75|    }\n76|    public func deleteMatching(service: String, accountPrefix: String, accountSuffix: String) {\n77|        lock.withLock {\n78|            let prefix = \"\\(service)\\u{0}\\(accountPrefix)\"\n79|            let doomed = storage.keys.filter { $0.hasPrefix(prefix) && $0.hasSuffix(accountSuffix) }\n80|            for key in doomed {\n81|                storage.removeValue(forKey: key)\n82|            }\n83|        }\n84|    }\n85|}","final_result":true}}}
