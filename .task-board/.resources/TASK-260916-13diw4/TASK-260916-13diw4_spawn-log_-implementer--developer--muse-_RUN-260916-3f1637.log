-test\", \"labels\": []]]),\n1043|        jsonResponse([[\"id\": 1, \"name\": \"self-hosted\"]]),\n1044|    ])\n1045|    let harness = await registrationHarness(transport: transport)\n1046|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1047|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyLabels([\"self-hosted\", \"macOS\", \"gpu\"]))\n1048|    #expect(lastFailure(harness.logger)?.step == \"applyLabels\")\n1049|    _ = await harness.flow.apply(RunnerRegistration.Effect.retry)\n1050|    let applied = registrationActions(harness.logger).compactMap { action -> [String]? in\n1051|        if case .labelsApplied(let labels) = action { labels } else { nil }\n1052|    }\n1053|    #expect(applied.last == [\"self-hosted\", \"macOS\", \"gpu\"])\n1054|    let puts = await transport.requests.filter { $0.method == \"PUT\" }\n1055|    #expect(puts.count == 1)\n1056|    #expect(puts.first?.url.path.contains(\"/orgs/acme/actions/runners/77/labels\") ?? false)\n1057|}","final_result":true}}}
