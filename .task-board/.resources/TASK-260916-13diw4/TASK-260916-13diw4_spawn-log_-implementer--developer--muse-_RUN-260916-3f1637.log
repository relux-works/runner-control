e: String\n31|        public let isPrivate: Bool\n32|        public init(id: Int64, fullName: String, isPrivate: Bool) {\n33|            self.id = id; self.fullName = fullName; self.isPrivate = isPrivate\n34|        }\n35|    }\n36|\n37|    /// Connection phases. No tokens, device codes, or secrets are stored here.\n38|    public enum Connection: Sendable, Equatable {\n39|        case disconnected\n40|        case requestingCode\n41|        case awaitingUser(userCode: String, verificationURI: URL, expiresIn: Int, interval: Int)\n42|        case verifyingAccount\n43|        case verifyingInstallations(username: String)\n44|        case connected(username: String, serverHost: String)\n45|        case failed(message: String, retry: RetryKind)\n46|    }\n47|\n48|    public enum RetryKind: Sendable, Equatable {\n49|        case newCode\n50|        case retry\n51|        case relogin\n52|        case grantAccess\n53|        case none\n54|    }\n55|\n56|    public enum AuthError: LocalizedError, Sendable, Equatable {\n57|        case cancelled\n58|        case denied\n59|        case codeExpired\n60|        case slowDown\n61|        case authorizationPending\n62|        case network(String)\n63|        case unauthorized\n64|        case forbidden(String)\n65|        case rateLimited(retryAfter: Int?)\n66|        case needsInstallation\n67|        case needsApproval\n68|        case ssoRequired\n69|        case revoked\n70|        case missingClientID(binding: String)\n71|        case patNotSupported\n72|        case tokenRefreshFailed\n73|\n74|        public var errorDescription: String? {\n75|            switch self {\n76|            case .cancelled: \"Login cancelled.\"\n77|            case .denied: \"Access denied on GitHub. Approve Runner Control or try again.\"\n78|            case .codeExpired: \"Code expired. Get a new code.\"\n79|            case .slowDown: \"Polling too fast. Backing off.\"\n80|            case .authorizationPending: \"Waiting for confirmation on GitHub…\"\n81|            case .network(let message): message\n82|            case .unauthorized: \"Session expired or revoked (401). Sign in again.\"\n83|            case .forbidden(let message): message.isEmpty ? \"Access forbidden (403). Grant the App or approve access.\" : message\n84|            case .rateLimited: \"GitHub rate limit reached. Data may be stale; local control still works.\"\n85|            case .needsInstallation: \"GitHub App is not installed for this account. Grant access to continue.\"\n86|            case .needsApproval: \"Organization approval is required.\"\n87|            case .ssoRequired: \"SSO authorization is required for this organization.\"\n88|            case .revoked: \"Session was revoked. Sign in again.\"\n89|            case .missingClientID(let binding): \"GitHub App client_id is not provisioned. Missing binding: \\(binding).\"\n90|            case .patNotSupported: \"Personal access tokens are not supported. Use Sign in with GitHub (Device Flow).\"\n91|            case .tokenRefreshFailed: \"Token refresh failed. Sign in again.\"\n92|            }\n93|        }\n94|    }\n95|}","final_result":true}}}
