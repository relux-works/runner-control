{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e7","stream":{"kind":"session","id":"01a0a87b-9700-7b13-a5a9-4a460ed866b3"},"sequence":206,"recorded_at":1780531400000407,"record_type":"event","durability":"durable","causation_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"729941af-ea8e-4d7f-a339-63c28c483dc7","run_stream":{"kind":"run","id":"729941af-ea8e-4d7f-a339-63c28c483dc7"},"task_stream":{"kind":"task","id":"01a0a87c-07e5-7060-a545-c95dd05e16d0"},"task_id":"01a0a87c-07e5-7060-a545-c95dd05e16d0","event":{"kind":"output","task_id":"01a0a87c-07e5-7060-a545-c95dd05e16d0","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Gates.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Validation gates. Each gate refuses a concrete invalid class; negative\n5|    /// tests narrow every one of them.\n6|    public enum Gates {\n7|        /// Refuses install/work paths containing spaces. GitHub's own setup has\n8|        /// a known defect with spaced paths; the wizard never reproduces it.\n9|        public static func validateNoSpace(installDirName: String, workFolder: String) throws {\n10|            if installDirName.contains(\" \") {\n11|                throw RegistrationError.noSpacePath(\"Installation folder name must not contain spaces.\")\n12|            }\n13|            if installDirName.contains(\"/\") || installDirName.isEmpty {\n14|                throw RegistrationError.invalidDraft(\"Installation folder name is invalid.\")\n15|            }\n16|            if workFolder.contains(\" \") {\n17|                throw RegistrationError.noSpacePath(\"Work folder must not contain spaces.\")\n18|            }\n19|            if workFolder.isEmpty || workFolder.contains(\"/\") {\n20|                throw RegistrationError.invalidDraft(\"Work folder name is invalid.\")\n21|            }\n22|        }\n23|\n24|        /// Validates the full draft before any network or filesystem mutation.\n25|        public static func validateDraft(_ draft: Draft) throws {\n26|            let name = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n27|            guard !name.isEmpty else {\n28|                throw RegistrationError.invalidDraft(\"Runner name must not be empty.\")\n29|            }\n30|            guard name.count <= 64 else {\n31|                throw RegistrationError.invalidDraft(\"Runner name is too long (max 64 characters).\")\n32|            }\n33|            let labels = draft.labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }\n34|            guard !labels.isEmpty else {\n35|                throw RegistrationError.invalidDraft(\"At least one label is required.\")\n36|            }\n37|            for label in labels {\n38|                guard !label.isEmpty else {\n39|                    throw RegistrationError.invalidDraft(\"Labels must not be empty.\")\n40|                }\n41|                guard label.count <= 100 else {\n42|                    throw RegistrationError.invalidDraft(\"Label '\\(label)' is too long (max 100 characters).\")\n43|                }\n44|            }\n45|            try validateNoSpace(installDirName: draft.installDirName, workFolder: draft.workFolder)\n46|            switch draft.scope {\n47|            case .organization:\n48|                let group = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n49|                guard !group.isEmpty else {\n50|                    throw RegistrationError.invalidDraft(\"Organization runners need a dedicated per-Mac group name.\")\n51|                }\n52|            case .repository:\n53|                break\n54|            }\n55|        }\n56|\n57|        /// Picks the architecture-matched official asset. Refuses any\n58|        /// substitute: both OS and architecture must match exactly.\n59|        public static func selectDownload(\n60|            osName: String, arch: String, from assets: [DownloadAsset]\n61|        ) throws -> DownloadAsset {\n62|            guard let match = assets.first(where: { $0.osName == osName && $0.architecture == arch }) else {\n63|                throw RegistrationError.downloadMismatch(osName: osName, arch: arch)\n64|            }\n65|            return match\n66|        }\n67|\n68|        /// Authorizes a group mutation only when the UI explicitly scoped it\n69|        /// AND the target is this run's resolved dedicated group. Never\n70|        /// mutates unrelated or shared groups.\n71|        public static func authorizeGroupMutation(\n72|            targetGroupID: Int64, resolvedGroupID: Int64?, allowFlag: Bool\n73|        ) throws {\n74|            guard allowFlag else { throw RegistrationError.groupScopeNotConfirmed }\n75|            guard let resolved = resolvedGroupID, resolved == targetGroupID else {\n76|                throw RegistrationError.refusesSharedGroup(groupID: targetGroupID)\n77|            }\n78|        }\n79|\n80|        /// Repository scope never touches groups: personal repos get separate\n81|        /// installations without shared-group coupling.\n82|        public static func requireOrganizationScope(_ scope: Scope) throws {\n83|            if case .organization = scope { return }\n84|            throw RegistrationError.groupNotApplicable\n85|        }\n86|    }\n87|\n88|    /// Exact `config.sh` invocation inputs.\n89|    public struct ConfigSpec: Sendable, Equatable {\n90|        let scopeURL: String\n91|        let token: String\n92|        let name: String\n93|        let workFolder: String\n94|        let labels: [String]\n95|        let runnerGroup: String?\n96|    }\n97|\n98|    /// Exact `config.sh` invocation builder. Argument order is fixed and\n99|    /// covered by tests; production runs this exact array.\n100|    public enum ConfigInvocation {\n101|        public static func arguments(_ spec: ConfigSpec) -> [String] {\n102|            var args = [\n103|                \"--url\", spec.scopeURL,\n104|                \"--token\", spec.token,\n105|                \"--name\", spec.name,\n106|                \"--work\", spec.workFolder,\n107|                \"--labels\", spec.labels.joined(separator: \",\")\n108|            ]\n109|            if let group = spec.runnerGroup, !group.isEmpty {\n110|                args += [\"--runnergroup\", group]\n111|            }\n112|            args += [\"--unattended\", \"--replace\"]\n113|            return args\n114|        }\n115|    }\n116|}","final_result":true}}}
