ase .forbidden(let text) = error {\n320|                throw RunnerRegistration.RegistrationError.missingPermission(writeHelp(scope: scope, detail: text))\n321|            }\n322|            throw error\n323|        }\n324|    }\n325|}\n326|\n327|// MARK: - DTOs\n328|\n329|private struct RunnerDownloadDTO: Decodable, Sendable {\n330|    let os: String\n331|    let architecture: String\n332|    let download_url: String\n333|    let filename: String\n334|    let sha256_checksum: String?\n335|}\n336|\n337|private struct RegistrationTokenDTO: Decodable, Sendable {\n338|    let token: String\n339|    let expires_at: String?\n(more lines below)","final_result":true}}}
