{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ad","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":305,"recorded_at":1780531400000605,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"call_id":"call_01a0a85aef8b715c89a19b284dfa98f4","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubTransport.swift`.\n1|import Foundation\n2|\n3|/// Minimal HTTP boundary for GitHub Device Flow and REST. Keeps URLSession out of business logic.\n4|public protocol GitHubHTTPTransport: Sendable {\n5|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse\n6|}\n7|\n8|public struct GitHubHTTPRequest: Sendable {\n9|    public let method: String\n10|    public let url: URL\n11|    public let headers: [String: String]\n12|    public let body: Data?\n13|    public init(method: String, url: URL, headers: [String: String] = [:], body: Data? = nil) {\n14|        self.method = method; self.url = url; self.headers = headers; self.body = body\n15|    }\n16|}\n17|\n18|public struct GitHubHTTPResponse: Sendable {\n19|    public let status: Int\n20|    public let headers: [String: String]\n21|    public let body: Data\n22|    public init(status: Int, headers: [String: String] = [:], body: Data = Data()) {\n23|        self.status = status; self.headers = headers; self.body = body\n24|    }\n25|}\n26|\n27|public enum GitHubTransportError: LocalizedError, Sendable, Equatable {\n28|    case offline\n29|    case invalidResponse\n30|    public var errorDescription: String? {\n31|        switch self {\n32|        case .offline: \"Network unavailable. Local runner control still works.\"\n33|        case .invalidResponse: \"Unexpected GitHub response.\"\n34|        }\n35|    }\n36|}\n37|\n38|extension GitHubAuth {\n39|    // MARK: - Device DTOs\n40|\n41|    public struct DeviceCodeRequest: Encodable, Sendable {\n42|        public let client_id: String\n43|        public init(client_id: String) { self.client_id = client_id }\n44|    }\n45|\n46|    public struct DeviceCodeResponse: Decodable, Sendable {\n47|        public let device_code: String\n48|        public let user_code: String\n49|        public let verification_uri: String\n50|        public let expires_in: Int\n51|        public let interval: Int\n52|        public init(device_code: String, user_code: String, verification_uri: String, expires_in: Int, interval: Int) {\n53|            self.device_code = device_code; self.user_code = user_code; self.verification_uri = verification_uri\n54|            self.expires_in = expires_in; self.interval = interval\n55|        }\n56|    }\n57|\n58|    public struct TokenPollRequest: Encodable, Sendable {\n59|        public let client_id: String\n60|        public let device_code: String\n61|        public let grant_type: String\n62|        public init(client_id: String, device_code: String, grant_type: String) {\n63|            self.client_id = client_id; self.device_code = device_code; self.grant_type = grant_type\n64|        }\n65|    }\n66|\n67|    public struct TokenRefreshRequest: Encodable, Sendable {\n68|        public let client_id: String\n69|        public let grant_type: String\n70|        public let refresh_token: String\n71|        public init(client_id: String, grant_type: String, refresh_token: String) {\n72|            self.client_id = client_id; self.grant_type = grant_type; self.refresh_token = refresh_token\n73|        }\n74|    }\n75|\n76|    public struct TokenSuccessResponse: Decodable, Sendable {\n77|        public let access_token: String?\n78|        public let refresh_token: String?\n79|        public let expires_in: Int?\n80|        public let token_type: String?\n81|        public let error: String?\n82|        public let error_description: String?\n83|        public let interval: Int?\n84|        public init(access_token: String? = nil, refresh_token: String? = nil, expires_in: Int? = nil, token_type: String? = nil, error: String? = nil, error_description: String? = nil, interval: Int? = nil) {\n85|            self.access_token = access_token; self.refresh_token = refresh_token; self.expires_in = expires_in\n86|            self.token_type = token_type; self.error = error; self.error_description = error_description; self.interval = interval\n87|        }\n88|    }\n89|\n90|    public struct UserResponse: Decodable, Sendable {\n91|        public let login: String\n92|        public let id: Int64\n93|        public init(login: String, id: Int64) { self.login = login; self.id = id }\n94|    }\n95|\n96|    public struct InstallationsResponse: Decodable, Sendable {\n97|        public let installations: [InstallationDTO]\n98|        public init(installations: [InstallationDTO]) { self.installations = installations }\n99|    }\n100|\n101|    public struct InstallationDTO: Decodable, Sendable {\n102|        public let id: Int64\n103|        public let account: AccountDTO\n104|        public init(id: Int64, account: AccountDTO) { self.id = id; self.account = account }\n105|    }\n106|\n107|    public struct AccountDTO: Decodable, Sendable {\n108|        public let login: String\n109|        public let type: String\n110|        public init(login: String, type: String) { self.login = login; self.type = type }\n111|    }\n112|\n113|    public struct RepositoriesResponse: Decodable, Sendable {\n114|        public let repositories: [RepositoryDTO]\n115|        public init(repositories: [RepositoryDTO]) { self.repositories = repositories }\n116|    }\n117|\n118|    public struct RepositoryDTO: Decodable, Sendable {\n119|        public let id: Int64\n120|        public let full_name: String\n121|        public let `private`: Bool\n122|        public init(id: Int64, full_name: String, isPrivate: Bool) { self.id = id; self.full_name = full_name; self.private = isPrivate }\n123|    }\n124|}\n125|\n126|/// Production URLSession transport. Never logs bodies (they may contain tokens).\n127|public actor URLSessionGitHubTransport: GitHubHTTPTransport {\n128|    private let session: URLSession\n129|    public init(session: URLSession = .shared) { self.session = session }\n130|    public func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n131|        var urlRequest = URLRequest(url: request.url)\n132|        urlRequest.httpMethod = request.method\n133|        urlRequest.httpBody = request.body\n134|        for (key, value) in request.headers { urlRequest.setValue(value, forHTTPHeaderField: key) }\n135|        let (data, response): (Data, URLResponse)\n136|        do {\n137|            (data, response) = try await session.data(for: urlRequest)\n138|        } catch {\n139|            throw GitHubTransportError.offline\n140|        }\n141|        guard let http = response as? HTTPURLResponse else { throw GitHubTransportError.invalidResponse }\n142|        var headers: [String: String] = [:]\n143|        for (key, value) in http.allHeaderFields {\n144|            if let k = key as? String, let v = value as? String { headers[k] = v }\n145|        }\n146|        return GitHubHTTPResponse(status: http.statusCode, headers: headers, body: data)\n147|    }\n148|}\n149|\n150|extension GitHubAuth {\n151|    /// Maps REST status codes to typed auth errors. Local runners are never touched here.\n152|    public enum RESTMapper {\n153|        public static func map(status: Int, body: Data) -> AuthError? {\n154|            if status == 401 { return .unauthorized }\n155|            if status == 403 {\n156|                let text = String(decoding: body, as: UTF8.self).lowercased()\n157|                if text.contains(\"saml\") || text.contains(\"sso\") { return .ssoRequired }\n158|                if text.contains(\"rate limit\") || text.contains(\"rate_limit\") { return .rateLimited(retryAfter: nil) }\n159|                let message = String(decoding: body, as: UTF8.self)\n160|                let short = String(message.prefix(300))\n161|                return .forbidden(short)\n162|            }\n163|            if status == 429 { return .rateLimited(retryAfter: nil) }\n164|            return nil\n165|        }\n166|    }\n167|\n168|    /// Rejects personal access tokens. Only Device Flow user tokens (ghu_) are accepted.\n169|    public enum PATGuard {\n170|        public static func validate(token: String) throws {\n171|            if token.hasPrefix(\"ghp_\") || token.hasPrefix(\"github_pat_\") {\n172|                throw AuthError.patNotSupported\n173|            }\n174|        }\n175|\n176|        public static func authorizationHeader(token: String) throws -> String {\n177|            try validate(token: token)\n178|            return \"Bearer \\(token)\"\n179|        }\n180|    }\n181|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5af","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":306,"recorded_at":1780531400000607,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"call_id":"call_01a0a85af0807070a8d763b23954181e","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRuntime.swift`.\n1|import Foundation\n2|import Relux\n3|import OSLog\n4|@MainActor public enum RunnerRuntime {\n5|    public static func make(state: Runners.State, service: any RunnerServicing = LaunchAgentService()) async -> Relux {\n6|        let runtime = await Relux(logger: RuntimeLogger())\n7|        let flow = await Runners.Flow(service: service, dispatcher: runtime.dispatcher)\n8|        runtime.register(Runners.Module(state: state, flow: flow))\n9|        return runtime\n10|    }\n11|\n12|    public static func make(\n13|        state: Runners.State,\n14|        githubState: GitHubAuth.State,\n15|        service: any RunnerServicing = LaunchAgentService(),\n16|        transport: any GitHubHTTPTransport = URLSessionGitHubTransport(),\n17|        store: any GitHubCredentialStoring = GitHubKeychainStore()\n18|    ) async -> Relux {\n19|        let runtime = await Relux(logger: RuntimeLogger())\n20|        let flow = await Runners.Flow(service: service, dispatcher: runtime.dispatcher)\n21|        runtime.register(Runners.Module(state: state, flow: flow))\n22|        let deviceFlow = GitHubDeviceFlow(transport: transport)\n23|        let api = GitHubAPIClient(transport: transport)\n24|        let refresher = GitHubTokenRefresh(transport: transport, store: store)\n25|        let githubFlow = await GitHubAuth.Flow(deviceFlow: deviceFlow, api: api, refresher: refresher, store: store, dispatcher: runtime.dispatcher)\n26|        runtime.register(GitHubAuth.Module(state: githubState, flow: githubFlow))\n27|        return runtime\n28|    }\n29|}\n30|struct RuntimeLogger: Relux.Logger {\n31|    func logAction(_ action: Relux.EnumReflectable, result: Relux.ActionResult?, startTimeInMillis: Int, privacy: Relux.OSLogPrivacy, fileID: String, functionName: String, lineNumber: Int) {\n32|        Logger(subsystem: \"works.relux.runnercontrol\", category: \"state\").debug(\"State event: \\(String(describing: type(of: action)), privacy: .public)\")\n33|    }\n34|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b1","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":307,"recorded_at":1780531400000609,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"call_id":"call_01a0a85af1b4718ea9a7d5a9c5d21d2d","text":"Read text file `Targets/RunnerControl/Sources/ManagementWindowPage.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|struct ManagementWindowPage: View {\n5|    let props: Props\n6|    let reactions: Reactions\n7|    @State private var selection: Tab = .runners\n8|\n9|    enum Tab: Hashable {\n10|        case runners, github, general\n11|    }\n12|\n13|    var body: some View {\n14|        TabView(selection: $selection) {\n15|            runnersTab\n16|                .tabItem { Label(\"Раннеры\", systemImage: \"bolt.circle\") }\n17|                .tag(Tab.runners)\n18|            githubTab\n19|                .tabItem { Label(\"GitHub\", systemImage: \"person.circle\") }\n20|                .tag(Tab.github)\n21|            generalTab\n22|                .tabItem { Label(\"Основные\", systemImage: \"gearshape\") }\n23|                .tag(Tab.general)\n24|        }\n25|        .frame(width: 760, height: 540)\n26|    }\n27|\n28|    // MARK: - Runners\n29|\n30|    private var active: Int { props.runners.filter { $0.status == .running }.count }\n31|\n32|    private var runnersTab: some View {\n33|        VStack(alignment: .leading, spacing: 14) {\n34|            HStack(spacing: 10) {\n35|                VStack(alignment: .leading, spacing: 3) {\n36|                    Text(\"Раннеры на этом Mac\").font(.system(size: 15, weight: .semibold))\n37|                    Text(\"\\(Host.current().localizedName ?? \"Этот Mac\") · \\(active) из \\(props.runners.count) включено\")\n38|                        .font(.system(size: 11)).foregroundStyle(.secondary)\n39|                }\n40|                Spacer()\n41|                Circle().fill(active > 0 ? Color.green : Color.secondary.opacity(0.4)).frame(width: 8, height: 8)\n42|            }\n43|            if props.runners.isEmpty {\n44|                VStack(alignment: .leading, spacing: 8) {\n45|                    Text(\"Добавьте раннер на этом Mac\").font(.callout.weight(.medium))\n46|                    Text(\"Учётная запись GitHub не обязательна. Локальное управление работает без входа.\")\n47|                        .font(.callout).foregroundStyle(.secondary)\n48|                }\n49|                .padding(.vertical, 8)\n50|            }\n51|            ScrollView {\n52|                VStack(spacing: 10) {\n53|                    ForEach(props.runners) { runner in\n54|                        RunnerCard(\n55|                            snapshot: runner,\n56|                            changing: props.changing.contains(runner.id),\n57|                            setEnabled: { reactions.setEnabled(runner.id, $0) },\n58|                            openGitHub: { reactions.openGitHub(runner.definition) },\n59|                            openLogs: { reactions.openLogs(runner.definition) }\n60|                        )\n61|                    }\n62|                }\n63|            }\n64|            if let error = props.runnerError {\n65|                HStack(alignment: .top, spacing: 8) {\n66|                    Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n67|                    Text(error).font(.caption).textSelection(.enabled).lineLimit(6)\n68|                    Spacer(minLength: 0)\n69|                    Button(action: reactions.clearRunnerError) { Image(systemName: \"xmark\") }.buttonStyle(.plain)\n70|                }.padding(10).background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n71|            }\n72|            HStack(spacing: 8) {\n73|                Button(\"Включить все\", action: reactions.enableAll)\n74|                    .buttonStyle(.borderedProminent).tint(.teal)\n75|                    .disabled(!props.changing.isEmpty || props.runners.allSatisfy { $0.status == .running || $0.status == .checking || $0.status == .missing || $0.status == .unknown })\n76|                Button(\"Выключить все…\", action: reactions.disableAll)\n77|                    .buttonStyle(.bordered)\n78|                    .disabled(!props.changing.isEmpty || props.runners.allSatisfy { $0.status == .stopped || $0.status == .checking })\n79|            }\n80|            Text(\"Закрытие приложения не останавливает CI. Автозапуск определяется настройками каждой службы.\")\n81|                .font(.system(size: 11)).foregroundStyle(.secondary)\n82|        }\n83|        .padding(20)\n84|    }\n85|\n86|    // MARK: - GitHub\n87|\n88|    private var githubTab: some View {\n89|        ScrollView {\n90|            VStack(alignment: .leading, spacing: 16) {\n91|                switch props.github.connection {\n92|                case .disconnected:\n93|                    disconnectedView\n94|                case .requestingCode:\n95|                    HStack(spacing: 10) {\n96|                        ProgressView().controlSize(.small)\n97|                        Text(\"Запрашиваем код входа…\").font(.callout)\n98|                    }\n99|                    .padding(.vertical, 20)\n100|                case .awaitingUser(let userCode, let uri, let expiresIn, let interval):\n101|                    awaitingView(userCode: userCode, uri: uri, expiresIn: expiresIn, interval: interval)\n102|                case .verifyingAccount:\n103|                    HStack(spacing: 10) {\n104|                        ProgressView().controlSize(.small)\n105|                        Text(\"Проверяем аккаунт…\").font(.callout)\n106|                    }\n107|                    .padding(.vertical, 20)\n108|                case .verifyingInstallations(let username):\n109|                    HStack(spacing: 10) {\n110|                        ProgressView().controlSize(.small)\n111|                        Text(\"Проверяем установки для @\\(username)…\").font(.callout)\n112|                    }\n113|                    .padding(.vertical, 20)\n114|                case .connected(let username, let host):\n115|                    connectedView(username: username, host: host)\n116|                case .failed(let message, let retry):\n117|                    failedView(message: message, retry: retry)\n118|                }\n119|            }\n120|            .padding(20)\n121|            .frame(maxWidth: .infinity, alignment: .leading)\n122|        }\n123|    }\n124|\n125|    private var disconnectedView: some View {\n126|        VStack(alignment: .leading, spacing: 12) {\n127|            Text(\"Подключение GitHub\").font(.system(size: 15, weight: .semibold))\n128|            Text(\"Необязательно. Локальное включение и выключение работает без входа. Вход добавляет подтверждённые online/busy/labels.\")\n129|                .font(.callout).foregroundStyle(.secondary)\n130|            HStack(spacing: 8) {\n131|                Text(\"Сервер:\").font(.callout)\n132|                TextField(\"github.com\", text: Binding(\n133|                    get: { props.github.serverHostText },\n134|                    set: reactions.serverHostChanged\n135|                ))\n136|                .textFieldStyle(.roundedBorder)\n137|                .frame(width: 220)\n138|                .accessibilityIdentifier(\"GitHub server host field\")\n139|            }\n140|            Button(\"Войти через GitHub\", action: reactions.beginLogin)\n141|                .buttonStyle(.borderedProminent).tint(.teal)\n142|                .accessibilityIdentifier(\"GitHub sign in button\")\n143|            Text(\"Откроется код подтверждения. Пароль и 2FA вводятся только на сайте GitHub. Токены хранятся в Keychain.\")\n144|                .font(.system(size: 11)).foregroundStyle(.secondary)\n145|            if let syncError = props.github.syncError {\n146|                Text(syncError).font(.caption).foregroundStyle(.orange)\n147|            }\n148|        }\n149|    }\n150|\n151|    private func awaitingView(userCode: String, uri: URL, expiresIn: Int, interval: Int) -> some View {\n152|        VStack(alignment: .leading, spacing: 12) {\n153|            Text(\"Подтвердите подключение на GitHub\").font(.system(size: 15, weight: .semibold))\n154|            Text(userCode)\n155|                .font(.system(size: 32, weight: .bold, design: .monospaced))\n156|                .textSelection(.enabled)\n157|                .accessibilityIdentifier(\"GitHub user code\")\n158|            Text(\"Код действует ~\\(expiresIn / 60) мин. Опрос каждые \\(interval) c.\")\n159|                .font(.callout).foregroundStyle(.secondary)\n160|            HStack(spacing: 8) {\n161|                Button(\"Скопировать код\") { reactions.copyCode(userCode) }\n162|                    .buttonStyle(.bordered)\n163|                    .accessibilityIdentifier(\"GitHub copy code button\")\n164|                Button(\"Открыть GitHub\") { reactions.openVerification(uri) }\n165|                    .buttonStyle(.bordered)\n166|                    .accessibilityIdentifier(\"GitHub open verification button\")\n167|                Button(\"Отмена\", action: reactions.cancelLogin)\n168|                    .buttonStyle(.plain).foregroundStyle(.secondary)\n169|                    .accessibilityIdentifier(\"GitHub cancel login button\")\n170|            }\n171|            Text(\"Браузер — системный по умолчанию. Отмена уничтожает временный код и прекращает опрос.\")\n172|                .font(.system(size: 11)).foregroundStyle(.secondary)\n173|        }\n174|    }\n175|\n176|    private func connectedView(username: String, host: String) -> some View {\n177|        VStack(alignment: .leading, spacing: 12) {\n178|            HStack {\n179|                VStack(alignment: .leading, spacing: 3) {\n180|                    Text(\"Подключено как @\\(username)\").font(.system(size: 15, weight: .semibold))\n181|                    Text(host).font(.callout).foregroundStyle(.secondary)\n182|                    if let synced = props.github.lastSyncAt {\n183|                        Text(\"Обновлено: \\(synced.formatted(date: .omitted, time: .standard))\")\n184|                            .font(.system(size: 11)).foregroundStyle(.secondary)\n185|                    }\n186|                }\n187|                Spacer()\n188|                Button(\"Обновить\", action: reactions.refreshInstallations)\n189|                    .buttonStyle(.bordered).controlSize(.small)\n190|                    .accessibilityIdentifier(\"GitHub refresh button\")\n191|            }\n192|            if let syncError = props.github.syncError {\n193|                HStack(alignment: .top, spacing: 8) {\n194|                    Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n195|                    Text(syncError).font(.caption).lineLimit(6)\n196|                    Spacer(minLength: 0)\n197|                }.padding(10).background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n198|            }\n199|            HStack(spacing: 8) {\n200|                Button(\"Выйти на этом Mac\", action: reactions.logout)\n201|                    .buttonStyle(.bordered)\n202|                    .accessibilityIdentifier(\"GitHub logout button\")\n203|                Button(\"Отозвать доступ в GitHub…\", action: reactions.revokeInGitHub)\n204|                    .buttonStyle(.plain).font(.callout).foregroundStyle(.secondary)\n205|            }\n206|            Text(\"Выход удаляет локальные токены и останавливает опрос GitHub. Локальные службы продолжают работать.\")\n207|                .font(.system(size: 11)).foregroundStyle(.secondary)\n208|            Divider()\n209|            HStack {\n210|                Text(\"Установки GitHub App\").font(.system(size: 13, weight: .semibold))\n211|                Spacer()\n212|                Button(\"Предоставить доступ организации…\", action: reactions.grantAccess)\n213|                    .buttonStyle(.plain).font(.callout)\n214|            }\n215|            if props.github.installations.isEmpty {\n216|                Text(\"Нет доступных установок. Предоставьте доступ организации или запросите одобрение владельца.\")\n217|                    .font(.callout).foregroundStyle(.secondary)\n218|            } else {\n219|                Picker(\"Установка\", selection: Binding(\n220|                    get: { props.github.selectedInstallationID },\n221|                    set: reactions.selectInstallation\n222|                )) {\n223|                    ForEach(props.github.installations) { installation in\n224|                        Text(\"\\(installation.account) (\\(installation.accountType))\").tag(Optional(installation.id))\n225|                    }\n226|                }\n227|                .pickerStyle(.menu)\n228|                .accessibilityIdentifier(\"GitHub installation picker\")\n229|            }\n230|            Text(\"Репозитории\").font(.system(size: 13, weight: .semibold))\n231|            if props.github.repositories.isEmpty {\n232|                Text(\"Репозитории выбранной установки появятся здесь.\")\n233|                    .font(.callout).foregroundStyle(.secondary)\n234|            } else {\n235|                VStack(alignment: .leading, spacing: 6) {\n236|                    ForEach(props.github.repositories) { repo in\n237|                        Toggle(\n238|                            repo.fullName,\n239|                            isOn: Binding(\n240|                                get: { props.github.selectedRepositoryIDs.contains(repo.id) },\n241|                                set: { enabled in\n242|                                    var next = props.github.selectedRepositoryIDs\n243|                                    if enabled { next.insert(repo.id) } else { next.remove(repo.id) }\n244|                                    reactions.selectRepositories(next)\n245|                                }\n246|                            )\n247|                        )\n248|                        .font(.callout)\n249|                    }\n250|                }\n251|            }\n252|            if !props.github.selectedRepositoryIDs.isEmpty {\n253|                Text(\"Выбрано: \\(props.github.selectedRepositoryIDs.count). Применяется при регистрации раннера.\")\n254|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n255|            }\n256|        }\n257|    }\n258|\n259|    private func failedView(message: String, retry: GitHubAuth.RetryKind) -> some View {\n260|        VStack(alignment: .leading, spacing: 12) {\n261|            HStack(spacing: 8) {\n262|                Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n263|                Text(\"Не удалось подключить GitHub\").font(.system(size: 15, weight: .semibold))\n264|            }\n265|            Text(message).font(.callout).textSelection(.enabled)\n266|            HStack(spacing: 8) {\n267|                switch retry {\n268|                case .newCode:\n269|                    Button(\"Получить новый код\", action: reactions.beginLogin)\n270|                        .buttonStyle(.borderedProminent).tint(.teal)\n271|                case .retry:\n272|                    Button(\"Повторить\", action: reactions.beginLogin)\n273|                        .buttonStyle(.borderedProminent).tint(.teal)\n274|                case .relogin:\n275|                    Button(\"Войти снова\", action: reactions.beginLogin)\n276|                        .buttonStyle(.borderedProminent).tint(.teal)\n277|                case .grantAccess:\n278|                    Button(\"Предоставить доступ…\", action: reactions.grantAccess)\n279|                        .buttonStyle(.borderedProminent).tint(.teal)\n280|                    Button(\"Повторить\", action: reactions.beginLogin)\n281|                        .buttonStyle(.bordered)\n282|                case .none:\n283|                    EmptyView()\n284|                }\n285|                if retry != .none {\n286|                    Button(\"Отмена\", action: reactions.cancelLogin)\n287|                        .buttonStyle(.plain).foregroundStyle(.secondary)\n288|                } else {\n289|                    Button(\"Назад\", action: reactions.cancelLogin)\n290|                        .buttonStyle(.bordered)\n291|                }\n292|            }\n293|            Text(\"Локальное управление раннерами остаётся доступным.\")\n294|                .font(.system(size: 11)).foregroundStyle(.secondary)\n295|        }\n296|    }\n297|\n298|    // MARK: - General\n299|\n300|    private var generalTab: some View {\n301|        ScrollView {\n302|            VStack(alignment: .leading, spacing: 14) {\n303|                Text(\"Основные\").font(.system(size: 15, weight: .semibold))\n304|                Toggle(\n305|                    \"Открывать Runner Control при входе\",\n306|                    isOn: Binding(get: { props.general.launchAtLoginEnabled }, set: reactions.setLaunchAtLogin)\n307|                )\n308|                .font(.callout)\n309|                Text(\"Отдельно от запуска CI. Для новых управляемых служб запуск раннера при входе выключен.\")\n310|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n311|                Divider()\n312|                HStack {\n313|                    Text(\"Версия \\(props.general.appVersion)\").font(.callout).foregroundStyle(.secondary)\n314|                    Spacer()\n315|                    Button(\"Проверить обновления…\", action: reactions.checkForUpdates)\n316|                        .disabled(!props.general.canCheckForUpdates)\n317|                }\n318|                Toggle(\"Проверять автоматически\", isOn: Binding(get: { props.general.automaticChecks }, set: reactions.setAutomaticChecks))\n319|                    .font(.callout)\n320|                Toggle(\"Устанавливать автоматически\", isOn: Binding(get: { props.general.automaticDownloads }, set: reactions.setAutomaticDownloads))\n321|                    .font(.callout)\n322|                    .disabled(!props.general.automaticChecks)\n323|                Text(\"Выход и обновление приложения оставляют уже запущенные службы работать.\")\n324|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n325|                Divider()\n326|                HStack {\n327|                    Text(\"RELUX WORKS\").font(.system(size: 9, weight: .semibold, design: .monospaced)).tracking(1.5).foregroundStyle(.tertiary)\n328|                    Spacer()\n329|                    Button(\"Закрыть приложение\", action: reactions.quit).buttonStyle(.plain)\n330|                        .font(.system(size: 11)).foregroundStyle(.secondary)\n331|                }\n332|            }\n333|            .padding(20)\n334|            .frame(maxWidth: .infinity, alignment: .leading)\n335|        }\n336|    }\n337|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
