{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c527","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":238,"recorded_at":1780531400000471,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"task_stream":{"kind":"task","id":"01a0a85a-e5f9-7802-b4c0-745490e10257"},"task_id":"01a0a85a-e5f9-7802-b4c0-745490e10257","event":{"kind":"output","task_id":"01a0a85a-e5f9-7802-b4c0-745490e10257","chunk":"Read text file `Packages/RunnerControlCore/Sources/GitHubAppConfig.swift`.\n1|import Foundation\n2|\n3|extension GitHubAuth {\n4|    /// Public GitHub App configuration. Only the public client_id lives here.\n5|    /// Client secrets and private keys are never embedded (see auditNoSecrets).\n6|    public struct AppConfig: Sendable, Equatable {\n7|        public let clientID: String\n8|        public let serverHost: String\n9|        public let deviceAuthorizationURL: URL\n10|        public let tokenURL: URL\n11|        public let apiBaseURL: URL\n12|\n13|        public init(clientID: String, serverHost: String = \"github.com\") {\n14|            self.clientID = clientID\n15|            self.serverHost = serverHost\n16|            if serverHost == \"github.com\" || serverHost == \"www.github.com\" {\n17|                self.deviceAuthorizationURL = URL(string: \"https://github.com/login/device/code\")!\n18|                self.tokenURL = URL(string: \"https://github.com/login/oauth/access_token\")!\n19|                self.apiBaseURL = URL(string: \"https://api.github.com\")!\n20|            } else {\n21|                self.deviceAuthorizationURL = URL(string: \"https://\\(serverHost)/login/device/code\")!\n22|                self.tokenURL = URL(string: \"https://\\(serverHost)/login/oauth/access_token\")!\n23|                self.apiBaseURL = URL(string: \"https://\\(serverHost)/api/v3\")!\n24|            }\n25|        }\n26|\n27|        /// Exact scaffold binding the coordinator must provision.\n28|        public static let missingBindingHelp = \"Info.plist[GitHubAppClientID] (scaffold input ios-app-manager.json → macos.info_plist.GitHubAppClientID, coordinator-provisioned public client_id)\"\n29|\n30|        public static func current(bundle: Bundle = .main, serverHost: String = \"github.com\") throws -> Self {\n31|            if let info = bundle.infoDictionary {\n32|                try auditNoSecrets(in: info)\n33|            }\n34|            let raw = bundle.object(forInfoDictionaryKey: \"GitHubAppClientID\") as? String\n35|            let trimmed = raw?.trimmingCharacters(in: .whitespacesAndNewlines) ?? \"\"\n36|            guard !trimmed.isEmpty else {\n37|                throw ConfigError.missingClientID(binding: missingBindingHelp)\n38|            }\n39|            return Self(clientID: trimmed, serverHost: serverHost)\n40|        }\n41|\n42|        /// Fail-closed audit: Info.plist must not carry secrets or private keys.\n43|        public static func auditNoSecrets(in dictionary: [String: Any]) throws {\n44|            let forbidden = [\"secret\", \"private_key\", \"privatekey\", \"token\"]\n45|            for key in dictionary.keys {\n46|                let lowered = key.lowercased()\n47|                for token in forbidden where lowered.contains(token) {\n48|                    if key == \"GitHubAppClientID\" { continue }\n49|                    throw ConfigError.embeddedSecret(key: key)\n50|                }\n51|            }\n52|        }\n53|    }\n54|\n55|    public enum ConfigError: LocalizedError, Sendable, Equatable {\n56|        case missingClientID(binding: String)\n57|        case embeddedSecret(key: String)\n58|        case unsupportedEnterprise(host: String)\n59|\n60|        public var errorDescription: String? {\n61|            switch self {\n62|            case .missingClientID(let binding):\n63|                \"GitHub App client_id is not provisioned. Missing binding: \\(binding).\"\n64|            case .embeddedSecret(let key):\n65|                \"Refusing to load embedded secret '\\(key)'. Secrets must stay in Keychain, never in plist/state/logs.\"\n66|            case .unsupportedEnterprise(let host):\n67|                \"GitHub Enterprise Server '\\(host)' needs its own App registration and Device Flow support check. Local control remains available offline.\"\n68|            }\n69|        }\n70|    }\n71|}","final_result":true}}}
