(\"Раннер зарегистрирован\").font(.callout.weight(.medium))\n343|            }\n344|            if let path = props.installPath {\n345|                Text(path).font(.system(size: 11)).foregroundStyle(.secondary).textSelection(.enabled)\n346|            }\n347|            Text(\"Включите его во вкладке «Раннеры», когда будете готовы. Токен регистрации уже удалён.\")\n348|                .font(.system(size: 11)).foregroundStyle(.secondary)\n349|        }\n350|        .padding(10)\n351|        .background(.green.opacity(0.07), in: RoundedRectangle(cornerRadius: 10))\n352|    }\n353|\n354|    private var footer: some View {\n355|        HStack(spacing: 8) {\n356|            if props.working {\n357|                Button(\"Отмена\", action: reactions.cancel)\n358|                    .buttonStyle(.bordered)\n359|                    .accessibilityIdentifier(\"Registration cancel button\")\n360|            } else if props.phase != .idle {\n361|                Button(\"Сбросить\", action: reactions.reset)\n362|                    .buttonStyle(.plain).foregroundStyle(.secondary)\n363|                    .accessibilityIdentifier(\"Registration reset button\")\n364|            }\n365|            Spacer()\n366|            Button(\"Закрыть\", action: reactions.close)\n367|                .buttonStyle(.bordered)\n368|                .accessibilityIdentifier(\"Registration close button\")\n369|        }\n370|    }\n371|\n372|    private func labeledField(\n373|        _ title: String, text: String, set: @escaping (String) -> Void,\n374|        placeholder: String, id: String\n375|    ) -> some View {\n376|        VStack(alignment: .leading, spacing: 4) {\n377|            Text(title).font(.system(size: 11)).foregroundStyle(.secondary)\n378|            TextField(placeholder, text: Binding(get: { text }, set: set))\n379|                .textFieldStyle(.roundedBorder)\n380|                .accessibilityIdentifier(id)\n381|        }\n382|    }\n383|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
