{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c79b","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":552,"recorded_at":1780531400001099,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"call_id":"call_01a0a85b513773f5a792dd04cbb84faf","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerControlCoreTests.swift`.\n1|import Foundation\n2|import Testing\n3|import Relux\n4|@testable import RunnerControlCore\n5|\n6|struct ForeignAction: Relux.Action {}\n7|struct ForeignEffect: Relux.Effect {}\n8|\n9|@Test @MainActor func reducerPreservesUnrelatedActionsAndCleansState() async {\n10|    let definitions = (1...2).map { Runners.Definition(id: \"test.\\($0)\", title: \"Test\", detail: \"\", directory: URL(fileURLWithPath: \"/tmp/test-\\($0)\"), githubURL: URL(string: \"https://github.com/example\")!) }\n11|    let state = Runners.State(definitions: definitions)\n12|    let original = state.runners\n13|    await state.reduce(with: ForeignAction())\n14|    #expect(state.runners == original)\n15|    await state.reduce(with: Runners.Action.changing(original[0].id, true))\n16|    await state.reduce(with: Runners.Action.failed(\"Permission denied\"))\n17|    #expect(state.changing.contains(original[0].id))\n18|    #expect(state.lastError == \"Permission denied\")\n19|    await state.reduce(with: Runners.Action.refreshed(original.map { .init(definition: $0.definition, status: .running) }))\n20|    #expect(state.activeCount == 2)\n21|    await state.cleanup()\n22|    #expect(state.activeCount == 0)\n23|    #expect(state.changing.isEmpty)\n24|    #expect(state.lastError == nil)\n25|}\n26|\n27|@Test(arguments: [\n28|    (CommandResult(code: 0, output: \"state = running\\npid = 23\"), Runners.Status.running),\n29|    (CommandResult(code: 0, output: \"state = exited\"), .failed),\n30|    (CommandResult(code: 113, output: \"Could not find service foo\"), .stopped),\n31|    (CommandResult(code: 1, output: \"Operation not permitted\"), .unknown),\n32|    (CommandResult(code: 113, output: \"Could not find domain\"), .unknown)\n33|]) func distinguishesStoppedFromPermissionFailure(value: (CommandResult, Runners.Status)) {\n34|    #expect(LaunchAgentService.status(from: value.0) == value.1)\n35|}\n36|\n37|actor FakeExecutor: CommandExecuting {\n38|    private var results: [CommandResult]\n39|    private(set) var calls: [[String]] = []\n40|    init(_ results: [CommandResult]) { self.results = results }\n41|    func run(_ executable: String, _ arguments: [String]) async throws -> CommandResult {\n42|        calls.append([executable] + arguments)\n43|        guard !results.isEmpty else { throw RunnerError.message(\"Unexpected command\") }\n44|        return results.removeFirst()\n45|    }\n46|}\n47|struct Fixture {\n48|    let root: URL\n49|    let definition: Runners.Definition\n50|    init(suffix: String = \"\", work: String = \"_work\") throws {\n51|        root = FileManager.default.temporaryDirectory.appendingPathComponent(\"RunnerControl-\" + UUID().uuidString + suffix)\n52|        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)\n53|        definition = .init(id: \"works.relux.runnercontrol.test.\" + UUID().uuidString, title: \"Test\", detail: \"Fixture\", directory: root, githubURL: URL(string: \"https://example.com\")!)\n54|        let script = root.appendingPathComponent(\"runsvc.sh\")\n55|        try \"#!/bin/sh\\nexec /bin/sleep 120\\n\".write(to: script, atomically: true, encoding: .utf8)\n56|        try FileManager.default.setAttributes([.posixPermissions: 0o755], ofItemAtPath: script.path)\n57|        let plist: [String: Any] = [\"Label\": definition.id, \"ProgramArguments\": [script.path], \"WorkingDirectory\": root.path, \"RunAtLoad\": true]\n58|        try PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0).write(to: definition.plist)\n59|        try JSONSerialization.data(withJSONObject: [\"workFolder\": work]).write(to: root.appendingPathComponent(\".runner\"))\n60|    }\n61|    func clean() { try? FileManager.default.removeItem(at: root) }\n62|}\n63|let stopped = CommandResult(code: 113, output: \"Could not find service test\")\n64|let running = CommandResult(code: 0, output: \"state = running\")\n65|\n66|@Test func startIsIdempotentAndStopUsesServiceIdentity() async throws {\n67|    let fixture = try Fixture(); defer { fixture.clean() }\n68|    let executor = FakeExecutor([running, running, .init(code: 0, output: \"\"), stopped])\n69|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor, userID: 501)\n70|    try await service.setEnabled(true, id: fixture.definition.id)\n71|    try await service.setEnabled(false, id: fixture.definition.id)\n72|    let calls = await executor.calls\n73|    #expect(calls.count == 4)\n74|    #expect(calls[2] == [\"/bin/launchctl\", \"bootout\", \"gui/501/\" + fixture.definition.id])\n75|}\n76|\n77|@Test func startWaitsForRunningState() async throws {\n78|    let fixture = try Fixture(); defer { fixture.clean() }\n79|    let executor = FakeExecutor([stopped, .init(code: 0, output: \"\"), running])\n80|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor, userID: 501)\n81|    try await service.setEnabled(true, id: fixture.definition.id)\n82|    let calls = await executor.calls\n83|    #expect(calls[1] == [\"/bin/launchctl\", \"bootstrap\", \"gui/501\", fixture.definition.plist.path])\n84|}\n85|\n86|@Test(arguments: [false, true]) func rejectsSpacesBeforeLaunching(inWorkFolder: Bool) async throws {\n87|    let fixture = try Fixture(suffix: inWorkFolder ? \"\" : \" bad\", work: inWorkFolder ? \"bad path\" : \"_work\")\n88|    defer { fixture.clean() }\n89|    let executor = FakeExecutor([])\n90|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor)\n91|    await #expect(throws: (any Error).self) { try await service.setEnabled(true, id: fixture.definition.id) }\n92|    #expect(await executor.calls.isEmpty)\n93|}\n94|\n95|@Test func permissionErrorsNeverTriggerBootstrap() async throws {\n96|    let fixture = try Fixture(); defer { fixture.clean() }\n97|    let executor = FakeExecutor([.init(code: 1, output: \"Operation not permitted\")])\n98|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor)\n99|    await #expect(throws: (any Error).self) { try await service.setEnabled(true, id: fixture.definition.id) }\n100|    #expect(await executor.calls.count == 1)\n101|}\n102|\n103|@Test func canStopAfterRegistrationIsDeleted() async throws {\n104|    let fixture = try Fixture(); defer { fixture.clean() }\n105|    try FileManager.default.removeItem(at: fixture.root.appendingPathComponent(\".runner\"))\n106|    let executor = FakeExecutor([running, .init(code: 0, output: \"\"), stopped])\n107|    let service = LaunchAgentService(definitions: [fixture.definition], executor: executor)\n108|    try await service.setEnabled(false, id: fixture.definition.id)\n109|    #expect(await executor.calls.count == 3)\n110|}\n111|\n112|actor FailingService: RunnerServicing {\n113|    func snapshots() async -> [Runners.Snapshot] { [] }\n114|    func setEnabled(_ enabled: Bool, id: String) async throws { throw RunnerError.message(\"Denied\") }\n115|}\n116|@Test @MainActor func flowPublishesFailureAndClearsPendingState() async {\n117|    let logger = Relux.Testing.Logger()\n118|    let dispatcher = Relux.Dispatcher(logger: logger)\n119|    let flow = await Runners.Flow(service: FailingService(), dispatcher: dispatcher)\n120|    let _: Relux.ActionResult = await flow.apply(Runners.Effect.setEnabled(\"test\", true))\n121|    let actions = logger.actions.compactMap { $0 as? Runners.Action }\n122|    #expect(actions.count == 4)\n123|    guard case .changing(\"test\", true) = actions[0],\n124|          case .failed(\"Denied\") = actions[1],\n125|          case .changing(\"test\", false) = actions[3] else {\n126|        Issue.record(\"Flow did not balance start/failure/finish actions\"); return\n127|    }\n128|    let _: Relux.ActionResult = await flow.apply(ForeignEffect())\n129|    #expect(logger.actions.count == 4)\n130|}\n131|\n132|@Test func commandExecutorHandlesLargeOutputAndExitStatus() async throws {\n133|    let runner = CommandExecutor()\n134|    let result = try await runner.run(\"/usr/bin/printf\", [\"%050000d\", \"1\"])\n135|    #expect(result.code == 0)\n136|    #expect(result.output.count == 50000)\n137|    let failed = try await runner.run(\"/usr/bin/false\", [])\n138|    #expect(failed.code != 0)\n139|}\n140|\n141|@Test(.enabled(if: ProcessInfo.processInfo.environment[\"RUN_LAUNCH_AGENT_INTEGRATION\"] == \"1\"))\n142|func realLaunchAgentLifecycleWithoutGitHubJobs() async throws {\n143|    let fixture = try Fixture(); defer { fixture.clean() }\n144|    let service = LaunchAgentService(definitions: [fixture.definition])\n145|    do {\n146|        try await service.setEnabled(true, id: fixture.definition.id)\n147|        #expect(await service.snapshots().first?.status == .running)\n148|        try await service.setEnabled(true, id: fixture.definition.id)\n149|        try await service.setEnabled(false, id: fixture.definition.id)\n150|        #expect(await service.snapshots().first?.status == .stopped)\n151|        try await service.setEnabled(false, id: fixture.definition.id)\n152|    } catch {\n153|        try? await service.setEnabled(false, id: fixture.definition.id)\n154|        throw error\n155|    }\n156|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c79d","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":553,"recorded_at":1780531400001101,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"call_id":"call_01a0a85b51fc74dc845f7bdd6af6a0ab","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubTokenRefresh.swift`.\n1|import Foundation\n2|\n3|/// Serialized token refresh. Concurrent callers coalesce to a single network refresh.\n4|public actor GitHubTokenRefresh {\n5|    private let transport: any GitHubHTTPTransport\n6|    private let store: any GitHubCredentialStoring\n7|    private let now: @Sendable () -> Date\n8|    private var inFlight: Task<GitHubAuth.TokenRecord, Error>?\n9|\n10|    public init(\n11|        transport: any GitHubHTTPTransport,\n12|        store: any GitHubCredentialStoring,\n13|        now: @Sendable @escaping () -> Date = Date.init\n14|    ) {\n15|        self.transport = transport\n16|        self.store = store\n17|        self.now = now\n18|    }\n19|\n20|    /// Cancels the in-flight refresh so a superseding logout/login leaves no token behind.\n21|    /// Callers awaiting the cancelled refresh observe `CancellationError`.\n22|    public func cancelInFlight() {\n23|        inFlight?.cancel()\n24|        inFlight = nil\n25|    }\n26|\n27|    public func refresh(\n28|        config: GitHubAuth.AppConfig,\n29|        userID: Int64,\n30|        current: GitHubAuth.TokenRecord\n31|    ) async throws -> GitHubAuth.TokenRecord {\n32|        // Fast path: another task already refreshed while we waited.\n33|        if let latest = await store.load(serverHost: config.serverHost, userID: userID, clientID: config.clientID),\n34|           latest.accessToken != current.accessToken {\n35|            return latest\n36|        }\n37|        if let flight = inFlight {\n38|            return try await flight.value\n39|        }\n40|        guard let refreshToken = current.refreshToken, !refreshToken.isEmpty else {\n41|            throw GitHubAuth.AuthError.tokenRefreshFailed\n42|        }\n43|        let transportCopy = transport\n44|        let storeCopy = store\n45|        let nowCopy = now\n46|        let task: Task<GitHubAuth.TokenRecord, Error> = Task {\n47|            let body = try JSONEncoder().encode(GitHubAuth.TokenRefreshRequest(\n48|                client_id: config.clientID,\n49|                grant_type: \"refresh_token\",\n50|                refresh_token: refreshToken\n51|            ))\n52|            let request = GitHubHTTPRequest(\n53|                method: \"POST\",\n54|                url: config.tokenURL,\n55|                headers: [\"Accept\": \"application/json\", \"Content-Type\": \"application/json\"],\n56|                body: body\n57|            )\n58|            let response: GitHubHTTPResponse\n59|            do {\n60|                response = try await transportCopy.send(request)\n61|            } catch {\n62|                throw GitHubAuth.AuthError.network(GitHubTransportError.offline.localizedDescription)\n63|            }\n64|            let decoded: GitHubAuth.TokenSuccessResponse\n65|            do {\n66|                decoded = try JSONDecoder().decode(GitHubAuth.TokenSuccessResponse.self, from: response.body)\n67|            } catch {\n68|                throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n69|            }\n70|            if let token = decoded.access_token, !token.isEmpty {\n71|                try GitHubAuth.PATGuard.validate(token: token)\n72|                let expiresAt: Date?\n73|                if let seconds = decoded.expires_in {\n74|                    expiresAt = nowCopy().addingTimeInterval(TimeInterval(seconds))\n75|                } else {\n76|                    expiresAt = nil\n77|                }\n78|                let next = GitHubAuth.TokenRecord(\n79|                    accessToken: token,\n80|                    refreshToken: decoded.refresh_token ?? refreshToken,\n81|                    expiresAt: expiresAt,\n82|                    obtainedAt: nowCopy()\n83|                )\n84|                // A superseding logout/login must not leave refreshed tokens behind.\n85|                if Task.isCancelled { throw CancellationError() }\n86|                try await storeCopy.save(next, serverHost: config.serverHost, userID: userID, clientID: config.clientID)\n87|                if Task.isCancelled {\n88|                    // Lost a race with cancel during the save: remove the orphan,\n89|                    // but never touch tokens a newer login may have stored since.\n90|                    if let current = await storeCopy.load(serverHost: config.serverHost, userID: userID, clientID: config.clientID),\n91|                       current.accessToken == next.accessToken {\n92|                        await storeCopy.delete(serverHost: config.serverHost, userID: userID, clientID: config.clientID)\n93|                    }\n94|                    throw CancellationError()\n95|                }\n96|                return next\n97|            }\n98|            if decoded.error == \"invalid_grant\" {\n99|                throw GitHubAuth.AuthError.revoked\n100|            }\n101|            throw GitHubAuth.AuthError.tokenRefreshFailed\n102|        }\n103|        inFlight = task\n104|        do {\n105|            let value = try await task.value\n106|            inFlight = nil\n107|            return value\n108|        } catch {\n109|            inFlight = nil\n110|            throw error\n111|        }\n112|    }\n113|\n114|    public static func isExpiringSoon(_ record: GitHubAuth.TokenRecord, now: Date = Date(), within seconds: TimeInterval = 60) -> Bool {\n115|        guard let expiresAt = record.expiresAt else { return false }\n116|        return expiresAt.timeIntervalSince(now) <= seconds\n117|    }\n118|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c79f","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":554,"recorded_at":1780531400001103,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"call_id":"call_01a0a85b52c2747ea04fd366d487ded9","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubKeychainStore.swift`.\n1|import Foundation\n2|import Security\n3|\n4|/// Keychain-backed credential store. Secret values never enter Relux state or logs.\n5|public protocol GitHubCredentialStoring: Sendable {\n6|    func save(_ record: GitHubAuth.TokenRecord, serverHost: String, userID: Int64, clientID: String) async throws\n7|    func load(serverHost: String, userID: Int64, clientID: String) async -> GitHubAuth.TokenRecord?\n8|    func delete(serverHost: String, userID: Int64, clientID: String) async\n9|    func deleteAll(serverHost: String, clientID: String) async\n10|}\n11|\n12|public actor GitHubKeychainStore: GitHubCredentialStoring {\n13|    private let service: String\n14|    private let backend: any KeychainBackend\n15|\n16|    public init(service: String = \"works.relux.runnercontrol.github-token\", backend: (any KeychainBackend)? = nil) {\n17|        self.service = service\n18|        self.backend = backend ?? SecurityKeychainBackend()\n19|    }\n20|\n21|    public static func account(serverHost: String, userID: Int64, clientID: String) -> String {\n22|        \"\\(serverHost):\\(userID):\\(clientID)\"\n23|    }\n24|\n25|    private func account(serverHost: String, userID: Int64, clientID: String) -> String {\n26|        Self.account(serverHost: serverHost, userID: userID, clientID: clientID)\n27|    }\n28|\n29|    public func save(_ record: GitHubAuth.TokenRecord, serverHost: String, userID: Int64, clientID: String) async throws {\n30|        let data = try JSONEncoder().encode(record)\n31|        try backend.save(data, service: service, account: account(serverHost: serverHost, userID: userID, clientID: clientID))\n32|    }\n33|\n34|    public func load(serverHost: String, userID: Int64, clientID: String) async -> GitHubAuth.TokenRecord? {\n35|        guard let data = backend.load(service: service, account: account(serverHost: serverHost, userID: userID, clientID: clientID)) else { return nil }\n36|        return try? JSONDecoder().decode(GitHubAuth.TokenRecord.self, from: data)\n37|    }\n38|\n39|    public func delete(serverHost: String, userID: Int64, clientID: String) async {\n40|        backend.delete(service: service, account: account(serverHost: serverHost, userID: userID, clientID: clientID))\n41|    }\n42|\n43|    public func deleteAll(serverHost: String, clientID: String) async {\n44|        // Best-effort sweep: Keychain has no wildcard delete; callers pass known userIDs.\n45|        // This entry point exists so logout can clear without knowing the user when needed\n46|        // by enumerating via backend when supported.\n47|        backend.deleteMatching(service: service, accountPrefix: \"\\(serverHost):\", accountSuffix: \":\\(clientID)\")\n48|    }\n49|}\n50|\n51|/// Injectable Keychain boundary for tests.\n52|public protocol KeychainBackend: Sendable {\n53|    func save(_ data: Data, service: String, account: String) throws\n54|    func load(service: String, account: String) -> Data?\n55|    func delete(service: String, account: String)\n56|    func deleteMatching(service: String, accountPrefix: String, accountSuffix: String)\n57|}\n58|\n59|public struct SecurityKeychainBackend: KeychainBackend, Sendable {\n60|    public init() {}\n61|    public func save(_ data: Data, service: String, account: String) throws {\n62|        let query: [String: Any] = [kSecClass as String: kSecClassGenericPassword, kSecAttrService as String: service, kSecAttrAccount as String: account]\n63|        SecItemDelete(query as CFDictionary)\n64|        var add = query\n65|        add[kSecValueData as String] = data\n66|        add[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlock\n67|        let status = SecItemAdd(add as CFDictionary, nil)\n68|        guard status == errSecSuccess else { throw GitHubKeychainError.saveFailed(status) }\n69|    }\n70|    public func load(service: String, account: String) -> Data? {\n71|        let query: [String: Any] = [\n72|            kSecClass as String: kSecClassGenericPassword,\n73|            kSecAttrService as String: service,\n74|            kSecAttrAccount as String: account,\n75|            kSecReturnData as String: true,\n76|            kSecMatchLimit as String: kSecMatchLimitOne,\n77|        ]\n78|        var item: CFTypeRef?\n79|        guard SecItemCopyMatching(query as CFDictionary, &item) == errSecSuccess else { return nil }\n80|        return item as? Data\n81|    }\n82|    public func delete(service: String, account: String) {\n83|        let query: [String: Any] = [kSecClass as String: kSecClassGenericPassword, kSecAttrService as String: service, kSecAttrAccount as String: account]\n84|        SecItemDelete(query as CFDictionary)\n85|    }\n86|    public func deleteMatching(service: String, accountPrefix: String, accountSuffix: String) {\n87|        let query: [String: Any] = [\n88|            kSecClass as String: kSecClassGenericPassword,\n89|            kSecAttrService as String: service,\n90|            kSecReturnAttributes as String: true,\n91|            kSecMatchLimit as String: kSecMatchLimitAll,\n92|        ]\n93|        var items: CFTypeRef?\n94|        guard SecItemCopyMatching(query as CFDictionary, &items) == errSecSuccess,\n95|              let list = items as? [[String: Any]] else { return }\n96|        for entry in list {\n97|            if let account = entry[kSecAttrAccount as String] as? String,\n98|               account.hasPrefix(accountPrefix), account.hasSuffix(accountSuffix) {\n99|                delete(service: service, account: account)\n100|            }\n101|        }\n102|    }\n103|}\n104|\n105|public enum GitHubKeychainError: LocalizedError, Sendable, Equatable {\n106|    case saveFailed(OSStatus)\n107|    public var errorDescription: String? { \"Could not save GitHub credentials in Keychain.\" }\n108|}\n109|\n110|/// In-memory backend for unit tests. Never used in production.\n111|public final class InMemoryKeychainBackend: KeychainBackend, @unchecked Sendable {\n112|    private let lock = NSLock()\n113|    private var storage: [String: Data] = [:]\n114|    public init() {}\n115|    private func key(service: String, account: String) -> String { \"\\(service)\\u{0}\\(account)\" }\n116|    public func save(_ data: Data, service: String, account: String) throws {\n117|        lock.withLock { storage[key(service: service, account: account)] = data }\n118|    }\n119|    public func load(service: String, account: String) -> Data? {\n120|        lock.withLock { storage[key(service: service, account: account)] }\n121|    }\n122|    public func delete(service: String, account: String) {\n123|        lock.withLock { _ = storage.removeValue(forKey: key(service: service, account: account)) }\n124|    }\n125|    public func deleteMatching(service: String, accountPrefix: String, accountSuffix: String) {\n126|        lock.withLock {\n127|            for key in storage.keys where key.hasPrefix(\"\\(service)\\u{0}\\(accountPrefix)\") && key.hasSuffix(accountSuffix) {\n128|                storage.removeValue(forKey: key)\n129|            }\n130|        }\n131|    }\n132|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
