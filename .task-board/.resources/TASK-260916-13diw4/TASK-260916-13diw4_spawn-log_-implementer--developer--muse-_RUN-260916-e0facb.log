{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a9","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":175,"recorded_at":1780531400000345,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"task_stream":{"kind":"task","id":"01a0a85a-db16-7960-b271-2d09ac7ae9ee"},"task_id":"01a0a85a-db16-7960-b271-2d09ac7ae9ee","event":{"kind":"output","task_id":"01a0a85a-db16-7960-b271-2d09ac7ae9ee","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n1|import Relux\n2|extension Runners {\n3|    public protocol IFlow: Relux.Flow {}\n4|    public actor Flow {\n5|        public let dispatcher: Relux.Dispatcher\n6|        private let service: any RunnerServicing\n7|        private var working: Set<String> = []\n8|        private var refreshing = false\n9|        private var revision = 0\n10|        public init(service: any RunnerServicing, dispatcher: Relux.Dispatcher? = nil) async {\n11|            self.service = service\n12|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n13|        }\n14|    }\n15|}\n16|extension Runners.Flow: Runners.IFlow {\n17|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n18|        guard let effect = effect as? Runners.Effect else { return .success }\n19|        switch effect {\n20|        case .refresh:\n21|            guard !refreshing, working.isEmpty else { return .success }\n22|            refreshing = true\n23|            let startedAt = revision\n24|            let snapshots = await service.snapshots()\n25|            // Do not publish a stale read if a command started during this await.\n26|            if working.isEmpty && revision == startedAt { await action { Runners.Action.refreshed(snapshots) } }\n27|            refreshing = false\n28|        case .setEnabled(let id, let enabled):\n29|            guard !working.contains(id) else { return .success }\n30|            working.insert(id)\n31|            revision += 1\n32|            await action { Runners.Action.changing(id, true) }\n33|            do { try await service.setEnabled(enabled, id: id) }\n34|            catch { await action { Runners.Action.failed(error.localizedDescription) } }\n35|            let snapshots = await service.snapshots()\n36|            await action { Runners.Action.refreshed(snapshots) }\n37|            working.remove(id)\n38|            await action { Runners.Action.changing(id, false) }\n39|        }\n40|        return .success\n41|    }\n42|}","final_result":true}}}
