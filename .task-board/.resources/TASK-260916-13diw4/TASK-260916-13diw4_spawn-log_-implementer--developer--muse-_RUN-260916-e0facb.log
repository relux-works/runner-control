{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c853","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":644,"recorded_at":1780531400001283,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"task_stream":{"kind":"task","id":"01a0a85b-9d58-70e1-96dc-7c0a2e079c9d"},"task_id":"01a0a85b-9d58-70e1-96dc-7c0a2e079c9d","event":{"kind":"output","task_id":"01a0a85b-9d58-70e1-96dc-7c0a2e079c9d","chunk":"Read text file `Packages/RunnerControlCore/Tests/GitHubTransportTests.swift`.\n1|import Foundation\n2|import Testing\n3|@testable import RunnerControlCore\n4|\n5|// MARK: - Shared fakes\n6|\n7|actor TestTransport: GitHubHTTPTransport {\n8|    private var queue: [GitHubHTTPResponse]\n9|    private(set) var requests: [GitHubHTTPRequest] = []\n10|    init(_ responses: [GitHubHTTPResponse]) { self.queue = responses }\n11|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n12|        requests.append(request)\n13|        guard !queue.isEmpty else { throw GitHubTransportError.invalidResponse }\n14|        return queue.removeFirst()\n15|    }\n16|    func prepend(_ response: GitHubHTTPResponse) { queue.insert(response, at: 0) }\n17|    func append(_ response: GitHubHTTPResponse) { queue.append(response) }\n18|}\n19|\n20|func jsonResponse(_ object: Any, status: Int = 200) -> GitHubHTTPResponse {\n21|    // Static test literals always serialize.\n22|    // swiftlint:disable:next force_try\n23|    let data = try! JSONSerialization.data(withJSONObject: object)\n24|    return GitHubHTTPResponse(status: status, body: data)\n25|}\n26|\n27|let testConfig = GitHubAuth.AppConfig(clientID: \"test-client-id\")\n28|\n29|// MARK: - Config\n30|\n31|@Test func configReportsExactMissingBinding() {\n32|    let bundle = Bundle.main\n33|    // Production bundle has no GitHubAppClientID until coordinator provisions it.\n34|    // Assert the thrown binding names the exact scaffold input.\n35|    let raw = bundle.object(forInfoDictionaryKey: \"GitHubAppClientID\") as? String\n36|    if let raw, !raw.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {\n37|        // Provisioned environment: config must load.\n38|        #expect((try? GitHubAuth.AppConfig.current(bundle: bundle)) != nil)\n39|    } else {\n40|        do {\n41|            _ = try GitHubAuth.AppConfig.current(bundle: bundle)\n42|            Issue.record(\"Expected missingClientID when plist key is absent/empty\")\n43|        } catch let error as GitHubAuth.ConfigError {\n44|            guard case .missingClientID(let binding) = error else {\n45|                Issue.record(\"Wrong config error: \\(error)\"); return\n46|            }\n47|            #expect(binding == GitHubAuth.AppConfig.missingBindingHelp)\n48|            #expect(binding.contains(\"ios-app-manager.json\"))\n49|            #expect(binding.contains(\"GitHubAppClientID\"))\n50|        } catch {\n51|            Issue.record(\"Unexpected error: \\(error)\")\n52|        }\n53|    }\n54|}\n55|\n56|@Test func configAuditRunsThroughCurrentBundle() throws {\n57|    func bundleWithPlist(_ plist: [String: Any]) throws -> Bundle {\n58|        let dir = FileManager.default.temporaryDirectory.appendingPathComponent(\"AuditProbe-\\(UUID().uuidString).bundle\")\n59|        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)\n60|        let data = try PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0)\n61|        try data.write(to: dir.appendingPathComponent(\"Info.plist\"))\n62|        guard let bundle = Bundle(path: dir.path) else { throw GitHubTransportError.invalidResponse }\n63|        return bundle\n64|    }\n65|    let tainted = try bundleWithPlist([\"GitHubAppClientID\": \"pub-id\", \"ClientSecret\": \"shh\"])\n66|    defer { try? FileManager.default.removeItem(at: URL(fileURLWithPath: tainted.bundlePath)) }\n67|    do {\n68|        _ = try GitHubAuth.AppConfig.current(bundle: tainted)\n69|        Issue.record(\"current(bundle:) admitted embedded ClientSecret\")\n70|    } catch let error as GitHubAuth.ConfigError {\n71|        guard case .embeddedSecret(let key) = error, key == \"ClientSecret\" else {\n72|            Issue.record(\"Wrong audit error: \\(error)\"); return\n73|        }\n74|    }\n75|    let clean = try bundleWithPlist([\"GitHubAppClientID\": \"pub-id\"])\n76|    defer { try? FileManager.default.removeItem(at: URL(fileURLWithPath: clean.bundlePath)) }\n77|    #expect(try GitHubAuth.AppConfig.current(bundle: clean).clientID == \"pub-id\")\n78|}\n79|\n80|@Test func enterpriseConfigUsesHostScopedEndpoints() {\n81|    let config = GitHubAuth.AppConfig(clientID: \"pub\", serverHost: \"ghe.example.com\")\n82|    #expect(config.deviceAuthorizationURL.absoluteString == \"https://ghe.example.com/login/device/code\")\n83|    #expect(config.tokenURL.absoluteString == \"https://ghe.example.com/login/oauth/access_token\")\n84|    #expect(config.apiBaseURL.absoluteString == \"https://ghe.example.com/api/v3\")\n85|}\n86|\n87|@Test func auditRejectsEmbeddedSecrets() throws {\n88|    try GitHubAuth.AppConfig.auditNoSecrets(in: [\"GitHubAppClientID\": \"pub\", \"CFBundleIdentifier\": \"x\"])\n89|    for key in [\"ClientSecret\", \"client_secret\", \"AppPrivateKey\", \"app_private_key\", \"GitHubToken\", \"access_token_cache\"] {\n90|        do {\n91|            try GitHubAuth.AppConfig.auditNoSecrets(in: [key: \"value\"])\n92|            Issue.record(\"auditNoSecrets admitted forbidden key '\\(key)'\")\n93|        } catch let error as GitHubAuth.ConfigError {\n94|            guard case .embeddedSecret(let found) = error, found == key else {\n95|                Issue.record(\"Wrong audit error for '\\(key)': \\(error)\"); return\n96|            }\n97|        }\n98|    }\n99|}\n100|\n101|// MARK: - PAT guard (no PAT fallback)\n102|\n103|@Test func patGuardRejectsClassicAndFineGrainedPAT() {\n104|    for pat in [\"ghp_abc123\", \"github_pat_abc123\"] {\n105|        do {\n106|            _ = try GitHubAuth.PATGuard.authorizationHeader(token: pat)\n107|            Issue.record(\"PATGuard admitted PAT '\\(pat)'\")\n108|        } catch let error as GitHubAuth.AuthError {\n109|            #expect(error == .patNotSupported)\n110|        } catch {\n111|            Issue.record(\"Unexpected error for '\\(pat)': \\(error)\")\n112|        }\n113|    }\n114|    #expect((try? GitHubAuth.PATGuard.authorizationHeader(token: \"[REDACTED]\")) == \"Bearer [REDACTED]\")\n115|}\n116|\n117|// MARK: - REST mapper (401/403)\n118|\n119|@Test func restMapperSeparatesUnauthorizedForbiddenSSORateLimit() {\n120|    #expect(GitHubAuth.RESTMapper.map(status: 401, body: Data()) == .unauthorized)\n121|    #expect(GitHubAuth.RESTMapper.map(status: 429, body: Data()) == .rateLimited(retryAfter: nil))\n122|    let sso = GitHubAuth.RESTMapper.map(status: 403, body: Data(\"SAML SSO required\".utf8))\n123|    #expect(sso == .ssoRequired)\n124|    let rate = GitHubAuth.RESTMapper.map(status: 403, body: Data(\"API rate limit exceeded\".utf8))\n125|    #expect(rate == .rateLimited(retryAfter: nil))\n126|    let forbidden = GitHubAuth.RESTMapper.map(status: 403, body: Data(\"Resource not accessible\".utf8))\n127|    guard case .forbidden = forbidden else {\n128|        Issue.record(\"Expected forbidden, got \\(String(describing: forbidden))\"); return\n129|    }\n130|    #expect(GitHubAuth.RESTMapper.map(status: 200, body: Data()) == nil)\n131|    #expect(GitHubAuth.RESTMapper.map(status: 500, body: Data()) == nil)\n132|}\n133|\n134|// MARK: - Redaction\n135|\n136|@Test func redactionScrubsExactSecretsAndJSONShapes() {\n137|    let token = \"[REDACTED]\"\n138|    let refresh = \"[REDACTED]\"\n139|    let text = #\"{\"access_token\":\"[REDACTED]\",\"refresh_token\":\"[REDACTED]\",\"device_code\":\"dev789\",\"other\":\"keep\"}\"#\n140|    let clean = GitHubAuth.Redaction.sanitize(text, secrets: [token, refresh])\n141|    #expect(!clean.contains(token))\n142|    #expect(!clean.contains(refresh))\n143|    #expect(!clean.contains(\"dev789\"))\n144|    #expect(clean.contains(\"keep\"))\n145|    #expect(clean.contains(\"[REDACTED]\"))\n146|    let inline = GitHubAuth.Redaction.sanitize(\"Bearer \\(token) tail\", secrets: [token])\n147|    #expect(inline == \"Bearer [REDACTED] tail\")\n148|}\n149|\n150|// MARK: - Device Flow transport\n151|\n152|@Test func deviceCodeRequestDecodesAndPostsClientID() async throws {\n153|    let transport = TestTransport([jsonResponse([\n154|        \"device_code\": \"dev\", \"user_code\": \"USER-1\",\n155|        \"verification_uri\": \"https://github.com/login/device\",\n156|        \"expires_in\": 900, \"interval\": 5,\n157|    ])])\n158|    let flow = GitHubDeviceFlow(transport: transport)\n159|    let response = try await flow.requestCode(config: testConfig)\n160|    #expect(response.user_code == \"USER-1\")\n161|    #expect(response.interval == 5)\n162|    let requests = await transport.requests\n163|    #expect(requests.count == 1)\n164|    #expect(requests[0].url == testConfig.deviceAuthorizationURL)\n165|    let body = try JSONDecoder().decode([String: String].self, from: requests[0].body!)\n166|    #expect(body[\"client_id\"] == \"test-client-id\")\n167|    #expect(body[\"client_secret\"] == nil)\n168|}\n169|\n170|@Test func devicePollMapsAllTerminalBodiesOnHTTP200() async throws {\n171|    for (payload, expected) in [\n172|        ([\"error\": \"authorization_pending\"], GitHubAuth.PollResult.pending),\n173|        ([\"error\": \"slow_down\"], GitHubAuth.PollResult.slowDown),\n174|        ([\"error\": \"access_denied\"], GitHubAuth.PollResult.denied),\n175|        ([\"error\": \"expired_token\"], GitHubAuth.PollResult.expired),\n176|    ] as [([String: String], GitHubAuth.PollResult)] {\n177|        let transport = TestTransport([jsonResponse(payload)])\n178|        let flow = GitHubDeviceFlow(transport: transport)\n179|        #expect(try await flow.pollOnce(config: testConfig, deviceCode: \"dev\") == expected)\n180|    }\n181|    let ok = TestTransport([jsonResponse([\"access_token\": \"ghu_x\", \"refresh_token\": \"ghr_y\", \"expires_in\": 3600])])\n182|    let result = try await GitHubDeviceFlow(transport: ok).pollOnce(config: testConfig, deviceCode: \"dev\")\n183|    #expect(result == .success(accessToken: \"ghu_x\", refreshToken: \"ghr_y\", expiresIn: 3600))\n184|}\n185|\n186|@Test func devicePollRejectsPATShapedToken() async {\n187|    let transport = TestTransport([jsonResponse([\"access_token\": \"[REDACTED]\"])])\n188|    do {\n189|        _ = try await GitHubDeviceFlow(transport: transport).pollOnce(config: testConfig, deviceCode: \"dev\")\n190|        Issue.record(\"pollOnce admitted PAT-shaped token\")\n191|    } catch let error as GitHubAuth.AuthError {\n192|        #expect(error == .patNotSupported)\n193|    } catch {\n194|        Issue.record(\"Unexpected error: \\(error)\")\n195|    }\n196|}\n197|\n198|@Test func slowDownAddsFiveSeconds() {\n199|    #expect(GitHubDeviceFlow.nextInterval(current: 5, after: .slowDown) == 10)\n200|    #expect(GitHubDeviceFlow.nextInterval(current: 5, after: .pending) == 5)\n201|    #expect(GitHubDeviceFlow.nextInterval(current: 10, after: .slowDown) == 15)\n202|}\n203|\n204|// MARK: - API client\n205|\n206|@Test func apiClientSendsBearerAndDecodesUser() async throws {\n207|    let transport = TestTransport([jsonResponse([\"login\": \"octo\", \"id\": 42])])\n208|    let user = try await GitHubAPIClient(transport: transport).fetchUser(config: testConfig, token: \"ghu_x\")\n209|    #expect(user.login == \"octo\")\n210|    #expect(user.id == 42)\n211|    let requests = await transport.requests\n212|    #expect(requests[0].headers[\"Authorization\"] == \"Bearer [REDACTED]\")\n213|}\n214|\n215|@Test func apiClientRefusesPATWithoutNetwork() async {\n216|    let transport = TestTransport([jsonResponse([\"login\": \"x\", \"id\": 1])])\n217|    do {\n218|        _ = try await GitHubAPIClient(transport: transport).fetchUser(config: testConfig, token: \"ghp_abc\")\n219|        Issue.record(\"fetchUser admitted PAT\")\n220|    } catch let error as GitHubAuth.AuthError {\n221|        #expect(error == .patNotSupported)\n222|    } catch {\n223|        Issue.record(\"Unexpected: \\(error)\")\n224|    }\n225|    #expect(await transport.requests.count == 0)\n226|}\n227|\n228|@Test func apiClientMaps401And403() async {\n229|    let unauth = TestTransport([GitHubHTTPResponse(status: 401, body: Data())])\n230|    do {\n231|        _ = try await GitHubAPIClient(transport: unauth).fetchInstallations(config: testConfig, token: \"ghu_x\")\n232|        Issue.record(\"Expected unauthorized\")\n233|    } catch let error as GitHubAuth.AuthError {\n234|        #expect(error == .unauthorized)\n235|    } catch { Issue.record(\"Unexpected: \\(error)\") }\n236|\n237|    let forbidden = TestTransport([GitHubHTTPResponse(status: 403, body: Data(\"forbidden\".utf8))])\n238|    do {\n239|        _ = try await GitHubAPIClient(transport: forbidden).fetchInstallations(config: testConfig, token: \"ghu_x\")\n240|        Issue.record(\"Expected forbidden\")\n241|    } catch let error as GitHubAuth.AuthError {\n242|        guard case .forbidden = error else { Issue.record(\"Expected forbidden, got \\(error)\"); return }\n243|    } catch { Issue.record(\"Unexpected: \\(error)\") }\n244|}\n245|\n246|@Test func apiClientDecodesInstallationsAndRepositories() async throws {\n247|    let transport = TestTransport([\n248|        jsonResponse([\"installations\": [[\"id\": 7, \"account\": [\"login\": \"acme\", \"type\": \"Organization\"]]]]),\n249|        jsonResponse([\"repositories\": [[\"id\": 9, \"full_name\": \"acme/app\", \"private\": true]]]),\n250|    ])\n251|    let api = GitHubAPIClient(transport: transport)\n252|    let installs = try await api.fetchInstallations(config: testConfig, token: \"ghu_x\")\n253|    #expect(installs == [.init(id: 7, account: \"acme\", accountType: \"Organization\")])\n254|    let repos = try await api.fetchRepositories(config: testConfig, token: \"ghu_x\", installationID: 7)\n255|    #expect(repos == [.init(id: 9, fullName: \"acme/app\", isPrivate: true)])\n256|}\n257|\n258|// MARK: - Token refresh\n259|\n260|@Test func refreshSavesAtomicallyAndCoalescesConcurrentCallers() async throws {\n261|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n262|    let current = GitHubAuth.TokenRecord(accessToken: \"ghu_old\", refreshToken: \"ghr_old\", expiresAt: Date().addingTimeInterval(-10))\n263|    try await store.save(current, serverHost: \"github.com\", userID: 1, clientID: testConfig.clientID)\n264|    // Two identical success payloads available; coalescing must consume exactly one.\n265|    let transport = TestTransport([\n266|        jsonResponse([\"access_token\": \"ghu_new\", \"refresh_token\": \"ghr_new\", \"expires_in\": 3600]),\n267|        jsonResponse([\"access_token\": \"ghu_new\", \"refresh_token\": \"ghr_new\", \"expires_in\": 3600]),\n268|    ])\n269|    let refresher = GitHubTokenRefresh(transport: transport, store: store)\n270|    async let first = refresher.refresh(config: testConfig, userID: 1, current: current)\n271|    async let second = refresher.refresh(config: testConfig, userID: 1, current: current)\n272|    let (firstResult, secondResult) = try await (first, second)\n273|    #expect(firstResult.accessToken == \"ghu_new\")\n274|    #expect(secondResult.accessToken == \"ghu_new\")\n275|    #expect(await transport.requests.count == 1)\n276|    let stored = await store.load(serverHost: \"github.com\", userID: 1, clientID: testConfig.clientID)\n277|    #expect(stored?.accessToken == \"ghu_new\")\n278|    #expect(stored?.refreshToken == \"ghr_new\")\n279|}\n280|\n281|@Test func refreshRejectsFineGrainedPATWithoutSaving() async throws {\n282|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n283|    let current = GitHubAuth.TokenRecord(accessToken: \"ghu_old\", refreshToken: \"ghr_old\", expiresAt: nil)\n284|    try await store.save(current, serverHost: \"github.com\", userID: 1, clientID: testConfig.clientID)\n285|    let transport = TestTransport([jsonResponse([\"access_token\": \"github_pat_fine123\", \"refresh_token\": \"ghr_new\", \"expires_in\": 3600])])\n286|    do {\n287|        _ = try await GitHubTokenRefresh(transport: transport, store: store).refresh(config: testConfig, userID: 1, current: current)\n288|        Issue.record(\"refresh admitted github_pat_ token\")\n289|    } catch let error as GitHubAuth.AuthError {\n290|        #expect(error == .patNotSupported)\n291|    } catch {\n292|        Issue.record(\"Unexpected: \\(error)\")\n293|    }\n294|    #expect(await store.load(serverHost: \"github.com\", userID: 1, clientID: testConfig.clientID)?.accessToken == \"ghu_old\")\n295|    #expect(await transport.requests.count == 1)\n296|}\n297|\n298|@Test func refreshFailsClosedWithoutRefreshToken() async {\n299|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n300|    let current = GitHubAuth.TokenRecord(accessToken: \"ghu_old\", refreshToken: nil, expiresAt: nil)\n301|    let refresher = GitHubTokenRefresh(transport: TestTransport([]), store: store)\n302|    do {\n303|        _ = try await refresher.refresh(config: testConfig, userID: 1, current: current)\n304|        Issue.record(\"Expected tokenRefreshFailed\")\n305|    } catch let error as GitHubAuth.AuthError {\n306|        #expect(error == .tokenRefreshFailed)\n307|    } catch { Issue.record(\"Unexpected: \\(error)\") }\n308|}\n309|\n310|@Test func refreshMapsInvalidGrantToRevoked() async throws {\n311|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n312|    let current = GitHubAuth.TokenRecord(accessToken: \"ghu_old\", refreshToken: \"ghr_bad\", expiresAt: nil)\n313|    try await store.save(current, serverHost: \"github.com\", userID: 1, clientID: testConfig.clientID)\n314|    let transport = TestTransport([jsonResponse([\"error\": \"invalid_grant\"])])\n315|    do {\n316|        _ = try await GitHubTokenRefresh(transport: transport, store: store).refresh(config: testConfig, userID: 1, current: current)\n317|        Issue.record(\"Expected revoked\")\n318|    } catch let error as GitHubAuth.AuthError {\n319|        #expect(error == .revoked)\n320|    } catch { Issue.record(\"Unexpected: \\(error)\") }\n321|}\n322|\n323|// MARK: - Keychain\n324|\n325|@Test func keychainRoundTripsAndDeletesScopedRecords() async throws {\n326|    let store = GitHubKeychainStore(service: \"works.relux.runnercontrol.test.\\(UUID().uuidString)\", backend: InMemoryKeychainBackend())\n327|    let record = GitHubAuth.TokenRecord(accessToken: \"ghu_a\", refreshToken: \"ghr_b\", expiresAt: Date())\n328|    try await store.save(record, serverHost: \"github.com\", userID: 11, clientID: \"cid\")\n329|    #expect(await store.load(serverHost: \"github.com\", userID: 11, clientID: \"cid\") == record)\n330|    #expect(await store.load(serverHost: \"github.com\", userID: 12, clientID: \"cid\") == nil)\n331|    await store.delete(serverHost: \"github.com\", userID: 11, clientID: \"cid\")\n332|    #expect(await store.load(serverHost: \"github.com\", userID: 11, clientID: \"cid\") == nil)\n333|}\n334|\n335|@Test func keychainDeleteAllSweepsOnlyMatchingClient() async throws {\n336|    let store = GitHubKeychainStore(service: \"works.relux.runnercontrol.test.\\(UUID().uuidString)\", backend: InMemoryKeychainBackend())\n337|    let record = GitHubAuth.TokenRecord(accessToken: \"ghu_a\", refreshToken: nil, expiresAt: nil)\n338|    try await store.save(record, serverHost: \"github.com\", userID: 1, clientID: \"cid-a\")\n339|    try await store.save(record, serverHost: \"github.com\", userID: 2, clientID: \"cid-a\")\n340|    try await store.save(record, serverHost: \"github.com\", userID: 1, clientID: \"cid-b\")\n341|    await store.deleteAll(serverHost: \"github.com\", clientID: \"cid-a\")\n342|    #expect(await store.load(serverHost: \"github.com\", userID: 1, clientID: \"cid-a\") == nil)\n343|    #expect(await store.load(serverHost: \"github.com\", userID: 2, clientID: \"cid-a\") == nil)\n344|    #expect(await store.load(serverHost: \"github.com\", userID: 1, clientID: \"cid-b\") != nil)\n345|}\n346|\n347|@Test func realKeychainBackendRoundTripsUniqueRecord() throws {\n348|    // Focused real-Security check with a unique service/account; always cleaned up.\n349|    let backend = SecurityKeychainBackend()\n350|    let service = \"works.relux.runnercontrol.test.\\(UUID().uuidString)\"\n351|    let account = \"github.com:999:\\(UUID().uuidString)\"\n352|    let data = Data(\"{\\\"accessToken\\\":\\\"ghu_probe\\\"}\".utf8)\n353|    defer { backend.delete(service: service, account: account) }\n354|    try backend.save(data, service: service, account: account)\n355|    #expect(backend.load(service: service, account: account) == data)\n356|    backend.delete(service: service, account: account)\n357|    #expect(backend.load(service: service, account: account) == nil)\n358|}","final_result":true}}}
