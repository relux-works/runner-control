{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c629","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":367,"recorded_at":1780531400000729,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"call_id":"call_01a0a85b05f470658833cf2ed5b55ce5","text":"Read text file `Targets/RunnerControl/Sources/ManagementWindowContainer.swift`.\n1|import AppKit\n2|import SwiftUI\n3|import RunnerControlCore\n4|\n5|/// Management window composition root. Reads Relux state, dispatches production effects.\n6|struct ManagementWindowContainer: View {\n7|    @ObservedObject var runners: Runners.State\n8|    @ObservedObject var github: GitHubAuth.State\n9|    @ObservedObject private var updater = AppRegistry.updater\n10|    @StateObject private var launchAtLogin = LaunchAtLoginModel()\n11|    @State private var serverHostText: String = \"github.com\"\n12|\n13|    var body: some View {\n14|        ManagementWindowPage(\n15|            props: .init(\n16|                runners: runners.runners,\n17|                changing: runners.changing,\n18|                runnerError: runners.lastError,\n19|                github: .init(\n20|                    connection: github.connection,\n21|                    username: github.username,\n22|                    serverHost: github.serverHost,\n23|                    serverHostText: serverHostText,\n24|                    installations: github.installations,\n25|                    selectedInstallationID: github.selectedInstallationID,\n26|                    repositories: github.repositories,\n27|                    selectedRepositoryIDs: github.selectedRepositoryIDs,\n28|                    syncError: github.syncError,\n29|                    lastSyncAt: github.lastSyncAt\n30|                ),\n31|                general: .init(\n32|                    appVersion: Bundle.main.object(forInfoDictionaryKey: \"CFBundleShortVersionString\") as? String ?? \"—\",\n33|                    canCheckForUpdates: updater.canCheckForUpdates,\n34|                    automaticChecks: updater.automaticallyChecks,\n35|                    automaticDownloads: updater.automaticallyDownloads,\n36|                    launchAtLoginEnabled: launchAtLogin.enabled\n37|                )\n38|            ),\n39|            reactions: .init(\n40|                setEnabled: change,\n41|                enableAll: { for runner in runners.runners where [.stopped, .failed].contains(runner.status) { change(runner.id, true) } },\n42|                disableAll: { confirmStop(ids: runners.runners.map(\\.id)) },\n43|                openGitHub: { NSWorkspace.shared.open($0.githubURL) },\n44|                openLogs: { NSWorkspace.shared.open($0.logs) },\n45|                showDirectory: { NSWorkspace.shared.open($0.directory) },\n46|                clearRunnerError: { Task { await action { Runners.Action.clearError } } },\n47|                serverHostChanged: { serverHostText = $0 },\n48|                beginLogin: beginLogin,\n49|                cancelLogin: { Task { await action { GitHubAuth.Effect.cancelLogin } } },\n50|                logout: { Task { await action { GitHubAuth.Effect.logout } } },\n51|                openVerification: { NSWorkspace.shared.open($0) },\n52|                copyCode: copyCode,\n53|                refreshInstallations: { Task { await action { GitHubAuth.Effect.refreshInstallations } } },\n54|                selectInstallation: { id in Task { await action { GitHubAuth.Effect.selectInstallation(id) } } },\n55|                selectRepositories: { ids in Task { await action { GitHubAuth.Effect.selectRepositories(ids) } } },\n56|                grantAccess: { NSWorkspace.shared.open(URL(string: \"https://github.com/settings/installations\")!) },\n57|                revokeInGitHub: { NSWorkspace.shared.open(URL(string: \"https://github.com/settings/connections/applications\")!) },\n58|                checkForUpdates: updater.check,\n59|                setAutomaticChecks: updater.setAutomaticChecks,\n60|                setAutomaticDownloads: updater.setAutomaticDownloads,\n61|                setLaunchAtLogin: { launchAtLogin.setEnabled($0) },\n62|                quit: quit\n63|            )\n64|        )\n65|    }\n66|\n67|    private func beginLogin() {\n68|        let host = serverHostText.trimmingCharacters(in: .whitespacesAndNewlines)\n69|        let value = host.isEmpty ? nil : host\n70|        Task { await action { GitHubAuth.Effect.beginLogin(serverHost: value) } }\n71|    }\n72|\n73|    private func copyCode(_ code: String) {\n74|        NSPasteboard.general.clearContents()\n75|        NSPasteboard.general.setString(code, forType: .string)\n76|    }\n77|\n78|    private func change(_ id: String, _ enabled: Bool) {\n79|        if enabled { Task { await action { Runners.Effect.setEnabled(id, true) } } }\n80|        else { confirmStop(ids: [id]) }\n81|    }\n82|\n83|    private func confirmStop(ids: [String]) {\n84|        let alert = NSAlert()\n85|        alert.messageText = \"Выключить CI?\"\n86|        alert.informativeText = \"Если раннер сейчас выполняет сборку, она будет прервана. Новые задания он принимать не будет.\"\n87|        alert.addButton(withTitle: \"Отмена\")\n88|        alert.addButton(withTitle: \"Выключить\")\n89|        guard alert.runModal() == .alertSecondButtonReturn else { return }\n90|        Task { for id in ids { await action { Runners.Effect.setEnabled(id, false) } } }\n91|    }\n92|\n93|    private func quit() {\n94|        guard runners.changing.isEmpty else { return }\n95|        if runners.runners.contains(where: { $0.status == .running || $0.status == .failed || $0.status == .unknown }) {\n96|            let alert = NSAlert()\n97|            alert.messageText = \"Закрыть Runner Control?\"\n98|            alert.informativeText = \"Включённые раннеры продолжат работать в фоне. Для остановки CI сначала нажмите «Выключить все».\"\n99|            alert.addButton(withTitle: \"Остаться\")\n100|            alert.addButton(withTitle: \"Закрыть приложение\")\n101|            guard alert.runModal() == .alertSecondButtonReturn else { return }\n102|        }\n103|        NSApp.terminate(nil)\n104|    }\n105|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62b","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":368,"recorded_at":1780531400000731,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"call_id":"call_01a0a85b0742720db9ac9aa685ccce0a","text":"Read text file `Targets/RunnerControl/Sources/AppRegistry.swift`.\n1|import Foundation\n2|import RunnerControlCore\n3|\n4|@MainActor enum AppRegistry {\n5|    static let state = Runners.State()\n6|    static let githubState = GitHubAuth.State()\n7|    static let updater = AppUpdater()\n8|    private static var task: Task<Void, Never>?\n9|    private static var githubTask: Task<Void, Never>?\n10|    static func start() {\n11|        guard task == nil else { return }\n12|        updater.start()\n13|        // One composition root for every MenuBarExtra presentation.\n14|        task = Task {\n15|            _ = await RunnerRuntime.make(state: state, githubState: githubState)\n16|            await action { GitHubAuth.Effect.restoreSession }\n17|            while !Task.isCancelled {\n18|                await action { Runners.Effect.refresh }\n19|                try? await Task.sleep(for: .seconds(3))\n20|            }\n21|        }\n22|        githubTask = Task {\n23|            var ticks = 0\n24|            while !Task.isCancelled {\n25|                try? await Task.sleep(for: .seconds(30))\n26|                ticks += 1\n27|                // GitHub sync is best-effort and never blocks local control.\n28|                if case .connected = githubState.connection {\n29|                    await action { GitHubAuth.Effect.refreshInstallations }\n30|                }\n31|                _ = ticks\n32|            }\n33|        }\n34|    }\n35|\n36|    static func openManagementWindow() {\n37|        NotificationCenter.default.post(name: .openManagementWindow, object: nil)\n38|    }\n39|}\n40|\n41|extension Notification.Name {\n42|    static let openManagementWindow = Notification.Name(\"works.relux.runnercontrol.openManagementWindow\")\n43|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
