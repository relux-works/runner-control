ername, let userID, let host):\n26|            self.username = username\n27|            self.userID = userID\n28|            serverHost = host\n29|            connection = .verifyingInstallations(username: username)\n30|        case .installationsLoaded(let installations):\n31|            self.installations = installations\n32|            if selectedInstallationID == nil {\n33|                selectedInstallationID = installations.first?.id\n34|            } else if let selected = selectedInstallationID, !installations.contains(where: { $0.id == selected }) {\n35|                selectedInstallationID = installations.first?.id\n36|            }\n37|        case .repositoriesLoaded(let installationID, let repositories):\n38|            if selectedInstallationID == installationID || selectedInstallationID == nil {\n39|                self.repositories = repositories\n40|            }\n41|        case .connected(let username, let host, let date):\n42|            self.username = username\n43|            serverHost = host\n44|            connection = .connected(username: username, serverHost: host)\n45|            lastSyncAt = date\n46|            syncError = nil\n47|        case .failed(let message, let retry):\n48|            connection = .failed(message: message, retry: retry)\n49|        case .syncFailed(let message):\n50|            syncError = message\n51|        case .syncSucceeded(let date):\n52|            lastSyncAt = date\n53|            syncError = nil\n54|        case .installationSelected(let id):\n55|            selectedInstallationID = id\n56|            repositories = []\n57|        case .repositoriesSelected(let ids):\n58|            selectedRepositoryIDs = ids\n59|        case .loggedOut:\n60|            connection = .disconnected\n61|            username = nil\n62|            userID = nil\n63|            installations = []\n64|            selectedInstallationID = nil\n65|            repositories = []\n66|            selectedRepositoryIDs = []\n67|            syncError = nil\n68|            lastSyncAt = nil\n69|        case .clearSyncError:\n70|            syncError = nil\n71|        }\n72|    }\n73|}","final_result":true}}}
