{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c703","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":476,"recorded_at":1780531400000947,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"task_stream":{"kind":"task","id":"01a0a85b-31c4-78e1-add2-d6b974e5e234"},"task_id":"01a0a85b-31c4-78e1-add2-d6b974e5e234","event":{"kind":"output","task_id":"01a0a85b-31c4-78e1-add2-d6b974e5e234","chunk":"Read text file `Packages/RunnerControlCore/Sources/GitHubAuth+Flow.swift`.\n(499 line(s) above)\n500|    private func refreshInstallations() async {\n501|        let gen = generation\n502|        guard session != nil else { return }\n503|        let sess: GitHubAuth.Session\n504|        let token: String\n505|        do {\n506|            (sess, token) = try await currentToken(generation: gen)\n507|        } catch is CancellationError {\n508|            return\n509|        } catch let error as GitHubAuth.AuthError {\n510|            guard !isStale(gen) else { return }\n511|            switch error {\n512|            case .revoked, .unauthorized, .tokenRefreshFailed:\n513|                await action { GitHubAuth.Action.failed(message: GitHubAuth.AuthError.revoked.localizedDescription, retry: .relogin) }\n514|            default:\n515|                await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n516|            }\n517|            return\n518|        } catch {\n519|            guard !isStale(gen) else { return }\n520|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n521|            return\n522|        }\n523|        do {\n524|            let installations = try await api.fetchInstallations(config: sess.config, token: token)\n525|            guard !isStale(gen) else { return }\n526|            await action { GitHubAuth.Action.installationsLoaded(installations) }\n527|            guard !isStale(gen) else { return }\n528|            await action { GitHubAuth.Action.syncSucceeded(now()) }\n529|        } catch is CancellationError {\n530|            return\n531|        } catch let error as GitHubAuth.AuthError {\n532|            guard !isStale(gen) else { return }\n533|            switch error {\n534|            case .unauthorized, .revoked:\n535|                await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .relogin) }\n536|            default:\n537|                await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n538|            }\n539|        } catch {\n540|            guard !isStale(gen) else { return }\n541|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n542|        }\n543|    }\n544|\n545|    private func selectInstallation(_ id: Int64?) async {\n546|        let gen = generation\n547|        await action { GitHubAuth.Action.installationSelected(id) }\n548|        guard !isStale(gen) else { return }\n549|        guard let id, session != nil else { return }\n550|        let sess: GitHubAuth.Session\n551|        let token: String\n552|        do {\n553|            (sess, token) = try await currentToken(generation: gen)\n554|        } catch is CancellationError {\n555|            return\n556|        } catch let error as GitHubAuth.AuthError {\n557|            guard !isStale(gen) else { return }\n558|            switch error {\n559|            case .revoked, .unauthorized, .tokenRefreshFailed:\n560|                await action { GitHubAuth.Action.failed(message: GitHubAuth.AuthError.revoked.localizedDescription, retry: .relogin) }\n561|            default:\n562|                await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n563|            }\n564|            return\n565|        } catch {\n566|            guard !isStale(gen) else { return }\n567|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n568|            return\n569|        }\n570|        do {\n571|            let repos = try await api.fetchRepositories(config: sess.config, token: token, installationID: id)\n572|            guard !isStale(gen) else { return }\n573|            await action { GitHubAuth.Action.repositoriesLoaded(installationID: id, repositories: repos) }\n574|            guard !isStale(gen) else { return }\n575|            await action { GitHubAuth.Action.syncSucceeded(now()) }\n576|        } catch is CancellationError {\n577|            return\n578|        } catch let error as GitHubAuth.AuthError {\n579|            guard !isStale(gen) else { return }\n580|            switch error {\n581|            case .unauthorized, .revoked:\n582|                await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .relogin) }\n583|            default:\n584|                await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n585|            }\n586|        } catch {\n587|            guard !isStale(gen) else { return }\n588|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n589|        }\n590|    }\n591|\n592|    private nonisolated static func retryKind(for error: GitHubAuth.AuthError) -> GitHubAuth.RetryKind {\n593|        switch error {\n594|        case .denied, .codeExpired: .newCode\n595|        case .unauthorized, .revoked, .tokenRefreshFailed: .relogin\n596|        case .forbidden, .needsApproval, .needsInstallation: .grantAccess\n597|        case .ssoRequired, .missingClientID, .patNotSupported: .none\n598|        case .cancelled: .none\n599|        case .network, .rateLimited, .slowDown, .authorizationPending: .retry\n600|        }\n601|    }\n602|}","final_result":true}}}
