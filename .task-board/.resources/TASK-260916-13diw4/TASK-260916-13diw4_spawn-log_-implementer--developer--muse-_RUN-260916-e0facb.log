{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c523","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":236,"recorded_at":1780531400000467,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"task_stream":{"kind":"task","id":"01a0a85a-e5c1-7f70-aadf-1292f77b8418"},"task_id":"01a0a85a-e5c1-7f70-aadf-1292f77b8418","event":{"kind":"output","task_id":"01a0a85a-e5c1-7f70-aadf-1292f77b8418","chunk":"Read text file `Packages/RunnerControlCore/Sources/GitHubAuth+Models.swift`.\n1|import Foundation\n2|\n3|extension GitHubAuth {\n4|    /// Token metadata kept outside Relux state. Secret values live only in Keychain.\n5|    public struct TokenRecord: Sendable, Equatable, Codable {\n6|        public let accessToken: String\n7|        public let refreshToken: String?\n8|        public let expiresAt: Date?\n9|        public let obtainedAt: Date\n10|\n11|        public init(accessToken: String, refreshToken: String?, expiresAt: Date?, obtainedAt: Date = Date()) {\n12|            self.accessToken = accessToken\n13|            self.refreshToken = refreshToken\n14|            self.expiresAt = expiresAt\n15|            self.obtainedAt = obtainedAt\n16|        }\n17|    }\n18|\n19|    public struct Installation: Sendable, Equatable, Identifiable {\n20|        public let id: Int64\n21|        public let account: String\n22|        public let accountType: String\n23|        public init(id: Int64, account: String, accountType: String) {\n24|            self.id = id; self.account = account; self.accountType = accountType\n25|        }\n26|    }\n27|\n28|    public struct Repository: Sendable, Equatable, Identifiable {\n29|        public let id: Int64\n30|        public let fullName: String\n31|        public let isPrivate: Bool\n32|        public init(id: Int64, fullName: String, isPrivate: Bool) {\n33|            self.id = id; self.fullName = fullName; self.isPrivate = isPrivate\n34|        }\n35|    }\n36|\n37|    /// Connection phases. No tokens, device codes, or secrets are stored here.\n38|    public enum Connection: Sendable, Equatable {\n39|        case disconnected\n40|        case requestingCode\n41|        case awaitingUser(userCode: String, verificationURI: URL, expiresIn: Int, interval: Int)\n42|        case verifyingAccount\n43|        case verifyingInstallations(username: String)\n44|        case connected(username: String, serverHost: String)\n45|        case failed(message: String, retry: RetryKind)\n46|    }\n47|\n48|    public enum RetryKind: Sendable, Equatable {\n49|        case newCode\n50|        case retry\n51|        case relogin\n52|        case grantAccess\n53|        case none\n54|    }\n55|\n56|    public enum AuthError: LocalizedError, Sendable, Equatable {\n57|        case cancelled\n58|        case denied\n59|        case codeExpired\n60|        case slowDown\n61|        case authorizationPending\n62|        case network(String)\n63|        case unauthorized\n64|        case forbidden(String)\n65|        case rateLimited(retryAfter: Int?)\n66|        case needsInstallation\n67|        case needsApproval\n68|        case ssoRequired\n69|        case revoked\n70|        case missingClientID(binding: String)\n71|        case patNotSupported\n72|        case tokenRefreshFailed\n73|\n74|        public var errorDescription: String? {\n75|            switch self {\n76|            case .cancelled: \"Login cancelled.\"\n77|            case .denied: \"Access denied on GitHub. Approve Runner Control or try again.\"\n78|            case .codeExpired: \"Code expired. Get a new code.\"\n79|            case .slowDown: \"Polling too fast. Backing off.\"\n80|            case .authorizationPending: \"Waiting for confirmation on GitHub…\"\n81|            case .network(let message): message\n82|            case .unauthorized: \"Session expired or revoked (401). Sign in again.\"\n83|            case .forbidden(let message): message.isEmpty ? \"Access forbidden (403). Grant the App or approve access.\" : message\n84|            case .rateLimited: \"GitHub rate limit reached. Data may be stale; local control still works.\"\n85|            case .needsInstallation: \"GitHub App is not installed for this account. Grant access to continue.\"\n86|            case .needsApproval: \"Organization approval is required.\"\n87|            case .ssoRequired: \"SSO authorization is required for this organization.\"\n88|            case .revoked: \"Session was revoked. Sign in again.\"\n89|            case .missingClientID(let binding): \"GitHub App client_id is not provisioned. Missing binding: \\(binding).\"\n90|            case .patNotSupported: \"Personal access tokens are not supported. Use Sign in with GitHub (Device Flow).\"\n91|            case .tokenRefreshFailed: \"Token refresh failed. Sign in again.\"\n92|            }\n93|        }\n94|    }\n95|}","final_result":true}}}
