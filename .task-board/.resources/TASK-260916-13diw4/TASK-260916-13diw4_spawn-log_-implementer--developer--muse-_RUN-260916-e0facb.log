{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c435","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":117,"recorded_at":1780531400000229,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"task_stream":{"kind":"task","id":"01a0a85a-c742-7453-8478-016e5355b7e3"},"task_id":"01a0a85a-c742-7453-8478-016e5355b7e3","event":{"kind":"output","task_id":"01a0a85a-c742-7453-8478-016e5355b7e3","chunk":"Read text file `Packages/RunnerControlCore/Package.swift`.\n1|// swift-tools-version: 6.0\n2|// Generated by ios-app-manager macos-app.\n3|import PackageDescription\n4|let package = Package(\n5|    name: \"RunnerControlCore\",\n6|    platforms: [.macOS(\"14.0\")],\n7|    products: [.library(name: \"RunnerControlCore\", targets: [\"RunnerControlCore\"])],\n8|    dependencies: [\n9|        .package(url: \"https://github.com/relux-works/swift-relux.git\", exact: \"9.2.0\"),\n10|    ],\n11|    targets: [\n12|        .target(name: \"RunnerControlCore\", dependencies: [\n13|                .product(name: \"Relux\", package: \"swift-relux\"),\n14|        ], path: \"Sources\"),\n15|        .testTarget(name: \"RunnerControlCoreTests\", dependencies: [\"RunnerControlCore\"], path: \"Tests\"),\n16|    ]\n17|)","final_result":true}}}
