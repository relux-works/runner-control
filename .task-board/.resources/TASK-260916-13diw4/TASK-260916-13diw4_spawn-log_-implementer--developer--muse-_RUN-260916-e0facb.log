{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000df1f","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":3562,"recorded_at":1780531400007119,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"task_stream":{"kind":"task","id":"01a0a86f-56ff-7400-a954-88228628201c"},"task_id":"01a0a86f-56ff-7400-a954-88228628201c","event":{"kind":"output","task_id":"01a0a86f-56ff-7400-a954-88228628201c","chunk":"Read text file `Targets/RunnerControl/Sources/RunnerRegistrationPage.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|/// New-runner wizard. Pure view: all state arrives via props, all actions\n5|/// leave via reactions that dispatch production `RunnerRegistration.Effect`s.\n6|struct RunnerRegistrationPage: View {\n7|    struct Props {\n8|        let phase: RunnerRegistration.Phase\n9|        let working: Bool\n10|        let scopeKind: ScopeKind\n11|        let org: String\n12|        let repoOwner: String\n13|        let repoName: String\n14|        let runnerName: String\n15|        let labelsText: String\n16|        let installDirName: String\n17|        let workFolder: String\n18|        let groupName: String\n19|        let allowGroupMutation: Bool\n20|        let selectedRepositoryIDs: Set<Int64>\n21|        let repositories: [GitHubAuth.Repository]\n22|        let installations: [GitHubAuth.Installation]\n23|        let githubConnected: Bool\n24|        let githubUsername: String?\n25|        let group: RunnerRegistration.RunnerGroup?\n26|        let groupRepositoryIDs: [Int64]\n27|        let assetFilename: String?\n28|        let installPath: String?\n29|        let runnerID: Int64?\n30|        let localAgentID: Int64?\n31|        let completedSteps: Set<String>\n32|        let error: String?\n33|        let failedStep: String?\n34|        let permissionError: String?\n35|    }\n36|\n37|    enum ScopeKind: Hashable {\n38|        case organization\n39|        case repository\n40|    }\n41|\n42|    struct Reactions {\n43|        let scopeKindChanged: (ScopeKind) -> Void\n44|        let orgChanged: (String) -> Void\n45|        let repoOwnerChanged: (String) -> Void\n46|        let repoNameChanged: (String) -> Void\n47|        let runnerNameChanged: (String) -> Void\n48|        let labelsChanged: (String) -> Void\n49|        let installDirChanged: (String) -> Void\n50|        let workFolderChanged: (String) -> Void\n51|        let groupNameChanged: (String) -> Void\n52|        let allowGroupMutationChanged: (Bool) -> Void\n53|        let repositoriesChanged: (Set<Int64>) -> Void\n54|        let beginDraft: () -> Void\n55|        let resolveGroup: () -> Void\n56|        let downloadAndInstall: () -> Void\n57|        let registerRunner: () -> Void\n58|        let setupService: () -> Void\n59|        let applyRepositoryAccess: () -> Void\n60|        let applyLabels: () -> Void\n61|        let retry: () -> Void\n62|        let cancel: () -> Void\n63|        let reset: () -> Void\n64|        let dismissPermission: () -> Void\n65|        let close: () -> Void\n66|    }\n67|\n68|    let props: Props\n69|    let reactions: Reactions\n70|\n71|    var body: some View {\n72|        ScrollView {\n73|            VStack(alignment: .leading, spacing: 16) {\n74|                header\n75|                if !props.githubConnected {\n76|                    githubRequired\n77|                }\n78|                scopeSection\n79|                runnerSection\n80|                if props.scopeKind == .organization {\n81|                    groupSection\n82|                }\n83|                stepsSection\n84|                if let permission = props.permissionError {\n85|                    permissionView(permission)\n86|                } else if let error = props.error {\n87|                    errorView(error)\n88|                }\n89|                if props.phase == .done {\n90|                    doneView\n91|                }\n92|                footer\n93|            }\n94|            .padding(20)\n95|            .frame(maxWidth: .infinity, alignment: .leading)\n96|        }\n97|        .frame(width: 640, height: 560)\n98|    }\n99|\n100|    private var header: some View {\n101|        VStack(alignment: .leading, spacing: 3) {\n102|            Text(\"Новый раннер на этом Mac\").font(.system(size: 15, weight: .semibold))\n103|            Text(\"Официальная сборка GitHub под вашу архитектуру, регистрация без терминала.\")\n104|                .font(.callout).foregroundStyle(.secondary)\n105|        }\n106|    }\n107|\n108|    private var githubRequired: some View {\n109|        HStack(alignment: .top, spacing: 8) {\n110|            Image(systemName: \"person.crop.circle.badge.exclamationmark\").foregroundStyle(.orange)\n111|            Text(\"Войдите через GitHub во вкладке «GitHub», затем вернитесь сюда.\")\n112|            Text(\"Регистрация требует подтверждённой сессии.\")\n113|                .font(.callout)\n114|        }\n115|        .padding(10)\n116|        .background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n117|    }\n118|\n119|    private var scopeSection: some View {\n120|        VStack(alignment: .leading, spacing: 8) {\n121|            Text(\"Область регистрации\").font(.system(size: 13, weight: .semibold))\n122|            Picker(\"Область\", selection: Binding(\n123|                get: { props.scopeKind },\n124|                set: reactions.scopeKindChanged\n125|            )) {\n126|                Text(\"Организация\").tag(ScopeKind.organization)\n127|                Text(\"Репозиторий\").tag(ScopeKind.repository)\n128|            }\n129|            .pickerStyle(.segmented)\n130|            .frame(width: 320)\n(more lines below)","final_result":true}}}
