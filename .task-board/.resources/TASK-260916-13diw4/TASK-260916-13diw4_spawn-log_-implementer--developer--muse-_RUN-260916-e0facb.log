         Text(\"Раннеры на этом Mac\").font(.system(size: 15, weight: .semibold))\n37|                    Text(\"\\(Host.current().localizedName ?? \"Этот Mac\") · \\(active) из \\(props.runners.count) включено\")\n38|                        .font(.system(size: 11)).foregroundStyle(.secondary)\n39|                }\n40|                Spacer()\n41|                Circle().fill(active > 0 ? Color.green : Color.secondary.opacity(0.4)).frame(width: 8, height: 8)\n42|            }\n43|            if props.runners.isEmpty {\n44|                VStack(alignment: .leading, spacing: 8) {\n45|                    Text(\"Добавьте раннер на этом Mac\").font(.callout.weight(.medium))\n46|                    Text(\"Учётная запись GitHub не обязательна. Локальное управление работает без входа.\")\n47|                        .font(.callout).foregroundStyle(.secondary)\n48|                }\n49|                .padding(.vertical, 8)\n50|            }\n51|            ScrollView {\n52|                VStack(spacing: 10) {\n53|                    ForEach(props.runners) { runner in\n54|                        RunnerCard(\n55|                            snapshot: runner,\n56|                            changing: props.changing.contains(runner.id),\n57|                            setEnabled: { reactions.setEnabled(runner.id, $0) },\n58|                            openGitHub: { reactions.openGitHub(runner.definition) },\n59|                            openLogs: { reactions.openLogs(runner.definition) }\n60|                        )\n61|                    }\n62|                }\n63|            }\n64|            if let error = props.runnerError {\n65|                HStack(alignment: .top, spacing: 8) {\n66|                    Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n67|                    Text(error).font(.caption).textSelection(.enabled).lineLimit(6)\n68|                    Spacer(minLength: 0)\n69|                    Button(action: reactions.clearRunnerError) { Image(systemName: \"xmark\") }.buttonStyle(.plain)\n70|                }.padding(10).background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n71|            }\n72|            HStack(spacing: 8) {\n73|                Button(\"Включить все\", action: reactions.enableAll)\n74|                    .buttonStyle(.borderedProminent).tint(.teal)\n75|                    .disabled(!props.changing.isEmpty || props.runners.allSatisfy { $0.status == .running || $0.status == .checking || $0.status == .missing || $0.status == .unknown })\n76|                Button(\"Выключить все…\", action: reactions.disableAll)\n77|                    .buttonStyle(.bordered)\n78|                    .disabled(!props.changing.isEmpty || props.runners.allSatisfy { $0.status == .stopped || $0.status == .checking })\n79|            }\n80|            Text(\"Закрытие приложения не останавливает CI. Автозапуск определяется настройками каждой службы.\")\n81|                .font(.system(size: 11)).foregroundStyle(.secondary)\n82|        }\n83|        .padding(20)\n84|    }\n85|\n86|    // MARK: - GitHub\n87|\n88|    private var githubTab: some View {\n89|        ScrollView {\n90|            VStack(alignment: .leading, spacing: 16) {\n91|                switch props.github.connection {\n92|                case .disconnected:\n93|                    disconnectedView\n94|                case .requestingCode:\n95|                    HStack(spacing: 10) {\n96|                        ProgressView().controlSize(.small)\n97|                        Text(\"Запрашиваем код входа…\").font(.callout)\n98|                    }\n99|                    .padding(.vertical, 20)\n100|                case .awaitingUser(let userCode, let uri, let expiresIn, let interval):\n101|                    awaitingView(userCode: userCode, uri: uri, expiresIn: expiresIn, interval: interval)\n102|                case .verifyingAccount:\n103|                    HStack(spacing: 10) {\n104|                        ProgressView().controlSize(.small)\n105|                        Text(\"Проверяем аккаунт…\").font(.callout)\n106|                    }\n107|                    .padding(.vertical, 20)\n108|                case .verifyingInstallations(let username):\n109|                    HStack(spacing: 10) {\n110|                        ProgressView().controlSize(.small)\n111|                        Text(\"Проверяем установки для @\\(username)…\").font(.callout)\n112|                    }\n113|                    .padding(.vertical, 20)\n114|                case .connected(let username, let host):\n115|                    connectedView(username: username, host: host)\n116|                case .failed(let message, let retry):\n117|                    failedView(message: message, retry: retry)\n118|                }\n119|            }\n120|            .padding(20)\n121|            .frame(maxWidth: .infinity, alignment: .leading)\n122|        }\n123|    }\n124|\n125|    private var disconnectedView: some View {\n126|        VStack(alignment: .leading, spacing: 12) {\n127|            Text(\"Подключение GitHub\").font(.system(size: 15, weight: .semibold))\n128|            Text(\"Необязательно. Локальное включение и выключение работает без входа. Вход добавляет подтверждённые online/busy/labels.\")\n129|                .font(.callout).foregroundStyle(.secondary)\n130|            HStack(spacing: 8) {\n131|                Text(\"Сервер:\").font(.callout)\n132|                TextField(\"github.com\", text: Binding(\n133|                    get: { props.github.serverHostText },\n134|                    set: reactions.serverHostChanged\n135|                ))\n136|                .textFieldStyle(.roundedBorder)\n137|                .frame(width: 220)\n138|                .accessibilityIdentifier(\"GitHub server host field\")\n139|            }\n140|            Button(\"Войти через GitHub\", action: reactions.beginLogin)\n141|                .buttonStyle(.borderedProminent).tint(.teal)\n142|                .accessibilityIdentifier(\"GitHub sign in button\")\n143|            Text(\"Откроется код подтверждения. Пароль и 2FA вводятся только на сайте GitHub. Токены хранятся в Keychain.\")\n144|                .font(.system(size: 11)).foregroundStyle(.secondary)\n145|            if let syncError = props.github.syncError {\n146|                Text(syncError).font(.caption).foregroundStyle(.orange)\n147|            }\n148|        }\n149|    }\n150|\n151|    private func awaitingView(userCode: String, uri: URL, expiresIn: Int, interval: Int) -> some View {\n152|        VStack(alignment: .leading, spacing: 12) {\n153|            Text(\"Подтвердите подключение на GitHub\").font(.system(size: 15, weight: .semibold))\n154|            Text(userCode)\n155|                .font(.system(size: 32, weight: .bold, design: .monospaced))\n156|                .textSelection(.enabled)\n157|                .accessibilityIdentifier(\"GitHub user code\")\n158|            Text(\"Код действует ~\\(expiresIn / 60) мин. Опрос каждые \\(interval) c.\")\n159|                .font(.callout).foregroundStyle(.secondary)\n160|            HStack(spacing: 8) {\n161|                Button(\"Скопировать код\") { reactions.copyCode(userCode) }\n162|                    .buttonStyle(.bordered)\n163|                    .accessibilityIdentifier(\"GitHub copy code button\")\n164|                Button(\"Открыть GitHub\") { reactions.openVerification(uri) }\n165|                    .buttonStyle(.bordered)\n166|                    .accessibilityIdentifier(\"GitHub open verification button\")\n167|                Button(\"Отмена\", action: reactions.cancelLogin)\n168|                    .buttonStyle(.plain).foregroundStyle(.secondary)\n169|                    .accessibilityIdentifier(\"GitHub cancel login button\")\n170|            }\n171|            Text(\"Браузер — системный по умолчанию. Отмена уничтожает временный код и прекращает опрос.\")\n172|                .font(.system(size: 11)).foregroundStyle(.secondary)\n173|        }\n174|    }\n175|\n176|    private func connectedView(username: String, host: String) -> some View {\n177|        VStack(alignment: .leading, spacing: 12) {\n178|            HStack {\n179|                VStack(alignment: .leading, spacing: 3) {\n180|                    Text(\"Подключено как @\\(username)\").font(.system(size: 15, weight: .semibold))\n181|                    Text(host).font(.callout).foregroundStyle(.secondary)\n182|                    if let synced = props.github.lastSyncAt {\n183|                        Text(\"Обновлено: \\(synced.formatted(date: .omitted, time: .standard))\")\n184|                            .font(.system(size: 11)).foregroundStyle(.secondary)\n185|                    }\n186|                }\n187|                Spacer()\n188|                Button(\"Обновить\", action: reactions.refreshInstallations)\n189|                    .buttonStyle(.bordered).controlSize(.small)\n190|                    .accessibilityIdentifier(\"GitHub refresh button\")\n191|            }\n192|            if let syncError = props.github.syncError {\n193|                HStack(alignment: .top, spacing: 8) {\n194|                    Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n195|                    Text(syncError).font(.caption).lineLimit(6)\n196|                    Spacer(minLength: 0)\n197|                }.padding(10).background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n198|            }\n199|            HStack(spacing: 8) {\n200|                Button(\"Выйти на этом Mac\", action: reactions.logout)\n201|                    .buttonStyle(.bordered)\n202|                    .accessibilityIdentifier(\"GitHub logout button\")\n203|                Button(\"Отозвать доступ в GitHub…\", action: reactions.revokeInGitHub)\n204|                    .buttonStyle(.plain).font(.callout).foregroundStyle(.secondary)\n205|            }\n206|            Text(\"Выход удаляет локальные токены и останавливает опрос GitHub. Локальные службы продолжают работать.\")\n207|                .font(.system(size: 11)).foregroundStyle(.secondary)\n208|            Divider()\n209|            HStack {\n210|                Text(\"Установки GitHub App\").font(.system(size: 13, weight: .semibold))\n211|                Spacer()\n212|                Button(\"Предоставить доступ организации…\", action: reactions.grantAccess)\n213|                    .buttonStyle(.plain).font(.callout)\n214|            }\n215|            if props.github.installations.isEmpty {\n216|                Text(\"Нет доступных установок. Предоставьте доступ организации или запросите одобрение владельца.\")\n217|                    .font(.callout).foregroundStyle(.secondary)\n218|            } else {\n219|                Picker(\"Установка\", selection: Binding(\n220|                    get: { props.github.selectedInstallationID },\n221|                    set: reactions.selectInstallation\n222|                )) {\n223|                    ForEach(props.github.installations) { installation in\n224|                        Text(\"\\(installation.account) (\\(installation.accountType))\").tag(Optional(installation.id))\n225|                    }\n226|                }\n227|                .pickerStyle(.menu)\n228|                .accessibilityIdentifier(\"GitHub installation picker\")\n229|            }\n230|            Text(\"Репозитории\").font(.system(size: 13, weight: .semibold))\n231|            if props.github.repositories.isEmpty {\n232|                Text(\"Репозитории выбранной установки появятся здесь.\")\n233|                    .font(.callout).foregroundStyle(.secondary)\n234|            } else {\n235|                VStack(alignment: .leading, spacing: 6) {\n236|                    ForEach(props.github.repositories) { repo in\n237|                        Toggle(\n238|                            repo.fullName,\n239|                            isOn: Binding(\n240|                                get: { props.github.selectedRepositoryIDs.contains(repo.id) },\n241|                                set: { enabled in\n242|                                    var next = props.github.selectedRepositoryIDs\n243|                                    if enabled { next.insert(repo.id) } else { next.remove(repo.id) }\n244|                                    reactions.selectRepositories(next)\n245|                                }\n246|                            )\n247|                        )\n248|                        .font(.callout)\n249|                    }\n250|                }\n251|            }\n252|            if !props.github.selectedRepositoryIDs.isEmpty {\n253|                Text(\"Выбрано: \\(props.github.selectedRepositoryIDs.count). Применяется при регистрации раннера.\")\n254|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n255|            }\n256|        }\n257|    }\n258|\n259|    private func failedView(message: String, retry: GitHubAuth.RetryKind) -> some View {\n260|        VStack(alignment: .leading, spacing: 12) {\n261|            HStack(spacing: 8) {\n262|                Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n263|                Text(\"Не удалось подключить GitHub\").font(.system(size: 15, weight: .semibold))\n264|            }\n265|            Text(message).font(.callout).textSelection(.enabled)\n266|            HStack(spacing: 8) {\n267|                switch retry {\n268|                case .newCode:\n269|                    Button(\"Получить новый код\", action: reactions.beginLogin)\n270|                        .buttonStyle(.borderedProminent).tint(.teal)\n271|                case .retry:\n272|                    Button(\"Повторить\", action: reactions.beginLogin)\n273|                        .buttonStyle(.borderedProminent).tint(.teal)\n274|                case .relogin:\n275|                    Button(\"Войти снова\", action: reactions.beginLogin)\n276|                        .buttonStyle(.borderedProminent).tint(.teal)\n277|                case .grantAccess:\n278|                    Button(\"Предоставить доступ…\", action: reactions.grantAccess)\n279|                        .buttonStyle(.borderedProminent).tint(.teal)\n280|                    Button(\"Повторить\", action: reactions.beginLogin)\n281|                        .buttonStyle(.bordered)\n282|                case .none:\n283|                    EmptyView()\n284|                }\n285|                if retry != .none {\n286|                    Button(\"Отмена\", action: reactions.cancelLogin)\n287|                        .buttonStyle(.plain).foregroundStyle(.secondary)\n288|                } else {\n289|                    Button(\"Назад\", action: reactions.cancelLogin)\n290|                        .buttonStyle(.bordered)\n291|                }\n292|            }\n293|            Text(\"Локальное управление раннерами остаётся доступным.\")\n294|                .font(.system(size: 11)).foregroundStyle(.secondary)\n295|        }\n296|    }\n297|\n298|    // MARK: - General\n299|\n300|    private var generalTab: some View {\n301|        ScrollView {\n302|            VStack(alignment: .leading, spacing: 14) {\n303|                Text(\"Основные\").font(.system(size: 15, weight: .semibold))\n304|                Toggle(\n305|                    \"Открывать Runner Control при входе\",\n306|                    isOn: Binding(get: { props.general.launchAtLoginEnabled }, set: reactions.setLaunchAtLogin)\n307|                )\n308|                .font(.callout)\n309|                Text(\"Отдельно от запуска CI. Для новых управляемых служб запуск раннера при входе выключен.\")\n310|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n311|                Divider()\n312|                HStack {\n313|                    Text(\"Версия \\(props.general.appVersion)\").font(.callout).foregroundStyle(.secondary)\n314|                    Spacer()\n315|                    Button(\"Проверить обновления…\", action: reactions.checkForUpdates)\n316|                        .disabled(!props.general.canCheckForUpdates)\n317|                }\n318|                Toggle(\"Проверять автоматически\", isOn: Binding(get: { props.general.automaticChecks }, set: reactions.setAutomaticChecks))\n319|                    .font(.callout)\n320|                Toggle(\"Устанавливать автоматически\", isOn: Binding(get: { props.general.automaticDownloads }, set: reactions.setAutomaticDownloads))\n321|                    .font(.callout)\n322|                    .disabled(!props.general.automaticChecks)\n323|                Text(\"Выход и обновление приложения оставляют уже запущенные службы работать.\")\n324|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n325|                Divider()\n326|                HStack {\n327|                    Text(\"RELUX WORKS\").font(.system(size: 9, weight: .semibold, design: .monospaced)).tracking(1.5).foregroundStyle(.tertiary)\n328|                    Spacer()\n329|                    Button(\"Закрыть приложение\", action: reactions.quit).buttonStyle(.plain)\n330|                        .font(.system(size: 11)).foregroundStyle(.secondary)\n331|                }\n332|            }\n333|            .padding(20)\n334|            .frame(maxWidth: .infinity, alignment: .leading)\n335|        }\n336|    }\n337|}","final_result":true}}}
