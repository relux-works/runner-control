unnerError: () -> Void\n39|        let serverHostChanged: (String) -> Void\n40|        let beginLogin: () -> Void\n41|        let cancelLogin: () -> Void\n42|        let logout: () -> Void\n43|        let openVerification: (URL) -> Void\n44|        let copyCode: (String) -> Void\n45|        let refreshInstallations: () -> Void\n46|        let selectInstallation: (Int64?) -> Void\n47|        let selectRepositories: (Set<Int64>) -> Void\n48|        let grantAccess: () -> Void\n49|        let revokeInGitHub: () -> Void\n50|        let checkForUpdates: () -> Void\n51|        let setAutomaticChecks: (Bool) -> Void\n52|        let setAutomaticDownloads: (Bool) -> Void\n53|        let setLaunchAtLogin: (Bool) -> Void\n54|        let quit: () -> Void\n55|    }\n56|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c815","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":613,"recorded_at":1780531400001221,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"call_id":"call_01a0a85b87567371bf5e862c050979dc","text":"Read text file `Targets/RunnerControl/Sources/App.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|@main\n5|struct RunnerControl: App {\n6|    @NSApplicationDelegateAdaptor(AppDelegate.self) private var delegate\n7|    @StateObject private var state = AppRegistry.state\n8|    var body: some Scene {\n9|        MenuBarExtra {\n10|            RunnerContainer(state: state)\n11|        } label: {\n12|            Image(systemName: state.activeCount > 0 ? \"bolt.circle.fill\" : \"bolt.circle\")\n13|                .accessibilityLabel(\"Runner Control: \\(state.activeCount) включено\")\n14|        }\n15|        .menuBarExtraStyle(.window)\n16|    }\n17|}\n18|\n19|@MainActor final class AppDelegate: NSObject, NSApplicationDelegate {\n20|    private var window: NSWindow?\n21|    func applicationDidFinishLaunching(_ notification: Notification) {\n22|        NSApp.setActivationPolicy(.accessory)\n23|        AppRegistry.start()\n24|        NotificationCenter.default.addObserver(\n25|            forName: .openManagementWindow,\n26|            object: nil,\n27|            queue: .main\n28|        ) { [weak self] _ in\n29|            Task { @MainActor in self?.showControls() }\n30|        }\n31|        if !UserDefaults.standard.bool(forKey: \"hasShownWelcome\") {\n32|            showControls()\n33|            UserDefaults.standard.set(true, forKey: \"hasShownWelcome\")\n34|        }\n35|    }\n36|    func applicationShouldHandleReopen(_ sender: NSApplication, hasVisibleWindows flag: Bool) -> Bool {\n37|        showControls()\n38|        return true\n39|    }\n40|    private func showControls() {\n41|        if window == nil {\n42|            let controller = NSHostingController(rootView: ManagementWindowContainer(\n43|                runners: AppRegistry.state,\n44|                github: AppRegistry.githubState\n45|            ))\n46|            let value = NSWindow(contentViewController: controller)\n47|            value.title = \"Раннеры и настройки\"\n48|            value.styleMask = [.titled, .closable, .miniaturizable, .resizable]\n49|            value.isReleasedWhenClosed = false\n50|            value.setContentSize(NSSize(width: 760, height: 540))\n51|            value.minSize = NSSize(width: 700, height: 480)\n52|            value.center()\n53|            window = value\n54|        }\n55|        window?.makeKeyAndOrderFront(nil)\n56|        NSApp.activate(ignoringOtherApps: true)\n57|    }\n58|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c817","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":614,"recorded_at":1780531400001223,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"call_id":"call_01a0a85b88067506a8dff6e068e055c5","text":"Read text file `Targets/RunnerControl/Sources/RunnerContainer.swift`.\n1|import SwiftUI\n2|import AppKit\n3|import RunnerControlCore\n4|\n5|struct RunnerContainer: View {\n6|    @ObservedObject var state: Runners.State\n7|    @ObservedObject private var updater = AppRegistry.updater\n8|    var body: some View {\n9|        RunnerPage(\n10|            props: .init(runners: state.runners, changing: state.changing, error: state.lastError, canCheckForUpdates: updater.canCheckForUpdates, automaticChecks: updater.automaticallyChecks, automaticDownloads: updater.automaticallyDownloads),\n11|            reactions: .init(\n12|                setEnabled: change,\n13|                enableAll: { for runner in state.runners where [.stopped, .failed].contains(runner.status) { change(runner.id, true) } },\n14|                disableAll: { confirmStop(ids: state.runners.map(\\.id)) },\n15|                openGitHub: { NSWorkspace.shared.open($0.githubURL) },\n16|                openLogs: { NSWorkspace.shared.open($0.logs) },\n17|                clearError: { Task { await action { Runners.Action.clearError } } },\n18|                quit: quit,\n19|                checkForUpdates: updater.check,\n20|                setAutomaticChecks: updater.setAutomaticChecks,\n21|                setAutomaticDownloads: updater.setAutomaticDownloads,\n22|                openSettings: { AppRegistry.openManagementWindow() }\n23|            )\n24|        )\n25|    }\n26|    private func change(_ id: String, _ enabled: Bool) {\n27|        if enabled { Task { await action { Runners.Effect.setEnabled(id, true) } } }\n28|        else { confirmStop(ids: [id]) }\n29|    }\n30|    private func confirmStop(ids: [String]) {\n31|        let alert = NSAlert()\n32|        alert.messageText = \"Выключить CI?\"\n33|        alert.informativeText = \"Если раннер сейчас выполняет сборку, она будет прервана. Новые задания он принимать не будет.\"\n34|        alert.addButton(withTitle: \"Отмена\")\n35|        alert.addButton(withTitle: \"Выключить\")\n36|        guard alert.runModal() == .alertSecondButtonReturn else { return }\n37|        Task { for id in ids { await action { Runners.Effect.setEnabled(id, false) } } }\n38|    }\n39|    private func quit() {\n40|        guard state.changing.isEmpty else { return }\n41|        if state.runners.contains(where: { $0.status == .running || $0.status == .failed || $0.status == .unknown }) {\n42|            let alert = NSAlert()\n43|            alert.messageText = \"Закрыть Runner Control?\"\n44|            alert.informativeText = \"Включённые раннеры продолжат работать в фоне. Для остановки CI сначала нажмите «Выключить все».\"\n45|            alert.addButton(withTitle: \"Остаться\")\n46|            alert.addButton(withTitle: \"Закрыть приложение\")\n47|            guard alert.runModal() == .alertSecondButtonReturn else { return }\n48|        }\n49|        NSApp.terminate(nil)\n50|    }\n51|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c819","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":615,"recorded_at":1780531400001225,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"call_id":"call_01a0a85b88be70a19ff1d19e9f34d71a","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubSessionIdentityStore.swift`.\n1|import Foundation\n2|\n3|/// Non-secret session identity persisted separately from Keychain tokens.\n4|/// Lets the app find its Keychain record after relaunch without storing secrets.\n5|public struct GitHubSessionIdentity: Sendable, Equatable, Codable {\n6|    public let serverHost: String\n7|    public let userID: Int64\n8|    public let clientID: String\n9|    public let username: String\n10|\n11|    public init(serverHost: String, userID: Int64, clientID: String, username: String) {\n12|        self.serverHost = serverHost\n13|        self.userID = userID\n14|        self.clientID = clientID\n15|        self.username = username\n16|    }\n17|}\n18|\n19|public protocol GitHubSessionIdentityStoring: Sendable {\n20|    func save(_ identity: GitHubSessionIdentity) async\n21|    func load() async -> GitHubSessionIdentity?\n22|    func delete() async\n23|}\n24|\n25|/// Production store: UserDefaults holds only non-secret identity, never tokens.\n26|public actor UserDefaultsGitHubSessionIdentityStore: GitHubSessionIdentityStoring {\n27|    private let defaults: UserDefaults\n28|    private let key: String\n29|\n30|    public init(\n31|        defaults: UserDefaults = .standard,\n32|        key: String = \"works.relux.runnercontrol.github.sessionIdentity.v1\"\n33|    ) {\n34|        self.defaults = defaults\n35|        self.key = key\n36|    }\n37|\n38|    public func save(_ identity: GitHubSessionIdentity) async {\n39|        if let data = try? JSONEncoder().encode(identity) {\n40|            defaults.set(data, forKey: key)\n41|        }\n42|    }\n43|\n44|    public func load() async -> GitHubSessionIdentity? {\n45|        guard let data = defaults.data(forKey: key) else { return nil }\n46|        return try? JSONDecoder().decode(GitHubSessionIdentity.self, from: data)\n47|    }\n48|\n49|    public func delete() async {\n50|        defaults.removeObject(forKey: key)\n51|    }\n52|}\n53|\n54|/// In-memory store for unit tests. Never used in production.\n55|public final class InMemoryGitHubSessionIdentityStore: GitHubSessionIdentityStoring, @unchecked Sendable {\n56|    private let lock = NSLock()\n57|    private var value: GitHubSessionIdentity?\n58|    public init(value: GitHubSessionIdentity? = nil) { self.value = value }\n59|    public func save(_ identity: GitHubSessionIdentity) async {\n60|        lock.withLock { value = identity }\n61|    }\n62|    public func load() async -> GitHubSessionIdentity? {\n63|        lock.withLock { value }\n64|    }\n65|    public func delete() async {\n66|        lock.withLock { value = nil }\n67|    }\n68|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
