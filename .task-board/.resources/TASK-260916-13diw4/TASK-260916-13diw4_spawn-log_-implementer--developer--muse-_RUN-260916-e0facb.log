    }\n152|    }\n153|\n154|    private var runnerSection: some View {\n155|        VStack(alignment: .leading, spacing: 8) {\n156|            Text(\"Раннер\").font(.system(size: 13, weight: .semibold))\n157|            labeledField(\n158|                \"Имя раннера\", text: props.runnerName, set: reactions.runnerNameChanged,\n159|                placeholder: Host.current().localizedName ?? \"macbook\", id: \"Registration runner name field\"\n160|            )\n161|            labeledField(\n162|                \"Метки (через запятую)\", text: props.labelsText, set: reactions.labelsChanged,\n163|                placeholder: \"self-hosted, macOS\", id: \"Registration labels field\"\n164|            )\n165|            HStack(spacing: 8) {\n166|                labeledField(\n167|                    \"Папка установки\", text: props.installDirName, set: reactions.installDirChanged,\n168|                    placeholder: \"macbook-iv\", id: \"Registration install dir field\"\n169|                )\n170|                labeledField(\n171|                    \"Рабочая папка\", text: props.workFolder, set: reactions.workFolderChanged,\n172|                    placeholder: \"_work\", id: \"Registration work folder field\"\n173|                )\n174|            }\n175|            Text(\"Пути без пробелов: ~/Library/GitHubActions/<папка>.\")\n176|            Text(\"Повторный запуск продолжает с места остановки и не создаёт дубликатов.\")\n177|                .font(.system(size: 11)).foregroundStyle(.secondary)\n178|        }\n179|    }\n180|\n181|    private var groupSection: some View {\n182|        VStack(alignment: .leading, spacing: 8) {\n183|            Text(\"Группа и доступ к репозиториям\").font(.system(size: 13, weight: .semibold))\n184|            labeledField(\n185|                \"Группа этого Mac\", text: props.groupName, set: reactions.groupNameChanged,\n186|                placeholder: \"RunnerControl-Mac\", id: \"Registration group name field\"\n187|            )\n188|            if let group = props.group {\n189|                Text(\"Группа: \\(group.name) · id \\(group.id) · \\(group.visibility).\")\n190|                Text(\"Доступ: \\(props.groupRepositoryIDs.count) репозиториев.\")\n191|                    .font(.callout).foregroundStyle(.secondary)\n192|            } else {\n193|                Text(\"Группа создаётся только для этого Mac. Чужие и общие группы приложение не изменяет.\")\n194|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n195|            }\n196|            Toggle(\n197|                \"Разрешаю изменять доступ только для указанной группы этого Mac\",\n198|                isOn: Binding(get: { props.allowGroupMutation }, set: reactions.allowGroupMutationChanged)\n199|            )\n200|            .font(.callout)\n201|            .accessibilityIdentifier(\"Registration allow group mutation toggle\")\n202|            if props.repositories.isEmpty {\n203|                Text(\"Репозитории выбранной установки появятся здесь после входа.\")\n204|                    .font(.callout).foregroundStyle(.secondary)\n205|            } else {\n206|                VStack(alignment: .leading, spacing: 6) {\n207|                    ForEach(props.repositories) { repo in\n208|                        Toggle(\n209|                            repo.fullName,\n210|                            isOn: Binding(\n211|                                get: { props.selectedRepositoryIDs.contains(repo.id) },\n212|                                set: { enabled in\n213|                                    var next = props.selectedRepositoryIDs\n214|                                    if enabled { next.insert(repo.id) } else { next.remove(repo.id) }\n215|                                    reactions.repositoriesChanged(next)\n216|                                }\n217|                            )\n218|                        )\n219|                        .font(.callout)\n220|                    }\n221|                }\n222|                if props.group != nil {\n223|                    Button(\"Применить доступ к репозиториям\", action: reactions.applyRepositoryAccess)\n224|                        .buttonStyle(.bordered)\n225|                        .disabled(props.working || !props.allowGroupMutation)\n226|                        .accessibilityIdentifier(\"Registration apply repo access button\")\n227|                }\n228|            }\n229|        }\n230|    }\n231|\n232|    private var stepsSection: some View {\n233|        VStack(alignment: .leading, spacing: 8) {\n234|            Text(\"Шаги\").font(.system(size: 13, weight: .semibold))\n235|            stepRow(\n236|                title: \"Черновик\", done: props.phase != .idle,\n237|                action: reactions.beginDraft, button: \"Начать\",\n238|                id: \"Registration begin button\"\n239|            )\n240|            if props.scopeKind == .organization {\n241|                stepRow(\n242|                    title: \"Группа этого Mac\",\n243|                    done: props.completedSteps.contains(\"resolveGroup\"),\n244|                    action: reactions.resolveGroup, button: \"Найти или создать\",\n245|                    id: \"Registration resolve group button\"\n246|                )\n247|            }\n248|            stepRow(\n249|                title: \"Загрузка и проверка сборки\",\n250|                done: props.completedSteps.contains(\"downloadAndInstall\"),\n251|                action: reactions.downloadAndInstall, button: \"Загрузить и установить\",\n252|                id: \"Registration install button\",\n253|                detail: props.assetFilename ?? props.installPath\n254|            )\n255|            stepRow(\n256|                title: \"Регистрация\",\n257|                done: props.completedSteps.contains(\"registerRunner\"),\n258|                action: reactions.registerRunner, button: \"Зарегистрировать\",\n259|                id: \"Registration register button\",\n260|                detail: props.runnerID.map { \"id \\($0)\" }\n261|            )\n262|            stepRow(\n263|                title: \"Служба (автозапуск выключен)\",\n264|                done: props.completedSteps.contains(\"setupService\"),\n265|                action: reactions.setupService, button: \"Настроить службу\",\n266|                id: \"Registration setup service button\"\n267|            )\n268|            HStack(spacing: 8) {\n269|                Button(\"Метки: применить текущие\", action: reactions.applyLabels)\n270|                    .buttonStyle(.bordered).controlSize(.small)\n271|                    .disabled(props.working || props.runnerID == nil)\n272|                    .accessibilityIdentifier(\"Registration apply labels button\")\n273|                if props.failedStep != nil {\n274|                    Button(\"Повторить шаг\", action: reactions.retry)\n275|                        .buttonStyle(.borderedProminent).tint(.teal).controlSize(.small)\n276|                        .disabled(props.working)\n277|                        .accessibilityIdentifier(\"Registration retry button\")\n278|                }\n279|                if props.working {\n280|                    ProgressView().controlSize(.small)\n281|                }\n282|            }\n283|        }\n284|    }\n285|\n286|    private func stepRow(\n287|        title: String, done: Bool, action: @escaping () -> Void,\n288|        button: String, id: String, detail: String? = nil\n289|    ) -> some View {\n290|        HStack(spacing: 8) {\n291|            Image(systemName: done ? \"checkmark.circle.fill\" : \"circle\")\n292|                .foregroundStyle(done ? .green : .secondary)\n293|            VStack(alignment: .leading, spacing: 2) {\n294|                Text(title).font(.callout)\n295|                if let detail {\n296|                    Text(detail).font(.system(size: 11)).foregroundStyle(.secondary).lineLimit(2)\n297|                }\n298|            }\n299|            Spacer()\n300|            Button(button, action: action)\n301|                .buttonStyle(.bordered).controlSize(.small)\n302|                .disabled(props.working || !props.githubConnected)\n303|                .accessibilityIdentifier(id)\n304|        }\n305|    }\n306|\n307|    private func permissionView(_ message: String) -> some View {\n308|        VStack(alignment: .leading, spacing: 8) {\n309|            HStack(alignment: .top, spacing: 8) {\n310|                Image(systemName: \"lock.triangle.fill\").foregroundStyle(.red)\n311|                Text(message).font(.callout).textSelection(.enabled)\n312|                Spacer(minLength: 0)\n313|            }\n314|            HStack(spacing: 8) {\n315|                Button(\"Повторить шаг\", action: reactions.retry)\n316|                    .buttonStyle(.borderedProminent).tint(.teal).controlSize(.small)\n317|                    .disabled(props.working)\n318|                Button(\"Скрыть\", action: reactions.dismissPermission)\n319|                    .buttonStyle(.plain).font(.callout).foregroundStyle(.secondary)\n320|            }\n321|            Text(\"Ошибка прав сохранена и не стирается правками черновика.\")\n322|                .font(.system(size: 11)).foregroundStyle(.secondary)\n323|        }\n324|        .padding(10)\n325|        .background(.red.opacity(0.07), in: RoundedRectangle(cornerRadius: 10))\n326|    }\n327|\n328|    private func errorView(_ message: String) -> some View {\n329|        HStack(alignment: .top, spacing: 8) {\n330|            Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n331|            Text(message).font(.caption).textSelection(.enabled).lineLimit(6)\n332|            Spacer(minLength: 0)\n333|        }\n334|        .padding(10)\n335|        .background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n336|    }\n337|\n338|    private var doneView: some View {\n339|        VStack(alignment: .leading, spacing: 6) {\n340|            HStack(spacing: 8) {\n341|                Image(systemName: \"checkmark.seal.fill\").foregroundStyle(.green)\n342|                Text(\"Раннер зарегистрирован\").font(.callout.weight(.medium))\n343|            }\n344|            if let path = props.installPath {\n345|                Text(path).font(.system(size: 11)).foregroundStyle(.secondary).textSelection(.enabled)\n346|            }\n347|            Text(\"Включите его во вкладке «Раннеры», когда будете готовы. Токен регистрации уже удалён.\")\n348|                .font(.system(size: 11)).foregroundStyle(.secondary)\n349|        }\n350|        .padding(10)\n351|        .background(.green.opacity(0.07), in: RoundedRectangle(cornerRadius: 10))\n352|    }\n353|\n354|    private var footer: some View {\n355|        HStack(spacing: 8) {\n356|            if props.working {\n357|                Button(\"Отмена\", action: reactions.cancel)\n358|                    .buttonStyle(.bordered)\n359|                    .accessibilityIdentifier(\"Registration cancel button\")\n360|            } else if props.phase != .idle {\n361|                Button(\"Сбросить\", action: reactions.reset)\n362|                    .buttonStyle(.plain).foregroundStyle(.secondary)\n363|                    .accessibilityIdentifier(\"Registration reset button\")\n364|            }\n365|            Spacer()\n366|            Button(\"Закрыть\", action: reactions.close)\n367|                .buttonStyle(.bordered)\n368|                .accessibilityIdentifier(\"Registration close button\")\n369|        }\n370|    }\n371|\n372|    private func labeledField(\n373|        _ title: String, text: String, set: @escaping (String) -> Void,\n374|        placeholder: String, id: String\n375|    ) -> some View {\n376|        VStack(alignment: .leading, spacing: 4) {\n377|            Text(title).font(.system(size: 11)).foregroundStyle(.secondary)\n378|            TextField(placeholder, text: Binding(get: { text }, set: set))\n379|                .textFieldStyle(.roundedBorder)\n380|                .accessibilityIdentifier(id)\n381|        }\n382|    }\n383|}","final_result":true}}}
