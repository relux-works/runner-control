{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c1","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":187,"recorded_at":1780531400000369,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"call_id":"call_01a0a85ad3bf71099d7728a7ad735531","text":"Read text file `Packages/RunnerControlCore/Sources/Runners+Service.swift`.\n1|import Foundation\n2|public protocol RunnerServicing: Sendable {\n3|    func snapshots() async -> [Runners.Snapshot]\n4|    func setEnabled(_ enabled: Bool, id: String) async throws\n5|}\n6|public actor LaunchAgentService: RunnerServicing {\n7|    private let definitions: [Runners.Definition]\n8|    private let executor: any CommandExecuting\n9|    private let domain: String\n10|    public init(definitions: [Runners.Definition] = Runners.Definition.installed(), executor: any CommandExecuting = CommandExecutor(), userID: UInt32 = getuid()) {\n11|        self.definitions = definitions; self.executor = executor; domain = \"gui/\\(userID)\"\n12|    }\n13|    public static func status(from result: CommandResult) -> Runners.Status {\n14|        if result.code == 0 { return result.output.contains(\"state = running\") ? .running : .failed }\n15|        if result.code == 113 && result.output.contains(\"Could not find service\") { return .stopped }\n16|        return .unknown\n17|    }\n18|    private func validate(_ definition: Runners.Definition) throws {\n19|        let data = try Data(contentsOf: definition.plist)\n20|        guard let plist = try PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],\n21|              plist[\"Label\"] as? String == definition.id,\n22|              let args = plist[\"ProgramArguments\"] as? [String],\n23|              args == [definition.directory.appendingPathComponent(\"runsvc.sh\").path],\n24|              plist[\"WorkingDirectory\"] as? String == definition.directory.path else {\n25|            throw RunnerError.message(\"Настройки службы не соответствуют раннеру \\(definition.title).\")\n26|        }\n27|        guard !definition.directory.path.contains(\" \") else { throw RunnerError.message(\"Путь раннера содержит пробел. Исправьте путь перед запуском.\") }\n28|        let registration = try Data(contentsOf: definition.directory.appendingPathComponent(\".runner\"))\n29|        // GitHub writes a UTF-8 BOM; JSONSerialization accepts it.\n30|        guard let object = try JSONSerialization.jsonObject(with: registration) as? [String: Any],\n31|              let work = object[\"workFolder\"] as? String, !work.contains(\" \") else {\n32|            throw RunnerError.message(\"Рабочий каталог раннера отсутствует или содержит пробел.\")\n33|        }\n34|    }\n35|    public func snapshots() async -> [Runners.Snapshot] {\n36|        var values: [Runners.Snapshot] = []\n37|        for d in definitions {\n38|            do {\n39|                try validate(d)\n40|                let result = try await executor.run(\"/bin/launchctl\", [\"print\", domain + \"/\" + d.id])\n41|                let status = Self.status(from: result)\n42|                values.append(.init(definition: d, status: status, message: status == .unknown ? String(result.output.prefix(300)) : nil))\n43|            } catch { values.append(.init(definition: d, status: .missing, message: error.localizedDescription)) }\n44|        }\n45|        return values\n46|    }\n47|    public func setEnabled(_ enabled: Bool, id: String) async throws {\n48|        guard let d = definitions.first(where: { $0.id == id }) else { throw RunnerError.message(\"Неизвестный раннер.\") }\n49|        // Stop must remain possible even if someone damages registration/plist.\n50|        if enabled { try validate(d) }\n51|        let key = domain + \"/\" + d.id\n52|        let current = try await executor.run(\"/bin/launchctl\", [\"print\", key])\n53|        let state = Self.status(from: current)\n54|        if !enabled && state == .stopped || enabled && state == .running { return }\n55|        guard state != .unknown else { throw RunnerError.message(String(current.output.prefix(500))) }\n56|        if enabled && state == .failed {\n57|            let removed = try await executor.run(\"/bin/launchctl\", [\"bootout\", key])\n58|            guard removed.code == 0 else { throw RunnerError.message(removed.output) }\n59|        }\n60|        let result = try await executor.run(\"/bin/launchctl\", enabled ? [\"bootstrap\", domain, d.plist.path] : [\"bootout\", key])\n61|        guard result.code == 0 else { throw RunnerError.message(String(result.output.prefix(700))) }\n62|        for _ in 0..<30 {\n63|            let result = try await executor.run(\"/bin/launchctl\", [\"print\", key])\n64|            if Self.status(from: result) == (enabled ? .running : .stopped) { return }\n65|            try await Task.sleep(for: .milliseconds(100))\n66|        }\n67|        throw RunnerError.message(\"Служба не подтвердила изменение состояния. Проверьте журнал раннера.\")\n68|    }\n69|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c3","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":188,"recorded_at":1780531400000371,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"call_id":"call_01a0a85ad4ca7068ab879aacf9af44ec","text":"Read text file `Packages/RunnerControlCore/Sources/Runners+Flow.swift`.\n1|import Relux\n2|extension Runners {\n3|    public protocol IFlow: Relux.Flow {}\n4|    public actor Flow {\n5|        public let dispatcher: Relux.Dispatcher\n6|        private let service: any RunnerServicing\n7|        private var working: Set<String> = []\n8|        private var refreshing = false\n9|        private var revision = 0\n10|        public init(service: any RunnerServicing, dispatcher: Relux.Dispatcher? = nil) async {\n11|            self.service = service\n12|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n13|        }\n14|    }\n15|}\n16|extension Runners.Flow: Runners.IFlow {\n17|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n18|        guard let effect = effect as? Runners.Effect else { return .success }\n19|        switch effect {\n20|        case .refresh:\n21|            guard !refreshing, working.isEmpty else { return .success }\n22|            refreshing = true\n23|            let startedAt = revision\n24|            let snapshots = await service.snapshots()\n25|            // Do not publish a stale read if a command started during this await.\n26|            if working.isEmpty && revision == startedAt { await action { Runners.Action.refreshed(snapshots) } }\n27|            refreshing = false\n28|        case .setEnabled(let id, let enabled):\n29|            guard !working.contains(id) else { return .success }\n30|            working.insert(id)\n31|            revision += 1\n32|            await action { Runners.Action.changing(id, true) }\n33|            do { try await service.setEnabled(enabled, id: id) }\n34|            catch { await action { Runners.Action.failed(error.localizedDescription) } }\n35|            let snapshots = await service.snapshots()\n36|            await action { Runners.Action.refreshed(snapshots) }\n37|            working.remove(id)\n38|            await action { Runners.Action.changing(id, false) }\n39|        }\n40|        return .success\n41|    }\n42|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c5","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":189,"recorded_at":1780531400000373,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"call_id":"call_01a0a85ad5fb700e99d06af40c2e3ccf","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubAPIClient.swift`.\n1|import Foundation\n2|\n3|/// GitHub REST client for user/installation/repository reads. Takes tokens explicitly; never stores them.\n4|public actor GitHubAPIClient {\n5|    private let transport: any GitHubHTTPTransport\n6|\n7|    public init(transport: any GitHubHTTPTransport) {\n8|        self.transport = transport\n9|    }\n10|\n11|    private func get(config: GitHubAuth.AppConfig, path: String, token: String) async throws -> GitHubHTTPResponse {\n12|        let header: String\n13|        do {\n14|            header = try GitHubAuth.PATGuard.authorizationHeader(token: token)\n15|        } catch {\n16|            throw GitHubAuth.AuthError.patNotSupported\n17|        }\n18|        let url = config.apiBaseURL.appendingPathComponent(path)\n19|        let request = GitHubHTTPRequest(\n20|            method: \"GET\",\n21|            url: url,\n22|            headers: [\"Accept\": \"application/vnd.github+json\", \"Authorization\": header]\n23|        )\n24|        let response: GitHubHTTPResponse\n25|        do {\n26|            response = try await transport.send(request)\n27|        } catch {\n28|            throw GitHubAuth.AuthError.network(GitHubTransportError.offline.localizedDescription)\n29|        }\n30|        if response.status == 200 { return response }\n31|        if let mapped = GitHubAuth.RESTMapper.map(status: response.status, body: response.body) {\n32|            throw mapped\n33|        }\n34|        throw GitHubAuth.AuthError.network(\"GitHub request failed (HTTP \\(response.status)).\")\n35|    }\n36|\n37|    public func fetchUser(config: GitHubAuth.AppConfig, token: String) async throws -> GitHubAuth.UserResponse {\n38|        let response = try await get(config: config, path: \"user\", token: token)\n39|        do {\n40|            return try JSONDecoder().decode(GitHubAuth.UserResponse.self, from: response.body)\n41|        } catch {\n42|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n43|        }\n44|    }\n45|\n46|    public func fetchInstallations(config: GitHubAuth.AppConfig, token: String) async throws -> [GitHubAuth.Installation] {\n47|        let response = try await get(config: config, path: \"user/installations\", token: token)\n48|        do {\n49|            let decoded = try JSONDecoder().decode(GitHubAuth.InstallationsResponse.self, from: response.body)\n50|            return decoded.installations.map { GitHubAuth.Installation(id: $0.id, account: $0.account.login, accountType: $0.account.type) }\n51|        } catch let error as GitHubAuth.AuthError {\n52|            throw error\n53|        } catch {\n54|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n55|        }\n56|    }\n57|\n58|    public func fetchRepositories(config: GitHubAuth.AppConfig, token: String, installationID: Int64) async throws -> [GitHubAuth.Repository] {\n59|        let response = try await get(config: config, path: \"user/installations/\\(installationID)/repositories\", token: token)\n60|        do {\n61|            let decoded = try JSONDecoder().decode(GitHubAuth.RepositoriesResponse.self, from: response.body)\n62|            return decoded.repositories.map { GitHubAuth.Repository(id: $0.id, fullName: $0.full_name, isPrivate: $0.private) }\n63|        } catch let error as GitHubAuth.AuthError {\n64|            throw error\n65|        } catch {\n66|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n67|        }\n68|    }\n69|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
