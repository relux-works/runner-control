{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c60f","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":354,"recorded_at":1780531400000703,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"task_stream":{"kind":"task","id":"01a0a85b-0c99-72d2-aaaa-89cd45ff73bc"},"task_id":"01a0a85b-0c99-72d2-aaaa-89cd45ff73bc","event":{"kind":"output","task_id":"01a0a85b-0c99-72d2-aaaa-89cd45ff73bc","chunk":"Read text file `Packages/RunnerControlCore/Sources/Runners+State+Reducer.swift`.\n1|import Relux\n2|extension Runners.State {\n3|    public func reduce(with action: any Relux.Action) async {\n4|        guard let action = action as? Runners.Action else { return }\n5|        switch action {\n6|        case .refreshed(let snapshots): runners = snapshots\n7|        case .changing(let id, let value):\n8|            if value { changing.insert(id) } else { changing.remove(id) }\n9|        case .failed(let message): lastError = message\n10|        case .clearError: lastError = nil\n11|        }\n12|    }\n13|}","final_result":true}}}
