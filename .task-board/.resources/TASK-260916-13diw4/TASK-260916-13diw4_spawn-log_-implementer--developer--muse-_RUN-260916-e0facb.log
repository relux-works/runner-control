{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c70f","stream":{"kind":"session","id":"01a0a85a-8231-76e1-8427-bd6f7a784205"},"sequence":482,"recorded_at":1780531400000959,"record_type":"event","durability":"durable","causation_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4d662671-1b40-4c4a-ba35-517ccb03377e","run_stream":{"kind":"run","id":"4d662671-1b40-4c4a-ba35-517ccb03377e"},"task_stream":{"kind":"task","id":"01a0a85b-328b-7662-b477-df241b118a60"},"task_id":"01a0a85b-328b-7662-b477-df241b118a60","event":{"kind":"output","task_id":"01a0a85b-328b-7662-b477-df241b118a60","chunk":"Read text file `Packages/RunnerControlCore/Sources/GitHubRedaction.swift`.\n1|import Foundation\n2|\n3|extension GitHubAuth {\n4|    /// Redacts secret values from diagnostics. Never logs raw tokens.\n5|    /// Bound: no production caller in this slice. The diagnostics export\n6|    /// (log tail, _diag archive) lands with catalog/lifecycle; until then\n7|    /// RuntimeLogger emits action types only, so there is nothing to scrub.\n8|    public enum Redaction {\n9|        public static func sanitize(_ text: String, secrets: [String]) -> String {\n10|            var result = text\n11|            for secret in secrets where !secret.isEmpty {\n12|                result = result.replacingOccurrences(of: secret, with: \"[REDACTED]\")\n13|            }\n14|            // Scrub common token JSON shapes even when the exact value is unknown.\n15|            for key in [\"access_token\", \"refresh_token\", \"device_code\"] {\n16|                result = scrubJSONValue(for: key, in: result)\n17|            }\n18|            return result\n19|        }\n20|\n21|        private static func scrubJSONValue(for key: String, in text: String) -> String {\n22|            // \"key\":\"value\" and \"key\": \"value\" shapes.\n23|            var result = text\n24|            for pattern in [\"\\\"\\(key)\\\":\\\"\", \"\\\"\\(key)\\\": \\\"\"] {\n25|                var searchFrom = result.startIndex\n26|                while let keyRange = result.range(of: pattern, range: searchFrom..<result.endIndex) {\n27|                    let valueStart = keyRange.upperBound\n28|                    guard let valueEnd = result[valueStart...].firstIndex(of: \"\\\"\") else { break }\n29|                    result.replaceSubrange(valueStart..<valueEnd, with: \"[REDACTED]\")\n30|                    searchFrom = result.index(valueEnd, offsetBy: 0, limitedBy: result.endIndex) ?? result.endIndex\n31|                    if searchFrom >= result.endIndex { break }\n32|                }\n33|            }\n34|            return result\n35|        }\n36|    }\n37|}","final_result":true}}}
