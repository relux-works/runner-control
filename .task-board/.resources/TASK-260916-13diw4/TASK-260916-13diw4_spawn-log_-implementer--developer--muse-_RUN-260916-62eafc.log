{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f1","stream":{"kind":"session","id":"01a0a90a-330a-7132-bdeb-2012149a0d8b"},"sequence":339,"recorded_at":1780531400000673,"record_type":"event","durability":"durable","causation_id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc","run_stream":{"kind":"run","id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc"},"task_stream":{"kind":"task","id":"01a0a90b-dd64-7cc2-820a-b862163ea440"},"task_id":"01a0a90b-dd64-7cc2-820a-b862163ea440","event":{"kind":"output","task_id":"01a0a90b-dd64-7cc2-820a-b862163ea440","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(1979 line(s) above)\n1980|\n1981|// MARK: - R3 regressions (adopted reviewer attacks, verbatim production entry)\n1982|\n1983|private actor ReviewDownloadLatch {\n1984|    var started = false\n1985|    var waiter: CheckedContinuation<Void, Never>?\n1986|    var releaseWaiter: CheckedContinuation<Void, Never>?\n1987|    func download(_ bytes: Data) async -> Data {\n1988|        started = true\n1989|        waiter?.resume(); waiter = nil\n1990|        await withCheckedContinuation { releaseWaiter = $0 }\n1991|        return bytes\n1992|    }\n1993|    func waitStarted() async {\n1994|        if started { return }\n1995|        await withCheckedContinuation { waiter = $0 }\n1996|    }\n1997|    func release() { releaseWaiter?.resume(); releaseWaiter = nil }\n1998|}\n1999|\n2000|@Test @MainActor func reviewerInFlightInstallCannotRepopulateChangedDraft() async throws {\n2001|    let package = try await FixturePackage.make()\n2002|    let latch = ReviewDownloadLatch()\n2003|    let transport = TestTransport([downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))])\n2004|    let harness = await registrationHarness(transport: transport, downloader: { _ in await latch.download(