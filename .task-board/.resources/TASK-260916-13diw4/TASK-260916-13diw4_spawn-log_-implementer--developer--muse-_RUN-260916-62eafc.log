2030-01-01T00:00:00Z\"], status: 201),\n2855|        runnersListPayload([]),\n2856|        jsonResponse([\"token\": \"REG-NEW\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2857|        runnersListPayload([[\"id\": 4242, \"name\": \"renamed-runner\", \"labels\": []]])\n2858|    ])\n2859|    let h = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor)\n2860|    defer { try? FileManager.default.removeItem(at: h.home) }\n2861|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2862|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2863|    let old = Task { await h.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2864|    await executor.waitStarted()\n2865|    var edited = orgDraft()\n2866|    edited.runnerName = \"renamed-runner\"\n2867|    edited.installDirName = \"alias-install\"\n2868|    try FileManager.default.createSymbolicLink(\n2869|        at: h.installRoot.appendingPathComponent(\"alias-install\"),\n2870|        withDestinationURL: h.installRoot.appendingPathComponent(\"macbook-test\"))\n2871|    _ = await h.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2872|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2873|    _ = await h.flow.apply(RunnerRegistration.Effect.registerRunner)\n2874|    let callsWhileOldRuns = await executor.configCalls.count\n2875|    await executor.release()\n2876|    _ = await old.value\n2877|    #expect(callsWhileOldRuns == 1, \"An identity edit must not allow a second config.sh while the first still owns this directory\")\n2878|    let state = RunnerRegistration.State()\n2879|    for action in registrationActions(h.logger) { await state.reduce(with: action) }\n2880|    let directory = await h.installer.directory(for: edited.installDirName)\n2881|    let local = await h.installer.readLocalRegistration(directory: directory)\n2882|    #expect(!state.completedSteps.contains(\"registerRunner\") || local?.agentName == edited.runnerName,\n2883|            \"New registration is attested complete but old in-flight config overwrites .runner afterwards\")\n2884|}\n2885|\n2886|@Test func leaseKeyCanonicalizesSymlinkAncestorsForMissingLeaf() throws {\n2887|    // R6 ancestor control: nearest-existing-ancestor resolution maps one\n2888|    // physical directory to one lease key before the leaf exists, while\n2889|    // different physical directories keep different keys.\n2890|    let files = FileManager.default\n2891|    let root = files.temporaryDirectory.appendingPathComponent(\"LeaseAncestor-\" + UUID().uuidString)\n2892|    let real = root.appendingPathComponent(\"real\")\n2893|    try files.createDirectory(at: real, withIntermediateDirectories: true)\n2894|    defer { try? files.removeItem(at: root) }\n2895|    try files.createSymbolicLink(at: root.appendingPathComponent(\"link\"), withDestinationURL: real)\n2896|    let viaReal = RunnerInstallerService.leaseKey(\n2897|        for: real.appendingPathComponent(\"missing-leaf\"))\n2898|    let viaLink = RunnerInstallerService.leaseKey(\n2899|        for: root.appendingPathComponent(\"link\").appendingPathComponent(\"missing-leaf\"))\n2900|    #expect(viaReal == viaLink, \"One physical dir must map to one lease key through a symlink ancestor\")\n2901|    let other = RunnerInstallerService.leaseKey(for: root.appendingPathComponent(\"other-dir\"))\n2902|    #expect(other != viaReal, \"Different physical dirs must keep different leases\")\n2903|}\n2904|\n2905|private actor DownloadCounter {\n2906|    private let bytes: Data\n2907|    private(set) var calls = 0\n2908|    init(bytes: Data) { self.bytes = bytes }\n2909|    func download(_ url: URL) async throws -> Data {\n2910|        calls += 1\n2911|        return bytes\n2912|    }\n2913|}\n2914|\n2915|@Test @MainActor func finderAliasInstallFolderIsRefusedBeforeDownload() async throws {\n2916|    // R6 alias control: a Finder-alias install folder is refused before any\n2917|    // download side effect, through the production Flow entry point.\n2918|    let package = try await FixturePackage.make()\n2919|    let counter = DownloadCounter(bytes: package.bytes)\n2920|    let transport = TestTransport([\n2921|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2922|    ])\n2923|    let h = await registrationHarness(\n2924|        transport: transport, downloader: { url in try await counter.download(url) }\n2925|    )\n2926|    defer { try? FileManager.default.removeItem(at: h.home) }\n2927|    let target = h.home.appendingPathComponent(\"real-target\")\n2928|    try FileManager.default.createDirectory(at: target, withIntermediateDirectories: true)\n2929|    let aliasURL = h.installRoot.appendingPathComponent(\"alias-dir\")\n2930|    let bookmark = try target.bookmarkData(options: .suitableForBookmarkFile)\n2931|    try URL.writeBookmarkData(bookmark, to: aliasURL)\n2932|    var draft = orgDraft()\n2933|    draft.installDirName = \"alias-dir\"\n2934|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n2935|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2936|    #expect(await counter.calls == 0, \"Alias path must be refused before any download side effect\")\n2937|    let failure = lastFailure(h.logger)\n2938|    #expect(failure?.step == \"downloadAndInstall\")\n2939|    #expect(failure?.message.contains(\"alias\") ?? false)\n2940|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
