edFileURL.path\\n---\\n>         let standardized = URL(fileURLWithPath: directory.path).standardizedFileURL\\n>         let files = FileManager.default\\n>         var base = standardized\\n>         var suffix: [String] = []\\n>         while true {\\n>             if files.fileExists(atPath: base.path) || Self.isSymlink(atPath: base.path) {\\n>                 break\\n>             }\\n>             let parent = base.deletingLastPathComponent()\\n>             if parent.path == base.path { break }\\n>             suffix.insert(base.lastPathComponent, at: 0)\\n>             base = parent\\n>         }\\n>         let resolvedBase = base.resolvingSymlinksInPath().path\\n>         if suffix.isEmpty {\\n>             return URL(fileURLWithPath: resolvedBase).standardizedFileURL.path\\n>         }\\n>         var url = URL(fileURLWithPath: resolvedBase, isDirectory: true)\\n>         for component in suffix { url.appendPathComponent(component) }\\n>         return url.standardizedFileURL.path\\n68a92,115\\n>     private nonisolated static func isSymlink(atPath path: String) -> Bool {\\n>         (try? FileManager.default.destinationOfSymbolicLink(atPath: path)) != nil\\n>     }\\n> \\n>     /// Refuses Finder-alias installation paths before any side effect. A\\n>     /// Finder alias is not a transparent directory like a symlink: operating\\n>     /// through its spelling would not operate on the target, so alias\\n>     /// spellings are rejected instead of being canonicalized. Symlinks are\\n>     /// resolved by `leaseKey`, not refused here.\\n>     nonisolated static func ensureNoAlias(at directory: URL) throws {\\n>         var current = URL(fileURLWithPath: directory.path).standardizedFileURL\\n>         while true {\\n>             if FileManager.default.fileExists(atPath: current.path),\\n>                (try? current.resourceValues(forKeys: [.isAliasFileKey]))?.isAliasFile == true {\\n>                 throw RunnerRegistration.RegistrationError.invalidDraft(\\n>                     \\\"Installation path '\\\\(directory.path)' resolves through a Finder alias at '\\\\(current.path)'. Choose a direct folder path instead of an alias.\\\"\\n>                 )\\n>             }\\n>             let parent = current.deletingLastPathComponent()\\n>             if parent.path == current.path { break }\\n>             current = parent\\n>         }\\n>     }\\n> \\n72,74c119,123\\n<     /// live operation already owns the directory; different directories never\\n<     /// conflict.\\n<     private func acquireLease(for directory: URL) throws {\\n---\\n>     /// live operation already owns the directory; different physical\\n>     /// directories never conflict. Returns the originally acquired canonical\\n>     /// key; the caller must hold it across awaits and release that exact key.\\n>     private func acquireLease(for directory: URL) throws -> String {\\n>         try Self.ensureNoAlias(at: directory)\\n79a129\\n>         return key\\n82,83c132,133\\n<     private func releaseLease(for directory: URL) {\\n<         activeDirectories.remove(Self.leaseKey(for: directory))\\n---\\n>     private func releaseLease(_ key: String) {\\n>         activeDirectories.remove(key)\\n89c139\\n<     /// by others.\\n---\\n>     /// by others. Uses the same canonical identity as acquisition.\\n90a141\\n>         try Self.ensureNoAlias(at: directory)\\n170,172c221,224\\n<         // second download/extract over the same directory.\\n<         try acquireLease(for: directory)\\n<         defer { releaseLease(for: directory) }\\n---\\n>         // second download/extract over the same directory. The originally\\n>         // acquired canonical key is held across awaits and released exactly.\\n>         let lease = try acquireLease(for: directory)\\n>         defer { releaseLease(lease) }\\n290,292c342,345\\n<         // releases it.\\n<         try acquireLease(for: directory)\\n<         defer { releaseLease(for: directory) }\\n---\\n>         // releases it. The originally acquired canonical key is held across\\n>         // awaits and released exactly.\\n>         let lease = try acquireLease(for: directory)\\n>         defer { releaseLease(lease) }\\n482c535\\n< }\\n\\\\ No newline at end of file\\n---\\n> }\\n\",\n  \"original_output_bytes\": 4860,\n  \"original_output_tokens\": 1215,\n  \"truncated\": false\n}","final_result":true}}}
