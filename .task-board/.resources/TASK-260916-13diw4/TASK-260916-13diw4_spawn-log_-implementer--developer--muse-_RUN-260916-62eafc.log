{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5c7","stream":{"kind":"session","id":"01a0a90a-330a-7132-bdeb-2012149a0d8b"},"sequence":318,"recorded_at":1780531400000631,"record_type":"event","durability":"durable","causation_id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc","run_stream":{"kind":"run","id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc"},"task_stream":{"kind":"task","id":"01a0a90b-d2a3-76f3-91b4-0a4bf14f6d6f"},"task_id":"01a0a90b-d2a3-76f3-91b4-0a4bf14f6d6f","event":{"kind":"output","task_id":"01a0a90b-d2a3-76f3-91b4-0a4bf14f6d6f","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n1|import CryptoKit\n2|import Foundation\n3|import Testing\n4|import Relux\n5|@testable import RunnerControlCore\n6|\n7|// MARK: - Registration harness (production entry points, controlled IO)\n8|\n9|// TestTransport, jsonResponse, and testConfig are shared from GitHubTransportTests.\n10|\n11|private struct RegistrationHarness {\n12|    let flow: RunnerRegistration.Flow\n13|    let logger: Relux.Testing.Logger\n14|    let transport: TestTransport\n15|    let userStore: GitHubKeychainStore\n16|    let identities: InMemoryGitHubSessionIdentityStore\n17|    let registrationTokens: RunnerRegistrationTokenStore\n18|    let installer: RunnerInstallerService\n19|    let home: URL\n20|    let installRoot: URL\n21|}\n22|\n23|private func registrationHarness(\n24|    transport: TestTransport,\n25|    downloader: (@Sendable (URL) async throws -> Data)? = nil,\n26|    executor: (any CommandExecuting)? = nil,\n27|    arch: String = \"arm64\",\n28|    seedAuth: Bool = true\n29|) async -> RegistrationHarness {\n30|    let logger = Relux.Testing.Logger()\n31|    let dispatcher = Relux.Dispatcher(logger: logger)\n32|    let userStore = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n33|    let identities = InMemoryGitHubSessionIdentityStore()\n34|    if seedAuth {\n35|        await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n36|        try? await userStore.save(\n37|            GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n38|            serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n39|        )\n40|    }\n41|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"RegHome-\" + UUID().uuidString)\n42|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n43|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n44|    let archCopy = arch\n45|    let installer = RunnerInstallerService(\n46|        installRoot: installRoot,\n47|        downloader: downloader,\n48|        executor: executor,\n49|        currentArch: { archCopy }\n50|    )\n51|    let api = GitHubRunnerAPIClient(transport: transport)\n52|    let registrationTokens = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n53|    let refresher = GitHubTokenRefresh(transport: transport, store: userStore)\n54|    let flow = await RunnerRegistration.Flow(\n55|        api: api, installer: installer, registrationTokens: registrationTokens,\n56|        userStore: userStore, identityStore: identities, refresher: refresher,\n57|        configProvider: { _ in testConfig }, dispatcher: dispatcher\n58|    )\n59|    return RegistrationHarness(\n60|        flow: flow, logger: logger, transport: transport, userStore: userStore,\n61|        identities: identities, registrationTokens: registrationTokens,\n62|        installer: installer, home: home, installRoot: installRoot\n63|    )\n64|}\n65|\n66|private func registrationActions(_ logger: Relux.Testing.Logger) -> [RunnerRegistration.Action] {\n67|    logger.actions.compactMap { $0 as? RunnerRegistration.Action }\n68|}\n69|\n70|private func lastFailure(_ logger: Relux.Testing.Logger) -> (message: String, step: String)? {\n71|    for action in registrationActions(logger).reversed() {\n72|        switch action {\n73|        case .failed(let message, let step): return (message, step)\n74|        case .permissionDenied(let message, let step): return (message, step)\n75|        default: break\n76|        }\n77|    }\n78|    return nil\n79|}\n80|\n81|private func orgDraft(\n82|    name: String = \"macbook-test\",\n83|    dir: String = \"macbook-test\",\n84|    group: String = \"RunnerControl-Mac\",\n85|    repos: Set<Int64> = [9],\n86|    allowGroup: Bool = true,\n87|    allowTakeover: Bool = false,\n88|    allowReplace: Bool = false\n89|) -> RunnerRegistration.Draft {\n90|    RunnerRegistration.Draft(\n91|        scope: .organization(org: \"acme\"),\n92|        runnerName: name,\n93|        labels: [\"self-hosted\", \"macOS\"],\n94|        installDirName: dir,\n95|        workFolder: \"_work\",\n96|        groupName: group,\n97|        selectedRepositoryIDs: repos,\n98|        allowGroupMutation: allowGroup,\n99|        allowGroupTakeover: allowTakeover,\n100|        allowReplace: allowReplace\n101|    )\n102|}\n103|\n104|private func repoDraft(dir: String = \"personal-app\", allowReplace: Bool = false) -> RunnerRegistration.Draft {\n105|    RunnerRegistration.Draft(\n106|        scope: .repository(owner: \"octo\", name: \"app\"),\n107|        runnerName: \"personal-runner\",\n108|        labels: [\"self-hosted\", \"macOS\"],\n109|        installDirName: dir,\n110|        workFolder: \"_work\",\n111|        allowGroupMutation: false,\n112|        allowGroupTakeover: false,\n113|        allowReplace: allowReplace\n114|    )\n115|}\n116|\n117|/// The downloads endpoint returns a bare JSON array, not an object.\n118|private func downloadsArrayPayload(_ assets: [[String: Any]]) -> GitHubHTTPResponse {\n119|    // swiftlint:disable:next force_try\n120|    let data = try! JSONSerialization.data(withJSONObject: assets)\n121|    return GitHubHTTPResponse(status: 200, body: data)\n122|}\n123|\n124|/// Typed group fixture: heterogeneous literals (Int/String/Bool) need an\n125|/// explicit `[String: Any]` context to compile.\n126|private func groupPayload(id: Int64, name: String, visibility: String, allowsPublic: Bool) -> [String: Any] {\n127|    [\"id\": id, \"name\": name, \"visibility\": visibility, \"allows_public_repositories\": allowsPublic]\n128|}\n129|\n130|private func groupsListPayload(_ groups: [[String: Any]]) -> GitHubHTTPResponse {\n131|    jsonResponse([\"runner_groups\": groups])\n132|}\n133|\n134|// MARK: - Fixture package (real tarball, controlled filesystem)\n135|\n136|/// Builds a minimal official-shaped runner package and packs it with the\n137|/// real system tar. Scripts keep their executable bit inside the archive.\n138|private struct FixturePackage {\n139|    let bytes: Data\n140|    let sha256ViaSystem: String\n141|\n142|    static func make(withRealConfigScript: Bool = true) async throws -> FixturePackage {\n143|        let files = FileManager.default\n144|        let src = files.temporaryDirectory.appendingPathComponent(\"FixtureSrc-\" + UUID().uuidString)\n145|        let bin = src.appendingPathComponent(\"bin\")\n146|        try files.createDirectory(at: bin, withIntermediateDirectories: true)\n147|        try \"#!/bin/sh\\nexec \\\"$(dirname \\\"$0\\\")/../run.sh\\\" \\\"$@\\\"\\n\".write(to: bin.appendingPathComponent(\"runsvc.sh\"), atomically: true, encoding: .utf8)\n148|        try \"#!/bin/sh\\necho runner\\n\".write(to: src.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n149|        if withRealConfigScript {\n150|            let script = \"\"\"\n151|            #!/bin/sh\n152|            DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n153|            NAME=\"\"\n154|            while [ $# -gt 0 ]; do\n155|              case \"$1\" in\n156|                --name) NAME=\"$2\"; shift 2;;\n157|                *) shift;;\n158|              esac\n159|            done\n160|            printf '{\"agentId\":4242,\"agentName\":\"%s\",\"gitHubUrl\":\"https://github.com/acme\",\"workFolder\":\"_work\"}' \"$NAME\" > \"$DIR/.runner\"\n161|            \"\"\"\n162|            try script.write(to: src.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n163|        } else {\n164|            try \"#!/bin/sh\\nexit 0\\n\".write(to: src.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n165|        }\n166|        for path in [\"bin/runsvc.sh\", \"run.sh\", \"config.sh\"] {\n167|            try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: src.appendingPathComponent(path).path)\n168|        }\n169|        let archive = files.temporaryDirectory.appendingPathComponent(\"fixture-\" + UUID().uuidString + \".tar.gz\")\n170|        defer { try? files.removeItem(at: src) }\n171|        defer { try? files.removeItem(at: archive) }\n172|        let executor = CommandExecutor()\n173|        let packed = try await executor.run(\"/usr/bin/tar\", [\"-czf\", archive.path, \"-C\", src.path, \".\"])\n174|        guard packed.code == 0 else { throw RunnerError.message(\"fixture tar failed: \\(packed.output)\") }\n175|        let bytes = try Data(contentsOf: archive)\n176|        // Independent oracle: system shasum pins the production CryptoKit hasher.\n177|        let hashed = try await executor.run(\"/usr/bin/shasum\", [\"-a\", \"256\", archive.path])\n178|        guard hashed.code == 0 else { throw RunnerError.message(\"shasum missing: \\(hashed.output)\") }\n179|        let digest = hashed.output.split(separator: \" \").first.map(String.init) ?? \"\"\n180|        guard digest.count == 64 else { throw RunnerError.message(\"bad shasum output: \\(hashed.output)\") }\n181|        return FixturePackage(bytes: bytes, sha256ViaSystem: digest)\n182|    }\n183|}\n184|\n185|private func fixtureDownloader(_ bytes: Data) -> @Sendable (URL) async throws -> Data {\n186|    let copy = bytes\n187|    return { _ in copy }\n188|}\n189|\n190|/// Records config.sh argv and simulates a successful registration by writing\n191|/// `.runner`. Delegates every other command (tar) to the real executor.\n192|private actor SplitExecutor: CommandExecuting {\n193|    private(set) var configCalls: [[String]] = []\n194|    var failure: CommandResult?\n195|    private let real = CommandExecutor()\n196|    private let gitHubURL: String\n197|\n198|    init(gitHubURL: String = \"https://github.com/acme\") {\n199|        self.gitHubURL = gitHubURL\n200|    }\n201|\n202|    func run(_ executable: String, _ arguments: [String]) async throws -> CommandResult {\n203|        if executable.hasSuffix(\"config.sh\") {\n204|            configCalls.append(arguments)\n205|            if let failure { return failure }\n206|            let dir = URL(fileURLWithPath: executable).deletingLastPathComponent()\n207|            var name = \"unnamed\"\n208|            var work = \"_work\"\n209|            var index = arguments.startIndex\n210|            while index < arguments.endIndex {\n211|                if arguments[index] == \"--name\", arguments.index(after: index) < arguments.endIndex {\n212|                    name = arguments[arguments.index(after: index)]\n213|                }\n214|                if arguments[index] == \"--work\", arguments.index(after: index) < arguments.endIndex {\n215|                    work = arguments[arguments.index(after: index)]\n216|                }\n217|                index = arguments.index(after: index)\n218|            }\n219|            let payload = [\"agentId\": 4242, \"agentName\": name, \"gitHubUrl\": gitHubURL, \"workFolder\": work] as [String: Any]\n220|            let data = try JSONSerialization.data(withJSONObject: payload)\n221|            try data.write(to: dir.appendingPathComponent(\".runner\"), options: .atomic)\n222|            return CommandResult(code: 0, output: \"Configured\")\n223|        }\n224|        return try await real.run(executable, arguments)\n225|    }\n226|}\n227|\n228|// MARK: - Reducer and pure gates\n229|\n230|@Test @MainActor func registrationReducerRetainsPermissionErrorAcrossDraftEdits() async {\n231|    let state = RunnerRegistration.State()\n232|    await state.reduce(with: ForeignAction())\n233|    #expect(state.phase == .idle)\n234|    let draft = orgDraft()\n235|    await state.reduce(with: RunnerRegistration.Action.draftBegan(draft))\n236|    #expect(state.phase == .drafting)\n237|    await state.reduce(with: RunnerRegistration.Action.permissionDenied(message: \"Missing permission: X\", step: \"resolveGroup\"))\n238|    #expect(state.permissionError == \"Missing permission: X\")\n239|    // Draft edits must retain the permission error by design.\n240|    var edited = draft\n241|    edited.runnerName = \"renamed\"\n242|    await state.reduce(with: RunnerRegistration.Action.draftUpdated(edited))\n243|    #expect(state.permissionError == \"Missing permission: X\")\n244|    #expect(state.draft?.runnerName == \"renamed\")\n245|    await state.reduce(with: RunnerRegistration.Action.permissionDismissed)\n246|    #expect(state.permissionError == nil)\n247|    await state.reduce(with: RunnerRegistration.Action.registered(runnerID: 11, localAgentID: 4242))\n248|    #expect(state.runnerID == 11)\n249|    await state.cleanup()\n250|    #expect(state.phase == .idle)\n251|    #expect(state.draft == nil)\n252|}\n253|\n254|@Test func configInvocationIsExactAndOrdered() {\n255|    let orgSpec = RunnerRegistration.ConfigSpec(\n256|        scopeURL: \"https://github.com/acme\", token: \"TOKEN\",\n257|        name: \"mac1\", workFolder: \"_work\",\n258|        labels: [\"self-hosted\", \"macOS\"], runnerGroup: \"RunnerControl-Mac\",\n259|        replace: true\n260|    )\n(more lines below)","final_result":true}}}
