{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cddd","stream":{"kind":"session","id":"01a0a90a-330a-7132-bdeb-2012149a0d8b"},"sequence":1353,"recorded_at":1780531400002701,"record_type":"event","durability":"durable","causation_id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc","run_stream":{"kind":"run","id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc"},"task_stream":{"kind":"task","id":"01a0a919-8113-73b1-83de-cbc3c6ef4b77"},"task_id":"01a0a919-8113-73b1-83de-cbc3c6ef4b77","event":{"kind":"output","task_id":"01a0a919-8113-73b1-83de-cbc3c6ef4b77","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(2845 line(s) above)\n2846|// MARK: - R6: canonical directory lease (repeat-of R4-F1 / R5-F1)\n2847|\n2848|/// Bounded latch wait: polls the config latch's started flag so a config.sh\n2849|/// that never starts (for example a gate error thrown before the latch)\n2850|/// becomes a reported failure carrying the Flow diagnostics instead of an\n2851|/// infinite hang. The timeout is generous — latches normally fire in well\n2852|/// under a second — and the regression assertions below are unchanged.\n2853|private func waitForConfigStart(_ executor: ConfigLatchExecutor, timeoutSeconds: Double) async -> Bool {\n2854|    let deadline = Date().addingTimeInterval(timeoutSeconds)\n2855|    while true {\n2856|        if await executor.started { return true }\n2857|        if Date() >= deadline { return false }\n2858|        try? await Task.sleep(nanoseconds: 50_000_000)\n2859|    }\n2860|}\n2861|\n2862|@Test @MainActor func reviewerSymlinkAliasCannotBypassDirectoryLease() async throws {\n2863|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2864|    let executor = ConfigLatchExecutor()\n2865|    let transport = TestTransport([\n2866|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2867|        runnersListPayload([]),\n2868|        jsonResponse([\"token\": \"REG-OLD\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2869|        runnersListPayload([]),\n2870|        jsonResponse([\"token\": \"REG-NEW\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2871|        runnersListPayload([[\"id\": 4242, \"name\": \"renamed-runner\", \"labels\": []]])\n2872|    ])\n2873|    let h = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor)\n2874|    defer { try? FileManager.default.removeItem(at: h.home) }\n2875|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2876|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2877|    // Gate errors before the latch must fail fast with diagnostics, never\n2878|    // hang in the wait below: without an install the register step cannot\n2879|    // reach config.sh.\n2880|    if let setupFailure = lastFailure(h.logger) {\n2881|        #expect(\n2882|            Bool(false),\n2883|            \"Setup failed before the config latch: [\\(setupFailure.step)] \\(setupFailure.message)\"\n2884|        )\n2885|        return\n2886|    }\n2887|    let old = Task { await h.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2888|    guard await waitForConfigStart(executor, timeoutSeconds: 30) else {\n2889|        let detail = lastFailure(h.logger).map { \"[\\($0.step)] \\($0.message)\" } ?? \"no Flow failure recorded\"\n2890|        #expect(Bool(false), \"config.sh never started within 30s; Flow failure: \\(detail)\")\n2891|        await executor.release()\n2892|        _ = await old.value\n2893|        return\n2894|    }\n2895|    var edited = orgDraft()\n2896|    edited.runnerName = \"renamed-runner\"\n2897|    edited.installDirName = \"alias-install\"\n2898|    try FileManager.default.createSymbolicLink(\n2899|        at: h.installRoot.appendingPathComponent(\"alias-install\"),\n2900|        withDestinationURL: h.installRoot.appendingPathComponent(\"macbook-test\"))\n2901|    _ = await h.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2902|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2903|    _ = await h.flow.apply(RunnerRegistration.Effect.registerRunner)\n2904|    let callsWhileOldRuns = await executor.configCalls.count\n2905|    await executor.release()\n2906|    _ = await old.value\n2907|    #expect(callsWhileOldRuns == 1, \"An identity edit must not allow a second config.sh while the first still owns this directory\")\n2908|    let state = RunnerRegistration.State()\n2909|    for action in registrationActions(h.logger) { await state.reduce(with: action) }\n2910|    let directory = await h.installer.directory(for: edited.installDirName)\n(more lines below)","final_result":true}}}
