{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4fb","stream":{"kind":"session","id":"01a0a90a-330a-7132-bdeb-2012149a0d8b"},"sequence":216,"recorded_at":1780531400000427,"record_type":"event","durability":"durable","causation_id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc","run_stream":{"kind":"run","id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc"},"task_stream":{"kind":"task","id":"01a0a90b-7325-7140-9888-25bed5ba0f0a"},"task_id":"01a0a90b-7325-7140-9888-25bed5ba0f0a","event":{"kind":"output","task_id":"01a0a90b-7325-7140-9888-25bed5ba0f0a","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n1|import CryptoKit\n2|import Foundation\n3|\n4|/// Filesystem installer for downloaded GitHub Actions runners.\n5|///\n6|/// Production path: download bytes → SHA-256 verify → tar extract →\n7|/// `bin/runsvc.sh` copied into the root and chmodded (as official `svc.sh`\n8|/// would) → exact `config.sh` invocation → manual LaunchAgent plist.\n9|/// All side effects stay below `installRoot`; tests inject a temporary root,\n10|/// a fake downloader, and fixtures instead of touching production runners.\n11|public actor RunnerInstallerService {\n12|    public static let markerFileName = \".runnercontrol-install.json\"\n13|    public static let installOS = \"osx\"\n14|\n15|    private let installRoot: URL\n16|    private let downloader: @Sendable (URL) async throws -> Data\n17|    private let executor: any CommandExecuting\n18|    private let currentArch: @Sendable () -> String\n19|    private let hasher: @Sendable (Data) -> String\n20|\n21|    public init(\n22|        installRoot: URL? = nil,\n23|        downloader: (@Sendable (URL) async throws -> Data)? = nil,\n24|        executor: (any CommandExecuting)? = nil,\n25|        currentArch: (@Sendable () -> String)? = nil,\n26|        hasher: (@Sendable (Data) -> String)? = nil\n27|    ) {\n28|        self.installRoot = installRoot\n29|            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/GitHubActions\")\n30|        self.downloader = downloader ?? { url in\n31|            let (data, _) = try await URLSession.shared.data(from: url)\n32|            return data\n33|        }\n34|        self.executor = executor ?? CommandExecutor()\n35|        self.currentArch = currentArch ?? {\n36|            #if arch(arm64)\n37|            return \"arm64\"\n38|            #else\n39|            return \"x64\"\n40|            #endif\n41|        }\n42|        self.hasher = hasher ?? { data in\n43|            SHA256.hash(data: data).map { String(format: \"%02x\", $0) }.joined()\n44|        }\n45|    }\n46|\n47|    public nonisolated var root: URL { installRoot }\n48|    public nonisolated var architecture: String { currentArch() }\n49|\n50|    /// Canonical installation directories with a live mutating side effect\n51|    /// (download/extract/config/service/recovery). Acquired synchronously\n52|    /// before the first await and released only when the owning operation\n53|    /// settles, so actor reentrancy can never admit two mutations of one\n54|    /// directory. Abandoning a UI generation does not release this resource;\n55|    /// only the settling side effect does.\n56|    private var activeDirectories: Set<String> = []\n57|\n58|    public func directory(for installDirName: String) -> URL {\n59|        installRoot.appendingPathComponent(installDirName)\n60|    }\n61|\n62|    /// Canonical lease key for a directory: physical filesystem identity, not\n63|    /// path spelling. Both Flow-derived URLs (from a stored install path)\n64|    /// and `directory(for:)` URLs map to the same key for the same on-disk\n65|    /// location, including through symlink leaves and symlink ancestors.\n66|    /// Not-yet-created leaves canonicalize via their nearest existing\n67|    /// ancestor, so `/tmp`-vs-`/private/tmp` spellings of one directory map\n68|    /// to one key before the leaf exists.\n69|    nonisolated static func leaseKey(for directory: URL) -> String {\n70|        let standardized = URL(fileURLWithPath: directory.path).standardizedFileURL\n71|        let files = FileManager.default\n72|        var base = standardized\n73|        var suffix: [String] = []\n74|        while true {\n75|            if files.fileExists(atPath: base.path) || Self.isSymlink(atPath: base.path) {\n76|                break\n77|            }\n78|            let parent = base.deletingLastPathComponent()\n79|            if parent.path == base.path { break }\n80|            suffix.insert(base.lastPathComponent, at: 0)\n81|            base = parent\n82|        }\n83|        let resolvedBase = base.resolvingSymlinksInPath().path\n84|        if suffix.isEmpty {\n85|            return URL(fileURLWithPath: resolvedBase).standardizedFileURL.path\n86|        }\n87|        var url = URL(fileURLWithPath: resolvedBase, isDirectory: true)\n88|        for component in suffix { url.appendPathComponent(component) }\n89|        return url.standardizedFileURL.path\n90|    }\n91|\n92|    private nonisolated static func isSymlink(atPath path: String) -> Bool {\n93|        (try? FileManager.default.destinationOfSymbolicLink(atPath: path)) != nil\n94|    }\n95|\n96|    /// Refuses Finder-alias installation paths before any side effect. A\n97|    /// Finder alias is not a transparent directory like a symlink: operating\n98|    /// through its spelling would not operate on the target, so alias\n99|    /// spellings are rejected instead of being canonicalized. Symlinks are\n100|    /// resolved by `leaseKey`, not refused here.\n101|    nonisolated static func ensureNoAlias(at directory: URL) throws {\n102|        var current = URL(fileURLWithPath: directory.path).standardizedFileURL\n103|        while true {\n104|            if FileManager.default.fileExists(atPath: current.path),\n105|               (try? current.resourceValues(forKeys: [.isAliasFileKey]))?.isAliasFile == true {\n106|                throw RunnerRegistration.RegistrationError.invalidDraft(\n107|                    \"Installation path '\\(directory.path)' resolves through a Finder alias at '\\(current.path)'. Choose a direct folder path instead of an alias.\"\n108|                )\n109|            }\n110|            let parent = current.deletingLastPathComponent()\n111|            if parent.path == current.path { break }\n112|            current = parent\n113|        }\n114|    }\n115|\n116|    /// Acquires exclusive ownership of `directory`. Synchronous: callers must\n117|    /// invoke it before their first await so the check-and-insert is atomic\n118|    /// under actor isolation. Throws a retryable `directoryBusy` when another\n119|    /// live operation already owns the directory; different physical\n120|    /// directories never conflict. Returns the originally acquired canonical\n121|    /// key; the caller must hold it across awaits and release that exact key.\n122|    private func acquireLease(for directory: URL) throws -> String {\n123|        try Self.ensureNoAlias(at: directory)\n124|        let key = Self.leaseKey(for: directory)\n125|        guard !activeDirectories.contains(key) else {\n126|            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n127|        }\n128|        activeDirectories.insert(key)\n129|        return key\n130|    }\n131|\n132|    private func releaseLease(_ key: String) {\n133|        activeDirectories.remove(key)\n134|    }\n135|\n136|    /// Refuses a synchronous mutation (service setup, recovery) while a live\n137|    /// async side effect owns the directory. No insert: without an await the\n138|    /// caller itself cannot interleave, it only needs to respect leases held\n139|    /// by others. Uses the same canonical identity as acquisition.\n140|    private func requireIdleDirectory(_ directory: URL) throws {\n141|        try Self.ensureNoAlias(at: directory)\n142|        guard !activeDirectories.contains(Self.leaseKey(for: directory)) else {\n143|            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n144|        }\n145|    }\n146|\n147|    // MARK: - Idempotency markers\n148|\n149|    public struct Marker: Codable, Sendable, Equatable {\n150|        public var scopeKey: String\n151|        public var completedSteps: Set<String>\n152|        /// Server the directory was configured against (`.runner` host is\n153|        /// authoritative; this records the config-time expectation so a\n154|        /// group/server change cannot reuse an old configured marker).\n155|        public var serverHost: String?\n156|        /// Dedicated group passed to `config.sh --runnergroup` (org scope).\n157|        /// `.runner` does not record it, so the marker must: a group-name\n158|        /// edit never claims the old group's configuration as its own.\n159|        public var groupName: String?\n160|        public init(\n161|            scopeKey: String, completedSteps: Set<String> = [],\n162|            serverHost: String? = nil, groupName: String? = nil\n163|        ) {\n164|            self.scopeKey = scopeKey; self.completedSteps = completedSteps\n165|            self.serverHost = serverHost; self.groupName = groupName\n166|        }\n167|    }\n168|\n169|    public static let stepDownloaded = \"downloaded\"\n170|    public static let stepInstalled = \"installed\"\n171|    public static let stepConfigured = \"configured\"\n172|    public static let stepServiceReady = \"serviceReady\"\n173|\n174|    public func loadMarker(directory: URL) -> Marker? {\n175|        let url = directory.appendingPathComponent(Self.markerFileName)\n176|        guard let data = try? Data(contentsOf: url) else { return nil }\n177|        return try? JSONDecoder().decode(Marker.self, from: data)\n178|    }\n179|\n180|    private func storeMarker(_ marker: Marker, directory: URL) throws {\n181|        let data = try JSONEncoder().encode(marker)\n182|        try data.write(to: directory.appendingPathComponent(Self.markerFileName), options: .atomic)\n183|    }\n184|\n185|    public func markCompleted(\n186|        _ step: String, directory: URL, scopeKey: String,\n187|        serverHost: String? = nil, groupName: String? = nil\n188|    ) throws {\n189|        var marker = loadMarker(directory: directory) ?? Marker(scopeKey: scopeKey)\n190|        marker.completedSteps.insert(step)\n191|        if let serverHost { marker.serverHost = serverHost }\n192|        if let groupName { marker.groupName = groupName }\n193|        try storeMarker(marker, directory: directory)\n194|    }\n195|\n196|    public func hasCompleted(_ step: String, directory: URL) -> Bool {\n197|        loadMarker(directory: directory)?.completedSteps.contains(step) == true\n198|    }\n199|\n200|    // MARK: - Install\n201|\n202|    /// Downloads, verifies, and extracts the official package. Idempotent:\n203|    /// a completed `installed` marker with matching scope and server skips\n204|    /// the work. Refuses to overwrite an already-registered directory (no\n205|    /// duplicates).\n206|    public func downloadAndInstall(\n207|        asset: RunnerRegistration.DownloadAsset,\n208|        draft: RunnerRegistration.Draft,\n209|        serverHost: String? = nil\n210|    ) async throws -> URL {\n211|        try RunnerRegistration.Gates.validateNoSpace(\n212|            installDirName: draft.installDirName, workFolder: draft.workFolder\n213|        )\n214|        let directory = self.directory(for: draft.installDirName)\n215|        if directory.path.contains(\" \") {\n216|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n217|        }\n218|        // Exclusive ownership for the whole mutation, acquired before the\n219|        // first await (reuse check included): a same-directory retry while\n220|        // this install is live is refused retryably instead of starting a\n221|        // second download/extract over the same directory. The originally\n222|        // acquired canonical key is held across awaits and released exactly.\n223|        let lease = try acquireLease(for: directory)\n224|        defer { releaseLease(lease) }\n225|        let files = FileManager.default\n226|        if let marker = loadMarker(directory: directory),\n227|           marker.completedSteps.contains(Self.stepInstalled),\n228|           marker.scopeKey == draft.scope.scopeKey,\n229|           Self.markerServerMatches(marker: marker, serverHost: serverHost),\n230|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n231|            return directory\n232|        }\n233|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n234|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: draft.runnerName)\n235|        }\n236|        let bytes: Data\n237|        do {\n238|            bytes = try await downloader(asset.downloadURL)\n239|        } catch {\n240|            throw RunnerRegistration.RegistrationError.network(\"Runner download failed: \\(error.localizedDescription)\")\n241|        }\n242|        // Fail closed: the official downloads endpoint documents\n243|        // `sha256_checksum`, and an install without a verified digest is\n244|        // refused rather than trusted on TLS alone.\n245|        guard let expected = asset.sha256Checksum, !expected.isEmpty else {\n246|            throw RunnerRegistration.RegistrationError.integrityMismatch\n247|        }\n248|        let actual = hasher(bytes)\n249|        guard actual.lowercased() == expected.lowercased() else {\n250|            throw RunnerRegistration.RegistrationError.integrityMismatch\n251|        }\n252|        try files.createDirectory(at: directory, withIntermediateDirectories: true)\n253|        let archive = files.temporaryDirectory.appendingPathComponent(UUID().uuidString + \"-\" + asset.filename)\n254|        defer { try? files.removeItem(at: archive) }\n255|        try bytes.write(to: archive, options: .atomic)\n256|        let result = try await executor.run(\"/usr/bin/tar\", [\"-xzf\", archive.path, \"-C\", directory.path])\n257|        guard result.code == 0 else {\n258|            throw RunnerRegistration.RegistrationError.network(\n259|                \"Runner archive extraction failed: \\(String(result.output.prefix(300)))\"\n260|            )\n261|        }\n262|        // Official packages keep runsvc.sh under bin/ until svc.sh installs it;\n263|        // a bare extraction leaves the root copy absent, so install it here.\n264|        try installRunsvc(directory: directory)\n265|        try markCompleted(\n266|            Self.stepDownloaded, directory: directory,\n267|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n268|        )\n269|        try markCompleted(\n270|            Self.stepInstalled, directory: directory,\n271|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n272|        )\n273|        return directory\n274|    }\n275|\n276|    /// Server binding for install reuse. A marker written without a server\n277|    /// (pre-revision-4) never satisfies a server-bound request: the next\n278|    /// install re-verifies instead of reusing unknown provenance. Direct\n279|    /// installer calls without a server (unit fixtures) keep the legacy\n280|    /// scope-only reuse.\n281|    static func markerServerMatches(marker: Marker, serverHost: String?) -> Bool {\n282|        guard let want = serverHost else { return true }\n283|        guard let have = marker.serverHost else { return false }\n284|        return RunnerRegistration.OperationIdentity.normalizeServerHost(have)\n285|            == RunnerRegistration.OperationIdentity.normalizeServerHost(want)\n286|    }\n287|\n288|    /// Copies official `bin/runsvc.sh` into the installation root and makes\n289|    /// it executable, mirroring what official `svc.sh install` would do.\n290|    public func installRunsvc(directory: URL) throws {\n291|        let files = FileManager.default\n292|        let source = directory.appendingPathComponent(\"bin/runsvc.sh\")\n293|        let target = directory.appendingPathComponent(\"runsvc.sh\")\n294|        guard files.fileExists(atPath: source.path) else {\n295|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing bin/runsvc.sh.\")\n296|        }\n297|        if files.fileExists(atPath: target.path) {\n298|            try files.removeItem(at: target)\n299|        }\n300|        try files.copyItem(at: source, to: target)\n301|        try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: target.path)\n302|    }\n303|\n304|    // MARK: - Configure\n305|\n306|    /// Runs the exact `config.sh` invocation. Skips when a previous attempt\n307|    /// already registered this directory (marker + `.runner` present), so\n308|    /// retries never create orphan or duplicate GitHub registrations.\n309|    /// Returns the local agent ID read back from `.runner`.\n310|    @discardableResult\n311|    public func runConfig(\n312|        directory: URL,\n313|        scopeURL: String,\n314|        token: String,\n315|        draft: RunnerRegistration.Draft,\n316|        runnerGroup: String?\n317|    ) async throws -> Int64? {\n318|        try await runConfig(\n319|            directory: directory, scopeURL: scopeURL, token: token,\n320|            draft: draft, runnerGroup: runnerGroup, replace: draft.allowReplace\n321|        )\n322|    }\n323|\n324|    /// Explicit-`replace` variant. Production callers pass\n325|    /// `draft.allowReplace`; tests drive both values.\n326|    @discardableResult\n327|    public func runConfig(\n328|        directory: URL,\n329|        scopeURL: String,\n330|        token: String,\n331|        draft: RunnerRegistration.Draft,\n332|        runnerGroup: String?,\n333|        replace: Bool\n334|    ) async throws -> Int64? {\n335|        let files = FileManager.default\n336|        let scopeHost = URL(string: scopeURL)?.host ?? \"\"\n337|        // Exclusive ownership for the whole config, acquired before the\n338|        // first await (resume checks included): a same-directory retry while\n339|        // this config.sh is live is refused retryably instead of invoking a\n340|        // second config.sh over the same .runner. The lease is released only\n341|        // when this operation settles; an abandoned UI generation never\n342|        // releases it. The originally acquired canonical key is held across\n343|        // awaits and released exactly.\n344|        let lease = try acquireLease(for: directory)\n345|        defer { releaseLease(lease) }\n346|        if hasCompleted(Self.stepConfigured, directory: directory),\n347|           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n348|            // Idempotent resume never returns a stale ID: the existing\n349|            // configuration must still match this draft on this server.\n350|            let local = readLocalRegistration(directory: directory)\n351|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n352|                local: local, configured: true, draft: draft, serverHost: scopeHost\n353|            )\n354|            try Self.verifyConfiguredGroup(\n355|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n356|            )\n357|            return verified\n358|        }\n359|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n360|           hasCompleted(Self.stepConfigured, directory: directory) {\n361|            let local = readLocalRegistration(directory: directory)\n362|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n363|                local: local, configured: true, draft: draft, serverHost: scopeHost\n364|            )\n365|            try Self.verifyConfiguredGroup(\n366|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n367|            )\n368|            return verified\n369|        }\n370|        let spec = RunnerRegistration.ConfigSpec(\n371|            scopeURL: scopeURL, token: token, name: draft.runnerName,\n372|            workFolder: draft.workFolder, labels: draft.labels,\n373|            runnerGroup: runnerGroup, replace: replace\n374|        )\n375|        let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n376|        let executable = directory.appendingPathComponent(\"config.sh\").path\n377|        guard files.fileExists(atPath: executable) else {\n378|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n379|        }\n380|        let result = try await executor.run(executable, args)\n381|        guard result.code == 0 else {\n382|            // Never echo the token: config output may repeat arguments.\n383|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [token])\n384|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n385|        }\n386|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n387|            throw RunnerRegistration.RegistrationError.configFailed(\n388|                \"config.sh reported success but .runner is missing.\"\n389|            )\n390|        }\n391|        try markCompleted(\n392|            Self.stepConfigured, directory: directory, scopeKey: draft.scope.scopeKey,\n393|            serverHost: scopeHost, groupName: runnerGroup\n394|        )\n395|        return readAgentID(directory: directory)\n396|    }\n397|\n398|    /// `.runner` does not record the org group, so the configured marker\n399|    /// does. A resume whose marker names another group (or predates group\n400|    /// recording) refuses instead of claiming the old group's configuration\n401|    /// as the new draft's. Repository scope never configures a group.\n402|    static func verifyConfiguredGroup(\n403|        marker: Marker?, runnerGroup: String?, draft: RunnerRegistration.Draft\n404|    ) throws {\n405|        switch draft.scope {\n406|        case .repository:\n407|            return\n408|        case .organization:\n409|            break\n410|        }\n411|        let wanted = (runnerGroup ?? draft.groupName).trimmingCharacters(in: .whitespacesAndNewlines)\n412|        guard let have = marker?.groupName?.trimmingCharacters(in: .whitespacesAndNewlines),\n413|              !have.isEmpty else {\n414|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n415|                \"Directory '\\(draft.installDirName)' was configured before group recording. Reconfigure for group '\\(wanted)' instead of reusing the old configuration.\"\n416|            )\n417|        }\n418|        guard have == wanted else {\n419|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n420|                \"Local registration was configured for group '\\(have)', not '\\(wanted)'. Reconfigure instead of reusing the old group's configuration.\"\n421|            )\n422|        }\n423|    }\n424|\n425|    // MARK: - Dedicated-group ownership\n426|\n427|    public static let ownershipFileName = \".runnercontrol-groups.json\"\n428|\n429|    private func ownershipFile() -> URL {\n430|        installRoot.appendingPathComponent(Self.ownershipFileName)\n431|    }\n432|\n433|    private static func ownershipKey(serverHost: String, org: String, name: String) -> String {\n434|        \"\\(RunnerRegistration.OperationIdentity.normalizeServerHost(serverHost))\\u{0}\\(org.lowercased())\\u{0}\\(name)\"\n435|    }\n436|\n437|    /// Returns the locally recorded dedicated-group ID for\n438|    /// `server` + `org` + `name`, or nil when this Mac never created (or\n439|    /// took over) that group on that server. Name matches on GitHub alone\n440|    /// never count as ownership, and ownership on one server never\n441|    /// authorizes adoption on another.\n442|    public func loadOwnedGroupID(serverHost: String, org: String, name: String) -> Int64? {\n443|        guard let data = try? Data(contentsOf: ownershipFile()),\n444|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n445|        return table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)]\n446|    }\n447|\n448|    public func saveOwnedGroupID(serverHost: String, org: String, name: String, groupID: Int64) throws {\n449|        let file = ownershipFile()\n450|        var table: [String: Int64] = [:]\n451|        if let data = try? Data(contentsOf: file),\n452|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n453|            table = decoded\n454|        }\n455|        table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)] = groupID\n456|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n457|        let data = try JSONEncoder().encode(table)\n458|        try data.write(to: file, options: .atomic)\n459|    }\n460|\n461|    /// Reads the local `.runner` identity without touching credentials.\n462|    /// Returns nil only when the file is missing or unparseable; a present\n463|    /// but incomplete file returns a partial struct so verification can name\n464|    /// the exact missing field instead of crashing.\n465|    public func readLocalRegistration(directory: URL) -> RunnerRegistration.LocalRegistration? {\n466|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n467|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n468|        var agentID: Int64?\n469|        if let id = object[\"agentId\"] as? Int64 { agentID = id }\n470|        else if let id = object[\"agentId\"] as? Int { agentID = Int64(id) }\n471|        else if let id = object[\"agentId\"] as? NSNumber { agentID = id.int64Value }\n472|        return RunnerRegistration.LocalRegistration(\n473|            agentID: agentID,\n474|            agentName: object[\"agentName\"] as? String,\n475|            gitHubURL: object[\"gitHubUrl\"] as? String,\n476|            workFolder: object[\"workFolder\"] as? String\n477|        )\n478|    }\n479|\n480|    /// Reads the local agent ID from `.runner` without touching credentials.\n481|    public func readAgentID(directory: URL) -> Int64? {\n482|        readLocalRegistration(directory: directory)?.agentID\n483|    }\n484|\n485|    // MARK: - Manual LaunchAgent\n486|\n487|    /// Writes the manual service plist (RunAtLoad off for new runners) and\n488|    /// validates it matches the directory. Never bootstraps the service:\n489|    /// enabling is the user's separate action.\n490|    @discardableResult\n491|    public func setupService(directory: URL, label: String) throws -> URL {\n492|        guard !directory.path.contains(\" \") else {\n493|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n494|        }\n495|        // Never rewrite the service while a live install/config owns the\n496|        // directory; the caller retries after that operation settles.\n497|        try requireIdleDirectory(directory)\n498|        let files = FileManager.default\n499|        guard files.fileExists(atPath: directory.appendingPathComponent(\"runsvc.sh\").path) else {\n500|            throw RunnerRegistration.RegistrationError.network(\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4fd","stream":{"kind":"session","id":"01a0a90a-330a-7132-bdeb-2012149a0d8b"},"sequence":217,"recorded_at":1780531400000429,"record_type":"event","durability":"durable","causation_id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc","run_stream":{"kind":"run","id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc"},"task_stream":{"kind":"task","id":"01a0a90b-7325-7140-9888-25bed5ba0f0a"},"task_id":"01a0a90b-7325-7140-9888-25bed5ba0f0a","event":{"kind":"completed","task_id":"01a0a90b-7325-7140-9888-25bed5ba0f0a"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4ff","stream":{"kind":"session","id":"01a0a90a-330a-7132-bdeb-2012149a0d8b"},"sequence":218,"recorded_at":1780531400000431,"record_type":"event","durability":"durable","causation_id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc","run_stream":{"kind":"run","id":"e30341db-b4fb-4a21-89c3-ee429bb9c3cc"},"call_id":"call_01a0a90b6f7b71888b13cb3cb1240672","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n1|import CryptoKit\n2|import Foundation\n3|\n4|/// Filesystem installer for downloaded GitHub Actions runners.\n5|///\n6|/// Production path: download bytes → SHA-256 verify → tar extract →\n7|/// `bin/runsvc.sh` copied into the root and chmodded (as official `svc.sh`\n8|/// would) → exact `config.sh` invocation → manual LaunchAgent plist.\n9|/// All side effects stay below `installRoot`; tests inject a temporary root,\n10|/// a fake downloader, and fixtures instead of touching production runners.\n11|public actor RunnerInstallerService {\n12|    public static let markerFileName = \".runnercontrol-install.json\"\n13|    public static let installOS = \"osx\"\n14|\n15|    private let installRoot: URL\n16|    private let downloader: @Sendable (URL) async throws -> Data\n17|    private let executor: any CommandExecuting\n18|    private let currentArch: @Sendable () -> String\n19|    private let hasher: @Sendable (Data) -> String\n20|\n21|    public init(\n22|        installRoot: URL? = nil,\n23|        downloader: (@Sendable (URL) async throws -> Data)? = nil,\n24|        executor: (any CommandExecuting)? = nil,\n25|        currentArch: (@Sendable () -> String)? = nil,\n26|        hasher: (@Sendable (Data) -> String)? = nil\n27|    ) {\n28|        self.installRoot = installRoot\n29|            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/GitHubActions\")\n30|        self.downloader = downloader ?? { url in\n31|            let (data, _) = try await URLSession.shared.data(from: url)\n32|            return data\n33|        }\n34|        self.executor = executor ?? CommandExecutor()\n35|        self.currentArch = currentArch ?? {\n36|            #if arch(arm64)\n37|            return \"arm64\"\n38|            #else\n39|            return \"x64\"\n40|            #endif\n41|        }\n42|        self.hasher = hasher ?? { data in\n43|            SHA256.hash(data: data).map { String(format: \"%02x\", $0) }.joined()\n44|        }\n45|    }\n46|\n47|    public nonisolated var root: URL { installRoot }\n48|    public nonisolated var architecture: String { currentArch() }\n49|\n50|    /// Canonical installation directories with a live mutating side effect\n51|    /// (download/extract/config/service/recovery). Acquired synchronously\n52|    /// before the first await and released only when the owning operation\n53|    /// settles, so actor reentrancy can never admit two mutations of one\n54|    /// directory. Abandoning a UI generation does not release this resource;\n55|    /// only the settling side effect does.\n56|    private var activeDirectories: Set<String> = []\n57|\n58|    public func directory(for installDirName: String) -> URL {\n59|        installRoot.appendingPathComponent(installDirName)\n60|    }\n61|\n62|    /// Canonical lease key for a directory: physical filesystem identity, not\n63|    /// path spelling. Both Flow-derived URLs (from a stored install path)\n64|    /// and `directory(for:)` URLs map to the same key for the same on-disk\n65|    /// location, including through symlink leaves and symlink ancestors.\n66|    /// Not-yet-created leaves canonicalize via their nearest existing\n67|    /// ancestor, so `/tmp`-vs-`/private/tmp` spellings of one directory map\n68|    /// to one key before the leaf exists.\n69|    nonisolated static func leaseKey(for directory: URL) -> String {\n70|        let standardized = URL(fileURLWithPath: directory.path).standardizedFileURL\n71|        let files = FileManager.default\n72|        var base = standardized\n73|        var suffix: [String] = []\n74|        while true {\n75|            if files.fileExists(atPath: base.path) || Self.isSymlink(atPath: base.path) {\n76|                break\n77|            }\n78|            let parent = base.deletingLastPathComponent()\n79|            if parent.path == base.path { break }\n80|            suffix.insert(base.lastPathComponent, at: 0)\n81|            base = parent\n82|        }\n83|        let resolvedBase = base.resolvingSymlinksInPath().path\n84|        if suffix.isEmpty {\n85|            return URL(fileURLWithPath: resolvedBase).standardizedFileURL.path\n86|        }\n87|        var url = URL(fileURLWithPath: resolvedBase, isDirectory: true)\n88|        for component in suffix { url.appendPathComponent(component) }\n89|        return url.standardizedFileURL.path\n90|    }\n91|\n92|    private nonisolated static func isSymlink(atPath path: String) -> Bool {\n93|        (try? FileManager.default.destinationOfSymbolicLink(atPath: path)) != nil\n94|    }\n95|\n96|    /// Refuses Finder-alias installation paths before any side effect. A\n97|    /// Finder alias is not a transparent directory like a symlink: operating\n98|    /// through its spelling would not operate on the target, so alias\n99|    /// spellings are rejected instead of being canonicalized. Symlinks are\n100|    /// resolved by `leaseKey`, not refused here.\n101|    nonisolated static func ensureNoAlias(at directory: URL) throws {\n102|        var current = URL(fileURLWithPath: directory.path).standardizedFileURL\n103|        while true {\n104|            if FileManager.default.fileExists(atPath: current.path),\n105|               (try? current.resourceValues(forKeys: [.isAliasFileKey]))?.isAliasFile == true {\n106|                throw RunnerRegistration.RegistrationError.invalidDraft(\n107|                    \"Installation path '\\(directory.path)' resolves through a Finder alias at '\\(current.path)'. Choose a direct folder path instead of an alias.\"\n108|                )\n109|            }\n110|            let parent = current.deletingLastPathComponent()\n111|            if parent.path == current.path { break }\n112|            current = parent\n113|        }\n114|    }\n115|\n116|    /// Acquires exclusive ownership of `directory`. Synchronous: callers must\n117|    /// invoke it before their first await so the check-and-insert is atomic\n118|    /// under actor isolation. Throws a retryable `directoryBusy` when another\n119|    /// live operation already owns the directory; different physical\n120|    /// directories never conflict. Returns the originally acquired canonical\n121|    /// key; the caller must hold it across awaits and release that exact key.\n122|    private func acquireLease(for directory: URL) throws -> String {\n123|        try Self.ensureNoAlias(at: directory)\n124|        let key = Self.leaseKey(for: directory)\n125|        guard !activeDirectories.contains(key) else {\n126|            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n127|        }\n128|        activeDirectories.insert(key)\n129|        return key\n130|    }\n131|\n132|    private func releaseLease(_ key: String) {\n133|        activeDirectories.remove(key)\n134|    }\n135|\n136|    /// Refuses a synchronous mutation (service setup, recovery) while a live\n137|    /// async side effect owns the directory. No insert: without an await the\n138|    /// caller itself cannot interleave, it only needs to respect leases held\n139|    /// by others. Uses the same canonical identity as acquisition.\n140|    private func requireIdleDirectory(_ directory: URL) throws {\n141|        try Self.ensureNoAlias(at: directory)\n142|        guard !activeDirectories.contains(Self.leaseKey(for: directory)) else {\n143|            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n144|        }\n145|    }\n146|\n147|    // MARK: - Idempotency markers\n148|\n149|    public struct Marker: Codable, Sendable, Equatable {\n150|        public var scopeKey: String\n151|        public var completedSteps: Set<String>\n152|        /// Server the directory was configured against (`.runner` host is\n153|        /// authoritative; this records the config-time expectation so a\n154|        /// group/server change cannot reuse an old configured marker).\n155|        public var serverHost: String?\n156|        /// Dedicated group passed to `config.sh --runnergroup` (org scope).\n157|        /// `.runner` does not record it, so the marker must: a group-name\n158|        /// edit never claims the old group's configuration as its own.\n159|        public var groupName: String?\n160|        public init(\n161|            scopeKey: String, completedSteps: Set<String> = [],\n162|            serverHost: String? = nil, groupName: String? = nil\n163|        ) {\n164|            self.scopeKey = scopeKey; self.completedSteps = completedSteps\n165|            self.serverHost = serverHost; self.groupName = groupName\n166|        }\n167|    }\n168|\n169|    public static let stepDownloaded = \"downloaded\"\n170|    public static let stepInstalled = \"installed\"\n171|    public static let stepConfigured = \"configured\"\n172|    public static let stepServiceReady = \"serviceReady\"\n173|\n174|    public func loadMarker(directory: URL) -> Marker? {\n175|        let url = directory.appendingPathComponent(Self.markerFileName)\n176|        guard let data = try? Data(contentsOf: url) else { return nil }\n177|        return try? JSONDecoder().decode(Marker.self, from: data)\n178|    }\n179|\n180|    private func storeMarker(_ marker: Marker, directory: URL) throws {\n181|        let data = try JSONEncoder().encode(marker)\n182|        try data.write(to: directory.appendingPathComponent(Self.markerFileName), options: .atomic)\n183|    }\n184|\n185|    public func markCompleted(\n186|        _ step: String, directory: URL, scopeKey: String,\n187|        serverHost: String? = nil, groupName: String? = nil\n188|    ) throws {\n189|        var marker = loadMarker(directory: directory) ?? Marker(scopeKey: scopeKey)\n190|        marker.completedSteps.insert(step)\n191|        if let serverHost { marker.serverHost = serverHost }\n192|        if let groupName { marker.groupName = groupName }\n193|        try storeMarker(marker, directory: directory)\n194|    }\n195|\n196|    public func hasCompleted(_ step: String, directory: URL) -> Bool {\n197|        loadMarker(directory: directory)?.completedSteps.contains(step) == true\n198|    }\n199|\n200|    // MARK: - Install\n201|\n202|    /// Downloads, verifies, and extracts the official package. Idempotent:\n203|    /// a completed `installed` marker with matching scope and server skips\n204|    /// the work. Refuses to overwrite an already-registered directory (no\n205|    /// duplicates).\n206|    public func downloadAndInstall(\n207|        asset: RunnerRegistration.DownloadAsset,\n208|        draft: RunnerRegistration.Draft,\n209|        serverHost: String? = nil\n210|    ) async throws -> URL {\n211|        try RunnerRegistration.Gates.validateNoSpace(\n212|            installDirName: draft.installDirName, workFolder: draft.workFolder\n213|        )\n214|        let directory = self.directory(for: draft.installDirName)\n215|        if directory.path.contains(\" \") {\n216|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n217|        }\n218|        // Exclusive ownership for the whole mutation, acquired before the\n219|        // first await (reuse check included): a same-directory retry while\n220|        // this install is live is refused retryably instead of starting a\n221|        // second download/extract over the same directory. The originally\n222|        // acquired canonical key is held across awaits and released exactly.\n223|        let lease = try acquireLease(for: directory)\n224|        defer { releaseLease(lease) }\n225|        let files = FileManager.default\n226|        if let marker = loadMarker(directory: directory),\n227|           marker.completedSteps.contains(Self.stepInstalled),\n228|           marker.scopeKey == draft.scope.scopeKey,\n229|           Self.markerServerMatches(marker: marker, serverHost: serverHost),\n230|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n231|            return directory\n232|        }\n233|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n234|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: draft.runnerName)\n235|        }\n236|        let bytes: Data\n237|        do {\n238|            bytes = try await downloader(asset.downloadURL)\n239|        } catch {\n240|            throw RunnerRegistration.RegistrationError.network(\"Runner download failed: \\(error.localizedDescription)\")\n241|        }\n242|        // Fail closed: the official downloads endpoint documents\n243|        // `sha256_checksum`, and an install without a verified digest is\n244|        // refused rather than trusted on TLS alone.\n245|        guard let expected = asset.sha256Checksum, !expected.isEmpty else {\n246|            throw RunnerRegistration.RegistrationError.integrityMismatch\n247|        }\n248|        let actual = hasher(bytes)\n249|        guard actual.lowercased() == expected.lowercased() else {\n250|            throw RunnerRegistration.RegistrationError.integrityMismatch\n251|        }\n252|        try files.createDirectory(at: directory, withIntermediateDirectories: true)\n253|        let archive = files.temporaryDirectory.appendingPathComponent(UUID().uuidString + \"-\" + asset.filename)\n254|        defer { try? files.removeItem(at: archive) }\n255|        try bytes.write(to: archive, options: .atomic)\n256|        let result = try await executor.run(\"/usr/bin/tar\", [\"-xzf\", archive.path, \"-C\", directory.path])\n257|        guard result.code == 0 else {\n258|            throw RunnerRegistration.RegistrationError.network(\n259|                \"Runner archive extraction failed: \\(String(result.output.prefix(300)))\"\n260|            )\n261|        }\n262|        // Official packages keep runsvc.sh under bin/ until svc.sh installs it;\n263|        // a bare extraction leaves the root copy absent, so install it here.\n264|        try installRunsvc(directory: directory)\n265|        try markCompleted(\n266|            Self.stepDownloaded, directory: directory,\n267|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n268|        )\n269|        try markCompleted(\n270|            Self.stepInstalled, directory: directory,\n271|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n272|        )\n273|        return directory\n274|    }\n275|\n276|    /// Server binding for install reuse. A marker written without a server\n277|    /// (pre-revision-4) never satisfies a server-bound request: the next\n278|    /// install re-verifies instead of reusing unknown provenance. Direct\n279|    /// installer calls without a server (unit fixtures) keep the legacy\n280|    /// scope-only reuse.\n281|    static func markerServerMatches(marker: Marker, serverHost: String?) -> Bool {\n282|        guard let want = serverHost else { return true }\n283|        guard let have = marker.serverHost else { return false }\n284|        return RunnerRegistration.OperationIdentity.normalizeServerHost(have)\n285|            == RunnerRegistration.OperationIdentity.normalizeServerHost(want)\n286|    }\n287|\n288|    /// Copies official `bin/runsvc.sh` into the installation root and makes\n289|    /// it executable, mirroring what official `svc.sh install` would do.\n290|    public func installRunsvc(directory: URL) throws {\n291|        let files = FileManager.default\n292|        let source = directory.appendingPathComponent(\"bin/runsvc.sh\")\n293|        let target = directory.appendingPathComponent(\"runsvc.sh\")\n294|        guard files.fileExists(atPath: source.path) else {\n295|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing bin/runsvc.sh.\")\n296|        }\n297|        if files.fileExists(atPath: target.path) {\n298|            try files.removeItem(at: target)\n299|        }\n300|        try files.copyItem(at: source, to: target)\n301|        try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: target.path)\n302|    }\n303|\n304|    // MARK: - Configure\n305|\n306|    /// Runs the exact `config.sh` invocation. Skips when a previous attempt\n307|    /// already registered this directory (marker + `.runner` present), so\n308|    /// retries never create orphan or duplicate GitHub registrations.\n309|    /// Returns the local agent ID read back from `.runner`.\n310|    @discardableResult\n311|    public func runConfig(\n312|        directory: URL,\n313|        scopeURL: String,\n314|        token: String,\n315|        draft: RunnerRegistration.Draft,\n316|        runnerGroup: String?\n317|    ) async throws -> Int64? {\n318|        try await runConfig(\n319|            directory: directory, scopeURL: scopeURL, token: token,\n320|            draft: draft, runnerGroup: runnerGroup, replace: draft.allowReplace\n321|        )\n322|    }\n323|\n324|    /// Explicit-`replace` variant. Production callers pass\n325|    /// `draft.allowReplace`; tests drive both values.\n326|    @discardableResult\n327|    public func runConfig(\n328|        directory: URL,\n329|        scopeURL: String,\n330|        token: String,\n331|        draft: RunnerRegistration.Draft,\n332|        runnerGroup: String?,\n333|        replace: Bool\n334|    ) async throws -> Int64? {\n335|        let files = FileManager.default\n336|        let scopeHost = URL(string: scopeURL)?.host ?? \"\"\n337|        // Exclusive ownership for the whole config, acquired before the\n338|        // first await (resume checks included): a same-directory retry while\n339|        // this config.sh is live is refused retryably instead of invoking a\n340|        // second config.sh over the same .runner. The lease is released only\n341|        // when this operation settles; an abandoned UI generation never\n342|        // releases it. The originally acquired canonical key is held across\n343|        // awaits and released exactly.\n344|        let lease = try acquireLease(for: directory)\n345|        defer { releaseLease(lease) }\n346|        if hasCompleted(Self.stepConfigured, directory: directory),\n347|           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n348|            // Idempotent resume never returns a stale ID: the existing\n349|            // configuration must still match this draft on this server.\n350|            let local = readLocalRegistration(directory: directory)\n351|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n352|                local: local, configured: true, draft: draft, serverHost: scopeHost\n353|            )\n354|            try Self.verifyConfiguredGroup(\n355|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n356|            )\n357|            return verified\n358|        }\n359|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n360|           hasCompleted(Self.stepConfigured, directory: directory) {\n361|            let local = readLocalRegistration(directory: directory)\n362|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n363|                local: local, configured: true, draft: draft, serverHost: scopeHost\n364|            )\n365|            try Self.verifyConfiguredGroup(\n366|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n367|            )\n368|            return verified\n369|        }\n370|        let spec = RunnerRegistration.ConfigSpec(\n371|            scopeURL: scopeURL, token: token, name: draft.runnerName,\n372|            workFolder: draft.workFolder, labels: draft.labels,\n373|            runnerGroup: runnerGroup, replace: replace\n374|        )\n375|        let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n376|        let executable = directory.appendingPathComponent(\"config.sh\").path\n377|        guard files.fileExists(atPath: executable) else {\n378|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n379|        }\n380|        let result = try await executor.run(executable, args)\n381|        guard result.code == 0 else {\n382|            // Never echo the token: config output may repeat arguments.\n383|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [token])\n384|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n385|        }\n386|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n387|            throw RunnerRegistration.RegistrationError.configFailed(\n388|                \"config.sh reported success but .runner is missing.\"\n389|            )\n390|        }\n391|        try markCompleted(\n392|            Self.stepConfigured, directory: directory, scopeKey: draft.scope.scopeKey,\n393|            serverHost: scopeHost, groupName: runnerGroup\n394|        )\n395|        return readAgentID(directory: directory)\n396|    }\n397|\n398|    /// `.runner` does not record the org group, so the configured marker\n399|    /// does. A resume whose marker names another group (or predates group\n400|    /// recording) refuses instead of claiming the old group's configuration\n401|    /// as the new draft's. Repository scope never configures a group.\n402|    static func verifyConfiguredGroup(\n403|        marker: Marker?, runnerGroup: String?, draft: RunnerRegistration.Draft\n404|    ) throws {\n405|        switch draft.scope {\n406|        case .repository:\n407|            return\n408|        case .organization:\n409|            break\n410|        }\n411|        let wanted = (runnerGroup ?? draft.groupName).trimmingCharacters(in: .whitespacesAndNewlines)\n412|        guard let have = marker?.groupName?.trimmingCharacters(in: .whitespacesAndNewlines),\n413|              !have.isEmpty else {\n414|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n415|                \"Directory '\\(draft.installDirName)' was configured before group recording. Reconfigure for group '\\(wanted)' instead of reusing the old configuration.\"\n416|            )\n417|        }\n418|        guard have == wanted else {\n419|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n420|                \"Local registration was configured for group '\\(have)', not '\\(wanted)'. Reconfigure instead of reusing the old group's configuration.\"\n421|            )\n422|        }\n423|    }\n424|\n425|    // MARK: - Dedicated-group ownership\n426|\n427|    public static let ownershipFileName = \".runnercontrol-groups.json\"\n428|\n429|    private func ownershipFile() -> URL {\n430|        installRoot.appendingPathComponent(Self.ownershipFileName)\n431|    }\n432|\n433|    private static func ownershipKey(serverHost: String, org: String, name: String) -> String {\n434|        \"\\(RunnerRegistration.OperationIdentity.normalizeServerHost(serverHost))\\u{0}\\(org.lowercased())\\u{0}\\(name)\"\n435|    }\n436|\n437|    /// Returns the locally recorded dedicated-group ID for\n438|    /// `server` + `org` + `name`, or nil when this Mac never created (or\n439|    /// took over) that group on that server. Name matches on GitHub alone\n440|    /// never count as ownership, and ownership on one server never\n441|    /// authorizes adoption on another.\n442|    public func loadOwnedGroupID(serverHost: String, org: String, name: String) -> Int64? {\n443|        guard let data = try? Data(contentsOf: ownershipFile()),\n444|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n445|        return table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)]\n446|    }\n447|\n448|    public func saveOwnedGroupID(serverHost: String, org: String, name: String, groupID: Int64) throws {\n449|        let file = ownershipFile()\n450|        var table: [String: Int64] = [:]\n451|        if let data = try? Data(contentsOf: file),\n452|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n453|            table = decoded\n454|        }\n455|        table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)] = groupID\n456|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n457|        let data = try JSONEncoder().encode(table)\n458|        try data.write(to: file, options: .atomic)\n459|    }\n460|\n461|    /// Reads the local `.runner` identity without touching credentials.\n462|    /// Returns nil only when the file is missing or unparseable; a present\n463|    /// but incomplete file returns a partial struct so verification can name\n464|    /// the exact missing field instead of crashing.\n465|    public func readLocalRegistration(directory: URL) -> RunnerRegistration.LocalRegistration? {\n466|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n467|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n468|        var agentID: Int64?\n469|        if let id = object[\"agentId\"] as? Int64 { agentID = id }\n470|        else if let id = object[\"agentId\"] as? Int { agentID = Int64(id) }\n471|        else if let id = object[\"agentId\"] as? NSNumber { agentID = id.int64Value }\n472|        return RunnerRegistration.LocalRegistration(\n473|            agentID: agentID,\n474|            agentName: object[\"agentName\"] as? String,\n475|            gitHubURL: object[\"gitHubUrl\"] as? String,\n476|            workFolder: object[\"workFolder\"] as? String\n477|        )\n478|    }\n479|\n480|    /// Reads the local agent ID from `.runner` without touching credentials.\n481|    public func readAgentID(directory: URL) -> Int64? {\n482|        readLocalRegistration(directory: directory)?.agentID\n483|    }\n484|\n485|    // MARK: - Manual LaunchAgent\n486|\n487|    /// Writes the manual service plist (RunAtLoad off for new runners) and\n488|    /// validates it matches the directory. Never bootstraps the service:\n489|    /// enabling is the user's separate action.\n490|    @discardableResult\n491|    public func setupService(directory: URL, label: String) throws -> URL {\n492|        guard !directory.path.contains(\" \") else {\n493|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n494|        }\n495|        // Never rewrite the service while a live install/config owns the\n496|        // directory; the caller retries after that operation settles.\n497|        try requireIdleDirectory(directory)\n498|        let files = FileManager.default\n499|        guard files.fileExists(atPath: directory.appendingPathComponent(\"runsvc.sh\").path) else {\n500|            throw RunnerRegistration.RegistrationError.network(\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
