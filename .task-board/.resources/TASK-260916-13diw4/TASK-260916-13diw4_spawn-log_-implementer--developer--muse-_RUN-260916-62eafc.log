21|    public func recoverPartialInstall(directory: URL, scopeKey: String) throws {\n522|        let files = FileManager.default\n523|        guard files.fileExists(atPath: directory.path) else { return }\n524|        // Never delete a directory a live operation still owns; the caller\n525|        // retries after that operation settles.\n526|        try requireIdleDirectory(directory)\n527|        guard !files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n528|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: directory.lastPathComponent)\n529|        }\n530|        if let marker = loadMarker(directory: directory), marker.scopeKey != scopeKey {\n531|            throw RunnerRegistration.RegistrationError.alreadyInstalled(path: directory.path)\n532|        }\n533|        try files.removeItem(at: directory)\n534|    }\n535|}","final_result":true}}}
