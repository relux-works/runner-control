registrationActions(harness.logger).dropFirst(before))\n2061|    #expect(!after.contains { if case .registered = $0 { true } else { false } }, \"Old _work configuration is not new_work success\")\n2062|    #expect(lastFailure(harness.logger)?.step == \"registerRunner\")\n2063|}\n2064|\n2065|// MARK: - R4: coherent operation identity (in-flight, server, configuration)\n2066|\n2067|// Latch executor: suspends the next config.sh so a draft edit can land\n2068|// while registration is in flight through the production Flow entry point.\n2069|private actor ConfigLatchExecutor: CommandExecuting {\n2070|    private(set) var configCalls: [[String]] = []\n2071|    private let gitHubURL: String\n2072|    private let failure: CommandResult?\n2073|    private let real = CommandExecutor()\n2074|    private var latched = false\n2075|    var started = false\n2076|    private var waiter: CheckedContinuation<Void, Never>?\n2077|    private var releaseWaiter: CheckedContinuation<Void, Never>?\n2078|    init(gitHubURL: String = \"https://github.com/acme\", failure: CommandResult? = nil) {\n2079|        self.gitHubURL = gitHubURL; self.failure = failure\n2080|    }\n2081|    func run(_ executable: String, _ arguments: [String]) async throws -> CommandResult {\n2082|        if executable.hasSuffix(\"config.sh\") {\n2083|            configCalls.append(arguments)\n2084|            if !latched {\n2085|                latched = true\n2086|                started = true\n2087|                waiter?.resume(); waiter = nil\n2088|                await withCheckedContinuation { releaseWaiter = $0 }\n2089|            }\n2090|            if let failure { return failure }\n2091|            let dir = URL(fileURLWithPath: executable).deletingLastPathComponent()\n2092|            var name = \"unnamed\"\n2093|            var work = \"_work\"\n2094|            var index = arguments.startIndex\n2095|            while index < arguments.endIndex {\n2096|                if arguments[index] == \"--name\", arguments.index(after: index) < arguments.endIndex {\n2097|                    name = arguments[arguments.index(after: index)]\n2098|                }\n2099|                if arguments[index] == \"--work\", arguments.index(after: index) < arguments.endIndex {\n2100|                    work = arguments[arguments.index(after: index)]\n2101|                }\n2102|                index = arguments.index(after: index)\n2103|            }\n2104|            let payload = [\"agentId\": 4242, \"agentName\": name, \"gitHubUrl\": gitHubURL, \"workFolder\": work] as [String: Any]\n2105|            let data = try JSONSerialization.data(withJSONObject: payload)\n2106|            try data.write(to: dir.appendingPathComponent(\".runner\"), options: .atomic)\n2107|            return CommandResult(code: 0, output: \"Configured\")\n2108|        }\n2109|        return try await real.run(executable, arguments)\n2110|    }\n2111|    func waitStarted() async {\n2112|        if started { return }\n2113|        await withCheckedContinuation { waiter = $0 }\n2114|    }\n2115|    func release() { releaseWaiter?.resume(); releaseWaiter = nil }\n2116|}\n2117|\n2118|// Latch transport: suspends the matching request whose path contains the\n2119|// needle (after skipping `skip` prior matches of the same method), so a\n2120|// draft or session edit can land while a GitHub step is in flight. The\n2121|// method filter keeps token POSTs from consuming list-GET skip budget.\n2122|private actor LatchTransport: GitHubHTTPTransport {\n2123|    private let inner: TestTransport\n2124|    private let needle: String\n2125|    private let method: String?\n2126|    private let skip: Int\n2127|    private var seen = 0\n2128|    private var latched = false\n2129|    var started = false\n2130|    private var waiter: CheckedContinuation<Void, Never>?\n2131|    private var releaseWaiter: CheckedContinuation<Void, Never>?\n2132|    init(inner: TestTransport, needle: String, method: String? = nil, skip: Int = 0) {\n2133|        self.inner = inner; self.needle = needle; self.method = method; self.skip = skip\n2134|    }\n2135|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n2136|        if !latched, request.url.path.contains(needle), method == nil || request.method == method {\n2137|            if seen >= skip {\n2138|                latched = true\n2139|                started = true\n2140|                waiter?.resume(); waiter = nil\n2141|                await withCheckedContinuation { releaseWaiter = $0 }\n2142|            } else {\n2143|                seen += 1\n2144|            }\n2145|        }\n2146|        return try await inner.send(request)\n2147|    }\n2148|    func waitStarted() async {\n2149|        if started { return }\n2150|        await withCheckedContinuation { waiter = $0 }\n2151|    }\n2152|    func release() { releaseWaiter?.resume(); releaseWaiter = nil }\n2153|}\n2154|\n2155|private func latchedHarness(\n2156|    inner: TestTransport, needle: String, method: String? = nil, skip: Int = 0,\n2157|    downloader: (@Sendable (URL) async throws -> Data)? = nil,\n2158|    executor: (any CommandExecuting)? = nil\n2159|) async -> (RegistrationHarness, LatchTransport) {\n2160|    let logger = Relux.Testing.Logger()\n2161|    let dispatcher = Relux.Dispatcher(logger: logger)\n2162|    let latch = LatchTransport(inner: inner, needle: needle, method: method, skip: skip)\n2163|    let userStore = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n2164|    let identities = InMemoryGitHubSessionIdentityStore()\n2165|    await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n2166|    try? await userStore.save(\n2167|        GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n2168|        serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n2169|    )\n2170|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"RegHome-\" + UUID().uuidString)\n2171|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n2172|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n2173|    let installer = RunnerInstallerService(\n2174|        installRoot: installRoot, downloader: downloader, executor: executor, currentArch: { \"arm64\" }\n2175|    )\n2176|    let api = GitHubRunnerAPIClient(transport: latch)\n2177|    let registrationTokens = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n2178|    let refresher = GitHubTokenRefresh(transport: latch, store: userStore)\n2179|    let flow = await RunnerRegistration.Flow(\n2180|        api: api, installer: installer, registrationTokens: registrationTokens,\n2181|        userStore: userStore, identityStore: identities, refresher: refresher,\n2182|        configProvider: { _ in testConfig }, dispatcher: dispatcher\n2183|    )\n2184|    let harness = RegistrationHarness(\n2185|        flow: flow, logger: logger, transport: inner, userStore: userStore,\n2186|        identities: identities, registrationTokens: registrationTokens,\n2187|        installer: installer, home: home, installRoot: installRoot\n2188|    )\n2189|    return (harness, latch)\n2190|}\n2191|\n2192|@Test @MainActor func inFlightRegistrationCannotAttributeOldConfigToNewDraft() async throws {\n2193|    // R3-F1 class at the registration boundary: config suspends, the draft\n2194|    // renames, the old config's success must not become the new draft's.\n2195|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2196|    let executor = ConfigLatchExecutor()\n2197|    let transport = TestTransport([\n2198|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2199|        runnersListPayload([]),\n2200|        jsonResponse([\"token\": \"REG-SECRET-R4\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2201|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2202|    ])\n2203|    let harness = await registrationHarness(\n2204|        transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor\n2205|    )\n2206|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2207|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2208|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2209|    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2210|    await executor.waitStarted()\n2211|    var renamed = orgDraft()\n2212|    renamed.runnerName = \"renamed-runner\"\n2213|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(renamed))\n2214|    await executor.release()\n2215|    _ = await operation.value\n2216|    let state = RunnerRegistration.State()\n2217|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2218|    #expect(state.draft?.runnerName == \"renamed-runner\")\n2219|    #expect(state.runnerID == nil)\n2220|    #expect(!state.completedSteps.contains(\"registerRunner\"))\n2221|    #expect(!registrationActions(harness.logger).contains { if case .registered = $0 { true } else { false } })\n2222|}\n2223|\n2224|@Test @MainActor func inFlightGroupCannotResolveForEditedDraft() async throws {\n2225|    // R3-F1 class at the group boundary: the groups list suspends, the\n2226|    // draft re-targets another group, the old resolution must not land.\n2227|    let inner = TestTransport([\n2228|        groupsListPayload([groupPayload(id: 1, name: \"Default\", visibility: \"all\", allowsPublic: true)]),\n2229|        jsonResponse(groupPayload(id: 7, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true), status: 201),\n2230|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n2231|    ])\n2232|    let (harness, latch) = await latchedHarness(inner: inner, needle: \"runner-groups\")\n2233|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2234|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2235|    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.resolveGroup) }\n2236|    await latch.waitStarted()\n2237|    var edited = orgDraft()\n2238|    edited.groupName = \"Other-Mac\"\n2239|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2240|    await latch.release()\n2241|    _ = await operation.value\n2242|    let state = RunnerRegistration.State()\n2243|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2244|    #expect(state.draft?.groupName == \"Other-Mac\")\n2245|    #expect(state.group == nil)\n2246|    #expect(!state.completedSteps.contains(\"resolveGroup\"))\n2247|}\n2248|\n2249|@Test @MainActor func inFlightLabelsCannotWriteForEditedDraft() async throws {\n2250|    // R3-F1 class at the labels boundary: the labels runners-list fetch\n2251|    // suspends (downloads plus the two registration fetches pass through),\n2252|    // the draft renames, and the stale write is dropped before any PUT.\n2253|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2254|    let inner = TestTransport([\n2255|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2256|        runnersListPayload([]),\n2257|        jsonResponse([\"token\": \"REG-SECRET-R4L\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2258|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2259|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
