 42, clientID: testConfig.clientID, username: \"octo\"))\n36|        try? await userStore.save(\n37|            GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n38|            serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n39|        )\n40|    }\n41|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"RegHome-\" + UUID().uuidString)\n42|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n43|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n44|    let archCopy = arch\n45|    let installer = RunnerInstallerService(\n46|        installRoot: installRoot,\n47|        downloader: downloader,\n48|        executor: executor,\n49|        currentArch: { archCopy }\n50|    )\n51|    let api = GitHubRunnerAPIClient(transport: transport)\n52|    let registrationTokens = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n53|    let refresher = GitHubTokenRefresh(transport: transport, store: userStore)\n54|    let flow = await RunnerRegistration.Flow(\n55|        api: api, installer: installer, registrationTokens: registrationTokens,\n56|        userStore: userStore, identityStore: identities, refresher: refresher,\n57|        configProvider: { _ in testConfig }, dispatcher: dispatcher\n58|    )\n59|    return RegistrationHarness(\n60|        flow: flow, logger: logger, transport: transport, userStore: userStore,\n61|        identities: identities, registrationTokens: registrationTokens,\n62|        installer: installer, home: home, installRoot: installRoot\n63|    )\n64|}\n65|\n66|private func registrationActions(_ logger: Relux.Testing.Logger) -> [RunnerRegistration.Action] {\n67|    logger.actions.compactMap { $0 as? RunnerRegistration.Action }\n68|}\n69|\n70|private func lastFailure(_ logger: Relux.Testing.Logger) -> (message: String, step: String)? {