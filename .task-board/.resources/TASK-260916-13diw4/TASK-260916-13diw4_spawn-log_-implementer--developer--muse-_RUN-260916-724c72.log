{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c895","stream":{"kind":"session","id":"01a0a895-af1e-7030-b7a0-b39b63843e96"},"sequence":677,"recorded_at":1780531400001349,"record_type":"event","durability":"durable","causation_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","run_stream":{"kind":"run","id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332"},"task_stream":{"kind":"task","id":"01a0a898-abde-7573-a06c-fc265e9efa2b"},"task_id":"01a0a898-abde-7573-a06c-fc265e9efa2b","event":{"kind":"output","task_id":"01a0a898-abde-7573-a06c-fc265e9efa2b","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(1136 line(s) above)\n1137|@Test func takeoverRecordsOwnershipForRetries() async throws {\n1138|    let transport = TestTransport([\n1139|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n1140|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1141|    ])\n1142|    let harness = await registrationHarness(transport: transport)\n1143|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1144|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1145|    #expect(await harness.installer.loadOwnedGroupID(org: \"acme\", name: \"RunnerControl-Mac\") == 5)\n1146|}\n1147|\n1148|// MARK: - Public repositories (allows_public_repositories)\n1149|\n1150|@Test func resolvePatchesDeniedPublicReposOnOwnedGroup() async throws {\n1151|    let transport = TestTransport([\n1152|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: false)]),\n1153|        jsonResponse(groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)),\n1154|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1155|    ])\n1156|    let harness = await registrationHarness(transport: transport)\n1157|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1158|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1159|    let patches = await transport.requests.filter { $0.method == \"PATCH\" }\n1160|    #expect(patches.count == 1)\n1161|    #expect(patches.first?.url.path.contains(\"/orgs/acme/actions/runner-groups/5\") ?? false)\n1162|    let body = try JSONDecoder().decode([String: JSONAny].self, from: patches.first?.body ?? Data())\n1163|    #expect(body[\"allows_public_repositories\"]?.bool == true)\n1164|    let resolved = registrationActions(harness.logger).compactMap { action -> RunnerRegistration.RunnerGroup? in\n1165|        if case .groupResolved(let group, _) = action { group } else { nil }\n1166|    }\n1167|    #expect(resolved.first?.allowsPublicRepositories == true)\n1168|}\n1169|\n1170|@Test func resolveSkipsPatchWhenPublicReposAllowed() async {\n1171|    let transport = TestTransport([\n1172|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n1173|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n1174|    ])\n1175|    let harness = await registrationHarness(transport: transport)\n1176|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n1177|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n1178|    #expect(await transport.requests.filter { $0.method == \"PATCH\" }.isEmpty)\n1179|}\n1180|\n1181|// MARK: - Remote duplicate names (no silent --replace)\n1182|\n1183|@Test func remoteDuplicateWithoutReplaceIsRefusedBeforeToken() async throws {\n1184|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1185|    let executor = SplitExecutor()\n1186|    let transport = TestTransport([\n1187|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1188|        runnersListPayload([[\"id\": 99, \"name\": \"macbook-test\", \"labels\": []]]),\n1189|    ])\n1190|    let harness = await registrationHarness(\n1191|        transport: transport,\n1192|        downloader: fixtureDownloader(package.bytes),\n1193|        executor: executor\n1194|    )\n1195|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n1196|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1197|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n1198|    let failure = lastFailure(harness.logger)\n1199|    #expect(failure?.step == \"registerRunner\")\n1200|    #expect((failure?.message.contains(\"already exists in GitHub\") ?? false))\n1201|    // No registration token was minted and config.sh never ran.\n1202|    let tokenPosts = await transport.requests.filter {\n1203|        $0.method == \"POST\" && $0.url.path.contains(\"registration-token\")\n1204|    }\n1205|    #expect(tokenPosts.isEmpty)\n1206|    #expect(await executor.configCalls.isEmpty)\n1207|}\n1208|\n1209|@Test func remoteDuplicateWithReplaceProceedsWithFlag() async throws {\n1210|    let package = try await FixturePackage.make(withRealConfigScript: false)\n1211|    let executor = SplitExecutor()\n1212|    let transport = TestTransport([\n1213|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n1214|        runnersListPayload([[\"id\": 99, \"name\": \"macbook-test\", \"labels\": []]]),\n1215|        jsonResponse([\"token\": \"REG-SECRET-5\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n1216|        runnersListPayload([[\"id\": 99, \"name\": \"macbook-test\", \"labels\": []]]),\n1217|    ])\n1218|    let harness = await registrationHarness(\n1219|        transport: transport,\n1220|        downloader: fixtureDownloader(package.bytes),\n1221|        executor: executor\n1222|    )\n1223|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowReplace: true)))\n1224|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n1225|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n1226|    let calls = await executor.configCalls\n1227|    #expect(calls.count == 1)\n1228|    #expect(calls.first?.contains(\"--replace\") ?? false)\n1229|    let registered = registrationActions(harness.logger).compactMap { action -> Int64? in\n1230|        if case .registered(let runnerID, _) = action, let runnerID { runnerID } else { nil }\n1231|    }\n1232|    #expect(registered.last == 99)\n1233|}\n1234|\n1235|// MARK: - Missing checksum (fail closed)\n1236|\n1237|@Test func downloadRefusesMissingChecksum() async throws {\n1238|    let package = try await FixturePackage.make()\n1239|    let draft = orgDraft()\n1240|    let asset = RunnerRegistration.DownloadAsset(\n1241|        osName: \"osx\", architecture: \"arm64\",\n1242|        downloadURL: URL(string: \"https://example.com/osx-arm64.tar.gz\")!,\n1243|        filename: \"osx-arm64.tar.gz\", sha256Checksum: nil\n1244|    )\n1245|    let harness = await registrationHarness(\n1246|        transport: TestTransport([]), downloader: fixtureDownloader(package.bytes)\n1247|    )\n1248|    do {\n1249|        _ = try await harness.installer.downloadAndInstall(asset: asset, draft: draft)\n1250|        Issue.record(\"installer admitted a package without a checksum\")\n1251|    } catch let error as RunnerRegistration.RegistrationError {\n1252|        guard case .integrityMismatch = error else { Issue.record(\"wrong error: \\(error)\"); return }\n1253|    }\n1254|    let directory = await harness.installer.directory(for: draft.installDirName)\n1255|    #expect(FileManager.default.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) == false)\n1256|}\n1257|\n1258|// MARK: - Labels (editable with real IDs)\n1259|\n1260|@Test func labelsA