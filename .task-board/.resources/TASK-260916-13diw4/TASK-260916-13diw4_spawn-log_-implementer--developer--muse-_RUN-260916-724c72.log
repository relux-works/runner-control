{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c703","stream":{"kind":"session","id":"01a0a895-af1e-7030-b7a0-b39b63843e96"},"sequence":476,"recorded_at":1780531400000947,"record_type":"event","durability":"durable","causation_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","run_stream":{"kind":"run","id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332"},"task_stream":{"kind":"task","id":"01a0a896-dafa-7073-b55b-92b13af5e772"},"task_id":"01a0a896-dafa-7073-b55b-92b13af5e772","event":{"kind":"output","task_id":"01a0a896-dafa-7073-b55b-92b13af5e772","chunk":"Read text file `/Users/iv/Documents/Codex/2026-09-15/new-chat-4/outputs/RunnerControl/.task-board/.resources/TASK-260916-13diw4/TASK-260916-13diw4_review-attacks-rev2.swift`.\n1|\n2|// Reviewer attacks; appended only to git-archived rev2 in /tmp.\n3|@Test func reviewR2ListURLsUseQueryNotEncodedPath() async throws {\n4|    let transport = TestTransport([\n5|        groupsListPayload([]),\n6|        jsonResponse(groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true), status: 201),\n7|        jsonResponse([\"repositories\": []]),\n8|        runnersListPayload([])\n9|    ])\n10|    let h = await registrationHarness(transport: transport)\n11|    defer { try? FileManager.default.removeItem(at: h.home) }\n12|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n13|    _ = await h.flow.apply(RunnerRegistration.Effect.resolveGroup)\n14|    _ = await h.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"]))\n15|    let requests = await transport.requests\n16|    let lists = requests.filter { $0.url.absoluteString.contains(\"per_page\") }\n17|    #expect(lists.count == 2)\n18|    for request in lists {\n19|        #expect(!request.url.absoluteString.contains(\"%3F\"))\n20|        #expect(URLComponents(url: request.url, resolvingAgainstBaseURL: false)?.queryItems?.contains(URLQueryItem(name: \"per_page\", value: \"100\")) == true)\n21|    }\n22|}\n23|\n24|@Test func reviewR2NameOnlyMustNotAuthorizeLabelMutation() async throws {\n25|    let transport = TestTransport([\n26|        runnersListPayload([[\"id\": 77, \"name\": \"macbook-test\", \"labels\": []]]),\n27|        jsonResponse([\"labels\": [[\"name\": \"gpu\"]]])\n28|    ])\n29|    let h = await registrationHarness(transport: transport)\n30|    defer { try? FileManager.default.removeItem(at: h.home) }\n31|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n32|    // No install, no local agent ID, no successful registration; foreign name match only.\n33|    _ = await h.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"]))\n34|    #expect(await transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n35|    #expect(!registrationActions(h.logger).contains { if case .labelsApplied = $0 { true } else { false } })\n36|}\n37|\n38|@Test func reviewR2ChangedScopeMustNotReuseRegistrationOrRemoteID() async throws {\n39|    let package = try await FixturePackage.make(withRealConfigScript: false)\n40|    let executor = SplitExecutor()\n41|    let transport = TestTransport([\n42|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n43|        runnersListPayload([]),\n44|        jsonResponse([\"token\": \"REVIEW-TOKEN\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n45|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n46|        jsonResponse([\"labels\": [[\"name\": \"gpu\"]]])\n47|    ])\n48|    let h = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor)\n49|    defer { try? FileManager.default.removeItem(at: h.home) }\n50|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n51|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n52|    _ = await h.flow.apply(RunnerRegistration.Effect.registerRunner)\n53|    // Actual Container dispatches updateDraft for edits and leaves Apply Labels enabled.\n54|    _ = await h.flow.apply(RunnerRegistration.Effect.updateDraft(repoDraft(dir: \"different-install\")))\n55|    _ = await h.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"]))\n56|    let foreignWrites = await transport.requests.filter { $0.method == \"PUT\" && $0.url.path.contains(\"/repos/octo/app/actions/runners/4242/labels\") }\n57|    #expect(foreignWrites.isEmpty)\n58|}\n59|\n60|@Test func reviewR2MismatchedLocalAgentMustNotBecomeRemoteIdentity() async throws {\n61|    let package = try await FixturePackage.make(withRealConfigScript: false)\n62|    let transport = TestTransport([\n63|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n64|        runnersListPayload([]),\n65|        jsonResponse([\"token\": \"REVIEW-TOKEN\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n66|        runnersListPayload([[\"id\": 77, \"name\": \"macbook-test\", \"labels\": []]]),\n67|        jsonResponse([\"labels\": [[\"name\": \"gpu\"]]])\n68|    ])\n69|    let h = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: SplitExecutor())\n70|    defer { try? FileManager.default.removeItem(at: h.home) }\n71|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n72|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n73|    _ = await h.flow.apply(RunnerRegistration.Effect.registerRunner)\n74|    _ = await h.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"]))\n75|    #expect(await h.installer.readAgentID(directory: h.installRoot.appendingPathComponent(\"macbook-test\")) == 4242)\n76|    #expect(await transport.requests.filter { $0.method == \"PUT\" && $0.url.path.contains(\"/77/labels\") }.isEmpty)\n77|}\n78|\n79|@Test func reviewR2ServiceCannotClaimDoneBeforeRegistration() async throws {\n80|    let package = try await FixturePackage.make(withRealConfigScript: false)\n81|    let transport = TestTransport([downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))])\n82|    let h = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: SplitExecutor())\n83|    defer { try? FileManager.default.removeItem(at: h.home) }\n84|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n85|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n86|    // Wizard exposes this step while connected even when registration was skipped/failed.\n87|    _ = await h.flow.apply(RunnerRegistration.Effect.setupService)\n88|    #expect(!registrationActions(h.logger).contains { if case .serviceReady = $0 { true } else { false } })\n89|    #expect(!FileManager.default.fileExists(atPath: h.installRoot.appendingPathComponent(\"macbook-test/manual-service.plist\").path))\n90|}\n91|\n92|@Test func reviewR2RepositoryConfirmationMustFollowPagination() async throws {\n93|    let transport = TestTransport([\n94|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n95|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n96|        GitHubHTTPResponse(status: 204, body: Data()),\n97|        GitHubHTTPResponse(status: 200, headers: [\"Link\": \"<https://api.github.com/orgs/acme/actions/runner-groups/5/repositories?page=2>; rel=\\\"next\\\"\"], body: try JSONSerialization.data(withJSONObject: [\"total_count\": 2, \"repositories\": [[\"id\": 9]]])),\n98|        jsonResponse([\"total_count\": 2, \"repositories\": [[\"id\": 10]]])\n99|    ])\n100|    let h = await registrationHarness(transport: transport)\n101|    defer { try? FileManager.default.removeItem(at: h.home) }\n102|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n103|    _ = await h.flow.apply(RunnerRegistration.Effect.resolveGroup)\n104|    _ = await h.flow.apply(RunnerRegistration.Effect.applyRepositoryAccess(groupID: 5, repositories: [9,10]))\n105|    let confirmed = registrationActions(h.logger).compactMap { a -> [Int64]? in\n106|        if case .repositoryAccessApplied(let ids) = a { ids } else { nil }\n107|    }\n108|    #expect(confirmed.last.map(Set.init) == Set<Int64>([9,10]))\n109|    #expect(await transport.requests.contains { $0.url.query?.contains(\"page=2\") == true })\n110|}","final_result":true}}}
