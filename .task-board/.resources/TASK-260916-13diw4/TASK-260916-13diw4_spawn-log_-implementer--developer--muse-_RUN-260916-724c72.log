ation.Action.draftUpdated(draft) }\n131|    }\n132|\n133|    // MARK: - Auth\n134|\n135|    private func currentUserToken(generation gen: Int) async throws -> FlowUserToken {\n136|        guard let identity = await identities.load() else {\n137|            throw RunnerRegistration.RegistrationError.notAuthenticated\n138|        }\n139|        let config = try configProvider(identity.serverHost)\n140|        guard var record = await userStore.load(\n141|            serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID\n142|        ) else {\n143|            throw RunnerRegistration.RegistrationError.notAuthenticated\n144|        }\n145|        guard !isStale(gen) else { throw CancellationError() }\n146|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n147|            do {\n148|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n149|            } catch is CancellationError {\n150|                throw CancellationError()\n151|            } catch let error as GitHubAuth.AuthError {\n152|                switch error {\n153|                case .revoked, .unauthorized, .tokenRefreshFailed:\n154|                    throw RunnerRegistration.RegistrationError.unauthorized\n155|                default:\n156|                    break\n157|                }\n158|            }\n159|            guard !isStale(gen) else { throw CancellationError() }\n160|        }\n161|        return FlowUserToken(config: config, token: record.accessToken, identity: identity)\n162|    }\n163|\n164|    private func fail(_ error: Error, step: String, generation gen: Int) async {\n165|        guard !isStale(gen) else { return }\n166|        failedStep = step\n167|        if error is CancellationError { return }\n168|        if let reg = error as? RunnerRegistration.RegistrationError {\n169|            switch reg {\n170|            case .missingPermission, .forbidden:\n171|                await action {\n172|                    RunnerRegistration.Action.permissionDenied(message: reg.localizedDescription, step: step)\n173|                }\n174|                return\n175|            default:\n176|                break\n177|            }\n178|        }\n179|        let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n180|        await action { RunnerRegistration.Action.failed(message: message, step: step) }\n181|    }\n182|\n183|    private func finishStep(_ step: String, generation gen: Int) async {\n184|        guard !isStale(gen) else { return }\n185|        failedStep = nil\n186|        working = false\n187|        await action { RunnerRegistration.Action.stepFinished(step) }\n188|    }\n189|\n190|    // MARK: - Group\n191|\n192|    private func resolveGroup() async {\n193|        let gen = generation\n194|        guard !working else { return }\n195|        guard let draft else {\n196|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"resolveGroup\") }\n197|            return\n198|        }\n199|        do {\n200|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n201|        } catch {\n202|            failedStep = \"resolveGroup\"\n203|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"resolveGroup\") }\n204|            return\n205|        }\n206|        guard case .organization(let org) = draft.scope else { return }\n207|        working = true\n208|        await action { RunnerRegistration.Action.stepStarted(\"resolveGroup\") }\n209|        do {\n210|            let auth = try await currentUserToken(generation: gen)\n211|            guard !isStale(gen) else { return }\n212|            let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n213|            guard !isStale(gen) else { return }\n214|            let name = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n215|            let resolved: RunnerRegistration.RunnerGroup\n216|            if let existing = groups.first(where: { $0.name == name }) {\n217|                // Name alone never authorizes adoption: require a locally\n218|                // recorded ownership entry or explicit takeover confirmation.\n219|                let owned = await installer.loadOwnedGroupID(org: org, name: name)\n220|                try RunnerRegistration.Gates.authorizeGroupTakeover(\n221|                    groupName: name, existingID: existing.id,\n222|                    ownedID: owned, allowTakeover: draft.allowGroupTakeover\n223|                )\n224|                if owned != existing.id {\n225|                    try await installer.saveOwnedGroupID(org: org, name: name, groupID: existing.id)\n226|                }\n227|                guard !isStale(gen) else { return }\n228|                // A pre-existing group may deny public repos (GitHub default\n229|                // false), which would silently drop selected public repos.\n230|                if existing.allowsPublicRepositories {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
