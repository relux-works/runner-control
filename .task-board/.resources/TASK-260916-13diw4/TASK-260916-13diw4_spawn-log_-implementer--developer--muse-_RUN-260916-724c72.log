{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c759","stream":{"kind":"session","id":"01a0a895-af1e-7030-b7a0-b39b63843e96"},"sequence":519,"recorded_at":1780531400001033,"record_type":"event","durability":"durable","causation_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","run_stream":{"kind":"run","id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332"},"task_stream":{"kind":"task","id":"01a0a896-f1f2-7f71-a788-d285179ab569"},"task_id":"01a0a896-f1f2-7f71-a788-d285179ab569","event":{"kind":"output","task_id":"01a0a896-f1f2-7f71-a788-d285179ab569","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Module.swift`.\n1|import Relux\n2|\n3|extension RunnerRegistration {\n4|    @MainActor public struct Module: Relux.Module {\n5|        nonisolated public var states: [any Relux.AnyState] { [state] }\n6|        nonisolated public var sagas: [any Relux.Saga] { [flow] }\n7|        public let state: State\n8|        public let flow: Flow\n9|        public init(state: State, flow: Flow) { self.state = state; self.flow = flow }\n10|    }\n11|}","final_result":true}}}
