as? [String] == [directory.appendingPathComponent(\"runsvc.sh\").path])\n793|    #expect(object?[\"WorkingDirectory\"] as? String == directory.path)\n794|    #expect(object?[\"RunAtLoad\"] as? Bool == false)\n795|    // The wizard output must be visible to production discovery.\n796|    let found = RunnerDiscovery.installed(home: harness.home)\n797|    #expect(found.count == 1)\n798|    #expect(found.first?.title == \"macbook-test\")\n799|    #expect(found.first?.detail == \"acme\")\n800|}\n801|\n802|// MARK: - Recovery and token lifetime\n803|\n804|@Test func recoverPartialInstallRefusesWorkingRunner() async throws {\n805|    let harness = await registrationHarness(transport: TestTransport([]))\n806|    let draft = orgDraft()\n807|    let occupied = await harness.installer.directory(for: draft.installDirName)\n808|    try FileManager.default.createDirectory(at: occupied, withIntermediateDirectories: true)\n809|    try Data(\"{}\".utf8).write(to: occupied.appendingPathComponent(\".runner\"))\n810|    do {\n811|        try await harness.installer.recoverPartialInstall(directory: occupied, scopeKey: draft.scope.scopeKey)\n812|        Issue.record(\"recovery deleted a registered runner\")\n813|    } catch let error as RunnerRegistration.RegistrationError {\n814|        guard case .alreadyRegistered = error else { Issue.record(\"wrong error: \\(error)\"); return }\n815|    }\n816|    #expect(FileManager.default.fileExists(atPath: occupied.path))\n817|    let partial = harness.installRoot.appendingPathComponent(\"partial-dir\")\n818|    try FileManager.default.createDirectory(at: partial, withIntermediateDirectories: true)\n819|    try await harness.installer.recoverPartialInstall(directory: partial, scopeKey: draft.scope.scopeKey)\n820|    #expect(FileManager.default.fileExists(atPath: partial.path) == false)\n821|}\n822|\n823|@Test func registrationTokenStoreExpiresShortLivedToken() async throws {\n824|    let store = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n825|    let live = RunnerRegistration.ScopedToken(token: \"live\", expiresAt: Date().addingTimeInterval(60))\n826|    try await store.save(live, scopeKey: \"org:acme:dir\")\n827|    #expect(await store.load(scopeKey: \"org:acme:dir\") == live)\n828|    let dead = RunnerRegistration.ScopedToken(token: \"dead\", expiresAt: Date().addingTimeInterval(-5))\n829|    try await store.save(dead, scopeKey: \"org:acme:other\")\n830|    #expect(await store.load(scopeKey: \"org:acme:other\") == nil)\n831|    await store.delete(scopeKey: \"org:acme:dir\")\n832|    #expect(await store.load(scopeKey: \"org:acme:dir\") == nil)\n833|}\n834|\n835|// MARK: - End-to-end wizard through production Flow effects\n836|\n837|private func runnersListPayload(_ runners: [[String: Any]]) -> GitHubHTTPResponse {\n838|    jsonResponse([\"runners\": runners])\n839|}\n840|\n841|@Test func orgWizardEndToEndDeletesTokenAndLeaksNothing() async throws {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c99f","stream":{"kind":"session","id":"01a0a895-af1e-7030-b7a0-b39b63843e96"},"sequence":810,"recorded_at":1780531400001615,"record_type":"event","durability":"durable","causation_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","run_stream":{"kind":"run","id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332"},"call_id":"call_01a0a899341b7461b01de818491d52f2","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(385 line(s) above)\n386|private func downloadAssets(checksum: String) -> [[String: Any]] {\n387|    [\n388|        [\"os\": \"linux\", \"architecture\": \"x64\", \"download_url\": \"https://example.com/linux.tar.gz\", \"filename\": \"linux.tar.gz\"],\n389|        [\"os\": \"osx\", \"architecture\": \"x64\", \"download_url\": \"https://example.com/osx-x64.tar.gz\", \"filename\": \"osx-x64.tar.gz\", \"sha256_checksum\": \"x64sum\"],\n390|        [\"os\": \"osx\", \"architecture\": \"arm64\", \"download_url\": \"https://example.com/osx-arm64.tar.gz\", \"filename\": \"osx-arm64.tar.gz\", \"sha256_checksum\": checksum],\n391|    ]\n392|}\n393|\n394|@Test func prepareDownloadSelectsArchMatchedAsset() async {\n395|    let transport = TestTransport([downloadsArrayPayload(downloadAssets(checksum: \"arm64sum\"))])\n396|    let harness = await registrationHarness(transport: transport)\n397|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n398|    _ = await harness.flow.apply(RunnerRegistration.Effect.prepareDownload)\n399|    let ready = registrationActions(harness.logger).compactMap { action -> RunnerRegistration.DownloadAsset? in\n400|        if case .downloadReady(let asset) = action { asset } else { nil }\n401|    }\n402|    #expect(ready.count == 1)\n403|    #expect(ready.first?.architecture == \"arm64\")\n404|    #expect(ready.first?.osName == \"osx\")\n405|    let requests = await transport.requests\n406|    #expect(requests.count == 1)\n407|    #expect(requests.first?.url.path.hasSuffix(\"/orgs/acme/actions/runners/downloads\") ?? false)\n408|    #expect(requests.first?.headers[\"Authorization\"] == \"Bearer [REDACTED]\")\n409|}\n410|\n411|@Test func prepareDownloadRefusesSubstituteArch() async {\n412|    let assets = [\n413|        [\"os\": \"osx\", \"architecture\": \"x64\", \"download_url\": \"https://example.com/osx-x64.tar.gz\", \"filename\": \"osx-x64.tar.gz\", \"sha256_checksum\": \"x64sum\"],\n414|        [\"os\": \"linux\", \"architecture\": \"arm64\", \"download_url\": \"https://example.com/linux.tar.gz\", \"filename\": \"linux.tar.gz\"],\n415|    ]\n416|    let transport = TestTransport([downloadsArrayPayload(assets)])\n417|    let harness = await registrationHarness(transport: transport, arch: \"arm64\")\n418|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n419|    _ = await harness.flow.apply(RunnerRegistration.Effect.prepareDownload)\n420|    let failure = lastFailure(harness.logger)\n421|    #expect(failure?.step == \"prepareDownload\")\n422|    #expect((failure?.message.contains(\"arm64\") ?? false))\n423|    #expect(FileManager.default.fileExists(atPath: harness.installRoot.appendingPathComponent(\"macbook-test\").path) == false)\n424|}\n425|\n426|// MARK: - Groups (dedicated per-Mac, explicit scope)\n427|\n428|@Test func orgResolveGroupFindsExistingWithoutCreating() async {\n429|    let transport = TestTransport([\n430|        groupsListPayload([\n431|            groupPayload(id: 1, name: \"Default\", visibility: \"all\", allowsPublic: true),\n432|            groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true),\n433|        ]),\n434|        jsonResponse([\"repositories\": [[\"id\": 9], [\"id\": 10]]]),\n435|    ])\n436|    let harness = await registrationHarness(transport: transport)\n437|    // Explicit takeover: this Mac adopts the pre-existing same-name group.\n438|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n439|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n440|    let resolved = registrationActions(harness.logger).compactMap { action -> (RunnerRegistration.RunnerGroup, [Int64])? in\n441|        if case .groupResolved(let group, let ids) = action { (group, ids) } else { nil }\n442|    }\n443|    #expect(resolved.count == 1)\n444|    #expect(resolved.first?.0.id == 5)\n445|    #expect(resolved.first?.0.allowsPublicRepositories == true)\n446|    #expect(resolved.first?.1.sorted() == [9, 10])\n447|    let requests = await transport.requests\n448|    #expect(requests.filter { $0.method == \"POST\" }.isEmpty)\n449|}\n450|\n451|@Test func orgResolveGroupCreatesWithSelectedRepos() async throws {\n452|    let transport = TestTransport([\n453|        groupsListPayload([groupPayload(id: 1, name: \"Default\", visibility: \"all\", allowsPublic: true)]),\n454|        jsonResponse(groupPayload(id: 7, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true), status: 201),\n455|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n456|    ])\n457|    let harness = await registrationHarness(transport: transport)\n458|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n459|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n460|    let requests = await transport.requests\n461|    let posts = requests.filter { $0.method == \"POST\" }\n462|    #expect(posts.count == 1)\n463|    let body = try JSONDecoder().decode([String: JSONAny].self, from: posts[0].body ?? Data())\n464|    #expect(body[\"name\"]?.string == \"RunnerControl-Mac\")\n465|    #expect(body[\"visibility\"]?.string == \"selected\")\n466|    #expect(body[\"selected_repository_ids\"]?.ints?.sorted() == [9])\n467|    // Dedicated groups opt into public repos so selected PUBLIC repos work.\n468|    #expect(body[\"allows_public_repositories\"]?.bool == true)\n469|    // Creation records ownership for later resolves on this Mac.\n470|    #expect(await harness.installer.loadOwnedGroupID(org: \"acme\", name: \"RunnerControl-Mac\") == 7)\n471|}\n472|\n473|/// Minimal JSON reader for asserting request bodies without DTO coupling.\n474|private enum JSONAny: Decodable {\n475|    case string(String)\n476|    case ints([Int64])\n477|    case bool(Bool)\n478|    case other\n479|    var string: String? { if case .string(let value) = self { value } else { nil } }\n480|    var ints: [Int64]? { if case .ints(let values) = self { values } else { nil } }\n481|    var bool: Bool? { if case .bool(let value) = self { value } else { nil } }\n482|    init(from decoder: Decoder) throws {\n483|        let container = try decoder.singleValueContainer()\n484|        if let value = try? container.decode(Bool.self) { self = .bool(value); return }\n485|        if let value = try? container.decode(String.self) { self = .string(value); return }\n486|        if let values = try? container.decode([Int64].self) { self = .ints(values); return }\n487|        self = .other\n488|    }\n489|}\n490|\n491|@Test func repoScopeRefusesGroupResolution() async {\n492|    let transport = TestTransport([])\n493|    let harness = await registrationHarness(transport: transport)\n494|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(repoDraft()))\n495|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n496|    let failure = lastFailure(harness.logger)\n497|    #expect(failure?.step == \"resolveGroup\")\n498|    #expect((failure?.message.contains(\"organization\") ?? false))\n499|    #expect(await transport.requests.isEmpty)\n500|}\n501|\n502|private func harnessWithResolvedGroup(allow: Bool) async -> RegistrationHarness {\n503|    let transport = TestTransport([\n504|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n505|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n506|    ])\n507|    let harness = await registrationHarness(transport: transport)\n508|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowGroup: allow, allowTakeover: true)))\n509|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n510|    return harness\n511|}\n512|\n513|@Test func repoAccessWithoutExplicitScopeIsRefused() async {\n514|    let harness = await harnessWithResolvedGroup(allow: false)\n515|    let before = await harness.transport.requests.count\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
