rd let draft else {\n525|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyLabels\") }\n526|            return\n527|        }\n528|        let trimmed = labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }\n529|        guard !trimmed.isEmpty else {\n530|            failedStep = \"applyLabels\"\n531|            await action {\n532|                RunnerRegistration.Action.failed(message: \"At least one label is required.\", step: \"applyLabels\")\n533|            }\n534|            return\n535|        }\n536|        working = true\n537|        pendingLabels = trimmed\n538|        await action { RunnerRegistration.Action.stepStarted(\"applyLabels\") }\n539|        do {\n540|            let resolved: Int64?\n541|            if let runnerID {\n542|                resolved = runnerID\n543|            } else {\n544|                resolved = try await resolveRemoteRunnerID(draft: draft, generation: gen)\n545|                guard !isStale(gen) else { return }\n546|            }\n547|            guard let runnerID = resolved else {\n548|                failedStep = \"applyLabels\"\n549|                working = false\n550|                await action {\n551|                    RunnerRegistration.Action.failed(\n552|                        message: \"Register the runner first so labels have a real runner ID.\",\n553|                        step: \"applyLabels\"\n554|                    )\n555|                }\n556|                return\n557|            }\n558|            let auth = try await currentUserToken(generation: gen)\n559|            guard !isStale(gen) else { return }\n560|            try await api.setRunnerLabels(\n561|                config: auth.config, token: auth.token, scope: draft.scope, runnerID: runnerID, labels: trimmed\n562|            )\n563|            guard !isStale(gen) else { return }\n564|            self.runnerID = runnerID\n565|            if var current = self.draft {\n566|                current.labels = trimmed\n567|                self.draft = current\n568|            }\n569|            await action { RunnerRegistration.Action.labelsApplied(trimmed) }\n570|            pendingLabels = nil\n571|            await finishStep(\"applyLabels\", generation: gen)\n572|        } catch {\n573|            working = false\n574|            await fail(error, step: \"applyLabels\", generation: gen)\n575|        }\n576|    }\n577|\n578|    // MARK: - Retry / cancel / reset\n579|\n580|    private func retry() async {\n581|        guard !working else { return }\n582|        guard let step = failedStep else { return }\n583|        switch step {\n584|        case \"resolveGroup\": await resolveGroup()\n585|        case \"prepareDownload\": await prepareDownload()\n586|        case \"downloadAndInstall\": await downloadAndInstall()\n587|        case \"registerRunner\": await registerRunner()\n588|        case \"setupService\": await setupService()\n589|        case \"applyRepositoryAccess\":\n590|            if let ids = pendingRepositoryIDs, let target = pendingTargetGroupID {\n591|                await applyRepositoryAccess(groupID: target, ids: ids)\n592|            }\n593|        case \"applyLabels\":\n594|            if let labels = pendingLabels { await applyLabels(labels) }\n595|        default:\n596|            return\n597|        }\n598|    }\n599|\n600|    private func cancel() async {\n601|        generation += 1\n602|        working = false\n603|        if let draft {\n604|            await registrationTokens.delete(scopeKey: Self.tokenScopeKey(draft: draft))\n605|        }\n606|        failedStep = nil\n607|        pendingRepositoryIDs = nil\n608|        pendingTargetGroupID = nil\n609|        pendingLabels = nil\n610|        await action { RunnerRegistration.Action.cancelled }\n611|    }\n612|\n613|    private func reset() async {\n614|        generation += 1\n615|        working = false\n616|        if let draft {\n617|            await registrationTokens.delete(scopeKey: Self.tokenScopeKey(draft: draft))\n618|        }\n619|        draft = nil\n620|        group = nil\n621|        asset = nil\n622|        installPath = nil\n623|        runnerID = nil\n624|        failedStep = nil\n625|        pendingRepositoryIDs = nil\n626|        pendingTargetGroupID = nil\n627|        pendingLabels = nil\n628|        await action { RunnerRegistration.Action.didReset }\n629|    }\n630|}","final_result":true}}}
