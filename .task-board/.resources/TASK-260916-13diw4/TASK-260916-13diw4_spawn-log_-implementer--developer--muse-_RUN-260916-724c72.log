{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c999","stream":{"kind":"session","id":"01a0a895-af1e-7030-b7a0-b39b63843e96"},"sequence":807,"recorded_at":1780531400001609,"record_type":"event","durability":"durable","causation_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","run_stream":{"kind":"run","id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332"},"task_stream":{"kind":"task","id":"01a0a899-39e2-76c3-ac23-81ac799cb376"},"task_id":"01a0a899-39e2-76c3-ac23-81ac799cb376","event":{"kind":"output","task_id":"01a0a899-39e2-76c3-ac23-81ac799cb376","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(771 line(s) above)\n772|@Test func setupServiceWritesManualPlistFoundByDiscovery() async throws {\n773|    let package = try await FixturePackage.make()\n774|    let harness = await registrationHarness(\n775|        transport: TestTransport([]), downloader: fixtureDownloader(package.bytes)\n776|    )\n777|    let draft = orgDraft()\n778|    let asset = RunnerRegistration.DownloadAsset(\n779|        osName: \"osx\", architecture: \"arm64\",\n780|        downloadURL: URL(string: \"https://example.com/x.tar.gz\")!,\n781|        filename: \"x.tar.gz\", sha256Checksum: package.sha256ViaSystem\n782|    )\n783|    let directory = try await harness.installer.downloadAndInstall(asset: asset, draft: draft)\n784|    try Data(\"\"\"\n785|    {\"agentId\":4242,\"agentName\":\"macbook-test\",\"gitHubUrl\":\"https://github.com/acme\",\"workFolder\":\"_work\"}\n786|    \"\"\".utf8).write(to: directory.appendingPathComponent(\".runner\"))\n787|    let label = RunnerRegistration.Flow.serviceLabel(draft: draft)\n788|    let plist = try await harness.installer.setupService(directory: directory, label: label)\n789|    let data = try Data(contentsOf: plist)\n790|    let object = try PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any]\n791|    #expect(object?[\"Label\"] as? String == label)\n792|    #expect(object?[\"ProgramArguments\"] as? [String] == [directory.appendingPathComponent(\"runsvc.sh\").path])\n793|    #expect(object?[\"WorkingDirectory\"] as? String == directory.path)\n794|    #expect(object?[\"RunAtLoad\"] as? Bool == false)\n795|    // The wizard output must be visible to production discovery.\n796|    let found = RunnerDiscovery.installed(home: harness.home)\n797|    #expect(found.count == 1)\n798|    #expect(found.first?.title == \"macbook-test\")\n799|    #expect(found.first?.detail == \"acme\")\n800|}\n801|\n802|// MARK: - Recovery and token lifetime\n803|\n804|@Test func recoverPartialInstallRefusesWorkingRunner() async throws {\n805|    let harness = await registrationHarness(transport: TestTransport([]))\n806|    let draft = orgDraft()\n807|    let occupied = await harness.installer.directory(for: draft.installDirName)\n808|    try FileManager.default.createDirectory(at: occupied, withIntermediateDirectories: true)\n809|    try Data(\"{}\".utf8).write(to: occupied.appendingPathComponent(\".runner\"))\n810|    do {\n811|        try await harness.installer.recoverPartialInstall(directory: occupied, scopeKey: draft.scope.scopeKey)\n812|        Issue.record(\"recovery deleted a registered runner\")\n813|    } catch let error as RunnerRegistration.RegistrationError {\n814|        guard case .alreadyRegistered = error else { Issue.record(\"wrong error: \\(error)\"); return }\n815|    }\n816|    #expect(FileManager.default.fileExists(atPath: occupied.path))\n817|    let partial = harness.installRoot.appendingPathComponent(\"partial-dir\")\n818|    try FileManager.default.createDirectory(at: partial, withIntermediateDirectories: true)\n819|    try await harness.installer.recoverPartialInstall(directory: partial, scopeKey: draft.scope.scopeKey)\n820|    #expect(FileManager.default.fileExists(atPath: partial.path) == false)\n821|}\n822|\n823|@Test func registrationTokenStoreExpiresShortLivedToken() async throws {\n824|    let store = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n825|    let live = RunnerRegistration.ScopedToken(token: \"live\", expiresAt: Date().addingTimeInterval(60))\n826|    try await store.save(live, scopeKey: \"org:acme:dir\")\n827|    #expect(await store.load(scopeKey: \"org:acme:dir\") == live)\n828|    let dead = RunnerRegistration.ScopedToken(token: \"dead\", expiresAt: Date().addingTimeInterval(-5))\n829|    try await store.save(dead, scopeKey: \"org:acme:other\")\n830|    #expect(await store.load(scopeKey: \"org:acme:other\") == nil)\n831|    await store.delete(scopeKey: \"org:acme:dir\")\n832|    #expect(await store.load(scopeKey: \"org:acme:dir\") == nil)\n833|}\n834|\n835|// MARK: - End-to-end wizard through production Flow effects\n836|\n837|private func runnersListPayload(_ runners: [[String: Any]]) -> GitHubHTTPResponse {\n838|    jsonResponse([\"runners\": runners])\n839|}\n840|\n841|@Test func orgWizardEndToEndDeletesTokenAndLeaksNothing() async throws {\n(more lines below)","final_result":true}}}
