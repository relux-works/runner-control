{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c473","stream":{"kind":"session","id":"01a0a895-af1e-7030-b7a0-b39b63843e96"},"sequence":148,"recorded_at":1780531400000291,"record_type":"event","durability":"durable","causation_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","run_stream":{"kind":"run","id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332"},"call_id":"call_01a0a895f3f67132bb8fa5a19dd7b25c","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Models.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Registration scope. One wizard run registers exactly one scope:\n5|    /// an organization (shared, via a dedicated per-Mac group) or a single\n6|    /// personal repository (separate installation, no group).\n7|    public enum Scope: Sendable, Equatable, Hashable {\n8|        case organization(org: String)\n9|        case repository(owner: String, name: String)\n10|\n11|        /// REST path prefix below the API base URL, e.g. `orgs/acme` or `repos/acme/app`.\n12|        public var apiPrefix: String {\n13|            switch self {\n14|            case .organization(let org): \"orgs/\\(org)\"\n15|            case .repository(let owner, let name): \"repos/\\(owner)/\\(name)\"\n16|            }\n17|        }\n18|\n19|        /// Short key for token-store accounts and markers. Never contains secrets.\n20|        public var scopeKey: String {\n21|            switch self {\n22|            case .organization(let org): \"org:\\(org)\"\n23|            case .repository(let owner, let name): \"repo:\\(owner)/\\(name)\"\n24|            }\n25|        }\n26|\n27|        /// URL passed to `config.sh --url`. Enterprise hosts keep their own server.\n28|        public func configURL(serverHost: String) -> String {\n29|            let host = serverHost == \"github.com\" || serverHost == \"www.github.com\"\n30|                ? \"https://github.com\"\n31|                : \"https://\\(serverHost)\"\n32|            switch self {\n33|            case .organization(let org): return \"\\(host)/\\(org)\"\n34|            case .repository(let owner, let name): return \"\\(host)/\\(owner)/\\(name)\"\n35|            }\n36|        }\n37|\n38|        /// Detail line shown in UI, e.g. `acme` or `acme/app`.\n39|        public var detail: String {\n40|            switch self {\n41|            case .organization(let org): org\n42|            case .repository(let owner, let name): \"\\(owner)/\\(name)\"\n43|            }\n44|        }\n45|    }\n46|\n47|    /// User-editable wizard input. Holds no tokens.\n48|    public struct Draft: Sendable, Equatable {\n49|        public var scope: Scope\n50|        public var runnerName: String\n51|        public var labels: [String]\n52|        public var installDirName: String\n53|        public var workFolder: String\n54|        /// Dedicated per-Mac group name for org scope. Ignored for repo scope.\n55|        public var groupName: String\n56|        public var selectedRepositoryIDs: Set<Int64>\n57|        /// Explicit UI scope: user confirmed that group mutations apply only\n58|        /// to the resolved dedicated group. Never implied.\n59|        public var allowGroupMutation: Bool\n60|        /// Explicit takeover: user confirmed that a pre-existing group with\n61|        /// the same name is this Mac's dedicated group. Name alone never\n62|        /// authorizes adopting or editing a shared group.\n63|        public var allowGroupTakeover: Bool\n64|        /// Explicit replace: user confirmed that config may replace an\n65|        /// existing GitHub registration with the same runner name. Without\n66|        /// it the wizard refuses remote duplicates instead of silently\n67|        /// stealing another machine's registration via `--replace`.\n68|        public var allowReplace: Bool\n69|\n70|        public init(\n71|            scope: Scope,\n72|            runnerName: String,\n73|            labels: [String] = [\"self-hosted\", \"macOS\"],\n74|            installDirName: String,\n75|            workFolder: String = \"_work\",\n76|            groupName: String = \"\",\n77|            selectedRepositoryIDs: Set<Int64> = [],\n78|            allowGroupMutation: Bool = false,\n79|            allowGroupTakeover: Bool = false,\n80|            allowReplace: Bool = false\n81|        ) {\n82|            self.scope = scope\n83|            self.runnerName = runnerName\n84|            self.labels = labels\n85|            self.installDirName = installDirName\n86|            self.workFolder = workFolder\n87|            self.groupName = groupName\n88|            self.selectedRepositoryIDs = selectedRepositoryIDs\n89|            self.allowGroupMutation = allowGroupMutation\n90|            self.allowGroupTakeover = allowGroupTakeover\n91|            self.allowReplace = allowReplace\n92|        }\n93|\n94|        /// Default per-Mac group name derived from the Mac name.\n95|        public static func defaultGroupName(hostName: String) -> String {\n96|            let trimmed = hostName.trimmingCharacters(in: .whitespacesAndNewlines)\n97|            let base = trimmed.isEmpty ? \"Mac\" : trimmed\n98|            return \"RunnerControl-\\(base)\"\n99|        }\n100|    }\n101|\n102|    /// Official runner download asset as returned by the downloads endpoint.\n103|    public struct DownloadAsset: Sendable, Equatable {\n104|        public let osName: String\n105|        public let architecture: String\n106|        public let downloadURL: URL\n107|        public let filename: String\n108|        public let sha256Checksum: String?\n109|        public init(osName: String, architecture: String, downloadURL: URL, filename: String, sha256Checksum: String?) {\n110|            self.osName = osName; self.architecture = architecture\n111|            self.downloadURL = downloadURL; self.filename = filename\n112|            self.sha256Checksum = sha256Checksum\n113|        }\n114|    }\n115|\n116|    /// Runner group summary. Repository access is fetched separately.\n117|    /// `allowsPublicRepositories` mirrors GitHub's `allows_public_repositories`\n118|    /// flag: without it a `selected`-visibility group silently denies every\n119|    /// selected public repository.\n120|    public struct RunnerGroup: Sendable, Equatable {\n121|        public let id: Int64\n122|        public let name: String\n123|        public let visibility: String\n124|        public let allowsPublicRepositories: Bool\n125|        public init(id: Int64, name: String, visibility: String, allowsPublicRepositories: Bool = false) {\n126|            self.id = id; self.name = name; self.visibility = visibility\n127|            self.allowsPublicRepositories = allowsPublicRepositories\n128|        }\n129|    }\n130|\n131|    /// Registered runner identity fetched from GitHub after config.\n132|    public struct RegisteredRunner: Sendable, Equatable {\n133|        public let id: Int64\n134|        public let name: String\n135|        public let labels: [String]\n136|        public init(id: Int64, name: String, labels: [String]) {\n137|            self.id = id; self.name = name; self.labels = labels\n138|        }\n139|    }\n140|}\n141|\n142|extension RunnerRegistration {\n143|    public enum RegistrationError: LocalizedError, Sendable, Equatable {\n144|        case notAuthenticated\n145|        case missingPermission(String)\n146|        case invalidDraft(String)\n147|        case noSpacePath(String)\n148|        case downloadMismatch(osName: String, arch: String)\n149|        case integrityMismatch\n150|        case groupScopeNotConfirmed\n151|        case refusesSharedGroup(groupID: Int64)\n152|        case groupNameTaken(name: String, groupID: Int64)\n153|        case groupNotApplicable\n154|        case alreadyInstalled(path: String)\n155|        case alreadyRegistered(name: String)\n156|        case remoteNameTaken(name: String)\n157|        case network(String)\n158|        case unauthorized\n159|        case forbidden(String)\n160|        case rateLimited\n161|        case configFailed(String)\n162|        case cancelled\n163|\n164|        public var errorDescription: String? {\n165|            switch self {\n166|            case .notAuthenticated:\n167|                \"Sign in with GitHub first. Registration needs an authenticated session.\"\n168|            case .missingPermission(let text):\n169|                text.isEmpty ? \"Missing GitHub permission for this step.\" : text\n170|            case .invalidDraft(let text):\n171|                text\n172|            case .noSpacePath(let text):\n173|                text\n174|            case .downloadMismatch(let osName, let arch):\n175|                \"No official runner package for os=\\(osName) arch=\\(arch). Refusing substitute builds.\"\n176|            case .integrityMismatch:\n177|                \"Download integrity check failed (SHA-256 mismatch). Refusing to install.\"\n178|            case .groupScopeNotConfirmed:\n179|                \"Repository access changes need explicit confirmation for the dedicated group.\"\n180|            case .refusesSharedGroup(let groupID):\n181|                \"Refusing to change group \\(groupID): it is not this Mac's dedicated group.\"\n182|            case .groupNameTaken(let name, let groupID):\n183|                \"Group '\\(name)' already exists (id \\(groupID)) and is not this Mac's dedicated group. Choose a different name or explicitly confirm takeover.\"\n184|            case .groupNotApplicable:\n185|                \"Runner groups apply to organization runners only. Repository runners use separate installations.\"\n186|            case .alreadyInstalled(let path):\n187|                \"Installation already exists at \\(path). Resume or remove it before retrying.\"\n188|            case .alreadyRegistered(let name):\n189|                \"Runner '\\(name)' is already registered here. Reuse it instead of creating a duplicate.\"\n190|            case .remoteNameTaken(let name):\n191|                \"Runner '\\(name)' already exists in GitHub. Choose a different name or explicitly allow replace; refusing to silently replace another registration.\"\n192|            case .network(let text):\n193|                text\n194|            case .unauthorized:\n195|                \"Session expired or revoked (401). Sign in again.\"\n196|            case .forbidden(let text):\n197|                text.isEmpty ? \"Access forbidden (403).\" : text\n198|            case .rateLimited:\n199|                \"GitHub rate limit reached. Retry later; local runners keep working.\"\n200|            case .configFailed(let text):\n201|                text.isEmpty ? \"Runner configuration failed.\" : text\n202|            case .cancelled:\n203|                \"Registration cancelled.\"\n204|            }\n205|        }\n206|    }\n207|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
