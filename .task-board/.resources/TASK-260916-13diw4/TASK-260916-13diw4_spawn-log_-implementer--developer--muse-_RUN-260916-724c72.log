lveRemoteRunnerID(draft: draft, generation: gen)\n421|                guard !isStale(gen) else { return }\n422|                runnerID = remoteID\n423|                await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: localID) }\n424|                await finishStep(\"registerRunner\", generation: gen)\n425|                return\n426|            }\n427|            let auth = try await currentUserToken(generation: gen)\n428|            guard !isStale(gen) else { return }\n429|            // Duplicate guard before any token is minted: without explicit\n430|            // replace consent a remote name match refuses the run so config\n431|            // can never silently replace another machine's registration.\n432|            // Bound: the runners list is first-page only (per_page=100); a\n433|            // duplicate beyond it still fails at config.sh, which omits\n434|            // `--replace` unless the user explicitly allowed it.\n435|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n436|            let existing = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n437|            guard !isStale(gen) else { return }\n438|            try RunnerRegistration.Gates.rejectRemoteDuplicate(\n439|                name: wanted, isTaken: existing.contains(where: { $0.name == wanted }),\n440|                allowReplace: draft.allowReplace\n441|            )\n442|            guard !isStale(gen) else { return }\n443|            let created = try await api.createRegistrationToken(\n444|                config: auth.config, token: auth.token, scope: draft.scope\n445|            )\n446|            guard !isStale(gen) else { return }\n447|            let scoped = RunnerRegistration.ScopedToken(\n448|                token: created.token, expiresAt: created.expiresAt, obtainedAt: now()\n449|            )\n450|            try await registrationTokens.save(scoped, scopeKey: scopeKey)\n451|            guard !isStale(gen) else { return }\n452|            let groupName: String?\n453|            switch draft.scope {\n454|            case .organization: groupName = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n455|            case .repository: groupName = nil\n456|            }\n457|            let localID: Int64?\n458|            do {\n459|                localID = try await installer.runConfig(\n460|                    directory: directory,\n461|                    scopeURL: draft.scope.configURL(serverHost: auth.identity.serverHost),\n462|                    token: created.token,\n463|                    draft: draft,\n464|                    runnerGroup: groupName\n465|                )\n466|            } catch {\n467|                await registrationTokens.delete(scopeKey: scopeKey)\n468|                throw error\n469|            }\n470|            // The single-use token is consumed by config.sh: delete it before\n471|            // any follow-up API call so a post-config failure (review F6)\n472|            // reports the error without retaining the token.\n473|            await registrationTokens.delete(scopeKey: scopeKey)\n474|            guard !isStale(gen) else { return }\n475|            let remoteID = try await resolveRemoteRunnerID(draft: draft, generation: gen)\n476|            guard !isStale(gen) else { return }\n477|            runnerID = remoteID\n478|            await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: localID) }\n479|            guard !isStale(gen) else { return }\n480|            await action { RunnerRegistration.Action.permissionDismissed }\n481|            await finishStep(\"registerRunner\", generation: gen)\n482|        } catch {\n483|            working = false\n484|            await fail(error, step: \"registerRunner\", generation: gen)\n485|        }\n486|    }\n487|\n488|    /// Fetches the real GitHub runner ID by matching the registered name.\n489|    /// Returns nil when the runner list does not (yet) contain it.\n490|    private func resolveRemoteRunnerID(draft: RunnerRegistration.Draft, generation gen: Int) async throws -> Int64? {\n491|        let auth = try await currentUserToken(generation: gen)\n492|        guard !isStale(gen) else { throw CancellationError() }\n493|        let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n494|        let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n495|        return runners.first(where: { $0.name == wanted })?.id\n496|    }\n497|\n498|    // MARK: - Service\n499|\n500|    private func setupService() async {\n501|        let gen = generation\n502|        guard !working else { return }\n503|        guard let draft, let installPath else {\n504|            await action {\n505|                RunnerRegistration.Action.failed(message: \"Register the runner first.\", step: \"setupService\")\n506|            }\n507|            return\n508|        }\n509|        working = true\n510|        await action { RunnerRegistration.Action.stepStarted(\"setupService\") }\n511|        do {\n512|            let directory = URL(fileURLWithPath: installPath)\n513|            let label = Self.serviceLabel(draft: draft)\n514|            let plist = try await installer.setupService(directory: directory, label: label)\n515|            guard !isStale(gen) else { return }\n516|            await action { RunnerRegistration.Action.serviceReady(plistPath: plist.path) }\n517|            await finishStep(\"setupService\", generation: gen)\n518|        } catch {\n519|            working = false\n520|            await fail(error, step: \"setupService\", generation: gen)\n521|        }\n522|    }\n523|\n524|    // MARK: - Editable access and labels\n525|\n526|    private func applyRepositoryAccess(groupID: Int64, ids: Set<Int64>) async {\n527|        let gen = generation\n528|        guard !working else { return }\n5