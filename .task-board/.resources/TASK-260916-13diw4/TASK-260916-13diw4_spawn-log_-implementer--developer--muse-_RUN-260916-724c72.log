ring?\n31|        /// Retained permission errors (403/missing rights). Draft edits never\n32|        /// clear them; only an explicit retry, reset, or dismiss does.\n33|        @Published public internal(set) var permissionError: String?\n34|\n35|        public init() {}\n36|\n37|        public func cleanup() async {\n38|            phase = .idle\n39|            draft = nil\n40|            working = false\n41|            group = nil\n42|            groupRepositoryIDs = []\n43|            asset = nil\n44|            installPath = nil\n45|            runnerID = nil\n46|            localAgentID = nil\n47|            completedSteps = []\n48|            error = nil\n49|            failedStep = nil\n50|            permissionError = nil\n51|        }\n52|    }\n53|\n54|    public enum Action: Relux.Action {\n55|        case draftBegan(Draft)\n56|        case draftUpdated(Draft)\n57|        case stepStarted(String)\n58|        case stepFinished(String)\n59|        case groupResolved(RunnerGroup, repositoryIDs: [Int64])\n60|        case downloadReady(DownloadAsset)\n61|        case installed(path: String)\n62|        case registered(runnerID: Int64?, localAgentID: Int64?)\n63|        case serviceReady(plistPath: String)\n64|        case repositoryAccessApplied([Int64])\n65|        case labelsApplied([String])\n66|        case failed(message: String, step: String)\n67|        case permissionDenied(message: String, step: String)\n68|        case permissionDismissed\n69|        case cancelled\n70|        case didReset\n71|    }\n72|\n73|    public enum Effect: Relux.Effect {\n74|        case beginDraft(Draft)\n75|        case updateDraft(Draft)\n76|        case resolveGroup\n77|        case prepareDownload\n78|        case downloadAndInstall\n79|        case registerRunner\n80|        case setupService\n81|        case applyRepositoryAccess(groupID: Int64, repositories: Set<Int64>)\n82|        case applyLabels([String])\n83|        case retry\n84|        case cancel\n85|        case reset\n86|        case dismissPermission\n87|    }\n88|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c477","stream":{"kind":"session","id":"01a0a895-af1e-7030-b7a0-b39b63843e96"},"sequence":150,"recorded_at":1780531400000295,"record_type":"event","durability":"durable","causation_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","run_stream":{"kind":"run","id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332"},"call_id":"call_01a0a895f58a7763a2d6cf341f3a0b0b","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+State+Reducer.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension RunnerRegistration.State {\n5|    public func reduce(with action: any Relux.Action) async {\n6|        guard let action = action as? RunnerRegistration.Action else { return }\n7|        if reduceDraftAction(action) { return }\n8|        if reduceProgressAction(action) { return }\n9|        await reduceResultAction(action)\n10|    }\n11|\n12|    /// Draft lifecycle actions. Returns true when the action was handled.\n13|    private func reduceDraftAction(_ action: RunnerRegistration.Action) -> Bool {\n14|        switch action {\n15|        case .draftBegan(let draft):\n16|            self.draft = draft\n17|            phase = .drafting\n18|            error = nil\n19|            failedStep = nil\n20|        case .draftUpdated(let draft):\n21|            self.draft = draft\n22|            // Draft edits retain the permission error by design.\n23|            if error != nil, permissionError == nil {\n24|                error = nil\n25|                failedStep = nil\n26|            }\n27|        case .cancelled:\n28|            working = false\n29|            error = nil\n30|            failedStep = nil\n31|        default:\n32|            return false\n33|        }\n34|        return true\n35|    }\n36|\n37|    /// Step progress actions. Returns true when the action was handled.\n38|    private func reduceProgressAction(_ action: RunnerRegistration.Action) -> Bool {\n39|        switch action {\n40|        case .stepStarted(let step):\n41|            working = true\n42|            error = nil\n43|            failedStep = nil\n44|            reducePhase(step)\n45|        case .stepFinished(let step):\n46|            working = false\n47|            completedSteps.insert(step)\n48|        case .permissionDismissed:\n49|            permissionError = nil\n50|        default:\n51|            return false\n52|        }\n53|        return true\n54|    }\n55|\n56|    private func reducePhase(_ step: String) {\n57|        switch step {\n58|        case \"resolveGroup\": phase = .resolvingGroup\n59|        case \"prepareDownload\": phase = .preparingDownload\n60|        case \"downloadAndInstall\": phase = .installing\n61|        case \"registerRunner\": phase = .registering\n62|        case \"setupService\": phase = .settingUpService\n63|        default: break\n64|        }\n65|    }\n66|\n67|    /// Fetched results, failures, and reset.\n68|    private func reduceResultAction(_ action: RunnerRegistration.Action) async {\n69|        if reduceFetchResult(action) { return }\n70|        switch action {\n71|        case .failed(let message, let step):\n72|            working = false\n73|            error = message\n74|            failedStep = step\n75|        case .permissionDenied(let message, let step):\n76|            working = false\n77|            error = message\n78|            failedStep = step\n79|            permissionError = message\n80|        case .didReset:\n81|            await cleanup()\n82|        default:\n83|            break\n84|        }\n85|    }\n86|\n87|    /// Fetched values applied to state. Returns true when handled.\n88|    private func reduceFetchResult(_ action: RunnerRegistration.Action) -> Bool {\n89|        switch action {\n90|        case .groupResolved(let group, let repositoryIDs):\n91|            self.group = group\n92|            groupRepositoryIDs = repositoryIDs\n93|        case .downloadReady(let asset):\n94|            self.asset = asset\n95|        case .installed(let path):\n96|            installPath = path\n97|        case .registered(let runnerID, let localAgentID):\n98|            self.runnerID = runnerID\n99|            self.localAgentID = localAgentID\n100|        case .serviceReady:\n101|            phase = .done\n102|        case .repositoryAccessApplied(let ids):\n103|            groupRepositoryIDs = ids\n104|            syncDraftRepositories(ids)\n105|        case .labelsApplied(let labels):\n106|            syncDraftLabels(labels)\n107|        default:\n108|            return false\n109|        }\n110|        return true\n111|    }\n112|\n113|    private func syncDraftRepositories(_ ids: [Int64]) {\n114|        if var current = draft {\n115|            current.selectedRepositoryIDs = Set(ids)\n116|            draft = current\n117|        }\n118|    }\n119|\n120|    private func syncDraftLabels(_ labels: [String]) {\n121|        if var current = draft {\n122|            current.labels = labels\n123|            draft = current\n124|        }\n125|    }\n126|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
