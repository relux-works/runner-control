{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7ad","stream":{"kind":"session","id":"01a0a895-af1e-7030-b7a0-b39b63843e96"},"sequence":561,"recorded_at":1780531400001117,"record_type":"event","durability":"durable","causation_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","run_stream":{"kind":"run","id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332"},"call_id":"call_01a0a897075f76718558e45dad8eb223","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n1|import CryptoKit\n2|import Foundation\n3|\n4|/// Filesystem installer for downloaded GitHub Actions runners.\n5|///\n6|/// Production path: download bytes → SHA-256 verify → tar extract →\n7|/// `bin/runsvc.sh` copied into the root and chmodded (as official `svc.sh`\n8|/// would) → exact `config.sh` invocation → manual LaunchAgent plist.\n9|/// All side effects stay below `installRoot`; tests inject a temporary root,\n10|/// a fake downloader, and fixtures instead of touching production runners.\n11|public actor RunnerInstallerService {\n12|    public static let markerFileName = \".runnercontrol-install.json\"\n13|    public static let installOS = \"osx\"\n14|\n15|    private let installRoot: URL\n16|    private let downloader: @Sendable (URL) async throws -> Data\n17|    private let executor: any CommandExecuting\n18|    private let currentArch: @Sendable () -> String\n19|    private let hasher: @Sendable (Data) -> String\n20|\n21|    public init(\n22|        installRoot: URL? = nil,\n23|        downloader: (@Sendable (URL) async throws -> Data)? = nil,\n24|        executor: (any CommandExecuting)? = nil,\n25|        currentArch: (@Sendable () -> String)? = nil,\n26|        hasher: (@Sendable (Data) -> String)? = nil\n27|    ) {\n28|        self.installRoot = installRoot\n29|            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/GitHubActions\")\n30|        self.downloader = downloader ?? { url in\n31|            let (data, _) = try await URLSession.shared.data(from: url)\n32|            return data\n33|        }\n34|        self.executor = executor ?? CommandExecutor()\n35|        self.currentArch = currentArch ?? {\n36|            #if arch(arm64)\n37|            return \"arm64\"\n38|            #else\n39|            return \"x64\"\n40|            #endif\n41|        }\n42|        self.hasher = hasher ?? { data in\n43|            SHA256.hash(data: data).map { String(format: \"%02x\", $0) }.joined()\n44|        }\n45|    }\n46|\n47|    public nonisolated var root: URL { installRoot }\n48|    public nonisolated var architecture: String { currentArch() }\n49|\n50|    public func directory(for installDirName: String) -> URL {\n51|        installRoot.appendingPathComponent(installDirName)\n52|    }\n53|\n54|    // MARK: - Idempotency markers\n55|\n56|    public struct Marker: Codable, Sendable, Equatable {\n57|        public var scopeKey: String\n58|        public var completedSteps: Set<String>\n59|        public init(scopeKey: String, completedSteps: Set<String> = []) {\n60|            self.scopeKey = scopeKey; self.completedSteps = completedSteps\n61|        }\n62|    }\n63|\n64|    public static let stepDownloaded = \"downloaded\"\n65|    public static let stepInstalled = \"installed\"\n66|    public static let stepConfigured = \"configured\"\n67|    public static let stepServiceReady = \"serviceReady\"\n68|\n69|    public func loadMarker(directory: URL) -> Marker? {\n70|        let url = directory.appendingPathComponent(Self.markerFileName)\n71|        guard let data = try? Data(contentsOf: url) else { return nil }\n72|        return try? JSONDecoder().decode(Marker.self, from: data)\n73|    }\n74|\n75|    private func storeMarker(_ marker: Marker, directory: URL) throws {\n76|        let data = try JSONEncoder().encode(marker)\n77|        try data.write(to: directory.appendingPathComponent(Self.markerFileName), options: .atomic)\n78|    }\n79|\n80|    public func markCompleted(_ step: String, directory: URL, scopeKey: String) throws {\n81|        var marker = loadMarker(directory: directory) ?? Marker(scopeKey: scopeKey)\n82|        marker.completedSteps.insert(step)\n83|        try storeMarker(marker, directory: directory)\n84|    }\n85|\n86|    public func hasCompleted(_ step: String, directory: URL) -> Bool {\n87|        loadMarker(directory: directory)?.completedSteps.contains(step) == true\n88|    }\n89|\n90|    // MARK: - Install\n91|\n92|    /// Downloads, verifies, and extracts the official package. Idempotent:\n93|    /// a completed `installed` marker with matching scope skips the work.\n94|    /// Refuses to overwrite an already-registered directory (no duplicates).\n95|    public func downloadAndInstall(\n96|        asset: RunnerRegistration.DownloadAsset,\n97|        draft: RunnerRegistration.Draft\n98|    ) async throws -> URL {\n99|        try RunnerRegistration.Gates.validateNoSpace(\n100|            installDirName: draft.installDirName, workFolder: draft.workFolder\n101|        )\n102|        let directory = self.directory(for: draft.installDirName)\n103|        if directory.path.contains(\" \") {\n104|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n105|        }\n106|        let files = FileManager.default\n107|        if let marker = loadMarker(directory: directory),\n108|           marker.completedSteps.contains(Self.stepInstalled),\n109|           marker.scopeKey == draft.scope.scopeKey,\n110|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n111|            return directory\n112|        }\n113|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n114|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: draft.runnerName)\n115|        }\n116|        let bytes: Data\n117|        do {\n118|            bytes = try await downloader(asset.downloadURL)\n119|        } catch {\n120|            throw RunnerRegistration.RegistrationError.network(\"Runner download failed: \\(error.localizedDescription)\")\n121|        }\n122|        // Fail closed: the official downloads endpoint documents\n123|        // `sha256_checksum`, and an install without a verified digest is\n124|        // refused rather than trusted on TLS alone.\n125|        guard let expected = asset.sha256Checksum, !expected.isEmpty else {\n126|            throw RunnerRegistration.RegistrationError.integrityMismatch\n127|        }\n128|        let actual = hasher(bytes)\n129|        guard actual.lowercased() == expected.lowercased() else {\n130|            throw RunnerRegistration.RegistrationError.integrityMismatch\n131|        }\n132|        try files.createDirectory(at: directory, withIntermediateDirectories: true)\n133|        let archive = files.temporaryDirectory.appendingPathComponent(UUID().uuidString + \"-\" + asset.filename)\n134|        defer { try? files.removeItem(at: archive) }\n135|        try bytes.write(to: archive, options: .atomic)\n136|        let result = try await executor.run(\"/usr/bin/tar\", [\"-xzf\", archive.path, \"-C\", directory.path])\n137|        guard result.code == 0 else {\n138|            throw RunnerRegistration.RegistrationError.network(\n139|                \"Runner archive extraction failed: \\(String(result.output.prefix(300)))\"\n140|            )\n141|        }\n142|        // Official packages keep runsvc.sh under bin/ until svc.sh installs it;\n143|        // a bare extraction leaves the root copy absent, so install it here.\n144|        try installRunsvc(directory: directory)\n145|        try markCompleted(Self.stepDownloaded, directory: directory, scopeKey: draft.scope.scopeKey)\n146|        try markCompleted(Self.stepInstalled, directory: directory, scopeKey: draft.scope.scopeKey)\n147|        return directory\n148|    }\n149|\n150|    /// Copies official `bin/runsvc.sh` into the installation root and makes\n151|    /// it executable, mirroring what official `svc.sh install` would do.\n152|    public func installRunsvc(directory: URL) throws {\n153|        let files = FileManager.default\n154|        let source = directory.appendingPathComponent(\"bin/runsvc.sh\")\n155|        let target = directory.appendingPathComponent(\"runsvc.sh\")\n156|        guard files.fileExists(atPath: source.path) else {\n157|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing bin/runsvc.sh.\")\n158|        }\n159|        if files.fileExists(atPath: target.path) {\n160|            try files.removeItem(at: target)\n161|        }\n162|        try files.copyItem(at: source, to: target)\n163|        try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: target.path)\n164|    }\n165|\n166|    // MARK: - Configure\n167|\n168|    /// Runs the exact `config.sh` invocation. Skips when a previous attempt\n169|    /// already registered this directory (marker + `.runner` present), so\n170|    /// retries never create orphan or duplicate GitHub registrations.\n171|    /// Returns the local agent ID read back from `.runner`.\n172|    @discardableResult\n173|    public func runConfig(\n174|        directory: URL,\n175|        scopeURL: String,\n176|        token: String,\n177|        draft: RunnerRegistration.Draft,\n178|        runnerGroup: String?\n179|    ) async throws -> Int64? {\n180|        try await runConfig(\n181|            directory: directory, scopeURL: scopeURL, token: token,\n182|            draft: draft, runnerGroup: runnerGroup, replace: draft.allowReplace\n183|        )\n184|    }\n185|\n186|    /// Explicit-`replace` variant. Production callers pass\n187|    /// `draft.allowReplace`; tests drive both values.\n188|    @discardableResult\n189|    public func runConfig(\n190|        directory: URL,\n191|        scopeURL: String,\n192|        token: String,\n193|        draft: RunnerRegistration.Draft,\n194|        runnerGroup: String?,\n195|        replace: Bool\n196|    ) async throws -> Int64? {\n197|        let files = FileManager.default\n198|        if hasCompleted(Self.stepConfigured, directory: directory),\n199|           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n200|            return readAgentID(directory: directory)\n201|        }\n202|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n203|           hasCompleted(Self.stepConfigured, directory: directory) {\n204|            return readAgentID(directory: directory)\n205|        }\n206|        let spec = RunnerRegistration.ConfigSpec(\n207|            scopeURL: scopeURL, token: token, name: draft.runnerName,\n208|            workFolder: draft.workFolder, labels: draft.labels,\n209|            runnerGroup: runnerGroup, replace: replace\n210|        )\n211|        let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n212|        let executable = directory.appendingPathComponent(\"config.sh\").path\n213|        guard files.fileExists(atPath: executable) else {\n214|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n215|        }\n216|        let result = try await executor.run(executable, args)\n217|        guard result.code == 0 else {\n218|            // Never echo the token: config output may repeat arguments.\n219|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [token])\n220|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n221|        }\n222|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n223|            throw RunnerRegistration.RegistrationError.configFailed(\n224|                \"config.sh reported success but .runner is missing.\"\n225|            )\n226|        }\n227|        try markCompleted(Self.stepConfigured, directory: directory, scopeKey: draft.scope.scopeKey)\n228|        return readAgentID(directory: directory)\n229|    }\n230|\n231|    // MARK: - Dedicated-group ownership\n232|\n233|    public static let ownershipFileName = \".runnercontrol-groups.json\"\n234|\n235|    private func ownershipFile() -> URL {\n236|        installRoot.appendingPathComponent(Self.ownershipFileName)\n237|    }\n238|\n239|    private static func ownershipKey(org: String, name: String) -> String {\n240|        \"\\(org.lowercased())\\u{0}\\(name)\"\n241|    }\n242|\n243|    /// Returns the locally recorded dedicated-group ID for `org` + `name`,\n244|    /// or nil when this Mac never created (or took over) that group. Name\n245|    /// matches on GitHub alone never count as ownership.\n246|    public func loadOwnedGroupID(org: String, name: String) -> Int64? {\n247|        guard let data = try? Data(contentsOf: ownershipFile()),\n248|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n249|        return table[Self.ownershipKey(org: org, name: name)]\n250|    }\n251|\n252|    public func saveOwnedGroupID(org: String, name: String, groupID: Int64) throws {\n253|        let file = ownershipFile()\n254|        var table: [String: Int64] = [:]\n255|        if let data = try? Data(contentsOf: file),\n256|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n257|            table = decoded\n258|        }\n259|        table[Self.ownershipKey(org: org, name: name)] = groupID\n260|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n261|        let data = try JSONEncoder().encode(table)\n262|        try data.write(to: file, options: .atomic)\n263|    }\n264|\n265|    /// Reads the local agent ID from `.runner` without touching credentials.\n266|    public func readAgentID(directory: URL) -> Int64? {\n267|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n268|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n269|        if let id = object[\"agentId\"] as? Int64 { return id }\n270|        if let id = object[\"agentId\"] as? Int { return Int64(id) }\n271|        if let id = object[\"agentId\"] as? NSNumber { return id.int64Value }\n272|        return nil\n273|    }\n274|\n275|    // MARK: - Manual LaunchAgent\n276|\n277|    /// Writes the manual service plist (RunAtLoad off for new runners) and\n278|    /// validates it matches the directory. Never bootstraps the service:\n279|    /// enabling is the user's separate action.\n280|    @discardableResult\n281|    public func setupService(directory: URL, label: String) throws -> URL {\n282|        guard !directory.path.contains(\" \") else {\n283|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n284|        }\n285|        let files = FileManager.default\n286|        guard files.fileExists(atPath: directory.appendingPathComponent(\"runsvc.sh\").path) else {\n287|            throw RunnerRegistration.RegistrationError.network(\n288|                \"runsvc.sh is missing; reinstall before setting up the service.\"\n289|            )\n290|        }\n291|        let plist = directory.appendingPathComponent(\"manual-service.plist\")\n292|        let payload: [String: Any] = [\n293|            \"Label\": label,\n294|            \"ProgramArguments\": [directory.appendingPathComponent(\"runsvc.sh\").path],\n295|            \"WorkingDirectory\": directory.path,\n296|            \"RunAtLoad\": false\n297|        ]\n298|        let data = try PropertyListSerialization.data(fromPropertyList: payload, format: .xml, options: 0)\n299|        try data.write(to: plist, options: .atomic)\n300|        let scopeKey = loadMarker(directory: directory)?.scopeKey ?? \"\"\n301|        try markCompleted(Self.stepServiceReady, directory: directory, scopeKey: scopeKey)\n302|        return plist\n303|    }\n304|\n305|    /// Removes a failed partial install so retries start clean. Refuses to\n306|    /// touch directories that already hold a registration (`.runner`) or an\n307|    /// unknown marker scope: recovery never deletes a working runner.\n308|    public func recoverPartialInstall(directory: URL, scopeKey: String) throws {\n309|        let files = FileManager.default\n310|        guard files.fileExists(atPath: directory.path) else { return }\n311|        guard !files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n312|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: directory.lastPathComponent)\n313|        }\n314|        if let marker = loadMarker(directory: directory), marker.scopeKey != scopeKey {\n315|            throw RunnerRegistration.RegistrationError.alreadyInstalled(path: directory.path)\n316|        }\n317|        try files.removeItem(at: directory)\n318|    }\n319|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
