         }\n+            let response = try await perform(method: \"GET\", url: current, token: token)\n+            pages.append(response)\n+            url = Self.nextPageURL(headers: response.headers, allowedHost: config.apiBaseURL.host)\n+        }\n+        return pages\n+    }\n","edit_facts":{"tool_name":"edit_file","path":"Packages/RunnerControlCore/Sources/GitHubRunnerAPIClient.swift","added":68,"removed":9},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
