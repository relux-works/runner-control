y: body\n37|        )\n38|        let response: GitHubHTTPResponse\n39|        do {\n40|            response = try await transport.send(request)\n41|        } catch {\n42|            throw RunnerRegistration.RegistrationError.network(\n43|                GitHubTransportError.offline.localizedDescription\n44|            )\n45|        }\n46|        switch response.status {\n47|        // 204 is the documented success for PUT …/repositories; rejecting\n48|        // it fails every production repository-access update (review F2).\n49|        case 200, 201, 204:\n50|            return response\n51|        case 401:\n52|            throw RunnerRegistration.RegistrationError.unauthorized\n53|        case 403:\n54|            throw RunnerRegistration.RegistrationError.forbidden(\n55|                String(String(decoding: response.body, as: UTF8.self).prefix(300))\n56|            )\n57|        case 404:\n58|            throw RunnerRegistration.RegistrationError.network(\"GitHub resource not found (404): \\(path).\")\n59|        case 422:\n60|            throw RunnerRegistration.RegistrationError.network(\n61|                \"GitHub rejected the request (422): \" +\n62|                    String(String(decoding: response.body, as: UTF8.self).prefix(300))\n63|            )\n64|        default:\n65|            if response.status == 429\n66|                || String(decoding: response.body, as: UTF8.self).lowercased().contains(\"rate limit\") {\n67|                throw RunnerRegistration.RegistrationError.rateLimited\n68|            }\n69|            throw RunnerRegistration.RegistrationError.network(\n70|                \"GitHub request failed (HTTP \\(response.status)).\"\n71|            )\n72|        }\n73|    }\n74|\n75|    private func decode<T: Decodable>(_ type: T.Type, from response: GitHubHTTPResponse) throws -> T {\n76|        do {\n77|            return try JSONDecoder().decode(type, from: response.body)\n78|        } catch {\n79|            throw RunnerRegistration.RegistrationError.network(\n80|                GitHubTransportError.invalidResponse.localizedDescription\n81|            )\n82|        }\n83|    }\n84|\n85|    // MARK: - Downloads\n86|\n87|    public func fetchDownloads(\n88|        config: GitHubAuth.AppConfig,\n89|        token: String,\n90|        scope: RunnerRegistration.Scope\n91|    ) async throws -> [RunnerRegistration.DownloadAsset] {\n92|        let response: GitHubHTTPResponse\n93|        do {\n94|            response = try await send(\n95|                method: \"GET\", config: config,\n96|                path: \"\\(scope.apiPrefix)/actions/runners/downloads\", token: token\n97|            )\n98|        } catch let error as RunnerRegistration.RegistrationError {\n99|            if case .forbidden(let text) = error {\n100|                throw RunnerRegistration.RegistrationError.missingPermission(readHelp(scope: scope, detail: text))\n101|            }\n102|            throw error\n103|        }\n104|        let decoded = try decode([RunnerDownloadDTO].self, from: response)\n105|        return decoded.compactMap { dto -> RunnerRegistration.DownloadAsset? in\n106|            guard let url = URL(string: dto.downloadURL) else { return nil }\n107|            return .init(\n108|                osName: dto.osName, architecture: dto.architecture,\n109|                downloadURL: url, filename: dto.filename,\n110|                sha256Checksum: dto.sha256Checksum\n111|            )\n112|        }\n113|    }\n114|\n115|    // MARK: - Registration token (short-lived, single use)\n116|\n117|    public func createRegistrationToken(\n118|        config: GitHubAuth.AppConfig,\n119|        token: String,\n120|        scope: RunnerRegistration.Scope\n121|    ) async throws -> (token: String, expiresAt: Date?) {\n122|        let response: GitHubHTTPResponse\n123|        do {\n124|            response = try await send(\n125|                method: \"POST\", config: config,\n126|                path: \"\\(scope.apiPrefix)/actions/runners/registration-token\", token: token\n127|            )\n128|        } catch let error as RunnerRegistration.RegistrationError {\n129|            if case .forbidden(let text) = error {\n130|                throw RunnerRegistration.RegistrationError.missingPermission(permissionHelp(scope: scope, detail: text))\n131|            }\n132|            throw error\n133|        }\n134|        let decoded = try decode(RegistrationTokenDTO.self, from: response)\n135|        guard !decoded.token.isEmpty else {\n136|            throw RunnerRegistration.RegistrationError.network(\n137|                GitHubTransportError.invalidResponse.localizedDescription\n138|            )\n139|        }\n140|        var expiresAt: Date?\n141|        if let raw = decoded.expiresAt {\n142|            expiresAt = ISO8601DateFormatter().date(from: raw)\n143|        }\n144|        return (decoded.token, expiresAt)\n145|    }\n146|\n147|    private func permissionHelp(scope: RunnerRegistration.Scope, detail: String) -> String {\n148|        writeHelp(scope: scope, detail: detail)\n149|    }\n150|\n151|    private func readHelp(scope: RunnerRegistration.Scope, detail: String) -> String {\n152|        let need: String\n153|        switch scope {\n154|        case .organization:\n155|            need = \"Self-hosted runners/read for the organization\"\n156|        case .repository:\n157|            need = \"Administration/read for the repository\"\n158|        }\n159|        let suffix = detail.isEmpty ? \"\" : \" GitHub says: \\(detail)\"\n160|        return \"Missing permission: \\(need).\\(suffix)\"\n161|    }\n162|\n163|    private func writeHelp(scope: RunnerRegistration.Scope, detail: String) -> String {\n164|        let need: String\n165|        switch scope {\n166|        case .organization:\n167|            need = \"Self-hosted runners/write for the organization\"\n168|        case .repository:\n169|            need = \"Administration/write for the repository\"\n170|        }\n171|        let suffix = detail.isEmpty ? \"\" : \" GitHub says: \\(detail)\"\n172|        return \"Missing permission: \\(need).\\(suffix)\"\n173|    }\n174|\n175|    private func groupReadHelp(org: String, detail: String) -> String {\n176|        let suffix = detail.isEmpty ? \"\" : \" GitHub says: \\(detail)\"\n177|        return \"Missing permission: Self-hosted runners/read for the organization \\(org).\\(suffix)\"\n178|    }\n179|\n180|    // MARK: - Runners (fetch real IDs)\n181|\n182|    public func fetchRunners(\n183|        config: GitHubAuth.AppConfig,\n184|        token: String,\n185|        scope: RunnerRegistration.Scope\n186|    ) async throws -> [RunnerRegistration.RegisteredRunner] {\n187|        let response: GitHubHTTPResponse\n188|        do {\n189|            response = try await send(\n190|                method: \"GET\", config: config,\n191|                path: \"\\(scope.apiPrefix)/actions/runners?per_page=100\", token: token\n192|            )\n193|        } catch let error as RunnerRegistration.RegistrationError {\n194|            if case .forbidden(let text) = error {\n195|                throw RunnerRegistration.RegistrationError.missingPermission(readHelp(scope: scope, detail: text))\n196|            }\n197|            throw error\n198|        }\n199|        let decoded = try decode(RunnersListDTO.self, from: response)\n200|        return decoded.runners.map {\n201|            .init(id: $0.id, name: $0.name, labels: $0.labels.map(\\.name))\n202|        }\n203|    }\n204|\n205|    // MARK: - Runner groups (org only)\n206|\n207|    public func fetchGroups(\n208|        config: GitHubAuth.AppConfig,\n209|        token: String,\n210|        org: String\n211|    ) async throws -> [RunnerRegistration.RunnerGroup] {\n212|        let response: GitHubHTTPResponse\n213|        do {\n214|            response = try await send(\n215|                method: \"GET\", config: config,\n216|                path: \"orgs/\\(org)/actions/runner-groups?per_page=100\", token: token\n217|            )\n218|        } catch let error as RunnerRegistration.RegistrationError {\n219|            if case .forbidden(let text) = error {\n220|                throw RunnerRegistration.RegistrationError.missingPermission(groupReadHelp(org: org, detail: text))\n221|            }\n222|            throw error\n223|        }\n224|        let decoded = try decode(RunnerGroupsListDTO.self, from: response)\n225|        return decoded.runnerGroups.map {\n226|            .init(\n227|                id: $0.id, name: $0.name, visibility: $0.visibility,\n228|                allowsPublicRepositories: $0.allowsPublicRepositories ?? false\n229|            )\n230|        }\n231|    }\n232|\n233|    public func createGroup(\n234|        config: GitHubAuth.AppConfig,\n235|        token: String,\n236|        org: String,\n237|        name: String,\n238|        selectedRepositoryIDs: Set<Int64>,\n239|        allowsPublicRepositories: Bool = true\n240|    ) async throws -> RunnerRegistration.RunnerGroup {\n241|        let payload = CreateGroupDTO(\n242|            name: name, visibility: \"selected\",\n243|            selectedRepositoryIDs: Array(selectedRepositoryIDs).sorted(),\n244|            allowsPublicRepositories: allowsPublicRepositories\n245|        )\n246|        let body = try JSONEncoder().encode(payload)\n247|        let response: GitHubHTTPResponse\n248|        do {\n249|            response = try await send(\n250|                method: \"POST\", config: config,\n251|                path: \"orgs/\\(org)/actions/runner-groups\", token: token, body: body\n252|            )\n253|        } catch let error as RunnerRegistration.RegistrationError {\n254|            if case .forbidden(let text) = error {\n255|                throw RunnerRegistration.RegistrationError.missingPermission(\n256|                    permissionHelp(scope: .organization(org: org), detail: text)\n257|                )\n258|            }\n259|            throw error\n260|        }\n261|        let decoded = try decode(RunnerGroupDTO.self, from: response)\n262|        return .init(\n263|            id: decoded.id, name: decoded.name, visibility: decoded.visibility,\n264|            allowsPublicRepositories: decoded.allowsPublicRepositories ?? allowsPublicRepositories\n265|        )\n266|    }\n267|\n268|    /// Enables selected public repositories on an owned dedicated group.\n269|    /// GitHub defaults `allows_public_repositories` to false, which silently\n270|    /// denies every selected public repo; dedicated per-Mac groups always\n271|    /// opt in because `selected` visibility still bounds access to the\n272|    /// chosen repository IDs.\n273|    public func updateGroupAllowsPublic(\n274|        config: GitHubAuth.AppConfig,\n275|        token: String,\n276|        org: String,\n277|        groupID: Int64,\n278|        allowsPublic: Bool\n279|    ) async throws -> RunnerRegistration.RunnerGroup {\n280|        let payload = UpdateGroupDTO(allowsPublicRepositories: allowsPublic)\n281|        let body = try JSONEncoder().encode(payload)\n282|        let response: GitHubHTTPResponse\n283|        do {\n284|            response = try await send(\n285|                method: \"PATCH\", config: config,\n286|                path: \"orgs/\\(org)/actions/runner-groups/\\(groupID)\", token: token, body: body\n287|            )\n288|        } catch let error as RunnerRegistration.RegistrationError {\n289|            if case .forbidden(let text) = error {\n290|                throw RunnerRegistration.RegistrationError.missingPermission(\n291|                    permissionHelp(scope: .organization(org: org), detail: text)\n292|                )\n293|            }\n294|            throw error\n295|        }\n296|        let decoded = try decode(RunnerGroupDTO.self, from: response)\n297|        return .init(\n298|            id: decoded.id, name: decoded.name, visibility: decoded.visibility,\n299|            allowsPublicRepositories: decoded.allowsPublicRepositories ?? allowsPublic\n300|        )\n301|    }\n302|\n303|    public func fetchGroupRepositories(\n304|        config: GitHubAuth.AppConfig,\n305|        token: String,\n306|        org: String,\n307|        groupID: Int64\n308|    ) async throws -> [Int64] {\n309|        let response: GitHubHTTPResponse\n310|        do {\n311|            response = try await send(\n312|                method: \"GET\", config: config,\n313|                path: \"orgs/\\(org)/actions/runner-groups/\\(groupID)/repositories\", token: token\n314|            )\n315|        } catch let error as RunnerRegistration.RegistrationError {\n316|            if case .forbidden(let text) = error {\n317|                throw RunnerRegistration.RegistrationError.missingPermission(groupReadHelp(org: org, detail: text))\n318|            }\n319|            throw error\n320|        }\n321|        let decoded = try decode(GroupRepositoriesDTO.self, from: response)\n322|        return decoded.repositories.map(\\.id)\n323|    }\n324|\n325|    public func setGroupRepositories(\n326|        config: GitHubAuth.AppConfig,\n327|        token: String,\n328|        org: String,\n329|        groupID: Int64,\n330|        selectedRepositoryIDs: Set<Int64>\n331|    ) async throws {\n332|        let payload = SetGroupRepositoriesDTO(selectedRepositoryIDs: Array(selectedRepositoryIDs).sorted())\n333|        let body = try JSONEncoder().encode(payload)\n334|        do {\n335|            _ = try await send(\n336|                method: \"PUT\", config: config,\n337|                path: \"orgs/\\(org)/actions/runner-groups/\\(groupID)/repositories\", token: token, body: body\n338|            )\n339|        } catch let error as RunnerRegistration.RegistrationError {\n340|            if case .forbidden(let text) = error {\n341|                throw RunnerRegistration.RegistrationError.missingPermission(\n342|                    permissionHelp(scope: .organization(org: org), detail: text)\n343|                )\n344|            }\n345|            throw error\n346|        }\n347|    }\n348|\n349|    // MARK: - Labels (editable after registration)\n350|\n351|    public func setRunnerLabels(\n352|        config: GitHubAuth.AppConfig,\n353|        token: String,\n354|        scope: RunnerRegistration.Scope,\n355|        runnerID: Int64,\n356|        labels: [String]\n357|    ) async throws {\n358|        let payload = SetLabelsDTO(labels: labels)\n359|        let body = try JSONEncoder().encode(payload)\n360|        do {\n361|            _ = try await send(\n362|                method: \"PUT\", config: config,\n363|                path: \"\\(scope.apiPrefix)/actions/runners/\\(runnerID)/labels\", token: token, body: body\n364|            )\n365|        } catch let error as RunnerRegistration.RegistrationError {\n366|            if case .forbidden(let text) = error {\n367|                throw RunnerRegistration.RegistrationError.missingPermission(writeHelp(scope: scope, detail: text))\n368|            }\n369|            throw error\n370|        }\n371|    }\n372|}\n373|\n374|// MARK: - DTOs\n375|\n376|private struct RunnerDownloadDTO: Decodable, Sendable {\n377|    let osName: String\n378|    let architecture: String\n379|    let downloadURL: String\n380|    let filename: String\n381|    let sha256Checksum: String?\n382|\n383|    private enum CodingKeys: String, CodingKey {\n384|        case osName = \"os\"\n385|        case architecture\n386|        case downloadURL = \"download_url\"\n387|        case filename\n388|        case sha256Checksum = \"sha256_checksum\"\n389|    }\n390|}\n391|\n392|private struct RegistrationTokenDTO: Decodable, Sendable {\n393|    let token: String\n394|    let expiresAt: String?\n395|\n396|    private enum CodingKeys: String, CodingKey {\n397|        case token\n398|        case expiresAt = \"expires_at\"\n399|    }\n400|}\n401|\n402|private struct RunnersListDTO: Decodable, Sendable {\n403|    let runners: [RunnerDTO]\n404|}\n405|\n406|private struct RunnerDTO: Decodable, Sendable {\n407|    let id: Int64\n408|    let name: String\n409|    let labels: [LabelDTO]\n410|}\n411|\n412|private struct LabelDTO: Decodable, Sendable {\n413|    let name: String\n414|}\n415|\n416|private struct RunnerGroupsListDTO: Decodable, Sendable {\n417|    let runnerGroups: [RunnerGroupDTO]\n418|\n419|    private enum CodingKeys: String, CodingKey {\n420|        case runnerGroups = \"runner_groups\"\n421|    }\n422|}\n423|\n424|private struct RunnerGroupDTO: Decodable, Sendable {\n425|    let id: Int64\n426|    let name: String\n427|    let visibility: String\n428|    let allowsPublicRepositories: Bool?\n429|\n430|    private enum CodingKeys: String, CodingKey {\n431|        case id\n432|        case name\n433|        case visibility\n434|        case allowsPublicRepositories = \"allows_public_repositories\"\n435|    }\n436|}\n437|\n438|private struct GroupRepositoriesDTO: Decodable, Sendable {\n439|    let repositories: [GroupRepositoryDTO]\n440|}\n441|\n442|private struct GroupRepositoryDTO: Decodable, Sendable {\n443|    let id: Int64\n444|}\n445|\n446|private struct CreateGroupDTO: Encodable, Sendable {\n447|    let name: String\n448|    let visibility: String\n449|    let selectedRepositoryIDs: [Int64]\n450|    let allowsPublicRepositories: Bool\n451|\n452|    private enum CodingKeys: String, CodingKey {\n453|        case name\n454|        case visibility\n455|        case selectedRepositoryIDs = \"selected_repository_ids\"\n456|        case allowsPublicRepositories = \"allows_public_repositories\"\n457|    }\n458|}\n459|\n460|private struct UpdateGroupDTO: Encodable, Sendable {\n461|    let allowsPublicRepositories: Bool\n462|\n463|    private enum CodingKeys: String, CodingKey {\n464|        case allowsPublicRepositories = \"allows_public_repositories\"\n465|    }\n466|}\n467|\n468|private struct SetGroupRepositoriesDTO: Encodable, Sendable {\n469|    let selectedRepositoryIDs: [Int64]\n470|\n471|    private enum CodingKeys: String, CodingKey {\n472|        case selectedRepositoryIDs = \"selected_repository_ids\"\n473|    }\n474|}\n475|\n476|private struct SetLabelsDTO: Encodable, Sendable {\n477|    let labels: [String]\n478|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c767","stream":{"kind":"session","id":"01a0a895-af1e-7030-b7a0-b39b63843e96"},"sequence":526,"recorded_at":1780531400001047,"record_type":"event","durability":"durable","causation_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","run_stream":{"kind":"run","id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332"},"call_id":"call_01a0a896eb3e733aa25d1fcc1fa207f6","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Gates.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Validation gates. Each gate refuses a concrete invalid class; negative\n5|    /// tests narrow every one of them.\n6|    public enum Gates {\n7|        /// Refuses install/work paths containing spaces. GitHub's own setup has\n8|        /// a known defect with spaced paths; the wizard never reproduces it.\n9|        public static func validateNoSpace(installDirName: String, workFolder: String) throws {\n10|            if installDirName.contains(\" \") {\n11|                throw RegistrationError.noSpacePath(\"Installation folder name must not contain spaces.\")\n12|            }\n13|            if installDirName.contains(\"/\") || installDirName.isEmpty {\n14|                throw RegistrationError.invalidDraft(\"Installation folder name is invalid.\")\n15|            }\n16|            if workFolder.contains(\" \") {\n17|                throw RegistrationError.noSpacePath(\"Work folder must not contain spaces.\")\n18|            }\n19|            if workFolder.isEmpty || workFolder.contains(\"/\") {\n20|                throw RegistrationError.invalidDraft(\"Work folder name is invalid.\")\n21|            }\n22|        }\n23|\n24|        /// Validates the full draft before any network or filesystem mutation.\n25|        public static func validateDraft(_ draft: Draft) throws {\n26|            let name = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n27|            guard !name.isEmpty else {\n28|                throw RegistrationError.invalidDraft(\"Runner name must not be empty.\")\n29|            }\n30|            guard name.count <= 64 else {\n31|                throw RegistrationError.invalidDraft(\"Runner name is too long (max 64 characters).\")\n32|            }\n33|            let labels = draft.labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }\n34|            guard !labels.isEmpty else {\n35|                throw RegistrationError.invalidDraft(\"At least one label is required.\")\n36|            }\n37|            for label in labels {\n38|                guard !label.isEmpty else {\n39|                    throw RegistrationError.invalidDraft(\"Labels must not be empty.\")\n40|                }\n41|                guard label.count <= 100 else {\n42|                    throw RegistrationError.invalidDraft(\"Label '\\(label)' is too long (max 100 characters).\")\n43|                }\n44|            }\n45|            try validateNoSpace(installDirName: draft.installDirName, workFolder: draft.workFolder)\n46|            switch draft.scope {\n47|            case .organization:\n48|                let group = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n49|                guard !group.isEmpty else {\n50|                    throw RegistrationError.invalidDraft(\"Organization runners need a dedicated per-Mac group name.\")\n51|                }\n52|            case .repository:\n53|                break\n54|            }\n55|        }\n56|\n57|        /// Picks the architecture-matched official asset. Refuses any\n58|        /// substitute: both OS and architecture must match exactly.\n59|        public static func selectDownload(\n60|            osName: String, arch: String, from assets: [DownloadAsset]\n61|        ) throws -> DownloadAsset {\n62|            guard let match = assets.first(where: { $0.osName == osName && $0.architecture == arch }) else {\n63|                throw RegistrationError.downloadMismatch(osName: osName, arch: arch)\n64|            }\n65|            return match\n66|        }\n67|\n68|        /// Authorizes a group mutation only when the UI explicitly scoped it\n69|        /// AND the target is this run's resolved dedicated group. Never\n70|        /// mutates unrelated or shared groups.\n71|        public static func authorizeGroupMutation(\n72|            targetGroupID: Int64, resolvedGroupID: Int64?, allowFlag: Bool\n73|        ) throws {\n74|            guard allowFlag else { throw RegistrationError.groupScopeNotConfirmed }\n75|            guard let resolved = resolvedGroupID, resolved == targetGroupID else {\n76|                throw RegistrationError.refusesSharedGroup(groupID: targetGroupID)\n77|            }\n78|        }\n79|\n80|        /// Repository scope never touches groups: personal repos get separate\n81|        /// installations without shared-group coupling.\n82|        public static func requireOrganizationScope(_ scope: Scope) throws {\n83|            if case .organization = scope { return }\n84|            throw RegistrationError.groupNotApplicable\n85|        }\n86|\n87|        /// Ownership check for a pre-existing group with the requested name.\n88|        /// A name match alone never authorizes adoption: the caller must show\n89|        /// either a locally recorded ownership entry for the same group ID or\n90|        /// an explicit UI takeover confirmation.\n91|        public static func authorizeGroupTakeover(\n92|            groupName: String, existingID: Int64, ownedID: Int64?, allowTakeover: Bool\n93|        ) throws {\n94|            if let owned = ownedID, owned == existingID { return }\n95|            guard allowTakeover else {\n96|                throw RegistrationError.groupNameTaken(name: groupName, groupID: existingID)\n97|            }\n98|        }\n99|\n100|        /// Duplicate-name guard run before any registration token is minted.\n101|        /// Without explicit replace consent a remote name match refuses the\n102|        /// run so `config.sh` can never silently replace another machine.\n103|        public static func rejectRemoteDuplicate(name: String, isTaken: Bool, allowReplace: Bool) throws {\n104|            guard isTaken, !allowReplace else { return }\n105|            throw RegistrationError.remoteNameTaken(name: name)\n106|        }\n107|    }\n108|\n109|    /// Exact `config.sh` invocation inputs.\n110|    public struct ConfigSpec: Sendable, Equatable {\n111|        let scopeURL: String\n112|        let token: String\n113|        let name: String\n114|        let workFolder: String\n115|        let labels: [String]\n116|        let runnerGroup: String?\n117|        /// Explicit `--replace`. Production sets it only from\n118|        /// `Draft.allowReplace`; default invocations omit the flag so a\n119|        /// duplicate name fails instead of stealing another registration.\n120|        let replace: Bool\n121|    }\n122|\n123|    /// Exact `config.sh` invocation builder. Argument order is fixed and\n124|    /// covered by tests; production runs this exact array.\n125|    public enum ConfigInvocation {\n126|        public static func arguments(_ spec: ConfigSpec) -> [String] {\n127|            var args = [\n128|                \"--url\", spec.scopeURL,\n129|                \"--token\", spec.token,\n130|                \"--name\", spec.name,\n131|                \"--work\", spec.workFolder,\n132|                \"--labels\", spec.labels.joined(separator: \",\")\n133|            ]\n134|            if let group = spec.runnerGroup, !group.isEmpty {\n135|                args += [\"--runnergroup\", group]\n136|            }\n137|            args += [\"--unattended\"]\n138|            if spec.replace {\n139|                args += [\"--replace\"]\n140|            }\n141|            return args\n142|        }\n143|    }\n144|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
