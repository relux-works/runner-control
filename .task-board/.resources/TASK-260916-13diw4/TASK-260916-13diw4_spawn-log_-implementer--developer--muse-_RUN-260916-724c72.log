{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c46d","stream":{"kind":"session","id":"01a0a895-af1e-7030-b7a0-b39b63843e96"},"sequence":145,"recorded_at":1780531400000285,"record_type":"event","durability":"durable","causation_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332","run_stream":{"kind":"run","id":"a6dbad5b-a9c9-418a-a77b-cbe6123a6332"},"task_stream":{"kind":"task","id":"01a0a895-f9d6-7e41-9fa1-2b68dd8d07ea"},"task_id":"01a0a895-f9d6-7e41-9fa1-2b68dd8d07ea","event":{"kind":"output","task_id":"01a0a895-f9d6-7e41-9fa1-2b68dd8d07ea","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension RunnerRegistration {\n5|    public protocol IFlow: Relux.Flow {}\n6|\n7|    public actor Flow {\n8|        public let dispatcher: Relux.Dispatcher\n9|        private let api: GitHubRunnerAPIClient\n10|        private let installer: RunnerInstallerService\n11|        private let registrationTokens: any RunnerRegistrationTokenStoring\n12|        private let userStore: any GitHubCredentialStoring\n13|        private let identities: any GitHubSessionIdentityStoring\n14|        private let refresher: GitHubTokenRefresh\n15|        private let configProvider: @Sendable (String?) throws -> GitHubAuth.AppConfig\n16|        private let now: @Sendable () -> Date\n17|\n18|        private var generation = 0\n19|        private var working = false\n20|        private var draft: Draft?\n21|        private var group: RunnerGroup?\n22|        private var asset: DownloadAsset?\n23|        private var installPath: String?\n24|        private var runnerID: Int64?\n25|        private var failedStep: String?\n26|        private var pendingRepositoryIDs: Set<Int64>?\n27|        private var pendingTargetGroupID: Int64?\n28|        private var pendingLabels: [String]?\n29|\n30|        public init(\n31|            api: GitHubRunnerAPIClient,\n32|            installer: RunnerInstallerService,\n33|            registrationTokens: any RunnerRegistrationTokenStoring,\n34|            userStore: any GitHubCredentialStoring,\n35|            identityStore: any GitHubSessionIdentityStoring,\n36|            refresher: GitHubTokenRefresh,\n37|            configProvider: (@Sendable (String?) throws -> GitHubAuth.AppConfig)? = nil,\n38|            now: (@Sendable () -> Date)? = nil,\n39|            dispatcher: Relux.Dispatcher? = nil\n40|        ) async {\n41|            self.api = api\n42|            self.installer = installer\n43|            self.registrationTokens = registrationTokens\n44|            self.userStore = userStore\n45|            self.identities = identityStore\n46|            self.refresher = refresher\n47|            self.configProvider = configProvider ?? { host in\n48|                try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\")\n49|            }\n50|            self.now = now ?? Date.init\n51|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n52|        }\n53|\n54|        /// Deterministic LaunchAgent label for a draft. Always carries the\n55|        /// `actions.runner.` prefix discovery requires.\n56|        public nonisolated static func serviceLabel(draft: Draft) -> String {\n57|            let scope = draft.scope.detail.replacingOccurrences(of: \"/\", with: \"-\")\n58|            let raw = \"actions.runner.\\(scope).\\(draft.installDirName)\"\n59|            let allowed = CharacterSet.alphanumerics.union(CharacterSet(charactersIn: \".-\"))\n60|            return raw.unicodeScalars.map { allowed.contains($0) ? String($0) : \"-\" }.joined()\n61|        }\n62|\n63|        public nonisolated static func tokenScopeKey(draft: Draft) -> String {\n64|            \"\\(draft.scope.scopeKey):\\(draft.installDirName)\"\n65|        }\n66|    }\n67|}\n68|\n69|/// Authenticated user token for wizard API calls. Never logged.\n70|private struct FlowUserToken: Sendable {\n71|    let config: GitHubAuth.AppConfig\n72|    let token: String\n73|    let identity: GitHubSessionIdentity\n74|}\n75|\n76|extension RunnerRegistration.Flow: RunnerRegistration.IFlow {\n77|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n78|        guard let effect = effect as? RunnerRegistration.Effect else { return .success }\n79|        switch effect {\n80|        case .beginDraft(let draft): await beginDraft(draft)\n81|        case .updateDraft(let draft): await updateDraft(draft)\n82|        case .resolveGroup: await resolveGroup()\n83|        case .prepareDownload: await prepareDownload()\n84|        case .downloadAndInstall: await downloadAndInstall()\n85|        case .registerRunner: await registerRunner()\n86|        case .setupService: await setupService()\n87|        case .applyRepositoryAccess(let groupID, let ids): await applyRepositoryAccess(groupID: groupID, ids: ids)\n88|        case .applyLabels(let labels): await applyLabels(labels)\n89|        case .retry: await retry()\n90|        case .cancel: await cancel()\n91|        case .reset: await reset()\n92|        case .dismissPermission: await action { RunnerRegistration.Action.permissionDismissed }\n93|        }\n94|        return .success\n95|    }\n96|\n97|    private func isStale(_ gen: Int) -> Bool { generation != gen }\n98|\n99|    // MARK: - Draft\n100|\n101|    private func beginDraft(_ draft: RunnerRegistration.Draft) async {\n102|        do {\n103|            try RunnerRegistration.Gates.validateDraft(draft)\n104|        } catch {\n105|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"beginDraft\") }\n106|            return\n107|        }\n108|        self.draft = draft\n109|        group = nil\n110|        asset = nil\n111|        installPath = nil\n112|        runnerID = nil\n113|        failedStep = nil\n114|        await action { RunnerRegistration.Action.draftBegan(draft) }\n115|    }\n116|\n117|    private func updateDraft(_ draft: RunnerRegistration.Draft) async {\n118|        do {\n119|            try RunnerRegistration.Gates.validateDraft(draft)\n120|        } catch {\n121|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"updateDraft\") }\n122|            return\n123|        }\n124|        // A scope change invalidates resolved group/download state.\n125|        if self.draft?.scope != draft.scope {\n126|            group = nil\n127|            asset = nil\n128|        }\n129|        self.draft = draft\n130|        await action { RunnerRegistration.Action.draftUpdated(draft) }\n131|    }\n132|\n133|    // MARK: - Auth\n134|\n135|    private func currentUserToken(generation gen: Int) async throws -> FlowUserToken {\n136|        guard let identity = await identities.load() else {\n137|            throw RunnerRegistration.RegistrationError.notAuthenticated\n138|        }\n139|        let config = try configProvider(identity.serverHost)\n140|        guard var record = await userStore.load(\n141|            serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID\n142|        ) else {\n143|            throw RunnerRegistration.RegistrationError.notAuthenticated\n144|        }\n145|        guard !isStale(gen) else { throw CancellationError() }\n146|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n147|            do {\n148|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n149|            } catch is CancellationError {\n150|                throw CancellationError()\n151|            } catch let error as GitHubAuth.AuthError {\n152|                switch error {\n153|                case .revoked, .unauthorized, .tokenRefreshFailed:\n154|                    throw RunnerRegistration.RegistrationError.unauthorized\n155|                default:\n156|                    break\n157|                }\n158|            }\n159|            guard !isStale(gen) else { throw CancellationError() }\n160|        }\n161|        return FlowUserToken(config: config, token: record.accessToken, identity: identity)\n162|    }\n163|\n164|    private func fail(_ error: Error, step: String, generation gen: Int) async {\n165|        guard !isStale(gen) else { return }\n166|        failedStep = step\n167|        if error is CancellationError { return }\n168|        if let reg = error as? RunnerRegistration.RegistrationError {\n169|            switch reg {\n170|            case .missingPermission, .forbidden:\n171|                await action {\n172|                    RunnerRegistration.Action.permissionDenied(message: reg.localizedDescription, step: step)\n173|                }\n174|                return\n175|            default:\n176|                break\n177|            }\n178|        }\n179|        let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n180|        await action { RunnerRegistration.Action.failed(message: message, step: step) }\n181|    }\n182|\n183|    private func finishStep(_ step: String, generation gen: Int) async {\n184|        guard !isStale(gen) else { return }\n185|        failedStep = nil\n186|        working = false\n187|        await action { RunnerRegistration.Action.stepFinished(step) }\n188|    }\n189|\n190|    // MARK: - Group\n191|\n192|    private func resolveGroup() async {\n193|        let gen = generation\n194|        guard !working else { return }\n195|        guard let draft else {\n196|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"resolveGroup\") }\n197|            return\n198|        }\n199|        do {\n200|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n201|        } catch {\n202|            failedStep = \"resolveGroup\"\n203|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"resolveGroup\") }\n204|            return\n205|        }\n206|        guard case .organization(let org) = draft.scope else { return }\n207|        working = true\n208|        await action { RunnerRegistration.Action.stepStarted(\"resolveGroup\") }\n209|        do {\n210|            let auth = try await currentUserToken(generation: gen)\n211|            guard !isStale(gen) else { return }\n212|            let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n213|            guard !isStale(gen) else { return }\n214|            let name = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n215|            let resolved: RunnerRegistration.RunnerGroup\n216|            if let existing = groups.first(where: { $0.name == name }) {\n217|                // Name alone never authorizes adoption: require a locally\n218|                // recorded ownership entry or explicit takeover confirmation.\n219|                let owned = await installer.loadOwnedGroupID(org: org, name: name)\n220|                try RunnerRegistration.Gates.authorizeGroupTakeover(\n221|                    groupName: name, existingID: existing.id,\n222|                    ownedID: owned, allowTakeover: draft.allowGroupTakeover\n223|                )\n224|                if owned != existing.id {\n225|                    try await installer.saveOwnedGroupID(org: org, name: name, groupID: existing.id)\n226|                }\n227|                guard !isStale(gen) else { return }\n228|                // A pre-existing group may deny public repos (GitHub default\n229|                // false), which would silently drop selected public repos.\n230|                if existing.allowsPublicRepositories {\n231|                    resolved = existing\n232|                } else {\n233|                    resolved = try await api.updateGroupAllowsPublic(\n234|                        config: auth.config, token: auth.token, org: org,\n235|                        groupID: existing.id, allowsPublic: true\n236|                    )\n237|                }\n238|            } else {\n239|                resolved = try await api.createGroup(\n240|                    config: auth.config, token: auth.token, org: org,\n241|                    name: name, selectedRepositoryIDs: draft.selectedRepositoryIDs,\n242|                    allowsPublicRepositories: true\n243|                )\n244|                guard !isStale(gen) else { return }\n245|                try await installer.saveOwnedGroupID(org: org, name: name, groupID: resolved.id)\n246|            }\n247|            guard !isStale(gen) else { return }\n248|            let repoIDs = try await api.fetchGroupRepositories(\n249|                config: auth.config, token: auth.token, org: org, groupID: resolved.id\n250|            )\n251|            guard !isStale(gen) else { return }\n252|            group = resolved\n253|            await action { RunnerRegistration.Action.groupResolved(resolved, repositoryIDs: repoIDs) }\n254|            guard !isStale(gen) else { return }\n255|            await action { RunnerRegistration.Action.permissionDismissed }\n256|            await finishStep(\"resolveGroup\", generation: gen)\n257|        } catch {\n258|            working = false\n259|            await fail(error, step: \"resolveGroup\", generation: gen)\n260|        }\n261|    }\n262|\n263|    // MARK: - Download\n264|\n265|    private func prepareDownload() async {\n266|        let gen = generation\n267|        guard !working else { return }\n268|        guard let draft else {\n269|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"prepareDownload\") }\n270|            return\n271|        }\n272|        working = true\n273|        await action { RunnerRegistration.Action.stepStarted(\"prepareDownload\") }\n274|        do {\n275|            let found = try await prepareDownloadInner(draft: draft, generation: gen)\n276|            guard !isStale(gen) else { return }\n277|            asset = found\n278|            await action { RunnerRegistration.Action.downloadReady(found) }\n279|            await finishStep(\"prepareDownload\", generation: gen)\n280|        } catch {\n281|            working = false\n282|            await fail(error, step: \"prepareDownload\", generation: gen)\n283|        }\n284|    }\n285|\n286|    private func prepareDownloadInner(\n287|        draft: RunnerRegistration.Draft, generation gen: Int\n288|    ) async throws -> RunnerRegistration.DownloadAsset {\n289|        let auth = try await currentUserToken(generation: gen)\n290|        guard !isStale(gen) else { throw CancellationError() }\n291|        let assets = try await api.fetchDownloads(config: auth.config, token: auth.token, scope: draft.scope)\n292|        guard !isStale(gen) else { throw CancellationError() }\n293|        return try RunnerRegistration.Gates.selectDownload(\n294|            osName: RunnerInstallerService.installOS,\n295|            arch: installer.architecture,\n296|            from: assets\n297|        )\n298|    }\n299|\n300|    // MARK: - Install\n301|\n302|    private func downloadAndInstall() async {\n303|        let gen = generation\n304|        guard !working else { return }\n305|        guard let draft else {\n306|            await action {\n307|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"downloadAndInstall\")\n308|            }\n309|            return\n310|        }\n311|        working = true\n312|        await action { RunnerRegistration.Action.stepStarted(\"downloadAndInstall\") }\n313|        do {\n314|            let resolved: RunnerRegistration.DownloadAsset\n315|            if let asset {\n316|                resolved = asset\n317|            } else {\n318|                resolved = try await prepareDownloadInner(draft: draft, generation: gen)\n319|                guard !isStale(gen) else { return }\n320|                asset = resolved\n321|                await action { RunnerRegistration.Action.downloadReady(resolved) }\n322|            }\n323|            guard !isStale(gen) else { return }\n324|            let directory = try await installer.downloadAndInstall(asset: resolved, draft: draft)\n325|            guard !isStale(gen) else { return }\n326|            installPath = directory.path\n327|            await action { RunnerRegistration.Action.installed(path: directory.path) }\n328|            await finishStep(\"downloadAndInstall\", generation: gen)\n329|        } catch {\n330|            working = false\n331|            await fail(error, step: \"downloadAndInstall\", generation: gen)\n332|        }\n333|    }\n334|\n335|    // MARK: - Register\n336|\n337|    private func registerRunner() async {\n338|        let gen = generation\n339|        guard !working else { return }\n340|        guard let draft else {\n341|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"registerRunner\") }\n342|            return\n343|        }\n344|        guard let installPath else {\n345|            failedStep = \"registerRunner\"\n346|            await action {\n347|                RunnerRegistration.Action.failed(message: \"Install the runner package first.\", step: \"registerRunner\")\n348|            }\n349|            return\n350|        }\n351|        working = true\n352|        await action { RunnerRegistration.Action.stepStarted(\"registerRunner\") }\n353|        let directory = URL(fileURLWithPath: installPath)\n354|        let scopeKey = Self.tokenScopeKey(draft: draft)\n355|        do {\n356|            // Idempotent resume: an already-configured directory never mints\n357|            // a second registration token or a duplicate GitHub registration.\n358|            if await installer.hasCompleted(RunnerInstallerService.stepConfigured, directory: directory) {\n359|                let localID = await installer.readAgentID(directory: directory)\n360|                let remoteID = try await resolveRemoteRunnerID(draft: draft, generation: gen)\n361|                guard !isStale(gen) else { return }\n362|                runnerID = remoteID\n363|                await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: localID) }\n364|                await finishStep(\"registerRunner\", generation: gen)\n365|                return\n366|            }\n367|            let auth = try await currentUserToken(generation: gen)\n368|            guard !isStale(gen) else { return }\n369|            // Duplicate guard before any token is minted: without explicit\n370|            // replace consent a remote name match refuses the run so config\n371|            // can never silently replace another machine's registration.\n372|            // Bound: the runners list is first-page only (per_page=100); a\n373|            // duplicate beyond it still fails at config.sh, which omits\n374|            // `--replace` unless the user explicitly allowed it.\n375|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n376|            let existing = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n377|            guard !isStale(gen) else { return }\n378|            try RunnerRegistration.Gates.rejectRemoteDuplicate(\n379|                name: wanted, isTaken: existing.contains(where: { $0.name == wanted }),\n380|                allowReplace: draft.allowReplace\n381|            )\n382|            guard !isStale(gen) else { return }\n383|            let created = try await api.createRegistrationToken(\n384|                config: auth.config, token: auth.token, scope: draft.scope\n385|            )\n386|            guard !isStale(gen) else { return }\n387|            let scoped = RunnerRegistration.ScopedToken(\n388|                token: created.token, expiresAt: created.expiresAt, obtainedAt: now()\n389|            )\n390|            try await registrationTokens.save(scoped, scopeKey: scopeKey)\n391|            guard !isStale(gen) else { return }\n392|            let groupName: String?\n393|            switch draft.scope {\n394|            case .organization: groupName = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n395|            case .repository: groupName = nil\n396|            }\n397|            let localID: Int64?\n398|            do {\n399|                localID = try await installer.runConfig(\n400|                    directory: directory,\n401|                    scopeURL: draft.scope.configURL(serverHost: auth.identity.serverHost),\n402|                    token: created.token,\n403|                    draft: draft,\n404|                    runnerGroup: groupName\n405|                )\n406|            } catch {\n407|                await registrationTokens.delete(scopeKey: scopeKey)\n408|                throw error\n409|            }\n410|            // The single-use token is consumed by config.sh: delete it before\n411|            // any follow-up API call so a post-config failure (review F6)\n412|            // reports the error without retaining the token.\n413|            await registrationTokens.delete(scopeKey: scopeKey)\n414|            guard !isStale(gen) else { return }\n415|            let remoteID = try await resolveRemoteRunnerID(draft: draft, generation: gen)\n416|            guard !isStale(gen) else { return }\n417|            runnerID = remoteID\n418|            await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: localID) }\n419|            guard !isStale(gen) else { return }\n420|            await action { RunnerRegistration.Action.permissionDismissed }\n421|            await finishStep(\"registerRunner\", generation: gen)\n422|        } catch {\n423|            working = false\n424|            await fail(error, step: \"registerRunner\", generation: gen)\n425|        }\n426|    }\n427|\n428|    /// Fetches the real GitHub runner ID by matching the registered name.\n429|    /// Returns nil when the runner list does not (yet) contain it.\n430|    private func resolveRemoteRunnerID(draft: RunnerRegistration.Draft, generation gen: Int) async throws -> Int64? {\n431|        let auth = try await currentUserToken(generation: gen)\n432|        guard !isStale(gen) else { throw CancellationError() }\n433|        let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n434|        let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n435|        return runners.first(where: { $0.name == wanted })?.id\n436|    }\n437|\n438|    // MARK: - Service\n439|\n440|    private func setupService() async {\n441|        let gen = generation\n442|        guard !working else { return }\n443|        guard let draft, let installPath else {\n444|            await action {\n445|                RunnerRegistration.Action.failed(message: \"Register the runner first.\", step: \"setupService\")\n446|            }\n447|            return\n448|        }\n449|        working = true\n450|        await action { RunnerRegistration.Action.stepStarted(\"setupService\") }\n451|        do {\n452|            let directory = URL(fileURLWithPath: installPath)\n453|            let label = Self.serviceLabel(draft: draft)\n454|            let plist = try await installer.setupService(directory: directory, label: label)\n455|            guard !isStale(gen) else { return }\n456|            await action { RunnerRegistration.Action.serviceReady(plistPath: plist.path) }\n457|            await finishStep(\"setupService\", generation: gen)\n458|        } catch {\n459|            working = false\n460|            await fail(error, step: \"setupService\", generation: gen)\n461|        }\n462|    }\n463|\n464|    // MARK: - Editable access and labels\n465|\n466|    private func applyRepositoryAccess(groupID: Int64, ids: Set<Int64>) async {\n467|        let gen = generation\n468|        guard !working else { return }\n469|        guard let draft else {\n470|            await action {\n471|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyRepositoryAccess\")\n472|            }\n473|            return\n474|        }\n475|        do {\n476|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n477|            guard case .organization(let org) = draft.scope else { return }\n478|            guard let group else {\n479|                failedStep = \"applyRepositoryAccess\"\n480|                await action {\n481|                    RunnerRegistration.Action.failed(\n482|                        message: \"Resolve the dedicated group first.\", step: \"applyRepositoryAccess\"\n483|                    )\n484|                }\n485|                return\n486|            }\n487|            try RunnerRegistration.Gates.authorizeGroupMutation(\n488|                targetGroupID: groupID, resolvedGroupID: group.id,\n489|                allowFlag: draft.allowGroupMutation\n490|            )\n491|            working = true\n492|            pendingRepositoryIDs = ids\n493|            pendingTargetGroupID = groupID\n494|            await action { RunnerRegistration.Action.stepStarted(\"applyRepositoryAccess\") }\n495|            let auth = try await currentUserToken(generation: gen)\n496|            guard !isStale(gen) else { return }\n497|            try await api.setGroupRepositories(\n498|                config: auth.config, token: auth.token, org: org, groupID: group.id, selectedRepositoryIDs: ids\n499|            )\n500|            guard !isStale(gen) else { return }\n(more lines below)","final_result":true}}}
