   let localAgentID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n821|                local: local, configured: configured, draft: draft,\n822|                serverHost: auth.identity.serverHost\n823|            )\n824|            guard !isStale(gen) else { return }\n825|            // Re-bind on every write: the stored ID is never trusted across\n826|            // edits, retries, or remote drift. A missing agent fails with\n827|            // not-found; a contradictory list fails with mismatch. Neither\n828|            // guesses by name.\n829|            let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n830|            guard !isStale(gen) else { return }\n831|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n832|            let bound = try RunnerRegistration.Gates.boundRemoteRunnerID(\n833|                localAgentID: localAgentID, name: wanted, runners: runners\n834|            )\n835|            guard let runnerID = bound else {\n836|                throw RunnerRegistration.RegistrationError.remoteRunnerNotFound(\n837|                    \"GitHub does not list agent \\(localAgentID) for this scope yet; refusing to guess '\\(wanted)' by name. Retry after registration converges.\"\n838|                )\n839|            }\n840|            try await api.setRunnerLabels(\n841|                config: auth.config, token: auth.token, scope: draft.scope, runnerID: runnerID, labels: trimmed\n842|            )\n843|            guard !isStale(gen) else { return }\n844|            self.runnerID = runnerID\n845|            if var current = self.draft {\n846|                current.labels = trimmed\n847|                self.draft = current\n848|            }\n849|            await action { RunnerRegistration.Action.labelsApplied(trimmed) }\n850|            pendingLabels = nil\n851|            await finishStep(\"applyLabels\", generation: gen)\n852|        } catch {\n853|            working = false\n854|            await fail(error, step: \"applyLabels\", generation: gen)\n855|        }\n856|    }\n857|\n858|    // MARK: - Retry / cancel / reset\n859|\n860|    private func retry() async {\n861|        guard !working else { return }\n862|        guard let step = failedStep else { return }\n863|        switch step {\n864|        case \"resolveGroup\": await resolveGroup()\n865|        case \"prepareDownload\": await prepareDownload()\n866|        case \"downloadAndInstall\": await downloadAndInstall()\n867|        case \"registerRunner\": await registerRunner()\n868|        case \"setupService\": await setupService()\n869|        case \"applyRepositoryAccess\":\n870|            if let ids = pendingRepositoryIDs, let target = pendingTargetGroupID {\n871|                await applyRepositoryAccess(groupID: target, ids: ids)\n872|            }\n873|        case \"applyLabels\":\n874|            if let labels = pendingLabels { await applyLabels(labels) }\n875|        default:\n876|            return\n877|        }\n878|    }\n879|\n880|    private func cancel() async {\n881|        generation += 1\n882|        working = false\n883|        workingStep = nil\n884|        if let draft {\n885|            await registrationTokens.delete(scopeKey: Self.tokenScopeKey(draft: draft))\n886|        }\n887|        failedStep = nil\n888|        pendingRepositoryIDs = nil\n889|        pendingTargetGroupID = nil\n890|        pendingLabels = nil\n891|        await action { RunnerRegistration.Action.cancelled }\n892|    }\n893|\n894|    private func reset() async {\n895|        generation += 1\n896|        working = false\n897|        workingStep = nil\n898|        if let draft {\n899|            await registrationTokens.delete(scopeKey: Self.tokenScopeKey(draft: draft))\n900|        }\n901|        draft = nil\n902|        group = nil\n903|        asset = nil\n904|        installPath = nil\n905|        runnerID = nil\n906|        failedStep = nil\n907|        pendingRepositoryIDs = nil\n908|        pendingTargetGroupID = nil\n909|        pendingLabels = nil\n910|        boundServerHost = nil\n911|        await action { RunnerRegistration.Action.didReset }\n912|    }\n913|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
