{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c935","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":757,"recorded_at":1780531400001509,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"task_stream":{"kind":"task","id":"01a0a8e3-de1d-7bf1-94a4-32c70ef3bc65"},"task_id":"01a0a8e3-de1d-7bf1-94a4-32c70ef3bc65","event":{"kind":"output","task_id":"01a0a8e3-de1d-7bf1-94a4-32c70ef3bc65","chunk":"edited\nchanged lines: lines 47-52\n--- original\n+++ updated\n@@\n-    public nonisolated var root: URL { installRoot }\n-    public nonisolated var architecture: String { currentArch() }\n-\n-    public func directory(for installDirName: String) -> URL {\n-        installRoot.appendingPathComponent(installDirName)\n-    }\n+    public nonisolated var root: URL { installRoot }\n+    public nonisolated var architecture: String { currentArch() }\n+\n+    /// Canonical installation directories with a live mutating side effect\n+    /// (download/extract/config/service/recovery). Acquired synchronously\n+    /// before the first await and released only when the owning operation\n+    /// settles, so actor reentrancy can never admit two mutations of one\n+    /// directory. Abandoning a UI generation does not release this resource;\n+    /// only the settling side effect does.\n+    private var activeDirectories: Set<String> = []\n+\n+    public func directory(for installDirName: String) -> URL {\n+        installRoot.appendingPathComponent(installDirName)\n+    }\n+\n+    /// Canonical lease key for a directory. Both Flow-derived URLs (from a\n+    /// stored install path) and `directory(for:)` URLs map to the same key\n+    /// for the same on-disk location.\n+    nonisolated static func leaseKey(for directory: URL) -> String {\n+        URL(fileURLWithPath: directory.path).standardizedFileURL.path\n+    }\n+\n+    /// Acquires exclusive ownership of `directory`. Synchronous: callers must\n+    /// invoke it before their first await so the check-and-insert is atomic\n+    /// under actor isolation. Throws a retryable `directoryBusy` when another\n+    /// live operation already owns the directory; different directories never\n+    /// conflict.\n+    private func acquireLease(for directory: URL) throws {\n+        let key = Self.leaseKey(for: directory)\n+        guard !activeDirectories.contains(key) else {\n+            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n+        }\n+        activeDirectories.insert(key)\n+    }\n+\n+    private func releaseLease(for directory: URL) {\n+        activeDirectories.remove(Self.leaseKey(for: directory))\n+    }\n+\n+    /// Refuses a synchronous mutation (service setup, recovery) while a live\n+    /// async side effect owns the directory. No insert: without an await the\n+    /// caller itself cannot interleave, it only needs to respect leases held\n+    /// by others.\n+    private func requireIdleDirectory(_ directory: URL) throws {\n+        guard !activeDirectories.contains(Self.leaseKey(for: directory)) else {\n+            throw RunnerRegistration.RegistrationError.directoryBusy(path: directory.path)\n+        }\n+    }\n","final_result":true}}}
