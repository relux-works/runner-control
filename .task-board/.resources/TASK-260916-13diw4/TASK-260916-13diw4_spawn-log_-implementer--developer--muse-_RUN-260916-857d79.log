{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a9","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":431,"recorded_at":1780531400000857,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"call_id":"call_01a0a8dfcc2971b9ad197f73252f34e5","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+State+Reducer.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension RunnerRegistration.State {\n5|    public func reduce(with action: any Relux.Action) async {\n6|        guard let action = action as? RunnerRegistration.Action else { return }\n7|        if reduceDraftAction(action) { return }\n8|        if reduceProgressAction(action) { return }\n9|        await reduceResultAction(action)\n10|    }\n11|\n12|    /// Draft lifecycle actions. Returns true when the action was handled.\n13|    private func reduceDraftAction(_ action: RunnerRegistration.Action) -> Bool {\n14|        switch action {\n15|        case .draftBegan(let draft):\n16|            self.draft = draft\n17|            phase = .drafting\n18|            group = nil\n19|            groupRepositoryIDs = []\n20|            asset = nil\n21|            installPath = nil\n22|            runnerID = nil\n23|            localAgentID = nil\n24|            completedSteps = []\n25|            error = nil\n26|            failedStep = nil\n27|        case .draftUpdated(let draft):\n28|            if let old = self.draft {\n29|                invalidateProgress(old: old, new: draft)\n30|            }\n31|            self.draft = draft\n32|            // Draft edits retain the permission error by design.\n33|            if error != nil, permissionError == nil {\n34|                error = nil\n35|                failedStep = nil\n36|            }\n37|        case .cancelled:\n38|            working = false\n39|            error = nil\n40|            failedStep = nil\n41|        default:\n42|            return false\n43|        }\n44|        return true\n45|    }\n46|\n47|    /// Invalidates cached progress bound to the changed identity fields, so a\n48|    /// scope/install/name/group/work-folder edit never displays another\n49|    /// registration's evidence as this draft's. Mirrors the Flow's\n50|    /// invalidation. Group is part of the config identity: a group edit drops\n51|    /// registration evidence as well.\n52|    private func invalidateProgress(old: RunnerRegistration.Draft, new: RunnerRegistration.Draft) {\n53|        if old.scope != new.scope {\n54|            group = nil\n55|            groupRepositoryIDs = []\n56|            asset = nil\n57|            installPath = nil\n58|            runnerID = nil\n59|            localAgentID = nil\n60|            completedSteps = []\n61|            failedStep = nil\n62|            if phase == .done { phase = .drafting }\n63|            return\n64|        }\n65|        if old.installDirName != new.installDirName {\n66|            installPath = nil\n67|            runnerID = nil\n68|            localAgentID = nil\n69|            completedSteps.subtract([\"downloadAndInstall\", \"registerRunner\", \"setupService\", \"applyLabels\"])\n70|            if [\"downloadAndInstall\", \"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n71|                failedStep = nil\n72|            }\n73|            if phase == .done { phase = .drafting }\n74|        }\n75|        let oldName = old.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n76|        let newName = new.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n77|        if oldName != newName {\n78|            runnerID = nil\n79|            localAgentID = nil\n80|            completedSteps.subtract([\"registerRunner\", \"setupService\", \"applyLabels\"])\n81|            if [\"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n82|                failedStep = nil\n83|            }\n84|            if phase == .done { phase = .drafting }\n85|        }\n86|        let oldIsOrg: Bool = if case .organization = old.scope { true } else { false }\n87|        let newIsOrg: Bool = if case .organization = new.scope { true } else { false }\n88|        if oldIsOrg || newIsOrg {\n89|            let oldGroup = old.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n90|            let newGroup = new.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n91|            if oldGroup != newGroup {\n92|                group = nil\n93|                groupRepositoryIDs = []\n94|                runnerID = nil\n95|                localAgentID = nil\n96|                completedSteps.subtract([\n97|                    \"resolveGroup\", \"applyRepositoryAccess\",\n98|                    \"registerRunner\", \"setupService\", \"applyLabels\",\n99|                ])\n100|                if [\"resolveGroup\", \"applyRepositoryAccess\", \"registerRunner\", \"setupService\", \"applyLabels\"]\n101|                    .contains(failedStep ?? \"\") {\n102|                    failedStep = nil\n103|                }\n104|                if phase == .done { phase = .drafting }\n105|            }\n106|        }\n107|        if old.workFolder != new.workFolder {\n108|            runnerID = nil\n109|            localAgentID = nil\n110|            completedSteps.subtract([\"registerRunner\", \"setupService\", \"applyLabels\"])\n111|            if [\"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n112|                failedStep = nil\n113|            }\n114|            if phase == .done { phase = .drafting }\n115|        }\n116|    }\n117|\n118|    /// Step progress actions. Returns true when the action was handled.\n119|    private func reduceProgressAction(_ action: RunnerRegistration.Action) -> Bool {\n120|        switch action {\n121|        case .stepStarted(let step):\n122|            working = true\n123|            error = nil\n124|            failedStep = nil\n125|            reducePhase(step)\n126|        case .stepFinished(let step):\n127|            working = false\n128|            completedSteps.insert(step)\n129|        case .permissionDismissed:\n130|            permissionError = nil\n131|        default:\n132|            return false\n133|        }\n134|        return true\n135|    }\n136|\n137|    private func reducePhase(_ step: String) {\n138|        switch step {\n139|        case \"resolveGroup\": phase = .resolvingGroup\n140|        case \"prepareDownload\": phase = .preparingDownload\n141|        case \"downloadAndInstall\": phase = .installing\n142|        case \"registerRunner\": phase = .registering\n143|        case \"setupService\": phase = .settingUpService\n144|        default: break\n145|        }\n146|    }\n147|\n148|    /// Fetched results, failures, and reset.\n149|    private func reduceResultAction(_ action: RunnerRegistration.Action) async {\n150|        if reduceFetchResult(action) { return }\n151|        switch action {\n152|        case .failed(let message, let step):\n153|            working = false\n154|            error = message\n155|            failedStep = step\n156|        case .permissionDenied(let message, let step):\n157|            working = false\n158|            error = message\n159|            failedStep = step\n160|            permissionError = message\n161|        case .didReset:\n162|            await cleanup()\n163|        default:\n164|            break\n165|        }\n166|    }\n167|\n168|    /// Fetched values applied to state. Returns true when handled.\n169|    private func reduceFetchResult(_ action: RunnerRegistration.Action) -> Bool {\n170|        switch action {\n171|        case .groupResolved(let group, let repositoryIDs):\n172|            self.group = group\n173|            groupRepositoryIDs = repositoryIDs\n174|        case .downloadReady(let asset):\n175|            self.asset = asset\n176|        case .installed(let path):\n177|            installPath = path\n178|        case .registered(let runnerID, let localAgentID):\n179|            self.runnerID = runnerID\n180|            self.localAgentID = localAgentID\n181|        case .serviceReady:\n182|            phase = .done\n183|        case .repositoryAccessApplied(let ids):\n184|            groupRepositoryIDs = ids\n185|            syncDraftRepositories(ids)\n186|        case .labelsApplied(let labels):\n187|            syncDraftLabels(labels)\n188|        default:\n189|            return false\n190|        }\n191|        return true\n192|    }\n193|\n194|    private func syncDraftRepositories(_ ids: [Int64]) {\n195|        if var current = draft {\n196|            current.selectedRepositoryIDs = Set(ids)\n197|            draft = current\n198|        }\n199|    }\n200|\n201|    private func syncDraftLabels(_ labels: [String]) {\n202|        if var current = draft {\n203|            current.labels = labels\n204|            draft = current\n205|        }\n206|    }\n207|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
