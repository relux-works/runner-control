{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c867","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":654,"recorded_at":1780531400001303,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"task_stream":{"kind":"task","id":"01a0a8e3-33e3-7581-bd44-81c933d5d478"},"task_id":"01a0a8e3-33e3-7581-bd44-81c933d5d478","event":{"kind":"output","task_id":"01a0a8e3-33e3-7581-bd44-81c933d5d478","chunk":"Read text file `Targets/RunnerControl/Sources/RunnerRegistrationPage.swift`.\n(139 line(s) above)\n140|    let reactions: Reactions\n141|\n142|    var body: some View {\n143|        VStack(alignment: .leading, spacing: 16) {\n144|            scopeSection\n145|            runnerSection\n146|            if props.scopeKind == .organization {\n147|                groupSection\n148|            }\n149|            if props.working {\n150|                Text(\"Правка области, имени, папок или группы во время работы отменяет текущий шаг — повторите его после правки. Правка меток отменяет применение меток, правка репозиториев — применение доступа.\")\n151|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n152|            }\n153|        }\n154|    }\n155|\n156|    private var scopeSection: some View {\n157|        VStack(alignment: .leading, spacing: 8) {\n158|            Text(\"Область регистрации\").font(.system(size: 13, weight: .semibold))\n159|            Picker(\"Область\", selection: Binding(\n160|                get: { props.scopeKind },\n161|                set: reactions.scopeKindChanged\n162|            )) {\n163|                Text(\"Организация\").tag(ScopeKind.organization)\n164|                Text(\"Репозиторий\").tag(ScopeKind.repository)\n165|            }\n166|            .pickerStyle(.segmented)\n167|            .frame(width: 320)\n168|            .accessibilityIdentifier(\"Registration scope picker\")\n169|            if props.scopeKind == .organization {\n170|                labeledField(\n171|                    \"Организация\", text: props.org, set: reactions.orgChanged,\n172|                    placeholder: \"acme\", id: \"Registration org field\"\n173|                )\n174|            } else {\n175|                HStack(spacing: 8) {\n176|                    labeledField(\n177|                        \"Владелец\", text: props.repoOwner, set: reactions.repoOwnerChanged,\n178|                        placeholder: \"octo\", id: \"Registration repo owner field\"\n179|                    )\n180|                    labeledField(\n181|                        \"Репозиторий\", text: props.repoName, set: reactions.repoNameChanged,\n182|                        placeholder: \"app\", id: \"Registration repo name field\"\n183|                    )\n184|                }\n185|                Text(\"Личные репозитории получают отдельную установку без общих групп.\")\n186|                    .font(.system(size: 11)).foregroundStyle(.secondary)\n187|            }\n188|        }\n189|    }\n190|\n191|    private var runnerSection: some View {\n192|        VStack(alignment: .leading, spacing: 8) {\n193|            Text(\"Раннер\").font(.system(size: 13, weight: .semibold))\n194|            labeledField(\n195|                \"Имя раннера\", text: props.runnerName, set: reactions.runnerNameChanged,\n196|                placeholder: Host.current().localizedName ?? \"macbook\",\n197|                id: \"Registration runner name field\"\n198|            )\n199|            labeledField(\n200|                \"Метки (через запятую)\", text: props.labelsText, set: reactions.labelsChanged,\n201|                placeholder: \"self-hosted, macOS\", id: \"Registration labels field\"\n202|            )\n203|            HStack(spacing: 8) {\n204|                labeledField(\n205|                    \"Папка установки\", text: props.installDirName, set: reactions.installDirChanged,\n206|                    placeholder: \"macbook-iv\", id: \"Registration install dir field\"\n207|                )\n208|                labeledField(\n209|                    \"Рабочая папка\", text: props.workFolder, set: reactions.workFolderChanged,\n210|                    placeholder: \"_work\", id: \"Registration work folder field\"\n211|                )\n212|            }\n213|            VStack(alignment: .leading, spacing: 2) {\n214|                Text(\"Пути без пробелов: ~/Library/GitHubActions/<папка>.\")\n215|                Text(\"Повторный запуск продолжает с места остановки и не создаёт дубликатов.\")\n216|            }\n217|            .font(.system(size: 11)).foregroundStyle(.secondary)\n218|            Toggle(\n219|                \"Заменить регистрацию GitHub с таким же именем (опасно для других Mac)\",\n(more lines below)","final_result":true}}}
