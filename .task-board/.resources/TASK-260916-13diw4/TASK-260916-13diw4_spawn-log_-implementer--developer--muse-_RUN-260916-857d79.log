{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c739","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":503,"recorded_at":1780531400001001,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"call_id":"call_01a0a8dff118708eaa5ec0db71a647d6","text":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(1982 line(s) above)\n1983|private actor ReviewDownloadLatch {\n1984|    var started = false\n1985|    var waiter: CheckedContinuation<Void, Never>?\n1986|    var releaseWaiter: CheckedContinuation<Void, Never>?\n1987|    func download(_ bytes: Data) async -> Data {\n1988|        started = true\n1989|        waiter?.resume(); waiter = nil\n1990|        await withCheckedContinuation { releaseWaiter = $0 }\n1991|        return bytes\n1992|    }\n1993|    func waitStarted() async {\n1994|        if started { return }\n1995|        await withCheckedContinuation { waiter = $0 }\n1996|    }\n1997|    func release() { releaseWaiter?.resume(); releaseWaiter = nil }\n1998|}\n1999|\n2000|@Test @MainActor func reviewerInFlightInstallCannotRepopulateChangedDraft() async throws {\n2001|    let package = try await FixturePackage.make()\n2002|    let latch = ReviewDownloadLatch()\n2003|    let transport = TestTransport([downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))])\n2004|    let harness = await registrationHarness(transport: transport, downloader: { _ in await latch.download(package.bytes) })\n2005|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2006|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2007|    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2008|    await latch.waitStarted()\n2009|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(repoDraft(dir: \"new-install\")))\n2010|    await latch.release()\n2011|    _ = await operation.value\n2012|    let state = RunnerRegistration.State()\n2013|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2014|    #expect(state.draft?.installDirName == \"new-install\")\n2015|    #expect(state.installPath == nil, \"Old async install must not attest the new draft\")\n2016|    #expect(!state.completedSteps.contains(\"downloadAndInstall\"))\n2017|}\n2018|\n2019|@Test func reviewerForeignServerIdentityCannotAuthorizeLabels() async throws {\n2020|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2021|    let transport = TestTransport([\n2022|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2023|        runnersListPayload([]),\n2024|        jsonResponse([\"token\": \"REG-SECRET\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2025|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2026|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2027|        jsonResponse([\"labels\": [[\"name\": \"gpu\"]]])\n2028|    ])\n2029|    let harness = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: SplitExecutor())\n2030|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2031|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2032|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2033|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n2034|    let directory = await harness.installer.directory(for: \"macbook-test\")\n2035|    try Data(#\"{\"agentId\":4242,\"agentName\":\"macbook-test\",\"gitHubUrl\":\"https://enterprise.example/acme\",\"workFolder\":\"_work\"}\"#.utf8).write(to: directory.appendingPathComponent(\".runner\"))\n2036|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"]))\n2037|    #expect(await transport.requests.filter { $0.method == \"PUT\" }.isEmpty, \"Foreign server ID must not authorize github.com writes\")\n2038|    #expect(lastFailure(harness.logger)?.step == \"applyLabels\")\n2039|}\n2040|\n2041|@Test func reviewerChangedWorkFolderCannotReuseConfiguredSuccess() async throws {\n2042|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2043|    let transport = TestTransport([\n2044|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2045|        runnersListPayload([]),\n2046|        jsonResponse([\"token\": \"REG-SECRET\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2047|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2048|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]])\n2049|    ])\n2050|    let harness = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: SplitExecutor())\n2051|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2052|    var draft = orgDraft()\n2053|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n2054|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2055|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n2056|    draft.workFolder = \"new_work\"\n2057|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(draft))\n2058|    let before = registrationActions(harness.logger).count\n2059|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n2060|    let after = Array(registrationActions(harness.logger).dropFirst(before))\n2061|    #expect(!after.contains { if case .registered = $0 { true } else { false } }, \"Old _work configuration is not new_work success\")\n2062|    #expect(lastFailure(harness.logger)?.step == \"registerRunner\")\n2063|}\n2064|\n2065|// MARK: - R4: coherent operation identity (in-flight, server, configuration)\n2066|\n2067|// Latch executor: suspends the next config.sh so a draft edit can land\n2068|// while registration is in flight through the production Flow entry point.\n2069|private actor ConfigLatchExecutor: CommandExecuting {\n2070|    private(set) var configCalls: [[String]] = []\n2071|    private let gitHubURL: String\n2072|    private let real = CommandExecutor()\n2073|    private var latched = false\n2074|    var started = false\n2075|    private var waiter: CheckedContinuation<Void, Never>?\n2076|    private var releaseWaiter: CheckedContinuation<Void, Never>?\n2077|    init(gitHubURL: String = \"https://github.com/acme\") { self.gitHubURL = gitHubURL }\n2078|    func run(_ executable: String, _ arguments: [String]) async throws -> CommandResult {\n2079|        if executable.hasSuffix(\"config.sh\") {\n2080|            configCalls.append(arguments)\n2081|            if !latched {\n2082|                latched = true\n2083|                started = true\n2084|                waiter?.resume(); waiter = nil\n2085|                await withCheckedContinuation { releaseWaiter = $0 }\n2086|            }\n2087|            let dir = URL(fileURLWithPath: executable).deletingLastPathComponent()\n2088|            var name = \"unnamed\"\n2089|            var work = \"_work\"\n2090|            var index = arguments.startIndex\n2091|            while index < arguments.endIndex {\n2092|                if arguments[index] == \"--name\", arguments.index(after: index) < arguments.endIndex {\n2093|                    name = arguments[arguments.index(after: index)]\n2094|                }\n2095|                if arguments[index] == \"--work\", arguments.index(after: index) < arguments.endIndex {\n2096|                    work = arguments[arguments.index(after: index)]\n2097|                }\n2098|                index = arguments.index(after: index)\n2099|            }\n2100|            let payload = [\"agentId\": 4242, \"agentName\": name, \"gitHubUrl\": gitHubURL, \"workFolder\": work] as [String: Any]\n2101|            let data = try JSONSerialization.data(withJSONObject: payload)\n2102|            try data.write(to: dir.appendingPathComponent(\".runner\"), options: .atomic)\n2103|            return CommandResult(code: 0, output: \"Configured\")\n2104|        }\n2105|        return try await real.run(executable, arguments)\n2106|    }\n2107|    func waitStarted() async {\n2108|        if started { return }\n2109|        await withCheckedContinuation { waiter = $0 }\n2110|    }\n2111|    func release() { releaseWaiter?.resume(); releaseWaiter = nil }\n2112|}\n2113|\n2114|// Latch transport: suspends the matching request whose path contains the\n2115|// needle (after skipping `skip` prior matches of the same method), so a\n2116|// draft or session edit can land while a GitHub step is in flight. The\n2117|// method filter keeps token POSTs from consuming list-GET skip budget.\n2118|private actor LatchTransport: GitHubHTTPTransport {\n2119|    private let inner: TestTransport\n2120|    private let needle: String\n2121|    private let method: String?\n2122|    private let skip: Int\n2123|    private var seen = 0\n2124|    private var latched = false\n2125|    var started = false\n2126|    private var waiter: CheckedContinuation<Void, Never>?\n2127|    private var releaseWaiter: CheckedContinuation<Void, Never>?\n2128|    init(inner: TestTransport, needle: String, method: String? = nil, skip: Int = 0) {\n2129|        self.inner = inner; self.needle = needle; self.method = method; self.skip = skip\n2130|    }\n2131|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n2132|        if !latched, request.url.path.contains(needle), method == nil || request.method == method {\n2133|            if seen >= skip {\n2134|                latched = true\n2135|                started = true\n2136|                waiter?.resume(); waiter = nil\n2137|                await withCheckedContinuation { releaseWaiter = $0 }\n2138|            } else {\n2139|                seen += 1\n2140|            }\n2141|        }\n2142|        return try await inner.send(request)\n2143|    }\n2144|    func waitStarted() async {\n2145|        if started { return }\n2146|        await withCheckedContinuation { waiter = $0 }\n2147|    }\n2148|    func release() { releaseWaiter?.resume(); releaseWaiter = nil }\n2149|}\n2150|\n2151|private func latchedHarness(\n2152|    inner: TestTransport, needle: String, method: String? = nil, skip: Int = 0,\n2153|    downloader: (@Sendable (URL) async throws -> Data)? = nil,\n2154|    executor: (any CommandExecuting)? = nil\n2155|) async -> (RegistrationHarness, LatchTransport) {\n2156|    let logger = Relux.Testing.Logger()\n2157|    let dispatcher = Relux.Dispatcher(logger: logger)\n2158|    let latch = LatchTransport(inner: inner, needle: needle, method: method, skip: skip)\n2159|    let userStore = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n2160|    let identities = InMemoryGitHubSessionIdentityStore()\n2161|    await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n2162|    try? await userStore.save(\n2163|        GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n2164|        serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n2165|    )\n2166|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"RegHome-\" + UUID().uuidString)\n2167|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n2168|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n2169|    let installer = RunnerInstallerService(\n2170|        installRoot: installRoot, downloader: downloader, executor: executor, currentArch: { \"arm64\" }\n2171|    )\n2172|    let api = GitHubRunnerAPIClient(transport: latch)\n2173|    let registrationTokens = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n2174|    let refresher = GitHubTokenRefresh(transport: latch, store: userStore)\n2175|    let flow = await RunnerRegistration.Flow(\n2176|        api: api, installer: installer, registrationTokens: registrationTokens,\n2177|        userStore: userStore, identityStore: identities, refresher: refresher,\n2178|        configProvider: { _ in testConfig }, dispatcher: dispatcher\n2179|    )\n2180|    let harness = RegistrationHarness(\n2181|        flow: flow, logger: logger, transport: inner, userStore: userStore,\n2182|        identities: identities, registrationTokens: registrationTokens,\n2183|        installer: installer, home: home, installRoot: installRoot\n2184|    )\n2185|    return (harness, latch)\n2186|}\n2187|\n2188|@Test @MainActor func inFlightRegistrationCannotAttributeOldConfigToNewDraft() async throws {\n2189|    // R3-F1 class at the registration boundary: config suspends, the draft\n2190|    // renames, the old config's success must not become the new draft's.\n2191|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2192|    let executor = ConfigLatchExecutor()\n2193|    let transport = TestTransport([\n2194|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2195|        runnersListPayload([]),\n2196|        jsonResponse([\"token\": \"REG-SECRET-R4\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2197|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2198|    ])\n2199|    let harness = await registrationHarness(\n2200|        transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor\n2201|    )\n2202|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2203|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2204|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2205|    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2206|    await executor.waitStarted()\n2207|    var renamed = orgDraft()\n2208|    renamed.runnerName = \"renamed-runner\"\n2209|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(renamed))\n2210|    await executor.release()\n2211|    _ = await operation.value\n2212|    let state = RunnerRegistration.State()\n2213|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2214|    #expect(state.draft?.runnerName == \"renamed-runner\")\n2215|    #expect(state.runnerID == nil)\n2216|    #expect(!state.completedSteps.contains(\"registerRunner\"))\n2217|    #expect(!registrationActions(harness.logger).contains { if case .registered = $0 { true } else { false } })\n2218|}\n2219|\n2220|@Test @MainActor func inFlightGroupCannotResolveForEditedDraft() async throws {\n2221|    // R3-F1 class at the group boundary: the groups list suspends, the\n2222|    // draft re-targets another group, the old resolution must not land.\n2223|    let inner = TestTransport([\n2224|        groupsListPayload([groupPayload(id: 1, name: \"Default\", visibility: \"all\", allowsPublic: true)]),\n2225|        jsonResponse(groupPayload(id: 7, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true), status: 201),\n2226|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n2227|    ])\n2228|    let (harness, latch) = await latchedHarness(inner: inner, needle: \"runner-groups\")\n2229|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2230|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2231|  