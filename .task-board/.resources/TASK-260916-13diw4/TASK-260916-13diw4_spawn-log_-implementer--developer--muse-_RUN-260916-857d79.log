{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d9","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":455,"recorded_at":1780531400000905,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"task_stream":{"kind":"task","id":"01a0a8df-db4b-7a30-8387-f6a375365bb5"},"task_id":"01a0a8df-db4b-7a30-8387-f6a375365bb5","event":{"kind":"output","task_id":"01a0a8df-db4b-7a30-8387-f6a375365bb5","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n1|import CryptoKit\n2|import Foundation\n3|import Testing\n4|import Relux\n5|@testable import RunnerControlCore\n6|\n7|// MARK: - Registration harness (production entry points, controlled IO)\n8|\n9|// TestTransport, jsonResponse, and testConfig are shared from GitHubTransportTests.\n10|\n11|private struct RegistrationHarness {\n12|    let flow: RunnerRegistration.Flow\n13|    let logger: Relux.Testing.Logger\n14|    let transport: TestTransport\n15|    let userStore: GitHubKeychainStore\n16|    let identities: InMemoryGitHubSessionIdentityStore\n17|    let registrationTokens: RunnerRegistrationTokenStore\n18|    let installer: RunnerInstallerService\n19|    let home: URL\n20|    let installRoot: URL\n21|}\n22|\n23|private func registrationHarness(\n24|    transport: TestTransport,\n25|    downloader: (@Sendable (URL) async throws -> Data)? = nil,\n26|    executor: (any CommandExecuting)? = nil,\n27|    arch: String = \"arm64\",\n28|    seedAuth: Bool = true\n29|) async -> RegistrationHarness {\n30|    let logger = Relux.Testing.Logger()\n31|    let dispatcher = Relux.Dispatcher(logger: logger)\n32|    let userStore = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n33|    let identities = InMemoryGitHubSessionIdentityStore()\n34|    if seedAuth {\n35|        await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n36|        try? await userStore.save(\n37|            GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n38|            serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n39|        )\n40|    }\n41|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"RegHome-\" + UUID().uuidString)\n42|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n43|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n44|    let archCopy = arch\n45|    let installer = RunnerInstallerService(\n46|        installRoot: installRoot,\n47|        downloader: downloader,\n48|        executor: executor,\n49|        currentArch: { archCopy }\n50|    )\n51|    let api = GitHubRunnerAPIClient(transport: transport)\n52|    let registrationTokens = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n53|    let refresher = GitHubTokenRefresh(transport: transport, store: userStore)\n54|    let flow = await RunnerRegistration.Flow(\n55|        api: api, installer: installer, registrationTokens: registrationTokens,\n56|        userStore: userStore, identityStore: identities, refresher: refresher,\n57|        configProvider: { _ in testConfig }, dispatcher: dispatcher\n58|    )\n59|    return RegistrationHarness(\n60|        flow: flow, logger: logger, transport: transport, userStore: userStore,\n61|        identities: identities, registrationTokens: registrationTokens,\n62|        installer: installer, home: home, installRoot: installRoot\n63|    )\n64|}\n65|\n66|private func registrationActions(_ logger: Relux.Testing.Logger) -> [RunnerRegistration.Action] {\n67|    logger.actions.compactMap { $0 as? RunnerRegistration.Action }\n68|}\n69|\n70|private func lastFailure(_ logger: Relux.Testing.Logger) -> (message: String, step: String)? {\n71|    for action in registrationActions(logger).reversed() {\n72|        switch action {\n73|        case .failed(let message, let step): return (message, step)\n74|        case .permissionDenied(let message, let step): return (message, step)\n75|        default: break\n76|        }\n77|    }\n78|    return nil\n79|}\n80|\n81|private func orgDraft(\n82|    name: String = \"macbook-test\",\n83|    dir: String = \"macbook-test\",\n84|    group: String = \"RunnerControl-Mac\",\n85|    repos: Set<Int64> = [9],\n86|    allowGroup: Bool = true,\n87|    allowTakeover: Bool = false,\n88|    allowReplace: Bool = false\n89|) -> RunnerRegistration.Draft {\n90|    RunnerRegistration.Draft(\n91|        scope: .organization(org: \"acme\"),\n92|        runnerName: name,\n93|        labels: [\"self-hosted\", \"macOS\"],\n94|        installDirName: dir,\n95|        workFolder: \"_work\",\n96|        groupName: group,\n97|        selectedRepositoryIDs: repos,\n98|        allowGroupMutation: allowGroup,\n99|        allowGroupTakeover: allowTakeover,\n100|        allowReplace: allowReplace\n101|    )\n102|}\n103|\n104|private func repoDraft(dir: String = \"personal-app\", allowReplace: Bool = false) -> RunnerRegistration.Draft {\n105|    RunnerRegistration.Draft(\n106|        scope: .repository(owner: \"octo\", name: \"app\"),\n107|        runnerName: \"personal-runner\",\n108|        labels: [\"self-hosted\", \"macOS\"],\n109|        installDirName: dir,\n110|        workFolder: \"_work\",\n111|        allowGroupMutation: false,\n112|        allowGroupTakeover: false,\n113|        allowReplace: allowReplace\n114|    )\n115|}\n116|\n117|/// The downloads endpoint returns a bare JSON array, not an object.\n118|private func downloadsArrayPayload(_ assets: [[String: Any]]) -> GitHubHTTPResponse {\n119|    // swiftlint:disable:next force_try\n120|    let data = try! JSONSerialization.data(withJSONObject: assets)\n121|    return GitHubHTTPResponse(status: 200, body: data)\n122|}\n123|\n124|/// Typed group fixture: heterogeneous literals (Int/String/Bool) need an\n125|/// explicit `[String: Any]` context to compile.\n126|private func groupPayload(id: Int64, name: String, visibility: String, allowsPublic: Bool) -> [String: Any] {\n127|    [\"id\": id, \"name\": name, \"visibility\": visibility, \"allows_public_repositories\": allowsPublic]\n128|}\n129|\n130|private func groupsListPayload(_ groups: [[String: Any]]) -> GitHubHTTPResponse {\n131|    jsonResponse([\"runner_groups\": groups])\n132|}\n133|\n134|// MARK: - Fixture package (real tarball, controlled filesystem)\n135|\n136|/// Builds a minimal official-shaped runner package and packs it with the\n137|/// real system tar. Scripts keep their executable bit inside the archive.\n138|private struct FixturePackage {\n139|    let bytes: Data\n140|    let sha256ViaSystem: String\n141|\n142|    static func make(withRealConfigScript: Bool = true) async throws -> FixturePackage {\n143|        let files = FileManager.default\n144|        let src = files.temporaryDirectory.appendingPathComponent(\"FixtureSrc-\" + UUID().uuidString)\n145|        let bin = src.appendingPathComponent(\"bin\")\n146|        try files.createDirectory(at: bin, withIntermediateDirectories: true)\n147|        try \"#!/bin/sh\\nexec \\\"$(dirname \\\"$0\\\")/../run.sh\\\" \\\"$@\\\"\\n\".write(to: bin.appendingPathComponent(\"runsvc.sh\"), atomically: true, encoding: .utf8)\n148|        try \"#!/bin/sh\\necho runner\\n\".write(to: src.appendingPathComponent(\"run.sh\"), atomically: true, encoding: .utf8)\n149|        if withRealConfigScript {\n150|            let script = \"\"\"\n151|            #!/bin/sh\n152|            DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n153|            NAME=\"\"\n154|            while [ $# -gt 0 ]; do\n155|              case \"$1\" in\n156|                --name) NAME=\"$2\"; shift 2;;\n157|                *) shift;;\n158|              esac\n159|            done\n160|            printf '{\"agentId\":4242,\"agentName\":\"%s\",\"gitHubUrl\":\"https://github.com/acme\",\"workFolder\":\"_work\"}' \"$NAME\" > \"$DIR/.runner\"\n161|            \"\"\"\n162|            try script.write(to: src.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n163|        } else {\n164|            try \"#!/bin/sh\\nexit 0\\n\".write(to: src.appendingPathComponent(\"config.sh\"), atomically: true, encoding: .utf8)\n165|        }\n166|        for path in [\"bin/runsvc.sh\", \"run.sh\", \"config.sh\"] {\n167|            try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: src.appendingPathComponent(path).path)\n168|        }\n169|        let archive = files.temporaryDirectory.appendingPathComponent(\"fixture-\" + UUID().uuidString + \".tar.gz\")\n170|        defer { try? files.removeItem(at: src) }\n171|        defer { try? files.removeItem(at: archive) }\n172|        let executor = CommandExecutor()\n173|        let packed = try await executor.run(\"/usr/bin/tar\", [\"-czf\", archive.path, \"-C\", src.path, \".\"])\n174|        guard packed.code == 0 else { throw RunnerError.message(\"fixture tar failed: \\(packed.output)\") }\n175|        let bytes = try Data(contentsOf: archive)\n176|        // Independent oracle: system shasum pins the production CryptoKit hasher.\n177|        let hashed = try await executor.run(\"/usr/bin/shasum\", [\"-a\", \"256\", archive.path])\n178|        guard hashed.code == 0 else { throw RunnerError.message(\"shasum missing: \\(hashed.output)\") }\n179|        let digest = hashed.output.split(separator: \" \").first.map(String.init) ?? \"\"\n180|        guard digest.count == 64 else { throw RunnerError.message(\"bad shasum output: \\(hashed.output)\") }\n181|        return FixturePackage(bytes: bytes, sha256ViaSystem: digest)\n182|    }\n183|}\n184|\n185|private func fixtureDownloader(_ bytes: Data) -> @Sendable (URL) async throws -> Data {\n186|    let copy = bytes\n187|    return { _ in copy }\n188|}\n189|\n190|/// Records config.sh argv and simulates a successful registration by writing\n191|/// `.runner`. Delegates every other command (tar) to the real executor.\n192|private actor SplitExecutor: CommandExecuting {\n193|    private(set) var configCalls: [[String]] = []\n194|    var failure: CommandResult?\n195|    private let real = CommandExecutor()\n196|    private let gitHubURL: String\n197|\n198|    init(gitHubURL: String = \"https://github.com/acme\") {\n199|        self.gitHubURL = gitHubURL\n200|    }\n201|\n202|    func run(_ executable: String, _ arguments: [String]) async throws -> CommandResult {\n203|        if executable.hasSuffix(\"config.sh\") {\n204|            configCalls.append(arguments)\n205|            if let failure { return failure }\n206|            let dir = URL(fileURLWithPath: executable).deletingLastPathComponent()\n207|            var name = \"unnamed\"\n208|            var work = \"_work\"\n209|            var index = arguments.startIndex\n210|            while index < arguments.endIndex {\n211|                if arguments[index] == \"--name\", arguments.index(after: index) < arguments.endIndex {\n212|                    name = arguments[arguments.index(after: index)]\n213|                }\n214|                if arguments[index] == \"--work\", arguments.index(after: index) < arguments.endIndex {\n215|                    work = arguments[arguments.index(after: index)]\n216|                }\n217|                index = arguments.index(after: index)\n218|            }\n219|            let payload = [\"agentId\": 4242, \"agentName\": name, \"gitHubUrl\": gitHubURL, \"workFolder\": work] as [String: Any]\n220|            let data = try JSONSerialization.data(withJSONObject: payload)\n221|            try data.write(to: dir.appendingPathComponent(\".runner\"), options: .atomic)\n222|            return CommandResult(code: 0, output: \"Configured\")\n223|        }\n224|        return try await real.run(executable, arguments)\n225|    }\n226|}\n227|\n228|// MARK: - Reducer and pure gates\n229|\n230|@Test @MainActor func registrationReducerRetainsPermissionErrorAcrossDraftEdits() async {\n231|    let state = RunnerRegistration.State()\n232|    await state.reduce(with: ForeignAction())\n233|    #expect(state.phase == .idle)\n234|    let draft = orgDraft()\n235|    await state.reduce(with: RunnerRegistration.Action.draftBegan(draft))\n236|    #expect(state.phase == .drafting)\n237|    await state.reduce(with: RunnerRegistration.Action.permissionDenied(message: \"Missing permission: X\", step: \"resolveGroup\"))\n238|    #expect(state.permissionError == \"Missing permission: X\")\n239|    // Draft edits must retain the permission error by design.\n240|    var edited = draft\n241|    edited.runnerName = \"renamed\"\n242|    await state.reduce(with: RunnerRegistration.Action.draftUpdated(edited))\n243|    #expect(state.permissionError == \"Missing permission: X\")\n244|    #expect(state.draft?.runnerName == \"renamed\")\n245|    await state.reduce(with: RunnerRegistration.Action.permissionDismissed)\n246|    #expect(state.permissionError == nil)\n247|    await state.reduce(with: RunnerRegistration.Action.registered(runnerID: 11, localAgentID: 4242))\n248|    #expect(state.runnerID == 11)\n249|    await state.cleanup()\n250|    #expect(state.phase == .idle)\n251|    #expect(state.draft == nil)\n252|}\n253|\n254|@Test func configInvocationIsExactAndOrdered() {\n255|    let orgSpec = RunnerRegistration.ConfigSpec(\n256|        scopeURL: \"https://github.com/acme\", token: \"TOKEN\",\n257|        name: \"mac1\", workFolder: \"_work\",\n258|        labels: [\"self-hosted\", \"macOS\"], runnerGroup: \"RunnerControl-Mac\",\n259|        replace: true\n260|    )\n261|    let org = RunnerRegistration.ConfigInvocation.arguments(orgSpec)\n262|    #expect(org == [\n263|        \"--url\", \"https://github.com/acme\",\n264|        \"--token\", \"TOKEN\",\n265|        \"--name\", \"mac1\",\n266|        \"--work\", \"_work\",\n267|        \"--labels\", \"self-hosted,macOS\",\n268|        \"--runnergroup\", \"RunnerControl-Mac\",\n269|        \"--unattended\", \"--replace\",\n270|    ])\n271|    let repoSpec = RunnerRegistration.ConfigSpec(\n272|        scopeURL: \"https://github.com/octo/app\", token: \"TOKEN\",\n273|        name: \"r2\", workFolder: \"_work\",\n274|        labels: [\"a\"], runnerGroup: nil, replace: true\n275|    )\n276|    let repo = RunnerRegistration.ConfigInvocation.arguments(repoSpec)\n277|    #expect(!repo.contains(\"--runnergroup\"))\n278|    #expect(repo == [\n279|        \"--url\", \"https://github.com/octo/app\",\n280|        \"--token\", \"TOKEN\",\n281|        \"--name\", \"r2\",\n282|        \"--work\", \"_work\",\n283|        \"--labels\", \"a\",\n284|        \"--unattended\", \"--replace\",\n285|    ])\n286|}\n287|\n288|@Test func configInvocationOmitsReplaceWithoutExplicitConsent() {\n289|    let spec = RunnerRegistration.ConfigSpec(\n290|        scopeURL: \"https://github.com/acme\", token: \"TOKEN\",\n291|        name: \"mac1\", workFolder: \"_work\",\n292|        labels: [\"self-hosted\", \"macOS\"], runnerGroup: \"RunnerControl-Mac\",\n293|        replace: false\n294|    )\n295|    let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n296|    #expect(!args.contains(\"--replace\"))\n297|    #expect(args.last == \"--unattended\")\n298|}\n299|\n300|@Test func serviceLabelCarriesDiscoveryPrefixAndSanitizes() {\n301|    let label = RunnerRegistration.Flow.serviceLabel(draft: orgDraft())\n302|    #expect(label.hasPrefix(\"actions.runner.\"))\n303|    #expect(!label.contains(\" \"))\n304|    #expect(!label.contains(\"/\"))\n305|    var spaced = orgDraft()\n306|    spaced.installDirName = \"a b/c\"\n307|    #expect(!RunnerRegistration.Flow.serviceLabel(draft: spaced).contains(\" \"))\n308|}\n309|\n310|@Test func scopeURLsAndKeysAreExact() {\n311|    #expect(RunnerRegistration.Scope.organization(org: \"acme\").apiPrefix == \"orgs/acme\")\n312|    #expect(RunnerRegistration.Scope.repository(owner: \"o\", name: \"r\").apiPrefix == \"repos/o/r\")\n313|    #expect(RunnerRegistration.Scope.organization(org: \"acme\").configURL(serverHost: \"github.com\") == \"https://github.com/acme\")\n314|    #expect(RunnerRegistration.Scope.repository(owner: \"o\", name: \"r\").configURL(serverHost: \"ghe.example.com\") == \"https://ghe.example.com/o/r\")\n315|}\n316|\n317|@Test @MainActor func registrationModuleRegistersStateAndFlow() async {\n318|    let transport = TestTransport([])\n319|    let harness = await registrationHarness(transport: transport)\n320|    let state = RunnerRegistration.State()\n321|    let module = RunnerRegistration.Module(state: state, flow: harness.flow)\n322|    #expect(module.states.count == 1)\n323|    #expect(module.sagas.count == 1)\n324|}\n325|\n326|// MARK: - Draft gates (no network before validation)\n327|\n328|@Test(arguments: [\n329|    (\"bad dir\", \"_work\"),\n330|    (\"gooddir\", \"bad work\"),\n331|]) func beginDraftRefusesSpacesBeforeAnyNetwork(dir: String, work: String) async {\n332|    let transport = TestTransport([])\n333|    let harness = await registrationHarness(transport: transport)\n334|    var draft = orgDraft()\n335|    draft.installDirName = dir\n336|    draft.workFolder = work\n337|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n338|    let failure = lastFailure(harness.logger)\n339|    #expect(failure?.step == \"beginDraft\")\n340|    #expect((failure?.message.contains(\"space\") ?? false))\n341|    #expect(await transport.requests.isEmpty)\n342|}\n343|\n344|@Test func installerRefusesSpacesWithoutDownloading() async {\n345|    actor Probe {\n346|        var count = 0\n347|        func next(_ url: URL) async throws -> Data { count += 1; return Data() }\n348|    }\n349|    let probe = Probe()\n350|    let downloader: @Sendable (URL) async throws -> Data = { url in try await probe.next(url) }\n351|    let harness = await registrationHarness(transport: TestTransport([]), downloader: downloader)\n352|    var draft = orgDraft()\n353|    draft.installDirName = \"has space\"\n354|    let asset = RunnerRegistration.DownloadAsset(\n355|        osName: \"osx\", architecture: \"arm64\",\n356|        downloadURL: URL(string: \"https://example.com/x.tar.gz\")!,\n357|        filename: \"x.tar.gz\", sha256Checksum: nil\n358|    )\n359|    do {\n360|        _ = try await harness.installer.downloadAndInstall(asset: asset, draft: draft)\n361|        Issue.record(\"installer admitted spaced path\")\n362|    } catch let error as RunnerRegistration.RegistrationError {\n363|        guard case .noSpacePath = error else { Issue.record(\"wrong error: \\(error)\"); return }\n364|    } catch {\n365|        Issue.record(\"unexpected error: \\(error)\")\n366|    }\n367|    #expect(await probe.count == 0)\n368|}\n369|\n370|@Test func beginDraftRequiresNameAndLabels() async {\n371|    let harness = await registrationHarness(transport: TestTransport([]))\n372|    var nameless = orgDraft()\n373|    nameless.runnerName = \"   \"\n374|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(nameless))\n375|    #expect(lastFailure(harness.logger)?.step == \"beginDraft\")\n376|    var labelless = orgDraft()\n377|    labelless.labels = []\n378|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(labelless))\n379|    #expect(registrationActions(harness.logger).filter {\n380|        if case .failed = $0 { true } else { false }\n381|    }.count == 2)\n382|}\n383|\n384|@Test func unauthenticatedWizardFailsClosedWithoutNetwork() async {\n385|    let transport = TestTransport([])\n386|    let harness = await registrationHarness(transport: transport, seedAuth: false)\n387|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n388|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n389|    let failure = lastFailure(harness.logger)\n390|    #expect(failure?.step == \"resolveGroup\")\n391|    #expect((failure?.message.contains(\"Sign in\") ?? false))\n392|    #expect(await transport.requests.isEmpty)\n393|}\n394|\n395|// MARK: - Download selection (architecture-matched, official only)\n396|\n397|private func downloadAssets(checksum: String) -> [[String: Any]] {\n398|    [\n399|        [\"os\": \"linux\", \"architecture\": \"x64\", \"download_url\": \"https://example.com/linux.tar.gz\", \"filename\": \"linux.tar.gz\"],\n400|        [\"os\": \"osx\", \"architecture\": \"x64\", \"download_url\": \"https://example.com/osx-x64.tar.gz\", \"filename\": \"osx-x64.tar.gz\", \"sha256_checksum\": \"x64sum\"],\n(more lines below)","final_result":true}}}
