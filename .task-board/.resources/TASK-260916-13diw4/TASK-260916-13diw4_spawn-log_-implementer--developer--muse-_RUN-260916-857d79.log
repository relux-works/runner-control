{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c735","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":501,"recorded_at":1780531400000997,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"task_stream":{"kind":"task","id":"01a0a8df-f560-7fc2-9ef5-8b71f707befd"},"task_id":"01a0a8df-f560-7fc2-9ef5-8b71f707befd","event":{"kind":"output","task_id":"01a0a8df-f560-7fc2-9ef5-8b71f707befd","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerRegistrationTests.swift`.\n(1982 line(s) above)\n1983|private actor ReviewDownloadLatch {\n1984|    var started = false\n1985|    var waiter: CheckedContinuation<Void, Never>?\n1986|    var releaseWaiter: CheckedContinuation<Void, Never>?\n1987|    func download(_ bytes: Data) async -> Data {\n1988|        started = true\n1989|        waiter?.resume(); waiter = nil\n1990|        await withCheckedContinuation { releaseWaiter = $0 }\n1991|        return bytes\n1992|    }\n1993|    func waitStarted() async {\n1994|        if started { return }\n1995|        await withCheckedContinuation { waiter = $0 }\n1996|    }\n1997|    func release() { releaseWaiter?.resume(); releaseWaiter = nil }\n1998|}\n1999|\n2000|@Test @MainActor func reviewerInFlightInstallCannotRepopulateChangedDraft() async throws {\n2001|    let package = try await FixturePackage.make()\n2002|    let latch = ReviewDownloadLatch()\n2003|    let transport = TestTransport([downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))])\n2004|    let harness = await registrationHarness(transport: transport, downloader: { _ in await latch.download(package.bytes) })\n2005|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2006|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2007|    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2008|    await latch.waitStarted()\n2009|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(repoDraft(dir: \"new-install\")))\n2010|    await latch.release()\n2011|    _ = await operation.value\n2012|    let state = RunnerRegistration.State()\n2013|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2014|    #expect(state.draft?.installDirName == \"new-install\")\n2015|    #expect(state.installPath == nil, \"Old async install must not attest the new draft\")\n2016|    #expect(!state.completedSteps.contains(\"downloadAndInstall\"))\n2017|}\n2018|\n2019|@Test func reviewerForeignServerIdentityCannotAuthorizeLabels() async throws {\n2020|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2021|    let transport = TestTransport([\n2022|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2023|        runnersListPayload([]),\n2024|        jsonResponse([\"token\": \"REG-SECRET\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2025|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2026|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2027|        jsonResponse([\"labels\": [[\"name\": \"gpu\"]]])\n2028|    ])\n2029|    let harness = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: SplitExecutor())\n2030|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2031|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2032|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2033|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n2034|    let directory = await harness.installer.directory(for: \"macbook-test\")\n2035|    try Data(#\"{\"agentId\":4242,\"agentName\":\"macbook-test\",\"gitHubUrl\":\"https://enterprise.example/acme\",\"workFolder\":\"_work\"}\"#.utf8).write(to: directory.appendingPathComponent(\".runner\"))\n2036|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"]))\n2037|    #expect(await transport.requests.filter { $0.method == \"PUT\" }.isEmpty, \"Foreign server ID must not authorize github.com writes\")\n2038|    #expect(lastFailure(harness.logger)?.step == \"applyLabels\")\n2039|}\n2040|\n2041|@Test func reviewerChangedWorkFolderCannotReuseConfiguredSuccess() async throws {\n2042|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2043|    let transport = TestTransport([\n2044|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2045|        runnersListPayload([]),\n2046|        jsonResponse([\"token\": \"REG-SECRET\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2047|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2048|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]])\n2049|    ])\n2050|    let harness = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: SplitExecutor())\n2051|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2052|    var draft = orgDraft()\n2053|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(draft))\n2054|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2055|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n2056|    draft.workFolder = \"new_work\"\n2057|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(draft))\n2058|    let before = registrationActions(harness.logger).count\n2059|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n2060|    let after = Array(registrationActions(harness.logger).dropFirst(before))\n2061|    #expect(!after.contains { if case .registered = $0 { true } else { false } }, \"Old _work configuration is not new_work success\")\n2062|    #expect(lastFailure(harness.logger)?.step == \"registerRunner\")\n2063|}\n2064|\n2065|// MARK: - R4: coherent operation identity (in-flight, server, configuration)\n2066|\n2067|// Latch executor: suspends the next config.sh so a draft edit can land\n2068|// while registration is in flight through the production Flow entry point.\n2069|private actor ConfigLatchExecutor: CommandExecuting {\n2070|    private(set) var configCalls: [[String]] = []\n2071|    private let gitHubURL: String\n2072|    private let real = CommandExecutor()\n2073|    private var latched = false\n2074|    var started = false\n2075|    private var waiter: CheckedContinuation<Void, Never>?\n2076|    private var releaseWaiter: CheckedContinuation<Void, Never>?\n2077|    init(gitHubURL: String = \"https://github.com/acme\") { self.gitHubURL = gitHubURL }\n2078|    func run(_ executable: String, _ arguments: [String]) async throws -> CommandResult {\n2079|        if executable.hasSuffix(\"config.sh\") {\n2080|            configCalls.append(arguments)\n2081|            if !latched {\n2082|                latched = true\n2083|                started = true\n2084|                waiter?.resume(); waiter = nil\n2085|                await withCheckedContinuation { releaseWaiter = $0 }\n2086|            }\n2087|            let dir = URL(fileURLWithPath: executable).deletingLastPathComponent()\n2088|            var name = \"unnamed\"\n2089|            var work = \"_work\"\n2090|            var index = arguments.startIndex\n2091|            while index < arguments.endIndex {\n2092|                if arguments[index] == \"--name\", arguments.index(after: index) < arguments.endIndex {\n2093|                    name = arguments[arguments.index(after: index)]\n2094|                }\n2095|                if arguments[index] == \"--work\", arguments.index(after: index) < arguments.endIndex {\n2096|                    work = arguments[arguments.index(after: index)]\n2097|                }\n2098|                index = arguments.index(after: index)\n2099|            }\n2100|            let payload = [\"agentId\": 4242, \"agentName\": name, \"gitHubUrl\": gitHubURL, \"workFolder\": work] as [String: Any]\n2101|            let data = try JSONSerialization.data(withJSONObject: payload)\n2102|            try data.write(to: dir.appendingPathComponent(\".runner\"), options: .atomic)\n2103|            return CommandResult(code: 0, output: \"Configured\")\n2104|        }\n2105|        return try await real.run(executable, arguments)\n2106|    }\n2107|    func waitStarted() async {\n2108|        if started { return }\n2109|        await withCheckedContinuation { waiter = $0 }\n2110|    }\n2111|    func release() { releaseWaiter?.resume(); releaseWaiter = nil }\n2112|}\n2113|\n2114|// Latch transport: suspends the matching request whose path contains the\n2115|// needle (after skipping `skip` prior matches of the same method), so a\n2116|// draft or session edit can land while a GitHub step is in flight. The\n2117|// method filter keeps token POSTs from consuming list-GET skip budget.\n2118|private actor LatchTransport: GitHubHTTPTransport {\n2119|    private let inner: TestTransport\n2120|    private let needle: String\n2121|    private let method: String?\n2122|    private let skip: Int\n2123|    private var seen = 0\n2124|    private var latched = false\n2125|    var started = false\n2126|    private var waiter: CheckedContinuation<Void, Never>?\n2127|    private var releaseWaiter: CheckedContinuation<Void, Never>?\n2128|    init(inner: TestTransport, needle: String, method: String? = nil, skip: Int = 0) {\n2129|        self.inner = inner; self.needle = needle; self.method = method; self.skip = skip\n2130|    }\n2131|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n2132|        if !latched, request.url.path.contains(needle), method == nil || request.method == method {\n2133|            if seen >= skip {\n2134|                latched = true\n2135|                started = true\n2136|                waiter?.resume(); waiter = nil\n2137|                await withCheckedContinuation { releaseWaiter = $0 }\n2138|            } else {\n2139|                seen += 1\n2140|            }\n2141|        }\n2142|        return try await inner.send(request)\n2143|    }\n2144|    func waitStarted() async {\n2145|        if started { return }\n2146|        await withCheckedContinuation { waiter = $0 }\n2147|    }\n2148|    func release() { releaseWaiter?.resume(); releaseWaiter = nil }\n2149|}\n2150|\n2151|private func latchedHarness(\n2152|    inner: TestTransport, needle: String, method: String? = nil, skip: Int = 0,\n2153|    downloader: (@Sendable (URL) async throws -> Data)? = nil,\n2154|    executor: (any CommandExecuting)? = nil\n2155|) async -> (RegistrationHarness, LatchTransport) {\n2156|    let logger = Relux.Testing.Logger()\n2157|    let dispatcher = Relux.Dispatcher(logger: logger)\n2158|    let latch = LatchTransport(inner: inner, needle: needle, method: method, skip: skip)\n2159|    let userStore = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n2160|    let identities = InMemoryGitHubSessionIdentityStore()\n2161|    await identities.save(GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n2162|    try? await userStore.save(\n2163|        GitHubAuth.TokenRecord(accessToken: \"user-token-42\", refreshToken: \"refresh-42\", expiresAt: Date().addingTimeInterval(3600)),\n2164|        serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n2165|    )\n2166|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(\"RegHome-\" + UUID().uuidString)\n2167|    let installRoot = home.appendingPathComponent(\"Library/GitHubActions\")\n2168|    try? FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n2169|    let installer = RunnerInstallerService(\n2170|        installRoot: installRoot, downloader: downloader, executor: executor, currentArch: { \"arm64\" }\n2171|    )\n2172|    let api = GitHubRunnerAPIClient(transport: latch)\n2173|    let registrationTokens = RunnerRegistrationTokenStore(backend: InMemoryRegistrationTokenBackend())\n2174|    let refresher = GitHubTokenRefresh(transport: latch, store: userStore)\n2175|    let flow = await RunnerRegistration.Flow(\n2176|        api: api, installer: installer, registrationTokens: registrationTokens,\n2177|        userStore: userStore, identityStore: identities, refresher: refresher,\n2178|        configProvider: { _ in testConfig }, dispatcher: dispatcher\n2179|    )\n2180|    let harness = RegistrationHarness(\n2181|        flow: flow, logger: logger, transport: inner, userStore: userStore,\n2182|        identities: identities, registrationTokens: registrationTokens,\n2183|        installer: installer, home: home, installRoot: installRoot\n2184|    )\n2185|    return (harness, latch)\n2186|}\n2187|\n2188|@Test @MainActor func inFlightRegistrationCannotAttributeOldConfigToNewDraft() async throws {\n2189|    // R3-F1 class at the registration boundary: config suspends, the draft\n2190|    // renames, the old config's success must not become the new draft's.\n2191|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2192|    let executor = ConfigLatchExecutor()\n2193|    let transport = TestTransport([\n2194|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2195|        runnersListPayload([]),\n2196|        jsonResponse([\"token\": \"REG-SECRET-R4\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2197|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2198|    ])\n2199|    let harness = await registrationHarness(\n2200|        transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor\n2201|    )\n2202|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2203|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2204|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2205|    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.registerRunner) }\n2206|    await executor.waitStarted()\n2207|    var renamed = orgDraft()\n2208|    renamed.runnerName = \"renamed-runner\"\n2209|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(renamed))\n2210|    await executor.release()\n2211|    _ = await operation.value\n2212|    let state = RunnerRegistration.State()\n2213|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2214|    #expect(state.draft?.runnerName == \"renamed-runner\")\n2215|    #expect(state.runnerID == nil)\n2216|    #expect(!state.completedSteps.contains(\"registerRunner\"))\n2217|    #expect(!registrationActions(harness.logger).contains { if case .registered = $0 { true } else { false } })\n2218|}\n2219|\n2220|@Test @MainActor func inFlightGroupCannotResolveForEditedDraft() async throws {\n2221|    // R3-F1 class at the group boundary: the groups list suspends, the\n2222|    // draft re-targets another group, the old resolution must not land.\n2223|    let inner = TestTransport([\n2224|        groupsListPayload([groupPayload(id: 1, name: \"Default\", visibility: \"all\", allowsPublic: true)]),\n2225|        jsonResponse(groupPayload(id: 7, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true), status: 201),\n2226|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n2227|    ])\n2228|    let (harness, latch) = await latchedHarness(inner: inner, needle: \"runner-groups\")\n2229|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2230|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2231|    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.resolveGroup) }\n2232|    await latch.waitStarted()\n2233|    var edited = orgDraft()\n2234|    edited.groupName = \"Other-Mac\"\n2235|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2236|    await latch.release()\n2237|    _ = await operation.value\n2238|    let state = RunnerRegistration.State()\n2239|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2240|    #expect(state.draft?.groupName == \"Other-Mac\")\n2241|    #expect(state.group == nil)\n2242|    #expect(!state.completedSteps.contains(\"resolveGroup\"))\n2243|}\n2244|\n2245|@Test @MainActor func inFlightLabelsCannotWriteForEditedDraft() async throws {\n2246|    // R3-F1 class at the labels boundary: the labels runners-list fetch\n2247|    // suspends (downloads plus the two registration fetches pass through),\n2248|    // the draft renames, and the stale write is dropped before any PUT.\n2249|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2250|    let inner = TestTransport([\n2251|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2252|        runnersListPayload([]),\n2253|        jsonResponse([\"token\": \"REG-SECRET-R4L\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2254|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2255|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2256|        jsonResponse([\"labels\": [[\"name\": \"gpu\"]]]),\n2257|    ])\n2258|    let (harness, latch) = await latchedHarness(\n2259|        inner: inner, needle: \"/actions/runners\", method: \"GET\", skip: 3,\n2260|        downloader: fixtureDownloader(package.bytes), executor: SplitExecutor()\n2261|    )\n2262|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2263|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2264|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2265|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n2266|    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"])) }\n2267|    await latch.waitStarted()\n2268|    var renamed = orgDraft()\n2269|    renamed.runnerName = \"renamed-runner\"\n2270|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(renamed))\n2271|    await latch.release()\n2272|    _ = await operation.value\n2273|    let state = RunnerRegistration.State()\n2274|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2275|    #expect(state.draft?.runnerName == \"renamed-runner\")\n2276|    #expect(await inner.requests.filter { $0.method == \"PUT\" }.isEmpty)\n2277|    #expect(!registrationActions(harness.logger).contains { if case .labelsApplied = $0 { true } else { false } })\n2278|}\n2279|\n2280|@Test @MainActor func nonIdentityEditDuringInstallDoesNotCancel() async throws {\n2281|    // Editable selections never abandon in-flight work: a labels edit while\n2282|    // downloading still completes the install for the visible draft.\n2283|    let package = try await FixturePackage.make()\n2284|    let latch = ReviewDownloadLatch()\n2285|    let transport = TestTransport([downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))])\n2286|    let harness = await registrationHarness(transport: transport, downloader: { _ in await latch.download(package.bytes) })\n2287|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2288|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2289|    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n2290|    await latch.waitStarted()\n2291|    var edited = orgDraft()\n2292|    edited.labels = [\"self-hosted\", \"macOS\", \"gpu\"]\n2293|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2294|    await latch.release()\n2295|    _ = await operation.value\n2296|    let state = RunnerRegistration.State()\n2297|    for item in registrationActions(harness.logger) { await state.reduce(with: item) }\n2298|    #expect(state.draft?.labels.contains(\"gpu\") == true)\n2299|    #expect(state.installPath != nil)\n2300|    #expect(state.completedSteps.contains(\"downloadAndInstall\"))\n2301|}\n2302|\n2303|@Test func serverChangeBetweenStepsInvalidatesGroupAndRunner() async throws {\n2304|    // R3-F2 session class: after resolving on github.com, the session moves\n2305|    // to another server. Cached group/runner progress must not authorize\n2306|    // writes there; the step re-resolves instead of reusing.\n2307|    let transport = TestTransport([\n2308|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n2309|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n2310|    ])\n2311|    let harness = await registrationHarness(transport: transport)\n2312|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2313|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n2314|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n2315|    await harness.identities.save(GitHubSessionIdentity(serverHost: \"enterprise.example\", userID: 7, clientID: testConfig.clientID, username: \"octo\"))\n2316|    try? await harness.userStore.save(\n2317|        GitHubAuth.TokenRecord(accessToken: \"enterprise-token\", refreshToken: \"refresh-e\", expiresAt: Date().addingTimeInterval(3600)),\n2318|        serverHost: \"enterprise.example\", userID: 7, clientID: testConfig.clientID\n2319|    )\n2320|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyRepositoryAccess(groupID: 5, repositories: [9, 10]))\n2321|    let failure = lastFailure(harness.logger)\n2322|    #expect(failure?.step == \"applyRepositoryAccess\")\n2323|    #expect(failure?.message.contains(\"Resolve the dedicated group first\") ?? false)\n2324|    #expect(await transport.requests.filter { $0.method == \"PUT\" }.isEmpty)\n2325|}\n2326|\n2327|@Test func groupOwnershipIsScopedToServer() async throws {\n2328|    // R3-F2 ownership class: the same org/name on another server is not\n2329|    // owned. www.github.com aliases github.com; enterprise does not.\n2330|    let harness = await registrationHarness(transport: TestTransport([]))\n2331|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2332|    try await harness.installer.saveOwnedGroupID(serverHost: \"github.com\", org: \"acme\", name: \"RunnerControl-Mac\", groupID: 5)\n2333|    #expect(await harness.installer.loadOwnedGroupID(serverHost: \"github.com\", org: \"acme\", name: \"RunnerControl-Mac\") == 5)\n2334|    #expect(await harness.installer.loadOwnedGroupID(serverHost: \"www.github.com\", org: \"acme\", name: \"RunnerControl-Mac\") == 5)\n2335|    #expect(await harness.installer.loadOwnedGroupID(serverHost: \"enterprise.example\", org: \"acme\", name: \"RunnerControl-Mac\") == nil)\n2336|    #expect(await harness.installer.loadOwnedGroupID(serverHost: \"github.com\", org: \"acme\", name: \"Other-Mac\") == nil)\n2337|}\n2338|\n2339|@Test func enterpriseGroupDoesNotReuseGithubOwnership() async throws {\n2340|    // Flow entry: github.com ownership never adopts an enterprise group with\n2341|    // the same name. Without explicit takeover the enterprise resolve refuses.\n2342|    let harness = await registrationHarness(transport: TestTransport([\n2343|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n2344|    ]))\n2345|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2346|    try await harness.installer.saveOwnedGroupID(serverHost: \"github.com\", org: \"acme\", name: \"RunnerControl-Mac\", groupID: 5)\n2347|    await harness.identities.save(GitHubSessionIdentity(serverHost: \"enterprise.example\", userID: 7, clientID: testConfig.clientID, username: \"octo\"))\n2348|    try? await harness.userStore.save(\n2349|        GitHubAuth.TokenRecord(accessToken: \"enterprise-token\", refreshToken: \"refresh-e\", expiresAt: Date().addingTimeInterval(3600)),\n2350|        serverHost: \"enterprise.example\", userID: 7, clientID: testConfig.clientID\n2351|    )\n2352|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2353|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n2354|    let failure = lastFailure(harness.logger)\n2355|    #expect(failure?.step == \"resolveGroup\")\n2356|    #expect(failure?.message.contains(\"already exists\") ?? false)\n2357|    #expect(await harness.transport.requests.filter { $0.method != \"GET\" }.isEmpty)\n2358|}\n2359|\n2360|@Test func groupChangeRefusesOldConfiguredSuccess() async throws {\n2361|    // R3-F3 configuration class: `.runner` does not record the group, so the\n2362|    // marker does. A group edit never claims the old group's config.\n2363|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2364|    let transport = TestTransport([\n2365|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2366|        runnersListPayload([]),\n2367|        jsonResponse([\"token\": \"REG-SECRET-G\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2368|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2369|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2370|    ])\n2371|    let harness = await registrationHarness(\n2372|        transport: transport, downloader: fixtureDownloader(package.bytes), executor: SplitExecutor()\n2373|    )\n2374|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2375|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2376|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2377|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n2378|    var edited = orgDraft()\n2379|    edited.groupName = \"Other-Mac\"\n2380|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2381|    let before = registrationActions(harness.logger).count\n2382|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n2383|    let after = Array(registrationActions(harness.logger).dropFirst(before))\n2384|    #expect(!after.contains { if case .registered = $0 { true } else { false } })\n2385|    #expect(lastFailure(harness.logger)?.step == \"registerRunner\")\n2386|    #expect(lastFailure(harness.logger)?.message.contains(\"Other-Mac\") ?? false)\n2387|}\n2388|\n2389|@Test func runConfigRefusesWorkFolderMismatchOnResume() async throws {\n2390|    // Direct installer pin: the configured-marker resume verifies work\n2391|    // folder instead of returning the stale agent ID.\n2392|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2393|    let harness = await registrationHarness(\n2394|        transport: TestTransport([]), downloader: fixtureDownloader(package.bytes), executor: SplitExecutor()\n2395|    )\n2396|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2397|    let draft = orgDraft()\n2398|    let asset = RunnerRegistration.DownloadAsset(\n2399|        osName: \"osx\", architecture: \"arm64\",\n2400|        downloadURL: URL(string: \"https://example.com/x.tar.gz\")!,\n2401|        filename: \"x.tar.gz\", sha256Checksum: package.sha256ViaSystem\n2402|    )\n2403|    let directory = try await harness.installer.downloadAndInstall(asset: asset, draft: draft)\n2404|    _ = try await harness.installer.runConfig(\n2405|        directory: directory, scopeURL: \"https://github.com/acme\",\n2406|        token: \"TOKEN\", draft: draft, runnerGroup: \"RunnerControl-Mac\"\n2407|    )\n2408|    var changed = draft\n2409|    changed.workFolder = \"new_work\"\n2410|    do {\n2411|        _ = try await harness.installer.runConfig(\n2412|            directory: directory, scopeURL: \"https://github.com/acme\",\n2413|            token: \"TOKEN2\", draft: changed, runnerGroup: \"RunnerControl-Mac\"\n2414|        )\n2415|        Issue.record(\"runConfig admitted a work-folder mismatch on resume\")\n2416|    } catch let error as RunnerRegistration.RegistrationError {\n2417|        guard case .unverifiedRegistration(let text) = error else {\n2418|            Issue.record(\"wrong error for work-folder resume: \\(error)\")\n2419|            return\n2420|        }\n2421|        #expect(text.contains(\"new_work\"))\n2422|    }\n2423|}\n2424|\n2425|@Test @MainActor func inFlightLabelsAbandonedWhenLabelsEdited() async throws {\n2426|    // Directive class: labels stay editable, but a labels edit abandons the\n2427|    // in-flight applyLabels so the older completion can never overwrite the\n2428|    // newer visible selection. Re-applying then applies the new values.\n2429|    let package = try await FixturePackage.make(withRealConfigScript: false)\n2430|    let inner = TestTransport([\n2431|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n2432|        runnersListPayload([]),\n2433|        jsonResponse([\"token\": \"REG-SECRET-R4S\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n2434|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2435|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2436|        runnersListPayload([[\"id\": 4242, \"name\": \"macbook-test\", \"labels\": []]]),\n2437|        jsonResponse([\"labels\": [[\"name\": \"gpu\"], [\"name\": \"fast\"]]]),\n2438|    ])\n2439|    let (harness, latch) = await latchedHarness(\n2440|        inner: inner, needle: \"/actions/runners\", method: \"GET\", skip: 3,\n2441|        downloader: fixtureDownloader(package.bytes), executor: SplitExecutor()\n2442|    )\n2443|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2444|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n2445|    _ = await harness.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n2446|    _ = await harness.flow.apply(RunnerRegistration.Effect.registerRunner)\n2447|    let operation = Task { await harness.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\"])) }\n2448|    await latch.waitStarted()\n2449|    var edited = orgDraft()\n2450|    edited.labels = [\"gpu\", \"fast\"]\n2451|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2452|    await latch.release()\n2453|    _ = await operation.value\n2454|    #expect(await inner.requests.filter { $0.method == \"PUT\" }.isEmpty)\n2455|    #expect(!registrationActions(harness.logger).contains { if case .labelsApplied = $0 { true } else { false } })\n2456|    let mid = RunnerRegistration.State()\n2457|    for item in registrationActions(harness.logger) { await mid.reduce(with: item) }\n2458|    #expect(mid.draft?.labels == [\"gpu\", \"fast\"])\n2459|    // Recovery: applying the visible values now PUTs exactly those.\n2460|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyLabels([\"gpu\", \"fast\"]))\n2461|    let puts = await inner.requests.filter { $0.method == \"PUT\" }\n2462|    #expect(puts.count == 1)\n2463|    #expect(puts.first?.url.path.contains(\"/orgs/acme/actions/runners/4242/labels\") ?? false)\n2464|    #expect(registrationActions(harness.logger).contains {\n2465|        if case .labelsApplied(let labels) = $0, labels == [\"gpu\", \"fast\"] { true } else { false }\n2466|    })\n2467|}\n2468|\n2469|@Test @MainActor func inFlightAccessAbandonedWhenRepositoriesEdited() async throws {\n2470|    // Directive class: repository selection stays editable, but an edit\n2471|    // abandons the in-flight apply so the older write can never be reported\n2472|    // as the newer selection applied. The newer selection survives for retry.\n2473|    let inner = TestTransport([\n2474|        groupsListPayload([groupPayload(id: 5, name: \"RunnerControl-Mac\", visibility: \"selected\", allowsPublic: true)]),\n2475|        jsonResponse([\"repositories\": [[\"id\": 9]]]),\n2476|        GitHubHTTPResponse(status: 204, body: Data()),\n2477|        GitHubHTTPResponse(status: 204, body: Data()),\n2478|        jsonResponse([\"repositories\": [[\"id\": 9], [\"id\": 10]]]),\n2479|    ])\n2480|    let (harness, latch) = await latchedHarness(inner: inner, needle: \"repositories\", method: \"PUT\", skip: 0)\n2481|    defer { try? FileManager.default.removeItem(at: harness.home) }\n2482|    _ = await harness.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft(allowTakeover: true)))\n2483|    _ = await harness.flow.apply(RunnerRegistration.Effect.resolveGroup)\n2484|    let operation = Task {\n2485|        await harness.flow.apply(RunnerRegistration.Effect.applyRepositoryAccess(groupID: 5, repositories: [9]))\n2486|    }\n2487|    await latch.waitStarted()\n2488|    var edited = orgDraft(allowTakeover: true)\n2489|    edited.selectedRepositoryIDs = [9, 10]\n2490|    _ = await harness.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n2491|    await latch.release()\n2492|    _ = await operation.value\n2493|    #expect(!registrationActions(harness.logger).contains {\n2494|        if case .repositoryAccessApplied = $0 { true } else { false }\n2495|    })\n2496|    let mid = RunnerRegistration.State()\n2497|    for item in registrationActions(harness.logger) { await mid.reduce(with: item) }\n2498|    #expect(mid.draft?.selectedRepositoryIDs == [9, 10])\n2499|    // Recovery: applying the visible selection confirms exactly those IDs.\n2500|    _ = await harness.flow.apply(RunnerRegistration.Effect.applyRepositoryAccess(groupID: 5, repositories: [9, 10]))\n2501|    #expect(registrationActions(harness.logger).contains {\n2502|        if case .repositoryAccessApplied(let ids) = $0, Set(ids) == [9, 10] { true } else { false }\n2503|    })\n2504|}\n2505|\n2506|@Test func operationIdentityNormalizationAndChangeDetection() {\n2507|    // Pure pin: server aliasing and the identity/editable split that drives\n2508|    // generation invalidation.\n2509|    #expect(RunnerRegistration.OperationIdentity.normalizeServerHost(\"www.github.com\") == \"github.com\")\n2510|    #expect(RunnerRegistration.OperationIdentity.normalizeServerHost(\"GitHub.com\") == \"github.com\")\n2511|    #expect(RunnerRegistration.OperationIdentity.normalizeServerHost(\"enterprise.example\") == \"enterprise.example\")\n2512|    let base = orgDraft()\n2513|    var changed = base\n2514|    changed.labels = [\"self-hosted\", \"macOS\", \"gpu\"]\n2515|    #expect(!RunnerRegistration.Gates.identityFieldsChanged(old: base, new: changed))\n2516|    changed = base\n2517|    changed.selectedRepositoryIDs = [9, 10]\n2518|    #expect(!RunnerRegistration.Gates.identityFieldsChanged(old: base, new: changed))\n2519|    changed = base\n2520|    changed.allowReplace = true\n2521|    #expect(!RunnerRegistration.Gates.identityFieldsChanged(old: base, new: changed))\n2522|    changed = base\n2523|    changed.runnerName = \"other\"\n2524|    #expect(RunnerRegistration.Gates.identityFieldsChanged(old: base, new: changed))\n2525|    changed = base\n2526|    changed.installDirName = \"other-dir\"\n2527|    #expect(RunnerRegistration.Gates.identityFieldsChanged(old: base, new: changed))\n2528|    changed = base\n2529|    changed.workFolder = \"new_work\"\n2530|    #expect(RunnerRegistration.Gates.identityFieldsChanged(old: base, new: changed))\n2531|    changed = base\n2532|    changed.groupName = \"Other-Mac\"\n2533|    #expect(RunnerRegistration.Gates.identityFieldsChanged(old: base, new: changed))\n2534|    changed = base\n2535|    changed.scope = .repository(owner: \"octo\", name: \"app\")\n2536|    #expect(RunnerRegistration.Gates.identityFieldsChanged(old: base, new: changed))\n2537|    let repoBase = repoDraft()\n2538|    var repoChanged = repoBase\n2539|    repoChanged.groupName = \"Ignored-For-Repo\"\n2540|    #expect(!RunnerRegistration.Gates.identityFieldsChanged(old: repoBase, new: repoChanged))\n2541|}","final_result":true}}}
