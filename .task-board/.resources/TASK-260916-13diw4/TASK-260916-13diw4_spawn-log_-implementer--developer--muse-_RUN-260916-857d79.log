{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f5","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":213,"recorded_at":1780531400000421,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"task_stream":{"kind":"task","id":"01a0a8df-6a5d-7270-b9a9-aca1adadfa51"},"task_id":"01a0a8df-6a5d-7270-b9a9-aca1adadfa51","event":{"kind":"output","task_id":"01a0a8df-6a5d-7270-b9a9-aca1adadfa51","chunk":"Read text file `/Users/iv/Documents/Codex/2026-09-15/new-chat-4/outputs/RunnerControl/.task-board/.resources/TASK-260916-13diw4/TASK-260916-13diw4_review-attacks-rev4.swift`.\n1|\n2|// Reviewer-only tests appended to the immutable candidate in a disposable copy.\n3|@Test @MainActor func reviewerRetryCannotRunTwoConfigsInSameDirectory() async throws {\n4|    let package = try await FixturePackage.make(withRealConfigScript: false)\n5|    let executor = ConfigLatchExecutor()\n6|    let transport = TestTransport([\n7|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n8|        runnersListPayload([]),\n9|        jsonResponse([\"token\": \"REG-OLD\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n10|        runnersListPayload([]),\n11|        jsonResponse([\"token\": \"REG-NEW\", \"expires_at\": \"2030-01-01T00:00:00Z\"], status: 201),\n12|        runnersListPayload([[\"id\": 4242, \"name\": \"renamed-runner\", \"labels\": []]])\n13|    ])\n14|    let h = await registrationHarness(transport: transport, downloader: fixtureDownloader(package.bytes), executor: executor)\n15|    defer { try? FileManager.default.removeItem(at: h.home) }\n16|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n17|    _ = await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall)\n18|    let old = Task { await h.flow.apply(RunnerRegistration.Effect.registerRunner) }\n19|    await executor.waitStarted()\n20|    var edited = orgDraft()\n21|    edited.runnerName = \"renamed-runner\"\n22|    _ = await h.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n23|    _ = await h.flow.apply(RunnerRegistration.Effect.registerRunner)\n24|    let callsWhileOldRuns = await executor.configCalls.count\n25|    await executor.release()\n26|    _ = await old.value\n27|    #expect(callsWhileOldRuns == 1, \"An identity edit must not allow a second config.sh while the first still owns this directory\")\n28|    let state = RunnerRegistration.State()\n29|    for action in registrationActions(h.logger) { await state.reduce(with: action) }\n30|    let directory = await h.installer.directory(for: edited.installDirName)\n31|    let local = await h.installer.readLocalRegistration(directory: directory)\n32|    #expect(!state.completedSteps.contains(\"registerRunner\") || local?.agentName == edited.runnerName,\n33|            \"New registration is attested complete but old in-flight config overwrites .runner afterwards\")\n34|}\n35|\n36|private actor ReviewTwoDownloads {\n37|    private var count = 0\n38|    private var started: Set<Int> = []\n39|    private var startWaiters: [Int: CheckedContinuation<Void, Never>] = [:]\n40|    private var releases: [Int: CheckedContinuation<Void, Never>] = [:]\n41|    func download(_ bytes: Data) async throws -> Data {\n42|        count += 1\n43|        let n = count\n44|        started.insert(n)\n45|        startWaiters.removeValue(forKey: n)?.resume()\n46|        await withCheckedContinuation { releases[n] = $0 }\n47|        if n == 1 { throw GitHubTransportError.invalidResponse }\n48|        return bytes\n49|    }\n50|    func waitStarted(_ n: Int) async {\n51|        if started.contains(n) { return }\n52|        await withCheckedContinuation { startWaiters[n] = $0 }\n53|    }\n54|    func release(_ n: Int) { releases.removeValue(forKey: n)?.resume() }\n55|}\n56|\n57|@Test func reviewerStaleFailureCannotUnlockNewOperation() async throws {\n58|    let package = try await FixturePackage.make()\n59|    let latch = ReviewTwoDownloads()\n60|    let transport = TestTransport([\n61|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem)),\n62|        downloadsArrayPayload(downloadAssets(checksum: package.sha256ViaSystem))\n63|    ])\n64|    let h = await registrationHarness(transport: transport, downloader: { _ in try await latch.download(package.bytes) })\n65|    defer { try? FileManager.default.removeItem(at: h.home) }\n66|    _ = await h.flow.apply(RunnerRegistration.Effect.beginDraft(orgDraft()))\n67|    let old = Task { await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n68|    await latch.waitStarted(1)\n69|    var edited = orgDraft()\n70|    edited.installDirName = \"new-install\"\n71|    _ = await h.flow.apply(RunnerRegistration.Effect.updateDraft(edited))\n72|    let current = Task { await h.flow.apply(RunnerRegistration.Effect.downloadAndInstall) }\n73|    await latch.waitStarted(2)\n74|    await latch.release(1)\n75|    _ = await old.value\n76|    let before = await transport.requests.count\n77|    _ = await h.flow.apply(RunnerRegistration.Effect.prepareDownload)\n78|    let after = await transport.requests.count\n79|    await latch.release(2)\n80|    _ = await current.value\n81|    #expect(after == before, \"Old generation's catch must not clear the current operation's working lock\")\n82|}","final_result":true}}}
