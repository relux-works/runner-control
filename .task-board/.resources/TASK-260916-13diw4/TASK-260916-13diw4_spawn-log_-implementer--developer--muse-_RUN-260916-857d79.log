{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c659","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":391,"recorded_at":1780531400000777,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"call_id":"call_01a0a8dfbea171948ebdb6ac78ff296d","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerInstallerService.swift`.\n1|import CryptoKit\n2|import Foundation\n3|\n4|/// Filesystem installer for downloaded GitHub Actions runners.\n5|///\n6|/// Production path: download bytes → SHA-256 verify → tar extract →\n7|/// `bin/runsvc.sh` copied into the root and chmodded (as official `svc.sh`\n8|/// would) → exact `config.sh` invocation → manual LaunchAgent plist.\n9|/// All side effects stay below `installRoot`; tests inject a temporary root,\n10|/// a fake downloader, and fixtures instead of touching production runners.\n11|public actor RunnerInstallerService {\n12|    public static let markerFileName = \".runnercontrol-install.json\"\n13|    public static let installOS = \"osx\"\n14|\n15|    private let installRoot: URL\n16|    private let downloader: @Sendable (URL) async throws -> Data\n17|    private let executor: any CommandExecuting\n18|    private let currentArch: @Sendable () -> String\n19|    private let hasher: @Sendable (Data) -> String\n20|\n21|    public init(\n22|        installRoot: URL? = nil,\n23|        downloader: (@Sendable (URL) async throws -> Data)? = nil,\n24|        executor: (any CommandExecuting)? = nil,\n25|        currentArch: (@Sendable () -> String)? = nil,\n26|        hasher: (@Sendable (Data) -> String)? = nil\n27|    ) {\n28|        self.installRoot = installRoot\n29|            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(\"Library/GitHubActions\")\n30|        self.downloader = downloader ?? { url in\n31|            let (data, _) = try await URLSession.shared.data(from: url)\n32|            return data\n33|        }\n34|        self.executor = executor ?? CommandExecutor()\n35|        self.currentArch = currentArch ?? {\n36|            #if arch(arm64)\n37|            return \"arm64\"\n38|            #else\n39|            return \"x64\"\n40|            #endif\n41|        }\n42|        self.hasher = hasher ?? { data in\n43|            SHA256.hash(data: data).map { String(format: \"%02x\", $0) }.joined()\n44|        }\n45|    }\n46|\n47|    public nonisolated var root: URL { installRoot }\n48|    public nonisolated var architecture: String { currentArch() }\n49|\n50|    public func directory(for installDirName: String) -> URL {\n51|        installRoot.appendingPathComponent(installDirName)\n52|    }\n53|\n54|    // MARK: - Idempotency markers\n55|\n56|    public struct Marker: Codable, Sendable, Equatable {\n57|        public var scopeKey: String\n58|        public var completedSteps: Set<String>\n59|        /// Server the directory was configured against (`.runner` host is\n60|        /// authoritative; this records the config-time expectation so a\n61|        /// group/server change cannot reuse an old configured marker).\n62|        public var serverHost: String?\n63|        /// Dedicated group passed to `config.sh --runnergroup` (org scope).\n64|        /// `.runner` does not record it, so the marker must: a group-name\n65|        /// edit never claims the old group's configuration as its own.\n66|        public var groupName: String?\n67|        public init(\n68|            scopeKey: String, completedSteps: Set<String> = [],\n69|            serverHost: String? = nil, groupName: String? = nil\n70|        ) {\n71|            self.scopeKey = scopeKey; self.completedSteps = completedSteps\n72|            self.serverHost = serverHost; self.groupName = groupName\n73|        }\n74|    }\n75|\n76|    public static let stepDownloaded = \"downloaded\"\n77|    public static let stepInstalled = \"installed\"\n78|    public static let stepConfigured = \"configured\"\n79|    public static let stepServiceReady = \"serviceReady\"\n80|\n81|    public func loadMarker(directory: URL) -> Marker? {\n82|        let url = directory.appendingPathComponent(Self.markerFileName)\n83|        guard let data = try? Data(contentsOf: url) else { return nil }\n84|        return try? JSONDecoder().decode(Marker.self, from: data)\n85|    }\n86|\n87|    private func storeMarker(_ marker: Marker, directory: URL) throws {\n88|        let data = try JSONEncoder().encode(marker)\n89|        try data.write(to: directory.appendingPathComponent(Self.markerFileName), options: .atomic)\n90|    }\n91|\n92|    public func markCompleted(\n93|        _ step: String, directory: URL, scopeKey: String,\n94|        serverHost: String? = nil, groupName: String? = nil\n95|    ) throws {\n96|        var marker = loadMarker(directory: directory) ?? Marker(scopeKey: scopeKey)\n97|        marker.completedSteps.insert(step)\n98|        if let serverHost { marker.serverHost = serverHost }\n99|        if let groupName { marker.groupName = groupName }\n100|        try storeMarker(marker, directory: directory)\n101|    }\n102|\n103|    public func hasCompleted(_ step: String, directory: URL) -> Bool {\n104|        loadMarker(directory: directory)?.completedSteps.contains(step) == true\n105|    }\n106|\n107|    // MARK: - Install\n108|\n109|    /// Downloads, verifies, and extracts the official package. Idempotent:\n110|    /// a completed `installed` marker with matching scope and server skips\n111|    /// the work. Refuses to overwrite an already-registered directory (no\n112|    /// duplicates).\n113|    public func downloadAndInstall(\n114|        asset: RunnerRegistration.DownloadAsset,\n115|        draft: RunnerRegistration.Draft,\n116|        serverHost: String? = nil\n117|    ) async throws -> URL {\n118|        try RunnerRegistration.Gates.validateNoSpace(\n119|            installDirName: draft.installDirName, workFolder: draft.workFolder\n120|        )\n121|        let directory = self.directory(for: draft.installDirName)\n122|        if directory.path.contains(\" \") {\n123|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n124|        }\n125|        let files = FileManager.default\n126|        if let marker = loadMarker(directory: directory),\n127|           marker.completedSteps.contains(Self.stepInstalled),\n128|           marker.scopeKey == draft.scope.scopeKey,\n129|           Self.markerServerMatches(marker: marker, serverHost: serverHost),\n130|           files.fileExists(atPath: directory.appendingPathComponent(\"run.sh\").path) {\n131|            return directory\n132|        }\n133|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n134|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: draft.runnerName)\n135|        }\n136|        let bytes: Data\n137|        do {\n138|            bytes = try await downloader(asset.downloadURL)\n139|        } catch {\n140|            throw RunnerRegistration.RegistrationError.network(\"Runner download failed: \\(error.localizedDescription)\")\n141|        }\n142|        // Fail closed: the official downloads endpoint documents\n143|        // `sha256_checksum`, and an install without a verified digest is\n144|        // refused rather than trusted on TLS alone.\n145|        guard let expected = asset.sha256Checksum, !expected.isEmpty else {\n146|            throw RunnerRegistration.RegistrationError.integrityMismatch\n147|        }\n148|        let actual = hasher(bytes)\n149|        guard actual.lowercased() == expected.lowercased() else {\n150|            throw RunnerRegistration.RegistrationError.integrityMismatch\n151|        }\n152|        try files.createDirectory(at: directory, withIntermediateDirectories: true)\n153|        let archive = files.temporaryDirectory.appendingPathComponent(UUID().uuidString + \"-\" + asset.filename)\n154|        defer { try? files.removeItem(at: archive) }\n155|        try bytes.write(to: archive, options: .atomic)\n156|        let result = try await executor.run(\"/usr/bin/tar\", [\"-xzf\", archive.path, \"-C\", directory.path])\n157|        guard result.code == 0 else {\n158|            throw RunnerRegistration.RegistrationError.network(\n159|                \"Runner archive extraction failed: \\(String(result.output.prefix(300)))\"\n160|            )\n161|        }\n162|        // Official packages keep runsvc.sh under bin/ until svc.sh installs it;\n163|        // a bare extraction leaves the root copy absent, so install it here.\n164|        try installRunsvc(directory: directory)\n165|        try markCompleted(\n166|            Self.stepDownloaded, directory: directory,\n167|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n168|        )\n169|        try markCompleted(\n170|            Self.stepInstalled, directory: directory,\n171|            scopeKey: draft.scope.scopeKey, serverHost: serverHost\n172|        )\n173|        return directory\n174|    }\n175|\n176|    /// Server binding for install reuse. A marker written without a server\n177|    /// (pre-revision-4) never satisfies a server-bound request: the next\n178|    /// install re-verifies instead of reusing unknown provenance. Direct\n179|    /// installer calls without a server (unit fixtures) keep the legacy\n180|    /// scope-only reuse.\n181|    static func markerServerMatches(marker: Marker, serverHost: String?) -> Bool {\n182|        guard let want = serverHost else { return true }\n183|        guard let have = marker.serverHost else { return false }\n184|        return RunnerRegistration.OperationIdentity.normalizeServerHost(have)\n185|            == RunnerRegistration.OperationIdentity.normalizeServerHost(want)\n186|    }\n187|\n188|    /// Copies official `bin/runsvc.sh` into the installation root and makes\n189|    /// it executable, mirroring what official `svc.sh install` would do.\n190|    public func installRunsvc(directory: URL) throws {\n191|        let files = FileManager.default\n192|        let source = directory.appendingPathComponent(\"bin/runsvc.sh\")\n193|        let target = directory.appendingPathComponent(\"runsvc.sh\")\n194|        guard files.fileExists(atPath: source.path) else {\n195|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing bin/runsvc.sh.\")\n196|        }\n197|        if files.fileExists(atPath: target.path) {\n198|            try files.removeItem(at: target)\n199|        }\n200|        try files.copyItem(at: source, to: target)\n201|        try files.setAttributes([.posixPermissions: 0o755], ofItemAtPath: target.path)\n202|    }\n203|\n204|    // MARK: - Configure\n205|\n206|    /// Runs the exact `config.sh` invocation. Skips when a previous attempt\n207|    /// already registered this directory (marker + `.runner` present), so\n208|    /// retries never create orphan or duplicate GitHub registrations.\n209|    /// Returns the local agent ID read back from `.runner`.\n210|    @discardableResult\n211|    public func runConfig(\n212|        directory: URL,\n213|        scopeURL: String,\n214|        token: String,\n215|        draft: RunnerRegistration.Draft,\n216|        runnerGroup: String?\n217|    ) async throws -> Int64? {\n218|        try await runConfig(\n219|            directory: directory, scopeURL: scopeURL, token: token,\n220|            draft: draft, runnerGroup: runnerGroup, replace: draft.allowReplace\n221|        )\n222|    }\n223|\n224|    /// Explicit-`replace` variant. Production callers pass\n225|    /// `draft.allowReplace`; tests drive both values.\n226|    @discardableResult\n227|    public func runConfig(\n228|        directory: URL,\n229|        scopeURL: String,\n230|        token: String,\n231|        draft: RunnerRegistration.Draft,\n232|        runnerGroup: String?,\n233|        replace: Bool\n234|    ) async throws -> Int64? {\n235|        let files = FileManager.default\n236|        let scopeHost = URL(string: scopeURL)?.host ?? \"\"\n237|        if hasCompleted(Self.stepConfigured, directory: directory),\n238|           files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) {\n239|            // Idempotent resume never returns a stale ID: the existing\n240|            // configuration must still match this draft on this server.\n241|            let local = readLocalRegistration(directory: directory)\n242|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n243|                local: local, configured: true, draft: draft, serverHost: scopeHost\n244|            )\n245|            try Self.verifyConfiguredGroup(\n246|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n247|            )\n248|            return verified\n249|        }\n250|        if files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path),\n251|           hasCompleted(Self.stepConfigured, directory: directory) {\n252|            let local = readLocalRegistration(directory: directory)\n253|            let verified = try RunnerRegistration.Gates.verifiedLocalAgentID(\n254|                local: local, configured: true, draft: draft, serverHost: scopeHost\n255|            )\n256|            try Self.verifyConfiguredGroup(\n257|                marker: loadMarker(directory: directory), runnerGroup: runnerGroup, draft: draft\n258|            )\n259|            return verified\n260|        }\n261|        let spec = RunnerRegistration.ConfigSpec(\n262|            scopeURL: scopeURL, token: token, name: draft.runnerName,\n263|            workFolder: draft.workFolder, labels: draft.labels,\n264|            runnerGroup: runnerGroup, replace: replace\n265|        )\n266|        let args = RunnerRegistration.ConfigInvocation.arguments(spec)\n267|        let executable = directory.appendingPathComponent(\"config.sh\").path\n268|        guard files.fileExists(atPath: executable) else {\n269|            throw RunnerRegistration.RegistrationError.network(\"Runner package is missing config.sh.\")\n270|        }\n271|        let result = try await executor.run(executable, args)\n272|        guard result.code == 0 else {\n273|            // Never echo the token: config output may repeat arguments.\n274|            let scrubbed = GitHubAuth.Redaction.sanitize(result.output, secrets: [token])\n275|            throw RunnerRegistration.RegistrationError.configFailed(String(scrubbed.prefix(700)))\n276|        }\n277|        guard files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n278|            throw RunnerRegistration.RegistrationError.configFailed(\n279|                \"config.sh reported success but .runner is missing.\"\n280|            )\n281|        }\n282|        try markCompleted(\n283|            Self.stepConfigured, directory: directory, scopeKey: draft.scope.scopeKey,\n284|            serverHost: scopeHost, groupName: runnerGroup\n285|        )\n286|        return readAgentID(directory: directory)\n287|    }\n288|\n289|    /// `.runner` does not record the org group, so the configured marker\n290|    /// does. A resume whose marker names another group (or predates group\n291|    /// recording) refuses instead of claiming the old group's configuration\n292|    /// as the new draft's. Repository scope never configures a group.\n293|    static func verifyConfiguredGroup(\n294|        marker: Marker?, runnerGroup: String?, draft: RunnerRegistration.Draft\n295|    ) throws {\n296|        switch draft.scope {\n297|        case .repository:\n298|            return\n299|        case .organization:\n300|            break\n301|        }\n302|        let wanted = (runnerGroup ?? draft.groupName).trimmingCharacters(in: .whitespacesAndNewlines)\n303|        guard let have = marker?.groupName?.trimmingCharacters(in: .whitespacesAndNewlines),\n304|              !have.isEmpty else {\n305|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n306|                \"Directory '\\(draft.installDirName)' was configured before group recording. Reconfigure for group '\\(wanted)' instead of reusing the old configuration.\"\n307|            )\n308|        }\n309|        guard have == wanted else {\n310|            throw RunnerRegistration.RegistrationError.unverifiedRegistration(\n311|                \"Local registration was configured for group '\\(have)', not '\\(wanted)'. Reconfigure instead of reusing the old group's configuration.\"\n312|            )\n313|        }\n314|    }\n315|\n316|    // MARK: - Dedicated-group ownership\n317|\n318|    public static let ownershipFileName = \".runnercontrol-groups.json\"\n319|\n320|    private func ownershipFile() -> URL {\n321|        installRoot.appendingPathComponent(Self.ownershipFileName)\n322|    }\n323|\n324|    private static func ownershipKey(serverHost: String, org: String, name: String) -> String {\n325|        \"\\(RunnerRegistration.OperationIdentity.normalizeServerHost(serverHost))\\u{0}\\(org.lowercased())\\u{0}\\(name)\"\n326|    }\n327|\n328|    /// Returns the locally recorded dedicated-group ID for\n329|    /// `server` + `org` + `name`, or nil when this Mac never created (or\n330|    /// took over) that group on that server. Name matches on GitHub alone\n331|    /// never count as ownership, and ownership on one server never\n332|    /// authorizes adoption on another.\n333|    public func loadOwnedGroupID(serverHost: String, org: String, name: String) -> Int64? {\n334|        guard let data = try? Data(contentsOf: ownershipFile()),\n335|              let table = try? JSONDecoder().decode([String: Int64].self, from: data) else { return nil }\n336|        return table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)]\n337|    }\n338|\n339|    public func saveOwnedGroupID(serverHost: String, org: String, name: String, groupID: Int64) throws {\n340|        let file = ownershipFile()\n341|        var table: [String: Int64] = [:]\n342|        if let data = try? Data(contentsOf: file),\n343|           let decoded = try? JSONDecoder().decode([String: Int64].self, from: data) {\n344|            table = decoded\n345|        }\n346|        table[Self.ownershipKey(serverHost: serverHost, org: org, name: name)] = groupID\n347|        try FileManager.default.createDirectory(at: installRoot, withIntermediateDirectories: true)\n348|        let data = try JSONEncoder().encode(table)\n349|        try data.write(to: file, options: .atomic)\n350|    }\n351|\n352|    /// Reads the local `.runner` identity without touching credentials.\n353|    /// Returns nil only when the file is missing or unparseable; a present\n354|    /// but incomplete file returns a partial struct so verification can name\n355|    /// the exact missing field instead of crashing.\n356|    public func readLocalRegistration(directory: URL) -> RunnerRegistration.LocalRegistration? {\n357|        guard let data = try? Data(contentsOf: directory.appendingPathComponent(\".runner\")),\n358|              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }\n359|        var agentID: Int64?\n360|        if let id = object[\"agentId\"] as? Int64 { agentID = id }\n361|        else if let id = object[\"agentId\"] as? Int { agentID = Int64(id) }\n362|        else if let id = object[\"agentId\"] as? NSNumber { agentID = id.int64Value }\n363|        return RunnerRegistration.LocalRegistration(\n364|            agentID: agentID,\n365|            agentName: object[\"agentName\"] as? String,\n366|            gitHubURL: object[\"gitHubUrl\"] as? String,\n367|            workFolder: object[\"workFolder\"] as? String\n368|        )\n369|    }\n370|\n371|    /// Reads the local agent ID from `.runner` without touching credentials.\n372|    public func readAgentID(directory: URL) -> Int64? {\n373|        readLocalRegistration(directory: directory)?.agentID\n374|    }\n375|\n376|    // MARK: - Manual LaunchAgent\n377|\n378|    /// Writes the manual service plist (RunAtLoad off for new runners) and\n379|    /// validates it matches the directory. Never bootstraps the service:\n380|    /// enabling is the user's separate action.\n381|    @discardableResult\n382|    public func setupService(directory: URL, label: String) throws -> URL {\n383|        guard !directory.path.contains(\" \") else {\n384|            throw RunnerRegistration.RegistrationError.noSpacePath(\"Installation path must not contain spaces.\")\n385|        }\n386|        let files = FileManager.default\n387|        guard files.fileExists(atPath: directory.appendingPathComponent(\"runsvc.sh\").path) else {\n388|            throw RunnerRegistration.RegistrationError.network(\n389|                \"runsvc.sh is missing; reinstall before setting up the service.\"\n390|            )\n391|        }\n392|        let plist = directory.appendingPathComponent(\"manual-service.plist\")\n393|        let payload: [String: Any] = [\n394|            \"Label\": label,\n395|            \"ProgramArguments\": [directory.appendingPathComponent(\"runsvc.sh\").path],\n396|            \"WorkingDirectory\": directory.path,\n397|            \"RunAtLoad\": false\n398|        ]\n399|        let data = try PropertyListSerialization.data(fromPropertyList: payload, format: .xml, options: 0)\n400|        try data.write(to: plist, options: .atomic)\n401|        let scopeKey = loadMarker(directory: directory)?.scopeKey ?? \"\"\n402|        try markCompleted(Self.stepServiceReady, directory: directory, scopeKey: scopeKey)\n403|        return plist\n404|    }\n405|\n406|    /// Removes a failed partial install so retries start clean. Refuses to\n407|    /// touch directories that already hold a registration (`.runner`) or an\n408|    /// unknown marker scope: recovery never deletes a working runner.\n409|    public func recoverPartialInstall(directory: URL, scopeKey: String) throws {\n410|        let files = FileManager.default\n411|        guard files.fileExists(atPath: directory.path) else { return }\n412|        guard !files.fileExists(atPath: directory.appendingPathComponent(\".runner\").path) else {\n413|            throw RunnerRegistration.RegistrationError.alreadyRegistered(name: directory.lastPathComponent)\n414|        }\n415|        if let marker = loadMarker(directory: directory), marker.scopeKey != scopeKey {\n416|            throw RunnerRegistration.RegistrationError.alreadyInstalled(path: directory.path)\n417|        }\n418|        try files.removeItem(at: directory)\n419|    }\n420|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65b","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":392,"recorded_at":1780531400000779,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"call_id":"call_01a0a8dfc00d750184eb939e1138d93f","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Gates.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Validation gates. Each gate refuses a concrete invalid class; negative\n5|    /// tests narrow every one of them.\n6|    public enum Gates {\n7|        /// Refuses install/work paths containing spaces. GitHub's own setup has\n8|        /// a known defect with spaced paths; the wizard never reproduces it.\n9|        public static func validateNoSpace(installDirName: String, workFolder: String) throws {\n10|            if installDirName.contains(\" \") {\n11|                throw RegistrationError.noSpacePath(\"Installation folder name must not contain spaces.\")\n12|            }\n13|            if installDirName.contains(\"/\") || installDirName.isEmpty {\n14|                throw RegistrationError.invalidDraft(\"Installation folder name is invalid.\")\n15|            }\n16|            if workFolder.contains(\" \") {\n17|                throw RegistrationError.noSpacePath(\"Work folder must not contain spaces.\")\n18|            }\n19|            if workFolder.isEmpty || workFolder.contains(\"/\") {\n20|                throw RegistrationError.invalidDraft(\"Work folder name is invalid.\")\n21|            }\n22|        }\n23|\n24|        /// Validates the full draft before any network or filesystem mutation.\n25|        public static func validateDraft(_ draft: Draft) throws {\n26|            let name = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n27|            guard !name.isEmpty else {\n28|                throw RegistrationError.invalidDraft(\"Runner name must not be empty.\")\n29|            }\n30|            guard name.count <= 64 else {\n31|                throw RegistrationError.invalidDraft(\"Runner name is too long (max 64 characters).\")\n32|            }\n33|            let labels = draft.labels.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }\n34|            guard !labels.isEmpty else {\n35|                throw RegistrationError.invalidDraft(\"At least one label is required.\")\n36|            }\n37|            for label in labels {\n38|                guard !label.isEmpty else {\n39|                    throw RegistrationError.invalidDraft(\"Labels must not be empty.\")\n40|                }\n41|                guard label.count <= 100 else {\n42|                    throw RegistrationError.invalidDraft(\"Label '\\(label)' is too long (max 100 characters).\")\n43|                }\n44|            }\n45|            try validateNoSpace(installDirName: draft.installDirName, workFolder: draft.workFolder)\n46|            switch draft.scope {\n47|            case .organization:\n48|                let group = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n49|                guard !group.isEmpty else {\n50|                    throw RegistrationError.invalidDraft(\"Organization runners need a dedicated per-Mac group name.\")\n51|                }\n52|            case .repository:\n53|                break\n54|            }\n55|        }\n56|\n57|        /// Picks the architecture-matched official asset. Refuses any\n58|        /// substitute: both OS and architecture must match exactly.\n59|        public static func selectDownload(\n60|            osName: String, arch: String, from assets: [DownloadAsset]\n61|        ) throws -> DownloadAsset {\n62|            guard let match = assets.first(where: { $0.osName == osName && $0.architecture == arch }) else {\n63|                throw RegistrationError.downloadMismatch(osName: osName, arch: arch)\n64|            }\n65|            return match\n66|        }\n67|\n68|        /// Authorizes a group mutation only when the UI explicitly scoped it\n69|        /// AND the target is this run's resolved dedicated group. Never\n70|        /// mutates unrelated or shared groups.\n71|        public static func authorizeGroupMutation(\n72|            targetGroupID: Int64, resolvedGroupID: Int64?, allowFlag: Bool\n73|        ) throws {\n74|            guard allowFlag else { throw RegistrationError.groupScopeNotConfirmed }\n75|            guard let resolved = resolvedGroupID, resolved == targetGroupID else {\n76|                throw RegistrationError.refusesSharedGroup(groupID: targetGroupID)\n77|            }\n78|        }\n79|\n80|        /// Repository scope never touches groups: personal repos get separate\n81|        /// installations without shared-group coupling.\n82|        public static func requireOrganizationScope(_ scope: Scope) throws {\n83|            if case .organization = scope { return }\n84|            throw RegistrationError.groupNotApplicable\n85|        }\n86|\n87|        /// Ownership check for a pre-existing group with the requested name.\n88|        /// A name match alone never authorizes adoption: the caller must show\n89|        /// either a locally recorded ownership entry for the same group ID or\n90|        /// an explicit UI takeover confirmation.\n91|        public static func authorizeGroupTakeover(\n92|            groupName: String, existingID: Int64, ownedID: Int64?, allowTakeover: Bool\n93|        ) throws {\n94|            if let owned = ownedID, owned == existingID { return }\n95|            guard allowTakeover else {\n96|                throw RegistrationError.groupNameTaken(name: groupName, groupID: existingID)\n97|            }\n98|        }\n99|\n100|        /// Duplicate-name guard run before any registration token is minted.\n101|        /// Without explicit replace consent a remote name match refuses the\n102|        /// run so `config.sh` can never silently replace another machine.\n103|        public static func rejectRemoteDuplicate(name: String, isTaken: Bool, allowReplace: Bool) throws {\n104|            guard isTaken, !allowReplace else { return }\n105|            throw RegistrationError.remoteNameTaken(name: name)\n106|        }\n107|\n108|        /// Verifies the local `.runner` identity belongs to this draft's\n109|        /// operation on the authenticated server. Returns the verified local\n110|        /// agent ID. Refuses anything else: an unconfigured directory, a\n111|        /// missing or unreadable agent ID, a name mismatch, a server/scope\n112|        /// mismatch, or a work-folder mismatch. Agent IDs belong to their\n113|        /// server: a same-ID foreign host never authorizes writes on this\n114|        /// session's server. A remote name match alone never authorizes\n115|        /// writes to another runner.\n116|        public static func verifiedLocalAgentID(\n117|            local: LocalRegistration?, configured: Bool, draft: Draft, serverHost: String\n118|        ) throws -> Int64 {\n119|            guard configured else {\n120|                throw RegistrationError.unverifiedRegistration(\n121|                    \"Directory '\\(draft.installDirName)' was never configured by this wizard. Register it first; refusing a planted or foreign registration.\"\n122|                )\n123|            }\n124|            guard let local, let agentID = local.agentID else {\n125|                throw RegistrationError.unverifiedRegistration(\n126|                    \"No verified local registration for '\\(draft.runnerName)': install and register this directory first; refusing to touch a runner that is not this installation.\"\n127|                )\n128|            }\n129|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n130|            guard let name = local.agentName, name == wanted else {\n131|                throw RegistrationError.unverifiedRegistration(\n132|                    \"Local registration is for '\\(local.agentName ?? \"unknown\")', not '\\(wanted)'. Refusing to use another registration's identity.\"\n133|                )\n134|            }\n135|            guard let address = local.gitHubURL,\n136|                  scopeMatches(address: address, scope: draft.scope, serverHost: serverHost) else {\n137|                throw RegistrationError.unverifiedRegistration(\n138|                    \"Local registration points at '\\(local.gitHubURL ?? \"unknown\")', not this draft's scope on \\(OperationIdentity.normalizeServerHost(serverHost)). Refusing to use another registration's identity.\"\n139|                )\n140|            }\n141|            let wantedWork = draft.workFolder.trimmingCharacters(in: .whitespacesAndNewlines)\n142|            guard let work = local.workFolder, work == wantedWork else {\n143|                throw RegistrationError.unverifiedRegistration(\n144|                    \"Local registration uses work folder '\\(local.workFolder ?? \"unknown\")', not '\\(wantedWork)'. Reconfigure for the new work folder instead of reusing the old configuration.\"\n145|                )\n146|            }\n147|            return agentID\n148|        }\n149|\n150|        /// Matches a `.runner` gitHubUrl against a draft scope on the\n151|        /// authenticated server. Host must equal the session server\n152|        /// (`www.github.com` aliases `github.com`); path mirrors\n153|        /// RunnerDiscovery's parsing (one component for an org, two for\n154|        /// owner/repo). GitHub logins compare case-insensitively. Agent IDs\n155|        /// are server-scoped, so a same-path foreign host never matches.\n156|        public static func scopeMatches(address: String, scope: Scope, serverHost: String) -> Bool {\n157|            guard let url = URL(string: address), url.scheme == \"https\" else { return false }\n158|            guard let host = url.host,\n159|                  OperationIdentity.normalizeServerHost(host)\n160|                    == OperationIdentity.normalizeServerHost(serverHost) else { return false }\n161|            let components = url.pathComponents.filter { $0 != \"/\" }.map { $0.lowercased() }\n162|            switch scope {\n163|            case .organization(let org):\n164|                return components == [org.lowercased()]\n165|            case .repository(let owner, let name):\n166|                return components == [owner.lowercased(), name.lowercased()]\n167|            }\n168|        }\n169|\n170|        /// True when an edit changes operation identity (server is bound\n171|        /// separately via the authenticated session): scope, install folder,\n172|        /// runner name, work folder, or the dedicated group for org scope.\n173|        /// Labels, repository selections, and consent flags are editable and\n174|        /// never invalidate an in-flight operation.\n175|        public static func identityFieldsChanged(old: Draft, new: Draft) -> Bool {\n176|            if old.scope != new.scope { return true }\n177|            if old.installDirName != new.installDirName { return true }\n178|            let oldName = old.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n179|            let newName = new.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n180|            if oldName != newName { return true }\n181|            if old.workFolder != new.workFolder { return true }\n182|            let oldIsOrg: Bool = if case .organization = old.scope { true } else { false }\n183|            let newIsOrg: Bool = if case .organization = new.scope { true } else { false }\n184|            if oldIsOrg || newIsOrg {\n185|                let oldGroup = old.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n186|                let newGroup = new.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n187|                if oldGroup != newGroup { return true }\n188|            }\n189|            return false\n190|        }\n191|\n192|        /// Binds the complete remote runner list to the verified local agent\n193|        /// ID. Returns the bound runner ID, or nil when this agent is not\n194|        /// listed yet (retryable convergence, never an error by itself).\n195|        /// Throws when the list contradicts the local identity — a same-name\n196|        /// foreign runner or a renamed local agent — instead of guessing.\n197|        public static func boundRemoteRunnerID(\n198|            localAgentID: Int64, name: String, runners: [RegisteredRunner]\n199|        ) throws -> Int64? {\n200|            if let exact = runners.first(where: { $0.id == localAgentID }) {\n201|                guard exact.name == name else {\n202|                    throw RegistrationError.remoteIdentityMismatch(\n203|                        \"GitHub lists agent \\(localAgentID) as '\\(exact.name)', not '\\(name)'. Refusing to write to a mismatched registration.\"\n204|                    )\n205|                }\n206|                return exact.id\n207|            }\n208|            if let foreign = runners.first(where: { $0.name == name }) {\n209|                throw RegistrationError.remoteIdentityMismatch(\n210|                    \"This installation is agent \\(localAgentID), but GitHub shows '\\(name)' as agent \\(foreign.id). Refusing to adopt another runner's identity.\"\n211|                )\n212|            }\n213|            return nil\n214|        }\n215|\n216|        /// Confirms a repository-access write against the complete confirmed\n217|        /// list. Any difference — missing or extra IDs — fails closed instead\n218|        /// of reporting partial access as complete.\n219|        public static func confirmRepositoryIDs(requested: Set<Int64>, confirmed: [Int64]) throws {\n220|            guard Set(confirmed) == requested else {\n221|                throw RegistrationError.confirmationMismatch(\n222|                    \"GitHub confirmed repositories \\(confirmed.sorted()) but \\(requested.sorted()) was requested. Refusing to report partial access as complete.\"\n223|                )\n224|            }\n225|        }\n226|    }\n227|\n228|    /// Exact `config.sh` invocation inputs.\n229|    public struct ConfigSpec: Sendable, Equatable {\n230|        let scopeURL: String\n231|        let token: String\n232|        let name: String\n233|        let workFolder: String\n234|        let labels: [String]\n235|        let runnerGroup: String?\n236|        /// Explicit `--replace`. Production sets it only from\n237|        /// `Draft.allowReplace`; default invocations omit the flag so a\n238|        /// duplicate name fails instead of stealing another registration.\n239|        let replace: Bool\n240|    }\n241|\n242|    /// Exact `config.sh` invocation builder. Argument order is fixed and\n243|    /// covered by tests; production runs this exact array.\n244|    public enum ConfigInvocation {\n245|        public static func arguments(_ spec: ConfigSpec) -> [String] {\n246|            var args = [\n247|                \"--url\", spec.scopeURL,\n248|                \"--token\", spec.token,\n249|                \"--name\", spec.name,\n250|                \"--work\", spec.workFolder,\n251|                \"--labels\", spec.labels.joined(separator: \",\")\n252|            ]\n253|            if let group = spec.runnerGroup, !group.isEmpty {\n254|                args += [\"--runnergroup\", group]\n255|            }\n256|            args += [\"--unattended\"]\n257|            if spec.replace {\n258|                args += [\"--replace\"]\n259|            }\n260|            return args\n261|        }\n262|    }\n263|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65d","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":393,"recorded_at":1780531400000781,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"call_id":"call_01a0a8dfc203763293296df7317f92b3","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Models.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Registration scope. One wizard run registers exactly one scope:\n5|    /// an organization (shared, via a dedicated per-Mac group) or a single\n6|    /// personal repository (separate installation, no group).\n7|    public enum Scope: Sendable, Equatable, Hashable {\n8|        case organization(org: String)\n9|        case repository(owner: String, name: String)\n10|\n11|        /// REST path prefix below the API base URL, e.g. `orgs/acme` or `repos/acme/app`.\n12|        public var apiPrefix: String {\n13|            switch self {\n14|            case .organization(let org): \"orgs/\\(org)\"\n15|            case .repository(let owner, let name): \"repos/\\(owner)/\\(name)\"\n16|            }\n17|        }\n18|\n19|        /// Short key for token-store accounts and markers. Never contains secrets.\n20|        public var scopeKey: String {\n21|            switch self {\n22|            case .organization(let org): \"org:\\(org)\"\n23|            case .repository(let owner, let name): \"repo:\\(owner)/\\(name)\"\n24|            }\n25|        }\n26|\n27|        /// URL passed to `config.sh --url`. Enterprise hosts keep their own server.\n28|        public func configURL(serverHost: String) -> String {\n29|            let host = serverHost == \"github.com\" || serverHost == \"www.github.com\"\n30|                ? \"https://github.com\"\n31|                : \"https://\\(serverHost)\"\n32|            switch self {\n33|            case .organization(let org): return \"\\(host)/\\(org)\"\n34|            case .repository(let owner, let name): return \"\\(host)/\\(owner)/\\(name)\"\n35|            }\n36|        }\n37|\n38|        /// Detail line shown in UI, e.g. `acme` or `acme/app`.\n39|        public var detail: String {\n40|            switch self {\n41|            case .organization(let org): org\n42|            case .repository(let owner, let name): \"\\(owner)/\\(name)\"\n43|            }\n44|        }\n45|    }\n46|\n47|    /// User-editable wizard input. Holds no tokens.\n48|    public struct Draft: Sendable, Equatable {\n49|        public var scope: Scope\n50|        public var runnerName: String\n51|        public var labels: [String]\n52|        public var installDirName: String\n53|        public var workFolder: String\n54|        /// Dedicated per-Mac group name for org scope. Ignored for repo scope.\n55|        public var groupName: String\n56|        public var selectedRepositoryIDs: Set<Int64>\n57|        /// Explicit UI scope: user confirmed that group mutations apply only\n58|        /// to the resolved dedicated group. Never implied.\n59|        public var allowGroupMutation: Bool\n60|        /// Explicit takeover: user confirmed that a pre-existing group with\n61|        /// the same name is this Mac's dedicated group. Name alone never\n62|        /// authorizes adopting or editing a shared group.\n63|        public var allowGroupTakeover: Bool\n64|        /// Explicit replace: user confirmed that config may replace an\n65|        /// existing GitHub registration with the same runner name. Without\n66|        /// it the wizard refuses remote duplicates instead of silently\n67|        /// stealing another machine's registration via `--replace`.\n68|        public var allowReplace: Bool\n69|\n70|        public init(\n71|            scope: Scope,\n72|            runnerName: String,\n73|            labels: [String] = [\"self-hosted\", \"macOS\"],\n74|            installDirName: String,\n75|            workFolder: String = \"_work\",\n76|            groupName: String = \"\",\n77|            selectedRepositoryIDs: Set<Int64> = [],\n78|            allowGroupMutation: Bool = false,\n79|            allowGroupTakeover: Bool = false,\n80|            allowReplace: Bool = false\n81|        ) {\n82|            self.scope = scope\n83|            self.runnerName = runnerName\n84|            self.labels = labels\n85|            self.installDirName = installDirName\n86|            self.workFolder = workFolder\n87|            self.groupName = groupName\n88|            self.selectedRepositoryIDs = selectedRepositoryIDs\n89|            self.allowGroupMutation = allowGroupMutation\n90|            self.allowGroupTakeover = allowGroupTakeover\n91|            self.allowReplace = allowReplace\n92|        }\n93|\n94|        /// Default per-Mac group name derived from the Mac name.\n95|        public static func defaultGroupName(hostName: String) -> String {\n96|            let trimmed = hostName.trimmingCharacters(in: .whitespacesAndNewlines)\n97|            let base = trimmed.isEmpty ? \"Mac\" : trimmed\n98|            return \"RunnerControl-\\(base)\"\n99|        }\n100|    }\n101|\n102|    /// Immutable operation identity. Every async step captures it at start\n103|    /// and binds its completion to it: a draft edit that changes any field,\n104|    /// or an authenticated-server change, abandons the in-flight completion\n105|    /// instead of attributing stale success to the new identity. Labels,\n106|    /// selected repositories, and consent flags are editable selections, not\n107|    /// identity: they re-target pending retries to the visible values.\n108|    public struct OperationIdentity: Sendable, Equatable {\n109|        public let serverHost: String\n110|        public let scope: Scope\n111|        public let installDirName: String\n112|        public let runnerName: String\n113|        public let workFolder: String\n114|        public let groupName: String\n115|\n116|        public init(\n117|            serverHost: String, scope: Scope, installDirName: String,\n118|            runnerName: String, workFolder: String, groupName: String\n119|        ) {\n120|            self.serverHost = Self.normalizeServerHost(serverHost)\n121|            self.scope = scope\n122|            self.installDirName = installDirName\n123|            self.runnerName = runnerName\n124|            self.workFolder = workFolder\n125|            self.groupName = groupName\n126|        }\n127|\n128|        /// Canonical server comparison. `www.github.com` is the same\n129|        /// deployment as `github.com`; every other host compares lowercased.\n130|        public static func normalizeServerHost(_ host: String) -> String {\n131|            let lowered = host.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()\n132|            if lowered == \"www.github.com\" { return \"github.com\" }\n133|            return lowered\n134|        }\n135|\n136|        public static func make(draft: Draft, serverHost: String) -> Self {\n137|            let group: String\n138|            switch draft.scope {\n139|            case .organization:\n140|                group = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n141|            case .repository:\n142|                group = \"\"\n143|            }\n144|            return Self(\n145|                serverHost: serverHost,\n146|                scope: draft.scope,\n147|                installDirName: draft.installDirName,\n148|                runnerName: draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines),\n149|                workFolder: draft.workFolder,\n150|                groupName: group\n151|            )\n152|        }\n153|    }\n154|\n155|    /// Official runner download asset as returned by the downloads endpoint.\n156|    public struct DownloadAsset: Sendable, Equatable {\n157|        public let osName: String\n158|        public let architecture: String\n159|        public let downloadURL: URL\n160|        public let filename: String\n161|        public let sha256Checksum: String?\n162|        public init(osName: String, architecture: String, downloadURL: URL, filename: String, sha256Checksum: String?) {\n163|            self.osName = osName; self.architecture = architecture\n164|            self.downloadURL = downloadURL; self.filename = filename\n165|            self.sha256Checksum = sha256Checksum\n166|        }\n167|    }\n168|\n169|    /// Runner group summary. Repository access is fetched separately.\n170|    /// `allowsPublicRepositories` mirrors GitHub's `allows_public_repositories`\n171|    /// flag: without it a `selected`-visibility group silently denies every\n172|    /// selected public repository.\n173|    public struct RunnerGroup: Sendable, Equatable {\n174|        public let id: Int64\n175|        public let name: String\n176|        public let visibility: String\n177|        public let allowsPublicRepositories: Bool\n178|        public init(id: Int64, name: String, visibility: String, allowsPublicRepositories: Bool = false) {\n179|            self.id = id; self.name = name; self.visibility = visibility\n180|            self.allowsPublicRepositories = allowsPublicRepositories\n181|        }\n182|    }\n183|\n184|    /// Registered runner identity fetched from GitHub after config.\n185|    public struct RegisteredRunner: Sendable, Equatable {\n186|        public let id: Int64\n187|        public let name: String\n188|        public let labels: [String]\n189|        public init(id: Int64, name: String, labels: [String]) {\n190|            self.id = id; self.name = name; self.labels = labels\n191|        }\n192|    }\n193|\n194|    /// Local `.runner` identity, read without touching credentials.\n195|    /// Every field is optional because a missing, corrupt, or foreign file\n196|    /// must fail verification explicitly instead of crashing the wizard.\n197|    public struct LocalRegistration: Sendable, Equatable {\n198|        public let agentID: Int64?\n199|        public let agentName: String?\n200|        public let gitHubURL: String?\n201|        public let workFolder: String?\n202|        public init(agentID: Int64?, agentName: String?, gitHubURL: String?, workFolder: String?) {\n203|            self.agentID = agentID; self.agentName = agentName\n204|            self.gitHubURL = gitHubURL; self.workFolder = workFolder\n205|        }\n206|    }\n207|}\n208|\n209|extension RunnerRegistration {\n210|    public enum RegistrationError: LocalizedError, Sendable, Equatable {\n211|        case notAuthenticated\n212|        case missingPermission(String)\n213|        case invalidDraft(String)\n214|        case noSpacePath(String)\n215|        case downloadMismatch(osName: String, arch: String)\n216|        case integrityMismatch\n217|        case groupScopeNotConfirmed\n218|        case refusesSharedGroup(groupID: Int64)\n219|        case groupNameTaken(name: String, groupID: Int64)\n220|        case groupNotApplicable\n221|        case alreadyInstalled(path: String)\n222|        case alreadyRegistered(name: String)\n223|        case remoteNameTaken(name: String)\n224|        case unverifiedRegistration(String)\n225|        case remoteIdentityMismatch(String)\n226|        case remoteRunnerNotFound(String)\n227|        case confirmationMismatch(String)\n228|        case network(String)\n229|        case unauthorized\n230|        case forbidden(String)\n231|        case rateLimited\n232|        case configFailed(String)\n233|        case cancelled\n234|\n235|        public var errorDescription: String? {\n236|            switch self {\n237|            case .notAuthenticated:\n238|                \"Sign in with GitHub first. Registration needs an authenticated session.\"\n239|            case .missingPermission(let text):\n240|                text.isEmpty ? \"Missing GitHub permission for this step.\" : text\n241|            case .invalidDraft(let text):\n242|                text\n243|            case .noSpacePath(let text):\n244|                text\n245|            case .downloadMismatch(let osName, let arch):\n246|                \"No official runner package for os=\\(osName) arch=\\(arch). Refusing substitute builds.\"\n247|            case .integrityMismatch:\n248|                \"Download integrity check failed (SHA-256 mismatch). Refusing to install.\"\n249|            case .groupScopeNotConfirmed:\n250|                \"Repository access changes need explicit confirmation for the dedicated group.\"\n251|            case .refusesSharedGroup(let groupID):\n252|                \"Refusing to change group \\(groupID): it is not this Mac's dedicated group.\"\n253|            case .groupNameTaken(let name, let groupID):\n254|                \"Group '\\(name)' already exists (id \\(groupID)) and is not this Mac's dedicated group. Choose a different name or explicitly confirm takeover.\"\n255|            case .groupNotApplicable:\n256|                \"Runner groups apply to organization runners only. Repository runners use separate installations.\"\n257|            case .alreadyInstalled(let path):\n258|                \"Installation already exists at \\(path). Resume or remove it before retrying.\"\n259|            case .alreadyRegistered(let name):\n260|                \"Runner '\\(name)' is already registered here. Reuse it instead of creating a duplicate.\"\n261|            case .remoteNameTaken(let name):\n262|                \"Runner '\\(name)' already exists in GitHub. Choose a different name or explicitly allow replace; refusing to silently replace another registration.\"\n263|            case .unverifiedRegistration(let text):\n264|                text.isEmpty ? \"No verified local registration for this installation. Refusing to touch a runner that is not this Mac's installation.\" : text\n265|            case .remoteIdentityMismatch(let text):\n266|                text.isEmpty ? \"GitHub's runner list contradicts this installation's identity. Refusing to adopt another runner.\" : text\n267|            case .remoteRunnerNotFound(let text):\n268|                text.isEmpty ? \"GitHub does not list this installation yet. Refusing to guess by name.\" : text\n269|            case .confirmationMismatch(let text):\n270|                text.isEmpty ? \"GitHub confirmed different repositories than requested. Refusing to report partial access as complete.\" : text\n271|            case .network(let text):\n272|                text\n273|            case .unauthorized:\n274|                \"Session expired or revoked (401). Sign in again.\"\n275|            case .forbidden(let text):\n276|                text.isEmpty ? \"Access forbidden (403).\" : text\n277|            case .rateLimited:\n278|                \"GitHub rate limit reached. Retry later; local runners keep working.\"\n279|            case .configFailed(let text):\n280|                text.isEmpty ? \"Runner configuration failed.\" : text\n281|            case .cancelled:\n282|                \"Registration cancelled.\"\n283|            }\n284|        }\n285|    }\n286|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
