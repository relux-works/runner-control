{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c655","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":389,"recorded_at":1780531400000773,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"task_stream":{"kind":"task","id":"01a0a8df-c4a7-7870-8928-b38f1f770792"},"task_id":"01a0a8df-c4a7-7870-8928-b38f1f770792","event":{"kind":"output","task_id":"01a0a8df-c4a7-7870-8928-b38f1f770792","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Models.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Registration scope. One wizard run registers exactly one scope:\n5|    /// an organization (shared, via a dedicated per-Mac group) or a single\n6|    /// personal repository (separate installation, no group).\n7|    public enum Scope: Sendable, Equatable, Hashable {\n8|        case organization(org: String)\n9|        case repository(owner: String, name: String)\n10|\n11|        /// REST path prefix below the API base URL, e.g. `orgs/acme` or `repos/acme/app`.\n12|        public var apiPrefix: String {\n13|            switch self {\n14|            case .organization(let org): \"orgs/\\(org)\"\n15|            case .repository(let owner, let name): \"repos/\\(owner)/\\(name)\"\n16|            }\n17|        }\n18|\n19|        /// Short key for token-store accounts and markers. Never contains secrets.\n20|        public var scopeKey: String {\n21|            switch self {\n22|            case .organization(let org): \"org:\\(org)\"\n23|            case .repository(let owner, let name): \"repo:\\(owner)/\\(name)\"\n24|            }\n25|        }\n26|\n27|        /// URL passed to `config.sh --url`. Enterprise hosts keep their own server.\n28|        public func configURL(serverHost: String) -> String {\n29|            let host = serverHost == \"github.com\" || serverHost == \"www.github.com\"\n30|                ? \"https://github.com\"\n31|                : \"https://\\(serverHost)\"\n32|            switch self {\n33|            case .organization(let org): return \"\\(host)/\\(org)\"\n34|            case .repository(let owner, let name): return \"\\(host)/\\(owner)/\\(name)\"\n35|            }\n36|        }\n37|\n38|        /// Detail line shown in UI, e.g. `acme` or `acme/app`.\n39|        public var detail: String {\n40|            switch self {\n41|            case .organization(let org): org\n42|            case .repository(let owner, let name): \"\\(owner)/\\(name)\"\n43|            }\n44|        }\n45|    }\n46|\n47|    /// User-editable wizard input. Holds no tokens.\n48|    public struct Draft: Sendable, Equatable {\n49|        public var scope: Scope\n50|        public var runnerName: String\n51|        public var labels: [String]\n52|        public var installDirName: String\n53|        public var workFolder: String\n54|        /// Dedicated per-Mac group name for org scope. Ignored for repo scope.\n55|        public var groupName: String\n56|        public var selectedRepositoryIDs: Set<Int64>\n57|        /// Explicit UI scope: user confirmed that group mutations apply only\n58|        /// to the resolved dedicated group. Never implied.\n59|        public var allowGroupMutation: Bool\n60|        /// Explicit takeover: user confirmed that a pre-existing group with\n61|        /// the same name is this Mac's dedicated group. Name alone never\n62|        /// authorizes adopting or editing a shared group.\n63|        public var allowGroupTakeover: Bool\n64|        /// Explicit replace: user confirmed that config may replace an\n65|        /// existing GitHub registration with the same runner name. Without\n66|        /// it the wizard refuses remote duplicates instead of silently\n67|        /// stealing another machine's registration via `--replace`.\n68|        public var allowReplace: Bool\n69|\n70|        public init(\n71|            scope: Scope,\n72|            runnerName: String,\n73|            labels: [String] = [\"self-hosted\", \"macOS\"],\n74|            installDirName: String,\n75|            workFolder: String = \"_work\",\n76|            groupName: String = \"\",\n77|            selectedRepositoryIDs: Set<Int64> = [],\n78|            allowGroupMutation: Bool = false,\n79|            allowGroupTakeover: Bool = false,\n80|            allowReplace: Bool = false\n81|        ) {\n82|            self.scope = scope\n83|            self.runnerName = runnerName\n84|            self.labels = labels\n85|            self.installDirName = installDirName\n86|            self.workFolder = workFolder\n87|            self.groupName = groupName\n88|            self.selectedRepositoryIDs = selectedRepositoryIDs\n89|            self.allowGroupMutation = allowGroupMutation\n90|            self.allowGroupTakeover = allowGroupTakeover\n91|            self.allowReplace = allowReplace\n92|        }\n93|\n94|        /// Default per-Mac group name derived from the Mac name.\n95|        public static func defaultGroupName(hostName: String) -> String {\n96|            let trimmed = hostName.trimmingCharacters(in: .whitespacesAndNewlines)\n97|            let base = trimmed.isEmpty ? \"Mac\" : trimmed\n98|            return \"RunnerControl-\\(base)\"\n99|        }\n100|    }\n101|\n102|    /// Immutable operation identity. Every async step captures it at start\n103|    /// and binds its completion to it: a draft edit that changes any field,\n104|    /// or an authenticated-server change, abandons the in-flight completion\n105|    /// instead of attributing stale success to the new identity. Labels,\n106|    /// selected repositories, and consent flags are editable selections, not\n107|    /// identity: they re-target pending retries to the visible values.\n108|    public struct OperationIdentity: Sendable, Equatable {\n109|        public let serverHost: String\n110|        public let scope: Scope\n111|        public let installDirName: String\n112|        public let runnerName: String\n113|        public let workFolder: String\n114|        public let groupName: String\n115|\n116|        public init(\n117|            serverHost: String, scope: Scope, installDirName: String,\n118|            runnerName: String, workFolder: String, groupName: String\n119|        ) {\n120|            self.serverHost = Self.normalizeServerHost(serverHost)\n121|            self.scope = scope\n122|            self.installDirName = installDirName\n123|            self.runnerName = runnerName\n124|            self.workFolder = workFolder\n125|            self.groupName = groupName\n126|        }\n127|\n128|        /// Canonical server comparison. `www.github.com` is the same\n129|        /// deployment as `github.com`; every other host compares lowercased.\n130|        public static func normalizeServerHost(_ host: String) -> String {\n131|            let lowered = host.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()\n132|            if lowered == \"www.github.com\" { return \"github.com\" }\n133|            return lowered\n134|        }\n135|\n136|        public static func make(draft: Draft, serverHost: String) -> Self {\n137|            let group: String\n138|            switch draft.scope {\n139|            case .organization:\n140|                group = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n141|            case .repository:\n142|                group = \"\"\n143|            }\n144|            return Self(\n145|                serverHost: serverHost,\n146|                scope: draft.scope,\n147|                installDirName: draft.installDirName,\n148|                runnerName: draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines),\n149|                workFolder: draft.workFolder,\n150|                groupName: group\n151|            )\n152|        }\n153|    }\n154|\n155|    /// Official runner download asset as returned by the downloads endpoint.\n156|    public struct DownloadAsset: Sendable, Equatable {\n157|        public let osName: String\n158|        public let architecture: String\n159|        public let downloadURL: URL\n160|        public let filename: String\n161|        public let sha256Checksum: String?\n162|        public init(osName: String, architecture: String, downloadURL: URL, filename: String, sha256Checksum: String?) {\n163|            self.osName = osName; self.architecture = architecture\n164|            self.downloadURL = downloadURL; self.filename = filename\n165|            self.sha256Checksum = sha256Checksum\n166|        }\n167|    }\n168|\n169|    /// Runner group summary. Repository access is fetched separately.\n170|    /// `allowsPublicRepositories` mirrors GitHub's `allows_public_repositories`\n171|    /// flag: without it a `selected`-visibility group silently denies every\n172|    /// selected public repository.\n173|    public struct RunnerGroup: Sendable, Equatable {\n174|        public let id: Int64\n175|        public let name: String\n176|        public let visibility: String\n177|        public let allowsPublicRepositories: Bool\n178|        public init(id: Int64, name: String, visibility: String, allowsPublicRepositories: Bool = false) {\n179|            self.id = id; self.name = name; self.visibility = visibility\n180|            self.allowsPublicRepositories = allowsPublicRepositories\n181|        }\n182|    }\n183|\n184|    /// Registered runner identity fetched from GitHub after config.\n185|    public struct RegisteredRunner: Sendable, Equatable {\n186|        public let id: Int64\n187|        public let name: String\n188|        public let labels: [String]\n189|        public init(id: Int64, name: String, labels: [String]) {\n190|            self.id = id; self.name = name; self.labels = labels\n191|        }\n192|    }\n193|\n194|    /// Local `.runner` identity, read without touching credentials.\n195|    /// Every field is optional because a missing, corrupt, or foreign file\n196|    /// must fail verification explicitly instead of crashing the wizard.\n197|    public struct LocalRegistration: Sendable, Equatable {\n198|        public let agentID: Int64?\n199|        public let agentName: String?\n200|        public let gitHubURL: String?\n201|        public let workFolder: String?\n202|        public init(agentID: Int64?, agentName: String?, gitHubURL: String?, workFolder: String?) {\n203|            self.agentID = agentID; self.agentName = agentName\n204|            self.gitHubURL = gitHubURL; self.workFolder = workFolder\n205|        }\n206|    }\n207|}\n208|\n209|extension RunnerRegistration {\n210|    public enum RegistrationError: LocalizedError, Sendable, Equatable {\n211|        case notAuthenticated\n212|        case missingPermission(String)\n213|        case invalidDraft(String)\n214|        case noSpacePath(String)\n215|        case downloadMismatch(osName: String, arch: String)\n216|        case integrityMismatch\n217|        case groupScopeNotConfirmed\n218|        case refusesSharedGroup(groupID: Int64)\n219|        case groupNameTaken(name: String, groupID: Int64)\n220|        case groupNotApplicable\n221|        case alreadyInstalled(path: String)\n222|        case alreadyRegistered(name: String)\n223|        case remoteNameTaken(name: String)\n224|        case unverifiedRegistration(String)\n225|        case remoteIdentityMismatch(String)\n226|        case remoteRunnerNotFound(String)\n227|        case confirmationMismatch(String)\n228|        case network(String)\n229|        case unauthorized\n230|        case forbidden(String)\n231|        case rateLimited\n232|        case configFailed(String)\n233|        case cancelled\n234|\n235|        public var errorDescription: String? {\n236|            switch self {\n237|            case .notAuthenticated:\n238|                \"Sign in with GitHub first. Registration needs an authenticated session.\"\n239|            case .missingPermission(let text):\n240|                text.isEmpty ? \"Missing GitHub permission for this step.\" : text\n241|            case .invalidDraft(let text):\n242|                text\n243|            case .noSpacePath(let text):\n244|                text\n245|            case .downloadMismatch(let osName, let arch):\n246|                \"No official runner package for os=\\(osName) arch=\\(arch). Refusing substitute builds.\"\n247|            case .integrityMismatch:\n248|                \"Download integrity check failed (SHA-256 mismatch). Refusing to install.\"\n249|            case .groupScopeNotConfirmed:\n250|                \"Repository access changes need explicit confirmation for the dedicated group.\"\n251|            case .refusesSharedGroup(let groupID):\n252|                \"Refusing to change group \\(groupID): it is not this Mac's dedicated group.\"\n253|            case .groupNameTaken(let name, let groupID):\n254|                \"Group '\\(name)' already exists (id \\(groupID)) and is not this Mac's dedicated group. Choose a different name or explicitly confirm takeover.\"\n255|            case .groupNotApplicable:\n256|                \"Runner groups apply to organization runners only. Repository runners use separate installations.\"\n257|            case .alreadyInstalled(let path):\n258|                \"Installation already exists at \\(path). Resume or remove it before retrying.\"\n259|            case .alreadyRegistered(let name):\n260|                \"Runner '\\(name)' is already registered here. Reuse it instead of creating a duplicate.\"\n261|            case .remoteNameTaken(let name):\n262|                \"Runner '\\(name)' already exists in GitHub. Choose a different name or explicitly allow replace; refusing to silently replace another registration.\"\n263|            case .unverifiedRegistration(let text):\n264|                text.isEmpty ? \"No verified local registration for this installation. Refusing to touch a runner that is not this Mac's installation.\" : text\n265|            case .remoteIdentityMismatch(let text):\n266|                text.isEmpty ? \"GitHub's runner list contradicts this installation's identity. Refusing to adopt another runner.\" : text\n267|            case .remoteRunnerNotFound(let text):\n268|                text.isEmpty ? \"GitHub does not list this installation yet. Refusing to guess by name.\" : text\n269|            case .confirmationMismatch(let text):\n270|                text.isEmpty ? \"GitHub confirmed different repositories than requested. Refusing to report partial access as complete.\" : text\n271|            case .network(let text):\n272|                text\n273|            case .unauthorized:\n274|                \"Session expired or revoked (401). Sign in again.\"\n275|            case .forbidden(let text):\n276|                text.isEmpty ? \"Access forbidden (403).\" : text\n277|            case .rateLimited:\n278|                \"GitHub rate limit reached. Retry later; local runners keep working.\"\n279|            case .configFailed(let text):\n280|                text.isEmpty ? \"Runner configuration failed.\" : text\n281|            case .cancelled:\n282|                \"Registration cancelled.\"\n283|            }\n284|        }\n285|    }\n286|}","final_result":true}}}
