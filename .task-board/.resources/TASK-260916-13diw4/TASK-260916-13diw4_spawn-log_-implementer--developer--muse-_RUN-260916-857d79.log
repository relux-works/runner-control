{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c803","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":604,"recorded_at":1780531400001203,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"call_id":"call_01a0a8e2cb9b736f80e5b1b538656363","text":"Read text file `Targets/RunnerControl/Sources/RunnerRegistrationContainer.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|/// Wizard composition root. Edits local draft fields, dispatches production\n5|/// `RunnerRegistration.Effect`s, and never holds tokens.\n6|struct RunnerRegistrationContainer: View {\n7|    @ObservedObject var registration: RunnerRegistration.State\n8|    @ObservedObject var github: GitHubAuth.State\n9|    let close: () -> Void\n10|\n11|    @State private var scopeKind: RunnerRegistrationPage.ScopeKind = .organization\n12|    @State private var org = \"\"\n13|    @State private var repoOwner = \"\"\n14|    @State private var repoName = \"\"\n15|    @State private var runnerName = Host.current().localizedName ?? \"\"\n16|    @State private var labelsText = \"self-hosted, macOS\"\n17|    @State private var installDirName = \"\"\n18|    @State private var workFolder = \"_work\"\n19|    @State private var groupName = RunnerRegistration.Draft.defaultGroupName(\n20|        hostName: Host.current().localizedName ?? \"\"\n21|    )\n22|    @State private var allowGroupMutation = false\n23|    @State private var allowGroupTakeover = false\n24|    @State private var allowReplace = false\n25|    @State private var selectedRepositoryIDs: Set<Int64> = []\n26|    @State private var seeded = false\n27|\n28|    private static func parseLabels(_ text: String) -> [String] {\n29|        text.split(separator: \",\").map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }\n30|    }\n31|\n32|    private var currentDraft: RunnerRegistration.Draft {\n33|        let scope: RunnerRegistration.Scope\n34|        switch scopeKind {\n35|        case .organization:\n36|            scope = .organization(org: org.trimmingCharacters(in: .whitespacesAndNewlines))\n37|        case .repository:\n38|            scope = .repository(\n39|                owner: repoOwner.trimmingCharacters(in: .whitespacesAndNewlines),\n40|                name: repoName.trimmingCharacters(in: .whitespacesAndNewlines)\n41|            )\n42|        }\n43|        return RunnerRegistration.Draft(\n44|            scope: scope,\n45|            runnerName: runnerName.trimmingCharacters(in: .whitespacesAndNewlines),\n46|            labels: Self.parseLabels(labelsText),\n47|            installDirName: installDirName.trimmingCharacters(in: .whitespacesAndNewlines),\n48|            workFolder: workFolder.trimmingCharacters(in: .whitespacesAndNewlines),\n49|            groupName: groupName.trimmingCharacters(in: .whitespacesAndNewlines),\n50|            selectedRepositoryIDs: selectedRepositoryIDs,\n51|            allowGroupMutation: allowGroupMutation,\n52|            allowGroupTakeover: allowGroupTakeover,\n53|            allowReplace: allowReplace\n54|        )\n55|    }\n56|\n57|    var body: some View {\n58|        RunnerRegistrationPage(\n59|            props: .init(\n60|                phase: registration.phase,\n61|                working: registration.working,\n62|                scopeKind: scopeKind,\n63|                org: org,\n64|                repoOwner: repoOwner,\n65|                repoName: repoName,\n66|                runnerName: runnerName,\n67|                labelsText: labelsText,\n68|                installDirName: installDirName,\n69|                workFolder: workFolder,\n70|                groupName: groupName,\n71|                allowGroupMutation: allowGroupMutation,\n72|                allowGroupTakeover: allowGroupTakeover,\n73|                allowReplace: allowReplace,\n74|                selectedRepositoryIDs: selectedRepositoryIDs,\n75|                repositories: github.repositories,\n76|                installations: github.installations,\n77|                githubConnected: isConnected,\n78|                githubUsername: github.username,\n79|                group: registration.group,\n80|                groupRepositoryIDs: registration.groupRepositoryIDs,\n81|                assetFilename: registration.asset?.filename,\n82|                installPath: registration.installPath,\n83|                runnerID: registration.runnerID,\n84|                localAgentID: registration.localAgentID,\n85|                completedSteps: registration.completedSteps,\n86|                error: registration.error,\n87|                failedStep: registration.failedStep,\n88|                permissionError: registration.permissionError\n89|            ),\n90|            reactions: .init(\n91|                scopeKindChanged: { scopeKind = $0; pushDraft() },\n92|                orgChanged: { org = $0; pushDraft() },\n93|                repoOwnerChanged: { repoOwner = $0; pushDraft() },\n94|                repoNameChanged: { repoName = $0; pushDraft() },\n95|                runnerNameChanged: { runnerName = $0; pushDraft() },\n96|                labelsChanged: { labelsText = $0; pushDraft() },\n97|                installDirChanged: { installDirName = $0; pushDraft() },\n98|                workFolderChanged: { workFolder = $0; pushDraft() },\n99|                groupNameChanged: { groupName = $0; pushDraft() },\n100|                allowGroupMutationChanged: { allowGroupMutation = $0; pushDraft() },\n101|                allowGroupTakeoverChanged: { allowGroupTakeover = $0; pushDraft() },\n102|                allowReplaceChanged: { allowReplace = $0; pushDraft() },\n103|                repositoriesChanged: { ids in\n104|                    selectedRepositoryIDs = ids\n105|                    Task { await action { GitHubAuth.Effect.selectRepositories(ids) } }\n106|                    pushDraft()\n107|                },\n108|                beginDraft: { Task { await action { RunnerRegistration.Effect.beginDraft(currentDraft) } } },\n109|                resolveGroup: { Task { await action { RunnerRegistration.Effect.resolveGroup } } },\n110|                downloadAndInstall: { Task { await action { RunnerRegistration.Effect.downloadAndInstall } } },\n111|                registerRunner: { Task { await action { RunnerRegistration.Effect.registerRunner } } },\n112|                setupService: { Task { await action { RunnerRegistration.Effect.setupService } } },\n113|                applyRepositoryAccess: {\n114|                    let target = registration.group?.id ?? -1\n115|                    let effect = RunnerRegistration.Effect.applyRepositoryAccess(\n116|                        groupID: target, repositories: selectedRepositoryIDs\n117|                    )\n118|                    Task { await action { effect } }\n119|                },\n120|                applyLabels: {\n121|                    let labels = Self.parseLabels(labelsText)\n122|                    Task { await action { RunnerRegistration.Effect.applyLabels(labels) } }\n123|                },\n124|                retry: { Task { await action { RunnerRegistration.Effect.retry } } },\n125|                cancel: { Task { await action { RunnerRegistration.Effect.cancel } } },\n126|                reset: { Task { await action { RunnerRegistration.Effect.reset } } },\n127|                dismissPermission: { Task { await action { RunnerRegistration.Effect.dismissPermission } } },\n128|                close: close\n129|            )\n130|        )\n131|        .onAppear(perform: seedFromGitHub)\n132|    }\n133|\n134|    private var isConnected: Bool {\n135|        if case .connected = github.connection { return true }\n136|        return false\n137|    }\n138|\n139|    /// Pushes field edits into the draft once the wizard has begun, so step\n140|    /// buttons always run the visible values. Before the first begin the\n141|    /// draft does not exist yet and edits stay local.\n142|    private func pushDraft() {\n143|        guard registration.phase != .idle else { return }\n144|        let draft = currentDraft\n145|        Task { await action { RunnerRegistration.Effect.updateDraft(draft) } }\n146|    }\n147|\n148|    /// Seeds org/owner from the selected GitHub installation once.\n149|    private func seedFromGitHub() {\n150|        guard !seeded else { return }\n151|        seeded = true\n152|        if installDirName.isEmpty {\n153|            installDirName = (Host.current().localizedName ?? \"runner\")\n154|                .lowercased()\n155|                .replacingOccurrences(of: \" \", with: \"-\")\n156|        }\n157|        guard let id = github.selectedInstallationID,\n158|              let installation = github.installations.first(where: { $0.id == id }) else { return }\n159|        if org.isEmpty, installation.accountType == \"Organization\" {\n160|            org = installation.account\n161|            scopeKind = .organization\n162|        } else if repoOwner.isEmpty {\n163|            repoOwner = installation.account\n164|            scopeKind = .repository\n165|        }\n166|        if selectedRepositoryIDs.isEmpty {\n167|            selectedRepositoryIDs = github.selectedRepositoryIDs\n168|        }\n169|    }\n170|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c805","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":605,"recorded_at":1780531400001205,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"call_id":"call_01a0a8e2cd24742fafa679ee3450ae89","text":"Read text file `Targets/RunnerControl/Sources/RunnerRegistrationPage.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|/// New-runner wizard. Pure view: all state arrives via props, all actions\n5|/// leave via reactions that dispatch production `RunnerRegistration.Effect`s.\n6|struct RunnerRegistrationPage: View {\n7|    struct Props {\n8|        let phase: RunnerRegistration.Phase\n9|        let working: Bool\n10|        let scopeKind: ScopeKind\n11|        let org: String\n12|        let repoOwner: String\n13|        let repoName: String\n14|        let runnerName: String\n15|        let labelsText: String\n16|        let installDirName: String\n17|        let workFolder: String\n18|        let groupName: String\n19|        let allowGroupMutation: Bool\n20|        let allowGroupTakeover: Bool\n21|        let allowReplace: Bool\n22|        let selectedRepositoryIDs: Set<Int64>\n23|        let repositories: [GitHubAuth.Repository]\n24|        let installations: [GitHubAuth.Installation]\n25|        let githubConnected: Bool\n26|        let githubUsername: String?\n27|        let group: RunnerRegistration.RunnerGroup?\n28|        let groupRepositoryIDs: [Int64]\n29|        let assetFilename: String?\n30|        let installPath: String?\n31|        let runnerID: Int64?\n32|        let localAgentID: Int64?\n33|        let completedSteps: Set<String>\n34|        let error: String?\n35|        let failedStep: String?\n36|        let permissionError: String?\n37|    }\n38|\n39|    enum ScopeKind: Hashable {\n40|        case organization\n41|        case repository\n42|    }\n43|\n44|    struct Reactions {\n45|        let scopeKindChanged: (ScopeKind) -> Void\n46|        let orgChanged: (String) -> Void\n47|        let repoOwnerChanged: (String) -> Void\n48|        let repoNameChanged: (String) -> Void\n49|        let runnerNameChanged: (String) -> Void\n50|        let labelsChanged: (String) -> Void\n51|        let installDirChanged: (String) -> Void\n52|        let workFolderChanged: (String) -> Void\n53|        let groupNameChanged: (String) -> Void\n54|        let allowGroupMutationChanged: (Bool) -> Void\n55|        let allowGroupTakeoverChanged: (Bool) -> Void\n56|        let allowReplaceChanged: (Bool) -> Void\n57|        let repositoriesChanged: (Set<Int64>) -> Void\n58|        let beginDraft: () -> Void\n59|        let resolveGroup: () -> Void\n60|        let downloadAndInstall: () -> Void\n61|        let registerRunner: () -> Void\n62|        let setupService: () -> Void\n63|        let applyRepositoryAccess: () -> Void\n64|        let applyLabels: () -> Void\n65|        let retry: () -> Void\n66|        let cancel: () -> Void\n67|        let reset: () -> Void\n68|        let dismissPermission: () -> Void\n69|        let close: () -> Void\n70|    }\n71|\n72|    let props: Props\n73|    let reactions: Reactions\n74|\n75|    var body: some View {\n76|        ScrollView {\n77|            VStack(alignment: .leading, spacing: 16) {\n78|                header\n79|                if !props.githubConnected {\n80|                    githubRequired\n81|                }\n82|                WizardForm(props: props, reactions: reactions)\n83|                WizardSteps(props: props, reactions: reactions)\n84|                WizardStatus(props: props, reactions: reactions)\n85|                footer\n86|            }\n87|            .padding(20)\n88|            .frame(maxWidth: .infinity, alignment: .leading)\n89|        }\n90|        .frame(width: 640, height: 560)\n91|    }\n92|\n93|    private var header: some View {\n94|        VStack(alignment: .leading, spacing: 3) {\n95|            Text(\"Новый раннер на этом Mac\").font(.system(size: 15, weight: .semibold))\n96|            Text(\"Официальная сборка GitHub под вашу архитектуру, регистрация без терминала.\")\n97|                .font(.callout).foregroundStyle(.secondary)\n98|        }\n99|    }\n100|\n101|    private var githubRequired: some View {\n102|        HStack(alignment: .top, spacing: 8) {\n103|            Image(systemName: \"person.crop.circle.badge.exclamationmark\").foregroundStyle(.orange)\n104|            VStack(alignment: .leading, spacing: 2) {\n105|                Text(\"Войдите через GitHub во вкладке «GitHub», затем вернитесь сюда.\")\n106|                Text(\"Регистрация требует подтверждённой сессии.\")\n107|            }\n108|            .font(.callout)\n109|        }\n110|        .padding(10)\n111|        .background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n112|    }\n113|\n114|    private var footer: some View {\n115|        HStack(spacing: 8) {\n116|            if props.working {\n117|                Button(\"Отмена\", action: reactions.cancel)\n118|                    .buttonStyle(.bordered)\n119|                    .accessibilityIdentifier(\"Registration cancel button\")\n120|            } else if props.phase != .idle {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c807","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":606,"recorded_at":1780531400001207,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"call_id":"call_01a0a8e2cf3f74f095e6a3f9597c4e5e","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistrationTokenStore.swift`.\n1|import Foundation\n2|\n3|extension RunnerRegistration {\n4|    /// Short-lived registration token. Lives in Keychain + Flow actor\n5|    /// privates only; never enters Relux state, logs, or diagnostics.\n6|    public struct ScopedToken: Sendable, Equatable, Codable {\n7|        public let token: String\n8|        public let expiresAt: Date?\n9|        public let obtainedAt: Date\n10|        public init(token: String, expiresAt: Date?, obtainedAt: Date = Date()) {\n11|            self.token = token; self.expiresAt = expiresAt; self.obtainedAt = obtainedAt\n12|        }\n13|        public var isExpired: Bool {\n14|            guard let expiresAt else { return false }\n15|            return expiresAt <= Date()\n16|        }\n17|    }\n18|}\n19|\n20|/// Keychain boundary for scoped short-lived registration tokens.\n21|public protocol RunnerRegistrationTokenStoring: Sendable {\n22|    func save(_ token: RunnerRegistration.ScopedToken, scopeKey: String) async throws\n23|    func load(scopeKey: String) async -> RunnerRegistration.ScopedToken?\n24|    func delete(scopeKey: String) async\n25|}\n26|\n27|public actor RunnerRegistrationTokenStore: RunnerRegistrationTokenStoring {\n28|    private let backend: any KeychainBackend\n29|    private let service: String\n30|\n31|    public init(\n32|        service: String = \"works.relux.runnercontrol.runner-registration-token\",\n33|        backend: (any KeychainBackend)? = nil\n34|    ) {\n35|        self.service = service\n36|        self.backend = backend ?? SecurityKeychainBackend()\n37|    }\n38|\n39|    public func save(_ token: RunnerRegistration.ScopedToken, scopeKey: String) async throws {\n40|        let data = try JSONEncoder().encode(token)\n41|        try backend.save(data, service: service, account: scopeKey)\n42|    }\n43|\n44|    public func load(scopeKey: String) async -> RunnerRegistration.ScopedToken? {\n45|        guard let data = backend.load(service: service, account: scopeKey) else { return nil }\n46|        guard let decoded = try? JSONDecoder().decode(RunnerRegistration.ScopedToken.self, from: data) else {\n47|            return nil\n48|        }\n49|        if decoded.isExpired {\n50|            backend.delete(service: service, account: scopeKey)\n51|            return nil\n52|        }\n53|        return decoded\n54|    }\n55|\n56|    public func delete(scopeKey: String) async {\n57|        backend.delete(service: service, account: scopeKey)\n58|    }\n59|}\n60|\n61|/// In-memory registration-token backend for unit tests. Never used in production.\n62|public final class InMemoryRegistrationTokenBackend: KeychainBackend, @unchecked Sendable {\n63|    private let lock = NSLock()\n64|    private var storage: [String: Data] = [:]\n65|    public init() {}\n66|    private func key(service: String, account: String) -> String { \"\\(service)\\u{0}\\(account)\" }\n67|    public func save(_ data: Data, service: String, account: String) throws {\n68|        lock.withLock { storage[key(service: service, account: account)] = data }\n69|    }\n70|    public func load(service: String, account: String) -> Data? {\n71|        lock.withLock { storage[key(service: service, account: account)] }\n72|    }\n73|    public func delete(service: String, account: String) {\n74|        lock.withLock { _ = storage.removeValue(forKey: key(service: service, account: account)) }\n75|    }\n76|    public func deleteMatching(service: String, accountPrefix: String, accountSuffix: String) {\n77|        lock.withLock {\n78|            let prefix = \"\\(service)\\u{0}\\(accountPrefix)\"\n79|            let doomed = storage.keys.filter { $0.hasPrefix(prefix) && $0.hasSuffix(accountSuffix) }\n80|            for key in doomed {\n81|                storage.removeValue(forKey: key)\n82|            }\n83|        }\n84|    }\n85|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
