{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c603","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":348,"recorded_at":1780531400000691,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"task_stream":{"kind":"task","id":"01a0a8df-b956-71e2-8a4e-69d76b576113"},"task_id":"01a0a8df-b956-71e2-8a4e-69d76b576113","event":{"kind":"output","task_id":"01a0a8df-b956-71e2-8a4e-69d76b576113","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n(499 line(s) above)\n500|            installPath = directory.path\n501|            await action { RunnerRegistration.Action.installed(path: directory.path) }\n502|            await finishStep(\"downloadAndInstall\", generation: gen)\n503|        } catch {\n504|            working = false\n505|            await fail(error, step: \"downloadAndInstall\", generation: gen)\n506|        }\n507|    }\n508|\n509|    // MARK: - Register\n510|\n511|    private func registerRunner() async {\n512|        let gen = generation\n513|        guard !working else { return }\n514|        guard let draft else {\n515|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"registerRunner\") }\n516|            return\n517|        }\n518|        guard let installPath else {\n519|            failedStep = \"registerRunner\"\n520|            await action {\n521|                RunnerRegistration.Action.failed(message: \"Install the runner package first.\", step: \"registerRunner\")\n522|            }\n523|            return\n524|        }\n525|        working = true\n526|        workingStep = \"registerRunner\"\n527|        await action { RunnerRegistration.Action.stepStarted(\"registerRunner\") }\n528|        let directory = URL(fileURLWithPath: installPath)\n529|        let scopeKey = Self.tokenScopeKey(draft: draft)\n530|        do {\n531|            // The whole step — including idempotent resume — is bound to one\n532|            // authenticated server. Resume verifies the full local identity\n533|            // (server/scope/agent/name/work-folder/group) before any success:\n534|            // a drifted or re-targeted draft never adopts the old marker.\n535|            let auth = try await currentUserToken(generation: gen)\n536|            guard !isStale(gen) else { return }\n537|            _ = syncServerBinding(auth.identity.serverHost)\n538|            guard !isStale(gen) else { return }\n539|            let serverHost = auth.identity.serverHost\n540|            if await installer.hasCompleted(RunnerInstallerService.stepConfigured, directory: directory) {\n541|                let local = await installer.readLocalRegistration(directory: directory)\n542|                let localID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n543|                    local: local, configured: true, draft: draft, serverHost: serverHost\n544|                )\n545|                let marker = await installer.loadMarker(directory: directory)\n546|                let groupName: String?\n547|                switch draft.scope {\n548|                case .organization:\n549|                    groupName = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n550|                case .repository:\n551|                    groupName = nil\n552|                }\n553|                try RunnerInstallerService.verifyConfiguredGroup(\n554|                    marker: marker, runnerGroup: groupName, draft: draft\n555|                )\n556|                let remoteID = try await resolveBoundRemoteRunnerID(\n557|                    draft: draft, localAgentID: localID, auth: auth, generation: gen\n558|                )\n559|                guard !isStale(gen) else { return }\n560|                runnerID = remoteID\n561|                await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: localID) }\n562|                await finishStep(\"registerRunner\", generation: gen)\n563|                return\n564|            }\n565|            guard !isStale(gen) else { return }\n566|            // Duplicate guard before any token is minted: without explicit\n567|            // replace consent a remote name match refuses the run so config\n568|            // can never silently replace another machine's registration.\n569|            // The list is complete (every page followed); a duplicate that\n570|            // appears after this check still fails at config.sh, which omits\n571|            // `--replace` unless the user explicitly allowed it.\n572|            let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n573|            let existing = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n574|            guard !isStale(gen) else { return }\n575|            try RunnerRegistration.Gates.rejectRemoteDuplicate(\n576|                name: wanted, isTaken: existing.contains(where: { $0.name == wanted }),\n577|                allowReplace: draft.allowReplace\n578|            )\n579|            guard !isStale(gen) else { return }\n580|            let created = try await api.createRegistrationToken(\n581|                config: auth.config, token: auth.token, scope: draft.scope\n582|            )\n583|            guard !isStale(gen) else { return }\n584|            let scoped = RunnerRegistration.ScopedToken(\n585|                token: created.token, expiresAt: created.expiresAt, obtainedAt: now()\n586|            )\n587|            try await registrationTokens.save(scoped, scopeKey: scopeKey)\n588|            guard !isStale(gen) else { return }\n589|            let groupName: String?\n590|            switch draft.scope {\n591|            case .organization: groupName = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n592|            case .repository: groupName = nil\n593|            }\n594|            let localID: Int64?\n595|            do {\n596|                localID = try await installer.runConfig(\n597|                    directory: directory,\n598|                    scopeURL: draft.scope.configURL(serverHost: auth.identity.serverHost),\n599|                    token: created.token,\n600|                    draft: draft,\n601|                    runnerGroup: groupName\n602|                )\n603|            } catch {\n604|                await registrationTokens.delete(scopeKey: scopeKey)\n605|                throw error\n606|            }\n607|            // The single-use token is consumed by config.sh: delete it before\n608|            // any follow-up API call so a post-config failure (review F6)\n609|            // reports the error without retaining the token.\n610|            await registrationTokens.delete(scopeKey: scopeKey)\n611|            guard !isStale(gen) else { return }\n612|            // Bind the remote ID to the verified local agent, never to a\n613|            // bare name match: a same-name foreign runner must fail here\n614|            // instead of becoming this installation's identity.\n615|            let verifiedLocal: RunnerRegistration.LocalRegistration? = await installer.readLocalRegistration(\n616|                directory: directory\n617|            )\n618|            let verifiedConfigured = await installer.hasCompleted(\n619|                RunnerInstallerService.stepConfigured, directory: directory\n620|            )\n621|            let verifiedID = try RunnerRegistration.Gates.verifiedLocalAgentID(\n622|                local: verifiedLocal,\n623|                configured: verifiedConfigured && localID != nil,\n624|                draft: draft,\n625|                serverHost: serverHost\n626|            )\n627|            let remoteID = try await resolveBoundRemoteRunnerID(\n628|                draft: draft, localAgentID: verifiedID, auth: auth, generation: gen\n629|            )\n630|            guard !isStale(gen) else { return }\n631|            runnerID = remoteID\n632|            await action { RunnerRegistration.Action.registered(runnerID: remoteID, localAgentID: verifiedID) }\n633|            guard !isStale(gen) else { return }\n634|            await action { RunnerRegistration.Action.permissionDismissed }\n635|            await finishStep(\"registerRunner\", generation: gen)\n636|        } catch {\n637|            working = false\n638|            await fail(error, step: \"registerRunner\", generation: gen)\n639|        }\n640|    }\n641|\n642|    /// Binds the complete remote runner list to the verified local agent ID.\n643|    /// Returns nil when this agent is not listed yet (convergence, retryable);\n644|    /// throws when the list contradicts the local identity. The step's own\n645|    /// auth is reused: no mid-step session reload may mix servers.\n646|    private func resolveBoundRemoteRunnerID(\n647|        draft: RunnerRegistration.Draft, localAgentID: Int64,\n648|        auth: FlowUserToken, generation gen: Int\n649|    ) async throws -> Int64? {\n650|        guard !isStale(gen) else { throw CancellationError() }\n651|        let runners = try await api.fetchRunners(config: auth.config, token: auth.token, scope: draft.scope)\n652|        let wanted = draft.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n653|        return try RunnerRegistration.Gates.boundRemoteRunnerID(\n654|            localAgentID: localAgentID, name: wanted, runners: runners\n655|        )\n656|    }\n657|\n658|    // MARK: - Service\n659|\n660|    private func setupService() async {\n661|        let gen = generation\n662|        guard !working else { return }\n663|        guard let draft, let installPath else {\n664|            failedStep = \"setupService\"\n665|            await action {\n666|                RunnerRegistration.Action.failed(message: \"Register the runner first.\", step: \"setupService\")\n667|            }\n668|            return\n669|        }\n670|        working = true\n671|        workingStep = \"setupService\"\n672|        await action { RunnerRegistration.Action.stepStarted(\"setupService\") }\n673|        let directory = URL(fileURLWithPath: installPath)\n674|        do {\n675|            // Service setup never declares registration complete on its own:\n676|            // it requires this operation's verified configured local identity\n677|            // on the authenticated server.\n678|            let auth = try await currentUserToken(generation: gen)\n679|            guard !isStale(gen) else { return }\n680|            _ = syncServerBinding(auth.identity.serverHost)\n681|            guard !isStale(gen) else { return }\n682|            let local = await installer.readLocalRegistration(directory: directory)\n683|            let configured = await installer.hasCompleted(\n684|                RunnerInstallerService.stepConfigured, directory: directory\n685|            )\n686|            _ = try RunnerRegistration.Gates.verifiedLocalAgentID(\n687|                local: local, configured: configured, draft: draft,\n688|                serverHost: auth.identity.serverHost\n689|            )\n690|            let marker = await installer.loadMarker(directory: directory)\n691|            let groupName: String?\n692|            switch draft.scope {\n693|            case .organization:\n694|                groupName = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n695|            case .repository:\n696|                groupName = nil\n697|            }\n698|            try RunnerInstallerService.verifyConfiguredGroup(\n699|                marker: marker, runnerGroup: groupName, draft: draft\n700|            )\n701|            guard !isStale(gen) else { return }\n702|            let label = Self.serviceLabel(draft: draft)\n703|            let plist = try await installer.setupService(directory: directory, label: label)\n704|            guard !isStale(gen) else { return }\n705|            await action { RunnerRegistration.Action.serviceReady(plistPath: plist.path) }\n706|            await finishStep(\"setupService\", generation: gen)\n707|        } catch {\n708|            working = false\n709|            await fail(error, step: \"setupService\", generation: gen)\n710|        }\n711|    }\n712|\n713|    // MARK: - Editable access and labels\n714|\n715|    private func applyRepositoryAccess(groupID: Int64, ids: Set<Int64>) async {\n716|        let gen = generation\n717|        guard !working else { return }\n718|        guard let draft else {\n719|            await action {\n720|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"applyRepositoryAccess\")\n721|            }\n722|            return\n723|        }\n724|        do {\n725|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n726|            guard case .organization(let org) = draft.scope else { return }\n727|            working = true\n728|            workingStep = \"applyRepositoryAccess\"\n729|            pendingRepositoryIDs = ids\n730|            pendingTargetGroupID = groupID\n731|            await action { RunnerRegistration.Action.stepStarted(\"applyRepositoryAccess\") }\n732|            let auth = try await currentUserToken(generation: gen)\n733|            guard !isStale(gen) else { return }\n734|            _ = syncServerBinding(auth.identity.serverHost)\n735|            guard !isStale(gen) else { return }\n736|            guard let group else {\n737|                throw RunnerRegistration.RegistrationError.invalidDraft(\n738|                    \"Resolve the dedicated group first.\"\n739|                )\n740|            }\n741|            try RunnerRegistration.Gates.authorizeGroupMutation(\n742|                targetGroupID: groupID, resolvedGroupID: group.id,\n743|                allowFlag: draft.allowGroupMutation\n744|            )\n745|            guard !isStale(gen) else { return }\n746|            try await api.setGroupRepositories(\n747|                config: auth.config, token: auth.token, org: org, groupID: group.id, selectedRepositoryIDs: ids\n748|            )\n749|            guard !isStale(gen) else { return }\n750|            let confirmed = try await api.fetchGroupRepositories(\n751|                config: auth.config, token: auth.token, org: org, groupID: group.id\n752|            )\n753|            guard !isStale(gen) else { return }\n754|            // The confirmed list is complete (every page followed). It must\n755|            // equal the request exactly; otherwise the draft keeps the\n756|            // requested selection and the step fails instead of claiming a\n757|            // partial write as success.\n758|            try RunnerRegistration.Gates.confirmRepositoryIDs(requested: ids, confirmed: confirmed)\n759|            guard !isStale(gen) else { return }\n760|            if var current = self.draft {\n761|                current.selectedRepositoryIDs = Set(confirmed)\n762|                self.draft = current\n763|            }\n764|            await action { RunnerRegistration.Action.repositoryAccessApplied(confirmed) }\n765|            guard !isStale(gen) else { return }\n766|            await action { RunnerRegistration.Action.permissionDismissed }\n767|            pendingRepositoryIDs = nil\n768|            pendingTargetGroupID = nil\n769|            await finishStep(\"applyRepositoryAccess\", generation: gen)\n770|        } catch {\n771|            working = false\n772|            await fail(error, step: \"applyRepositoryAccess\", generation: gen)\n773|        }\n774|    }\n775|\n776|    private func applyLabels(_ labels: [String]) async {\n777|        let gen = generation\n778|        guard !working else { return }\n779|        guard let draft