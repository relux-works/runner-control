{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5dd","stream":{"kind":"session","id":"01a0a8de-e22e-70a3-89be-ab44c7c44c24"},"sequence":329,"recorded_at":1780531400000653,"record_type":"event","durability":"durable","causation_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91","run_stream":{"kind":"run","id":"6ff73b13-a72a-4314-9fa1-56166ffd9a91"},"call_id":"call_01a0a8dfa90476fdb8b4036579d6def8","text":"Read text file `Packages/RunnerControlCore/Sources/RunnerRegistration+Flow.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension RunnerRegistration {\n5|    public protocol IFlow: Relux.Flow {}\n6|\n7|    public actor Flow {\n8|        public let dispatcher: Relux.Dispatcher\n9|        private let api: GitHubRunnerAPIClient\n10|        private let installer: RunnerInstallerService\n11|        private let registrationTokens: any RunnerRegistrationTokenStoring\n12|        private let userStore: any GitHubCredentialStoring\n13|        private let identities: any GitHubSessionIdentityStoring\n14|        private let refresher: GitHubTokenRefresh\n15|        private let configProvider: @Sendable (String?) throws -> GitHubAuth.AppConfig\n16|        private let now: @Sendable () -> Date\n17|\n18|        private var generation = 0\n19|        private var working = false\n20|        private var workingStep: String?\n21|        private var draft: Draft?\n22|        private var group: RunnerGroup?\n23|        private var asset: DownloadAsset?\n24|        private var installPath: String?\n25|        private var runnerID: Int64?\n26|        private var failedStep: String?\n27|        private var pendingRepositoryIDs: Set<Int64>?\n28|        private var pendingTargetGroupID: Int64?\n29|        private var pendingLabels: [String]?\n30|        /// Authenticated server the cached progress is bound to. A session\n31|        /// change invalidates server-bound caches before any reuse, so a\n32|        /// group/runner ID from one server never authorizes writes on another.\n33|        private var boundServerHost: String?\n34|\n35|        public init(\n36|            api: GitHubRunnerAPIClient,\n37|            installer: RunnerInstallerService,\n38|            registrationTokens: any RunnerRegistrationTokenStoring,\n39|            userStore: any GitHubCredentialStoring,\n40|            identityStore: any GitHubSessionIdentityStoring,\n41|            refresher: GitHubTokenRefresh,\n42|            configProvider: (@Sendable (String?) throws -> GitHubAuth.AppConfig)? = nil,\n43|            now: (@Sendable () -> Date)? = nil,\n44|            dispatcher: Relux.Dispatcher? = nil\n45|        ) async {\n46|            self.api = api\n47|            self.installer = installer\n48|            self.registrationTokens = registrationTokens\n49|            self.userStore = userStore\n50|            self.identities = identityStore\n51|            self.refresher = refresher\n52|            self.configProvider = configProvider ?? { host in\n53|                try GitHubAuth.AppConfig.current(serverHost: host ?? \"github.com\")\n54|            }\n55|            self.now = now ?? Date.init\n56|            self.dispatcher = if let dispatcher { dispatcher } else { await Self.defaultDispatcher }\n57|        }\n58|\n59|        /// Deterministic LaunchAgent label for a draft. Always carries the\n60|        /// `actions.runner.` prefix discovery requires.\n61|        public nonisolated static func serviceLabel(draft: Draft) -> String {\n62|            let scope = draft.scope.detail.replacingOccurrences(of: \"/\", with: \"-\")\n63|            let raw = \"actions.runner.\\(scope).\\(draft.installDirName)\"\n64|            let allowed = CharacterSet.alphanumerics.union(CharacterSet(charactersIn: \".-\"))\n65|            return raw.unicodeScalars.map { allowed.contains($0) ? String($0) : \"-\" }.joined()\n66|        }\n67|\n68|        public nonisolated static func tokenScopeKey(draft: Draft) -> String {\n69|            \"\\(draft.scope.scopeKey):\\(draft.installDirName)\"\n70|        }\n71|    }\n72|}\n73|\n74|/// Authenticated user token for wizard API calls. Never logged.\n75|private struct FlowUserToken: Sendable {\n76|    let config: GitHubAuth.AppConfig\n77|    let token: String\n78|    let identity: GitHubSessionIdentity\n79|}\n80|\n81|extension RunnerRegistration.Flow: RunnerRegistration.IFlow {\n82|    public func apply(_ effect: any Relux.Effect) async -> Relux.ActionResult {\n83|        guard let effect = effect as? RunnerRegistration.Effect else { return .success }\n84|        switch effect {\n85|        case .beginDraft(let draft): await beginDraft(draft)\n86|        case .updateDraft(let draft): await updateDraft(draft)\n87|        case .resolveGroup: await resolveGroup()\n88|        case .prepareDownload: await prepareDownload()\n89|        case .downloadAndInstall: await downloadAndInstall()\n90|        case .registerRunner: await registerRunner()\n91|        case .setupService: await setupService()\n92|        case .applyRepositoryAccess(let groupID, let ids): await applyRepositoryAccess(groupID: groupID, ids: ids)\n93|        case .applyLabels(let labels): await applyLabels(labels)\n94|        case .retry: await retry()\n95|        case .cancel: await cancel()\n96|        case .reset: await reset()\n97|        case .dismissPermission: await action { RunnerRegistration.Action.permissionDismissed }\n98|        }\n99|        return .success\n100|    }\n101|\n102|    private func isStale(_ gen: Int) -> Bool { generation != gen }\n103|\n104|    // MARK: - Draft\n105|\n106|    private func beginDraft(_ draft: RunnerRegistration.Draft) async {\n107|        do {\n108|            try RunnerRegistration.Gates.validateDraft(draft)\n109|        } catch {\n110|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"beginDraft\") }\n111|            return\n112|        }\n113|        // A new draft abandons any in-flight completion: the old operation's\n114|        // success must never be attributed to the new draft. Already-started\n115|        // filesystem side effects stay on disk for safe recovery; only their\n116|        // completion ownership is revoked via the generation bump.\n117|        let abandoned = working\n118|        if abandoned {\n119|            generation += 1\n120|            working = false\n121|            workingStep = nil\n122|        }\n123|        self.draft = draft\n124|        group = nil\n125|        asset = nil\n126|        installPath = nil\n127|        runnerID = nil\n128|        failedStep = nil\n129|        pendingRepositoryIDs = nil\n130|        pendingTargetGroupID = nil\n131|        pendingLabels = nil\n132|        boundServerHost = nil\n133|        await action { RunnerRegistration.Action.draftBegan(draft) }\n134|        if abandoned {\n135|            await action { RunnerRegistration.Action.cancelled }\n136|        }\n137|    }\n138|\n139|    private func updateDraft(_ draft: RunnerRegistration.Draft) async {\n140|        do {\n141|            try RunnerRegistration.Gates.validateDraft(draft)\n142|        } catch {\n143|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"updateDraft\") }\n144|            return\n145|        }\n146|        // Identity edits while working abandon the in-flight operation via\n147|        // the generation bump. Selections stay editable without cancelling\n148|        // unrelated steps — except the mutation they feed: a labels edit\n149|        // abandons in-flight applyLabels and a repository edit abandons\n150|        // in-flight applyRepositoryAccess, so an older completion can never\n151|        // overwrite the newer visible selection or report it as applied.\n152|        // Stale completions observe the bump at their next await boundary\n153|        // and emit nothing.\n154|        var abandoned = false\n155|        if let old = self.draft {\n156|            if working, shouldAbandonInFlight(old: old, new: draft) {\n157|                generation += 1\n158|                working = false\n159|                workingStep = nil\n160|                abandoned = true\n161|            }\n162|            invalidateProgress(old: old, new: draft)\n163|        }\n164|        self.draft = draft\n165|        await action { RunnerRegistration.Action.draftUpdated(draft) }\n166|        if abandoned {\n167|            await action { RunnerRegistration.Action.cancelled }\n168|        }\n169|    }\n170|\n171|    /// Invalidates cached success-progress bound to the changed identity\n172|    /// fields. Scope/install/name/group/work-folder edits never reuse\n173|    /// another registration's evidence; editable selections re-target pending\n174|    /// retries to the visible values instead. Mirrors the reducer's\n175|    /// invalidation. Group is part of the config identity (`--runnergroup`):\n176|    /// a group edit drops registration evidence as well, so the old group's\n177|    /// configuration is never claimed as the new draft's success.\n178|    private func invalidateProgress(old: RunnerRegistration.Draft, new: RunnerRegistration.Draft) {\n179|        if old.scope != new.scope {\n180|            group = nil\n181|            asset = nil\n182|            installPath = nil\n183|            runnerID = nil\n184|            pendingRepositoryIDs = nil\n185|            pendingTargetGroupID = nil\n186|            pendingLabels = nil\n187|            failedStep = nil\n188|            return\n189|        }\n190|        if old.installDirName != new.installDirName {\n191|            installPath = nil\n192|            runnerID = nil\n193|            pendingLabels = nil\n194|            if [\"downloadAndInstall\", \"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n195|                failedStep = nil\n196|            }\n197|        }\n198|        let oldName = old.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n199|        let newName = new.runnerName.trimmingCharacters(in: .whitespacesAndNewlines)\n200|        if oldName != newName {\n201|            runnerID = nil\n202|            pendingLabels = nil\n203|            if [\"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n204|                failedStep = nil\n205|            }\n206|        }\n207|        let oldIsOrg: Bool = if case .organization = old.scope { true } else { false }\n208|        let newIsOrg: Bool = if case .organization = new.scope { true } else { false }\n209|        if oldIsOrg || newIsOrg {\n210|            let oldGroup = old.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n211|            let newGroup = new.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n212|            if oldGroup != newGroup {\n213|                group = nil\n214|                runnerID = nil\n215|                pendingRepositoryIDs = nil\n216|                pendingTargetGroupID = nil\n217|                pendingLabels = nil\n218|                if [\"resolveGroup\", \"applyRepositoryAccess\", \"registerRunner\", \"setupService\", \"applyLabels\"]\n219|                    .contains(failedStep ?? \"\") {\n220|                    failedStep = nil\n221|                }\n222|            }\n223|        }\n224|        if old.workFolder != new.workFolder {\n225|            runnerID = nil\n226|            pendingLabels = nil\n227|            if [\"registerRunner\", \"setupService\", \"applyLabels\"].contains(failedStep ?? \"\") {\n228|                failedStep = nil\n229|            }\n230|        }\n231|        // Editable selections stay live: a retry after an edit applies the\n232|        // visible values, never the stale attempt's.\n233|        if old.labels != new.labels, !new.labels.isEmpty {\n234|            pendingLabels = new.labels\n235|        }\n236|        if old.selectedRepositoryIDs != new.selectedRepositoryIDs {\n237|            pendingRepositoryIDs = new.selectedRepositoryIDs\n238|        }\n239|    }\n240|\n241|    /// True when an edit must abandon the in-flight step: any identity\n242|    /// change, plus a selection change for the mutation it feeds.\n243|    private func shouldAbandonInFlight(old: RunnerRegistration.Draft, new: RunnerRegistration.Draft) -> Bool {\n244|        if RunnerRegistration.Gates.identityFieldsChanged(old: old, new: new) { return true }\n245|        if workingStep == \"applyLabels\", old.labels != new.labels { return true }\n246|        if workingStep == \"applyRepositoryAccess\", old.selectedRepositoryIDs != new.selectedRepositoryIDs {\n247|            return true\n248|        }\n249|        return false\n250|    }\n251|\n252|    // MARK: - Auth\n253|\n254|    private func currentUserToken(generation gen: Int) async throws -> FlowUserToken {\n255|        guard let identity = await identities.load() else {\n256|            throw RunnerRegistration.RegistrationError.notAuthenticated\n257|        }\n258|        let config = try configProvider(identity.serverHost)\n259|        guard var record = await userStore.load(\n260|            serverHost: identity.serverHost, userID: identity.userID, clientID: identity.clientID\n261|        ) else {\n262|            throw RunnerRegistration.RegistrationError.notAuthenticated\n263|        }\n264|        guard !isStale(gen) else { throw CancellationError() }\n265|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n266|            do {\n267|                record = try await refresher.refresh(config: config, userID: identity.userID, current: record)\n268|            } catch is CancellationError {\n269|                throw CancellationError()\n270|            } catch let error as GitHubAuth.AuthError {\n271|                switch error {\n272|                case .revoked, .unauthorized, .tokenRefreshFailed:\n273|                    throw RunnerRegistration.RegistrationError.unauthorized\n274|                default:\n275|                    break\n276|                }\n277|            }\n278|            guard !isStale(gen) else { throw CancellationError() }\n279|        }\n280|        return FlowUserToken(config: config, token: record.accessToken, identity: identity)\n281|    }\n282|\n283|    /// Binds cached progress to the authenticated server. When the session\n284|    /// server changes between steps, server-bound caches (group, asset,\n285|    /// runner ID, pendings) are dropped before any reuse, so an ID from one\n286|    /// server never authorizes writes on another. Returns false when the\n287|    /// binding changed and the caller must re-resolve instead of reusing.\n288|    @discardableResult\n289|    private func syncServerBinding(_ host: String) -> Bool {\n290|        let normalized = RunnerRegistration.OperationIdentity.normalizeServerHost(host)\n291|        if let bound = boundServerHost,\n292|           RunnerRegistration.OperationIdentity.normalizeServerHost(bound) == normalized {\n293|            return true\n294|        }\n295|        if boundServerHost != nil {\n296|            group = nil\n297|            asset = nil\n298|            runnerID = nil\n299|            pendingRepositoryIDs = nil\n300|            pendingTargetGroupID = nil\n301|            pendingLabels = nil\n302|            failedStep = nil\n303|            boundServerHost = normalized\n304|            return false\n305|        }\n306|        boundServerHost = normalized\n307|        return true\n308|    }\n309|\n310|    private func fail(_ error: Error, step: String, generation gen: Int) async {\n311|        guard !isStale(gen) else { return }\n312|        failedStep = step\n313|        workingStep = nil\n314|        if error is CancellationError { return }\n315|        if let reg = error as? RunnerRegistration.RegistrationError {\n316|            switch reg {\n317|            case .missingPermission, .forbidden:\n318|                await action {\n319|                    RunnerRegistration.Action.permissionDenied(message: reg.localizedDescription, step: step)\n320|                }\n321|                return\n322|            default:\n323|                break\n324|            }\n325|        }\n326|        let message = (error as? LocalizedError)?.localizedDescription ?? error.localizedDescription\n327|        await action { RunnerRegistration.Action.failed(message: message, step: step) }\n328|    }\n329|\n330|    private func finishStep(_ step: String, generation gen: Int) async {\n331|        guard !isStale(gen) else { return }\n332|        failedStep = nil\n333|        working = false\n334|        workingStep = nil\n335|        await action { RunnerRegistration.Action.stepFinished(step) }\n336|    }\n337|\n338|    // MARK: - Group\n339|\n340|    private func resolveGroup() async {\n341|        let gen = generation\n342|        guard !working else { return }\n343|        guard let draft else {\n344|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"resolveGroup\") }\n345|            return\n346|        }\n347|        do {\n348|            try RunnerRegistration.Gates.requireOrganizationScope(draft.scope)\n349|        } catch {\n350|            failedStep = \"resolveGroup\"\n351|            await action { RunnerRegistration.Action.failed(message: error.localizedDescription, step: \"resolveGroup\") }\n352|            return\n353|        }\n354|        guard case .organization(let org) = draft.scope else { return }\n355|        working = true\n356|        workingStep = \"resolveGroup\"\n357|        await action { RunnerRegistration.Action.stepStarted(\"resolveGroup\") }\n358|        do {\n359|            let auth = try await currentUserToken(generation: gen)\n360|            guard !isStale(gen) else { return }\n361|            _ = syncServerBinding(auth.identity.serverHost)\n362|            guard !isStale(gen) else { return }\n363|            let groups = try await api.fetchGroups(config: auth.config, token: auth.token, org: org)\n364|            guard !isStale(gen) else { return }\n365|            let name = draft.groupName.trimmingCharacters(in: .whitespacesAndNewlines)\n366|            let resolved: RunnerRegistration.RunnerGroup\n367|            if let existing = groups.first(where: { $0.name == name }) {\n368|                // Name alone never authorizes adoption: require a locally\n369|                // recorded ownership entry on this server or explicit\n370|                // takeover confirmation.\n371|                let owned = await installer.loadOwnedGroupID(\n372|                    serverHost: auth.identity.serverHost, org: org, name: name\n373|                )\n374|                try RunnerRegistration.Gates.authorizeGroupTakeover(\n375|                    groupName: name, existingID: existing.id,\n376|                    ownedID: owned, allowTakeover: draft.allowGroupTakeover\n377|                )\n378|                if owned != existing.id {\n379|                    try await installer.saveOwnedGroupID(\n380|                        serverHost: auth.identity.serverHost, org: org, name: name, groupID: existing.id\n381|                    )\n382|                }\n383|                guard !isStale(gen) else { return }\n384|                // A pre-existing group may deny public repos (GitHub default\n385|                // false), which would silently drop selected public repos.\n386|                if existing.allowsPublicRepositories {\n387|                    resolved = existing\n388|                } else {\n389|                    resolved = try await api.updateGroupAllowsPublic(\n390|                        config: auth.config, token: auth.token, org: org,\n391|                        groupID: existing.id, allowsPublic: true\n392|                    )\n393|                }\n394|            } else {\n395|                resolved = try await api.createGroup(\n396|                    config: auth.config, token: auth.token, org: org,\n397|                    name: name, selectedRepositoryIDs: draft.selectedRepositoryIDs,\n398|                    allowsPublicRepositories: true\n399|                )\n400|                guard !isStale(gen) else { return }\n401|                try await installer.saveOwnedGroupID(\n402|                    serverHost: auth.identity.serverHost, org: org, name: name, groupID: resolved.id\n403|                )\n404|            }\n405|            guard !isStale(gen) else { return }\n406|            let repoIDs = try await api.fetchGroupRepositories(\n407|                config: auth.config, token: auth.token, org: org, groupID: resolved.id\n408|            )\n409|            guard !isStale(gen) else { return }\n410|            group = resolved\n411|            await action { RunnerRegistration.Action.groupResolved(resolved, repositoryIDs: repoIDs) }\n412|            guard !isStale(gen) else { return }\n413|            await action { RunnerRegistration.Action.permissionDismissed }\n414|            await finishStep(\"resolveGroup\", generation: gen)\n415|        } catch {\n416|            working = false\n417|            await fail(error, step: \"resolveGroup\", generation: gen)\n418|        }\n419|    }\n420|\n421|    // MARK: - Download\n422|\n423|    private func prepareDownload() async {\n424|        let gen = generation\n425|        guard !working else { return }\n426|        guard let draft else {\n427|            await action { RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"prepareDownload\") }\n428|            return\n429|        }\n430|        working = true\n431|        workingStep = \"prepareDownload\"\n432|        await action { RunnerRegistration.Action.stepStarted(\"prepareDownload\") }\n433|        do {\n434|            let auth = try await currentUserToken(generation: gen)\n435|            guard !isStale(gen) else { return }\n436|            _ = syncServerBinding(auth.identity.serverHost)\n437|            guard !isStale(gen) else { return }\n438|            let found = try await prepareDownloadInner(draft: draft, auth: auth, generation: gen)\n439|            guard !isStale(gen) else { return }\n440|            asset = found\n441|            await action { RunnerRegistration.Action.downloadReady(found) }\n442|            await finishStep(\"prepareDownload\", generation: gen)\n443|        } catch {\n444|            working = false\n445|            await fail(error, step: \"prepareDownload\", generation: gen)\n446|        }\n447|    }\n448|\n449|    private func prepareDownloadInner(\n450|        draft: RunnerRegistration.Draft, auth: FlowUserToken, generation gen: Int\n451|    ) async throws -> RunnerRegistration.DownloadAsset {\n452|        guard !isStale(gen) else { throw CancellationError() }\n453|        let assets = try await api.fetchDownloads(config: auth.config, token: auth.token, scope: draft.scope)\n454|        guard !isStale(gen) else { throw CancellationError() }\n455|        return try RunnerRegistration.Gates.selectDownload(\n456|            osName: RunnerInstallerService.installOS,\n457|            arch: installer.architecture,\n458|            from: assets\n459|        )\n460|    }\n461|\n462|    // MARK: - Install\n463|\n464|    private func downloadAndInstall() async {\n465|        let gen = generation\n466|        guard !working else { return }\n467|        guard let draft else {\n468|            await action {\n469|                RunnerRegistration.Action.failed(message: \"Start a draft first.\", step: \"downloadAndInstall\")\n470|            }\n471|            return\n472|        }\n473|        working = true\n474|        workingStep = \"downloadAndInstall\"\n475|        await action { RunnerRegistration.Action.stepStarted(\"downloadAndInstall\") }\n476|        do {\n477|            // Bind to the authenticated server before touching the cache: a\n478|            // session change drops the old server's asset instead of reusing\n479|            // it. The same auth serves the whole step; no mid-step reload\n480|            // may mix servers.\n481|            let auth = try await currentUserToken(generation: gen)\n482|            guard !isStale(gen) else { return }\n483|            _ = syncServerBinding(auth.identity.serverHost)\n484|            guard !isStale(gen) else { return }\n485|            let serverHost = auth.identity.serverHost\n486|            let resolved: RunnerRegistration.DownloadAsset\n487|            if let asset {\n488|                resolved = asset\n489|            } else {\n490|                resolved = try await prepareDownloadInner(draft: draft, auth: auth, generation: gen)\n491|                guard !isStale(gen) else { return }\n492|                asset = resolved\n493|                await action { RunnerRegistration.Action.downloadReady(resolved) }\n494|            }\n495|            guard !isStale(gen) else { return }\n496|            let directory = try await installer.downloadAndInstall(\n497|                asset: resolved, draft: draft, serverHost: serverHost\n498|            )\n499|            guard !isStale(gen) else { return }\n500|            installPath = directory.path\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
