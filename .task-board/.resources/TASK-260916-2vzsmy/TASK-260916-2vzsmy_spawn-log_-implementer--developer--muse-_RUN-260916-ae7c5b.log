{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c611","stream":{"kind":"session","id":"01a0a834-2dd6-7302-a20b-bd6ef471e4be"},"sequence":355,"recorded_at":1780531400000705,"record_type":"event","durability":"durable","causation_id":"f40cada4-f145-4b44-bc35-1e9f8e45782b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f40cada4-f145-4b44-bc35-1e9f8e45782b","run_stream":{"kind":"run","id":"f40cada4-f145-4b44-bc35-1e9f8e45782b"},"task_stream":{"kind":"task","id":"01a0a835-28a0-7cd1-903d-09b0dcee7048"},"task_id":"01a0a835-28a0-7cd1-903d-09b0dcee7048","event":{"kind":"output","task_id":"01a0a835-28a0-7cd1-903d-09b0dcee7048","chunk":"Read text file `Scripts/release-preflight.sh`.\n1|#!/bin/bash\n2|set -euo pipefail\n3|for tool in xcodebuild xcrun codesign security hdiutil tuist gh python3; do\n4|  command -v \"$tool\" >/dev/null || { echo \"Missing release tool: $tool\" >&2; exit 1; }\n5|done\n6|identity_out=\"$(mktemp)\"\n7|identity_err=\"$(mktemp)\"\n8|if ! security find-identity -v -p codesigning >\"$identity_out\" 2>\"$identity_err\"; then\n9|  echo 'Could not read signing identities; the result is unknown, not missing.' >&2\n10|  head -n 5 \"$identity_err\" >&2 || true\n11|  rm -f \"$identity_out\" \"$identity_err\"\n12|  exit 1\n13|fi\n14|identities=\"$(grep -E 'Developer ID Application:.*\\(262RZ595FP\\)' \"$identity_out\" || true)\"\n15|rm -f \"$identity_out\" \"$identity_err\"\n16|if [ -z \"$identities\" ]; then\n17|  echo 'Missing Developer ID Application identity with private key for team 262RZ595FP.' >&2\n18|  echo 'An Account Holder must issue it; Apple Development or another team cannot be substituted.' >&2\n19|  exit 1\n20|fi\n21|if [ \"$(printf '%s\\n' \"$identities\" | grep -c .)\" -gt 1 ]; then\n22|  echo 'Multiple Developer ID Application identities for team 262RZ595FP; remove the stale certificate so release signing is unambiguous.' >&2\n23|  exit 1\n24|fi\n25|profile=\"${NOTARY_PROFILE:-RunnerControl-notary}\"\n26|history_err=\"$(mktemp)\"\n27|if ! xcrun notarytool history --keychain-profile \"$profile\" --output-format json >/dev/null 2>\"$history_err\"; then\n28|  if grep -q 'keychainLocked' \"$history_err\"; then\n29|    echo \"The login keychain is locked in this session, so notarytool profile '$profile' cannot be read.\" >&2\n30|    echo 'Unlock the login keychain on macbook-iv (console login as the runner user) and re-run Release DMG via workflow_dispatch with the existing tag. Credentials are never printed or exported.' >&2\n31|  elif grep -q 'No Keychain password item found for profile' \"$history_err\"; then\n32|    echo \"notarytool profile '$profile' is missing from the login keychain.\" >&2\n33|    echo \"Recreate it locally with 'xcrun notarytool store-credentials' (see RELEASING.md), then re-run Release DMG via workflow_dispatch with the existing tag.\" >&2\n34|  else\n35|    echo \"notarytool history failed for profile '$profile':\" >&2\n36|    head -n 5 \"$history_err\" >&2 || true\n37|  fi\n38|  rm -f \"$history_err\"\n39|  exit 1\n40|fi\n41|rm -f \"$history_err\"\n42|root=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n43|cd \"$root\"\n44|sparkle_bin=\"$(\"$root/Scripts/sparkle-tools.sh\")\"\n45|actual=\"$(\"$sparkle_bin/generate_keys\" --account works.relux.runnercontrol -p)\"\n46|expected=\"$(python3 -c 'import json; print(json.load(open(\"ios-app-manager.json\"))[\"macos\"][\"info_plist\"][\"SUPublicEDKey\"])')\"\n47|[ \"$actual\" = \"$expected\" ] || { echo 'Sparkle signing key is missing or does not match the app public key.' >&2; exit 1; }\n48|printf \"Release prerequisites verified (team 262RZ595FP, notary profile '%s').\\n\" \"$profile\"","final_result":true}}}
