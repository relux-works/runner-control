README.md'):\n71|            text = (REPO / name).read_text()\n72|            self.assertNotRegex(text, r'BEGIN [A-Z ]*PRIVATE')\n73|            self.assertNotRegex(text, r'BEGIN CERTIFICATE')\n74|            self.assertNotRegex(text, r'\\b[A-F0-9]{40}\\b')\n75|\n76|\n77|if __name__ == '__main__':\n78|    unittest.main()","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
