{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c5","stream":{"kind":"session","id":"01a0a834-2dd6-7302-a20b-bd6ef471e4be"},"sequence":445,"recorded_at":1780531400000885,"record_type":"event","durability":"durable","causation_id":"f40cada4-f145-4b44-bc35-1e9f8e45782b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f40cada4-f145-4b44-bc35-1e9f8e45782b","run_stream":{"kind":"run","id":"f40cada4-f145-4b44-bc35-1e9f8e45782b"},"task_stream":{"kind":"task","id":"01a0a835-6be7-70f1-af5c-b07796c96f9d"},"task_id":"01a0a835-6be7-70f1-af5c-b07796c96f9d","event":{"kind":"output","task_id":"01a0a835-6be7-70f1-af5c-b07796c96f9d","chunk":"Read text file `Scripts/tests/test_release_packaging.py`.\n1|\"\"\"Drive the real Scripts/release.sh end to end with stubbed macOS tools.\n2|\n3|Each test builds an isolated repo root (real release.sh, release-preflight.sh,\n4|release_metadata.py, sparkle-tools.sh; fixture ios-app-manager.json for the\n5|coordinator-approved v1.2.0 target) and a stub bin dir shadowing security,\n6|xcrun, xcodebuild, codesign, ditto, hdiutil, spctl, tuist, gh plus the\n7|generator binary. The Sparkle bin dir is pre-created so no download happens.\n8|No credentials enter the fixtures; no Apple submission or publication occurs.\n9|\n10|The DMG-signing gate is proven behaviorally: the codesign stub records every\n11|invocation, and tests assert the exact resolved team identity reaches\n12|`codesign --sign`, on first attempt and on retry, and that zero/multiple\n13|identities prevent all packaging and workflow output. Refusal coverage extends\n14|to tag/marketing mismatch, out-of-range run numbers, notary rejection, a wrong\n15|codesign team, appcast tampering, and an unresolvable identity hash that passes\n16|preflight but must fail DMG signing; late refusals assert no SHA256SUMS and no\n17|dist= workflow output escape.\n18|\"\"\"\n19|import base64\n20|import json\n21|import os\n22|from pathlib import Path\n23|import shutil\n24|import subprocess\n25|import tempfile\n26|import unittest\n27|\n28|REPO = Path(__file__).parents[2]\n29|TAG = 'v1.2.0'\n30|TEAM = '262RZ595FP'\n31|EXPECTED_SHA = '267D90FC976A48CF830BE7F41AE612999E025054'\n32|PUBKEY = base64.b64encode(bytes(32)).decode()\n33|TEAM_LINE = f'  3) {EXPECTED_SHA} \"Developer ID Application: Relux Works, LLC ({TEAM})\"'\n34|OTHER_LINES = ('  1) 7FB8D981868F2637B75DFD098A1F87E0CC11158D \"Apple Development: Ivan Oparin (45W9YW7M6V)\"\\n'\n35|               '  4) C8448515B5871071F90EB0168A79DCD35E7CA9FE \"Developer ID Application: SKL VC DMCC (4Y4UJAT8QR)\"')\n36|VALID_OUTPUT = OTHER_LINES + '\\n' + TEAM_LINE\n37|\n38|GENERATE_APPCAST = '''#!/usr/bin/env python3\n39|import base64, json, os, sys\n40|args = sys.argv[1:]\n41|distdir = args[-1]\n42|prefix = args[args.index('--download-url-prefix') + 1]\n43|tag = os.environ['RELEASE_TAG']\n44|root = os.environ['FIXTURE_ROOT']\n45|build = json.load(open(os.path.join(root, 'ios-app-manager.json')))['project_version']\n46|if os.environ.get('APPCAST_TAMPER') == '1':\n47|    build = '0.0-tampered'\n48|size = os.path.getsize(os.path.join(distdir, 'RunnerControl.dmg'))\n49|sig = base64.b64encode(bytes(64)).decode()\n50|xml = f\"\"\"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n51|<rss version=\"2.0\" xmlns:sparkle=\"http://www.andymatuschak.org/xml-namespaces/sparkle\">\n52|<channel>\n53|<item>\n54|<title>Runner Control {tag}</title>\n55|<sparkle:version>{build}</sparkle:version>\n56|<sparkle:shortVersionString>{tag[1:]}</sparkle:shortVersionString>\n57|<sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>\n58|<enclosure url=\"{prefix}RunnerControl.dmg\" length=\"{size}\" type=\"application/octet-stream\" sparkle:edSignature=\"{sig}\" />\n59|</item>\n60|</channel>\n61|</rss>\n62|\"\"\"\n63|open(os.path.join(distdir, 'appcast.xml'), 'w').write(xml)\n64|'''\n65|\n66|XCODEBUILD_STUB = '''#!/bin/bash\n67|prev=\"\"\n68|for a in \"$@\"; do\n69|  if [ \"$prev\" = \"-archivePath\" ]; then mkdir -p \"$a\"; fi\n70|  if [ \"$prev\" = \"-exportPath\" ]; then\n71|    mkdir -p \"$a/RunnerControl.app\"\n72|    printf 'fixture' > \"$a/RunnerControl.app/RunnerControl\"\n73|  fi\n74|  prev=\"$a\"\n75|done\n76|exit 0\n77|'''\n78|\n79|XCRUN_STUB = '''#!/bin/bash\n80|if [ \"${1:-}\" = \"notarytool\" ] && [ \"${2:-}\" = \"submit\" ]; then\n81|  printf '{\"status\":\"%s\",\"id\":\"00000000-0000-0000-0000-000000000000\"}\\\\n' \"${NOTARY_STATUS:-Accepted}\"\n82|fi\n83|exit 0\n84|'''\n85|\n86|CODESIGN_STUB = '''#!/bin/bash\n87|if [ \"${1:-}\" = \"-dvv\" ]; then\n88|  team=\"${CODESIGN_TEAM:-262RZ595FP}\"\n89|  echo \"Executable=${2:-}\"\n90|  echo \"Identifier=works.relux.runnercontrol\"\n91|  echo \"TeamIdentifier=$team\"\n92|  echo \"Authority=Developer ID Application: Relux Works, LLC ($team)\"\n93|  exit 0\n94|fi\n95|printf '%s\\\\n' \"$*\" >> \"$CODESIGN_LOG\"\n96|exit 0\n97|'''\n98|\n99|DITTO_STUB = '''#!/bin/bash\n100|dest=\"${@: -1}\"\n101|if [ \"${1:-}\" = \"-c\" ]; then : > \"$dest\"; else mkdir -p \"$dest\"; fi\n102|exit 0\n103|'''\n104|\n105|HDIUTIL_STUB = '''#!/bin/bash\n106|printf 'fixture-dmg' > \"${@: -1}\"\n107|exit 0\n108|'''\n109|\n110|\n111|def write_exe(path, content):\n112|    path.write_text(content)\n113|    path.chmod(0o755)\n114|\n115|\n116|class ReleasePackagingHarness(unittest.TestCase):\n117|    def setUp(self):\n118|        self.tmp = tempfile.TemporaryDirectory()\n119|        root = Path(self.tmp.name)\n120|        scripts = root / 'Scripts'\n121|        scripts.mkdir()\n122|        for name in ('release.sh', 'release-preflight.sh', 'release_metadata.py',\n123|                     'sparkle-tools.sh'):\n124|            shutil.copy(REPO / 'Scripts' / name, scripts / name)\n125|        (root / 'ios-app-manager.json').write_text(json.dumps({\n126|            'bundle_id': 'works.relux.runnercontrol',\n127|            'team_id': TEAM,\n128|            'marketing_version': TAG[1:],\n129|            'macos': {'info_plist': {\n130|                'SUFeedURL': 'https://github.com/relux-works/runner-control/releases/latest/download/appcast.xml',\n131|                'SUPublicEDKey': PUBKEY}}}))\n132|        sparkle_bin = root / '.temp' / 'tools' / 'Sparkle-2.10.0' / 'bin'\n133|        sparkle_bin.mkdir(parents=True)\n134|        write_exe(sparkle_bin / 'generate_appcast', GENERATE_APPCAST)\n135|        write_exe(sparkle_bin / 'generate_keys', '#!/bin/sh\\necho ' + PUBKEY + '\\n')\n136|        bindir = root / 'bin'\n137|        bindir.mkdir()\n138|        write_exe(bindir / 'xcodebuild', XCODEBUILD_STUB)\n139|        write_exe(bindir / 'xcrun', XCRUN_STUB)\n140|        write_exe(bindir / 'codesign', CODESIGN_STUB)\n141|        write_exe(bindir / 'ditto', DITTO_STUB)\n142|        write_exe(bindir / 'hdiutil', HDIUTIL_STUB)\n143|        for tool in ('spctl', 'tuist', 'gh', 'ios-app-manager'):\n144|            write_exe(bindir / tool, '#!/bin/bash\\nexit 0\\n')\n145|        self.root = root\n146|        self.bindir = bindir\n147|        self.codesign_log = root / 'codesign.log'\n148|        self.github_output = root / 'github-output.txt'\n149|\n150|    def tearDown(self):\n151|        self.tmp.cleanup()\n152|\n153|    def run_release(self, security_out, attempt=1, run_number=101, tag=TAG,\n154|                    notary_status='Accepted', codesign_team=TEAM, tamper_appcast=False):\n155|        if security_out:\n156|            stub = '#!/bin/sh\\ncat <<\\'EOF\\'\\n' + security_out + '\\nEOF\\n'\n157|        else:\n158|            stub = '#!/bin/sh\\n'\n159|        write_exe(self.bindir / 'security', stub)\n160|        env = dict(os.environ)\n161|        env['PATH'] = str(self.bindir) + os.pathsep + env['PATH']\n162|        env['RELEASE_TAG'] = tag\n163|        env['GITHUB_RUN_NUMBER'] = str(run_number)\n164|        env['GITHUB_RUN_ATTEMPT'] = str(attempt)\n165|        env['IOS_APP_MANAGER'] = str(self.bindir / 'ios-app-manager')\n166|        env['GITHUB_OUTPUT'] = str(self.github_output)\n167|        env['CODESIGN_LOG'] = str(self.codesign_log)\n168|        env['FIXTURE_ROOT'] = str(self.root)\n169|        env['NOTARY_STATUS'] = notary_status\n170|        env['CODESIGN_TEAM'] = codesign_team\n171|        env['APPCAST_TAMPER'] = '1' if tamper_appcast else '0'\n172|        env.pop('NOTARY_PROFILE', None)\n173|        return subprocess.run(['bash', str(self.root / 'Scripts' / 'release.sh')],\n174|                              capture_output=True, text=True, timeout=180,\n175|                              env=env, cwd=self.tmp.name)\n176|\n177|    def dist_of(self):\n178|        for line in self.github_output.read_text().splitlines():\n179|            if line.startswith('dist='):\n180|                return Path(line[len('dist='):])\n181|        self.fail('release wrote no dist= workflow output')\n182|\n183|    def assert_no_packaging_or_output(self, result):\n184|        self.assertNotEqual(result.returncode, 0)\n185|        if self.codesign_log.exists():\n186|            self.assertNotIn('--sign ', self.codesign_log.read_text())\n187|        if self.github_output.exists():\n188|            self.assertNotIn('dist=', self.github_output.read_text())\n189|        packaged = [p for p in (self.root / '.temp').glob('release-*')\n190|                    if p.name != 'tools']\n191|        self.assertEqual(packaged, [])\n192|\n193|    def assert_no_publish_output(self, result):\n194|        \"\"\"Late refusal: packaging may exist, but nothing publishable escapes.\"\"\"\n195|        self.assertNotEqual(result.returncode, 0)\n196|        if self.github_output.exists():\n197|            self.assertNotIn('dist=', self.github_output.read_text())\n198|        sums = list((self.root / '.temp').glob('release-*/dist/SHA256SUMS'))\n199|        self.assertEqual(sums, [])\n200|\n201|\n202|class ReleasePackagingTests(ReleasePackagingHarness):\n203|    def test_release_signs_dmg_with_resolved_team_identity(self):\n204|        r = self.run_release(VALID_OUTPUT, attempt=1)\n205|        self.assertEqual(r.returncode, 0, r.stderr[-2000:])\n206|        self.assertIn(f'--sign {EXPECTED_SHA}', self.codesign_log.read_text())\n207|        dist = self.dist_of()\n208|        for name in ('RunnerControl.dmg', 'appcast.xml', 'SHA256SUMS'):\n209|            self.assertTrue((dist / name).exists(), name)\n210|\n211|    def test_retry_attempt_signs_with_resolved_team_identity(self):\n212|        r = self.run_release(VALID_OUTPUT, attempt=2)\n213|        self.assertEqual(r.returncode, 0, r.stderr[-2000:])\n214|        self.assertIn(f'--sign {EXPECTED_SHA}', self.codesign_log.read_text())\n215|        dist = self.dist_of()\n216|        for name in ('RunnerControl.dmg', 'appcast.xml', 'SHA256SUMS'):\n217|            self.assertTrue((dist / name).exists(), name)\n218|\n219|    def test_zero_identities_prevents_packaging_and_output(self):\n220|        r = self.run_release(OTHER_LINES, attempt=1)\n221|        self.assert_no_packaging_or_output(r)\n222|\n223|    def test_multiple_identities_prevents_packaging_and_output(self):\n224|        second = TEAM_LINE.replace(EXPECTED_SHA, 'A' * 40).replace('  3)', '  5)')\n225|        r = self.run_release(VALID_OUTPUT + '\\n' + second, attempt=1)\n226|        self.assert_no_packaging_or_output(r)\n227|\n228|    def test_tag_marketing_mismatch_prevents_packaging(self):\n229|        r = self.run_release(VALID_OUTPUT, attempt=1, tag='v9.9.9')\n230|        self.assert_no_packaging_or_output(r)\n231|        self.assertIn('marketing_version', r.stderr)\n232|\n233|    def test_invalid_run_number_prevents_packaging(self):\n234|        r = self.run_release(VALID_OUTPUT, attempt=1, run_number=0)\n235|        self.assert_no_packaging_or_output(r)\n236|        self.assertIn('run/attempt', r.stderr)\n237|\n238|    def test_boundary_run_attempt_accepted(self):\n239|        r = self.run_release(VALID_OUTPUT, attempt=99, run_number=9899)\n240|        self.assertEqual(r.returncode, 0, r.stderr[-2000:])\n241|        self.assertIn(f'--sign {EXPECTED_SHA}', self.codesign_log.read_text())\n242|        dist = self.dist_of()\n243|        for name in ('RunnerControl.dmg', 'appcast.xml', 'SHA256SUMS'):\n244|            self.assertTrue((dist / name).exists(), name)\n245|\n246|    def test_notarization_rejection_prevents_publish(self):\n247|        r = self.run_release(VALID_OUTPUT, attempt=1, notary_status='Rejected')\n248|        self.assert_no_publish_output(r)\n249|        self.assertIn('did not accept', r.stderr)\n250|        if self.codesign_log.exists():\n251|            self.assertNotIn('--sign ', self.codesign_log.read_text())\n252|\n253|    def test_codesign_team_mismatch_prevents_packaging(self):\n254|        r = self.run_release(VALID_OUTPUT, attempt=1, codesign_team='OTHERTEAM1')\n255|        self.assert_no_publish_output(r)\n256|        if self.codesign_log.exists():\n257|            self.assertNotIn('--sign ', self.codesign_log.read_text())\n258|\n259|    def test_appcast_tamper_prevents_publish(self):\n260|        r = self.run_release(VALID_OUTPUT, attempt=1, tamper_appcast=True)\n261|        self.assert_no_publish_output(r)\n262|        self.assertIn('Appcast build does not match', r.stderr)\n263|\n264|    def test_malformed_identity_hash_prevents_signing(self):\n265|        malformed = TEAM_LINE.replace(EXPECTED_SHA, 'X' * 40)\n266|        r = self.run_release(OTHER_LINES + '\\n' + malformed, attempt=1)\n267|        self.assertNotEqual(r.returncode, 0)\n268|        self.assertIn('No Developer ID Application identity', r.stderr)\n269|        if self.codesign_log.exists():\n270|            self.assertNotIn('--sign ', self.codesign_log.read_text())\n271|        if self.github_output.exists():\n272|            self.assertNotIn('dist=', self.github_output.read_text())\n273|\n274|\n275|if __name__ == '__main__':\n276|    unittest.main()","final_result":true}}}
