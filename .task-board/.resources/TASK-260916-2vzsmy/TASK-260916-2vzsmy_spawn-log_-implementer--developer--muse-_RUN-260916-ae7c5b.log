{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5cb","stream":{"kind":"session","id":"01a0a834-2dd6-7302-a20b-bd6ef471e4be"},"sequence":320,"recorded_at":1780531400000635,"record_type":"event","durability":"durable","causation_id":"f40cada4-f145-4b44-bc35-1e9f8e45782b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f40cada4-f145-4b44-bc35-1e9f8e45782b","run_stream":{"kind":"run","id":"f40cada4-f145-4b44-bc35-1e9f8e45782b"},"task_stream":{"kind":"task","id":"01a0a835-1828-78e1-b481-63b84115d6f2"},"task_id":"01a0a835-1828-78e1-b481-63b84115d6f2","event":{"kind":"output","task_id":"01a0a835-1828-78e1-b481-63b84115d6f2","chunk":"Read text file `Scripts/tests/test_release_workflow.py`.\n1|\"\"\"Release workflow wiring: tag trust, gate order, publish gating.\n2|\n3|Parses .github/workflows/release.yml by step blocks (stdlib only): untrusted\n4|tags are refused before any work, gates precede packaging, packaging precedes\n5|publication, and the publish step keeps default success-only gating so a\n6|failed package can never reach `gh release create`.\n7|\"\"\"\n8|from pathlib import Path\n9|import re\n10|import unittest\n11|\n12|WORKFLOW = Path(__file__).parents[2] / '.github' / 'workflows' / 'release.yml'\n13|ORDER = ['Validate trusted release tag', 'Release prerequisites', 'Unit tests',\n14|         'Build, notarize, staple and sign appcast', 'Publish complete GitHub Release']\n15|\n16|\n17|def blocks(text):\n18|    starts = [m.start() for m in re.finditer(r'^      - ', text, re.M)]\n19|    return [text[s:e] for s, e in zip(starts, starts[1:] + [len(text)])]\n20|\n21|\n22|def block_named(blocks, name):\n23|    found = [b for b in blocks if b.splitlines()[0].endswith(f'- name: {name}')]\n24|    assert len(found) == 1, name\n25|    return found[0]\n26|\n27|\n28|class ReleaseWorkflowTests(unittest.TestCase):\n29|    def test_gates_precede_packaging_precedes_publish(self):\n30|        text = WORKFLOW.read_text()\n31|        positions = [text.index(f'- name: {name}') for name in ORDER]\n32|        self.assertEqual(positions, sorted(positions))\n33|\n34|    def test_only_log_preservation_overrides_success_gating(self):\n35|        gated = set()\n36|        for block in blocks(WORKFLOW.read_text()):\n37|            name = block.splitlines()[0]\n38|            if any(re.match(r'\\s*if\\s*:', line) for line in block.splitlines()[1:]):\n39|                gated.add(name)\n40|        self.assertEqual(len(gated), 1)\n41|        self.assertTrue(next(iter(gated)).endswith('- name: Preserve release logs'))\n42|\n43|    def test_untrusted_tags_refused_before_any_work(self):\n44|        block = block_named(blocks(WORKFLOW.read_text()), 'Validate trusted release tag')\n45|        for token in (r'^v[0-9]+\\.[0-9]+\\.[0-9]+$', 'git rev-parse', 'merge-base --is-ancestor',\n46|                      'gh release view', 'exit 1'):\n47|            self.assertIn(token, block)\n48|\n49|\n50|if __name__ == '__main__':\n51|    unittest.main()","final_result":true}}}
