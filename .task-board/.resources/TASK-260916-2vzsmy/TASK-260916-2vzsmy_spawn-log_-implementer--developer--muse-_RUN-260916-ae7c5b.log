{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7f3","stream":{"kind":"session","id":"01a0a834-2dd6-7302-a20b-bd6ef471e4be"},"sequence":596,"recorded_at":1780531400001187,"record_type":"event","durability":"durable","causation_id":"f40cada4-f145-4b44-bc35-1e9f8e45782b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f40cada4-f145-4b44-bc35-1e9f8e45782b","run_stream":{"kind":"run","id":"f40cada4-f145-4b44-bc35-1e9f8e45782b"},"task_stream":{"kind":"task","id":"01a0a836-67cd-7d51-b983-18e908237ce5"},"task_id":"01a0a836-67cd-7d51-b983-18e908237ce5","event":{"kind":"output","task_id":"01a0a836-67cd-7d51-b983-18e908237ce5","chunk":"{\n  \"chunk_id\": \"exec-15-1\",\n  \"command\": \"which gh; gh --version 2>&1 | head -n 5; gh release view --help 2>&1 | head -n 60\",\n  \"description\": \"Check local gh release help\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"/opt/homebrew/bin/gh\\ngh version 2.37.0 (2023-10-17)\\nhttps://github.com/cli/cli/releases/tag/v2.37.0\\nView information about a GitHub Release.\\n\\nWithout an explicit tag name argument, the latest release in the project\\nis shown.\\n\\nFor more information about output formatting flags, see `gh help formatting`.\\n\\nUSAGE\\n  gh release view [<tag>] [flags]\\n\\nFLAGS\\n  -q, --jq expression     Filter JSON output using a jq expression\\n      --json fields       Output JSON with the specified fields\\n  -t, --template string   Format JSON output using a Go template; see \\\"gh help formatting\\\"\\n  -w, --web               Open the release in the browser\\n\\nINHERITED FLAGS\\n      --help                     Show help for command\\n  -R, --repo [HOST/]OWNER/REPO   Select another repository using the [HOST/]OWNER/REPO format\\n\\nLEARN MORE\\n  Use 'gh <command> <subcommand> --help' for more information about a command.\\n  Read the manual at https://cli.github.com/manual\\n\\n\",\n  \"original_output_bytes\": 941,\n  \"original_output_tokens\": 236,\n  \"truncated\": false\n}","final_result":true}}}
