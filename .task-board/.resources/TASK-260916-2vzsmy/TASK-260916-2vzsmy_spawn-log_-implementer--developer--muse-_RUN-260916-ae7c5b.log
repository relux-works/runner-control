{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5c3","stream":{"kind":"session","id":"01a0a834-2dd6-7302-a20b-bd6ef471e4be"},"sequence":316,"recorded_at":1780531400000627,"record_type":"event","durability":"durable","causation_id":"f40cada4-f145-4b44-bc35-1e9f8e45782b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f40cada4-f145-4b44-bc35-1e9f8e45782b","run_stream":{"kind":"run","id":"f40cada4-f145-4b44-bc35-1e9f8e45782b"},"task_stream":{"kind":"task","id":"01a0a835-17f3-70f3-a8eb-777f4103dfd3"},"task_id":"01a0a835-17f3-70f3-a8eb-777f4103dfd3","event":{"kind":"output","task_id":"01a0a835-17f3-70f3-a8eb-777f4103dfd3","chunk":"Read text file `.github/workflows/release.yml`.\n1|name: Release DMG\n2|on:\n3|  push:\n4|    tags: ['v*']\n5|  workflow_dispatch:\n6|    inputs:\n7|      tag:\n8|        description: Existing vMAJOR.MINOR.PATCH tag on main\n9|        required: true\n10|        type: string\n11|permissions:\n12|  contents: write\n13|concurrency:\n14|  group: runner-control-release\n15|  cancel-in-progress: false\n16|jobs:\n17|  release:\n18|    runs-on: [self-hosted, macOS, ARM64, macbook-iv]\n19|    environment: release\n20|    timeout-minutes: 90\n21|    env:\n22|      RELEASE_TAG: ${{ inputs.tag || github.ref_name }}\n23|      NOTARY_PROFILE: RunnerControl-notary\n24|      GH_TOKEN: ${{ github.token }}\n25|    steps:\n26|      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n27|        with:\n28|          ref: ${{ inputs.tag || github.ref }}\n29|          fetch-depth: 0\n30|      - name: Validate trusted release tag\n31|        shell: bash\n32|        run: |\n33|          [[ \"$RELEASE_TAG\" =~ ^v[0-9]+\\.[0-9]+\\.[0-9]+$ ]]\n34|          test \"$(git rev-parse HEAD)\" = \"$(git rev-parse \"$RELEASE_TAG^{commit}\")\"\n35|          git merge-base --is-ancestor HEAD origin/main\n36|          if gh release view \"$RELEASE_TAG\" >/dev/null 2>&1; then\n37|            echo 'Release already exists. Inspect it before retrying; no published assets are overwritten.' >&2\n38|            exit 1\n39|          fi\n40|      - name: Release prerequisites\n41|        run: ./Scripts/release-preflight.sh\n42|      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n43|        with:\n44|          go-version: '1.25.5'\n45|          cache: false\n46|      - name: Build pinned scaffold generator\n47|        shell: bash\n48|        run: |\n49|          git clone https://github.com/relux-works/skill-ios-app-manager.git \"$RUNNER_TEMP/runner-control-generator-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT\"\n50|          cd \"$RUNNER_TEMP/runner-control-generator-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT\"\n51|          git checkout --detach 755a29538dfe0867671ac4291b016bf42d93a299\n52|          cd tuist-starter\n53|          env -u GOROOT go build -o \"$RUNNER_TEMP/runner-control-ios-app-manager\" ./cmd/ios-app-manager\n54|          echo \"IOS_APP_MANAGER=$RUNNER_TEMP/runner-control-ios-app-manager\" >> \"$GITHUB_ENV\"\n55|      - name: Unit tests\n56|        run: |\n57|          swift test --package-path Packages/RunnerControlCore --scratch-path \"$RUNNER_TEMP/runner-control-release-tests\"\n58|          python3 -m unittest discover -s Scripts/tests -v\n59|      - name: Build, notarize, staple and sign appcast\n60|        id: package\n61|        run: ./Scripts/release.sh\n62|      - name: Publish complete GitHub Release\n63|        env:\n64|          RELEASE_DIST: ${{ steps.package.outputs.dist }}\n65|        shell: bash\n66|        run: |\n67|          gh release create \"$RELEASE_TAG\" --verify-tag --draft --title \"Runner Control $RELEASE_TAG\" --generate-notes\n68|          gh release upload \"$RELEASE_TAG\" \"$RELEASE_DIST/RunnerControl.dmg\" \"$RELEASE_DIST/appcast.xml\" \"$RELEASE_DIST/SHA256SUMS\"\n69|          gh release edit \"$RELEASE_TAG\" --draft=false --latest\n70|      - name: Preserve release logs\n71|        if: always()\n72|        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n73|        with:\n74|          name: release-diagnostics-${{ github.run_id }}-${{ github.run_attempt }}\n75|          path: |\n76|            .temp/release-*/archive.log\n77|            .temp/release-*/export.log\n78|            .temp/release-*/*-notary.json\n79|          if-no-files-found: ignore\n80|          retention-days: 14","final_result":true}}}
