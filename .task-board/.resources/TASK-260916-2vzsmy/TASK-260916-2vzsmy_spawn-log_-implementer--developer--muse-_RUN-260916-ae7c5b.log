{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cabf","stream":{"kind":"session","id":"01a0a834-2dd6-7302-a20b-bd6ef471e4be"},"sequence":954,"recorded_at":1780531400001903,"record_type":"event","durability":"durable","causation_id":"f40cada4-f145-4b44-bc35-1e9f8e45782b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f40cada4-f145-4b44-bc35-1e9f8e45782b","run_stream":{"kind":"run","id":"f40cada4-f145-4b44-bc35-1e9f8e45782b"},"task_stream":{"kind":"task","id":"01a0a837-cf42-7552-8c0f-ffc553bde5e0"},"task_id":"01a0a837-cf42-7552-8c0f-ffc553bde5e0","event":{"kind":"output","task_id":"01a0a837-cf42-7552-8c0f-ffc553bde5e0","chunk":"Read text file `Scripts/tests/test_release_docs.py`.\n1|\"\"\"RELEASING.md states the exact values the release scripts enforce.\n2|\n3|Each test derives the expected value from the enforcing code (not from the\n4|docs) and requires the docs to name it, so doc drift fails the suite. The\n5|run/attempt bound test additionally drives release_metadata.prepare at the\n6|documented limit in both directions, tying docs to code behaviorally.\n7|\"\"\"\n8|import base64\n9|import copy\n10|import importlib.util\n11|from pathlib import Path\n12|import re\n13|import unittest\n14|\n15|REPO = Path(__file__).parents[2]\n16|DOCS = (REPO / 'RELEASING.md').read_text()\n17|\n18|spec = importlib.util.spec_from_file_location('metadata', REPO / 'Scripts' / 'release_metadata.py')\n19|m = importlib.util.module_from_spec(spec)\n20|spec.loader.exec_module(m)\n21|\n22|\n23|def _config():\n24|    return {'marketing_version': '1.1.0', 'bundle_id': 'works.relux.runnercontrol',\n25|            'team_id': '262RZ595FP', 'macos': {'info_plist': {\n26|                'SUFeedURL': m.FEED, 'SUPublicEDKey': base64.b64encode(bytes(32)).decode()}}}\n27|\n28|\n29|class ReleaseDocsTests(unittest.TestCase):\n30|    def test_docs_name_sparkle_tool_pin(self):\n31|        tools = (REPO / 'Scripts' / 'sparkle-tools.sh').read_text()\n32|        version = re.search(r'^version=(\\S+)$', tools, re.M).group(1)\n33|        checksum = re.search(r'^checksum=(\\S+)$', tools, re.M).group(1)\n34|        self.assertIn(version, DOCS)\n35|        self.assertIn(checksum, DOCS)\n36|\n37|    def test_docs_name_signing_team_profile_and_account(self):\n38|        release = (REPO / 'Scripts' / 'release.sh').read_text()\n39|        preflight = (REPO / 'Scripts' / 'release-preflight.sh').read_text()\n40|        teams = set(re.findall(r'DEVELOPMENT_TEAM=(\\w+)', release))\n41|        self.assertTrue(teams)\n42|        for team in teams:\n43|            self.assertIn(team, DOCS)\n44|        profile = re.search(r'NOTARY_PROFILE:-([^}]+)\\}', preflight).group(1)\n45|        self.assertIn(profile, DOCS)\n46|        accounts = set(re.findall(r'--account (\\S+)', release + preflight))\n47|        self.assertTrue(accounts)\n48|        for account in accounts:\n49|            self.assertIn(account, DOCS)\n50|\n51|    def test_docs_name_toolchain_pins(self):\n52|        workflow = (REPO / '.github' / 'workflows' / 'release.yml').read_text()\n53|        go = re.search(r\"go-version: '([^']+)'\", workflow).group(1)\n54|        generator = re.search(r'git checkout --detach (\\S+)', workflow).group(1)\n55|        self.assertIn(go, DOCS)\n56|        self.assertIn(generator, DOCS)\n57|        self.assertIn('Tuist 4.9.0', DOCS)\n58|\n59|    def test_documented_run_attempt_bounds_match_code(self):\n60|        max_run = int(re.search(r'run 1\\.\\.(\\d+)', DOCS).group(1))\n61|        max_attempt = int(re.search(r'attempt 1\\.\\.(\\d+)', DOCS).group(1))\n62|        got = m.prepare(copy.deepcopy(_config()), 'v1.1.0', max_run, max_attempt)['project_version']\n63|        self.assertEqual(got, f'{100 + max_run}.{max_attempt}')\n64|        with self.assertRaises(ValueError):\n65|            m.prepare(copy.deepcopy(_config()), 'v1.1.0', max_run + 1, 1)\n66|        with self.assertRaises(ValueError):\n67|            m.prepare(copy.deepcopy(_config()), 'v1.1.0', 1, max_attempt + 1)\n68|\n69|    def test_docs_contain_no_secret_material(self):\n70|        for name in ('RELEASING.md', 'README.md'):\n71|            text = (REPO / name).read_text()\n72|            self.assertNotRegex(text, r'BEGIN [A-Z ]*PRIVATE')\n73|            self.assertNotRegex(text, r'BEGIN CERTIFICATE')\n74|            self.assertNotRegex(text, r'\\b[A-F0-9]{40}\\b')\n75|\n76|\n77|if __name__ == '__main__':\n78|    unittest.main()","final_result":true}}}
