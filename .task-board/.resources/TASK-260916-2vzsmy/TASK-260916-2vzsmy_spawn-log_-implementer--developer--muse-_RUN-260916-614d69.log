{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c633","stream":{"kind":"session","id":"01a0a842-7ca1-71f1-86b1-b6bbe1bc6bac"},"sequence":372,"recorded_at":1780531400000739,"record_type":"event","durability":"durable","causation_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","payload_type":"task.lifecycle.status","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","run_stream":{"kind":"run","id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10"},"task_stream":{"kind":"task","id":"01a0a843-4fd4-7401-b3d5-7f52b7a84f13"},"task_id":"01a0a843-4fd4-7401-b3d5-7f52b7a84f13","event":{"kind":"status","task_id":"01a0a843-4fd4-7401-b3d5-7f52b7a84f13","message":"tool action serialized: parallel eligibility not proven"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c635","stream":{"kind":"session","id":"01a0a842-7ca1-71f1-86b1-b6bbe1bc6bac"},"sequence":373,"recorded_at":1780531400000741,"record_type":"event","durability":"durable","causation_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","run_stream":{"kind":"run","id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10"},"task_stream":{"kind":"task","id":"01a0a843-4fd4-7401-b3d5-7f52b7a84f13"},"task_id":"01a0a843-4fd4-7401-b3d5-7f52b7a84f13","event":{"kind":"output","task_id":"01a0a843-4fd4-7401-b3d5-7f52b7a84f13","chunk":"{\n  \"chunk_id\": \"exec-13-1\",\n  \"command\": \"ls -R Scripts/; echo \\\"---\\\"; cat Scripts/release-preflight.sh | head -n 80; echo \\\"===\\\"; git diff --stat; echo \\\"===\\\"; git status --short\",\n  \"description\": \"List scripts and diff status\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"__pycache__\\nbuild.sh\\nrelease-preflight.sh\\nrelease.sh\\nrelease_metadata.py\\nsparkle-tools.sh\\ntests\\nvalidate-release-tag.sh\\n\\nScripts//__pycache__:\\nrelease_metadata.cpython-311.pyc\\n\\nScripts//tests:\\n__pycache__\\ntest_release_docs.py\\ntest_release_metadata.py\\ntest_release_packaging.py\\ntest_release_preflight.py\\ntest_release_workflow.py\\n\\nScripts//tests/__pycache__:\\ntest_release_docs.cpython-311.pyc\\ntest_release_metadata.cpython-311.pyc\\ntest_release_packaging.cpython-311.pyc\\ntest_release_preflight.cpython-311.pyc\\ntest_release_workflow.cpython-311.pyc\\n---\\n#!/bin/bash\\nset -euo pipefail\\nfor tool in xcodebuild xcrun codesign security hdiutil tuist gh python3; do\\n  command -v \\\"$tool\\\" >/dev/null || { echo \\\"Missing release tool: $tool\\\" >&2; exit 1; }\\ndone\\nidentity_out=\\\"$(mktemp)\\\"\\nidentity_err=\\\"$(mktemp)\\\"\\nif ! security find-identity -v -p codesigning >\\\"$identity_out\\\" 2>\\\"$identity_err\\\"; then\\n  echo 'Could not read signing identities; the result is unknown, not missing.' >&2\\n  head -n 5 \\\"$identity_err\\\" >&2 || true\\n  rm -f \\\"$identity_out\\\" \\\"$identity_err\\\"\\n  exit 1\\nfi\\nidentities=\\\"$(grep -E 'Developer ID Application:.*\\\\(262RZ595FP\\\\)' \\\"$identity_out\\\" || true)\\\"\\nrm -f \\\"$identity_out\\\" \\\"$identity_err\\\"\\nif [ -z \\\"$identities\\\" ]; then\\n  echo 'Missing Developer ID Application identity with private key for team 262RZ595FP.' >&2\\n  echo 'An Account Holder must issue it; Apple Development or another team cannot be substituted.' >&2\\n  exit 1\\nfi\\nif [ \\\"$(printf '%s\\\\n' \\\"$identities\\\" | grep -c .)\\\" -gt 1 ]; then\\n  echo 'Multiple Developer ID Application identities for team 262RZ595FP; remove the stale certificate so release signing is unambiguous.' >&2\\n  exit 1\\nfi\\nprofile=\\\"${NOTARY_PROFILE:-RunnerControl-notary}\\\"\\nhistory_err=\\\"$(mktemp)\\\"\\nif ! xcrun notarytool history --keychain-profile \\\"$profile\\\" --output-format json >/dev/null 2>\\\"$history_err\\\"; then\\n  if grep -q 'keychainLocked' \\\"$history_err\\\"; then\\n    echo \\\"The login keychain is locked in this session, so notarytool profile '$profile' cannot be read.\\\" >&2\\n    echo 'Unlock the login keychain on macbook-iv (console login as the runner user) and re-run Release DMG via workflow_dispatch with the existing tag. Credentials are never printed or exported.' >&2\\n  elif grep -q 'No Keychain password item found for profile' \\\"$history_err\\\"; then\\n    echo \\\"notarytool profile '$profile' is missing from the login keychain.\\\" >&2\\n    echo \\\"Recreate it locally with 'xcrun notarytool store-credentials' (see RELEASING.md), then re-run Release DMG via workflow_dispatch with the existing tag.\\\" >&2\\n  else\\n    echo \\\"notarytool history failed for profile '$profile':\\\" >&2\\n    head -n 5 \\\"$history_err\\\" >&2 || true\\n  fi\\n  rm -f \\\"$history_err\\\"\\n  exit 1\\nfi\\nrm -f \\\"$history_err\\\"\\nroot=\\\"$(cd \\\"$(dirname \\\"$0\\\")/..\\\" && pwd)\\\"\\ncd \\\"$root\\\"\\nsparkle_bin=\\\"$(\\\"$root/Scripts/sparkle-tools.sh\\\")\\\"\\nactual=\\\"$(\\\"$sparkle_bin/generate_keys\\\" --account works.relux.runnercontrol -p)\\\"\\nexpected=\\\"$(python3 -c 'import json; print(json.load(open(\\\"ios-app-manager.json\\\"))[\\\"macos\\\"][\\\"info_plist\\\"][\\\"SUPublicEDKey\\\"])')\\\"\\n[ \\\"$actual\\\" = \\\"$expected\\\" ] || { echo 'Sparkle signing key is missing or does not match the app public key.' >&2; exit 1; }\\nprintf \\\"Release prerequisites verified (team 262RZ595FP, notary profile '%s').\\\\n\\\" \\\"$profile\\\"\\n===\\n .github/workflows/release.yml           | 10 +----\\n RELEASING.md                            | 39 ++++++++++++++---\\n Scripts/tests/test_release_metadata.py  | 71 +++++++++++++++++++++++++++++-\\n Scripts/tests/test_release_packaging.py | 77 ++++++++++++++++++++++++++++++---\\n Scripts/tests/test_release_preflight.py | 35 +++++++++++++++\\n 5 files changed, 211 insertions(+), 21 deletions(-)\\n===\\n M .github/workflows/release.yml\\n M RELEASING.md\\n M Scripts/tests/test_release_metadata.py\\n M Scripts/tests/test_release_packaging.py\\n M Scripts/tests/test_release_preflight.py\\n?? Scripts/tests/test_release_docs.py\\n?? Scripts/tests/test_release_workflow.py\\n?? Scripts/validate-release-tag.sh\\n\",\n  \"original_output_bytes\": 3915,\n  \"original_output_tokens\": 979,\n  \"truncated\": false\n}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c637","stream":{"kind":"session","id":"01a0a842-7ca1-71f1-86b1-b6bbe1bc6bac"},"sequence":374,"recorded_at":1780531400000743,"record_type":"event","durability":"durable","causation_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","run_stream":{"kind":"run","id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10"},"task_stream":{"kind":"task","id":"01a0a843-4fd4-7401-b3d5-7f52b7a84f13"},"task_id":"01a0a843-4fd4-7401-b3d5-7f52b7a84f13","event":{"kind":"completed","task_id":"01a0a843-4fd4-7401-b3d5-7f52b7a84f13"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c639","stream":{"kind":"session","id":"01a0a842-7ca1-71f1-86b1-b6bbe1bc6bac"},"sequence":375,"recorded_at":1780531400000745,"record_type":"event","durability":"durable","causation_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","run_stream":{"kind":"run","id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10"},"call_id":"call_01a0a84349a6764693959add587dcd92","text":"Read text file `Scripts/tests/test_release_docs.py`.\n1|\"\"\"RELEASING.md states the exact values the release scripts enforce.\n2|\n3|Each test derives the expected value from the enforcing code (not from the\n4|docs) and requires the docs to name it, so doc drift fails the suite. The\n5|run/attempt bound test additionally drives release_metadata.prepare at the\n6|documented limit in both directions, tying docs to code behaviorally.\n7|\"\"\"\n8|import base64\n9|import copy\n10|import importlib.util\n11|from pathlib import Path\n12|import re\n13|import unittest\n14|\n15|REPO = Path(__file__).parents[2]\n16|DOCS = (REPO / 'RELEASING.md').read_text()\n17|\n18|spec = importlib.util.spec_from_file_location('metadata', REPO / 'Scripts' / 'release_metadata.py')\n19|m = importlib.util.module_from_spec(spec)\n20|spec.loader.exec_module(m)\n21|\n22|\n23|def _config():\n24|    return {'marketing_version': '1.1.0', 'bundle_id': 'works.relux.runnercontrol',\n25|            'team_id': '262RZ595FP', 'macos': {'info_plist': {\n26|                'SUFeedURL': m.FEED, 'SUPublicEDKey': base64.b64encode(bytes(32)).decode()}}}\n27|\n28|\n29|class ReleaseDocsTests(unittest.TestCase):\n30|    def test_docs_name_sparkle_tool_pin(self):\n31|        tools = (REPO / 'Scripts' / 'sparkle-tools.sh').read_text()\n32|        version = re.search(r'^version=(\\S+)$', tools, re.M).group(1)\n33|        checksum = re.search(r'^checksum=(\\S+)$', tools, re.M).group(1)\n34|        self.assertIn(version, DOCS)\n35|        self.assertIn(checksum, DOCS)\n36|\n37|    def test_docs_name_signing_team_profile_and_account(self):\n38|        release = (REPO / 'Scripts' / 'release.sh').read_text()\n39|        preflight = (REPO / 'Scripts' / 'release-preflight.sh').read_text()\n40|        teams = set(re.findall(r'DEVELOPMENT_TEAM=(\\w+)', release))\n41|        self.assertTrue(teams)\n42|        for team in teams:\n43|            self.assertIn(team, DOCS)\n44|        profile = re.search(r'NOTARY_PROFILE:-([^}]+)\\}', preflight).group(1)\n45|        self.assertIn(profile, DOCS)\n46|        accounts = set(re.findall(r'--account (\\S+)', release + preflight))\n47|        self.assertTrue(accounts)\n48|        for account in accounts:\n49|            self.assertIn(account, DOCS)\n50|\n51|    def test_docs_name_toolchain_pins(self):\n52|        workflow = (REPO / '.github' / 'workflows' / 'release.yml').read_text()\n53|        go = re.search(r\"go-version: '([^']+)'\", workflow).group(1)\n54|        generator = re.search(r'git checkout --detach (\\S+)', workflow).group(1)\n55|        self.assertIn(go, DOCS)\n56|        self.assertIn(generator, DOCS)\n57|        self.assertIn('Tuist 4.9.0', DOCS)\n58|\n59|    def test_documented_run_attempt_bounds_match_code(self):\n60|        max_run = int(re.search(r'run 1\\.\\.(\\d+)', DOCS).group(1))\n61|        max_attempt = int(re.search(r'attempt 1\\.\\.(\\d+)', DOCS).group(1))\n62|        got = m.prepare(copy.deepcopy(_config()), 'v1.1.0', max_run, max_attempt)['project_version']\n63|        self.assertEqual(got, f'{100 + max_run}.{max_attempt}')\n64|        with self.assertRaises(ValueError):\n65|            m.prepare(copy.deepcopy(_config()), 'v1.1.0', max_run + 1, 1)\n66|        with self.assertRaises(ValueError):\n67|            m.prepare(copy.deepcopy(_config()), 'v1.1.0', 1, max_attempt + 1)\n68|\n69|    def test_docs_state_notarization_gates_and_diagnostic_handling(self):\n70|        release = (REPO / 'Scripts' / 'release.sh').read_text()\n71|        self.assertGreaterEqual(len(re.findall(r'^notarize ', release, re.M)), 2,\n72|                                'release.sh must notarize app ZIP and DMG separately')\n73|        self.assertIn(\"!= 'Accepted'\", release)\n74|        self.assertGreaterEqual(len(re.findall(r'stapler validate', release)), 2,\n75|                                'each artifact must pass staple validation')\n76|        diagnostic = '6d537548-8c24-48ea-89b5-7ebb2dc959d5'\n77|        self.assertIn(diagnostic, DOCS)\n78|        for phrase in ('its own `Accepted`', 'stapler staple', 'Do not duplicate',\n79|                       'not a release artifact', 'is authorized',\n80|                       'notarytool info', 'read-only', 'v1.2.0'):\n81|            self.assertIn(phrase, DOCS, phrase)\n82|\n83|    def test_docs_contain_no_secret_material(self):\n84|        for name in ('RELEASING.md', 'README.md'):\n85|            text = (REPO / name).read_text()\n86|            self.assertNotRegex(text, r'BEGIN [A-Z ]*PRIVATE')\n87|            self.assertNotRegex(text, r'BEGIN CERTIFICATE')\n88|            self.assertNotRegex(text, r'\\b[A-F0-9]{40}\\b')\n89|\n90|\n91|if __name__ == '__main__':\n92|    unittest.main()","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c63b","stream":{"kind":"session","id":"01a0a842-7ca1-71f1-86b1-b6bbe1bc6bac"},"sequence":376,"recorded_at":1780531400000747,"record_type":"event","durability":"durable","causation_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","run_stream":{"kind":"run","id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10"},"call_id":"call_01a0a8434ac67694a404887bd0af3245","text":"Read text file `RELEASING.md`.\n1|# Release operations\n2|\n3|## One-time setup on macbook-iv\n4|\n5|The release workflow uses this Mac's manually controlled runner. Enable it in Runner Control before releasing; a disabled runner leaves the workflow queued. Pull requests run unit tests on GitHub-hosted macOS and do not use release credentials.\n6|\n7|Required tools: Xcode, Tuist 4.9.0, GitHub CLI, Python 3. The workflow installs Go 1.25.5 and builds the scaffold generator at a pinned revision. Sparkle tools are downloaded at a pinned version and verified by SHA-256.\n8|\n9|The runner's login Keychain needs:\n10|\n11|- A Developer ID Application certificate **and matching private key** for team `262RZ595FP`. Apple Development and certificates belonging to other teams are rejected.\n12|- A validated notarytool profile named `RunnerControl-notary`.\n13|- The existing Sparkle Ed25519 signing key under account `works.relux.runnercontrol`. Keep a secure backup; losing it prevents updates to installed releases. Do not regenerate it for each release.\n14|\n15|An Apple Account Holder must issue the Developer ID certificate from the supplied CSR. Import the issued certificate together with its matching private key. Use `xcrun notarytool store-credentials` locally with a valid App Store Connect API key, key ID and issuer ID; it validates authorization before saving the profile. Never commit keys, certificates with private keys, or credentials.\n16|\n17|Run `./Scripts/release-preflight.sh` from any directory to verify these prerequisites. Keychain access must work from the runner session without an unattended authorization prompt.\n18|\n19|## Publish\n20|\n21|1. Set `marketing_version` in `ios-app-manager.json` to the intended version and regenerate with the pinned macOS app generator.\n22|2. Commit to `main` and wait for the Tests workflow.\n23|3. Tag that commit `vMAJOR.MINOR.PATCH` and push the tag. Alternatively run **Release DMG** with that existing tag.\n24|4. The workflow tests, archives, exports with Developer ID, notarizes/staples the app and DMG, generates the Sparkle signature, and checks feed metadata.\n25|5. Only after those checks does it create a draft release, upload `RunnerControl.dmg`, `appcast.xml` and `SHA256SUMS`, then publish it as latest. Assets remain in GitHub Releases without the artifact retention deadline.\n26|\n27|Each feed points to its immutable version-specific DMG URL. The application follows the latest release's appcast. Published release assets are never overwritten by the workflow. If uploading fails after draft creation, inspect the draft and remove the incomplete draft before retrying the same run. Diagnostic logs are retained for 14 days.\n28|\n29|Build numbers are derived from the release workflow run number and attempt. Keep this workflow's run counter continuous; do not replace it with a new workflow whose counter starts over without adjusting the build-number scheme.\n30|\n31|## Exact requirements reference\n32|\n33|Every value below is enforced by the named script and covered by `Scripts/tests`. If a value changes, update the script, this section, and the tests together.\n34|\n35|| Requirement | Exact value | Enforced by |\n36||---|---|---|\n37|| Signing identity | Exactly one `Developer ID Application` certificate with private key for team `262RZ595FP`; Apple Development and other teams are refused | `release-preflight.sh`, `release_metadata.py signing-identity`, `release.sh` DMG signing |\n38|| Bundle and team | `works.relux.runnercontrol` / `262RZ595FP` | `release_metadata.py prepare` |\n39|| Release tag | `vMAJOR.MINOR.PATCH`, equal to `marketing_version`, on `main` ancestry at `HEAD`; an existing release refuses the run; unknown `gh` lookup failures refuse instead of passing as absent | `validate-release-tag.sh` (invoked by `release.yml`), `prepare` |\n40|| Build number | `project_version` = `(100 + run).attempt` with run 1..9899 and attempt 1..99 (for example run 1 attempt 1 → `101.1`) | `release_metadata.py prepare` |\n41|| Notary profile | `RunnerControl-notary` in the runner's login keychain, unlocked in the runner session; `notarytool` waits up to 30 minutes per artifact (app ZIP, then DMG), each needs its own `Accepted` plus `stapler staple`/`validate` before publication | `release-preflight.sh`, `release.sh` notarize |\n42|| Sparkle account and feed | Account `works.relux.runnercontrol`; private key must match `SUPublicEDKey`; feed `https://github.com/relux-works/runner-control/releases/latest/download/appcast.xml` | `release-preflight.sh`, `prepare` |\n43|| Sparkle tools | Version `2.10.0`, SHA-256 `c2bf58aa8387266ac179357b1415d6f2635f044da8be41042af32425dae6da0c` | `sparkle-tools.sh` |\n44|| Appcast | Exactly one item; `sparkle:version` = build, `shortVersionString` = marketing version, enclosure URL `https://github.com/relux-works/runner-control/releases/download/<tag>/RunnerControl.dmg`, 64-byte `edSignature`, `length` = DMG bytes, minimum macOS 14 | `release_metadata.py verify` |\n45|| Scaffold generator | `skill-ios-app-manager` at `755a29538dfe0867671ac4291b016bf42d93a299`, built with Go `1.25.5` | `release.yml` |\n46|| Host tools | Xcode, Tuist 4.9.0, GitHub CLI, Python 3, plus `xcodebuild xcrun codesign security hdiutil tuist gh python3` on `PATH` | `release-preflight.sh` |\n47|| Publish order | Preflight → unit tests → package/notarize/verify → draft → upload DMG + appcast + SHA256SUMS → publish as latest; the publish step runs only after a successful package and never overwrites published assets | `release.yml`, `release.sh` |\n48|\n49|## Failure recovery\n50|\n51|Release run 35040921163 (`v1.1.0`) failed in Release prerequisites before any\n52|build or signing: the login keychain was locked in the runner session, so\n53|`notarytool` could not read profile `RunnerControl-notary` (`keychainLocked`).\n54|No draft or published release was created.\n55|\n56|Per coordinator directive, `v1.1.0` is neither retried nor deleted: the tag\n57|stays as-is with no release, and the approved next release is new `v1.2.0`\n58|after product integration. No new tag is created and nothing is published\n59|until product review and coordinator dispatch.\n60|\n61|If a future run reports a locked keychain in Release prerequisites, unlock\n62|the login keychain on macbook-iv with a console login as the runner user (no\n63|credentials are printed or exported), enable the runner in Runner Control,\n64|then run **Release DMG** via workflow_dispatch with the existing tag. Do not\n65|delete or re-push the tag and do not create the release by hand; the workflow\n66|refuses to overwrite published assets. If prerequisites still report a locked\n67|keychain, the runner session has no unlocked login keychain; unlock it and\n68|dispatch again.\n69|\n70|Preflight also fails fast when no Developer ID Application identity for team\n71|`262RZ595FP` is present, when several are present (remove the stale\n72|certificate so signing is unambiguous), when the notarytool profile is missing\n73|(recreate it with `xcrun notarytool store-credentials` as above), when the\n74|Sparkle private key does not match `SUPublicEDKey`, or when signing\n75|identities cannot be read at all (a failed read is reported as unknown,\n76|never as missing or verified).\n77|\n78|Apple notarization waits up to 30 minutes per artifact (app ZIP, then DMG).\n79|Each artifact must receive its own `Accepted` result and pass `stapler staple`\n80|plus `stapler validate` before final publication; `release.sh` enforces this\n81|and only `Accepted` proceeds for each submission. If a wait times out, the\n82|submission ID in the release logs can be inspected read-only with\n83|`xcrun notarytool info <id> --keychain-profile RunnerControl-notary` (status\n84|only); retrying dispatches a new run with a new monotonic build number.\n85|\n86|Diagnostic signing-check submission `6d537548-8c24-48ea-89b5-7ebb2dc959d5`\n87|was `In Progress` at 02:49 UTC. Do not duplicate that test submission and do\n88|not treat it as a release prerequisite: it is not a release artifact and its\n89|state does not gate the next release. Inspect it read-only only if needed\n90|(`xcrun notarytool info 6d537548-8c24-48ea-89b5-7ebb2dc959d5\n91|--keychain-profile RunnerControl-notary`, status only). Submitting the\n92|genuinely new release app ZIP and DMG for `v1.2.0` is authorized and is not\n93|duplication; each must still reach its own `Accepted` and pass staple\n94|verification before the draft is published.\n95|\n96|## Validation status\n97|\n98|Core and release metadata tests pass locally and in GitHub Actions; the Sparkle-enabled app builds successfully. Developer ID signing and the notarytool profile are validated on macbook-iv. The complete notarization and update-install cycle requires the first accepted Apple submission and two published versions. Check GitHub Releases for publication status.","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c63d","stream":{"kind":"session","id":"01a0a842-7ca1-71f1-86b1-b6bbe1bc6bac"},"sequence":377,"recorded_at":1780531400000749,"record_type":"event","durability":"durable","causation_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","run_stream":{"kind":"run","id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10"},"call_id":"call_01a0a8434bf473829c4d8f4bdd7e9d4e","text":"{\n  \"chunk_id\": \"exec-13-1\",\n  \"command\": \"ls -R Scripts/; echo \\\"---\\\"; cat Scripts/release-preflight.sh | head -n 80; echo \\\"===\\\"; git diff --stat; echo \\\"===\\\"; git status --short\",\n  \"description\": \"List scripts and diff status\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"__pycache__\\nbuild.sh\\nrelease-preflight.sh\\nrelease.sh\\nrelease_metadata.py\\nsparkle-tools.sh\\ntests\\nvalidate-release-tag.sh\\n\\nScripts//__pycache__:\\nrelease_metadata.cpython-311.pyc\\n\\nScripts//tests:\\n__pycache__\\ntest_release_docs.py\\ntest_release_metadata.py\\ntest_release_packaging.py\\ntest_release_preflight.py\\ntest_release_workflow.py\\n\\nScripts//tests/__pycache__:\\ntest_release_docs.cpython-311.pyc\\ntest_release_metadata.cpython-311.pyc\\ntest_release_packaging.cpython-311.pyc\\ntest_release_preflight.cpython-311.pyc\\ntest_release_workflow.cpython-311.pyc\\n---\\n#!/bin/bash\\nset -euo pipefail\\nfor tool in xcodebuild xcrun codesign security hdiutil tuist gh python3; do\\n  command -v \\\"$tool\\\" >/dev/null || { echo \\\"Missing release tool: $tool\\\" >&2; exit 1; }\\ndone\\nidentity_out=\\\"$(mktemp)\\\"\\nidentity_err=\\\"$(mktemp)\\\"\\nif ! security find-identity -v -p codesigning >\\\"$identity_out\\\" 2>\\\"$identity_err\\\"; then\\n  echo 'Could not read signing identities; the result is unknown, not missing.' >&2\\n  head -n 5 \\\"$identity_err\\\" >&2 || true\\n  rm -f \\\"$identity_out\\\" \\\"$identity_err\\\"\\n  exit 1\\nfi\\nidentities=\\\"$(grep -E 'Developer ID Application:.*\\\\(262RZ595FP\\\\)' \\\"$identity_out\\\" || true)\\\"\\nrm -f \\\"$identity_out\\\" \\\"$identity_err\\\"\\nif [ -z \\\"$identities\\\" ]; then\\n  echo 'Missing Developer ID Application identity with private key for team 262RZ595FP.' >&2\\n  echo 'An Account Holder must issue it; Apple Development or another team cannot be substituted.' >&2\\n  exit 1\\nfi\\nif [ \\\"$(printf '%s\\\\n' \\\"$identities\\\" | grep -c .)\\\" -gt 1 ]; then\\n  echo 'Multiple Developer ID Application identities for team 262RZ595FP; remove the stale certificate so release signing is unambiguous.' >&2\\n  exit 1\\nfi\\nprofile=\\\"${NOTARY_PROFILE:-RunnerControl-notary}\\\"\\nhistory_err=\\\"$(mktemp)\\\"\\nif ! xcrun notarytool history --keychain-profile \\\"$profile\\\" --output-format json >/dev/null 2>\\\"$history_err\\\"; then\\n  if grep -q 'keychainLocked' \\\"$history_err\\\"; then\\n    echo \\\"The login keychain is locked in this session, so notarytool profile '$profile' cannot be read.\\\" >&2\\n    echo 'Unlock the login keychain on macbook-iv (console login as the runner user) and re-run Release DMG via workflow_dispatch with the existing tag. Credentials are never printed or exported.' >&2\\n  elif grep -q 'No Keychain password item found for profile' \\\"$history_err\\\"; then\\n    echo \\\"notarytool profile '$profile' is missing from the login keychain.\\\" >&2\\n    echo \\\"Recreate it locally with 'xcrun notarytool store-credentials' (see RELEASING.md), then re-run Release DMG via workflow_dispatch with the existing tag.\\\" >&2\\n  else\\n    echo \\\"notarytool history failed for profile '$profile':\\\" >&2\\n    head -n 5 \\\"$history_err\\\" >&2 || true\\n  fi\\n  rm -f \\\"$history_err\\\"\\n  exit 1\\nfi\\nrm -f \\\"$history_err\\\"\\nroot=\\\"$(cd \\\"$(dirname \\\"$0\\\")/..\\\" && pwd)\\\"\\ncd \\\"$root\\\"\\nsparkle_bin=\\\"$(\\\"$root/Scripts/sparkle-tools.sh\\\")\\\"\\nactual=\\\"$(\\\"$sparkle_bin/generate_keys\\\" --account works.relux.runnercontrol -p)\\\"\\nexpected=\\\"$(python3 -c 'import json; print(json.load(open(\\\"ios-app-manager.json\\\"))[\\\"macos\\\"][\\\"info_plist\\\"][\\\"SUPublicEDKey\\\"])')\\\"\\n[ \\\"$actual\\\" = \\\"$expected\\\" ] || { echo 'Sparkle signing key is missing or does not match the app public key.' >&2; exit 1; }\\nprintf \\\"Release prerequisites verified (team 262RZ595FP, notary profile '%s').\\\\n\\\" \\\"$profile\\\"\\n===\\n .github/workflows/release.yml           | 10 +----\\n RELEASING.md                            | 39 ++++++++++++++---\\n Scripts/tests/test_release_metadata.py  | 71 +++++++++++++++++++++++++++++-\\n Scripts/tests/test_release_packaging.py | 77 ++++++++++++++++++++++++++++++---\\n Scripts/tests/test_release_preflight.py | 35 +++++++++++++++\\n 5 files changed, 211 insertions(+), 21 deletions(-)\\n===\\n M .github/workflows/release.yml\\n M RELEASING.md\\n M Scripts/tests/test_release_metadata.py\\n M Scripts/tests/test_release_packaging.py\\n M Scripts/tests/test_release_preflight.py\\n?? Scripts/tests/test_release_docs.py\\n?? Scripts/tests/test_release_workflow.py\\n?? Scripts/validate-release-tag.sh\\n\",\n  \"original_output_bytes\": 3915,\n  \"original_output_tokens\": 979,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
