{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3e9","stream":{"kind":"session","id":"01a0a842-7ca1-71f1-86b1-b6bbe1bc6bac"},"sequence":79,"recorded_at":1780531400000153,"record_type":"event","durability":"durable","causation_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","run_stream":{"kind":"run","id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10"},"call_id":"call_01a0a8429a5e7531a14da0c9cfdfc2c3","text":"Read text file `.github/workflows/release.yml`.\n1|name: Release DMG\n2|on:\n3|  push:\n4|    tags: ['v*']\n5|  workflow_dispatch:\n6|    inputs:\n7|      tag:\n8|        description: Existing vMAJOR.MINOR.PATCH tag on main\n9|        required: true\n10|        type: string\n11|permissions:\n12|  contents: write\n13|concurrency:\n14|  group: runner-control-release\n15|  cancel-in-progress: false\n16|jobs:\n17|  release:\n18|    runs-on: [self-hosted, macOS, ARM64, macbook-iv]\n19|    environment: release\n20|    timeout-minutes: 90\n21|    env:\n22|      RELEASE_TAG: ${{ inputs.tag || github.ref_name }}\n23|      NOTARY_PROFILE: RunnerControl-notary\n24|      GH_TOKEN: ${{ github.token }}\n25|    steps:\n26|      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n27|        with:\n28|          ref: ${{ inputs.tag || github.ref }}\n29|          fetch-depth: 0\n30|      - name: Validate trusted release tag\n31|        run: ./Scripts/validate-release-tag.sh\n32|      - name: Release prerequisites\n33|        run: ./Scripts/release-preflight.sh\n34|      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n35|        with:\n36|          go-version: '1.25.5'\n37|          cache: false\n38|      - name: Build pinned scaffold generator\n39|        shell: bash\n40|        run: |\n41|          git clone https://github.com/relux-works/skill-ios-app-manager.git \"$RUNNER_TEMP/runner-control-generator-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT\"\n42|          cd \"$RUNNER_TEMP/runner-control-generator-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT\"\n43|          git checkout --detach 755a29538dfe0867671ac4291b016bf42d93a299\n44|          cd tuist-starter\n45|          env -u GOROOT go build -o \"$RUNNER_TEMP/runner-control-ios-app-manager\" ./cmd/ios-app-manager\n46|          echo \"IOS_APP_MANAGER=$RUNNER_TEMP/runner-control-ios-app-manager\" >> \"$GITHUB_ENV\"\n47|      - name: Unit tests\n48|        run: |\n49|          swift test --package-path Packages/RunnerControlCore --scratch-path \"$RUNNER_TEMP/runner-control-release-tests\"\n50|          python3 -m unittest discover -s Scripts/tests -v\n51|      - name: Build, notarize, staple and sign appcast\n52|        id: package\n53|        run: ./Scripts/release.sh\n54|      - name: Publish complete GitHub Release\n55|        env:\n56|          RELEASE_DIST: ${{ steps.package.outputs.dist }}\n57|        shell: bash\n58|        run: |\n59|          gh release create \"$RELEASE_TAG\" --verify-tag --draft --title \"Runner Control $RELEASE_TAG\" --generate-notes\n60|          gh release upload \"$RELEASE_TAG\" \"$RELEASE_DIST/RunnerControl.dmg\" \"$RELEASE_DIST/appcast.xml\" \"$RELEASE_DIST/SHA256SUMS\"\n61|          gh release edit \"$RELEASE_TAG\" --draft=false --latest\n62|      - name: Preserve release logs\n63|        if: always()\n64|        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n65|        with:\n66|          name: release-diagnostics-${{ github.run_id }}-${{ github.run_attempt }}\n67|          path: |\n68|            .temp/release-*/archive.log\n69|            .temp/release-*/export.log\n70|            .temp/release-*/*-notary.json\n71|          if-no-files-found: ignore\n72|          retention-days: 14","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3eb","stream":{"kind":"session","id":"01a0a842-7ca1-71f1-86b1-b6bbe1bc6bac"},"sequence":80,"recorded_at":1780531400000155,"record_type":"event","durability":"durable","causation_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","run_stream":{"kind":"run","id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10"},"call_id":"call_01a0a8429b7270a2a41a0798599096f2","text":"Read text file `Scripts/validate-release-tag.sh`.\n1|#!/bin/bash\n2|# Validate that RELEASE_TAG is a trusted release tag before any release work.\n3|# Production entry point invoked by .github/workflows/release.yml (\"Validate\n4|# trusted release tag\"). Refuses malformed tags, HEAD/tag mismatch, non-main\n5|# ancestry, existing releases, and unknown lookup failures (fail closed).\n6|set -euo pipefail\n7|: \"${RELEASE_TAG:?Set RELEASE_TAG to an existing vMAJOR.MINOR.PATCH tag}\"\n8|if ! [[ \"$RELEASE_TAG\" =~ ^v[0-9]+\\.[0-9]+\\.[0-9]+$ ]]; then\n9|  echo \"Refusing untrusted release tag '$RELEASE_TAG': must be vMAJOR.MINOR.PATCH.\" >&2\n10|  exit 1\n11|fi\n12|head_commit=\"$(git rev-parse HEAD)\"\n13|tag_commit=\"$(git rev-parse \"$RELEASE_TAG^{commit}\")\"\n14|if [ \"$head_commit\" != \"$tag_commit\" ]; then\n15|  echo \"Refusing tag $RELEASE_TAG: HEAD ($head_commit) does not match tag commit ($tag_commit).\" >&2\n16|  exit 1\n17|fi\n18|if ! git merge-base --is-ancestor HEAD origin/main; then\n19|  echo \"Refusing tag $RELEASE_TAG: HEAD is not on origin/main ancestry.\" >&2\n20|  exit 1\n21|fi\n22|gh_err=\"$(mktemp)\"\n23|if gh release view \"$RELEASE_TAG\" >/dev/null 2>\"$gh_err\"; then\n24|  echo 'Release already exists. Inspect it before retrying; no published assets are overwritten.' >&2\n25|  rm -f \"$gh_err\"\n26|  exit 1\n27|fi\n28|gh_text=\"$(cat \"$gh_err\" 2>/dev/null || true)\"\n29|rm -f \"$gh_err\"\n30|if printf '%s\\n' \"$gh_text\" | grep -qi 'release not found'; then\n31|  printf 'Trusted release tag %s verified (HEAD matches, on origin/main, no existing release).\\n' \"$RELEASE_TAG\"\n32|  exit 0\n33|fi\n34|echo \"Could not verify release absence for $RELEASE_TAG; refusing to proceed.\" >&2\n35|if [ -n \"$gh_text\" ]; then\n36|  printf '%s\\n' \"$gh_text\" >&2\n37|fi\n38|exit 1","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3ed","stream":{"kind":"session","id":"01a0a842-7ca1-71f1-86b1-b6bbe1bc6bac"},"sequence":81,"recorded_at":1780531400000157,"record_type":"event","durability":"durable","causation_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","run_stream":{"kind":"run","id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10"},"call_id":"call_01a0a8429c8371b1b82b7413bb83500d","text":"Read text file `Scripts/tests/test_release_workflow.py`.\n1|\"\"\"Release workflow wiring and tag-trust behavior.\n2|\n3|The workflow delegates tag trust to the production script\n4|Scripts/validate-release-tag.sh. Wiring tests prove the workflow invokes that\n5|script before any work and preserves gate order and publish gating. Behavioral\n6|tests execute the production script with stubbed git/gh and prove it accepts a\n7|trusted tag while refusing malformed tags, HEAD/tag mismatch, non-main\n8|ancestry, existing releases, and unknown lookup failures (fail closed).\n9|\"\"\"\n10|from pathlib import Path\n11|import os\n12|import re\n13|import shutil\n14|import subprocess\n15|import tempfile\n16|import unittest\n17|\n18|WORKFLOW = Path(__file__).parents[2] / '.github' / 'workflows' / 'release.yml'\n19|SCRIPT = Path(__file__).parents[1] / 'validate-release-tag.sh'\n20|ORDER = ['Validate trusted release tag', 'Release prerequisites', 'Unit tests',\n21|         'Build, notarize, staple and sign appcast', 'Publish complete GitHub Release']\n22|\n23|GIT_STUB = '''#!/bin/bash\n24|printf '%s\\\\n' \"$*\" >> \"$GIT_LOG\"\n25|if [ \"$1\" = \"rev-parse\" ] && [ \"$2\" = \"HEAD\" ]; then\n26|  printf '%s\\\\n' \"${HEAD_SHA:-abc123}\"\n27|  exit 0\n28|fi\n29|if [ \"$1\" = \"rev-parse\" ]; then\n30|  printf '%s\\\\n' \"${TAG_SHA:-abc123}\"\n31|  exit 0\n32|fi\n33|if [ \"$1\" = \"merge-base\" ]; then\n34|  exit \"${ANCESTRY_EXIT:-0}\"\n35|fi\n36|exit 0\n37|'''\n38|\n39|GH_STUB = '''#!/bin/bash\n40|printf '%s\\\\n' \"$*\" >> \"$GH_LOG\"\n41|if [ \"${GH_MODE:-absent}\" = \"exists\" ]; then\n42|  exit 0\n43|fi\n44|if [ -n \"${GH_TEXT:-}\" ]; then\n45|  printf '%s\\\\n' \"$GH_TEXT\" >&2\n46|fi\n47|exit 1\n48|'''\n49|\n50|\n51|def blocks(text):\n52|    starts = [m.start() for m in re.finditer(r'^      - ', text, re.M)]\n53|    return [text[s:e] for s, e in zip(starts, starts[1:] + [len(text)])]\n54|\n55|\n56|def block_named(blocks, name):\n57|    found = [b for b in blocks if b.splitlines()[0].endswith(f'- name: {name}')]\n58|    assert len(found) == 1, name\n59|    return found[0]\n60|\n61|\n62|def write_exe(path, content):\n63|    path.write_text(content)\n64|    path.chmod(0o755)\n65|\n66|\n67|class ReleaseWorkflowTests(unittest.TestCase):\n68|    def test_gates_precede_packaging_precedes_publish(self):\n69|        text = WORKFLOW.read_text()\n70|        positions = [text.index(f'- name: {name}') for name in ORDER]\n71|        self.assertEqual(positions, sorted(positions))\n72|\n73|    def test_only_log_preservation_overrides_success_gating(self):\n74|        gated = set()\n75|        for block in blocks(WORKFLOW.read_text()):\n76|            name = block.splitlines()[0]\n77|            if any(re.match(r'\\s*if\\s*:', line) for line in block.splitlines()[1:]):\n78|                gated.add(name)\n79|        self.assertEqual(len(gated), 1)\n80|        self.assertTrue(next(iter(gated)).endswith('- name: Preserve release logs'))\n81|\n82|    def test_workflow_invokes_trust_script_before_any_work(self):\n83|        block = block_named(blocks(WORKFLOW.read_text()), 'Validate trusted release tag')\n84|        self.assertIn('Scripts/validate-release-tag.sh', block)\n85|        self.assertTrue(SCRIPT.exists(), 'production trust script missing')\n86|        self.assertTrue(os.access(SCRIPT, os.X_OK), 'trust script must be executable')\n87|        body = SCRIPT.read_text()\n88|        for token in (r'^v[0-9]+\\.[0-9]+\\.[0-9]+$', 'git rev-parse',\n89|                      'merge-base --is-ancestor', 'gh release view',\n90|                      'release not found', 'Could not verify'):\n91|            self.assertIn(token, body)\n92|\n93|\n94|class ReleaseTagTrustBehaviorTests(unittest.TestCase):\n95|    def setUp(self):\n96|        self.tmp = tempfile.TemporaryDirectory()\n97|        root = Path(self.tmp.name)\n98|        scripts = root / 'Scripts'\n99|        scripts.mkdir()\n100|        shutil.copy(SCRIPT, scripts / 'validate-release-tag.sh')\n101|        bindir = root / 'bin'\n102|        bindir.mkdir()\n103|        write_exe(bindir / 'git', GIT_STUB)\n104|        write_exe(bindir / 'gh', GH_STUB)\n105|        self.root = root\n106|        self.bindir = bindir\n107|        self.git_log = root / 'git.log'\n108|        self.gh_log = root / 'gh.log'\n109|\n110|    def tearDown(self):\n111|        self.tmp.cleanup()\n112|\n113|    def run_trust(self, tag='v1.2.0', head='abc123def', tag_sha='abc123def',\n114|                  ancestry_exit=0, gh_mode='absent',\n115|                  gh_text='release not found', unset_tag=False):\n116|        env = dict(os.environ)\n117|        env['PATH'] = str(self.bindir) + os.pathsep + env['PATH']\n118|        if unset_tag:\n119|            env.pop('RELEASE_TAG', None)\n120|        else:\n121|            env['RELEASE_TAG'] = tag\n122|        env['HEAD_SHA'] = head\n123|        env['TAG_SHA'] = tag_sha\n124|        env['ANCESTRY_EXIT'] = str(ancestry_exit)\n125|        env['GH_MODE'] = gh_mode\n126|        env['GH_TEXT'] = gh_text\n127|        env['GIT_LOG'] = str(self.git_log)\n128|        env['GH_LOG'] = str(self.gh_log)\n129|        return subprocess.run(['bash', str(self.root / 'Scripts' / 'validate-release-tag.sh')],\n130|                              capture_output=True, text=True, timeout=60,\n131|                              env=env, cwd=self.tmp.name)\n132|\n133|    def test_trusted_tag_accepted(self):\n134|        r = self.run_trust()\n135|        self.assertEqual(r.returncode, 0, r.stderr)\n136|        self.assertIn('Trusted release tag v1.2.0 verified', r.stdout)\n137|\n138|    def test_non_main_ancestry_refused(self):\n139|        r = self.run_trust(ancestry_exit=1)\n140|        self.assertNotEqual(r.returncode, 0)\n141|        self.assertIn('not on origin/main ancestry', r.stderr)\n142|        self.assertNotIn('Trusted release tag', r.stdout)\n143|\n144|    def test_head_tag_mismatch_refused(self):\n145|        r = self.run_trust(head='aaa111', tag_sha='bbb222')\n146|        self.assertNotEqual(r.returncode, 0)\n147|        self.assertIn('does not match tag commit', r.stderr)\n148|        self.assertNotIn('Trusted release tag', r.stdout)\n149|\n150|    def test_malformed_tags_refused_before_any_git_work(self):\n151|        for tag in ['v1.2', 'v1.2.3.4', 'main', '1.2.0', 'v1.2.0 ',\n152|                    'v1.2.0;echo', 'v1.2.0\\nv9.9.9']:\n153|            if self.git_log.exists():\n154|                self.git_log.unlink()\n155|            if self.gh_log.exists():\n156|                self.gh_log.unlink()\n157|            r = self.run_trust(tag=tag)\n158|            self.assertNotEqual(r.returncode, 0, tag)\n159|            self.assertIn('must be vMAJOR.MINOR.PATCH', r.stderr, tag)\n160|            self.assertNotIn('Trusted release tag', r.stdout, tag)\n161|            self.assertFalse(self.git_log.exists(), f'git reached for {tag!r}')\n162|            self.assertFalse(self.gh_log.exists(), f'gh reached for {tag!r}')\n163|\n164|    def test_missing_release_tag_refused(self):\n165|        r = self.run_trust(unset_tag=True)\n166|        self.assertNotEqual(r.returncode, 0)\n167|        self.assertIn('RELEASE_TAG', r.stderr)\n168|        self.assertFalse(self.git_log.exists())\n169|\n170|    def test_existing_release_refused(self):\n171|        r = self.run_trust(gh_mode='exists')\n172|        self.assertNotEqual(r.returncode, 0)\n173|        self.assertIn('Release already exists', r.stderr)\n174|        self.assertNotIn('Trusted release tag', r.stdout)\n175|\n176|    def test_gh_lookup_failure_fails_closed_not_absent(self):\n177|        for text in ['Error: HTTP 500 from the GitHub API',\n178|                     \"GraphQL: Could not resolve to a Repository with the name 'x/y'.\"]:\n179|            r = self.run_trust(gh_text=text)\n180|            self.assertNotEqual(r.returncode, 0, text)\n181|            self.assertIn('Could not verify release absence', r.stderr, text)\n182|            self.assertIn(text.split(':')[0] if ':' in text else text[:20], r.stderr, text)\n183|            self.assertNotIn('Trusted release tag', r.stdout, text)\n184|            self.assertNotIn('Release already exists', r.stderr, text)\n185|\n186|    def test_gh_empty_error_fails_closed(self):\n187|        r = self.run_trust(gh_text='')\n188|        self.assertNotEqual(r.returncode, 0)\n189|        self.assertIn('Could not verify release absence', r.stderr)\n190|        self.assertNotIn('Trusted release tag', r.stdout)\n191|\n192|\n193|if __name__ == '__main__':\n194|    unittest.main()","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3ef","stream":{"kind":"session","id":"01a0a842-7ca1-71f1-86b1-b6bbe1bc6bac"},"sequence":82,"recorded_at":1780531400000159,"record_type":"event","durability":"durable","causation_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10","run_stream":{"kind":"run","id":"f92f1783-f7e6-48cd-8aa0-8db041dd6f10"},"call_id":"call_01a0a8429d72767f8f8b38be999188c9","text":"Read text file `Scripts/tests/test_release_metadata.py`.\n1|import base64\n2|import copy\n3|import importlib.util\n4|from pathlib import Path\n5|import tempfile\n6|import unittest\n7|\n8|spec = importlib.util.spec_from_file_location('metadata', Path(__file__).parents[1] / 'release_metadata.py')\n9|m = importlib.util.module_from_spec(spec)\n10|spec.loader.exec_module(m)\n11|\n12|class ReleaseMetadataTests(unittest.TestCase):\n13|    def setUp(self):\n14|        self.config = {'marketing_version': '1.1.0', 'bundle_id': 'works.relux.runnercontrol',\n15|                       'team_id': '262RZ595FP', 'macos': {'info_plist': {\n16|                           'SUFeedURL': m.FEED, 'SUPublicEDKey': base64.b64encode(bytes(32)).decode()}}}\n17|    def test_builds_increase_between_attempts_and_runs(self):\n18|        values = [m.prepare(copy.deepcopy(self.config), 'v1.1.0', r, a)['project_version']\n19|                  for r, a in [(1, 1), (1, 2), (2, 1)]]\n20|        self.assertEqual(values, ['101.1', '101.2', '102.1'])\n21|    def test_rejects_wrong_tag_or_identity(self):\n22|        for tag in ['v1.0.0', 'main', 'v1.1.0;echo', 'v1.2', 'v1.2.3.4', '1.1.0', 'v1.1.0 ']:\n23|            with self.assertRaises(ValueError): m.prepare(copy.deepcopy(self.config), tag, 1, 1)\n24|        self.config['team_id'] = 'OTHERTEAM'\n25|        with self.assertRaises(ValueError): m.prepare(self.config, 'v1.1.0', 1, 1)\n26|    def test_rejects_short_tag_even_when_marketing_matches(self):\n27|        config = copy.deepcopy(self.config)\n28|        config['marketing_version'] = '1.2'\n29|        with self.assertRaises(ValueError): m.prepare(config, 'v1.2', 1, 1)\n30|    def test_rejects_invalid_run_attempt_bounds(self):\n31|        for run, attempt in [(0, 1), (9900, 1), (10**6, 1), (1, 0), (1, 100), (1, 10**3)]:\n32|            with self.assertRaises(ValueError):\n33|                m.prepare(copy.deepcopy(self.config), 'v1.1.0', run, attempt)\n34|    def test_accepts_run_attempt_at_exact_limits(self):\n35|        lo = m.prepare(copy.deepcopy(self.config), 'v1.1.0', 1, 1)['project_version']\n36|        hi = m.prepare(copy.deepcopy(self.config), 'v1.1.0', 9899, 99)['project_version']\n37|        self.assertEqual((lo, hi), ('101.1', '9999.99'))\n38|    def test_rejects_bad_sparkle_pubkey(self):\n39|        for raw in (bytes(31), bytes(33), bytes(64)):\n40|            bad = copy.deepcopy(self.config)\n41|            bad['macos']['info_plist']['SUPublicEDKey'] = base64.b64encode(raw).decode()\n42|            with self.assertRaises(ValueError): m.prepare(bad, 'v1.1.0', 1, 1)\n43|        bad = copy.deepcopy(self.config)\n44|        bad['macos']['info_plist']['SUPublicEDKey'] = '!!!not-base64!!!'\n45|        with self.assertRaises(ValueError): m.prepare(bad, 'v1.1.0', 1, 1)\n46|    def test_rejects_bundle_id_mismatch(self):\n47|        bad = copy.deepcopy(self.config)\n48|        bad['bundle_id'] = 'works.relux.runnercontrol.evil'\n49|        with self.assertRaises(ValueError): m.prepare(bad, 'v1.1.0', 1, 1)\n50|    def test_rejects_wrong_feed(self):\n51|        self.config['macos']['info_plist']['SUFeedURL'] = 'https://example.org/feed'\n52|        with self.assertRaises(ValueError): m.prepare(self.config, 'v1.1.0', 1, 1)\n53|    def test_appcast_archive_binding(self):\n54|        with tempfile.TemporaryDirectory() as d:\n55|            dmg = Path(d) / 'RunnerControl.dmg'; dmg.write_bytes(b'archive')\n56|            feed = Path(d) / 'appcast.xml'\n57|            xml = f'''<rss xmlns:sparkle=\"{m.NS[1:-1]}\"><channel><item>\n58|              <sparkle:version>101.1</sparkle:version><sparkle:shortVersionString>1.1.0</sparkle:shortVersionString>\n59|              <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>\n60|              <enclosure url=\"https://github.com/{m.REPO}/releases/download/v1.1.0/RunnerControl.dmg\"\n61|              length=\"7\" sparkle:edSignature=\"{base64.b64encode(bytes(64)).decode()}\"/>\n62|              </item></channel></rss>'''\n63|            feed.write_text(xml)\n64|            m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')\n65|            for bad in [xml.replace('length=\"7\"', 'length=\"8\"'), xml.replace('/v1.1.0/', '/v9.0.0/'),\n66|                        xml.replace('101.1', '100.1'), xml.replace('14.0', '13.0')]:\n67|                feed.write_text(bad)\n68|                with self.assertRaises(ValueError): m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')\n69|    def test_rejects_short_version_mismatch(self):\n70|        with tempfile.TemporaryDirectory() as d:\n71|            dmg = Path(d) / 'RunnerControl.dmg'; dmg.write_bytes(b'archive')\n72|            feed = Path(d) / 'appcast.xml'\n73|            feed.write_text(_appcast(dmg, short='9.9.9'))\n74|            with self.assertRaises(ValueError): m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')\n75|    def test_rejects_wrong_item_count(self):\n76|        with tempfile.TemporaryDirectory() as d:\n77|            dmg = Path(d) / 'RunnerControl.dmg'; dmg.write_bytes(b'archive')\n78|            feed = Path(d) / 'appcast.xml'\n79|            feed.write_text(_appcast(dmg, items=0))\n80|            with self.assertRaises(ValueError): m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')\n81|            feed.write_text(_appcast(dmg, items=2))\n82|            with self.assertRaises(ValueError): m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')\n83|    def test_rejects_bad_signature(self):\n84|        with tempfile.TemporaryDirectory() as d:\n85|            dmg = Path(d) / 'RunnerControl.dmg'; dmg.write_bytes(b'archive')\n86|            feed = Path(d) / 'appcast.xml'\n87|            for sig in ['', base64.b64encode(bytes(32)).decode(), '!!!not-base64!!!']:\n88|                feed.write_text(_appcast(dmg, sig=sig))\n89|                with self.assertRaises(ValueError): m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')\n90|    def test_rejects_missing_enclosure_and_minimum(self):\n91|        with tempfile.TemporaryDirectory() as d:\n92|            dmg = Path(d) / 'RunnerControl.dmg'; dmg.write_bytes(b'archive')\n93|            feed = Path(d) / 'appcast.xml'\n94|            feed.write_text(_appcast(dmg, enclosure=False))\n95|            with self.assertRaises(ValueError): m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')\n96|            feed.write_text(_appcast(dmg, minimum=None))\n97|            with self.assertRaises(ValueError): m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')\n98|    def test_malformed_appcast_fails_closed(self):\n99|        with tempfile.TemporaryDirectory() as d:\n100|            dmg = Path(d) / 'RunnerControl.dmg'; dmg.write_bytes(b'archive')\n101|            feed = Path(d) / 'appcast.xml'; feed.write_text('<rss><channel><item>')\n102|            import xml.etree.ElementTree as ET\n103|            with self.assertRaises(ET.ParseError): m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')\n104|\n105|\n106|def _appcast(dmg, short='1.1.0', build='101.1', sig=None, items=1, enclosure=True, minimum='14.0'):\n107|    sig = base64.b64encode(bytes(64)).decode() if sig is None else sig\n108|    enc = (f'<enclosure url=\"https://github.com/{m.REPO}/releases/download/v1.1.0/RunnerControl.dmg\" '\n109|           f'length=\"{dmg.stat().st_size}\" sparkle:edSignature=\"{sig}\"/>') if enclosure else ''\n110|    mintag = f'<sparkle:minimumSystemVersion>{minimum}</sparkle:minimumSystemVersion>' if minimum else ''\n111|    item = (f'<item><sparkle:version>{build}</sparkle:version>'\n112|            f'<sparkle:shortVersionString>{short}</sparkle:shortVersionString>{mintag}{enc}</item>')\n113|    return (f'<rss xmlns:sparkle=\"{m.NS[1:-1]}\"><channel>' + item * items + '</channel></rss>')\n114|\n115|TEAM = '262RZ595FP'\n116|EXPECTED_SHA = '267D90FC976A48CF830BE7F41AE612999E025054'\n117|FIND_IDENTITY = (\n118|    '  1) 7FB8D981868F2637B75DFD098A1F87E0CC11158D \"Apple Development: Ivan Oparin (45W9YW7M6V)\"\\n'\n119|    '  2) 08EF92AE3835F98861F51E625FAA9B6900A075C7 \"Apple Development: Ivan Oparin (FSPBF3QRXT)\"\\n'\n120|    f'  3) {EXPECTED_SHA} \"Developer ID Application: Relux Works, LLC ({TEAM})\"\\n'\n121|    '  4) C8448515B5871071F90EB0168A79DCD35E7CA9FE \"Developer ID Application: SKL VC DMCC (4Y4UJAT8QR)\"\\n'\n122|    '     4 valid identities found\\n')\n123|\n124|class SigningIdentityTests(unittest.TestCase):\n125|    def test_returns_team_identity_ignoring_other_teams(self):\n126|        self.assertEqual(m.resolve_signing_identity(FIND_IDENTITY, TEAM), EXPECTED_SHA)\n127|    def test_rejects_missing_team_identity(self):\n128|        only_other = '\\n'.join(l for l in FIND_IDENTITY.splitlines() if TEAM not in l)\n129|        with self.assertRaises(ValueError): m.resolve_signing_identity(only_other, TEAM)\n130|    def test_rejects_apple_development_only(self):\n131|        dev_only = '\\n'.join(l for l in FIND_IDENTITY.splitlines() if 'Apple Development' in l)\n132|        with self.assertRaises(ValueError): m.resolve_signing_identity(dev_only, TEAM)\n133|    def test_rejects_same_team_apple_development(self):\n134|        same_team_dev = FIND_IDENTITY.splitlines()[0].replace('(45W9YW7M6V)', f'({TEAM})')\n135|        with self.assertRaises(ValueError): m.resolve_signing_identity(same_team_dev, TEAM)\n136|    def test_rejects_near_match_team(self):\n137|        near = FIND_IDENTITY.replace(f'({TEAM})', '(262RZ595FX)')\n138|        with self.assertRaises(ValueError): m.resolve_signing_identity(near, TEAM)\n139|    def test_rejects_multiple_team_identities(self):\n140|        extra = FIND_IDENTITY.replace('  4) C8448515B5871071F90EB0168A79DCD35E7CA9FE \"Developer ID Application: SKL VC DMCC (4Y4UJAT8QR)\"',\n141|                                      f'  4) AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA \"Developer ID Application: Relux Works, LLC ({TEAM})\"')\n142|        with self.assertRaises(ValueError): m.resolve_signing_identity(extra, TEAM)\n143|\n144|class ReleaseWiringTests(unittest.TestCase):\n145|    def test_release_signs_dmg_with_resolved_team_identity(self):\n146|        lines = (Path(__file__).parents[1] / 'release.sh').read_text().splitlines()\n147|        live = [l for l in lines if not l.lstrip().startswith('#')]\n148|        self.assertTrue(any('release_metadata.py signing-identity' in l and '--team 262RZ595FP' in l for l in live),\n149|                        'release.sh must resolve the DMG signing identity through release_metadata.py signing-identity')","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
