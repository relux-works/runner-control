ted_raw=\\\\\\\"in-progress\\\\\\\", status=development)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"publish_context\\\":{\\\"description\\\":\\\"Publish a completed building context as ready after successful register-time classification and transcript verification\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"CTX identifier\\\",\\\"required\\\":true},{\\\"name\\\":\\\"expected_revision\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Observed record revision\\\",\\\"required\\\":true},{\\\"name\\\":\\\"transcript\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Client-local provider transcript path verified before publication; never read by board-server\\\",\\\"required\\\":true},{\\\"name\\\":\\\"secret_class\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Classification result; may elevate but never downgrade\\\",\\\"enum\\\":[\\\"unrestricted\\\",\\\"restricted\\\"]},{\\\"name\\\":\\\"expires_at\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"RFC3339 retention deadline\\\"}],\\\"examples\\\":[\\\"publish_context(CTX-260728-a1b2c3, expected_revision=1, transcript=\\\\\\\"./.temp/run/transcript.jsonl\\\\\\\")\\\",\\\"publish_context(CTX-260728-a1b2c3, expected_revision=1, transcript=\\\\\\\"./.temp/run/transcript.jsonl\\\\\\\", secret_class=restricted)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"reclassify_context\\\":{\\\"description\\\":\\\"Quarantine a misclassified context's payload and retire it instead of relabeling it\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"CTX identifier\\\",\\\"required\\\":true},\\n[tool output bounded: strategy=head, original_bytes=65342, visible_bytes=40000]\\n<system-reminder>\\nFull output saved to: /Users/iv/.local/share/muse