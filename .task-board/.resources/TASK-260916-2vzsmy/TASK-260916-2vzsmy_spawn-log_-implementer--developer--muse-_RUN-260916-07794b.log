format ULFO \"$release_root/dist/RunnerControl.dmg\"\n61|signing_identity=\"$(security find-identity -v -p codesigning | python3 Scripts/release_metadata.py signing-identity --team 262RZ595FP)\"\n62|codesign --force --timestamp --sign \"$signing_identity\" \"$release_root/dist/RunnerControl.dmg\"\n63|notarize \"$release_root/dist/RunnerControl.dmg\" \"$release_root/dmg-notary.json\"\n64|xcrun stapler staple \"$release_root/dist/RunnerControl.dmg\"\n65|xcrun stapler validate \"$release_root/dist/RunnerControl.dmg\"\n66|sparkle_bin=\"$(./Scripts/sparkle-tools.sh)\"\n67|\"$sparkle_bin/generate_appcast\" --account works.relux.runnercontrol \\\n68|  --maximum-versions 1 --maximum-deltas 0 \\\n69|  --download-url-prefix \"https://github.com/relux-works/runner-control/releases/download/$RELEASE_TAG/\" \\\n70|  --link 'https://github.com/relux-works/runner-control' \"$release_root/dist\"\n71|python3 Scripts/release_metadata.py verify --appcast \"$release_root/dist/appcast.xml\" \\\n72|  --dmg \"$release_root/dist/RunnerControl.dmg\" --tag \"$RELEASE_TAG\" --build \"$build\"\n73|(cd \"$release_root/dist\" && shasum -a 256 RunnerControl.dmg appcast.xml > SHA256SUMS)\n74|if [ -n \"${GITHUB_OUTPUT:-}\" ]; then printf 'dist=%s\\n' \"$release_root/dist\" >> \"$GITHUB_OUTPUT\"; fi\n75|printf 'Notarized release assets: %s\\n' \"$release_root/dist\"","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c447","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":126,"recorded_at":1780531400000247,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"call_id":"call_01a0a82463687255804849481ab06e0a","text":"Read text file `Scripts/release-preflight.sh`.\n1|#!/bin/bash\n2|set -euo pipefail\n3|for tool in xcodebuild xcrun codesign security hdiutil tuist gh python3; do\n4|  command -v \"$tool\" >/dev/null || { echo \"Missing release tool: $tool\" >&2; exit 1; }\n5|done\n6|identity_out=\"$(mktemp)\"\n7|identity_err=\"$(mktemp)\"\n8|if ! security find-identity -v -p codesigning >\"$identity_out\" 2>\"$identity_err\"; then\n9|  echo 'Could not read signing identities; the result is unknown, not missing.' >&2\n10|  head -n 5 \"$identity_err\" >&2 || true\n11|  rm -f \"$identity_out\" \"$identity_err\"\n12|  exit 1\n13|fi\n14|identities=\"$(grep -E 'Developer ID Application:.*\\(262RZ595FP\\)' \"$identity_out\" || true)\"\n15|rm -f \"$identity_out\" \"$identity_err\"\n16|if [ -z \"$identities\" ]; then\n17|  echo 'Missing Developer ID Application identity with private key for team 262RZ595FP.' >&2\n18|  echo 'An Account Holder must issue it; Apple Development or another team cannot be substituted.' >&2\n19|  exit 1\n20|fi\n21|if [ \"$(printf '%s\\n' \"$identities\" | grep -c .)\" -gt 1 ]; then\n22|  echo 'Multiple Developer ID Application identities for team 262RZ595FP; remove the stale certificate so release signing is unambiguous.' >&2\n23|  exit 1\n24|fi\n25|profile=\"${NOTARY_PROFILE:-RunnerControl-notary}\"\n26|history_err=\"$(mktemp)\"\n27|if ! xcrun notarytool history --keychain-profile \"$profile\" --output-format json >/dev/null 2>\"$history_err\"; then\n28|  if grep -q 'keychainLocked' \"$history_err\"; then\n29|    echo \"The login keychain is locked in this session, so notarytool profile '$profile' cannot be read.\" >&2\n30|    echo 'Unlock the login keychain on macbook-iv (console login as the runner user) and re-run Release DMG via workflow_dispatch with the existing tag. Credentials are never printed or exported.' >&2\n31|  elif grep -q 'No Keychain password item found for profile' \"$history_err\"; then\n32|    echo \"notarytool profile '$profile' is missing from the login keychain.\" >&2\n33|    echo \"Recreate it locally with 'xcrun notarytool store-credentials' (see RELEASING.md), then re-run Release DMG via workflow_dispatch with the existing tag.\" >&2\n34|  else\n35|    echo \"notarytool history failed for profile '$profile':\" >&2\n36|    head -n 5 \"$history_err\" >&2 || true\n37|  fi\n38|  rm -f \"$history_err\"\n39|  exit 1\n40|fi\n41|rm -f \"$history_err\"\n42|root=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n43|cd \"$root\"\n44|sparkle_bin=\"$(\"$root/Scripts/sparkle-tools.sh\")\"\n45|actual=\"$(\"$sparkle_bin/generate_keys\" --account works.relux.runnercontrol -p)\"\n46|expected=\"$(python3 -c 'import json; print(json.load(open(\"ios-app-manager.json\"))[\"macos\"][\"info_plist\"][\"SUPublicEDKey\"])')\"\n47|[ \"$actual\" = \"$expected\" ] || { echo 'Sparkle signing key is missing or does not match the app public key.' >&2; exit 1; }\n48|printf \"Release prerequisites verified (team 262RZ595FP, notary profile '%s').\\n\" \"$profile\"","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c449","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":127,"recorded_at":1780531400000249,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"call_id":"call_01a0a824646770a892bbd283a0cf7b2b","text":"Read text file `Scripts/build.sh`.\n1|#!/bin/bash\n2|set -euo pipefail\n3|root=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n4|cd \"$root\"\n5|# Regenerate scaffold after config changes with ios-app-manager generate macos-app.\n6|tuist generate --no-open\n7|xcodebuild -workspace RunnerControl.xcworkspace -scheme RunnerControl \\\n8|  -configuration Release -destination 'platform=macOS' \\\n9|  -derivedDataPath .temp/DerivedData -allowProvisioningUpdates \\\n10|  CONFIGURATION_BUILD_DIR=\"$root/.temp/products\" \\\n11|  CODE_SIGN_IDENTITY='Apple Development' DEVELOPMENT_TEAM=262RZ595FP build\n12|codesign --verify --deep --strict .temp/products/RunnerControl.app","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c44b","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":128,"recorded_at":1780531400000251,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"call_id":"call_01a0a8246567762396516c0088bd24ad","text":"Read text file `Scripts/sparkle-tools.sh`.\n1|#!/bin/bash\n2|set -euo pipefail\n3|root=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n4|version=2.10.0\n5|checksum=c2bf58aa8387266ac179357b1415d6f2635f044da8be41042af32425dae6da0c\n6|tools=\"$root/.temp/tools/Sparkle-$version\"\n7|mkdir -p \"$tools\"\n8|if [ ! -x \"$tools/bin/generate_appcast\" ]; then\n9|  archive=\"$root/.temp/tools/Sparkle-$version.tar.xz\"\n10|  curl --fail --location --silent --show-error \"https://github.com/sparkle-project/Sparkle/releases/download/$version/Sparkle-$version.tar.xz\" -o \"$archive\"\n11|  printf '%s  %s\\n' \"$checksum\" \"$archive\" | shasum -a 256 --check --status\n12|  tar -xf \"$archive\" -C \"$tools\"\n13|fi\n14|printf '%s\\n' \"$tools/bin\"","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c44d","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":129,"recorded_at":1780531400000253,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"call_id":"call_01a0a82466b37774b46b8ea37df4b7e2","text":"Read text file `.github/workflows/release.yml`.\n1|name: Release DMG\n2|on:\n3|  push:\n4|    tags: ['v*']\n5|  workflow_dispatch:\n6|    inputs:\n7|      tag:\n8|        description: Existing vMAJOR.MINOR.PATCH tag on main\n9|        required: true\n10|        type: string\n11|permissions:\n12|  contents: write\n13|concurrency:\n14|  group: runner-control-release\n15|  cancel-in-progress: false\n16|jobs:\n17|  release:\n18|    runs-on: [self-hosted, macOS, ARM64, macbook-iv]\n19|    environment: release\n20|    timeout-minutes: 90\n21|    env:\n22|      RELEASE_TAG: ${{ inputs.tag || github.ref_name }}\n23|      NOTARY_PROFILE: RunnerControl-notary\n24|      GH_TOKEN: ${{ github.token }}\n25|    steps:\n26|      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n27|        with:\n28|          ref: ${{ inputs.tag || github.ref }}\n29|          fetch-depth: 0\n30|      - name: Validate trusted release tag\n31|        shell: bash\n32|        run: |\n33|          [[ \"$RELEASE_TAG\" =~ ^v[0-9]+\\.[0-9]+\\.[0-9]+$ ]]\n34|          test \"$(git rev-parse HEAD)\" = \"$(git rev-parse \"$RELEASE_TAG^{commit}\")\"\n35|          git merge-base --is-ancestor HEAD origin/main\n36|          if gh release view \"$RELEASE_TAG\" >/dev/null 2>&1; then\n37|            echo 'Release already exists. Inspect it before retrying; no published assets are overwritten.' >&2\n38|            exit 1\n39|          fi\n40|      - name: Release prerequisites\n41|        run: ./Scripts/release-preflight.sh\n42|      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n43|        with:\n44|          go-version: '1.25.5'\n45|          cache: false\n46|      - name: Build pinned scaffold generator\n47|        shell: bash\n48|        run: |\n49|          git clone https://github.com/relux-works/skill-ios-app-manager.git \"$RUNNER_TEMP/runner-control-generator-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT\"\n50|          cd \"$RUNNER_TEMP/runner-control-generator-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT\"\n51|          git checkout --detach 755a29538dfe0867671ac4291b016bf42d93a299\n52|          cd tuist-starter\n53|          env -u GOROOT go build -o \"$RUNNER_TEMP/runner-control-ios-app-manager\" ./cmd/ios-app-manager\n54|          echo \"IOS_APP_MANAGER=$RUNNER_TEMP/runner-control-ios-app-manager\" >> \"$GITHUB_ENV\"\n55|      - name: Unit tests\n56|        run: |\n57|          swift test --package-path Packages/RunnerControlCore --scratch-path \"$RUNNER_TEMP/runner-control-release-tests\"\n58|          python3 -m unittest discover -s Scripts/tests -v\n59|      - name: Build, notarize, staple and sign appcast\n60|        id: package\n61|        run: ./Scripts/release.sh\n62|      - name: Publish complete GitHub Release\n63|        env:\n64|          RELEASE_DIST: ${{ steps.package.outputs.dist }}\n65|        shell: bash\n66|        run: |\n67|          gh release create \"$RELEASE_TAG\" --verify-tag --draft --title \"Runner Control $RELEASE_TAG\" --generate-notes\n68|          gh release upload \"$RELEASE_TAG\" \"$RELEASE_DIST/RunnerControl.dmg\" \"$RELEASE_DIST/appcast.xml\" \"$RELEASE_DIST/SHA256SUMS\"\n69|          gh release edit \"$RELEASE_TAG\" --draft=false --latest\n70|      - name: Preserve release logs\n71|        if: always()\n72|        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n73|        with:\n74|          name: release-diagnostics-${{ github.run_id }}-${{ github.run_attempt }}\n75|          path: |\n76|            .temp/release-*/archive.log\n77|            .temp/release-*/export.log\n78|            .temp/release-*/*-notary.json\n79|          if-no-files-found: ignore\n80|          retention-days: 14","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c44f","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":130,"recorded_at":1780531400000255,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"call_id":"call_01a0a82467b576918f6626c677658283","text":"Read text file `.github/workflows/ci.yml`.\n1|name: Tests\n2|on:\n3|  pull_request:\n4|  push:\n5|    branches: [main]\n6|permissions:\n7|  contents: read\n8|jobs:\n9|  test:\n10|    runs-on: macos-15\n11|    steps:\n12|      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n13|      - name: Core unit tests (no UI tests or production runners)\n14|        run: swift test --package-path Packages/RunnerControlCore --scratch-path \"$RUNNER_TEMP/runner-control-tests\"\n15|      - name: Release metadata tests\n16|        run: python3 -m unittest discover -s Scripts/tests -v","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
