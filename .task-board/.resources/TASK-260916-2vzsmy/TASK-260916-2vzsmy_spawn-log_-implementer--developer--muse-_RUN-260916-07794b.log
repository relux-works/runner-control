{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c1","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":187,"recorded_at":1780531400000369,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"call_id":"call_01a0a8247c57741788d836e89c579e99","text":"Read text file `Scripts/tests/test_release_metadata.py`.\n1|import base64\n2|import copy\n3|import importlib.util\n4|from pathlib import Path\n5|import tempfile\n6|import unittest\n7|\n8|spec = importlib.util.spec_from_file_location('metadata', Path(__file__).parents[1] / 'release_metadata.py')\n9|m = importlib.util.module_from_spec(spec)\n10|spec.loader.exec_module(m)\n11|\n12|class ReleaseMetadataTests(unittest.TestCase):\n13|    def setUp(self):\n14|        self.config = {'marketing_version': '1.1.0', 'bundle_id': 'works.relux.runnercontrol',\n15|                       'team_id': '262RZ595FP', 'macos': {'info_plist': {\n16|                           'SUFeedURL': m.FEED, 'SUPublicEDKey': base64.b64encode(bytes(32)).decode()}}}\n17|    def test_builds_increase_between_attempts_and_runs(self):\n18|        values = [m.prepare(copy.deepcopy(self.config), 'v1.1.0', r, a)['project_version']\n19|                  for r, a in [(1, 1), (1, 2), (2, 1)]]\n20|        self.assertEqual(values, ['101.1', '101.2', '102.1'])\n21|    def test_rejects_wrong_tag_or_identity(self):\n22|        for tag in ['v1.0.0', 'main', 'v1.1.0;echo']:\n23|            with self.assertRaises(ValueError): m.prepare(copy.deepcopy(self.config), tag, 1, 1)\n24|        self.config['team_id'] = 'OTHERTEAM'\n25|        with self.assertRaises(ValueError): m.prepare(self.config, 'v1.1.0', 1, 1)\n26|    def test_rejects_wrong_feed(self):\n27|        self.config['macos']['info_plist']['SUFeedURL'] = 'https://example.org/feed'\n28|        with self.assertRaises(ValueError): m.prepare(self.config, 'v1.1.0', 1, 1)\n29|    def test_appcast_archive_binding(self):\n30|        with tempfile.TemporaryDirectory() as d:\n31|            dmg = Path(d) / 'RunnerControl.dmg'; dmg.write_bytes(b'archive')\n32|            feed = Path(d) / 'appcast.xml'\n33|            xml = f'''<rss xmlns:sparkle=\"{m.NS[1:-1]}\"><channel><item>\n34|              <sparkle:version>101.1</sparkle:version><sparkle:shortVersionString>1.1.0</sparkle:shortVersionString>\n35|              <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>\n36|              <enclosure url=\"https://github.com/{m.REPO}/releases/download/v1.1.0/RunnerControl.dmg\"\n37|              length=\"7\" sparkle:edSignature=\"{base64.b64encode(bytes(64)).decode()}\"/>\n38|              </item></channel></rss>'''\n39|            feed.write_text(xml)\n40|            m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')\n41|            for bad in [xml.replace('length=\"7\"', 'length=\"8\"'), xml.replace('/v1.1.0/', '/v9.0.0/'),\n42|                        xml.replace('101.1', '100.1'), xml.replace('14.0', '13.0')]:\n43|                feed.write_text(bad)\n44|                with self.assertRaises(ValueError): m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')\n45|\n46|TEAM = '262RZ595FP'\n47|EXPECTED_SHA = '267D90FC976A48CF830BE7F41AE612999E025054'\n48|FIND_IDENTITY = (\n49|    '  1) 7FB8D981868F2637B75DFD098A1F87E0CC11158D \"Apple Development: Ivan Oparin (45W9YW7M6V)\"\\n'\n50|    '  2) 08EF92AE3835F98861F51E625FAA9B6900A075C7 \"Apple Development: Ivan Oparin (FSPBF3QRXT)\"\\n'\n51|    f'  3) {EXPECTED_SHA} \"Developer ID Application: Relux Works, LLC ({TEAM})\"\\n'\n52|    '  4) C8448515B5871071F90EB0168A79DCD35E7CA9FE \"Developer ID Application: SKL VC DMCC (4Y4UJAT8QR)\"\\n'\n53|    '     4 valid identities found\\n')\n54|\n55|class SigningIdentityTests(unittest.TestCase):\n56|    def test_returns_team_identity_ignoring_other_teams(self):\n57|        self.assertEqual(m.resolve_signing_identity(FIND_IDENTITY, TEAM), EXPECTED_SHA)\n58|    def test_rejects_missing_team_identity(self):\n59|        only_other = '\\n'.join(l for l in FIND_IDENTITY.splitlines() if TEAM not in l)\n60|        with self.assertRaises(ValueError): m.resolve_signing_identity(only_other, TEAM)\n61|    def test_rejects_apple_development_only(self):\n62|        dev_only = '\\n'.join(l for l in FIND_IDENTITY.splitlines() if 'Apple Development' in l)\n63|        with self.assertRaises(ValueError): m.resolve_signing_identity(dev_only, TEAM)\n64|    def test_rejects_same_team_apple_development(self):\n65|        same_team_dev = FIND_IDENTITY.splitlines()[0].replace('(45W9YW7M6V)', f'({TEAM})')\n66|        with self.assertRaises(ValueError): m.resolve_signing_identity(same_team_dev, TEAM)\n67|    def test_rejects_near_match_team(self):\n68|        near = FIND_IDENTITY.replace(f'({TEAM})', '(262RZ595FX)')\n69|        with self.assertRaises(ValueError): m.resolve_signing_identity(near, TEAM)\n70|    def test_rejects_multiple_team_identities(self):\n71|        extra = FIND_IDENTITY.replace('  4) C8448515B5871071F90EB0168A79DCD35E7CA9FE \"Developer ID Application: SKL VC DMCC (4Y4UJAT8QR)\"',\n72|                                      f'  4) AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA \"Developer ID Application: Relux Works, LLC ({TEAM})\"')\n73|        with self.assertRaises(ValueError): m.resolve_signing_identity(extra, TEAM)\n74|\n75|class ReleaseWiringTests(unittest.TestCase):\n76|    def test_release_signs_dmg_with_resolved_team_identity(self):\n77|        lines = (Path(__file__).parents[1] / 'release.sh').read_text().splitlines()\n78|        live = [l for l in lines if not l.lstrip().startswith('#')]\n79|        self.assertTrue(any('release_metadata.py signing-identity' in l and '--team 262RZ595FP' in l for l in live),\n80|                        'release.sh must resolve the DMG signing identity through release_metadata.py signing-identity')","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c3","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":188,"recorded_at":1780531400000371,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"call_id":"call_01a0a8247da173c8876397fbc86e1d6f","text":"Read text file `Scripts/tests/test_release_packaging.py`.\n1|\"\"\"Drive the real Scripts/release.sh end to end with stubbed macOS tools.\n2|\n3|Each test builds an isolated repo root (real release.sh, release-preflight.sh,\n4|release_metadata.py, sparkle-tools.sh; fixture ios-app-manager.json for the\n5|coordinator-approved v1.2.0 target) and a stub bin dir shadowing security,\n6|xcrun, xcodebuild, codesign, ditto, hdiutil, spctl, tuist, gh plus the\n7|generator binary. The Sparkle bin dir is pre-created so no download happens.\n8|No credentials enter the fixtures; no Apple submission or publication occurs.\n9|\n10|The DMG-signing gate is proven behaviorally: the codesign stub records every\n11|invocation, and tests assert the exact resolved team identity reaches\n12|`codesign --sign`, on first attempt and on retry, and that zero/multiple\n13|identities prevent all packaging and workflow output.\n14|\"\"\"\n15|import base64\n16|import json\n17|import os\n18|from pathlib import Path\n19|import shutil\n20|import subprocess\n21|import tempfile\n22|import unittest\n23|\n24|REPO = Path(__file__).parents[2]\n25|TAG = 'v1.2.0'\n26|TEAM = '262RZ595FP'\n27|EXPECTED_SHA = '267D90FC976A48CF830BE7F41AE612999E025054'\n28|PUBKEY = base64.b64encode(bytes(32)).decode()\n29|TEAM_LINE = f'  3) {EXPECTED_SHA} \"Developer ID Application: Relux Works, LLC ({TEAM})\"'\n30|OTHER_LINES = ('  1) 7FB8D981868F2637B75DFD098A1F87E0CC11158D \"Apple Development: Ivan Oparin (45W9YW7M6V)\"\\n'\n31|               '  4) C8448515B5871071F90EB0168A79DCD35E7CA9FE \"Developer ID Application: SKL VC DMCC (4Y4UJAT8QR)\"')\n32|VALID_OUTPUT = OTHER_LINES + '\\n' + TEAM_LINE\n33|\n34|GENERATE_APPCAST = '''#!/usr/bin/env python3\n35|import base64, json, os, sys\n36|args = sys.argv[1:]\n37|distdir = args[-1]\n38|prefix = args[args.index('--download-url-prefix') + 1]\n39|tag = os.environ['RELEASE_TAG']\n40|root = os.environ['FIXTURE_ROOT']\n41|build = json.load(open(os.path.join(root, 'ios-app-manager.json')))['project_version']\n42|size = os.path.getsize(os.path.join(distdir, 'RunnerControl.dmg'))\n43|sig = base64.b64encode(bytes(64)).decode()\n44|xml = f\"\"\"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n45|<rss version=\"2.0\" xmlns:sparkle=\"http://www.andymatuschak.org/xml-namespaces/sparkle\">\n46|<channel>\n47|<item>\n48|<title>Runner Control {tag}</title>\n49|<sparkle:version>{build}</sparkle:version>\n50|<sparkle:shortVersionString>{tag[1:]}</sparkle:shortVersionString>\n51|<sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>\n52|<enclosure url=\"{prefix}RunnerControl.dmg\" length=\"{size}\" type=\"application/octet-stream\" sparkle:edSignature=\"{sig}\" />\n53|</item>\n54|</channel>\n55|</rss>\n56|\"\"\"\n57|open(os.path.join(distdir, 'appcast.xml'), 'w').write(xml)\n58|'''\n59|\n60|XCODEBUILD_STUB = '''#!/bin/bash\n61|prev=\"\"\n62|for a in \"$@\"; do\n63|  if [ \"$prev\" = \"-archivePath\" ]; then mkdir -p \"$a\"; fi\n64|  if [ \"$prev\" = \"-exportPath\" ]; then\n65|    mkdir -p \"$a/RunnerControl.app\"\n66|    printf 'fixture' > \"$a/RunnerControl.app/RunnerControl\"\n67|  fi\n68|  prev=\"$a\"\n69|done\n70|exit 0\n71|'''\n72|\n73|XCRUN_STUB = '''#!/bin/bash\n74|if [ \"${1:-}\" = \"notarytool\" ] && [ \"${2:-}\" = \"submit\" ]; then\n75|  printf '{\"status\":\"Accepted\",\"id\":\"00000000-0000-0000-0000-000000000000\"}\\\\n'\n76|fi\n77|exit 0\n78|'''\n79|\n80|CODESIGN_STUB = '''#!/bin/bash\n81|if [ \"${1:-}\" = \"-dvv\" ]; then\n82|  echo \"Executable=${2:-}\"\n83|  echo \"Identifier=works.relux.runnercontrol\"\n84|  echo \"TeamIdentifier=262RZ595FP\"\n85|  echo \"Authority=Developer ID Application: Relux Works, LLC (262RZ595FP)\"\n86|  exit 0\n87|fi\n88|printf '%s\\\\n' \"$*\" >> \"$CODESIGN_LOG\"\n89|exit 0\n90|'''\n91|\n92|DITTO_STUB = '''#!/bin/bash\n93|dest=\"${@: -1}\"\n94|if [ \"${1:-}\" = \"-c\" ]; then : > \"$dest\"; else mkdir -p \"$dest\"; fi\n95|exit 0\n96|'''\n97|\n98|HDIUTIL_STUB = '''#!/bin/bash\n99|printf 'fixture-dmg' > \"${@: -1}\"\n100|exit 0\n101|'''\n102|\n103|\n104|def write_exe(path, content):\n105|    path.write_text(content)\n106|    path.chmod(0o755)\n107|\n108|\n109|class ReleasePackagingHarness(unittest.TestCase):\n110|    def setUp(self):\n111|        self.tmp = tempfile.TemporaryDirectory()\n112|        root = Path(self.tmp.name)\n113|        scripts = root / 'Scripts'\n114|        scripts.mkdir()\n115|        for name in ('release.sh', 'release-preflight.sh', 'release_metadata.py',\n116|                     'sparkle-tools.sh'):\n117|            shutil.copy(REPO / 'Scripts' / name, scripts / name)\n118|        (root / 'ios-app-manager.json').write_text(json.dumps({\n119|            'bundle_id': 'works.relux.runnercontrol',\n120|            'team_id': TEAM,\n121|            'marketing_version': TAG[1:],\n122|            'macos': {'info_plist': {\n123|                'SUFeedURL': 'https://github.com/relux-works/runner-control/releases/latest/download/appcast.xml',\n124|                'SUPublicEDKey': PUBKEY}}}))\n125|        sparkle_bin = root / '.temp' / 'tools' / 'Sparkle-2.10.0' / 'bin'\n126|        sparkle_bin.mkdir(parents=True)\n127|        write_exe(sparkle_bin / 'generate_appcast', GENERATE_APPCAST)\n128|        write_exe(sparkle_bin / 'generate_keys', '#!/bin/sh\\necho ' + PUBKEY + '\\n')\n129|        bindir = root / 'bin'\n130|        bindir.mkdir()\n131|        write_exe(bindir / 'xcodebuild', XCODEBUILD_STUB)\n132|        write_exe(bindir / 'xcrun', XCRUN_STUB)\n133|        write_exe(bindir / 'codesign', CODESIGN_STUB)\n134|        write_exe(bindir / 'ditto', DITTO_STUB)\n135|        write_exe(bindir / 'hdiutil', HDIUTIL_STUB)\n136|        for tool in ('spctl', 'tuist', 'gh', 'ios-app-manager'):\n137|            write_exe(bindir / tool, '#!/bin/bash\\nexit 0\\n')\n138|        self.root = root\n139|        self.bindir = bindir\n140|        self.codesign_log = root / 'codesign.log'\n141|        self.github_output = root / 'github-output.txt'\n142|\n143|    def tearDown(self):\n144|        self.tmp.cleanup()\n145|\n146|    def run_release(self, security_out, attempt=1, run_number=101):\n147|        if security_out:\n148|            stub = '#!/bin/sh\\ncat <<\\'EOF\\'\\n' + security_out + '\\nEOF\\n'\n149|        else:\n150|            stub = '#!/bin/sh\\n'\n151|        write_exe(self.bindir / 'security', stub)\n152|        env = dict(os.environ)\n153|        env['PATH'] = str(self.bindir) + os.pathsep + env['PATH']\n154|        env['RELEASE_TAG'] = TAG\n155|        env['GITHUB_RUN_NUMBER'] = str(run_number)\n156|        env['GITHUB_RUN_ATTEMPT'] = str(attempt)\n157|        env['IOS_APP_MANAGER'] = str(self.bindir / 'ios-app-manager')\n158|        env['GITHUB_OUTPUT'] = str(self.github_output)\n159|        env['CODESIGN_LOG'] = str(self.codesign_log)\n160|        env['FIXTURE_ROOT'] = str(self.root)\n161|        env.pop('NOTARY_PROFILE', None)\n162|        return subprocess.run(['bash', str(self.root / 'Scripts' / 'release.sh')],\n163|                              capture_output=True, text=True, timeout=180,\n164|                              env=env, cwd=self.tmp.name)\n165|\n166|    def dist_of(self):\n167|        for line in self.github_output.read_text().splitlines():\n168|            if line.startswith('dist='):\n169|                return Path(line[len('dist='):])\n170|        self.fail('release wrote no dist= workflow output')\n171|\n172|    def assert_no_packaging_or_output(self, result):\n173|        self.assertNotEqual(result.returncode, 0)\n174|        if self.codesign_log.exists():\n175|            self.assertNotIn('--sign ', self.codesign_log.read_text())\n176|        if self.github_output.exists():\n177|            self.assertNotIn('dist=', self.github_output.read_text())\n178|        packaged = [p for p in (self.root / '.temp').glob('release-*')\n179|                    if p.name != 'tools']\n180|        self.assertEqual(packaged, [])\n181|\n182|\n183|class ReleasePackagingTests(ReleasePackagingHarness):\n184|    def test_release_signs_dmg_with_resolved_team_identity(self):\n185|        r = self.run_release(VALID_OUTPUT, attempt=1)\n186|        self.assertEqual(r.returncode, 0, r.stderr[-2000:])\n187|        self.assertIn(f'--sign {EXPECTED_SHA}', self.codesign_log.read_text())\n188|        dist = self.dist_of()\n189|        for name in ('RunnerControl.dmg', 'appcast.xml', 'SHA256SUMS'):\n190|            self.assertTrue((dist / name).exists(), name)\n191|\n192|    def test_retry_attempt_signs_with_resolved_team_identity(self):\n193|        r = self.run_release(VALID_OUTPUT, attempt=2)\n194|        self.assertEqual(r.returncode, 0, r.stderr[-2000:])\n195|        self.assertIn(f'--sign {EXPECTED_SHA}', self.codesign_log.read_text())\n196|        dist = self.dist_of()\n197|        for name in ('RunnerControl.dmg', 'appcast.xml', 'SHA256SUMS'):\n198|            self.assertTrue((dist / name).exists(), name)\n199|\n200|    def test_zero_identities_prevents_packaging_and_output(self):\n201|        r = self.run_release(OTHER_LINES, attempt=1)\n202|        self.assert_no_packaging_or_output(r)\n203|\n204|    def test_multiple_identities_prevents_packaging_and_output(self):\n205|        second = TEAM_LINE.replace(EXPECTED_SHA, 'A' * 40).replace('  3)', '  5)')\n206|        r = self.run_release(VALID_OUTPUT + '\\n' + second, attempt=1)\n207|        self.assert_no_packaging_or_output(r)\n208|\n209|\n210|if __name__ == '__main__':\n211|    unittest.main()","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c5","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":189,"recorded_at":1780531400000373,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"call_id":"call_01a0a8247ee471f5b5ed0ea3e2cc0132","text":"Read text file `Scripts/tests/test_release_preflight.py`.\n1|\"\"\"Drive Scripts/release-preflight.sh with stubbed macOS tools.\n2|\n3|Each test builds an isolated repo root (preflight + sparkle-tools scripts,\n4|minimal ios-app-manager.json, stub Sparkle tools so no download happens) and\n5|a stub bin dir shadowing xcrun/security. Real python3/bash/grep run from PATH.\n6|No credentials enter the fixtures.\n7|\"\"\"\n8|import base64\n9|import json\n10|import os\n11|from pathlib import Path\n12|import shlex\n13|import shutil\n14|import subprocess\n15|import tempfile\n16|import unittest\n17|\n18|REPO = Path(__file__).parents[2]\n19|PUBKEY = base64.b64encode(bytes(32)).decode()\n20|WRONG_PUBKEY = base64.b64encode(bytes(range(32))).decode()\n21|TEAM_LINE = '  3) 267D90FC976A48CF830BE7F41AE612999E025054 \"Developer ID Application: Relux Works, LLC (262RZ595FP)\"'\n22|OTHER_LINES = ('  1) 7FB8D981868F2637B75DFD098A1F87E0CC11158D \"Apple Development: Ivan Oparin (45W9YW7M6V)\"\\n'\n23|               '  4) C8448515B5871071F90EB0168A79DCD35E7CA9FE \"Developer ID Application: SKL VC DMCC (4Y4UJAT8QR)\"')\n24|\n25|\n26|def write_exe(path, content):\n27|    path.write_text(content)\n28|    path.chmod(0o755)\n29|\n30|\n31|class PreflightHarness(unittest.TestCase):\n32|    def setUp(self):\n33|        self.tmp = tempfile.TemporaryDirectory()\n34|        root = Path(self.tmp.name)\n35|        scripts = root / 'Scripts'\n36|        scripts.mkdir()\n37|        for name in ('release-preflight.sh', 'sparkle-tools.sh'):\n38|            shutil.copy(REPO / 'Scripts' / name, scripts / name)\n39|        (root / 'ios-app-manager.json').write_text(json.dumps(\n40|            {'macos': {'info_plist': {'SUPublicEDKey': PUBKEY}}}))\n41|        sparkle_bin = root / '.temp' / 'tools' / 'Sparkle-2.10.0' / 'bin'\n42|        sparkle_bin.mkdir(parents=True)\n43|        write_exe(sparkle_bin / 'generate_appcast', '#!/bin/sh\\nexit 0\\n')\n44|        self.sparkle_bin = sparkle_bin\n45|        self.bindir = root / 'bin'\n46|        self.bindir.mkdir()\n47|        for tool in ('xcodebuild', 'codesign', 'hdiutil', 'tuist', 'gh'):\n48|            write_exe(self.bindir / tool, '#!/bin/sh\\nexit 0\\n')\n49|        self.root = root\n50|\n51|    def tearDown(self):\n52|        self.tmp.cleanup()\n53|\n54|    def run_preflight(self, security_out, xcrun_script, sparkle_key=PUBKEY, profile=None,\n55|                      security_exit=0, security_err=''):\n56|        stub = '#!/bin/sh\\n'\n57|        if security_err:\n58|            stub += 'echo ' + shlex.quote(security_err) + ' >&2\\n'\n59|        if security_out:\n60|            stub += 'cat <<\\'EOF\\'\\n' + security_out + '\\nEOF\\n'\n61|        stub += 'exit ' + str(security_exit) + '\\n'\n62|        write_exe(self.bindir / 'security', stub)\n63|        write_exe(self.bindir / 'xcrun', xcrun_script)\n64|        write_exe(self.sparkle_bin / 'generate_keys', '#!/bin/sh\\necho ' + sparkle_key + '\\n')\n65|        env = dict(os.environ)\n66|        env['PATH'] = str(self.bindir) + os.pathsep + env['PATH']\n67|        if profile is None:\n68|            env.pop('NOTARY_PROFILE', None)\n69|        else:\n70|            env['NOTARY_PROFILE'] = profile\n71|        return subprocess.run(['bash', str(self.root / 'Scripts' / 'release-preflight.sh')],\n72|                              capture_output=True, text=True, timeout=60, env=env, cwd=self.tmp.name)\n73|\n74|\n75|class ReleasePreflightTests(PreflightHarness):\n76|    def test_preflight_passes_with_valid_credentials(self):\n77|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, '#!/bin/sh\\nexit 0\\n')\n78|        self.assertEqual(r.returncode, 0, r.stderr)\n79|        self.assertIn('Release prerequisites verified', r.stdout)\n80|        self.assertIn('RunnerControl-notary', r.stdout)\n81|\n82|    def test_locked_keychain_fails_with_unlock_guidance(self):\n83|        stub = ('#!/bin/sh\\necho \\'Error: keychainLocked(keychainName: \"default\", keychainURL: nil)'\n84|                ' Use Keychain Access or the `security unlock-keychain` command line tool'\n85|                ' to unlock the default keychain.\\' >&2\\nexit 1\\n')\n86|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, stub)\n87|        self.assertNotEqual(r.returncode, 0)\n88|        self.assertIn('locked', r.stderr)\n89|        self.assertIn('workflow_dispatch', r.stderr)\n90|        self.assertIn('RunnerControl-notary', r.stderr)\n91|\n92|    def test_missing_profile_names_profile_without_locked_guidance(self):\n93|        stub = ('#!/bin/sh\\necho \"Error: No Keychain password item found for profile: Custom-Profile-9\" >&2\\n'\n94|                'echo \"Run \\'notarytool store-credentials\\' to create another credential profile.\" >&2\\nexit 1\\n')\n95|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, stub, profile='Custom-Profile-9')\n96|        self.assertNotEqual(r.returncode, 0)\n97|        self.assertIn('Custom-Profile-9', r.stderr)\n98|        self.assertIn('store-credentials', r.stderr)\n99|        self.assertIn('missing from the login keychain', r.stderr)\n100|        self.assertNotIn('locked', r.stderr)\n101|\n102|    def test_missing_identity_rejected(self):\n103|        r = self.run_preflight(OTHER_LINES, '#!/bin/sh\\nexit 0\\n')\n104|        self.assertNotEqual(r.returncode, 0)\n105|        self.assertIn('Missing Developer ID Application identity', r.stderr)\n106|\n107|    def test_multiple_team_identities_rejected(self):\n108|        second = TEAM_LINE.replace('267D90FC976A48CF830BE7F41AE612999E025054',\n109|                                   'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA').replace('  3)', '  5)')\n110|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE + '\\n' + second, '#!/bin/sh\\nexit 0\\n')\n111|        self.assertNotEqual(r.returncode, 0)\n112|        self.assertIn('Multiple Developer ID Application identities', r.stderr)\n113|\n114|    def test_sparkle_key_mismatch_rejected(self):\n115|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, '#!/bin/sh\\nexit 0\\n', sparkle_key=WRONG_PUBKEY)\n116|        self.assertNotEqual(r.returncode, 0)\n117|        self.assertIn('Sparkle signing key', r.stderr)\n118|\n119|    def test_failed_identity_read_with_empty_output_is_unknown_not_missing(self):\n120|        r = self.run_preflight('', '#!/bin/sh\\nexit 0\\n',\n121|                               security_exit=42, security_err='security: read failed')\n122|        self.assertNotEqual(r.returncode, 0)\n123|        self.assertIn('Could not read signing identities', r.stderr)\n124|        self.assertNotIn('Missing Developer ID Application identity', r.stderr)\n125|        self.assertNotIn('Release prerequisites verified', r.stdout)\n126|\n127|    def test_failed_identity_read_with_partial_output_is_not_verified(self):\n128|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, '#!/bin/sh\\nexit 0\\n',\n129|                               security_exit=42, security_err='security: read failed')\n130|        self.assertNotEqual(r.returncode, 0)\n131|        self.assertIn('Could not read signing identities', r.stderr)\n132|        self.assertNotIn('Release prerequisites verified', r.stdout)\n133|\n134|\n135|if __name__ == '__main__':\n136|    unittest.main()","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
