{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c437","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":118,"recorded_at":1780531400000231,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"task_stream":{"kind":"task","id":"01a0a824-6b39-7ec0-ae59-c767fb8ce647"},"task_id":"01a0a824-6b39-7ec0-ae59-c767fb8ce647","event":{"kind":"output","task_id":"01a0a824-6b39-7ec0-ae59-c767fb8ce647","chunk":"Read text file `Scripts/sparkle-tools.sh`.\n1|#!/bin/bash\n2|set -euo pipefail\n3|root=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n4|version=2.10.0\n5|checksum=c2bf58aa8387266ac179357b1415d6f2635f044da8be41042af32425dae6da0c\n6|tools=\"$root/.temp/tools/Sparkle-$version\"\n7|mkdir -p \"$tools\"\n8|if [ ! -x \"$tools/bin/generate_appcast\" ]; then\n9|  archive=\"$root/.temp/tools/Sparkle-$version.tar.xz\"\n10|  curl --fail --location --silent --show-error \"https://github.com/sparkle-project/Sparkle/releases/download/$version/Sparkle-$version.tar.xz\" -o \"$archive\"\n11|  printf '%s  %s\\n' \"$checksum\" \"$archive\" | shasum -a 256 --check --status\n12|  tar -xf \"$archive\" -C \"$tools\"\n13|fi\n14|printf '%s\\n' \"$tools/bin\"","final_result":true}}}
