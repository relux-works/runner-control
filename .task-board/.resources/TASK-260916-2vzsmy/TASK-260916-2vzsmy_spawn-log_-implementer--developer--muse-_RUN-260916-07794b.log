{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4bd","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":185,"recorded_at":1780531400000365,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"task_stream":{"kind":"task","id":"01a0a824-84cc-7a90-887c-205bcb3f146e"},"task_id":"01a0a824-84cc-7a90-887c-205bcb3f146e","event":{"kind":"output","task_id":"01a0a824-84cc-7a90-887c-205bcb3f146e","chunk":"Read text file `Scripts/tests/test_release_packaging.py`.\n1|\"\"\"Drive the real Scripts/release.sh end to end with stubbed macOS tools.\n2|\n3|Each test builds an isolated repo root (real release.sh, release-preflight.sh,\n4|release_metadata.py, sparkle-tools.sh; fixture ios-app-manager.json for the\n5|coordinator-approved v1.2.0 target) and a stub bin dir shadowing security,\n6|xcrun, xcodebuild, codesign, ditto, hdiutil, spctl, tuist, gh plus the\n7|generator binary. The Sparkle bin dir is pre-created so no download happens.\n8|No credentials enter the fixtures; no Apple submission or publication occurs.\n9|\n10|The DMG-signing gate is proven behaviorally: the codesign stub records every\n11|invocation, and tests assert the exact resolved team identity reaches\n12|`codesign --sign`, on first attempt and on retry, and that zero/multiple\n13|identities prevent all packaging and workflow output.\n14|\"\"\"\n15|import base64\n16|import json\n17|import os\n18|from pathlib import Path\n19|import shutil\n20|import subprocess\n21|import tempfile\n22|import unittest\n23|\n24|REPO = Path(__file__).parents[2]\n25|TAG = 'v1.2.0'\n26|TEAM = '262RZ595FP'\n27|EXPECTED_SHA = '267D90FC976A48CF830BE7F41AE612999E025054'\n28|PUBKEY = base64.b64encode(bytes(32)).decode()\n29|TEAM_LINE = f'  3) {EXPECTED_SHA} \"Developer ID Application: Relux Works, LLC ({TEAM})\"'\n30|OTHER_LINES = ('  1) 7FB8D981868F2637B75DFD098A1F87E0CC11158D \"Apple Development: Ivan Oparin (45W9YW7M6V)\"\\n'\n31|               '  4) C8448515B5871071F90EB0168A79DCD35E7CA9FE \"Developer ID Application: SKL VC DMCC (4Y4UJAT8QR)\"')\n32|VALID_OUTPUT = OTHER_LINES + '\\n' + TEAM_LINE\n33|\n34|GENERATE_APPCAST = '''#!/usr/bin/env python3\n35|import base64, json, os, sys\n36|args = sys.argv[1:]\n37|distdir = args[-1]\n38|prefix = args[args.index('--download-url-prefix') + 1]\n39|tag = os.environ['RELEASE_TAG']\n40|root = os.environ['FIXTURE_ROOT']\n41|build = json.load(open(os.path.join(root, 'ios-app-manager.json')))['project_version']\n42|size = os.path.getsize(os.path.join(distdir, 'RunnerControl.dmg'))\n43|sig = base64.b64encode(bytes(64)).decode()\n44|xml = f\"\"\"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n45|<rss version=\"2.0\" xmlns:sparkle=\"http://www.andymatuschak.org/xml-namespaces/sparkle\">\n46|<channel>\n47|<item>\n48|<title>Runner Control {tag}</title>\n49|<sparkle:version>{build}</sparkle:version>\n50|<sparkle:shortVersionString>{tag[1:]}</sparkle:shortVersionString>\n51|<sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>\n52|<enclosure url=\"{prefix}RunnerControl.dmg\" length=\"{size}\" type=\"application/octet-stream\" sparkle:edSignature=\"{sig}\" />\n53|</item>\n54|</channel>\n55|</rss>\n56|\"\"\"\n57|open(os.path.join(distdir, 'appcast.xml'), 'w').write(xml)\n58|'''\n59|\n60|XCODEBUILD_STUB = '''#!/bin/bash\n61|prev=\"\"\n62|for a in \"$@\"; do\n63|  if [ \"$prev\" = \"-archivePath\" ]; then mkdir -p \"$a\"; fi\n64|  if [ \"$prev\" = \"-exportPath\" ]; then\n65|    mkdir -p \"$a/RunnerControl.app\"\n66|    printf 'fixture' > \"$a/RunnerControl.app/RunnerControl\"\n67|  fi\n68|  prev=\"$a\"\n69|done\n70|exit 0\n71|'''\n72|\n73|XCRUN_STUB = '''#!/bin/bash\n74|if [ \"${1:-}\" = \"notarytool\" ] && [ \"${2:-}\" = \"submit\" ]; then\n75|  printf '{\"status\":\"Accepted\",\"id\":\"00000000-0000-0000-0000-000000000000\"}\\\\n'\n76|fi\n77|exit 0\n78|'''\n79|\n80|CODESIGN_STUB = '''#!/bin/bash\n81|if [ \"${1:-}\" = \"-dvv\" ]; then\n82|  echo \"Executable=${2:-}\"\n83|  echo \"Identifier=works.relux.runnercontrol\"\n84|  echo \"TeamIdentifier=262RZ595FP\"\n85|  echo \"Authority=Developer ID Application: Relux Works, LLC (262RZ595FP)\"\n86|  exit 0\n87|fi\n88|printf '%s\\\\n' \"$*\" >> \"$CODESIGN_LOG\"\n89|exit 0\n90|'''\n91|\n92|DITTO_STUB = '''#!/bin/bash\n93|dest=\"${@: -1}\"\n94|if [ \"${1:-}\" = \"-c\" ]; then : > \"$dest\"; else mkdir -p \"$dest\"; fi\n95|exit 0\n96|'''\n97|\n98|HDIUTIL_STUB = '''#!/bin/bash\n99|printf 'fixture-dmg' > \"${@: -1}\"\n100|exit 0\n101|'''\n102|\n103|\n104|def write_exe(path, content):\n105|    path.write_text(content)\n106|    path.chmod(0o755)\n107|\n108|\n109|class ReleasePackagingHarness(unittest.TestCase):\n110|    def setUp(self):\n111|        self.tmp = tempfile.TemporaryDirectory()\n112|        root = Path(self.tmp.name)\n113|        scripts = root / 'Scripts'\n114|        scripts.mkdir()\n115|        for name in ('release.sh', 'release-preflight.sh', 'release_metadata.py',\n116|                     'sparkle-tools.sh'):\n117|            shutil.copy(REPO / 'Scripts' / name, scripts / name)\n118|        (root / 'ios-app-manager.json').write_text(json.dumps({\n119|            'bundle_id': 'works.relux.runnercontrol',\n120|            'team_id': TEAM,\n121|            'marketing_version': TAG[1:],\n122|            'macos': {'info_plist': {\n123|                'SUFeedURL': 'https://github.com/relux-works/runner-control/releases/latest/download/appcast.xml',\n124|                'SUPublicEDKey': PUBKEY}}}))\n125|        sparkle_bin = root / '.temp' / 'tools' / 'Sparkle-2.10.0' / 'bin'\n126|        sparkle_bin.mkdir(parents=True)\n127|        write_exe(sparkle_bin / 'generate_appcast', GENERATE_APPCAST)\n128|        write_exe(sparkle_bin / 'generate_keys', '#!/bin/sh\\necho ' + PUBKEY + '\\n')\n129|        bindir = root / 'bin'\n130|        bindir.mkdir()\n131|        write_exe(bindir / 'xcodebuild', XCODEBUILD_STUB)\n132|        write_exe(bindir / 'xcrun', XCRUN_STUB)\n133|        write_exe(bindir / 'codesign', CODESIGN_STUB)\n134|        write_exe(bindir / 'ditto', DITTO_STUB)\n135|        write_exe(bindir / 'hdiutil', HDIUTIL_STUB)\n136|        for tool in ('spctl', 'tuist', 'gh', 'ios-app-manager'):\n137|            write_exe(bindir / tool, '#!/bin/bash\\nexit 0\\n')\n138|        self.root = root\n139|        self.bindir = bindir\n140|        self.codesign_log = root / 'codesign.log'\n141|        self.github_output = root / 'github-output.txt'\n142|\n143|    def tearDown(self):\n144|        self.tmp.cleanup()\n145|\n146|    def run_release(self, security_out, attempt=1, run_number=101):\n147|        if security_out:\n148|            stub = '#!/bin/sh\\ncat <<\\'EOF\\'\\n' + security_out + '\\nEOF\\n'\n149|        else:\n150|            stub = '#!/bin/sh\\n'\n151|        write_exe(self.bindir / 'security', stub)\n152|        env = dict(os.environ)\n153|        env['PATH'] = str(self.bindir) + os.pathsep + env['PATH']\n154|        env['RELEASE_TAG'] = TAG\n155|        env['GITHUB_RUN_NUMBER'] = str(run_number)\n156|        env['GITHUB_RUN_ATTEMPT'] = str(attempt)\n157|        env['IOS_APP_MANAGER'] = str(self.bindir / 'ios-app-manager')\n158|        env['GITHUB_OUTPUT'] = str(self.github_output)\n159|        env['CODESIGN_LOG'] = str(self.codesign_log)\n160|        env['FIXTURE_ROOT'] = str(self.root)\n161|        env.pop('NOTARY_PROFILE', None)\n162|        return subprocess.run(['bash', str(self.root / 'Scripts' / 'release.sh')],\n163|                              capture_output=True, text=True, timeout=180,\n164|                              env=env, cwd=self.tmp.name)\n165|\n166|    def dist_of(self):\n167|        for line in self.github_output.read_text().splitlines():\n168|            if line.startswith('dist='):\n169|                return Path(line[len('dist='):])\n170|        self.fail('release wrote no dist= workflow output')\n171|\n172|    def assert_no_packaging_or_output(self, result):\n173|        self.assertNotEqual(result.returncode, 0)\n174|        if self.codesign_log.exists():\n175|            self.assertNotIn('--sign ', self.codesign_log.read_text())\n176|        if self.github_output.exists():\n177|            self.assertNotIn('dist=', self.github_output.read_text())\n178|        packaged = [p for p in (self.root / '.temp').glob('release-*')\n179|                    if p.name != 'tools']\n180|        self.assertEqual(packaged, [])\n181|\n182|\n183|class ReleasePackagingTests(ReleasePackagingHarness):\n184|    def test_release_signs_dmg_with_resolved_team_identity(self):\n185|        r = self.run_release(VALID_OUTPUT, attempt=1)\n186|        self.assertEqual(r.returncode, 0, r.stderr[-2000:])\n187|        self.assertIn(f'--sign {EXPECTED_SHA}', self.codesign_log.read_text())\n188|        dist = self.dist_of()\n189|        for name in ('RunnerControl.dmg', 'appcast.xml', 'SHA256SUMS'):\n190|            self.assertTrue((dist / name).exists(), name)\n191|\n192|    def test_retry_attempt_signs_with_resolved_team_identity(self):\n193|        r = self.run_release(VALID_OUTPUT, attempt=2)\n194|        self.assertEqual(r.returncode, 0, r.stderr[-2000:])\n195|        self.assertIn(f'--sign {EXPECTED_SHA}', self.codesign_log.read_text())\n196|        dist = self.dist_of()\n197|        for name in ('RunnerControl.dmg', 'appcast.xml', 'SHA256SUMS'):\n198|            self.assertTrue((dist / name).exists(), name)\n199|\n200|    def test_zero_identities_prevents_packaging_and_output(self):\n201|        r = self.run_release(OTHER_LINES, attempt=1)\n202|        self.assert_no_packaging_or_output(r)\n203|\n204|    def test_multiple_identities_prevents_packaging_and_output(self):\n205|        second = TEAM_LINE.replace(EXPECTED_SHA, 'A' * 40).replace('  3)', '  5)')\n206|        r = self.run_release(VALID_OUTPUT + '\\n' + second, attempt=1)\n207|        self.assert_no_packaging_or_output(r)\n208|\n209|\n210|if __name__ == '__main__':\n211|    unittest.main()","final_result":true}}}
