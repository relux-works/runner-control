{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4ad","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":177,"recorded_at":1780531400000349,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"task_stream":{"kind":"task","id":"01a0a824-8499-73e0-8e11-ad47c99c7f2d"},"task_id":"01a0a824-8499-73e0-8e11-ad47c99c7f2d","event":{"kind":"output","task_id":"01a0a824-8499-73e0-8e11-ad47c99c7f2d","chunk":"Read text file `Scripts/tests/test_release_metadata.py`.\n1|import base64\n2|import copy\n3|import importlib.util\n4|from pathlib import Path\n5|import tempfile\n6|import unittest\n7|\n8|spec = importlib.util.spec_from_file_location('metadata', Path(__file__).parents[1] / 'release_metadata.py')\n9|m = importlib.util.module_from_spec(spec)\n10|spec.loader.exec_module(m)\n11|\n12|class ReleaseMetadataTests(unittest.TestCase):\n13|    def setUp(self):\n14|        self.config = {'marketing_version': '1.1.0', 'bundle_id': 'works.relux.runnercontrol',\n15|                       'team_id': '262RZ595FP', 'macos': {'info_plist': {\n16|                           'SUFeedURL': m.FEED, 'SUPublicEDKey': base64.b64encode(bytes(32)).decode()}}}\n17|    def test_builds_increase_between_attempts_and_runs(self):\n18|        values = [m.prepare(copy.deepcopy(self.config), 'v1.1.0', r, a)['project_version']\n19|                  for r, a in [(1, 1), (1, 2), (2, 1)]]\n20|        self.assertEqual(values, ['101.1', '101.2', '102.1'])\n21|    def test_rejects_wrong_tag_or_identity(self):\n22|        for tag in ['v1.0.0', 'main', 'v1.1.0;echo']:\n23|            with self.assertRaises(ValueError): m.prepare(copy.deepcopy(self.config), tag, 1, 1)\n24|        self.config['team_id'] = 'OTHERTEAM'\n25|        with self.assertRaises(ValueError): m.prepare(self.config, 'v1.1.0', 1, 1)\n26|    def test_rejects_wrong_feed(self):\n27|        self.config['macos']['info_plist']['SUFeedURL'] = 'https://example.org/feed'\n28|        with self.assertRaises(ValueError): m.prepare(self.config, 'v1.1.0', 1, 1)\n29|    def test_appcast_archive_binding(self):\n30|        with tempfile.TemporaryDirectory() as d:\n31|            dmg = Path(d) / 'RunnerControl.dmg'; dmg.write_bytes(b'archive')\n32|            feed = Path(d) / 'appcast.xml'\n33|            xml = f'''<rss xmlns:sparkle=\"{m.NS[1:-1]}\"><channel><item>\n34|              <sparkle:version>101.1</sparkle:version><sparkle:shortVersionString>1.1.0</sparkle:shortVersionString>\n35|              <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>\n36|              <enclosure url=\"https://github.com/{m.REPO}/releases/download/v1.1.0/RunnerControl.dmg\"\n37|              length=\"7\" sparkle:edSignature=\"{base64.b64encode(bytes(64)).decode()}\"/>\n38|              </item></channel></rss>'''\n39|            feed.write_text(xml)\n40|            m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')\n41|            for bad in [xml.replace('length=\"7\"', 'length=\"8\"'), xml.replace('/v1.1.0/', '/v9.0.0/'),\n42|                        xml.replace('101.1', '100.1'), xml.replace('14.0', '13.0')]:\n43|                feed.write_text(bad)\n44|                with self.assertRaises(ValueError): m.verify_appcast(feed, dmg, 'v1.1.0', '101.1')\n45|\n46|TEAM = '262RZ595FP'\n47|EXPECTED_SHA = '267D90FC976A48CF830BE7F41AE612999E025054'\n48|FIND_IDENTITY = (\n49|    '  1) 7FB8D981868F2637B75DFD098A1F87E0CC11158D \"Apple Development: Ivan Oparin (45W9YW7M6V)\"\\n'\n50|    '  2) 08EF92AE3835F98861F51E625FAA9B6900A075C7 \"Apple Development: Ivan Oparin (FSPBF3QRXT)\"\\n'\n51|    f'  3) {EXPECTED_SHA} \"Developer ID Application: Relux Works, LLC ({TEAM})\"\\n'\n52|    '  4) C8448515B5871071F90EB0168A79DCD35E7CA9FE \"Developer ID Application: SKL VC DMCC (4Y4UJAT8QR)\"\\n'\n53|    '     4 valid identities found\\n')\n54|\n55|class SigningIdentityTests(unittest.TestCase):\n56|    def test_returns_team_identity_ignoring_other_teams(self):\n57|        self.assertEqual(m.resolve_signing_identity(FIND_IDENTITY, TEAM), EXPECTED_SHA)\n58|    def test_rejects_missing_team_identity(self):\n59|        only_other = '\\n'.join(l for l in FIND_IDENTITY.splitlines() if TEAM not in l)\n60|        with self.assertRaises(ValueError): m.resolve_signing_identity(only_other, TEAM)\n61|    def test_rejects_apple_development_only(self):\n62|        dev_only = '\\n'.join(l for l in FIND_IDENTITY.splitlines() if 'Apple Development' in l)\n63|        with self.assertRaises(ValueError): m.resolve_signing_identity(dev_only, TEAM)\n64|    def test_rejects_same_team_apple_development(self):\n65|        same_team_dev = FIND_IDENTITY.splitlines()[0].replace('(45W9YW7M6V)', f'({TEAM})')\n66|        with self.assertRaises(ValueError): m.resolve_signing_identity(same_team_dev, TEAM)\n67|    def test_rejects_near_match_team(self):\n68|        near = FIND_IDENTITY.replace(f'({TEAM})', '(262RZ595FX)')\n69|        with self.assertRaises(ValueError): m.resolve_signing_identity(near, TEAM)\n70|    def test_rejects_multiple_team_identities(self):\n71|        extra = FIND_IDENTITY.replace('  4) C8448515B5871071F90EB0168A79DCD35E7CA9FE \"Developer ID Application: SKL VC DMCC (4Y4UJAT8QR)\"',\n72|                                      f'  4) AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA \"Developer ID Application: Relux Works, LLC ({TEAM})\"')\n73|        with self.assertRaises(ValueError): m.resolve_signing_identity(extra, TEAM)\n74|\n75|class ReleaseWiringTests(unittest.TestCase):\n76|    def test_release_signs_dmg_with_resolved_team_identity(self):\n77|        lines = (Path(__file__).parents[1] / 'release.sh').read_text().splitlines()\n78|        live = [l for l in lines if not l.lstrip().startswith('#')]\n79|        self.assertTrue(any('release_metadata.py signing-identity' in l and '--team 262RZ595FP' in l for l in live),\n80|                        'release.sh must resolve the DMG signing identity through release_metadata.py signing-identity')","final_result":true}}}
