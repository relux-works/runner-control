{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c42f","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":114,"recorded_at":1780531400000223,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"task_stream":{"kind":"task","id":"01a0a824-6b66-7781-99da-83957542577f"},"task_id":"01a0a824-6b66-7781-99da-83957542577f","event":{"kind":"output","task_id":"01a0a824-6b66-7781-99da-83957542577f","chunk":"Read text file `.github/workflows/release.yml`.\n1|name: Release DMG\n2|on:\n3|  push:\n4|    tags: ['v*']\n5|  workflow_dispatch:\n6|    inputs:\n7|      tag:\n8|        description: Existing vMAJOR.MINOR.PATCH tag on main\n9|        required: true\n10|        type: string\n11|permissions:\n12|  contents: write\n13|concurrency:\n14|  group: runner-control-release\n15|  cancel-in-progress: false\n16|jobs:\n17|  release:\n18|    runs-on: [self-hosted, macOS, ARM64, macbook-iv]\n19|    environment: release\n20|    timeout-minutes: 90\n21|    env:\n22|      RELEASE_TAG: ${{ inputs.tag || github.ref_name }}\n23|      NOTARY_PROFILE: RunnerControl-notary\n24|      GH_TOKEN: ${{ github.token }}\n25|    steps:\n26|      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n27|        with:\n28|          ref: ${{ inputs.tag || github.ref }}\n29|          fetch-depth: 0\n30|      - name: Validate trusted release tag\n31|        shell: bash\n32|        run: |\n33|          [[ \"$RELEASE_TAG\" =~ ^v[0-9]+\\.[0-9]+\\.[0-9]+$ ]]\n34|          test \"$(git rev-parse HEAD)\" = \"$(git rev-parse \"$RELEASE_TAG^{commit}\")\"\n35|          git merge-base --is-ancestor HEAD origin/main\n36|          if gh release view \"$RELEASE_TAG\" >/dev/null 2>&1; then\n37|            echo 'Release already exists. Inspect it before retrying; no published assets are overwritten.' >&2\n38|            exit 1\n39|          fi\n40|      - name: Release prerequisites\n41|        run: ./Scripts/release-preflight.sh\n42|      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n43|        with:\n44|          go-version: '1.25.5'\n45|          cache: false\n46|      - name: Build pinned scaffold generator\n47|        shell: bash\n48|        run: |\n49|          git clone https://github.com/relux-works/skill-ios-app-manager.git \"$RUNNER_TEMP/runner-control-generator-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT\"\n50|          cd \"$RUNNER_TEMP/runner-control-generator-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT\"\n51|          git checkout --detach 755a29538dfe0867671ac4291b016bf42d93a299\n52|          cd tuist-starter\n53|          env -u GOROOT go build -o \"$RUNNER_TEMP/runner-control-ios-app-manager\" ./cmd/ios-app-manager\n54|          echo \"IOS_APP_MANAGER=$RUNNER_TEMP/runner-control-ios-app-manager\" >> \"$GITHUB_ENV\"\n55|      - name: Unit tests\n56|        run: |\n57|          swift test --package-path Packages/RunnerControlCore --scratch-path \"$RUNNER_TEMP/runner-control-release-tests\"\n58|          python3 -m unittest discover -s Scripts/tests -v\n59|      - name: Build, notarize, staple and sign appcast\n60|        id: package\n61|        run: ./Scripts/release.sh\n62|      - name: Publish complete GitHub Release\n63|        env:\n64|          RELEASE_DIST: ${{ steps.package.outputs.dist }}\n65|        shell: bash\n66|        run: |\n67|          gh release create \"$RELEASE_TAG\" --verify-tag --draft --title \"Runner Control $RELEASE_TAG\" --generate-notes\n68|          gh release upload \"$RELEASE_TAG\" \"$RELEASE_DIST/RunnerControl.dmg\" \"$RELEASE_DIST/appcast.xml\" \"$RELEASE_DIST/SHA256SUMS\"\n69|          gh release edit \"$RELEASE_TAG\" --draft=false --latest\n70|      - name: Preserve release logs\n71|        if: always()\n72|        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n73|        with:\n74|          name: release-diagnostics-${{ github.run_id }}-${{ github.run_attempt }}\n75|          path: |\n76|            .temp/release-*/archive.log\n77|            .temp/release-*/export.log\n78|            .temp/release-*/*-notary.json\n79|          if-no-files-found: ignore\n80|          retention-days: 14","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c431","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":115,"recorded_at":1780531400000225,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"task_stream":{"kind":"task","id":"01a0a824-6b66-7781-99da-83957542577f"},"task_id":"01a0a824-6b66-7781-99da-83957542577f","event":{"kind":"completed","task_id":"01a0a824-6b66-7781-99da-83957542577f"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c433","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":116,"recorded_at":1780531400000227,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"task_stream":{"kind":"task","id":"01a0a824-6a66-70d2-b825-998858ce2f6d"},"task_id":"01a0a824-6a66-70d2-b825-998858ce2f6d","event":{"kind":"output","task_id":"01a0a824-6a66-70d2-b825-998858ce2f6d","chunk":"Read text file `Scripts/release_metadata.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Validate release identity and appcast metadata without handling private keys.\"\"\"\n3|import argparse\n4|import base64\n5|import json\n6|from pathlib import Path\n7|import re\n8|import sys\n9|import xml.etree.ElementTree as ET\n10|\n11|REPO = 'relux-works/runner-control'\n12|FEED = f'https://github.com/{REPO}/releases/latest/download/appcast.xml'\n13|NS = '{http://www.andymatuschak.org/xml-namespaces/sparkle}'\n14|\n15|def prepare(config, tag, run, attempt):\n16|    if not re.fullmatch(r'v\\d+\\.\\d+\\.\\d+', tag):\n17|        raise ValueError('Release tag must be vMAJOR.MINOR.PATCH')\n18|    if config['marketing_version'] != tag[1:]:\n19|        raise ValueError('Tag must match marketing_version in ios-app-manager.json')\n20|    if config['bundle_id'] != 'works.relux.runnercontrol' or config['team_id'] != '262RZ595FP':\n21|        raise ValueError('Unexpected bundle ID or signing team')\n22|    if not 1 <= run <= 9899 or not 1 <= attempt <= 99:\n23|        raise ValueError('Invalid release run/attempt number')\n24|    if config['macos']['info_plist']['SUFeedURL'] != FEED:\n25|        raise ValueError('Unexpected public update feed')\n26|    key = base64.b64decode(config['macos']['info_plist']['SUPublicEDKey'], validate=True)\n27|    if len(key) != 32:\n28|        raise ValueError('Invalid Sparkle public key')\n29|    config['project_version'] = f'{100 + run}.{attempt}'\n30|    return config\n31|\n32|def resolve_signing_identity(find_identity_output, team):\n33|    \"\"\"Return the Developer ID Application SHA-1 for team.\n34|\n35|    Parses `security find-identity -v -p codesigning` output. Apple\n36|    Development and other-team identities are ignored. Zero or several\n37|    matches fail so release signing never silently picks a wrong key.\n38|    \"\"\"\n39|    matches = []\n40|    for line in find_identity_output.splitlines():\n41|        if 'Developer ID Application:' not in line or f'({team})' not in line:\n42|            continue\n43|        found = re.search(r'\\b([A-F0-9]{40})\\b', line)\n44|        if found:\n45|            matches.append(found.group(1))\n46|    if not matches:\n47|        raise ValueError(f'No Developer ID Application identity for team {team}')\n48|    if len(matches) > 1:\n49|        raise ValueError(f'Multiple Developer ID Application identities for team {team}; remove the stale certificate')\n50|    return matches[0]\n51|\n52|def verify_appcast(path, dmg, tag, build):\n53|    root = ET.parse(path).getroot()\n54|    items = root.findall('./channel/item')\n55|    if len(items) != 1:\n56|        raise ValueError('Expected one current release in appcast')\n57|    item = items[0]\n58|    if item.findtext(NS + 'version') != build:\n59|        raise ValueError('Appcast build does not match app build')\n60|    if item.findtext(NS + 'shortVersionString') != tag[1:]:\n61|        raise ValueError('Appcast release version mismatch')\n62|    enclosure = item.find('enclosure')\n63|    if enclosure is None or enclosure.get('url') != f'https://github.com/{REPO}/releases/download/{tag}/RunnerControl.dmg':\n64|        raise ValueError('Unexpected download URL')\n65|    signature = base64.b64decode(enclosure.get(NS + 'edSignature', ''), validate=True)\n66|    if len(signature) != 64 or int(enclosure.get('length', '0')) != dmg.stat().st_size:\n67|        raise ValueError('Missing signature or archive length mismatch')\n68|    minimum = item.findtext(NS + 'minimumSystemVersion')\n69|    if not minimum or int(minimum.split('.')[0]) < 14:\n70|        raise ValueError('Missing minimum macOS requirement')\n71|\n72|def main():\n73|    parser = argparse.ArgumentParser()\n74|    sub = parser.add_subparsers(dest='command', required=True)\n75|    prep = sub.add_parser('prepare')\n76|    prep.add_argument('--config', type=Path, required=True)\n77|    prep.add_argument('--tag', required=True)\n78|    prep.add_argument('--run', type=int, required=True)\n79|    prep.add_argument('--attempt', type=int, required=True)\n80|    verify = sub.add_parser('verify')\n81|    verify.add_argument('--appcast', type=Path, required=True)\n82|    verify.add_argument('--dmg', type=Path, required=True)\n83|    verify.add_argument('--tag', required=True)\n84|    verify.add_argument('--build', required=True)\n85|    sig = sub.add_parser('signing-identity')\n86|    sig.add_argument('--team', required=True)\n87|    args = parser.parse_args()\n88|    if args.command == 'prepare':\n89|        data = prepare(json.loads(args.config.read_text()), args.tag, args.run, args.attempt)\n90|        args.config.write_text(json.dumps(data, indent=2) + '\\n')\n91|        print(data['project_version'])\n92|    elif args.command == 'signing-identity':\n93|        print(resolve_signing_identity(sys.stdin.read(), args.team))\n94|    else:\n95|        verify_appcast(args.appcast, args.dmg, args.tag, args.build)\n96|        print('Appcast identity, signature presence, size and minimum OS verified')\n97|\n98|if __name__ == '__main__':\n99|    main()","final_result":true}}}
