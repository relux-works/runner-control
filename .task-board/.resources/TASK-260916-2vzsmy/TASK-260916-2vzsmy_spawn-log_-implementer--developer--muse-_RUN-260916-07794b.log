{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4b7","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":182,"recorded_at":1780531400000359,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"task_stream":{"kind":"task","id":"01a0a824-8593-7202-8ee7-f1bbddc8e19d"},"task_id":"01a0a824-8593-7202-8ee7-f1bbddc8e19d","event":{"kind":"completed","task_id":"01a0a824-8593-7202-8ee7-f1bbddc8e19d"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4b9","stream":{"kind":"session","id":"01a0a824-3367-71b3-b578-b3dbe0e13bbe"},"sequence":183,"recorded_at":1780531400000361,"record_type":"event","durability":"durable","causation_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01","run_stream":{"kind":"run","id":"70aff3fa-2b06-43ab-b4a6-dd81d1872e01"},"task_stream":{"kind":"task","id":"01a0a824-850a-73e3-9757-a6863732ae3f"},"task_id":"01a0a824-850a-73e3-9757-a6863732ae3f","event":{"kind":"output","task_id":"01a0a824-850a-73e3-9757-a6863732ae3f","chunk":"Read text file `Scripts/tests/test_release_preflight.py`.\n1|\"\"\"Drive Scripts/release-preflight.sh with stubbed macOS tools.\n2|\n3|Each test builds an isolated repo root (preflight + sparkle-tools scripts,\n4|minimal ios-app-manager.json, stub Sparkle tools so no download happens) and\n5|a stub bin dir shadowing xcrun/security. Real python3/bash/grep run from PATH.\n6|No credentials enter the fixtures.\n7|\"\"\"\n8|import base64\n9|import json\n10|import os\n11|from pathlib import Path\n12|import shlex\n13|import shutil\n14|import subprocess\n15|import tempfile\n16|import unittest\n17|\n18|REPO = Path(__file__).parents[2]\n19|PUBKEY = base64.b64encode(bytes(32)).decode()\n20|WRONG_PUBKEY = base64.b64encode(bytes(range(32))).decode()\n21|TEAM_LINE = '  3) 267D90FC976A48CF830BE7F41AE612999E025054 \"Developer ID Application: Relux Works, LLC (262RZ595FP)\"'\n22|OTHER_LINES = ('  1) 7FB8D981868F2637B75DFD098A1F87E0CC11158D \"Apple Development: Ivan Oparin (45W9YW7M6V)\"\\n'\n23|               '  4) C8448515B5871071F90EB0168A79DCD35E7CA9FE \"Developer ID Application: SKL VC DMCC (4Y4UJAT8QR)\"')\n24|\n25|\n26|def write_exe(path, content):\n27|    path.write_text(content)\n28|    path.chmod(0o755)\n29|\n30|\n31|class PreflightHarness(unittest.TestCase):\n32|    def setUp(self):\n33|        self.tmp = tempfile.TemporaryDirectory()\n34|        root = Path(self.tmp.name)\n35|        scripts = root / 'Scripts'\n36|        scripts.mkdir()\n37|        for name in ('release-preflight.sh', 'sparkle-tools.sh'):\n38|            shutil.copy(REPO / 'Scripts' / name, scripts / name)\n39|        (root / 'ios-app-manager.json').write_text(json.dumps(\n40|            {'macos': {'info_plist': {'SUPublicEDKey': PUBKEY}}}))\n41|        sparkle_bin = root / '.temp' / 'tools' / 'Sparkle-2.10.0' / 'bin'\n42|        sparkle_bin.mkdir(parents=True)\n43|        write_exe(sparkle_bin / 'generate_appcast', '#!/bin/sh\\nexit 0\\n')\n44|        self.sparkle_bin = sparkle_bin\n45|        self.bindir = root / 'bin'\n46|        self.bindir.mkdir()\n47|        for tool in ('xcodebuild', 'codesign', 'hdiutil', 'tuist', 'gh'):\n48|            write_exe(self.bindir / tool, '#!/bin/sh\\nexit 0\\n')\n49|        self.root = root\n50|\n51|    def tearDown(self):\n52|        self.tmp.cleanup()\n53|\n54|    def run_preflight(self, security_out, xcrun_script, sparkle_key=PUBKEY, profile=None,\n55|                      security_exit=0, security_err=''):\n56|        stub = '#!/bin/sh\\n'\n57|        if security_err:\n58|            stub += 'echo ' + shlex.quote(security_err) + ' >&2\\n'\n59|        if security_out:\n60|            stub += 'cat <<\\'EOF\\'\\n' + security_out + '\\nEOF\\n'\n61|        stub += 'exit ' + str(security_exit) + '\\n'\n62|        write_exe(self.bindir / 'security', stub)\n63|        write_exe(self.bindir / 'xcrun', xcrun_script)\n64|        write_exe(self.sparkle_bin / 'generate_keys', '#!/bin/sh\\necho ' + sparkle_key + '\\n')\n65|        env = dict(os.environ)\n66|        env['PATH'] = str(self.bindir) + os.pathsep + env['PATH']\n67|        if profile is None:\n68|            env.pop('NOTARY_PROFILE', None)\n69|        else:\n70|            env['NOTARY_PROFILE'] = profile\n71|        return subprocess.run(['bash', str(self.root / 'Scripts' / 'release-preflight.sh')],\n72|                              capture_output=True, text=True, timeout=60, env=env, cwd=self.tmp.name)\n73|\n74|\n75|class ReleasePreflightTests(PreflightHarness):\n76|    def test_preflight_passes_with_valid_credentials(self):\n77|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, '#!/bin/sh\\nexit 0\\n')\n78|        self.assertEqual(r.returncode, 0, r.stderr)\n79|        self.assertIn('Release prerequisites verified', r.stdout)\n80|        self.assertIn('RunnerControl-notary', r.stdout)\n81|\n82|    def test_locked_keychain_fails_with_unlock_guidance(self):\n83|        stub = ('#!/bin/sh\\necho \\'Error: keychainLocked(keychainName: \"default\", keychainURL: nil)'\n84|                ' Use Keychain Access or the `security unlock-keychain` command line tool'\n85|                ' to unlock the default keychain.\\' >&2\\nexit 1\\n')\n86|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, stub)\n87|        self.assertNotEqual(r.returncode, 0)\n88|        self.assertIn('locked', r.stderr)\n89|        self.assertIn('workflow_dispatch', r.stderr)\n90|        self.assertIn('RunnerControl-notary', r.stderr)\n91|\n92|    def test_missing_profile_names_profile_without_locked_guidance(self):\n93|        stub = ('#!/bin/sh\\necho \"Error: No Keychain password item found for profile: Custom-Profile-9\" >&2\\n'\n94|                'echo \"Run \\'notarytool store-credentials\\' to create another credential profile.\" >&2\\nexit 1\\n')\n95|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, stub, profile='Custom-Profile-9')\n96|        self.assertNotEqual(r.returncode, 0)\n97|        self.assertIn('Custom-Profile-9', r.stderr)\n98|        self.assertIn('store-credentials', r.stderr)\n99|        self.assertIn('missing from the login keychain', r.stderr)\n100|        self.assertNotIn('locked', r.stderr)\n101|\n102|    def test_missing_identity_rejected(self):\n103|        r = self.run_preflight(OTHER_LINES, '#!/bin/sh\\nexit 0\\n')\n104|        self.assertNotEqual(r.returncode, 0)\n105|        self.assertIn('Missing Developer ID Application identity', r.stderr)\n106|\n107|    def test_multiple_team_identities_rejected(self):\n108|        second = TEAM_LINE.replace('267D90FC976A48CF830BE7F41AE612999E025054',\n109|                                   'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA').replace('  3)', '  5)')\n110|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE + '\\n' + second, '#!/bin/sh\\nexit 0\\n')\n111|        self.assertNotEqual(r.returncode, 0)\n112|        self.assertIn('Multiple Developer ID Application identities', r.stderr)\n113|\n114|    def test_sparkle_key_mismatch_rejected(self):\n115|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, '#!/bin/sh\\nexit 0\\n', sparkle_key=WRONG_PUBKEY)\n116|        self.assertNotEqual(r.returncode, 0)\n117|        self.assertIn('Sparkle signing key', r.stderr)\n118|\n119|    def test_failed_identity_read_with_empty_output_is_unknown_not_missing(self):\n120|        r = self.run_preflight('', '#!/bin/sh\\nexit 0\\n',\n121|                               security_exit=42, security_err='security: read failed')\n122|        self.assertNotEqual(r.returncode, 0)\n123|        self.assertIn('Could not read signing identities', r.stderr)\n124|        self.assertNotIn('Missing Developer ID Application identity', r.stderr)\n125|        self.assertNotIn('Release prerequisites verified', r.stdout)\n126|\n127|    def test_failed_identity_read_with_partial_output_is_not_verified(self):\n128|        r = self.run_preflight(OTHER_LINES + '\\n' + TEAM_LINE, '#!/bin/sh\\nexit 0\\n',\n129|                               security_exit=42, security_err='security: read failed')\n130|        self.assertNotEqual(r.returncode, 0)\n131|        self.assertIn('Could not read signing identities', r.stderr)\n132|        self.assertNotIn('Release prerequisites verified', r.stdout)\n133|\n134|\n135|if __name__ == '__main__':\n136|    unittest.main()","final_result":true}}}
