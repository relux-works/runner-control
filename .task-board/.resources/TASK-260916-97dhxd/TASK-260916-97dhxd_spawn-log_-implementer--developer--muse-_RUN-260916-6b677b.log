{ now().addingTimeInterval(TimeInterval($0)) }\n186|        let record = GitHubAuth.TokenRecord(accessToken: accessToken, refreshToken: refreshToken, expiresAt: expiresAt, obtainedAt: now())\n187|        do {\n188|            try await store.save(record, serverHost: config.serverHost, userID: user.id, clientID: config.clientID)\n189|        } catch {\n190|            guard generation == gen else { return }\n191|            deviceCode = nil\n192|            await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .retry) }\n193|            return\n194|        }\n195|        session = GitHubAuth.Session(userID: user.id, username: user.login, serverHost: config.serverHost, config: config)\n196|        deviceCode = nil\n197|        await action { GitHubAuth.Action.accountVerified(username: user.login, userID: user.id, serverHost: config.serverHost) }\n198|        guard generation == gen else { return }\n199|        do {\n200|            let installations = try await api.fetchInstallations(config: config, token: accessToken)\n201|            guard generation == gen else { return }\n202|            await action { GitHubAuth.Action.installationsLoaded(installations) }\n203|            if let first = installations.first {\n204|                do {\n205|                    let repos = try await api.fetchRepositories(config: config, token: accessToken, installationID: first.id)\n206|                    guard generation == gen else { return }\n207|                    await action { GitHubAuth.Action.repositoriesLoaded(installationID: first.id, repositories: repos) }\n208|                } catch let error as GitHubAuth.AuthError {\n209|                    guard generation == gen else { return }\n210|                    await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n211|                } catch {\n212|                    guard generation == gen else { return }\n213|                    await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n214|                }\n215|            } else {\n216|                await action { GitHubAuth.Action.syncFailed(message: GitHubAuth.AuthError.needsInstallation.localizedDescription) }\n217|            }\n218|            await action { GitHubAuth.Action.connected(username: user.login, serverHost: config.serverHost, syncedAt: now()) }\n219|        } catch let error as GitHubAuth.AuthError {\n220|            guard generation == gen else { return }\n221|            switch error {\n222|            case .unauthorized, .revoked:\n223|                await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .relogin) }\n224|            default:\n225|                await action { GitHubAuth.Action.installationsLoaded([]) }\n226|                await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n227|                await action { GitHubAuth.Action.connected(username: user.login, serverHost: config.serverHost, syncedAt: now()) }\n228|            }\n229|        } catch {\n230|            guard generation == gen else { return }\n231|            await action { GitHubAuth.Action.installationsLoaded([]) }\n232|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n233|            await action { GitHubAuth.Action.connected(username: user.login, serverHost: config.serverHost, syncedAt: now()) }\n234|        }\n235|    }\n236|\n237|    private func cancelLogin() async {\n238|        generation += 1\n239|        pollTask?.cancel()\n240|        pollTask = nil\n241|        deviceCode = nil\n242|        if let sess = session {\n243|            await action { GitHubAuth.Action.connected(username: sess.username, serverHost: sess.serverHost, syncedAt: now()) }\n244|        } else {\n245|            await action { GitHubAuth.Action.loginCancelled }\n246|        }\n247|    }\n248|\n249|    private func logout() async {\n250|        generation += 1\n251|        pollTask?.cancel()\n252|        pollTask = nil\n253|        deviceCode = nil\n254|        if let sess = session {\n255|            await store.delete(serverHost: sess.serverHost, userID: sess.userID, clientID: sess.config.clientID)\n256|            await store.deleteAll(serverHost: sess.serverHost, clientID: sess.config.clientID)\n257|        }\n258|        session = nil\n259|        await action { GitHubAuth.Action.loggedOut }\n260|    }\n261|\n262|    private func currentToken() async throws -> (GitHubAuth.Session, String) {\n263|        guard let sess = session else { throw GitHubAuth.AuthError.revoked }\n264|        guard var record = await store.load(serverHost: sess.serverHost, userID: sess.userID, clientID: sess.config.clientID) else {\n265|            throw GitHubAuth.AuthError.revoked\n266|        }\n267|        if GitHubTokenRefresh.isExpiringSoon(record, now: now()) {\n268|            do {\n269|                record = try await refresher.refresh(config: sess.config, userID: sess.userID, current: record)\n270|            } catch let error as GitHubAuth.AuthError {\n271|                switch error {\n272|                case .revoked, .unauthorized, .tokenRefreshFailed:\n273|                    throw error\n274|                default:\n275|                    break // Keep old token; report stale below.\n276|                }\n277|            }\n278|        }\n279|        return (sess, record.accessToken)\n280|    }\n281|\n282|    private func refreshInstallations() async {\n283|        guard session != nil else { return }\n284|        let sess: GitHubAuth.Session\n285|        let token: String\n286|        do {\n287|            (sess, token) = try await currentToken()\n288|        } catch let error as GitHubAuth.AuthError {\n289|            switch error {\n290|            case .revoked, .unauthorized, .tokenRefreshFailed:\n291|                await action { GitHubAuth.Action.failed(message: GitHubAuth.AuthError.revoked.localizedDescription, retry: .relogin) }\n292|            default:\n293|                await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n294|            }\n295|            return\n296|        } catch {\n297|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n298|            return\n299|        }\n300|        do {\n301|            let installations = try await api.fetchInstallations(config: sess.config, token: token)\n302|            await action { GitHubAuth.Action.installationsLoaded(installations) }\n303|            await action { GitHubAuth.Action.syncSucceeded(now()) }\n304|        } catch let error as GitHubAuth.AuthError {\n305|            switch error {\n306|            case .unauthorized, .revoked:\n307|                await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .relogin) }\n308|            default:\n309|                await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n310|            }\n311|        } catch {\n312|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n313|        }\n314|    }\n315|\n316|    private func selectInstallation(_ id: Int64?) async {\n317|        await action { GitHubAuth.Action.installationSelected(id) }\n318|        guard let id, session != nil else { return }\n319|        let sess: GitHubAuth.Session\n320|        let token: String\n321|        do {\n322|            (sess, token) = try await currentToken()\n323|        } catch let error as GitHubAuth.AuthError {\n324|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n325|            return\n326|        } catch {\n327|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n328|            return\n329|        }\n330|        do {\n331|            let repos = try await api.fetchRepositories(config: sess.config, token: token, installationID: id)\n332|            await action { GitHubAuth.Action.repositoriesLoaded(installationID: id, repositories: repos) }\n333|            await action { GitHubAuth.Action.syncSucceeded(now()) }\n334|        } catch let error as GitHubAuth.AuthError {\n335|            switch error {\n336|            case .unauthorized, .revoked:\n337|                await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .relogin) }\n338|            default:\n339|                await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n340|            }\n341|        } catch {\n342|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n343|        }\n344|    }\n345|\n346|    private nonisolated static func retryKind(for error: GitHubAuth.AuthError) -> GitHubAuth.RetryKind {\n347|        switch error {\n348|        case .denied, .codeExpired: .newCode\n349|        case .unauthorized, .revoked, .tokenRefreshFailed: .relogin\n350|        case .forbidden, .needsApproval, .needsInstallation: .grantAccess\n351|        case .ssoRequired, .missingClientID, .patNotSupported: .none\n352|        case .cancelled: .none\n353|        case .network, .rateLimited, .slowDown, .authorizationPending: .retry\n354|        }\n355|    }\n356|}","final_result":true}}}
