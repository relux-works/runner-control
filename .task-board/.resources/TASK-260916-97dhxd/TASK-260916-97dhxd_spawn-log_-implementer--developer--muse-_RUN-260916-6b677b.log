{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b9","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":311,"recorded_at":1780531400000617,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"call_id":"call_01a0a8247aed710c97c252efe0faf9f9","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubAppConfig.swift`.\n1|import Foundation\n2|\n3|extension GitHubAuth {\n4|    /// Public GitHub App configuration. Only the public client_id lives here.\n5|    /// Client secrets and private keys are never embedded (see auditNoSecrets).\n6|    public struct AppConfig: Sendable, Equatable {\n7|        public let clientID: String\n8|        public let serverHost: String\n9|        public let deviceAuthorizationURL: URL\n10|        public let tokenURL: URL\n11|        public let apiBaseURL: URL\n12|\n13|        public init(clientID: String, serverHost: String = \"github.com\") {\n14|            self.clientID = clientID\n15|            self.serverHost = serverHost\n16|            if serverHost == \"github.com\" || serverHost == \"www.github.com\" {\n17|                self.deviceAuthorizationURL = URL(string: \"https://github.com/login/device/code\")!\n18|                self.tokenURL = URL(string: \"https://github.com/login/oauth/access_token\")!\n19|                self.apiBaseURL = URL(string: \"https://api.github.com\")!\n20|            } else {\n21|                self.deviceAuthorizationURL = URL(string: \"https://\\(serverHost)/login/device/code\")!\n22|                self.tokenURL = URL(string: \"https://\\(serverHost)/login/oauth/access_token\")!\n23|                self.apiBaseURL = URL(string: \"https://\\(serverHost)/api/v3\")!\n24|            }\n25|        }\n26|\n27|        /// Exact scaffold binding the coordinator must provision.\n28|        public static let missingBindingHelp = \"Info.plist[GitHubAppClientID] (scaffold input ios-app-manager.json → macos.info_plist.GitHubAppClientID, coordinator-provisioned public client_id)\"\n29|\n30|        public static func current(bundle: Bundle = .main, serverHost: String = \"github.com\") throws -> Self {\n31|            let raw = bundle.object(forInfoDictionaryKey: \"GitHubAppClientID\") as? String\n32|            let trimmed = raw?.trimmingCharacters(in: .whitespacesAndNewlines) ?? \"\"\n33|            guard !trimmed.isEmpty else {\n34|                throw ConfigError.missingClientID(binding: missingBindingHelp)\n35|            }\n36|            return Self(clientID: trimmed, serverHost: serverHost)\n37|        }\n38|\n39|        /// Fail-closed audit: Info.plist must not carry secrets or private keys.\n40|        public static func auditNoSecrets(in dictionary: [String: Any]) throws {\n41|            let forbidden = [\"secret\", \"private_key\", \"privatekey\", \"token\"]\n42|            for key in dictionary.keys {\n43|                let lowered = key.lowercased()\n44|                for token in forbidden where lowered.contains(token) {\n45|                    if key == \"GitHubAppClientID\" { continue }\n46|                    throw ConfigError.embeddedSecret(key: key)\n47|                }\n48|            }\n49|        }\n50|    }\n51|\n52|    public enum ConfigError: LocalizedError, Sendable, Equatable {\n53|        case missingClientID(binding: String)\n54|        case embeddedSecret(key: String)\n55|        case unsupportedEnterprise(host: String)\n56|\n57|        public var errorDescription: String? {\n58|            switch self {\n59|            case .missingClientID(let binding):\n60|                \"GitHub App client_id is not provisioned. Missing binding: \\(binding).\"\n61|            case .embeddedSecret(let key):\n62|                \"Refusing to load embedded secret '\\(key)'. Secrets must stay in Keychain, never in plist/state/logs.\"\n63|            case .unsupportedEnterprise(let host):\n64|                \"GitHub Enterprise Server '\\(host)' needs its own App registration and Device Flow support check. Local control remains available offline.\"\n65|            }\n66|        }\n67|    }\n68|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bb","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":312,"recorded_at":1780531400000619,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"call_id":"call_01a0a8247c4970848ae7892053e57c96","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubTokenRefresh.swift`.\n1|import Foundation\n2|\n3|/// Serialized token refresh. Concurrent callers coalesce to a single network refresh.\n4|public actor GitHubTokenRefresh {\n5|    private let transport: any GitHubHTTPTransport\n6|    private let store: any GitHubCredentialStoring\n7|    private let now: @Sendable () -> Date\n8|    private var inFlight: Task<GitHubAuth.TokenRecord, Error>?\n9|\n10|    public init(\n11|        transport: any GitHubHTTPTransport,\n12|        store: any GitHubCredentialStoring,\n13|        now: @Sendable @escaping () -> Date = Date.init\n14|    ) {\n15|        self.transport = transport\n16|        self.store = store\n17|        self.now = now\n18|    }\n19|\n20|    public func refresh(\n21|        config: GitHubAuth.AppConfig,\n22|        userID: Int64,\n23|        current: GitHubAuth.TokenRecord\n24|    ) async throws -> GitHubAuth.TokenRecord {\n25|        // Fast path: another task already refreshed while we waited.\n26|        if let latest = await store.load(serverHost: config.serverHost, userID: userID, clientID: config.clientID),\n27|           latest.accessToken != current.accessToken {\n28|            return latest\n29|        }\n30|        if let flight = inFlight {\n31|            return try await flight.value\n32|        }\n33|        guard let refreshToken = current.refreshToken, !refreshToken.isEmpty else {\n34|            throw GitHubAuth.AuthError.tokenRefreshFailed\n35|        }\n36|        let transportCopy = transport\n37|        let storeCopy = store\n38|        let nowCopy = now\n39|        let task: Task<GitHubAuth.TokenRecord, Error> = Task {\n40|            let body = try JSONEncoder().encode(GitHubAuth.TokenRefreshRequest(\n41|                client_id: config.clientID,\n42|                grant_type: \"refresh_token\",\n43|                refresh_token: refreshToken\n44|            ))\n45|            let request = GitHubHTTPRequest(\n46|                method: \"POST\",\n47|                url: config.tokenURL,\n48|                headers: [\"Accept\": \"application/json\", \"Content-Type\": \"application/json\"],\n49|                body: body\n50|            )\n51|            let response: GitHubHTTPResponse\n52|            do {\n53|                response = try await transportCopy.send(request)\n54|            } catch {\n55|                throw GitHubAuth.AuthError.network(GitHubTransportError.offline.localizedDescription)\n56|            }\n57|            let decoded: GitHubAuth.TokenSuccessResponse\n58|            do {\n59|                decoded = try JSONDecoder().decode(GitHubAuth.TokenSuccessResponse.self, from: response.body)\n60|            } catch {\n61|                throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n62|            }\n63|            if let token = decoded.access_token, !token.isEmpty {\n64|                try GitHubAuth.PATGuard.validate(token: token)\n65|                let expiresAt: Date?\n66|                if let seconds = decoded.expires_in {\n67|                    expiresAt = nowCopy().addingTimeInterval(TimeInterval(seconds))\n68|                } else {\n69|                    expiresAt = nil\n70|                }\n71|                let next = GitHubAuth.TokenRecord(\n72|                    accessToken: token,\n73|                    refreshToken: decoded.refresh_token ?? refreshToken,\n74|                    expiresAt: expiresAt,\n75|                    obtainedAt: nowCopy()\n76|                )\n77|                try await storeCopy.save(next, serverHost: config.serverHost, userID: userID, clientID: config.clientID)\n78|                return next\n79|            }\n80|            if decoded.error == \"invalid_grant\" {\n81|                throw GitHubAuth.AuthError.revoked\n82|            }\n83|            throw GitHubAuth.AuthError.tokenRefreshFailed\n84|        }\n85|        inFlight = task\n86|        do {\n87|            let value = try await task.value\n88|            inFlight = nil\n89|            return value\n90|        } catch {\n91|            inFlight = nil\n92|            throw error\n93|        }\n94|    }\n95|\n96|    public static func isExpiringSoon(_ record: GitHubAuth.TokenRecord, now: Date = Date(), within seconds: TimeInterval = 60) -> Bool {\n97|        guard let expiresAt = record.expiresAt else { return false }\n98|        return expiresAt.timeIntervalSince(now) <= seconds\n99|    }\n100|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bd","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":313,"recorded_at":1780531400000621,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"call_id":"call_01a0a8247db571df8b1e248ed5c060ed","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubTransport.swift`.\n1|import Foundation\n2|\n3|/// Minimal HTTP boundary for GitHub Device Flow and REST. Keeps URLSession out of business logic.\n4|public protocol GitHubHTTPTransport: Sendable {\n5|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse\n6|}\n7|\n8|public struct GitHubHTTPRequest: Sendable {\n9|    public let method: String\n10|    public let url: URL\n11|    public let headers: [String: String]\n12|    public let body: Data?\n13|    public init(method: String, url: URL, headers: [String: String] = [:], body: Data? = nil) {\n14|        self.method = method; self.url = url; self.headers = headers; self.body = body\n15|    }\n16|}\n17|\n18|public struct GitHubHTTPResponse: Sendable {\n19|    public let status: Int\n20|    public let headers: [String: String]\n21|    public let body: Data\n22|    public init(status: Int, headers: [String: String] = [:], body: Data = Data()) {\n23|        self.status = status; self.headers = headers; self.body = body\n24|    }\n25|}\n26|\n27|public enum GitHubTransportError: LocalizedError, Sendable, Equatable {\n28|    case offline\n29|    case invalidResponse\n30|    public var errorDescription: String? {\n31|        switch self {\n32|        case .offline: \"Network unavailable. Local runner control still works.\"\n33|        case .invalidResponse: \"Unexpected GitHub response.\"\n34|        }\n35|    }\n36|}\n37|\n38|extension GitHubAuth {\n39|    // MARK: - Device DTOs\n40|\n41|    public struct DeviceCodeRequest: Encodable, Sendable {\n42|        public let client_id: String\n43|        public init(client_id: String) { self.client_id = client_id }\n44|    }\n45|\n46|    public struct DeviceCodeResponse: Decodable, Sendable {\n47|        public let device_code: String\n48|        public let user_code: String\n49|        public let verification_uri: String\n50|        public let expires_in: Int\n51|        public let interval: Int\n52|        public init(device_code: String, user_code: String, verification_uri: String, expires_in: Int, interval: Int) {\n53|            self.device_code = device_code; self.user_code = user_code; self.verification_uri = verification_uri\n54|            self.expires_in = expires_in; self.interval = interval\n55|        }\n56|    }\n57|\n58|    public struct TokenPollRequest: Encodable, Sendable {\n59|        public let client_id: String\n60|        public let device_code: String\n61|        public let grant_type: String\n62|        public init(client_id: String, device_code: String, grant_type: String) {\n63|            self.client_id = client_id; self.device_code = device_code; self.grant_type = grant_type\n64|        }\n65|    }\n66|\n67|    public struct TokenRefreshRequest: Encodable, Sendable {\n68|        public let client_id: String\n69|        public let grant_type: String\n70|        public let refresh_token: String\n71|        public init(client_id: String, grant_type: String, refresh_token: String) {\n72|            self.client_id = client_id; self.grant_type = grant_type; self.refresh_token = refresh_token\n73|        }\n74|    }\n75|\n76|    public struct TokenSuccessResponse: Decodable, Sendable {\n77|        public let access_token: String?\n78|        public let refresh_token: String?\n79|        public let expires_in: Int?\n80|        public let token_type: String?\n81|        public let error: String?\n82|        public let error_description: String?\n83|        public let interval: Int?\n84|        public init(access_token: String? = nil, refresh_token: String? = nil, expires_in: Int? = nil, token_type: String? = nil, error: String? = nil, error_description: String? = nil, interval: Int? = nil) {\n85|            self.access_token = access_token; self.refresh_token = refresh_token; self.expires_in = expires_in\n86|            self.token_type = token_type; self.error = error; self.error_description = error_description; self.interval = interval\n87|        }\n88|    }\n89|\n90|    public struct UserResponse: Decodable, Sendable {\n91|        public let login: String\n92|        public let id: Int64\n93|        public init(login: String, id: Int64) { self.login = login; self.id = id }\n94|    }\n95|\n96|    public struct InstallationsResponse: Decodable, Sendable {\n97|        public let installations: [InstallationDTO]\n98|        public init(installations: [InstallationDTO]) { self.installations = installations }\n99|    }\n100|\n101|    public struct InstallationDTO: Decodable, Sendable {\n102|        public let id: Int64\n103|        public let account: AccountDTO\n104|        public init(id: Int64, account: AccountDTO) { self.id = id; self.account = account }\n105|    }\n106|\n107|    public struct AccountDTO: Decodable, Sendable {\n108|        public let login: String\n109|        public let type: String\n110|        public init(login: String, type: String) { self.login = login; self.type = type }\n111|    }\n112|\n113|    public struct RepositoriesResponse: Decodable, Sendable {\n114|        public let repositories: [RepositoryDTO]\n115|        public init(repositories: [RepositoryDTO]) { self.repositories = repositories }\n116|    }\n117|\n118|    public struct RepositoryDTO: Decodable, Sendable {\n119|        public let id: Int64\n120|        public let full_name: String\n121|        public let `private`: Bool\n122|        public init(id: Int64, full_name: String, isPrivate: Bool) { self.id = id; self.full_name = full_name; self.private = isPrivate }\n123|    }\n124|}\n125|\n126|/// Production URLSession transport. Never logs bodies (they may contain tokens).\n127|public actor URLSessionGitHubTransport: GitHubHTTPTransport {\n128|    private let session: URLSession\n129|    public init(session: URLSession = .shared) { self.session = session }\n130|    public func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n131|        var urlRequest = URLRequest(url: request.url)\n132|        urlRequest.httpMethod = request.method\n133|        urlRequest.httpBody = request.body\n134|        for (key, value) in request.headers { urlRequest.setValue(value, forHTTPHeaderField: key) }\n135|        let (data, response): (Data, URLResponse)\n136|        do {\n137|            (data, response) = try await session.data(for: urlRequest)\n138|        } catch {\n139|            throw GitHubTransportError.offline\n140|        }\n141|        guard let http = response as? HTTPURLResponse else { throw GitHubTransportError.invalidResponse }\n142|        var headers: [String: String] = [:]\n143|        for (key, value) in http.allHeaderFields {\n144|            if let k = key as? String, let v = value as? String { headers[k] = v }\n145|        }\n146|        return GitHubHTTPResponse(status: http.statusCode, headers: headers, body: data)\n147|    }\n148|}\n149|\n150|extension GitHubAuth {\n151|    /// Maps REST status codes to typed auth errors. Local runners are never touched here.\n152|    public enum RESTMapper {\n153|        public static func map(status: Int, body: Data) -> AuthError? {\n154|            if status == 401 { return .unauthorized }\n155|            if status == 403 {\n156|                let text = String(decoding: body, as: UTF8.self).lowercased()\n157|                if text.contains(\"saml\") || text.contains(\"sso\") { return .ssoRequired }\n158|                if text.contains(\"rate limit\") || text.contains(\"rate_limit\") { return .rateLimited(retryAfter: nil) }\n159|                let message = String(decoding: body, as: UTF8.self)\n160|                let short = String(message.prefix(300))\n161|                return .forbidden(short)\n162|            }\n163|            if status == 429 { return .rateLimited(retryAfter: nil) }\n164|            return nil\n165|        }\n166|    }\n167|\n168|    /// Rejects personal access tokens. Only Device Flow user tokens (ghu_) are accepted.\n169|    public enum PATGuard {\n170|        public static func validate(token: String) throws {\n171|            if token.hasPrefix(\"ghp_\") || token.hasPrefix(\"github_pat_\") {\n172|                throw AuthError.patNotSupported\n173|            }\n174|        }\n175|\n176|        public static func authorizationHeader(token: String) throws -> String {\n177|            try validate(token: token)\n178|            return \"Bearer \\(token)\"\n179|        }\n180|    }\n181|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bf","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":314,"recorded_at":1780531400000623,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"call_id":"call_01a0a8247f4b7441af51dffca3b63d20","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubKeychainStore.swift`.\n1|import Foundation\n2|import Security\n3|\n4|/// Keychain-backed credential store. Secret values never enter Relux state or logs.\n5|public protocol GitHubCredentialStoring: Sendable {\n6|    func save(_ record: GitHubAuth.TokenRecord, serverHost: String, userID: Int64, clientID: String) async throws\n7|    func load(serverHost: String, userID: Int64, clientID: String) async -> GitHubAuth.TokenRecord?\n8|    func delete(serverHost: String, userID: Int64, clientID: String) async\n9|    func deleteAll(serverHost: String, clientID: String) async\n10|}\n11|\n12|public actor GitHubKeychainStore: GitHubCredentialStoring {\n13|    private let service: String\n14|    private let backend: any KeychainBackend\n15|\n16|    public init(service: String = \"works.relux.runnercontrol.github-token\", backend: (any KeychainBackend)? = nil) {\n17|        self.service = service\n18|        self.backend = backend ?? SecurityKeychainBackend()\n19|    }\n20|\n21|    public static func account(serverHost: String, userID: Int64, clientID: String) -> String {\n22|        \"\\(serverHost):\\(userID):\\(clientID)\"\n23|    }\n24|\n25|    private func account(serverHost: String, userID: Int64, clientID: String) -> String {\n26|        Self.account(serverHost: serverHost, userID: userID, clientID: clientID)\n27|    }\n28|\n29|    public func save(_ record: GitHubAuth.TokenRecord, serverHost: String, userID: Int64, clientID: String) async throws {\n30|        let data = try JSONEncoder().encode(record)\n31|        try backend.save(data, service: service, account: account(serverHost: serverHost, userID: userID, clientID: clientID))\n32|    }\n33|\n34|    public func load(serverHost: String, userID: Int64, clientID: String) async -> GitHubAuth.TokenRecord? {\n35|        guard let data = backend.load(service: service, account: account(serverHost: serverHost, userID: userID, clientID: clientID)) else { return nil }\n36|        return try? JSONDecoder().decode(GitHubAuth.TokenRecord.self, from: data)\n37|    }\n38|\n39|    public func delete(serverHost: String, userID: Int64, clientID: String) async {\n40|        backend.delete(service: service, account: account(serverHost: serverHost, userID: userID, clientID: clientID))\n41|    }\n42|\n43|    public func deleteAll(serverHost: String, clientID: String) async {\n44|        // Best-effort sweep: Keychain has no wildcard delete; callers pass known userIDs.\n45|        // This entry point exists so logout can clear without knowing the user when needed\n46|        // by enumerating via backend when supported.\n47|        backend.deleteMatching(service: service, accountPrefix: \"\\(serverHost):\", accountSuffix: \":\\(clientID)\")\n48|    }\n49|}\n50|\n51|/// Injectable Keychain boundary for tests.\n52|public protocol KeychainBackend: Sendable {\n53|    func save(_ data: Data, service: String, account: String) throws\n54|    func load(service: String, account: String) -> Data?\n55|    func delete(service: String, account: String)\n56|    func deleteMatching(service: String, accountPrefix: String, accountSuffix: String)\n57|}\n58|\n59|public struct SecurityKeychainBackend: KeychainBackend, Sendable {\n60|    public init() {}\n61|    public func save(_ data: Data, service: String, account: String) throws {\n62|        let query: [String: Any] = [kSecClass as String: kSecClassGenericPassword, kSecAttrService as String: service, kSecAttrAccount as String: account]\n63|        SecItemDelete(query as CFDictionary)\n64|        var add = query\n65|        add[kSecValueData as String] = data\n66|        add[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlock\n67|        let status = SecItemAdd(add as CFDictionary, nil)\n68|        guard status == errSecSuccess else { throw GitHubKeychainError.saveFailed(status) }\n69|    }\n70|    public func load(service: String, account: String) -> Data? {\n71|        let query: [String: Any] = [\n72|            kSecClass as String: kSecClassGenericPassword,\n73|            kSecAttrService as String: service,\n74|            kSecAttrAccount as String: account,\n75|            kSecReturnData as String: true,\n76|            kSecMatchLimit as String: kSecMatchLimitOne,\n77|        ]\n78|        var item: CFTypeRef?\n79|        guard SecItemCopyMatching(query as CFDictionary, &item) == errSecSuccess else { return nil }\n80|        return item as? Data\n81|    }\n82|    public func delete(service: String, account: String) {\n83|        let query: [String: Any] = [kSecClass as String: kSecClassGenericPassword, kSecAttrService as String: service, kSecAttrAccount as String: account]\n84|        SecItemDelete(query as CFDictionary)\n85|    }\n86|    public func deleteMatching(service: String, accountPrefix: String, accountSuffix: String) {\n87|        let query: [String: Any] = [\n88|            kSecClass as String: kSecClassGenericPassword,\n89|            kSecAttrService as String: service,\n90|            kSecReturnAttributes as String: true,\n91|            kSecMatchLimit as String: kSecMatchLimitAll,\n92|        ]\n93|        var items: CFTypeRef?\n94|        guard SecItemCopyMatching(query as CFDictionary, &items) == errSecSuccess,\n95|              let list = items as? [[String: Any]] else { return }\n96|        for entry in list {\n97|            if let account = entry[kSecAttrAccount as String] as? String,\n98|               account.hasPrefix(accountPrefix), account.hasSuffix(accountSuffix) {\n99|                delete(service: service, account: account)\n100|            }\n101|        }\n102|    }\n103|}\n104|\n105|public enum GitHubKeychainError: LocalizedError, Sendable, Equatable {\n106|    case saveFailed(OSStatus)\n107|    public var errorDescription: String? { \"Could not save GitHub credentials in Keychain.\" }\n108|}\n109|\n110|/// In-memory backend for unit tests. Never used in production.\n111|public final class InMemoryKeychainBackend: KeychainBackend, @unchecked Sendable {\n112|    private let lock = NSLock()\n113|    private var storage: [String: Data] = [:]\n114|    public init() {}\n115|    private func key(service: String, account: String) -> String { \"\\(service)\\u{0}\\(account)\" }\n116|    public func save(_ data: Data, service: String, account: String) throws {\n117|        lock.withLock { storage[key(service: service, account: account)] = data }\n118|    }\n119|    public func load(service: String, account: String) -> Data? {\n120|        lock.withLock { storage[key(service: service, account: account)] }\n121|    }\n122|    public func delete(service: String, account: String) {\n123|        lock.withLock { _ = storage.removeValue(forKey: key(service: service, account: account)) }\n124|    }\n125|    public func deleteMatching(service: String, accountPrefix: String, accountSuffix: String) {\n126|        lock.withLock {\n127|            for key in storage.keys where key.hasPrefix(\"\\(service)\\u{0}\\(accountPrefix)\") && key.hasSuffix(accountSuffix) {\n128|                storage.removeValue(forKey: key)\n129|            }\n130|        }\n131|    }\n132|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
