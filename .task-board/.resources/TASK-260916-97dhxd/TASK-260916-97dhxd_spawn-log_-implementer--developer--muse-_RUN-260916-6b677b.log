{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c85b","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":648,"recorded_at":1780531400001291,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"task_stream":{"kind":"task","id":"01a0a825-b2ef-7cc2-88c3-bf5290f67fb0"},"task_id":"01a0a825-b2ef-7cc2-88c3-bf5290f67fb0","event":{"kind":"output","task_id":"01a0a825-b2ef-7cc2-88c3-bf5290f67fb0","chunk":"{\n  \"chunk_id\": \"exec-13-1\",\n  \"command\": \"grep -n \\\"GitHub\\\\|infoPlist\\\\|Info.plist\\\" Project.swift 2>&1 | head -n 30\\necho \\\"===\\\"\\nls *.swift *.xcworkspace 2>&1 | head\\necho \\\"===\\\"\\ncat Targets/RunnerControl/Sources/ManagementWindowPage.swift 2>&1 | head -n 80\",\n  \"description\": \"Inspect Project.swift plist wiring\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"23:            infoPlist: .extendingDefault(with: [\\n42:            infoPlist: .default,\\n52:            infoPlist: .default,\\n===\\nProject.swift\\nWorkspace.swift\\n\\nRunnerControl.xcworkspace:\\ncontents.xcworkspacedata\\nxcshareddata\\nxcuserdata\\n===\\nimport SwiftUI\\nimport RunnerControlCore\\n\\nstruct ManagementWindowPage: View {\\n    let props: Props\\n    let reactions: Reactions\\n    @State private var selection: Tab = .runners\\n\\n    enum Tab: Hashable {\\n        case runners, github, general\\n    }\\n\\n    var body: some View {\\n        TabView(selection: $selection) {\\n            runnersTab\\n                .tabItem { Label(\\\"Раннеры\\\", systemImage: \\\"bolt.circle\\\") }\\n                .tag(Tab.runners)\\n            githubTab\\n                .tabItem { Label(\\\"GitHub\\\", systemImage: \\\"person.circle\\\") }\\n                .tag(Tab.github)\\n            generalTab\\n                .tabItem { Label(\\\"Основные\\\", systemImage: \\\"gearshape\\\") }\\n                .tag(Tab.general)\\n        }\\n        .frame(width: 760, height: 540)\\n    }\\n\\n    // MARK: - Runners\\n\\n    private var active: Int { props.runners.filter { $0.status == .running }.count }\\n\\n    private var runnersTab: some View {\\n        VStack(alignment: .leading, spacing: 14) {\\n            HStack(spacing: 10) {\\n                VStack(alignment: .leading, spacing: 3) {\\n                    Text(\\\"Раннеры на этом Mac\\\").font(.system(size: 15, weight: .semibold))\\n                    Text(\\\"\\\\(Host.current().localizedName ?? \\\"Этот Mac\\\") · \\\\(active) из \\\\(props.runners.count) включено\\\")\\n                        .font(.system(size: 11)).foregroundStyle(.secondary)\\n                }\\n                Spacer()\\n                Circle().fill(active > 0 ? Color.green : Color.secondary.opacity(0.4)).frame(width: 8, height: 8)\\n            }\\n            if props.runners.isEmpty {\\n                VStack(alignment: .leading, spacing: 8) {\\n                    Text(\\\"Добавьте раннер на этом Mac\\\").font(.callout.weight(.medium))\\n                    Text(\\\"Учётная запись GitHub не обязательна. Локальное управление работает без входа.\\\")\\n                        .font(.callout).foregroundStyle(.secondary)\\n                }\\n                .padding(.vertical, 8)\\n            }\\n            ScrollView {\\n                VStack(spacing: 10) {\\n                    ForEach(props.runners) { runner in\\n                        RunnerCard(\\n                            snapshot: runner,\\n                            changing: props.changing.contains(runner.id),\\n                            setEnabled: { reactions.setEnabled(runner.id, $0) },\\n                            openGitHub: { reactions.openGitHub(runner.definition) },\\n                            openLogs: { reactions.openLogs(runner.definition) }\\n                        )\\n                    }\\n                }\\n            }\\n            if let error = props.runnerError {\\n                HStack(alignment: .top, spacing: 8) {\\n                    Image(systemName: \\\"exclamationmark.triangle.fill\\\").foregroundStyle(.orange)\\n                    Text(error).font(.caption).textSelection(.enabled).lineLimit(6)\\n                    Spacer(minLength: 0)\\n                    Button(action: reactions.clearRunnerError) { Image(systemName: \\\"xmark\\\") }.buttonStyle(.plain)\\n                }.padding(10).background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\\n            }\\n            HStack(spacing: 8) {\\n                Button(\\\"Включить все\\\", action: reactions.enableAll)\\n                    .buttonStyle(.borderedProminent).tint(.teal)\\n                    .disabled(!props.changing.isEmpty || props.runners.allSatisfy { $0.status == .running || $0.status == .checking || $0.status == .missing || $0.status == .unknown })\\n                Button(\\\"Выключить все…\\\", action: reactions.disableAll)\\n                    .buttonStyle(.bordered)\\n                    .disabled(!props.changing.isEmpty || props.runners.allSatisfy { $0.status == .stopped || $0.status == .checking })\\n            }\\n            Text(\\\"Закрытие приложения не останавливает CI. Автозапуск определяется настройками каждой службы.\\\")\\n\",\n  \"original_output_bytes\": 4292,\n  \"original_output_tokens\": 1073,\n  \"truncated\": false\n}","final_result":true}}}
