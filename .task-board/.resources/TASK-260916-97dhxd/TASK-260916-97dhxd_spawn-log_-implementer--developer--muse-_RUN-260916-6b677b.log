 accessToken, refreshToken: refreshToken, expiresAt: expiresAt, obtainedAt: now())\n191|        do {\n192|            try await store.save(record, serverHost: config.serverHost, userID: user.id, clientID: config.clientID)\n193|        } catch {\n194|            guard generation == gen else { return }\n195|            deviceCode = nil\n196|            await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .retry) }\n197|            return\n198|        }\n199|        session = GitHubAuth.Session(userID: user.id, username: user.login, serverHost: config.serverHost, config: config)\n200|        await identities.save(GitHubSessionIdentity(serverHost: config.serverHost, userID: user.id, clientID: config.clientID, username: user.login))\n201|        deviceCode = nil\n202|        await action { GitHubAuth.Action.accountVerified(username: user.login, userID: user.id, serverHost: config.serverHost) }\n203|        guard generation == gen else { return }\n204|        do {\n205|            let installations = try await api.fetchInstallations(config: config, token: accessToken)\n206|            guard generation == gen else { return }\n207|            await action { GitHubAuth.Action.installationsLoaded(installations) }\n208|            if let first = installations.first {\n209|                do {\n210|                    let repos = try await api.fetchRepositories(config: config, token: accessToken, installationID: first.id)\n211|                    guard generation == gen else { return }\n212|                    await action { GitHubAuth.Action.repositoriesLoaded(installationID: first.id, repositories: repos) }\n213|                } catch let error as GitHubAuth.AuthError {\n214|                    guard generation == gen else { return }\n215|                    await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n216|                } catch {\n217|                    guard generation == gen else { return }\n218|                    await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n219|                }\n220|            } else {\n221|                await action { GitHubAuth.Action.syncFailed(message: GitHubAuth.AuthError.needsInstallation.localizedDescription) }\n222|            }\n223|            await action { GitHubAuth.Action.connected(username: user.login, serverHost: config.serverHost, syncedAt: now()) }\n224|        } catch let error as GitHubAuth.AuthError {\n225|            guard generation == gen else { return }\n226|            switch error {\n227|            case .unauthorized, .revoked:\n228|                await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .relogin) }\n229|            default:\n230|                await action { GitHubAuth.Action.installationsLoaded([]) }\n231|                await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n232|                await action { GitHubAuth.Action.connected(username: user.login, serverHost: config.serverHost, syncedAt: now()) }\n233|            }\n234|        } catch {\n235|            guard generation == gen else { return }\n236|            await action { GitHubAuth.Action.installationsLoaded([]) }\n237|            await action { GitHubAuth.Action.syncFailed(message: error.localizedDescription) }\n238|            await action { GitHubAuth.Action.connected(username: user.login, serverHost: config.serverHost, syncedAt: now()) }\n239|        }\n240|    }\n241|\n242|    private func cancelLogin() async {\n(more lines below)","final_result":true}}}
