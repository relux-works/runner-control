logger.actions.count >= count { return true }\n31|        try? await Task.sleep(for: .milliseconds(20))\n32|    }\n33|    return logger.actions.count >= count\n34|}\n35|\n36|private func githubActions(_ logger: Relux.Testing.Logger) -> [GitHubAuth.Action] {\n37|    logger.actions.compactMap { $0 as? GitHubAuth.Action }\n38|}\n39|\n40|// MARK: - Reducer\n41|\n42|@Test @MainActor func githubReducerCoversLoginLifecycleAndIgnoresForeignActions() async {\n43|    let state = GitHubAuth.State()\n44|    let before = state.connection\n45|    await state.reduce(with: ForeignAction())\n46|    #expect(state.connection == before)\n47|    await state.reduce(with: GitHubAuth.Action.loginStarted(serverHost: \"github.com\"))\n48|    guard case .requestingCode = state.connection else { Issue.record(\"Expected requestingCode\"); return }\n49|    let uri = URL(string: \"https://github.com/login/device\")!\n50|    await state.reduce(with: GitHubAuth.Action.codeReceived(userCode: \"ABCD-1234\", verificationURI: uri, expiresIn: 900, interval: 5))\n51|    guard case .awaitingUser(let code, _, _, let interval) = state.connection, code == \"ABCD-1234\", interval == 5 else {\n52|        Issue.record(\"Expected awaitingUser\"); return\n53|    }\n54|    await state.reduce(with: GitHubAuth.Action.pollIntervalUpdated(10))\n55|    guard case .awaitingUser(_, _, _, let updated) = state.connection, updated == 10 else {\n56|        Issue.record(\"Expected interval 10\"); return\n57|    }\n58|    await state.reduce(with: GitHubAuth.Action.accountVerified(username: \"octo\", userID: 42, serverHost: \"github.com\"))\n59|    #expect(state.username == \"octo\")\n60|    await state.reduce(with: GitHubAuth.Action.installationsLoaded([.init(id: 7, account: \"acme\", accountType: \"Organization\")]))\n61|    #expect(state.selectedInstallationID == 7)\n62|    await state.reduce(with: GitHubAuth.Action.repositoriesLoaded(installationID: 7, repositories: [.init(id: 9, fullName: \"acme/app\", isPrivate: true)]))\n63|    #expect(state.repositories.count == 1)\n64|    await state.reduce(with: GitHubAuth.Action.connected(username: \"octo\", serverHost: \"github.com\", syncedAt: Date()))\n65|    guard case .connected = state.connection else { Issue.record(\"Expected connected\"); return }\n66|    await state.reduce(with: GitHubAuth.Action.syncFailed(message: \"stale\"))\n67|    #expect(state.syncError == \"stale\")\n68|    guard case .connected = state.connection else { Issue.record(\"syncFailed must preserve connected\"); return }\n69|    await state.reduce(with: GitHubAuth.Action.installationSelected(7))\n70|    await state.reduce(with: GitHubAuth.Action.repositoriesSelected([9]))\n71|    #expect(state.selectedRepositoryIDs == [9])\n72|    await state.reduce(with: GitHubAuth.Action.failed(message: \"denied\", retry: .newCode))\n73|    guard case .failed(_, let retry) = state.connection, retry == .newCode else { Issue.record(\"Expected failed newCode\"); return }\n74|    await state.reduce(with: GitHubAuth.Action.loggedOut)\n75|    guard case .disconnected = state.connection else { Issue.record(\"Expected disconnected\"); return }\n76|    #expect(state.username == nil)\n77|    await state.cleanup()\n78|    #expect(state.installations.isEmpty)\n79|}\n80|\n81|// MARK: - Flow: success + 401/403 + logout\n82|\n83|@Test func flowLoginSuccessDrivesProductionEffectsToConnected() async throws {\n84|    let transport = TestTransport([\n85|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n86|        jsonResponse([\"access_token\": \"ghu_x\", \"refresh_token\": \"ghr_y\", \"expires_in\": 3600]),\n87|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n88|        jsonResponse([\"installations\": [[\"id\": 7, \"account\": [\"login\": \"acme\", \"type\": \"Organization\"]]]]),\n89|        jsonResponse([\"repositories\": [[\"id\": 9, \"full_name\": \"acme/app\", \"private\": false]]]),\n90|    ])\n91|    let (flow, logger, store) = await githubHarness(transport: transport)\n92|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n93|    #expect(await waitForLoggedActions(logger, count: 6))\n94|    let actions = githubActions(logger)\n95|    guard case .loginStarted = actions[0], case .codeReceived = actions[1] else {\n96|        Issue.record(\"Login did not emit started/code, got \\(actions)\"); return\n97|    }\n98|    #expect(actions.contains { if case .connected(let user, _, _) = $0, user == \"octo\" { true } else { false } })\n99|    #expect(await store.load(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID)?.accessToken == \"ghu_x\")\n100|    // No Runners actions leak from the GitHub flow.\n101|    #expect(logger.actions.allSatisfy { $0 is GitHubAuth.Action })\n102|}\n103|\n104|@Test func flowExpiredCodeFailsWithNewCode() async {\n105|    let transport = TestTransport([\n106|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n107|        jsonResponse([\"error\": \"expired_token\"]),\n108|    ])\n109|    let (flow, logger, _) = await githubHarness(transport: transport)\n110|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n111|    #expect(await waitForLoggedActions(logger, count: 3))\n112|    let actions = githubActions(logger)\n113|    guard case .failed(let message, let retry) = actions.last, retry == .newCode else {\n114|        Issue.record(\"Expected failed newCode, got \\(actions)\"); return\n115|    }\n116|    #expect(message.contains(\"expired\"))\n117|}\n118|\n119|@Test func flowDeniedFailsWithNewCode() async {\n120|    let transport = TestTransport([\n121|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n122|        jsonResponse([\"error\": \"access_denied\"]),\n123|    ])\n124|    let (flow, logger, _) = await githubHarness(transport: transport)\n125|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n126|    #expect(await waitForLoggedActions(logger, count: 3))\n127|    guard case .failed(_, let retry) = githubActions(logger).last, retry == .newCode else {\n128|        Issue.record(\"Expected denied newCode\"); return\n129|    }\n130|}\n131|\n132|final class SleepRecorder: @unchecked Sendable {\n133|    private let lock = NSLock()\n134|    private var values: [UInt64] = []\n135|    func append(_ value: UInt64) { lock.withLock { values.append(value) } }\n136|    var snapshot: [UInt64] { lock.withLock { values } }\n137|}\n138|\n139|@Test func flowSlowDownIncreasesIntervalThenSucceeds() async throws {\n140|    let transport = TestTransport([\n141|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 5]),\n142|        jsonResponse([\"error\": \"slow_down\"]),\n143|        jsonResponse([\"access_token\": \"ghu_x\", \"expires_in\": 3600]),\n144|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n145|        jsonResponse([\"installations\": []]),\n146|    ])\n147|    let recorder = SleepRecorder()\n148|    let (flow, logger, _) = await githubHarness(transport: transport, sleeper: { nanos in\n149|        recorder.append(nanos)\n150|    })\n151|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n152|    #expect(await waitForLoggedActions(logger, count: 5))\n153|    let actions = githubActions(logger)\n154|    guard actions.contains(where: { if case .pollIntervalUpdated(let v) = $0, v == 10 { true } else { false } }) else {\n155|        Issue.record(\"Expected pollIntervalUpdated(10), got \\(actions)\"); return\n156|    }\n157|    let observed = recorder.snapshot\n158|    #expect(observed.count >= 2)\n159|    #expect(observed[0] == 5_000_000_000)\n160|    #expect(observed[1] == 10_000_000_000)\n161|}\n162|\n163|@Test func flowCancellationDestroysCodeAndStopsPoll() async throws {\n164|    // Cancel lands during the first poll sleep, so no poll consumes the queue.\n165|    // Queue order is therefore [code1, code2, ...second-login polls].\n166|    let transport = TestTransport([\n167|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 5]),\n168|        jsonResponse([\"device_code\": \"dev2\", \"user_code\": \"USER-2\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 60]),\n169|        jsonResponse([\"error\": \"authorization_pending\"]),\n170|        jsonResponse([\"error\": \"authorization_pending\"]),\n171|    ])\n172|    let (flow, logger, _) = await githubHarness(transport: transport, sleeper: { _ in\n173|        try await Task.sleep(for: .milliseconds(200))\n174|    })\n175|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n176|    _ = await waitForLoggedActions(logger, count: 2)\n177|    _ = await flow.apply(GitHubAuth.Effect.cancelLogin)\n178|    _ = await waitForLoggedActions(logger, count: 3)\n179|    // Second login must request a fresh code (old device_code destroyed, not reused).\n180|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n181|    #expect(await waitForLoggedActions(logger, count: 5))\n182|    let actions = githubActions(logger)\n183|    #expect(actions.contains { if case .loginCancelled = $0 { true } else { false } })\n184|    let codes = actions.compactMap { action -> String? in if case .codeReceived(let code, _, _, _) = action { code } else { nil } }\n185|    #expect(codes == [\"USER-1\", \"USER-2\"])\n186|    #expect(!actions.contains { if case .connected = $0 { true } else { false } })\n187|    _ = await flow.apply(GitHubAuth.Effect.cancelLogin)\n188|}\n189|\n190|@Test func flowCancelWhileConnectedRestoresConnected() async throws {\n191|    let transport = TestTransport([\n192|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n193|        jsonResponse([\"access_token\": \"ghu_x\", \"expires_in\": 3600]),\n194|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n195|        jsonResponse([\"installations\": []]),\n196|    ])\n197|    let (flow, logger, _) = await githubHarness(transport: transport)\n198|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n199|    #expect(await waitForLoggedActions(logger, count: 5))\n200|    _ = await flow.apply(GitHubAuth.Effect.cancelLogin)\n201|    #expect(await waitForLoggedActions(logger, count: 6))\n202|    guard case .connected(let user, _, _) = githubActions(logger).last, user == \"octo\" else {\n203|        Issue.record(\"Cancel while connected must restore connected, got \\(githubActions(logger))\"); return\n204|    }\n205|}\n206|\n207|@Test func flowLogoutClearsKeychainAndStopsSync() async throws {\n208|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n209|    let transport = TestTransport([\n210|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n211|        jsonResponse([\"access_token\": \"ghu_x\", \"refresh_token\": \"ghr_y\", \"expires_in\": 3600]),\n212|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n213|        jsonResponse([\"installations\": []]),\n214|    ])\n215|    let (flow, logger, credentialStore) = await githubHarness(transport: transport, store: store)\n216|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n217|    #expect(await waitForLoggedActions(logger, count: 5))\n218|    #expect(await credentialStore.load(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID) != nil)\n219|    _ = await flow.apply(GitHubAuth.Effect.logout)\n220|    _ = await waitForLoggedActions(logger, count: 6)\n221|    #expect(githubActions(logger).last.map { if case .loggedOut = $0 { true } else { false } } == true)\n222|    #expect(await credentialStore.load(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID) == nil)\n223|    // Post-logout refresh is a no-op (background ops stopped).\n224|    let before = logger.actions.count\n225|    _ = await flow.apply(GitHubAuth.Effect.refreshInstallations)\n226|    try await Task.sleep(for: .milliseconds(100))\n227|    #expect(logger.actions.count == before)\n228|}\n229|\n230|@Test func flow401DuringRefreshRequiresRelogin() async {\n231|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n232|    let record = GitHubAuth.TokenRecord(accessToken: \"ghu_old\", refreshToken: nil, expiresAt: nil)\n233|    await store.saveForTest(record, userID: 42)\n234|    let transport = TestTransport([\n235|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n236|        jsonResponse([\"access_token\": \"ghu_x\", \"expires_in\": 3600]),\n237|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n238|        jsonResponse([\"installations\": []]),\n239|        GitHubHTTPResponse(status: 401, body: Data()),\n240|    ])\n241|    let (flow, logger, _) = await githubHarness(transport: transport, store: store)\n242|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n243|    #expect(await waitForLoggedActions(logger, count: 5))\n244|    _ = await flow.apply(GitHubAuth.Effect.refreshInstallations)\n245|    #expect(await waitForLoggedActions(logger, count: 6))\n246|    guard case .failed(_, let retry) = githubActions(logger).last, retry == .relogin else {\n247|        Issue.record(\"Expected 401 relogin, got \\(githubActions(logger))\"); return\n248|    }\n249|}\n250|\n251|@Test func flow403DuringRefreshKeepsConnectedWithStaleError() async throws {\n252|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n253|    let transport = TestTransport([\n254|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n255|        jsonResponse([\"access_token\": \"ghu_x\", \"expires_in\": 3600]),\n256|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n257|        jsonResponse([\"installations\": []]),\n258|        GitHubHTTPResponse(status: 403, body: Data(\"forbidden\".utf8)),\n259|    ])\n260|    let (flow, logger, _) = await githubHarness(transport: transport, store: store)\n261|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n262|    #expect(await waitForLoggedActions(logger, count: 5))\n263|    _ = await flow.apply(GitHubAuth.Effect.refreshInstallations)\n264|    #expect(await waitForLoggedActions(logger, count: 6))\n265|    let actions = githubActions(logger)\n266|    guard case .syncFailed = actions.last else {\n267|        Issue.record(\"Expected syncFailed on 403, got \\(actions)\"); return\n268|    }\n269|    // Reducer proof: syncFailed preserves connected (local control unaffected).\n270|    let state = await MainActor.run { GitHubAuth.State() }\n271|    for action in actions { await state.reduce(with: action) }\n272|    let connection = await MainActor.run { state.connection }\n273|    guard case .connected = connection else {\n274|        Issue.record(\"403 must not disconnect\"); return\n275|    }\n276|}\n277|\n278|@Test func flowMissingClientIDFailsWithExactBinding() async {\n279|    let logger = Relux.Testing.Logger()\n280|    let dispatcher = Relux.Dispatcher(logger: logger)\n281|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n282|    let transport = TestTransport([])\n283|    let flow = await GitHubAuth.Flow(\n284|        deviceFlow: GitHubDeviceFlow(transport: transport),\n285|        api: GitHubAPIClient(transport: transport),\n286|        refresher: GitHubTokenRefresh(transport: transport, store: store),\n287|        store: store,\n288|        configProvider: { _ in throw GitHubAuth.ConfigError.missingClientID(binding: GitHubAuth.AppConfig.missingBindingHelp) },\n289|        sleeper: { _ in },\n290|        dispatcher: dispatcher\n291|    )\n292|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n293|    #expect(await waitForLoggedActions(logger, count: 1))\n294|    guard case .failed(let message, let retry) = githubActions(logger).first, retry == .none else {\n295|        Issue.record(\"Expected missing-binding failure\"); return\n296|    }\n297|    #expect(message.contains(\"ios-app-manager.json\"))\n298|}\n299|\n300|@Test func flowIgnoresForeignEffectsAndSelectsRepositories() async {\n301|    let (flow, logger, _) = await githubHarness(transport: TestTransport([]))\n302|    let result: Relux.ActionResult = await flow.apply(ForeignEffect())\n303|    _ = result\n304|    #expect(logger.actions.isEmpty)\n305|    _ = await flow.apply(GitHubAuth.Effect.selectRepositories([9]))\n306|    #expect(await waitForLoggedActions(logger, count: 1))\n307|    guard case .repositoriesSelected(let ids) = githubActions(logger).first, ids == [9] else {\n308|        Issue.record(\"Expected repositoriesSelected\"); return\n309|    }\n310|}\n311|\n312|@Test @MainActor func githubModuleRegistersStateAndFlow() async {\n313|    let state = GitHubAuth.State()\n314|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n315|    let transport = TestTransport([])\n316|    let dispatcher = Relux.Dispatcher(logger: Relux.Testing.Logger())\n317|    let flow = await GitHubAuth.Flow(\n318|        deviceFlow: GitHubDeviceFlow(transport: transport),\n319|        api: GitHubAPIClient(transport: transport),\n320|        refresher: GitHubTokenRefresh(transport: transport, store: store),\n321|        store: store,\n322|        configProvider: { _ in testConfig },\n323|        sleeper: { _ in },\n324|        dispatcher: dispatcher\n325|    )\n326|    let module = GitHubAuth.Module(state: state, flow: flow)\n327|    #expect(module.states.count == 1)\n328|    #expect(module.sagas.count == 1)\n329|}\n330|\n331|private extension GitHubKeychainStore {\n332|    func saveForTest(_ record: GitHubAuth.TokenRecord, userID: Int64) async {\n333|        try? await save(record, serverHost: \"github.com\", userID: userID, clientID: testConfig.clientID)\n334|    }\n335|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e3","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":460,"recorded_at":1780531400000915,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"call_id":"call_01a0a824af25748cbe061a7e7b8dffb8","text":"Read text file `Packages/RunnerControlCore/Tests/GitHubTransportTests.swift`.\n1|import Foundation\n2|import Testing\n3|@testable import RunnerControlCore\n4|\n5|// MARK: - Shared fakes\n6|\n7|actor TestTransport: GitHubHTTPTransport {\n8|    private var queue: [GitHubHTTPResponse]\n9|    private(set) var requests: [GitHubHTTPRequest] = []\n10|    init(_ responses: [GitHubHTTPResponse]) { self.queue = responses }\n11|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n12|        requests.append(request)\n13|        guard !queue.isEmpty else { throw GitHubTransportError.invalidResponse }\n14|        return queue.removeFirst()\n15|    }\n16|    func prepend(_ response: GitHubHTTPResponse) { queue.insert(response, at: 0) }\n17|    func append(_ response: GitHubHTTPResponse) { queue.append(response) }\n18|}\n19|\n20|func jsonResponse(_ object: Any, status: Int = 200) -> GitHubHTTPResponse {\n21|    let data = try! JSONSerialization.data(withJSONObject: object)\n22|    return GitHubHTTPResponse(status: status, body: data)\n23|}\n24|\n25|let testConfig = GitHubAuth.AppConfig(clientID: \"test-client-id\")\n26|\n27|// MARK: - Config\n28|\n29|@Test func configReportsExactMissingBinding() {\n30|    let bundle = Bundle.main\n31|    // Production bundle has no GitHubAppClientID until coordinator provisions it.\n32|    // Assert the thrown binding names the exact scaffold input.\n33|    let raw = bundle.object(forInfoDictionaryKey: \"GitHubAppClientID\") as? String\n34|    if let raw, !raw.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {\n35|        // Provisioned environment: config must load.\n36|        #expect((try? GitHubAuth.AppConfig.current(bundle: bundle)) != nil)\n37|    } else {\n38|        do {\n39|            _ = try GitHubAuth.AppConfig.current(bundle: bundle)\n40|            Issue.record(\"Expected missingClientID when plist key is absent/empty\")\n41|        } catch let error as GitHubAuth.ConfigError {\n42|            guard case .missingClientID(let binding) = error else {\n43|                Issue.record(\"Wrong config error: \\(error)\"); return\n44|            }\n45|            #expect(binding == GitHubAuth.AppConfig.missingBindingHelp)\n46|            #expect(binding.contains(\"ios-app-manager.json\"))\n47|            #expect(binding.contains(\"GitHubAppClientID\"))\n48|        } catch {\n49|            Issue.record(\"Unexpected error: \\(error)\")\n50|        }\n51|    }\n52|}\n53|\n54|@Test func enterpriseConfigUsesHostScopedEndpoints() {\n55|    let config = GitHubAuth.AppConfig(clientID: \"pub\", serverHost: \"ghe.example.com\")\n56|    #expect(config.deviceAuthorizationURL.absoluteString == \"https://ghe.example.com/login/device/code\")\n57|    #expect(config.tokenURL.absoluteString == \"https://ghe.example.com/login/oauth/access_token\")\n58|    #expect(config.apiBaseURL.absoluteString == \"https://ghe.example.com/api/v3\")\n59|}\n60|\n61|@Test func auditRejectsEmbeddedSecrets() throws {\n62|    try GitHubAuth.AppConfig.auditNoSecrets(in: [\"GitHubAppClientID\": \"pub\", \"CFBundleIdentifier\": \"x\"])\n63|    for key in [\"ClientSecret\", \"client_secret\", \"AppPrivateKey\", \"app_private_key\", \"GitHubToken\", \"access_token_cache\"] {\n64|        do {\n65|            try GitHubAuth.AppConfig.auditNoSecrets(in: [key: \"value\"])\n66|            Issue.record(\"auditNoSecrets admitted forbidden key '\\(key)'\")\n67|        } catch let error as GitHubAuth.ConfigError {\n68|            guard case .embeddedSecret(let found) = error, found == key else {\n69|                Issue.record(\"Wrong audit error for '\\(key)': \\(error)\"); return\n70|            }\n71|        }\n72|    }\n73|}\n74|\n75|// MARK: - PAT guard (no PAT fallback)\n76|\n77|@Test func patGuardRejectsClassicAndFineGrainedPAT() {\n78|    for pat in [\"ghp_abc123\", \"github_pat_abc123\"] {\n79|        do {\n80|            _ = try GitHubAuth.PATGuard.authorizationHeader(token: pat)\n81|            Issue.record(\"PATGuard admitted PAT '\\(pat)'\")\n82|        } catch let error as GitHubAuth.AuthError {\n83|            #expect(error == .patNotSupported)\n84|        } catch {\n85|            Issue.record(\"Unexpected error for '\\(pat)': \\(error)\")\n86|        }\n87|    }\n88|    #expect((try? GitHubAuth.PATGuard.authorizationHeader(token: \"[REDACTED]\")) == \"Bearer [REDACTED]\")\n89|}\n90|\n91|// MARK: - REST mapper (401/403)\n92|\n93|@Test func restMapperSeparatesUnauthorizedForbiddenSSORateLimit() {\n94|    #expect(GitHubAuth.RESTMapper.map(status: 401, body: Data()) == .unauthorized)\n95|    #expect(GitHubAuth.RESTMapper.map(status: 429, body: Data()) == .rateLimited(retryAfter: nil))\n96|    let sso = GitHubAuth.RESTMapper.map(status: 403, body: Data(\"SAML SSO required\".utf8))\n97|    #expect(sso == .ssoRequired)\n98|    let rate = GitHubAuth.RESTMapper.map(status: 403, body: Data(\"API rate limit exceeded\".utf8))\n99|    #expect(rate == .rateLimited(retryAfter: nil))\n100|    let forbidden = GitHubAuth.RESTMapper.map(status: 403, body: Data(\"Resource not accessible\".utf8))\n101|    guard case .forbidden = forbidden else {\n102|        Issue.record(\"Expected forbidden, got \\(String(describing: forbidden))\"); return\n103|    }\n104|    #expect(GitHubAuth.RESTMapper.map(status: 200, body: Data()) == nil)\n105|    #expect(GitHubAuth.RESTMapper.map(status: 500, body: Data()) == nil)\n106|}\n107|\n108|// MARK: - Redaction\n109|\n110|@Test func redactionScrubsExactSecretsAndJSONShapes() {\n111|    let token = \"[REDACTED]\"\n112|    let refresh = \"[REDACTED]\"\n113|    let text = #\"{\"access_token\":\"[REDACTED]\",\"refresh_token\":\"[REDACTED]\",\"device_code\":\"dev789\",\"other\":\"keep\"}\"#\n114|    let clean = GitHubAuth.Redaction.sanitize(text, secrets: [token, refresh])\n115|    #expect(!clean.contains(token))\n116|    #expect(!clean.contains(refresh))\n117|    #expect(!clean.contains(\"dev789\"))\n118|    #expect(clean.contains(\"keep\"))\n119|    #expect(clean.contains(\"[REDACTED]\"))\n120|    let inline = GitHubAuth.Redaction.sanitize(\"Bearer \\(token) tail\", secrets: [token])\n121|    #expect(inline == \"Bearer [REDACTED] tail\")\n122|}\n123|\n124|// MARK: - Device Flow transport\n125|\n126|@Test func deviceCodeRequestDecodesAndPostsClientID() async throws {\n127|    let transport = TestTransport([jsonResponse([\n128|        \"device_code\": \"dev\", \"user_code\": \"USER-1\",\n129|        \"verification_uri\": \"https://github.com/login/device\",\n130|        \"expires_in\": 900, \"interval\": 5,\n131|    ])])\n132|    let flow = GitHubDeviceFlow(transport: transport)\n133|    let response = try await flow.requestCode(config: testConfig)\n134|    #expect(response.user_code == \"USER-1\")\n135|    #expect(response.interval == 5)\n136|    let requests = await transport.requests\n137|    #expect(requests.count == 1)\n138|    #expect(requests[0].url == testConfig.deviceAuthorizationURL)\n139|    let body = try JSONDecoder().decode([String: String].self, from: requests[0].body!)\n140|    #expect(body[\"client_id\"] == \"test-client-id\")\n141|    #expect(body[\"client_secret\"] == nil)\n142|}\n143|\n144|@Test func devicePollMapsAllTerminalBodiesOnHTTP200() async throws {\n145|    for (payload, expected) in [\n146|        ([\"error\": \"authorization_pending\"], GitHubAuth.PollResult.pending),\n147|        ([\"error\": \"slow_down\"], GitHubAuth.PollResult.slowDown),\n148|        ([\"error\": \"access_denied\"], GitHubAuth.PollResult.denied),\n149|        ([\"error\": \"expired_token\"], GitHubAuth.PollResult.expired),\n150|    ] as [([String: String], GitHubAuth.PollResult)] {\n151|        let transport = TestTransport([jsonResponse(payload)])\n152|        let flow = GitHubDeviceFlow(transport: transport)\n153|        #expect(try await flow.pollOnce(config: testConfig, deviceCode: \"dev\") == expected)\n154|    }\n155|    let ok = TestTransport([jsonResponse([\"access_token\": \"ghu_x\", \"refresh_token\": \"ghr_y\", \"expires_in\": 3600])])\n156|    let result = try await GitHubDeviceFlow(transport: ok).pollOnce(config: testConfig, deviceCode: \"dev\")\n157|    #expect(result == .success(accessToken: \"ghu_x\", refreshToken: \"ghr_y\", expiresIn: 3600))\n158|}\n159|\n160|@Test func devicePollRejectsPATShapedToken() async {\n161|    let transport = TestTransport([jsonResponse([\"access_token\": \"[REDACTED]\"])])\n162|    do {\n163|        _ = try await GitHubDeviceFlow(transport: transport).pollOnce(config: testConfig, deviceCode: \"dev\")\n164|        Issue.record(\"pollOnce admitted PAT-shaped token\")\n165|    } catch let error as GitHubAuth.AuthError {\n166|        #expect(error == .patNotSupported)\n167|    } catch {\n168|        Issue.record(\"Unexpected error: \\(error)\")\n169|    }\n170|}\n171|\n172|@Test func slowDownAddsFiveSeconds() {\n173|    #expect(GitHubDeviceFlow.nextInterval(current: 5, after: .slowDown) == 10)\n174|    #expect(GitHubDeviceFlow.nextInterval(current: 5, after: .pending) == 5)\n175|    #expect(GitHubDeviceFlow.nextInterval(current: 10, after: .slowDown) == 15)\n176|}\n177|\n178|// MARK: - API client\n179|\n180|@Test func apiClientSendsBearerAndDecodesUser() async throws {\n181|    let transport = TestTransport([jsonResponse([\"login\": \"octo\", \"id\": 42])])\n182|    let user = try await GitHubAPIClient(transport: transport).fetchUser(config: testConfig, token: \"ghu_x\")\n183|    #expect(user.login == \"octo\")\n184|    #expect(user.id == 42)\n185|    let requests = await transport.requests\n186|    #expect(requests[0].headers[\"Authorization\"] == \"Bearer [REDACTED]\")\n187|}\n188|\n189|@Test func apiClientRefusesPATWithoutNetwork() async {\n190|    let transport = TestTransport([jsonResponse([\"login\": \"x\", \"id\": 1])])\n191|    do {\n192|        _ = try await GitHubAPIClient(transport: transport).fetchUser(config: testConfig, token: \"ghp_abc\")\n193|        Issue.record(\"fetchUser admitted PAT\")\n194|    } catch let error as GitHubAuth.AuthError {\n195|        #expect(error == .patNotSupported)\n196|    } catch {\n197|        Issue.record(\"Unexpected: \\(error)\")\n198|    }\n199|    #expect(await transport.requests.count == 0)\n200|}\n201|\n202|@Test func apiClientMaps401And403() async {\n203|    let unauth = TestTransport([GitHubHTTPResponse(status: 401, body: Data())])\n204|    do {\n205|        _ = try await GitHubAPIClient(transport: unauth).fetchInstallations(config: testConfig, token: \"ghu_x\")\n206|        Issue.record(\"Expected unauthorized\")\n207|    } catch let error as GitHubAuth.AuthError {\n208|        #expect(error == .unauthorized)\n209|    } catch { Issue.record(\"Unexpected: \\(error)\") }\n210|\n211|    let forbidden = TestTransport([GitHubHTTPResponse(status: 403, body: Data(\"forbidden\".utf8))])\n212|    do {\n213|        _ = try await GitHubAPIClient(transport: forbidden).fetchInstallations(config: testConfig, token: \"ghu_x\")\n214|        Issue.record(\"Expected forbidden\")\n215|    } catch let error as GitHubAuth.AuthError {\n216|        guard case .forbidden = error else { Issue.record(\"Expected forbidden, got \\(error)\"); return }\n217|    } catch { Issue.record(\"Unexpected: \\(error)\") }\n218|}\n219|\n220|@Test func apiClientDecodesInstallationsAndRepositories() async throws {\n221|    let transport = TestTransport([\n222|        jsonResponse([\"installations\": [[\"id\": 7, \"account\": [\"login\": \"acme\", \"type\": \"Organization\"]]]]),\n223|        jsonResponse([\"repositories\": [[\"id\": 9, \"full_name\": \"acme/app\", \"private\": true]]]),\n224|    ])\n225|    let api = GitHubAPIClient(transport: transport)\n226|    let installs = try await api.fetchInstallations(config: testConfig, token: \"ghu_x\")\n227|    #expect(installs == [.init(id: 7, account: \"acme\", accountType: \"Organization\")])\n228|    let repos = try await api.fetchRepositories(config: testConfig, token: \"ghu_x\", installationID: 7)\n229|    #expect(repos == [.init(id: 9, fullName: \"acme/app\", isPrivate: true)])\n230|}\n231|\n232|// MARK: - Token refresh\n233|\n234|@Test func refreshSavesAtomicallyAndCoalescesConcurrentCallers() async throws {\n235|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n236|    let current = GitHubAuth.TokenRecord(accessToken: \"ghu_old\", refreshToken: \"ghr_old\", expiresAt: Date().addingTimeInterval(-10))\n237|    try await store.save(current, serverHost: \"github.com\", userID: 1, clientID: testConfig.clientID)\n238|    // Two identical success payloads available; coalescing must consume exactly one.\n239|    let transport = TestTransport([\n240|        jsonResponse([\"access_token\": \"ghu_new\", \"refresh_token\": \"ghr_new\", \"expires_in\": 3600]),\n241|        jsonResponse([\"access_token\": \"ghu_new\", \"refresh_token\": \"ghr_new\", \"expires_in\": 3600]),\n242|    ])\n243|    let refresher = GitHubTokenRefresh(transport: transport, store: store)\n244|    async let first = refresher.refresh(config: testConfig, userID: 1, current: current)\n245|    async let second = refresher.refresh(config: testConfig, userID: 1, current: current)\n246|    let (a, b) = try await (first, second)\n247|    #expect(a.accessToken == \"ghu_new\")\n248|    #expect(b.accessToken == \"ghu_new\")\n249|    #expect(await transport.requests.count == 1)\n250|    let stored = await store.load(serverHost: \"github.com\", userID: 1, clientID: testConfig.clientID)\n251|    #expect(stored?.accessToken == \"ghu_new\")\n252|    #expect(stored?.refreshToken == \"ghr_new\")\n253|}\n254|\n255|@Test func refreshFailsClosedWithoutRefreshToken() async {\n256|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n257|    let current = GitHubAuth.TokenRecord(accessToken: \"ghu_old\", refreshToken: nil, expiresAt: nil)\n258|    let refresher = GitHubTokenRefresh(transport: TestTransport([]), store: store)\n259|    do {\n260|        _ = try await refresher.refresh(config: testConfig, userID: 1, current: current)\n261|        Issue.record(\"Expected tokenRefreshFailed\")\n262|    } catch let error as GitHubAuth.AuthError {\n263|        #expect(error == .tokenRefreshFailed)\n264|    } catch { Issue.record(\"Unexpected: \\(error)\") }\n265|}\n266|\n267|@Test func refreshMapsInvalidGrantToRevoked() async {\n268|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n269|    let current = GitHubAuth.TokenRecord(accessToken: \"ghu_old\", refreshToken: \"ghr_bad\", expiresAt: nil)\n270|    try! await store.save(current, serverHost: \"github.com\", userID: 1, clientID: testConfig.clientID)\n271|    let transport = TestTransport([jsonResponse([\"error\": \"invalid_grant\"])])\n272|    do {\n273|        _ = try await GitHubTokenRefresh(transport: transport, store: store).refresh(config: testConfig, userID: 1, current: current)\n274|        Issue.record(\"Expected revoked\")\n275|    } catch let error as GitHubAuth.AuthError {\n276|        #expect(error == .revoked)\n277|    } catch { Issue.record(\"Unexpected: \\(error)\") }\n278|}\n279|\n280|// MARK: - Keychain\n281|\n282|@Test func keychainRoundTripsAndDeletesScopedRecords() async throws {\n283|    let store = GitHubKeychainStore(service: \"works.relux.runnercontrol.test.\\(UUID().uuidString)\", backend: InMemoryKeychainBackend())\n284|    let record = GitHubAuth.TokenRecord(accessToken: \"ghu_a\", refreshToken: \"ghr_b\", expiresAt: Date())\n285|    try await store.save(record, serverHost: \"github.com\", userID: 11, clientID: \"cid\")\n286|    #expect(await store.load(serverHost: \"github.com\", userID: 11, clientID: \"cid\") == record)\n287|    #expect(await store.load(serverHost: \"github.com\", userID: 12, clientID: \"cid\") == nil)\n288|    await store.delete(serverHost: \"github.com\", userID: 11, clientID: \"cid\")\n289|    #expect(await store.load(serverHost: \"github.com\", userID: 11, clientID: \"cid\") == nil)\n290|}\n291|\n292|@Test func keychainDeleteAllSweepsOnlyMatchingClient() async throws {\n293|    let store = GitHubKeychainStore(service: \"works.relux.runnercontrol.test.\\(UUID().uuidString)\", backend: InMemoryKeychainBackend())\n294|    let record = GitHubAuth.TokenRecord(accessToken: \"ghu_a\", refreshToken: nil, expiresAt: nil)\n295|    try await store.save(record, serverHost: \"github.com\", userID: 1, clientID: \"cid-a\")\n296|    try await store.save(record, serverHost: \"github.com\", userID: 2, clientID: \"cid-a\")\n297|    try await store.save(record, serverHost: \"github.com\", userID: 1, clientID: \"cid-b\")\n298|    await store.deleteAll(serverHost: \"github.com\", clientID: \"cid-a\")\n299|    #expect(await store.load(serverHost: \"github.com\", userID: 1, clientID: \"cid-a\") == nil)\n300|    #expect(await store.load(serverHost: \"github.com\", userID: 2, clientID: \"cid-a\") == nil)\n301|    #expect(await store.load(serverHost: \"github.com\", userID: 1, clientID: \"cid-b\") != nil)\n302|}\n303|\n304|@Test func realKeychainBackendRoundTripsUniqueRecord() throws {\n305|    // Focused real-Security check with a unique service/account; always cleaned up.\n306|    let backend = SecurityKeychainBackend()\n307|    let service = \"works.relux.runnercontrol.test.\\(UUID().uuidString)\"\n308|    let account = \"github.com:999:\\(UUID().uuidString)\"\n309|    let data = Data(\"{\\\"accessToken\\\":\\\"ghu_probe\\\"}\".utf8)\n310|    defer { backend.delete(service: service, account: account) }\n311|    try backend.save(data, service: service, account: account)\n312|    #expect(backend.load(service: service, account: account) == data)\n313|    backend.delete(service: service, account: account)\n314|    #expect(backend.load(service: service, account: account) == nil)\n315|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
