 error {\n75|                await action { GitHubAuth.Action.failed(message: GitHubAuth.AuthError.missingClientID(binding: binding).localizedDescription, retry: .none) }\n76|            } else {\n77|                await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .none) }\n78|            }\n79|            return\n80|        } catch {\n81|            await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .none) }\n82|            return\n83|        }\n84|        await action { GitHubAuth.Action.loginStarted(serverHost: config.serverHost) }\n85|        let response: GitHubAuth.DeviceCodeResponse\n86|        do {\n87|            response = try await deviceFlow.requestCode(config: config)\n88|        } catch let error as GitHubAuth.AuthError {\n89|            await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: Self.retryKind(for: error)) }\n90|            return\n91|        } catch {\n92|            await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .retry) }\n93|            return\n94|        }\n95|        guard generation == gen else { return }\n96|        deviceCode = response.device_code\n97|        guard let uri = URL(string: response.verification_uri) else {\n98|            await action { GitHubAuth.Action.failed(message: GitHubTransportError.invalidResponse.localizedDescription, retry: .newCode) }\n99|            deviceCode = nil\n100|            return\n101|        }\n102|        await action { GitHubAuth.Action.codeReceived(userCode: response.user_code, verificationURI: uri, expiresIn: response.expires_in, interval: response.interval) }\n103|        pollTask = Task { [weak self] in\n104|            guard let self else { return }\n105|            await self.pollLoop(generation: gen, config: config, interval: response.interval, expiresIn: response.expires_in)\n106|        }\n107|    }\n108|\n109|    private func pollLoop(generation gen: Int, config: GitHubAuth.AppConfig, interval: Int, expiresIn: Int) async {\n110|        var currentInterval = interval\n111|        let deadline = now().addingTimeInterval(TimeInterval(expiresIn))\n112|        while generation == gen {\n113|            do {\n114|                try await sleeper(UInt64(currentInterval) * 1_000_000_000)\n115|            } catch {\n116|                return\n117|            }\n118|            guard generation == gen else { return }\n119|            if now() >= deadline {\n120|                deviceCode = nil\n121|                await action { GitHubAuth.Action.failed(message: GitHubAuth.AuthError.codeExpired.localizedDescription, retry: .newCode) }\n122|                return\n123|            }\n124|            guard let code = deviceCode else { return }\n125|            let result: GitHubAuth.PollResult\n126|            do {\n127|                result = try await deviceFlow.pollOnce(config: config, deviceCode: code)\n128|            } catch let error as GitHubAuth.AuthError {\n129|                guard generation == gen else { return }\n130|                deviceCode = nil\n131|                await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: Self.retryKind(for: error)) }\n132|                return\n133|            } catch {\n134|                guard generation == gen else { return }\n135|                deviceCode = nil\n136|                await action { GitHubAuth.Action.failed(message: error.localizedDescription, retry: .retry) }\n137|                return\n138|            }\n139|            guard generation == gen else { return }\n140|            switch result {\n141|            case .pending:\n142|                continue\n143|            case .slowDown:\n144|                currentInterval = GitHubDeviceFlow.nextInterval(current: currentInterval, after: .slowDown)\n145|                let updatedInterval = currentInterval\n146|                await action { GitHubAuth.Action.pollInterval