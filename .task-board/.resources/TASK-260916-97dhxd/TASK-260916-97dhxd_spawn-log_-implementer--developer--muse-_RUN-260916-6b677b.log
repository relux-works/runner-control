{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c669","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":399,"recorded_at":1780531400000793,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"task_stream":{"kind":"task","id":"01a0a824-9a7e-70a0-9d08-4e13c102b50b"},"task_id":"01a0a824-9a7e-70a0-9d08-4e13c102b50b","event":{"kind":"output","task_id":"01a0a824-9a7e-70a0-9d08-4e13c102b50b","chunk":"Read text file `Packages/RunnerControlCore/Sources/RunnerRuntime.swift`.\n1|import Foundation\n2|import Relux\n3|import OSLog\n4|@MainActor public enum RunnerRuntime {\n5|    public static func make(state: Runners.State, service: any RunnerServicing = LaunchAgentService()) async -> Relux {\n6|        let runtime = await Relux(logger: RuntimeLogger())\n7|        let flow = await Runners.Flow(service: service, dispatcher: runtime.dispatcher)\n8|        runtime.register(Runners.Module(state: state, flow: flow))\n9|        return runtime\n10|    }\n11|\n12|    public static func make(\n13|        state: Runners.State,\n14|        githubState: GitHubAuth.State,\n15|        service: any RunnerServicing = LaunchAgentService(),\n16|        transport: any GitHubHTTPTransport = URLSessionGitHubTransport(),\n17|        store: any GitHubCredentialStoring = GitHubKeychainStore()\n18|    ) async -> Relux {\n19|        let runtime = await Relux(logger: RuntimeLogger())\n20|        let flow = await Runners.Flow(service: service, dispatcher: runtime.dispatcher)\n21|        runtime.register(Runners.Module(state: state, flow: flow))\n22|        let deviceFlow = GitHubDeviceFlow(transport: transport)\n23|        let api = GitHubAPIClient(transport: transport)\n24|        let refresher = GitHubTokenRefresh(transport: transport, store: store)\n25|        let githubFlow = await GitHubAuth.Flow(deviceFlow: deviceFlow, api: api, refresher: refresher, store: store, dispatcher: runtime.dispatcher)\n26|        runtime.register(GitHubAuth.Module(state: githubState, flow: githubFlow))\n27|        return runtime\n28|    }\n29|}\n30|struct RuntimeLogger: Relux.Logger {\n31|    func logAction(_ action: Relux.EnumReflectable, result: Relux.ActionResult?, startTimeInMillis: Int, privacy: Relux.OSLogPrivacy, fileID: String, functionName: String, lineNumber: Int) {\n32|        Logger(subsystem: \"works.relux.runnercontrol\", category: \"state\").debug(\"State event: \\(String(describing: type(of: action)), privacy: .public)\")\n33|    }\n34|}","final_result":true}}}
