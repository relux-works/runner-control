dInstallationID = nil\n27|            repositories = []\n28|            selectedRepositoryIDs = []\n29|            syncError = nil\n30|            lastSyncAt = nil\n31|        }\n32|    }\n33|\n34|    public enum Action: Relux.Action {\n35|        case loginStarted(serverHost: String)\n36|        case codeReceived(userCode: String, verificationURI: URL, expiresIn: Int, interval: Int)\n37|        case pollIntervalUpdated(Int)\n38|        case loginCancelled\n39|        case accountVerified(username: String, userID: Int64, serverHost: String)\n40|        case installationsLoaded([Installation])\n41|        case repositoriesLoaded(installationID: Int64, repositories: [Repository])\n42|        case connected(username: String, serverHost: String, syncedAt: Date)\n43|        case failed(message: String, retry: RetryKind)\n44|        case syncFailed(message: String)\n45|        case syncSucceeded(Date)\n46|        case installationSelected(Int64?)\n47|        case repositoriesSelected(Set<Int64>)\n48|        case loggedOut\n49|        case clearSyncError\n50|    }\n51|\n52|    public enum Effect: Relux.Effect {\n53|        case beginLogin(serverHost: String?)\n54|        case cancelLogin\n55|        case logout\n56|        case refreshInstallations\n57|        case selectInstallation(Int64?)\n58|        case selectRepositories(Set<Int64>)\n59|    }\n60|}","final_result":true}}}
