{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c665","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":397,"recorded_at":1780531400000789,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"task_stream":{"kind":"task","id":"01a0a824-9a43-7632-8c8b-0b6593ce4a5b"},"task_id":"01a0a824-9a43-7632-8c8b-0b6593ce4a5b","event":{"kind":"output","task_id":"01a0a824-9a43-7632-8c8b-0b6593ce4a5b","chunk":"Read text file `Targets/RunnerControl/Sources/AppRegistry.swift`.\n1|import Foundation\n2|import RunnerControlCore\n3|\n4|@MainActor enum AppRegistry {\n5|    static let state = Runners.State()\n6|    static let githubState = GitHubAuth.State()\n7|    static let updater = AppUpdater()\n8|    private static var task: Task<Void, Never>?\n9|    private static var githubTask: Task<Void, Never>?\n10|    static func start() {\n11|        guard task == nil else { return }\n12|        updater.start()\n13|        // One composition root for every MenuBarExtra presentation.\n14|        task = Task {\n15|            _ = await RunnerRuntime.make(state: state, githubState: githubState)\n16|            while !Task.isCancelled {\n17|                await action { Runners.Effect.refresh }\n18|                try? await Task.sleep(for: .seconds(3))\n19|            }\n20|        }\n21|        githubTask = Task {\n22|            var ticks = 0\n23|            while !Task.isCancelled {\n24|                try? await Task.sleep(for: .seconds(30))\n25|                ticks += 1\n26|                // GitHub sync is best-effort and never blocks local control.\n27|                if case .connected = githubState.connection {\n28|                    await action { GitHubAuth.Effect.refreshInstallations }\n29|                }\n30|                _ = ticks\n31|            }\n32|        }\n33|    }\n34|\n35|    static func openManagementWindow() {\n36|        NotificationCenter.default.post(name: .openManagementWindow, object: nil)\n37|    }\n38|}\n39|\n40|extension Notification.Name {\n41|    static let openManagementWindow = Notification.Name(\"works.relux.runnercontrol.openManagementWindow\")\n42|}","final_result":true}}}
