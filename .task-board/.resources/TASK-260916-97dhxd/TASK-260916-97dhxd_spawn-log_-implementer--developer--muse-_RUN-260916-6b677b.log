{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b1","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":307,"recorded_at":1780531400000609,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"task_stream":{"kind":"task","id":"01a0a824-8193-77b2-abb7-575e06e8b0a1"},"task_id":"01a0a824-8193-77b2-abb7-575e06e8b0a1","event":{"kind":"output","task_id":"01a0a824-8193-77b2-abb7-575e06e8b0a1","chunk":"Read text file `Packages/RunnerControlCore/Sources/GitHubTokenRefresh.swift`.\n1|import Foundation\n2|\n3|/// Serialized token refresh. Concurrent callers coalesce to a single network refresh.\n4|public actor GitHubTokenRefresh {\n5|    private let transport: any GitHubHTTPTransport\n6|    private let store: any GitHubCredentialStoring\n7|    private let now: @Sendable () -> Date\n8|    private var inFlight: Task<GitHubAuth.TokenRecord, Error>?\n9|\n10|    public init(\n11|        transport: any GitHubHTTPTransport,\n12|        store: any GitHubCredentialStoring,\n13|        now: @Sendable @escaping () -> Date = Date.init\n14|    ) {\n15|        self.transport = transport\n16|        self.store = store\n17|        self.now = now\n18|    }\n19|\n20|    public func refresh(\n21|        config: GitHubAuth.AppConfig,\n22|        userID: Int64,\n23|        current: GitHubAuth.TokenRecord\n24|    ) async throws -> GitHubAuth.TokenRecord {\n25|        // Fast path: another task already refreshed while we waited.\n26|        if let latest = await store.load(serverHost: config.serverHost, userID: userID, clientID: config.clientID),\n27|           latest.accessToken != current.accessToken {\n28|            return latest\n29|        }\n30|        if let flight = inFlight {\n31|            return try await flight.value\n32|        }\n33|        guard let refreshToken = current.refreshToken, !refreshToken.isEmpty else {\n34|            throw GitHubAuth.AuthError.tokenRefreshFailed\n35|        }\n36|        let transportCopy = transport\n37|        let storeCopy = store\n38|        let nowCopy = now\n39|        let task: Task<GitHubAuth.TokenRecord, Error> = Task {\n40|            let body = try JSONEncoder().encode(GitHubAuth.TokenRefreshRequest(\n41|                client_id: config.clientID,\n42|                grant_type: \"refresh_token\",\n43|                refresh_token: refreshToken\n44|            ))\n45|            let request = GitHubHTTPRequest(\n46|                method: \"POST\",\n47|                url: config.tokenURL,\n48|                headers: [\"Accept\": \"application/json\", \"Content-Type\": \"application/json\"],\n49|                body: body\n50|            )\n51|            let response: GitHubHTTPResponse\n52|            do {\n53|                response = try await transportCopy.send(request)\n54|            } catch {\n55|                throw GitHubAuth.AuthError.network(GitHubTransportError.offline.localizedDescription)\n56|            }\n57|            let decoded: GitHubAuth.TokenSuccessResponse\n58|            do {\n59|                decoded = try JSONDecoder().decode(GitHubAuth.TokenSuccessResponse.self, from: response.body)\n60|            } catch {\n61|                throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n62|            }\n63|            if let token = decoded.access_token, !token.isEmpty {\n64|                try GitHubAuth.PATGuard.validate(token: token)\n65|                let expiresAt: Date?\n66|                if let seconds = decoded.expires_in {\n67|                    expiresAt = nowCopy().addingTimeInterval(TimeInterval(seconds))\n68|                } else {\n69|                    expiresAt = nil\n70|                }\n71|                let next = GitHubAuth.TokenRecord(\n72|                    accessToken: token,\n73|                    refreshToken: decoded.refresh_token ?? refreshToken,\n74|                    expiresAt: expiresAt,\n75|                    obtainedAt: nowCopy()\n76|                )\n77|                try await storeCopy.save(next, serverHost: config.serverHost, userID: userID, clientID: config.clientID)\n78|                return next\n79|            }\n80|            if decoded.error == \"invalid_grant\" {\n81|                throw GitHubAuth.AuthError.revoked\n82|            }\n83|            throw GitHubAuth.AuthError.tokenRefreshFailed\n84|        }\n85|        inFlight = task\n86|        do {\n87|            let value = try await task.value\n88|            inFlight = nil\n89|            return value\n90|        } catch {\n91|            inFlight = nil\n92|            throw error\n93|        }\n94|    }\n95|\n96|    public static func isExpiringSoon(_ record: GitHubAuth.TokenRecord, now: Date = Date(), within seconds: TimeInterval = 60) -> Bool {\n97|        guard let expiresAt = record.expiresAt else { return false }\n98|        return expiresAt.timeIntervalSince(now) <= seconds\n99|    }\n100|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b3","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":308,"recorded_at":1780531400000611,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"task_stream":{"kind":"task","id":"01a0a824-8193-77b2-abb7-575e06e8b0a1"},"task_id":"01a0a824-8193-77b2-abb7-575e06e8b0a1","event":{"kind":"completed","task_id":"01a0a824-8193-77b2-abb7-575e06e8b0a1"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b5","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":309,"recorded_at":1780531400000613,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"task_stream":{"kind":"task","id":"01a0a824-8202-7182-a65a-2cf7aa45eefb"},"task_id":"01a0a824-8202-7182-a65a-2cf7aa45eefb","event":{"kind":"output","task_id":"01a0a824-8202-7182-a65a-2cf7aa45eefb","chunk":"Read text file `Packages/RunnerControlCore/Sources/GitHubKeychainStore.swift`.\n1|import Foundation\n2|import Security\n3|\n4|/// Keychain-backed credential store. Secret values never enter Relux state or logs.\n5|public protocol GitHubCredentialStoring: Sendable {\n6|    func save(_ record: GitHubAuth.TokenRecord, serverHost: String, userID: Int64, clientID: String) async throws\n7|    func load(serverHost: String, userID: Int64, clientID: String) async -> GitHubAuth.TokenRecord?\n8|    func delete(serverHost: String, userID: Int64, clientID: String) async\n9|    func deleteAll(serverHost: String, clientID: String) async\n10|}\n11|\n12|public actor GitHubKeychainStore: GitHubCredentialStoring {\n13|    private let service: String\n14|    private let backend: any KeychainBackend\n15|\n16|    public init(service: String = \"works.relux.runnercontrol.github-token\", backend: (any KeychainBackend)? = nil) {\n17|        self.service = service\n18|        self.backend = backend ?? SecurityKeychainBackend()\n19|    }\n20|\n21|    public static func account(serverHost: String, userID: Int64, clientID: String) -> String {\n22|        \"\\(serverHost):\\(userID):\\(clientID)\"\n23|    }\n24|\n25|    private func account(serverHost: String, userID: Int64, clientID: String) -> String {\n26|        Self.account(serverHost: serverHost, userID: userID, clientID: clientID)\n27|    }\n28|\n29|    public func save(_ record: GitHubAuth.TokenRecord, serverHost: String, userID: Int64, clientID: String) async throws {\n30|        let data = try JSONEncoder().encode(record)\n31|        try backend.save(data, service: service, account: account(serverHost: serverHost, userID: userID, clientID: clientID))\n32|    }\n33|\n34|    public func load(serverHost: String, userID: Int64, clientID: String) async -> GitHubAuth.TokenRecord? {\n35|        guard let data = backend.load(service: service, account: account(serverHost: serverHost, userID: userID, clientID: clientID)) else { return nil }\n36|        return try? JSONDecoder().decode(GitHubAuth.TokenRecord.self, from: data)\n37|    }\n38|\n39|    public func delete(serverHost: String, userID: Int64, clientID: String) async {\n40|        backend.delete(service: service, account: account(serverHost: serverHost, userID: userID, clientID: clientID))\n41|    }\n42|\n43|    public func deleteAll(serverHost: String, clientID: String) async {\n44|        // Best-effort sweep: Keychain has no wildcard delete; callers pass known userIDs.\n45|        // This entry point exists so logout can clear without knowing the user when needed\n46|        // by enumerating via backend when supported.\n47|        backend.deleteMatching(service: service, accountPrefix: \"\\(serverHost):\", accountSuffix: \":\\(clientID)\")\n48|    }\n49|}\n50|\n51|/// Injectable Keychain boundary for tests.\n52|public protocol KeychainBackend: Sendable {\n53|    func save(_ data: Data, service: String, account: String) throws\n54|    func load(service: String, account: String) -> Data?\n55|    func delete(service: String, account: String)\n56|    func deleteMatching(service: String, accountPrefix: String, accountSuffix: String)\n57|}\n58|\n59|public struct SecurityKeychainBackend: KeychainBackend, Sendable {\n60|    public init() {}\n61|    public func save(_ data: Data, service: String, account: String) throws {\n62|        let query: [String: Any] = [kSecClass as String: kSecClassGenericPassword, kSecAttrService as String: service, kSecAttrAccount as String: account]\n63|        SecItemDelete(query as CFDictionary)\n64|        var add = query\n65|        add[kSecValueData as String] = data\n66|        add[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlock\n67|        let status = SecItemAdd(add as CFDictionary, nil)\n68|        guard status == errSecSuccess else { throw GitHubKeychainError.saveFailed(status) }\n69|    }\n70|    public func load(service: String, account: String) -> Data? {\n71|        let query: [String: Any] = [\n72|            kSecClass as String: kSecClassGenericPassword,\n73|            kSecAttrService as String: service,\n74|            kSecAttrAccount as String: account,\n75|            kSecReturnData as String: true,\n76|            kSecMatchLimit as String: kSecMatchLimitOne,\n77|        ]\n78|        var item: CFTypeRef?\n79|        guard SecItemCopyMatching(query as CFDictionary, &item) == errSecSuccess else { return nil }\n80|        return item as? Data\n81|    }\n82|    public func delete(service: String, account: String) {\n83|        let query: [String: Any] = [kSecClass as String: kSecClassGenericPassword, kSecAttrService as String: service, kSecAttrAccount as String: account]\n84|        SecItemDelete(query as CFDictionary)\n85|    }\n86|    public func deleteMatching(service: String, accountPrefix: String, accountSuffix: String) {\n87|        let query: [String: Any] = [\n88|            kSecClass as String: kSecClassGenericPassword,\n89|            kSecAttrService as String: service,\n90|            kSecReturnAttributes as String: true,\n91|            kSecMatchLimit as String: kSecMatchLimitAll,\n92|        ]\n93|        var items: CFTypeRef?\n94|        guard SecItemCopyMatching(query as CFDictionary, &items) == errSecSuccess,\n95|              let list = items as? [[String: Any]] else { return }\n96|        for entry in list {\n97|            if let account = entry[kSecAttrAccount as String] as? String,\n98|               account.hasPrefix(accountPrefix), account.hasSuffix(accountSuffix) {\n99|                delete(service: service, account: account)\n100|            }\n101|        }\n102|    }\n103|}\n104|\n105|public enum GitHubKeychainError: LocalizedError, Sendable, Equatable {\n106|    case saveFailed(OSStatus)\n107|    public var errorDescription: String? { \"Could not save GitHub credentials in Keychain.\" }\n108|}\n109|\n110|/// In-memory backend for unit tests. Never used in production.\n111|public final class InMemoryKeychainBackend: KeychainBackend, @unchecked Sendable {\n112|    private let lock = NSLock()\n113|    private var storage: [String: Data] = [:]\n114|    public init() {}\n115|    private func key(service: String, account: String) -> String { \"\\(service)\\u{0}\\(account)\" }\n116|    public func save(_ data: Data, service: String, account: String) throws {\n117|        lock.withLock { storage[key(service: service, account: account)] = data }\n118|    }\n119|    public func load(service: String, account: String) -> Data? {\n120|        lock.withLock { storage[key(service: service, account: account)] }\n121|    }\n122|    public func delete(service: String, account: String) {\n123|        lock.withLock { _ = storage.removeValue(forKey: key(service: service, account: account)) }\n124|    }\n125|    public func deleteMatching(service: String, accountPrefix: String, accountSuffix: String) {\n126|        lock.withLock {\n127|            for key in storage.keys where key.hasPrefix(\"\\(service)\\u{0}\\(accountPrefix)\") && key.hasSuffix(accountSuffix) {\n128|                storage.removeValue(forKey: key)\n129|            }\n130|        }\n131|    }\n132|}","final_result":true}}}
