{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c611","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":355,"recorded_at":1780531400000705,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"task_stream":{"kind":"task","id":"01a0a824-8ea2-7052-a2bc-0f853d9ebd07"},"task_id":"01a0a824-8ea2-7052-a2bc-0f853d9ebd07","event":{"kind":"output","task_id":"01a0a824-8ea2-7052-a2bc-0f853d9ebd07","chunk":"Read text file `Packages/RunnerControlCore/Sources/GitHubAPIClient.swift`.\n1|import Foundation\n2|\n3|/// GitHub REST client for user/installation/repository reads. Takes tokens explicitly; never stores them.\n4|public actor GitHubAPIClient {\n5|    private let transport: any GitHubHTTPTransport\n6|\n7|    public init(transport: any GitHubHTTPTransport) {\n8|        self.transport = transport\n9|    }\n10|\n11|    private func get(config: GitHubAuth.AppConfig, path: String, token: String) async throws -> GitHubHTTPResponse {\n12|        let header: String\n13|        do {\n14|            header = try GitHubAuth.PATGuard.authorizationHeader(token: token)\n15|        } catch {\n16|            throw GitHubAuth.AuthError.patNotSupported\n17|        }\n18|        let url = config.apiBaseURL.appendingPathComponent(path)\n19|        let request = GitHubHTTPRequest(\n20|            method: \"GET\",\n21|            url: url,\n22|            headers: [\"Accept\": \"application/vnd.github+json\", \"Authorization\": header]\n23|        )\n24|        let response: GitHubHTTPResponse\n25|        do {\n26|            response = try await transport.send(request)\n27|        } catch {\n28|            throw GitHubAuth.AuthError.network(GitHubTransportError.offline.localizedDescription)\n29|        }\n30|        if response.status == 200 { return response }\n31|        if let mapped = GitHubAuth.RESTMapper.map(status: response.status, body: response.body) {\n32|            throw mapped\n33|        }\n34|        throw GitHubAuth.AuthError.network(\"GitHub request failed (HTTP \\(response.status)).\")\n35|    }\n36|\n37|    public func fetchUser(config: GitHubAuth.AppConfig, token: String) async throws -> GitHubAuth.UserResponse {\n38|        let response = try await get(config: config, path: \"user\", token: token)\n39|        do {\n40|            return try JSONDecoder().decode(GitHubAuth.UserResponse.self, from: response.body)\n41|        } catch {\n42|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n43|        }\n44|    }\n45|\n46|    public func fetchInstallations(config: GitHubAuth.AppConfig, token: String) async throws -> [GitHubAuth.Installation] {\n47|        let response = try await get(config: config, path: \"user/installations\", token: token)\n48|        do {\n49|            let decoded = try JSONDecoder().decode(GitHubAuth.InstallationsResponse.self, from: response.body)\n50|            return decoded.installations.map { GitHubAuth.Installation(id: $0.id, account: $0.account.login, accountType: $0.account.type) }\n51|        } catch let error as GitHubAuth.AuthError {\n52|            throw error\n53|        } catch {\n54|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n55|        }\n56|    }\n57|\n58|    public func fetchRepositories(config: GitHubAuth.AppConfig, token: String, installationID: Int64) async throws -> [GitHubAuth.Repository] {\n59|        let response = try await get(config: config, path: \"user/installations/\\(installationID)/repositories\", token: token)\n60|        do {\n61|            let decoded = try JSONDecoder().decode(GitHubAuth.RepositoriesResponse.self, from: response.body)\n62|            return decoded.repositories.map { GitHubAuth.Repository(id: $0.id, fullName: $0.full_name, isPrivate: $0.private) }\n63|        } catch let error as GitHubAuth.AuthError {\n64|            throw error\n65|        } catch {\n66|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n67|        }\n68|    }\n69|}","final_result":true}}}
