{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ad","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":305,"recorded_at":1780531400000605,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"task_stream":{"kind":"task","id":"01a0a824-81c3-76e3-a6b9-6a9a8b475be7"},"task_id":"01a0a824-81c3-76e3-a6b9-6a9a8b475be7","event":{"kind":"output","task_id":"01a0a824-81c3-76e3-a6b9-6a9a8b475be7","chunk":"Read text file `Packages/RunnerControlCore/Sources/GitHubTransport.swift`.\n1|import Foundation\n2|\n3|/// Minimal HTTP boundary for GitHub Device Flow and REST. Keeps URLSession out of business logic.\n4|public protocol GitHubHTTPTransport: Sendable {\n5|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse\n6|}\n7|\n8|public struct GitHubHTTPRequest: Sendable {\n9|    public let method: String\n10|    public let url: URL\n11|    public let headers: [String: String]\n12|    public let body: Data?\n13|    public init(method: String, url: URL, headers: [String: String] = [:], body: Data? = nil) {\n14|        self.method = method; self.url = url; self.headers = headers; self.body = body\n15|    }\n16|}\n17|\n18|public struct GitHubHTTPResponse: Sendable {\n19|    public let status: Int\n20|    public let headers: [String: String]\n21|    public let body: Data\n22|    public init(status: Int, headers: [String: String] = [:], body: Data = Data()) {\n23|        self.status = status; self.headers = headers; self.body = body\n24|    }\n25|}\n26|\n27|public enum GitHubTransportError: LocalizedError, Sendable, Equatable {\n28|    case offline\n29|    case invalidResponse\n30|    public var errorDescription: String? {\n31|        switch self {\n32|        case .offline: \"Network unavailable. Local runner control still works.\"\n33|        case .invalidResponse: \"Unexpected GitHub response.\"\n34|        }\n35|    }\n36|}\n37|\n38|extension GitHubAuth {\n39|    // MARK: - Device DTOs\n40|\n41|    public struct DeviceCodeRequest: Encodable, Sendable {\n42|        public let client_id: String\n43|        public init(client_id: String) { self.client_id = client_id }\n44|    }\n45|\n46|    public struct DeviceCodeResponse: Decodable, Sendable {\n47|        public let device_code: String\n48|        public let user_code: String\n49|        public let verification_uri: String\n50|        public let expires_in: Int\n51|        public let interval: Int\n52|        public init(device_code: String, user_code: String, verification_uri: String, expires_in: Int, interval: Int) {\n53|            self.device_code = device_code; self.user_code = user_code; self.verification_uri = verification_uri\n54|            self.expires_in = expires_in; self.interval = interval\n55|        }\n56|    }\n57|\n58|    public struct TokenPollRequest: Encodable, Sendable {\n59|        public let client_id: String\n60|        public let device_code: String\n61|        public let grant_type: String\n62|        public init(client_id: String, device_code: String, grant_type: String) {\n63|            self.client_id = client_id; self.device_code = device_code; self.grant_type = grant_type\n64|        }\n65|    }\n66|\n67|    public struct TokenRefreshRequest: Encodable, Sendable {\n68|        public let client_id: String\n69|        public let grant_type: String\n70|        public let refresh_token: String\n71|        public init(client_id: String, grant_type: String, refresh_token: String) {\n72|            self.client_id = client_id; self.grant_type = grant_type; self.refresh_token = refresh_token\n73|        }\n74|    }\n75|\n76|    public struct TokenSuccessResponse: Decodable, Sendable {\n77|        public let access_token: String?\n78|        public let refresh_token: String?\n79|        public let expires_in: Int?\n80|        public let token_type: String?\n81|        public let error: String?\n82|        public let error_description: String?\n83|        public let interval: Int?\n84|        public init(access_token: String? = nil, refresh_token: String? = nil, expires_in: Int? = nil, token_type: String? = nil, error: String? = nil, error_description: String? = nil, interval: Int? = nil) {\n85|            self.access_token = access_token; self.refresh_token = refresh_token; self.expires_in = expires_in\n86|            self.token_type = token_type; self.error = error; self.error_description = error_description; self.interval = interval\n87|        }\n88|    }\n89|\n90|    public struct UserResponse: Decodable, Sendable {\n91|        public let login: String\n92|        public let id: Int64\n93|        public init(login: String, id: Int64) { self.login = login; self.id = id }\n94|    }\n95|\n96|    public struct InstallationsResponse: Decodable, Sendable {\n97|        public let installations: [InstallationDTO]\n98|        public init(installations: [InstallationDTO]) { self.installations = installations }\n99|    }\n100|\n101|    public struct InstallationDTO: Decodable, Sendable {\n102|        public let id: Int64\n103|        public let account: AccountDTO\n104|        public init(id: Int64, account: AccountDTO) { self.id = id; self.account = account }\n105|    }\n106|\n107|    public struct AccountDTO: Decodable, Sendable {\n108|        public let login: String\n109|        public let type: String\n110|        public init(login: String, type: String) { self.login = login; self.type = type }\n111|    }\n112|\n113|    public struct RepositoriesResponse: Decodable, Sendable {\n114|        public let repositories: [RepositoryDTO]\n115|        public init(repositories: [RepositoryDTO]) { self.repositories = repositories }\n116|    }\n117|\n118|    public struct RepositoryDTO: Decodable, Sendable {\n119|        public let id: Int64\n120|        public let full_name: String\n121|        public let `private`: Bool\n122|        public init(id: Int64, full_name: String, isPrivate: Bool) { self.id = id; self.full_name = full_name; self.private = isPrivate }\n123|    }\n124|}\n125|\n126|/// Production URLSession transport. Never logs bodies (they may contain tokens).\n127|public actor URLSessionGitHubTransport: GitHubHTTPTransport {\n128|    private let session: URLSession\n129|    public init(session: URLSession = .shared) { self.session = session }\n130|    public func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n131|        var urlRequest = URLRequest(url: request.url)\n132|        urlRequest.httpMethod = request.method\n133|        urlRequest.httpBody = request.body\n134|        for (key, value) in request.headers { urlRequest.setValue(value, forHTTPHeaderField: key) }\n135|        let (data, response): (Data, URLResponse)\n136|        do {\n137|            (data, response) = try await session.data(for: urlRequest)\n138|        } catch {\n139|            throw GitHubTransportError.offline\n140|        }\n141|        guard let http = response as? HTTPURLResponse else { throw GitHubTransportError.invalidResponse }\n142|        var headers: [String: String] = [:]\n143|        for (key, value) in http.allHeaderFields {\n144|            if let k = key as? String, let v = value as? String { headers[k] = v }\n145|        }\n146|        return GitHubHTTPResponse(status: http.statusCode, headers: headers, body: data)\n147|    }\n148|}\n149|\n150|extension GitHubAuth {\n151|    /// Maps REST status codes to typed auth errors. Local runners are never touched here.\n152|    public enum RESTMapper {\n153|        public static func map(status: Int, body: Data) -> AuthError? {\n154|            if status == 401 { return .unauthorized }\n155|            if status == 403 {\n156|                let text = String(decoding: body, as: UTF8.self).lowercased()\n157|                if text.contains(\"saml\") || text.contains(\"sso\") { return .ssoRequired }\n158|                if text.contains(\"rate limit\") || text.contains(\"rate_limit\") { return .rateLimited(retryAfter: nil) }\n159|                let message = String(decoding: body, as: UTF8.self)\n160|                let short = String(message.prefix(300))\n161|                return .forbidden(short)\n162|            }\n163|            if status == 429 { return .rateLimited(retryAfter: nil) }\n164|            return nil\n165|        }\n166|    }\n167|\n168|    /// Rejects personal access tokens. Only Device Flow user tokens (ghu_) are accepted.\n169|    public enum PATGuard {\n170|        public static func validate(token: String) throws {\n171|            if token.hasPrefix(\"ghp_\") || token.hasPrefix(\"github_pat_\") {\n172|                throw AuthError.patNotSupported\n173|            }\n174|        }\n175|\n176|        public static func authorizationHeader(token: String) throws -> String {\n177|            try validate(token: token)\n178|            return \"Bearer \\(token)\"\n179|        }\n180|    }\n181|}","final_result":true}}}
