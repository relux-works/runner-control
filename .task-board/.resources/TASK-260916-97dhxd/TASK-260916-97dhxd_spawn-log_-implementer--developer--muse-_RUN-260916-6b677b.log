{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c66d","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":401,"recorded_at":1780531400000797,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"task_stream":{"kind":"task","id":"01a0a824-9ab6-7173-a742-2689ff6fa2a7"},"task_id":"01a0a824-9ab6-7173-a742-2689ff6fa2a7","event":{"kind":"output","task_id":"01a0a824-9ab6-7173-a742-2689ff6fa2a7","chunk":"Read text file `Packages/RunnerControlCore/Sources/GitHubDeviceFlow.swift`.\n1|import Foundation\n2|\n3|extension GitHubAuth {\n4|    public enum PollResult: Sendable, Equatable {\n5|        case pending\n6|        case slowDown\n7|        case success(accessToken: String, refreshToken: String?, expiresIn: Int?)\n8|        case denied\n9|        case expired\n10|    }\n11|}\n12|\n13|/// Device Flow transport. Holds no tokens beyond the in-flight call.\n14|public actor GitHubDeviceFlow {\n15|    private let transport: any GitHubHTTPTransport\n16|\n17|    public init(transport: any GitHubHTTPTransport) {\n18|        self.transport = transport\n19|    }\n20|\n21|    public func requestCode(config: GitHubAuth.AppConfig) async throws -> GitHubAuth.DeviceCodeResponse {\n22|        let body = try JSONEncoder().encode(GitHubAuth.DeviceCodeRequest(client_id: config.clientID))\n23|        let request = GitHubHTTPRequest(\n24|            method: \"POST\",\n25|            url: config.deviceAuthorizationURL,\n26|            headers: [\"Accept\": \"application/json\", \"Content-Type\": \"application/json\"],\n27|            body: body\n28|        )\n29|        let response: GitHubHTTPResponse\n30|        do {\n31|            response = try await transport.send(request)\n32|        } catch {\n33|            throw GitHubAuth.AuthError.network(GitHubTransportError.offline.localizedDescription)\n34|        }\n35|        guard response.status == 200 else {\n36|            if let mapped = GitHubAuth.RESTMapper.map(status: response.status, body: response.body) {\n37|                throw mapped\n38|            }\n39|            throw GitHubAuth.AuthError.network(\"Device code request failed (HTTP \\(response.status)).\")\n40|        }\n41|        do {\n42|            return try JSONDecoder().decode(GitHubAuth.DeviceCodeResponse.self, from: response.body)\n43|        } catch {\n44|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n45|        }\n46|    }\n47|\n48|    public func pollOnce(config: GitHubAuth.AppConfig, deviceCode: String) async throws -> GitHubAuth.PollResult {\n49|        let body = try JSONEncoder().encode(GitHubAuth.TokenPollRequest(\n50|            client_id: config.clientID,\n51|            device_code: deviceCode,\n52|            grant_type: \"urn:ietf:params:oauth:grant-type:device_code\"\n53|        ))\n54|        let request = GitHubHTTPRequest(\n55|            method: \"POST\",\n56|            url: config.tokenURL,\n57|            headers: [\"Accept\": \"application/json\", \"Content-Type\": \"application/json\"],\n58|            body: body\n59|        )\n60|        let response: GitHubHTTPResponse\n61|        do {\n62|            response = try await transport.send(request)\n63|        } catch {\n64|            throw GitHubAuth.AuthError.network(GitHubTransportError.offline.localizedDescription)\n65|        }\n66|        // HTTP 200 does not imply success: Device Flow reports errors in the body.\n67|        let decoded: GitHubAuth.TokenSuccessResponse\n68|        do {\n69|            decoded = try JSONDecoder().decode(GitHubAuth.TokenSuccessResponse.self, from: response.body)\n70|        } catch {\n71|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n72|        }\n73|        if let token = decoded.access_token, !token.isEmpty {\n74|            try GitHubAuth.PATGuard.validate(token: token)\n75|            return .success(accessToken: token, refreshToken: decoded.refresh_token, expiresIn: decoded.expires_in)\n76|        }\n77|        switch decoded.error {\n78|        case \"authorization_pending\": return .pending\n79|        case \"slow_down\": return .slowDown\n80|        case \"access_denied\": return .denied\n81|        case \"expired_token\": return .expired\n82|        case .none:\n83|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n84|        case .some(let other):\n85|            throw GitHubAuth.AuthError.network(decoded.error_description ?? other)\n86|        }\n87|    }\n88|\n89|    /// slow_down increases the poll interval by 5 seconds (GitHub docs).\n90|    public static func nextInterval(current: Int, after result: GitHubAuth.PollResult) -> Int {\n91|        if result == .slowDown { return current + 5 }\n92|        return current\n93|    }\n94|}","final_result":true}}}
