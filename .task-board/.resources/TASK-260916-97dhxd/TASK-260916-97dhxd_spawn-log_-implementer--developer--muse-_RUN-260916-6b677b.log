{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c621","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":363,"recorded_at":1780531400000721,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"call_id":"call_01a0a824877575d3aa4c0be4722d0ad2","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubAPIClient.swift`.\n1|import Foundation\n2|\n3|/// GitHub REST client for user/installation/repository reads. Takes tokens explicitly; never stores them.\n4|public actor GitHubAPIClient {\n5|    private let transport: any GitHubHTTPTransport\n6|\n7|    public init(transport: any GitHubHTTPTransport) {\n8|        self.transport = transport\n9|    }\n10|\n11|    private func get(config: GitHubAuth.AppConfig, path: String, token: String) async throws -> GitHubHTTPResponse {\n12|        let header: String\n13|        do {\n14|            header = try GitHubAuth.PATGuard.authorizationHeader(token: token)\n15|        } catch {\n16|            throw GitHubAuth.AuthError.patNotSupported\n17|        }\n18|        let url = config.apiBaseURL.appendingPathComponent(path)\n19|        let request = GitHubHTTPRequest(\n20|            method: \"GET\",\n21|            url: url,\n22|            headers: [\"Accept\": \"application/vnd.github+json\", \"Authorization\": header]\n23|        )\n24|        let response: GitHubHTTPResponse\n25|        do {\n26|            response = try await transport.send(request)\n27|        } catch {\n28|            throw GitHubAuth.AuthError.network(GitHubTransportError.offline.localizedDescription)\n29|        }\n30|        if response.status == 200 { return response }\n31|        if let mapped = GitHubAuth.RESTMapper.map(status: response.status, body: response.body) {\n32|            throw mapped\n33|        }\n34|        throw GitHubAuth.AuthError.network(\"GitHub request failed (HTTP \\(response.status)).\")\n35|    }\n36|\n37|    public func fetchUser(config: GitHubAuth.AppConfig, token: String) async throws -> GitHubAuth.UserResponse {\n38|        let response = try await get(config: config, path: \"user\", token: token)\n39|        do {\n40|            return try JSONDecoder().decode(GitHubAuth.UserResponse.self, from: response.body)\n41|        } catch {\n42|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n43|        }\n44|    }\n45|\n46|    public func fetchInstallations(config: GitHubAuth.AppConfig, token: String) async throws -> [GitHubAuth.Installation] {\n47|        let response = try await get(config: config, path: \"user/installations\", token: token)\n48|        do {\n49|            let decoded = try JSONDecoder().decode(GitHubAuth.InstallationsResponse.self, from: response.body)\n50|            return decoded.installations.map { GitHubAuth.Installation(id: $0.id, account: $0.account.login, accountType: $0.account.type) }\n51|        } catch let error as GitHubAuth.AuthError {\n52|            throw error\n53|        } catch {\n54|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n55|        }\n56|    }\n57|\n58|    public func fetchRepositories(config: GitHubAuth.AppConfig, token: String, installationID: Int64) async throws -> [GitHubAuth.Repository] {\n59|        let response = try await get(config: config, path: \"user/installations/\\(installationID)/repositories\", token: token)\n60|        do {\n61|            let decoded = try JSONDecoder().decode(GitHubAuth.RepositoriesResponse.self, from: response.body)\n62|            return decoded.repositories.map { GitHubAuth.Repository(id: $0.id, fullName: $0.full_name, isPrivate: $0.private) }\n63|        } catch let error as GitHubAuth.AuthError {\n64|            throw error\n65|        } catch {\n66|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n67|        }\n68|    }\n69|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c623","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":364,"recorded_at":1780531400000723,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"call_id":"call_01a0a82488c072688e3df2fb3d681026","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubAuth+Models.swift`.\n1|import Foundation\n2|\n3|extension GitHubAuth {\n4|    /// Token metadata kept outside Relux state. Secret values live only in Keychain.\n5|    public struct TokenRecord: Sendable, Equatable, Codable {\n6|        public let accessToken: String\n7|        public let refreshToken: String?\n8|        public let expiresAt: Date?\n9|        public let obtainedAt: Date\n10|\n11|        public init(accessToken: String, refreshToken: String?, expiresAt: Date?, obtainedAt: Date = Date()) {\n12|            self.accessToken = accessToken\n13|            self.refreshToken = refreshToken\n14|            self.expiresAt = expiresAt\n15|            self.obtainedAt = obtainedAt\n16|        }\n17|    }\n18|\n19|    public struct Installation: Sendable, Equatable, Identifiable {\n20|        public let id: Int64\n21|        public let account: String\n22|        public let accountType: String\n23|        public init(id: Int64, account: String, accountType: String) {\n24|            self.id = id; self.account = account; self.accountType = accountType\n25|        }\n26|    }\n27|\n28|    public struct Repository: Sendable, Equatable, Identifiable {\n29|        public let id: Int64\n30|        public let fullName: String\n31|        public let isPrivate: Bool\n32|        public init(id: Int64, fullName: String, isPrivate: Bool) {\n33|            self.id = id; self.fullName = fullName; self.isPrivate = isPrivate\n34|        }\n35|    }\n36|\n37|    /// Connection phases. No tokens, device codes, or secrets are stored here.\n38|    public enum Connection: Sendable, Equatable {\n39|        case disconnected\n40|        case requestingCode\n41|        case awaitingUser(userCode: String, verificationURI: URL, expiresIn: Int, interval: Int)\n42|        case verifyingAccount\n43|        case verifyingInstallations(username: String)\n44|        case connected(username: String, serverHost: String)\n45|        case failed(message: String, retry: RetryKind)\n46|    }\n47|\n48|    public enum RetryKind: Sendable, Equatable {\n49|        case newCode\n50|        case retry\n51|        case relogin\n52|        case grantAccess\n53|        case none\n54|    }\n55|\n56|    public enum AuthError: LocalizedError, Sendable, Equatable {\n57|        case cancelled\n58|        case denied\n59|        case codeExpired\n60|        case slowDown\n61|        case authorizationPending\n62|        case network(String)\n63|        case unauthorized\n64|        case forbidden(String)\n65|        case rateLimited(retryAfter: Int?)\n66|        case needsInstallation\n67|        case needsApproval\n68|        case ssoRequired\n69|        case revoked\n70|        case missingClientID(binding: String)\n71|        case patNotSupported\n72|        case tokenRefreshFailed\n73|\n74|        public var errorDescription: String? {\n75|            switch self {\n76|            case .cancelled: \"Login cancelled.\"\n77|            case .denied: \"Access denied on GitHub. Approve Runner Control or try again.\"\n78|            case .codeExpired: \"Code expired. Get a new code.\"\n79|            case .slowDown: \"Polling too fast. Backing off.\"\n80|            case .authorizationPending: \"Waiting for confirmation on GitHub…\"\n81|            case .network(let message): message\n82|            case .unauthorized: \"Session expired or revoked (401). Sign in again.\"\n83|            case .forbidden(let message): message.isEmpty ? \"Access forbidden (403). Grant the App or approve access.\" : message\n84|            case .rateLimited: \"GitHub rate limit reached. Data may be stale; local control still works.\"\n85|            case .needsInstallation: \"GitHub App is not installed for this account. Grant access to continue.\"\n86|            case .needsApproval: \"Organization approval is required.\"\n87|            case .ssoRequired: \"SSO authorization is required for this organization.\"\n88|            case .revoked: \"Session was revoked. Sign in again.\"\n89|            case .missingClientID(let binding): \"GitHub App client_id is not provisioned. Missing binding: \\(binding).\"\n90|            case .patNotSupported: \"Personal access tokens are not supported. Use Sign in with GitHub (Device Flow).\"\n91|            case .tokenRefreshFailed: \"Token refresh failed. Sign in again.\"\n92|            }\n93|        }\n94|    }\n95|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c625","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":365,"recorded_at":1780531400000725,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"call_id":"call_01a0a8248a3270f6aed1e7a704e9e0a2","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubRedaction.swift`.\n1|import Foundation\n2|\n3|extension GitHubAuth {\n4|    /// Redacts secret values from diagnostics. Never logs raw tokens.\n5|    public enum Redaction {\n6|        public static func sanitize(_ text: String, secrets: [String]) -> String {\n7|            var result = text\n8|            for secret in secrets where !secret.isEmpty {\n9|                result = result.replacingOccurrences(of: secret, with: \"[REDACTED]\")\n10|            }\n11|            // Scrub common token JSON shapes even when the exact value is unknown.\n12|            for key in [\"access_token\", \"refresh_token\", \"device_code\"] {\n13|                result = scrubJSONValue(for: key, in: result)\n14|            }\n15|            return result\n16|        }\n17|\n18|        private static func scrubJSONValue(for key: String, in text: String) -> String {\n19|            // \"key\":\"value\" and \"key\": \"value\" shapes.\n20|            var result = text\n21|            for pattern in [\"\\\"\\(key)\\\":\\\"\", \"\\\"\\(key)\\\": \\\"\"] {\n22|                var searchFrom = result.startIndex\n23|                while let keyRange = result.range(of: pattern, range: searchFrom..<result.endIndex) {\n24|                    let valueStart = keyRange.upperBound\n25|                    guard let valueEnd = result[valueStart...].firstIndex(of: \"\\\"\") else { break }\n26|                    result.replaceSubrange(valueStart..<valueEnd, with: \"[REDACTED]\")\n27|                    searchFrom = result.index(valueEnd, offsetBy: 0, limitedBy: result.endIndex) ?? result.endIndex\n28|                    if searchFrom >= result.endIndex { break }\n29|                }\n30|            }\n31|            return result\n32|        }\n33|    }\n34|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
