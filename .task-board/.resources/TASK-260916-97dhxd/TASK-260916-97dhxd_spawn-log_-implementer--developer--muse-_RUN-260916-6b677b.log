{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c549","stream":{"kind":"session","id":"01a0a823-e600-7521-9ce0-62cc9653cb46"},"sequence":255,"recorded_at":1780531400000505,"record_type":"event","durability":"durable","causation_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a","run_stream":{"kind":"run","id":"a02c0fe6-9135-4b16-8f63-6f987d7b0b4a"},"task_stream":{"kind":"task","id":"01a0a824-759e-7cb1-b418-e37c251b9335"},"task_id":"01a0a824-759e-7cb1-b418-e37c251b9335","event":{"kind":"output","task_id":"01a0a824-759e-7cb1-b418-e37c251b9335","chunk":"Read text file `Packages/RunnerControlCore/Sources/GitHubAuth+State+Reducer.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension GitHubAuth.State {\n5|    public func reduce(with action: any Relux.Action) async {\n6|        guard let action = action as? GitHubAuth.Action else { return }\n7|        switch action {\n8|        case .loginStarted(let host):\n9|            connection = .requestingCode\n10|            serverHost = host\n11|            syncError = nil\n12|        case .codeReceived(let userCode, let uri, let expiresIn, let interval):\n13|            connection = .awaitingUser(userCode: userCode, verificationURI: uri, expiresIn: expiresIn, interval: interval)\n14|        case .pollIntervalUpdated(let interval):\n15|            if case .awaitingUser(let userCode, let uri, let expiresIn, _) = connection {\n16|                connection = .awaitingUser(userCode: userCode, verificationURI: uri, expiresIn: expiresIn, interval: interval)\n17|            }\n18|        case .loginCancelled:\n19|            connection = .disconnected\n20|            syncError = nil\n21|        case .accountVerified(let username, let userID, let host):\n22|            self.username = username\n23|            self.userID = userID\n24|            serverHost = host\n25|            connection = .verifyingInstallations(username: username)\n26|        case .installationsLoaded(let installations):\n27|            self.installations = installations\n28|            if selectedInstallationID == nil {\n29|                selectedInstallationID = installations.first?.id\n30|            } else if let selected = selectedInstallationID, !installations.contains(where: { $0.id == selected }) {\n31|                selectedInstallationID = installations.first?.id\n32|            }\n33|        case .repositoriesLoaded(let installationID, let repositories):\n34|            if selectedInstallationID == installationID || selectedInstallationID == nil {\n35|                self.repositories = repositories\n36|            }\n37|        case .connected(let username, let host, let date):\n38|            self.username = username\n39|            serverHost = host\n40|            connection = .connected(username: username, serverHost: host)\n41|            lastSyncAt = date\n42|            syncError = nil\n43|        case .failed(let message, let retry):\n44|            connection = .failed(message: message, retry: retry)\n45|        case .syncFailed(let message):\n46|            syncError = message\n47|        case .syncSucceeded(let date):\n48|            lastSyncAt = date\n49|            syncError = nil\n50|        case .installationSelected(let id):\n51|            selectedInstallationID = id\n52|            repositories = []\n53|        case .repositoriesSelected(let ids):\n54|            selectedRepositoryIDs = ids\n55|        case .loggedOut:\n56|            connection = .disconnected\n57|            username = nil\n58|            userID = nil\n59|            installations = []\n60|            selectedInstallationID = nil\n61|            repositories = []\n62|            selectedRepositoryIDs = []\n63|            syncError = nil\n64|            lastSyncAt = nil\n65|        case .clearSyncError:\n66|            syncError = nil\n67|        }\n68|    }\n69|}","fi