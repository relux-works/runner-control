{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c56f","stream":{"kind":"session","id":"01a0a800-dff5-7ec3-9e60-f73779a17ae8"},"sequence":274,"recorded_at":1780531400000543,"record_type":"event","durability":"durable","causation_id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1","run_stream":{"kind":"run","id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1"},"call_id":"call_01a0a8015930730db08009c6e2b00c8f","text":"Read text file `Targets/RunnerControl/Sources/RunnerCard.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|struct RunnerCard: View {\n5|    let snapshot: Runners.Snapshot\n6|    let changing: Bool\n7|    let setEnabled: (Bool) -> Void\n8|    let openGitHub: () -> Void\n9|    let openLogs: () -> Void\n10|    var body: some View {\n11|        VStack(alignment: .leading, spacing: 9) {\n12|            HStack {\n13|                VStack(alignment: .leading, spacing: 4) {\n14|                    Text(snapshot.definition.title).font(.system(size: 13, weight: .semibold))\n15|                    Text(snapshot.definition.detail).font(.system(size: 10)).foregroundStyle(.secondary)\n16|                }\n17|                Spacer(minLength: 6)\n18|                if changing { ProgressView().controlSize(.small) }\n19|                Toggle(snapshot.definition.title, isOn: Binding(get: { snapshot.status == .running }, set: setEnabled))\n20|                    .labelsHidden().toggleStyle(.switch).controlSize(.small).tint(.teal)\n21|                    .disabled(changing || [.checking, .missing, .unknown].contains(snapshot.status))\n22|                    .accessibilityIdentifier(\"Runners menu \\(snapshot.definition.title) toggle\")\n23|            }\n24|            HStack(spacing: 5) {\n25|                Circle().fill(color).frame(width: 5, height: 5)\n26|                Text(changing ? \"Меняем состояние…\" : snapshot.status.title).font(.system(size: 11)).foregroundStyle(.secondary)\n27|                Spacer()\n28|                Button(action: openLogs) { Image(systemName: \"doc.text.magnifyingglass\") }.help(\"Открыть журналы\")\n29|                Button(action: openGitHub) { Image(systemName: \"arrow.up.right.square\") }.help(\"Открыть раннеры в GitHub\")\n30|            }.buttonStyle(.plain).foregroundStyle(.secondary)\n31|            if let message = snapshot.message {\n32|                Text(message).font(.caption2).foregroundStyle(.orange).lineLimit(3)\n33|            }\n34|        }.padding(13).background(.primary.opacity(0.04), in: RoundedRectangle(cornerRadius: 12))\n35|    }\n36|    private var color: Color {\n37|        switch snapshot.status {\n38|        case .running: .green\n39|        case .failed, .missing, .unknown: .orange\n40|        default: .secondary.opacity(0.6)\n41|        }\n42|    }\n43|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c571","stream":{"kind":"session","id":"01a0a800-dff5-7ec3-9e60-f73779a17ae8"},"sequence":275,"recorded_at":1780531400000545,"record_type":"event","durability":"durable","causation_id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1","run_stream":{"kind":"run","id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1"},"call_id":"call_01a0a8015a367627927494c22a299498","text":"Read text file `Targets/RunnerControl/Sources/AppUpdater.swift`.\n1|import AppKit\n2|import Combine\n3|import Sparkle\n4|\n5|/// AppKit-bound adapter: one Sparkle controller for the application's lifetime.\n6|@MainActor final class AppUpdater: NSObject, ObservableObject {\n7|    @Published private(set) var canCheckForUpdates = false\n8|    @Published private(set) var automaticallyChecks = true\n9|    @Published private(set) var automaticallyDownloads = true\n10|    private var controller: SPUStandardUpdaterController!\n11|    private var started = false\n12|\n13|    override init() {\n14|        super.init()\n15|        controller = SPUStandardUpdaterController(startingUpdater: false, updaterDelegate: nil, userDriverDelegate: nil)\n16|        controller.updater.publisher(for: \\.canCheckForUpdates).assign(to: &$canCheckForUpdates)\n17|        controller.updater.publisher(for: \\.automaticallyChecksForUpdates).assign(to: &$automaticallyChecks)\n18|        controller.updater.publisher(for: \\.automaticallyDownloadsUpdates).assign(to: &$automaticallyDownloads)\n19|    }\n20|    func start() {\n21|        guard !started else { return }\n22|        started = true\n23|        controller.startUpdater()\n24|    }\n25|    func check() { controller.checkForUpdates(nil) }\n26|    func setAutomaticChecks(_ enabled: Bool) { controller.updater.automaticallyChecksForUpdates = enabled }\n27|    func setAutomaticDownloads(_ enabled: Bool) { controller.updater.automaticallyDownloadsUpdates = enabled }\n28|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
