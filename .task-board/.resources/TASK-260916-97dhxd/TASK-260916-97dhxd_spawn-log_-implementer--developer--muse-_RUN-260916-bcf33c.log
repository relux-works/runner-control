       client_id: config.clientID,\n34|            grant_type: \"refresh_token\",\n35|            refresh_token: refreshToken\n36|        ))\n37|        let request = GitHubHTTPRequest(\n38|            method: \"POST\",\n39|            url: config.tokenURL,\n40|            headers: [\"Accept\": \"application/json\", \"Content-Type\": \"application/json\"],\n41|            body: body\n42|        )\n43|        let response: GitHubHTTPResponse\n44|        do {\n45|            response = try await transport.send(request)\n46|        } catch {\n47|            throw GitHubAuth.AuthError.network(GitHubTransportError.offline.localizedDescription)\n48|        }\n49|        let decoded: GitHubAuth.TokenSuccessResponse\n50|        do {\n51|            decoded = try JSONDecoder().decode(GitHubAuth.TokenSuccessResponse.self, from: response.body)\n52|        } catch {\n53|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n54|        }\n55|        if let token = decoded.access_token, !token.isEmpty {\n56|            try GitHubAuth.PATGuard.validate(token: token)\n57|            let expiresAt: Date?\n58|            if let seconds = decoded.expires_in {\n59|                expiresAt = now().addingTimeInterval(TimeInterval(seconds))\n60|            } else {\n61|                expiresAt = nil\n62|            }\n63|            let next = GitHubAuth.TokenRecord(\n64|                accessToken: token,\n65|                refreshToken: decoded.refresh_token ?? refreshToken,\n66|                expiresAt: expiresAt,\n67|                obtainedAt: now()\n68|            )\n69|            try await store.save(next, serverHost: config.serverHost, userID: userID, clientID: config.clientID)\n70|            return next\n71|        }\n72|        if decoded.error == \"invalid_grant\" {\n73|            throw GitHubAuth.AuthError.revoked\n74|        }\n75|        throw GitHubAuth.AuthError.tokenRefreshFailed\n76|    }\n77|\n78|    public static func isExpiringSoon(_ record: GitHubAuth.TokenRecord, now: Date = Date(), within seconds: TimeInterval = 60) -> Bool {\n79|        guard let expiresAt = record.expiresAt else { return false }\n80|        return expiresAt.timeIntervalSince(now) <= seconds\n81|    }\n82|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
