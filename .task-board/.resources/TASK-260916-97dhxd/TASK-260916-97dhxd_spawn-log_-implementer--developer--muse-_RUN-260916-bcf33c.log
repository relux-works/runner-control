{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf05","stream":{"kind":"session","id":"01a0a800-dff5-7ec3-9e60-f73779a17ae8"},"sequence":1501,"recorded_at":1780531400002997,"record_type":"event","durability":"durable","causation_id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1","run_stream":{"kind":"run","id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1"},"task_stream":{"kind":"task","id":"01a0a809-d834-7293-916e-6ff8f59c5e69"},"task_id":"01a0a809-d834-7293-916e-6ff8f59c5e69","event":{"kind":"output","task_id":"01a0a809-d834-7293-916e-6ff8f59c5e69","chunk":"Read text file `Targets/RunnerControl/Sources/RunnerContainer.swift`.\n1|import SwiftUI\n2|import AppKit\n3|import RunnerControlCore\n4|\n5|struct RunnerContainer: View {\n6|    @ObservedObject var state: Runners.State\n7|    @ObservedObject private var updater = AppRegistry.updater\n8|    var body: some View {\n9|        RunnerPage(\n10|            props: .init(runners: state.runners, changing: state.changing, error: state.lastError, canCheckForUpdates: updater.canCheckForUpdates, automaticChecks: updater.automaticallyChecks, automaticDownloads: updater.automaticallyDownloads),\n11|            reactions: .init(\n12|                setEnabled: change,\n13|                enableAll: { for runner in state.runners where [.stopped, .failed].contains(runner.status) { change(runner.id, true) } },\n14|                disableAll: { confirmStop(ids: state.runners.map(\\.id)) },\n15|                openGitHub: { NSWorkspace.shared.open($0.githubURL) },\n16|                openLogs: { NSWorkspace.shared.open($0.logs) },\n17|                clearError: { Task { await action { Runners.Action.clearError } } },\n18|                quit: quit,\n19|                checkForUpdates: updater.check,\n20|                setAutomaticChecks: updater.setAutomaticChecks,\n21|                setAutomaticDownloads: updater.setAutomaticDownloads\n22|            )\n23|        )\n24|    }\n25|    private func change(_ id: String, _ enabled: Bool) {\n26|        if enabled { Task { await action { Runners.Effect.setEnabled(id, true) } } }\n27|        else { confirmStop(ids: [id]) }\n28|    }\n29|    private func confirmStop(ids: [String]) {\n30|        let alert = NSAlert()\n31|        alert.messageText = \"Выключить CI?\"\n32|        alert.informativeText = \"Если раннер сейчас выполняет сборку, она будет прервана. Новые задания он принимать не будет.\"\n33|        alert.addButton(withTitle: \"Отмена\")\n34|        alert.addButton(withTitle: \"Выключить\")\n35|        guard alert.runModal() == .alertSecondButtonReturn else { return }\n36|        Task { for id in ids { await action { Runners.Effect.setEnabled(id, false) } } }\n37|    }\n38|    private func quit() {\n39|        guard state.changing.isEmpty else { return }\n40|        if state.runners.contains(where: { $0.status == .running || $0.status == .failed || $0.status == .unknown }) {\n41|            let alert = NSAlert()\n42|            alert.messageText = \"Закрыть Runner Control?\"\n43|            alert.informativeText = \"Включённые раннеры продолжат работать в фоне. Для остановки CI сначала нажмите «Выключить все».\"\n44|            alert.addButton(withTitle: \"Остаться\")\n45|            alert.addButton(withTitle: \"Закрыть приложение\")\n46|            guard alert.runModal() == .alertSecondButtonReturn else { return }\n47|        }\n48|        NSApp.terminate(nil)\n49|    }\n50|}","final_result":true}}}
