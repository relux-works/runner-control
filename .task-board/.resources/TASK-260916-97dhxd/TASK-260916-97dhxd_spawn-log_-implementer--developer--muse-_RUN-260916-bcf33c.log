{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d3c1","stream":{"kind":"session","id":"01a0a800-dff5-7ec3-9e60-f73779a17ae8"},"sequence":2107,"recorded_at":1780531400004209,"record_type":"event","durability":"durable","causation_id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1","run_stream":{"kind":"run","id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1"},"task_stream":{"kind":"task","id":"01a0a80d-f58a-78e2-8c7a-48c33656bac9"},"task_id":"01a0a80d-f58a-78e2-8c7a-48c33656bac9","event":{"kind":"output","task_id":"01a0a80d-f58a-78e2-8c7a-48c33656bac9","chunk":"Read text file `Packages/RunnerControlCore/Sources/GitHubTokenRefresh.swift`.\n1|import Foundation\n2|\n3|/// Serialized token refresh. Concurrent callers coalesce to a single network refresh.\n4|public actor GitHubTokenRefresh {\n5|    private let transport: any GitHubHTTPTransport\n6|    private let store: any GitHubCredentialStoring\n7|    private let now: @Sendable () -> Date\n8|\n9|    public init(\n10|        transport: any GitHubHTTPTransport,\n11|        store: any GitHubCredentialStoring,\n12|        now: @Sendable @escaping () -> Date = Date.init\n13|    ) {\n14|        self.transport = transport\n15|        self.store = store\n16|        self.now = now\n17|    }\n18|\n19|    public func refresh(\n20|        config: GitHubAuth.AppConfig,\n21|        userID: Int64,\n22|        current: GitHubAuth.TokenRecord\n23|    ) async throws -> GitHubAuth.TokenRecord {\n24|        // Coalesce: if another task refreshed while we waited for the actor, reuse it.\n25|        if let latest = await store.load(serverHost: config.serverHost, userID: userID, clientID: config.clientID),\n26|           latest.accessToken != current.accessToken {\n27|            return latest\n28|        }\n29|        guard let refreshToken = current.refreshToken, !refreshToken.isEmpty else {\n30|            throw GitHubAuth.AuthError.tokenRefreshFailed\n31|        }\n32|        let body = try JSONEncoder().encode(GitHubAuth.TokenRefreshRequest(\n33|            client_id: config.clientID,\n34|            grant_type: \"refresh_token\",\n35|            refresh_token: refreshToken\n36|        ))\n37|        let request = GitHubHTTPRequest(\n38|            method: \"POST\",\n39|            url: config.tokenURL,\n40|            headers: [\"Accept\": \"application/json\", \"Content-Type\": \"application/json\"],\n41|            body: body\n42|        )\n43|        let response: GitHubHTTPResponse\n44|        do {\n45|            response = try await transport.send(request)\n46|        } catch {\n47|            throw GitHubAuth.AuthError.network(GitHubTransportError.offline.localizedDescription)\n48|        }\n49|        let decoded: GitHubAuth.TokenSuccessResponse\n50|        do {\n51|            decoded = try JSONDecoder().decode(GitHubAuth.TokenSuccessResponse.self, from: response.body)\n52|        } catch {\n53|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n54|        }\n55|        if let token = decoded.access_token, !token.isEmpty {\n56|            try GitHubAuth.PATGuard.validate(token: token)\n57|            let expiresAt: Date?\n58|            if let seconds = decoded.expires_in {\n59|                expiresAt = now().addingTimeInterval(TimeInterval(seconds))\n60|            } else {\n61|                expiresAt = nil\n62|            }\n63|            let next = GitHubAuth.TokenRecord(\n64|                accessToken: token,\n65|                refreshToken: decoded.refresh_token ?? refreshToken,\n66|                expiresAt: expiresAt,\n67|                obtainedAt: now()\n68|            )\n69|            try await store.save(next, serverHost: config.serverHost, userID: userID, clientID: config.clientID)\n70|            return next\n71|        }\n72|        if decoded.error == \"invalid_grant\" {\n73|            throw GitHubAuth.AuthError.revoked\n74|        }\n75|        throw GitHubAuth.AuthError.tokenRefreshFailed\n76|    }\n77|\n78|    public static func isExpiringSoon(_ record: GitHubAuth.TokenRecord, now: Date = Date(), within seconds: TimeInterval = 60) -> Bool {\n79|        guard let expiresAt = record.expiresAt else { return false }\n80|        return expiresAt.timeIntervalSince(now) <= seconds\n81|    }\n82|}","final_result":true}}}
