s.Definition) -> Void\n36|        let openLogs: (Runners.Definition) -> Void\n37|        let showDirectory: (Runners.Definition) -> Void\n38|        let clearRunnerError: () -> Void\n39|        let serverHostChanged: (String) -> Void\n40|        let beginLogin: () -> Void\n41|        let cancelLogin: () -> Void\n42|        let logout: () -> Void\n43|        let openVerification: (URL) -> Void\n44|        let copyCode: (String) -> Void\n45|        let refreshInstallations: () -> Void\n46|        let selectInstallation: (Int64?) -> Void\n47|        let selectRepositories: (Set<Int64>) -> Void\n48|        let grantAccess: () -> Void\n49|        let revokeInGitHub: () -> Void\n50|        let checkForUpdates: () -> Void\n51|        let setAutomaticChecks: (Bool) -> Void\n52|        let setAutomaticDownloads: (Bool) -> Void\n53|        let setLaunchAtLogin: (Bool) -> Void\n54|        let quit: () -> Void\n55|    }\n56|\n57|    let props: Props\n58|    let reactions: Reactions\n59|    @State private var selection: Tab = .runners\n60|\n61|    enum Tab: Hashable {\n62|        case runners, github, general\n63|    }\n64|\n65|    var body: some View {\n66|        TabView(selection: $selection) {\n67|            runnersTab\n68|                .tabItem { Label(\"Раннеры\", systemImage: \"bolt.circle\") }\n69|                .tag(Tab.runners)\n70|            githubTab\n71|                .tabItem { Label(\"GitHub\", systemImage: \"person.circle\") }\n72|                .tag(Tab.github)\n73|            generalTab\n74|                .tabItem { Label(\"Основные\", systemImage: \"gearshape\") }\n75|                .tag(Tab.general)\n76|        }\n77|        .frame(width: 760, height: 540)\n78|    }\n79|\n80|    // MARK: - Runners\n81|\n82|    private var active: Int { props.runners.filter { $0.status == .running }.count }\n83|\n84|    private var runnersTab: some View {\n85|        VStack(alignment: .leading, spacing: 14) {\n86|            HStack(spacing: 10) {\n87|                VStack(alignment: .leading, spacing: 3) {\n88|                    Text(\"Раннеры на этом Mac\").font(.system(size: 15, weight: .semibold))\n89|                    Text(\"\\(Host.current().localizedName ?? \"Этот Mac\") · \\(active) из \\(props.runners.count) включено\")\n90|                        .font(.system(size: 11)).foregroundStyle(.secondary)\n(more lines below)","final_result":true}}}
