{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c555","stream":{"kind":"session","id":"01a0a800-dff5-7ec3-9e60-f73779a17ae8"},"sequence":261,"recorded_at":1780531400000517,"record_type":"event","durability":"durable","causation_id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1","run_stream":{"kind":"run","id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1"},"task_stream":{"kind":"task","id":"01a0a801-5fd1-7fa2-b314-cff59278f2df"},"task_id":"01a0a801-5fd1-7fa2-b314-cff59278f2df","event":{"kind":"output","task_id":"01a0a801-5fd1-7fa2-b314-cff59278f2df","chunk":"Read text file `Targets/RunnerControl/Sources/AppRegistry.swift`.\n1|import Foundation\n2|import RunnerControlCore\n3|\n4|@MainActor enum AppRegistry {\n5|    static let state = Runners.State()\n6|    static let updater = AppUpdater()\n7|    private static var task: Task<Void, Never>?\n8|    static func start() {\n9|        guard task == nil else { return }\n10|        updater.start()\n11|        // One composition root for every MenuBarExtra presentation.\n12|        task = Task {\n13|            _ = await RunnerRuntime.make(state: state)\n14|            while !Task.isCancelled {\n15|                await action { Runners.Effect.refresh }\n16|                try? await Task.sleep(for: .seconds(3))\n17|            }\n18|        }\n19|    }\n20|}","final_result":true}}}
