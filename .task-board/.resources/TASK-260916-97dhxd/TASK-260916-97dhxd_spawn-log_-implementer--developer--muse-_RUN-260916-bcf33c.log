      return true\n32|    }\n33|    private func showControls() {\n34|        if window == nil {\n35|            let controller = NSHostingController(rootView: RunnerContainer(state: AppRegistry.state))\n36|            let value = NSWindow(contentViewController: controller)\n37|            value.title = \"Runner Control\"\n38|            value.styleMask = [.titled, .closable]\n39|            value.isReleasedWhenClosed = false\n40|            value.center()\n41|            window = value\n42|        }\n43|        window?.makeKeyAndOrderFront(nil)\n44|        NSApp.activate(ignoringOtherApps: true)\n45|    }\n46|}","final_result":true}}}
