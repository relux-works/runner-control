{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5d3","stream":{"kind":"session","id":"01a0a800-dff5-7ec3-9e60-f73779a17ae8"},"sequence":324,"recorded_at":1780531400000643,"record_type":"event","durability":"durable","causation_id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1","run_stream":{"kind":"run","id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1"},"task_stream":{"kind":"task","id":"01a0a801-6cee-7f33-af3c-a9803cc8ef8c"},"task_id":"01a0a801-6cee-7f33-af3c-a9803cc8ef8c","event":{"kind":"output","task_id":"01a0a801-6cee-7f33-af3c-a9803cc8ef8c","chunk":"Read text file `Packages/RunnerControlCore/Tests/RunnerDiscoveryTests.swift`.\n1|import Foundation\n2|import Testing\n3|@testable import RunnerControlCore\n4|\n5|@Test func discoversManualAndStandardServicesWithoutMachineNames() throws {\n6|    let home = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)\n7|    defer { try? FileManager.default.removeItem(at: home) }\n8|    let fm = FileManager.default\n9|    let agents = home.appendingPathComponent(\"Library/LaunchAgents\")\n10|    try fm.createDirectory(at: agents, withIntermediateDirectories: true)\n11|    func install(_ folder: URL, _ manifest: URL, _ label: String, _ scope: String) throws {\n12|        try fm.createDirectory(at: folder, withIntermediateDirectories: true)\n13|        let config: [String: Any] = [\"agentName\": \"any-mac\", \"gitHubUrl\": \"https://github.com/\" + scope, \"workFolder\": \"_work\"]\n14|        var registration = Data([0xef, 0xbb, 0xbf])\n15|        registration.append(try JSONSerialization.data(withJSONObject: config))\n16|        try registration.write(to: folder.appendingPathComponent(\".runner\"))\n17|        let plist: [String: Any] = [\"Label\": label, \"WorkingDirectory\": folder.path, \"ProgramArguments\": [folder.appendingPathComponent(\"runsvc.sh\").path]]\n18|        try PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0).write(to: manifest)\n19|    }\n20|    let manual = home.appendingPathComponent(\"Library/GitHubActions/manual\")\n21|    try install(manual, manual.appendingPathComponent(\"manual-service.plist\"), \"actions.runner.example.manual\", \"example/project\")\n22|    let other = home.appendingPathComponent(\"custom-install\")\n23|    let service = agents.appendingPathComponent(\"actions.runner.example.other.plist\")\n24|    try install(other, service, \"actions.runner.example.other\", \"example\")\n25|    // Duplicate manifest must not create another controllable row.\n26|    try install(manual, agents.appendingPathComponent(\"actions.runner.example.manual.plist\"), \"actions.runner.example.manual\", \"example/project\")\n27|    let found = RunnerDiscovery.installed(home: home)\n28|    #expect(found.count == 2)\n29|    #expect(Set(found.map(\\.title)) == [\"any-mac\"])\n30|    #expect(found.first { $0.directory.path == other.path }?.plist.resolvingSymlinksInPath() == service.resolvingSymlinksInPath())\n31|    #expect(found.first { $0.directory.path == other.path }?.githubURL.absoluteString == \"https://github.com/organizations/example/settings/actions/runners\")\n32|    #expect(found.first { $0.directory.path == manual.path }?.githubURL.absoluteString == \"https://github.com/example/project/settings/actions/runners\")\n33|    try Data(\"invalid\".utf8).write(to: service)\n34|    #expect(RunnerDiscovery.installed(home: home).count == 1)\n35|}\n36|\n37|@Test func missingDiscoveryRootsReturnEmpty() {\n38|    #expect(RunnerDiscovery.installed(home: URL(fileURLWithPath: \"/nonexistent-\" + UUID().uuidString)).isEmpty)\n39|}","final_result":true}}}
