{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf67","stream":{"kind":"session","id":"01a0a800-dff5-7ec3-9e60-f73779a17ae8"},"sequence":1550,"recorded_at":1780531400003095,"record_type":"event","durability":"durable","causation_id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1","run_stream":{"kind":"run","id":"5bfa53ee-3974-4b46-9ee1-e5a5376687f1"},"call_id":"call_01a0a809f22b75e5a343bb8698f98a5d","text":"Read text file `Targets/RunnerControl/Sources/RunnerPage.swift`.\n1|import SwiftUI\n2|import RunnerControlCore\n3|\n4|struct RunnerPage: View {\n5|    struct Props {\n6|        let runners: [Runners.Snapshot]\n7|        let changing: Set<String>\n8|        let error: String?\n9|        let canCheckForUpdates: Bool\n10|        let automaticChecks: Bool\n11|        let automaticDownloads: Bool\n12|    }\n13|    struct Reactions {\n14|        let setEnabled: (String, Bool) -> Void\n15|        let enableAll: () -> Void\n16|        let disableAll: () -> Void\n17|        let openGitHub: (Runners.Definition) -> Void\n18|        let openLogs: (Runners.Definition) -> Void\n19|        let clearError: () -> Void\n20|        let quit: () -> Void\n21|        let checkForUpdates: () -> Void\n22|        let setAutomaticChecks: (Bool) -> Void\n23|        let setAutomaticDownloads: (Bool) -> Void\n24|    }\n25|    let props: Props\n26|    let reactions: Reactions\n27|    private var active: Int { props.runners.filter { $0.status == .running }.count }\n28|    var body: some View {\n29|        VStack(alignment: .leading, spacing: 18) {\n30|            HStack(spacing: 10) {\n31|                Image(systemName: \"bolt.circle.fill\")\n32|                    .font(.system(size: 30, weight: .medium)).foregroundStyle(.teal)\n33|                VStack(alignment: .leading, spacing: 3) {\n34|                    Text(\"Runner Control\").font(.system(size: 16, weight: .semibold))\n35|                    Text(\"\\(Host.current().localizedName ?? \"Этот Mac\") · \\(active) из \\(props.runners.count) включено\")\n36|                        .font(.system(size: 11)).foregroundStyle(.secondary)\n37|                }\n38|                Spacer()\n39|                Circle().fill(active > 0 ? Color.green : Color.secondary.opacity(0.4)).frame(width: 8, height: 8)\n40|            }\n41|            if props.runners.isEmpty {\n42|                Text(\"Установленные службы раннеров не найдены на этом Mac.\")\n43|                    .font(.callout).foregroundStyle(.secondary)\n44|            }\n45|            VStack(spacing: 10) {\n46|                ForEach(props.runners) { runner in\n47|                    RunnerCard(snapshot: runner, changing: props.changing.contains(runner.id),\n48|                               setEnabled: { reactions.setEnabled(runner.id, $0) },\n49|                               openGitHub: { reactions.openGitHub(runner.definition) },\n50|                               openLogs: { reactions.openLogs(runner.definition) })\n51|                }\n52|            }\n53|            if let error = props.error {\n54|                HStack(alignment: .top, spacing: 8) {\n55|                    Image(systemName: \"exclamationmark.triangle.fill\").foregroundStyle(.orange)\n56|                    Text(error).font(.caption).textSelection(.enabled).lineLimit(6)\n57|                    Spacer(minLength: 0)\n58|                    Button(action: reactions.clearError) { Image(systemName: \"xmark\") }.buttonStyle(.plain)\n59|                }.padding(10).background(.orange.opacity(0.08), in: RoundedRectangle(cornerRadius: 10))\n60|            }\n61|            HStack(spacing: 8) {\n62|                Button(\"Включить все\", action: reactions.enableAll)\n63|                    .buttonStyle(.borderedProminent).tint(.teal)\n64|                    .disabled(!props.changing.isEmpty || props.runners.allSatisfy { $0.status == .running || $0.status == .checking || $0.status == .missing || $0.status == .unknown })\n65|                Button(\"Выключить все\", action: reactions.disableAll)\n66|                    .buttonStyle(.bordered)\n67|                    .disabled(!props.changing.isEmpty || props.runners.allSatisfy { $0.status == .stopped || $0.status == .checking })\n68|            }.controlSize(.regular)\n69|            Text(\"Закрытие приложения не останавливает CI. Автозапуск определяется настройками каждой службы.\")\n70|                .font(.system(size: 11)).foregroundStyle(.secondary).fixedSize(horizontal: false, vertical: true)\n71|            Divider()\n72|            VStack(alignment: .leading, spacing: 9) {\n73|                HStack {\n74|                    Text(\"Обновления\").font(.system(size: 12, weight: .medium))\n75|                    Spacer()\n76|                    Button(\"Проверить…\", action: reactions.checkForUpdates)\n77|                        .disabled(!props.canCheckForUpdates)\n78|                }\n79|                Toggle(\"Проверять автоматически\", isOn: Binding(get: { props.automaticChecks }, set: reactions.setAutomaticChecks))\n80|                Toggle(\"Устанавливать автоматически\", isOn: Binding(get: { props.automaticDownloads }, set: reactions.setAutomaticDownloads))\n81|                    .disabled(!props.automaticChecks)\n82|            }.font(.system(size: 11)).toggleStyle(.switch).controlSize(.mini)\n83|            Divider()\n84|            HStack {\n85|                Text(\"RELUX WORKS\").font(.system(size: 9, weight: .semibold, design: .monospaced)).tracking(1.5).foregroundStyle(.tertiary)\n86|                Spacer()\n87|                Button(\"Закрыть приложение\", action: reactions.quit).buttonStyle(.plain)\n88|                    .font(.system(size: 11)).foregroundStyle(.secondary).disabled(!props.changing.isEmpty)\n89|            }\n90|        }.padding(20).frame(width: 370)\n91|    }\n92|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
