{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d7","stream":{"kind":"session","id":"01a0a841-0b8e-7df2-8923-843adf19c894"},"sequence":454,"recorded_at":1780531400000903,"record_type":"event","durability":"durable","causation_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","run_stream":{"kind":"run","id":"0a9b0514-6796-4bae-973f-c687f7c4e3df"},"call_id":"call_01a0a843a8747545b8882457d15c1349","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubDeviceFlow.swift`.\n1|import Foundation\n2|\n3|extension GitHubAuth {\n4|    public enum PollResult: Sendable, Equatable {\n5|        case pending\n6|        case slowDown\n7|        case success(accessToken: String, refreshToken: String?, expiresIn: Int?)\n8|        case denied\n9|        case expired\n10|    }\n11|}\n12|\n13|/// Device Flow transport. Holds no tokens beyond the in-flight call.\n14|public actor GitHubDeviceFlow {\n15|    private let transport: any GitHubHTTPTransport\n16|\n17|    public init(transport: any GitHubHTTPTransport) {\n18|        self.transport = transport\n19|    }\n20|\n21|    public func requestCode(config: GitHubAuth.AppConfig) async throws -> GitHubAuth.DeviceCodeResponse {\n22|        let body = try JSONEncoder().encode(GitHubAuth.DeviceCodeRequest(client_id: config.clientID))\n23|        let request = GitHubHTTPRequest(\n24|            method: \"POST\",\n25|            url: config.deviceAuthorizationURL,\n26|            headers: [\"Accept\": \"application/json\", \"Content-Type\": \"application/json\"],\n27|            body: body\n28|        )\n29|        let response: GitHubHTTPResponse\n30|        do {\n31|            response = try await transport.send(request)\n32|        } catch {\n33|            throw GitHubAuth.AuthError.network(GitHubTransportError.offline.localizedDescription)\n34|        }\n35|        guard response.status == 200 else {\n36|            if let mapped = GitHubAuth.RESTMapper.map(status: response.status, body: response.body) {\n37|                throw mapped\n38|            }\n39|            throw GitHubAuth.AuthError.network(\"Device code request failed (HTTP \\(response.status)).\")\n40|        }\n41|        do {\n42|            return try JSONDecoder().decode(GitHubAuth.DeviceCodeResponse.self, from: response.body)\n43|        } catch {\n44|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n45|        }\n46|    }\n47|\n48|    public func pollOnce(config: GitHubAuth.AppConfig, deviceCode: String) async throws -> GitHubAuth.PollResult {\n49|        let body = try JSONEncoder().encode(GitHubAuth.TokenPollRequest(\n50|            client_id: config.clientID,\n51|            device_code: deviceCode,\n52|            grant_type: \"urn:ietf:params:oauth:grant-type:device_code\"\n53|        ))\n54|        let request = GitHubHTTPRequest(\n55|            method: \"POST\",\n56|            url: config.tokenURL,\n57|            headers: [\"Accept\": \"application/json\", \"Content-Type\": \"application/json\"],\n58|            body: body\n59|        )\n60|        let response: GitHubHTTPResponse\n61|        do {\n62|            response = try await transport.send(request)\n63|        } catch {\n64|            throw GitHubAuth.AuthError.network(GitHubTransportError.offline.localizedDescription)\n65|        }\n66|        // HTTP 200 does not imply success: Device Flow reports errors in the body.\n67|        let decoded: GitHubAuth.TokenSuccessResponse\n68|        do {\n69|            decoded = try JSONDecoder().decode(GitHubAuth.TokenSuccessResponse.self, from: response.body)\n70|        } catch {\n71|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n72|        }\n73|        if let token = decoded.access_token, !token.isEmpty {\n74|            try GitHubAuth.PATGuard.validate(token: token)\n75|            return .success(accessToken: token, refreshToken: decoded.refresh_token, expiresIn: decoded.expires_in)\n76|        }\n77|        switch decoded.error {\n78|        case \"authorization_pending\": return .pending\n79|        case \"slow_down\": return .slowDown\n80|        case \"access_denied\": return .denied\n81|        case \"expired_token\": return .expired\n82|        case .none:\n83|            throw GitHubAuth.AuthError.network(GitHubTransportError.invalidResponse.localizedDescription)\n84|        case .some(let other):\n85|            throw GitHubAuth.AuthError.network(decoded.error_description ?? other)\n86|        }\n87|    }\n88|\n89|    /// slow_down increases the poll interval by 5 seconds (GitHub docs).\n90|    public static func nextInterval(current: Int, after result: GitHubAuth.PollResult) -> Int {\n91|        if result == .slowDown { return current + 5 }\n92|        return current\n93|    }\n94|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d9","stream":{"kind":"session","id":"01a0a841-0b8e-7df2-8923-843adf19c894"},"sequence":455,"recorded_at":1780531400000905,"record_type":"event","durability":"durable","causation_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","run_stream":{"kind":"run","id":"0a9b0514-6796-4bae-973f-c687f7c4e3df"},"call_id":"call_01a0a843a9d6718bb697ba90d5a90a18","text":"Read text file `Packages/RunnerControlCore/Sources/GitHubAuth+State+Reducer.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension GitHubAuth.State {\n5|    public func reduce(with action: any Relux.Action) async {\n6|        guard let action = action as? GitHubAuth.Action else { return }\n7|        switch action {\n8|        case .restoreStarted(let host):\n9|            connection = .verifyingAccount\n10|            serverHost = host\n11|            syncError = nil\n12|        case .loginStarted(let host):\n13|            connection = .requestingCode\n14|            serverHost = host\n15|            syncError = nil\n16|        case .codeReceived(let userCode, let uri, let expiresIn, let interval):\n17|            connection = .awaitingUser(userCode: userCode, verificationURI: uri, expiresIn: expiresIn, interval: interval)\n18|        case .pollIntervalUpdated(let interval):\n19|            if case .awaitingUser(let userCode, let uri, let expiresIn, _) = connection {\n20|                connection = .awaitingUser(userCode: userCode, verificationURI: uri, expiresIn: expiresIn, interval: interval)\n21|            }\n22|        case .loginCancelled:\n23|            connection = .disconnected\n24|            syncError = nil\n25|        case .accountVerified(let username, let userID, let host):\n26|            self.username = username\n27|            self.userID = userID\n28|            serverHost = host\n29|            connection = .verifyingInstallations(username: username)\n30|        case .installationsLoaded(let installations):\n31|            self.installations = installations\n32|            if selectedInstallationID == nil {\n33|                selectedInstallationID = installations.first?.id\n34|            } else if let selected = selectedInstallationID, !installations.contains(where: { $0.id == selected }) {\n35|                selectedInstallationID = installations.first?.id\n36|            }\n37|        case .repositoriesLoaded(let installationID, let repositories):\n38|            if selectedInstallationID == installationID || selectedInstallationID == nil {\n39|                self.repositories = repositories\n40|            }\n41|        case .connected(let username, let host, let date):\n42|            self.username = username\n43|            serverHost = host\n44|            connection = .connected(username: username, serverHost: host)\n45|            lastSyncAt = date\n46|            syncError = nil\n47|        case .failed(let message, let retry):\n48|            connection = .failed(message: message, retry: retry)\n49|        case .syncFailed(let message):\n50|            syncError = message\n51|        case .syncSucceeded(let date):\n52|            lastSyncAt = date\n53|            syncError = nil\n54|        case .installationSelected(let id):\n55|            selectedInstallationID = id\n56|            repositories = []\n57|        case .repositoriesSelected(let ids):\n58|            selectedRepositoryIDs = ids\n59|        case .loggedOut:\n60|            connection = .disconnected\n61|            username = nil\n62|            userID = nil\n63|            installations = []\n64|            selectedInstallationID = nil\n65|            repositories = []\n66|            selectedRepositoryIDs = []\n67|            syncError = nil\n68|            lastSyncAt = nil\n69|        case .clearSyncError:\n70|            syncError = nil\n71|        }\n72|    }\n73|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
