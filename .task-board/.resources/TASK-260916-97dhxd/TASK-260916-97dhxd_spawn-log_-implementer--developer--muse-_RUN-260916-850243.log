{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c637","stream":{"kind":"session","id":"01a0a841-0b8e-7df2-8923-843adf19c894"},"sequence":374,"recorded_at":1780531400000743,"record_type":"event","durability":"durable","causation_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","run_stream":{"kind":"run","id":"0a9b0514-6796-4bae-973f-c687f7c4e3df"},"task_stream":{"kind":"task","id":"01a0a841-d4e8-7c30-942b-12da8d72e6f9"},"task_id":"01a0a841-d4e8-7c30-942b-12da8d72e6f9","event":{"kind":"output","task_id":"01a0a841-d4e8-7c30-942b-12da8d72e6f9","chunk":"Read text file `Packages/RunnerControlCore/Tests/GitHubAuthFlowTests.swift`.\n(499 line(s) above)\n500|        }\n501|        if path == \"/user\" { return jsonResponse([\"login\": \"octo\", \"id\": 42]) }\n502|        if path == \"/user/installations\" {\n503|            return jsonResponse([\"installations\": [[\"id\": 7, \"account\": [\"login\": \"acme\", \"type\": \"Organization\"]]]])\n504|        }\n505|        if path.hasSuffix(\"/repositories\") {\n506|            return jsonResponse([\"repositories\": [[\"id\": 9, \"full_name\": \"acme/app\", \"private\": false]]])\n507|        }\n508|        throw GitHubTransportError.invalidResponse\n509|    }\n510|}\n511|\n512|@Test func flowConcurrentRefreshAndSelectCoalesceToSingleRefresh() async throws {\n513|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n514|    let transport = RoutingTransport()\n515|    let (flow, logger, credentialStore) = await githubHarness(transport: transport, store: store)\n516|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n517|    #expect(await waitForLoggedActions(logger, count: 6))\n518|    try await credentialStore.save(\n519|        GitHubAuth.TokenRecord(accessToken: \"ghu_old\", refreshToken: \"ghr_old\", expiresAt: Date().addingTimeInterval(30)),\n520|        serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n521|    )\n522|    async let first = flow.apply(GitHubAuth.Effect.refreshInstallations)\n523|    async let second = flow.apply(GitHubAuth.Effect.selectInstallation(7))\n524|    _ = await (first, second)\n525|    #expect(await waitForLoggedActions(logger, count: 11))\n526|    let all = await transport.requests\n527|    let refreshGrants = all.filter {\n528|        guard $0.url.path.hasSuffix(\"/login/oauth/access_token\"), let body = $0.body else { return false }\n529|        return (try? JSONSerialization.jsonObject(with: body) as? [String: String])?[\"grant_type\"] == \"refresh_token\"\n530|    }\n531|    #expect(refreshGrants.count == 1)\n532|    #expect(await credentialStore.load(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID)?.accessToken == \"ghu_new\")\n533|    let actions = githubActions(logger)\n534|    #expect(actions.contains { if case .repositoriesLoaded(let id, _) = $0, id == 7 { true } else { false } })\n535|    #expect(actions.filter { if case .syncSucceeded = $0 { true } else { false } }.count == 2)\n536|}","final_result":true}}}
