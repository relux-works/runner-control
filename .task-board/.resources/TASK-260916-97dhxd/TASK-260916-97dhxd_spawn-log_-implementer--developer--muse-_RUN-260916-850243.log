{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6cf","stream":{"kind":"session","id":"01a0a841-0b8e-7df2-8923-843adf19c894"},"sequence":450,"recorded_at":1780531400000895,"record_type":"event","durability":"durable","causation_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","run_stream":{"kind":"run","id":"0a9b0514-6796-4bae-973f-c687f7c4e3df"},"task_stream":{"kind":"task","id":"01a0a843-ad48-7cc3-95af-02c10d664c05"},"task_id":"01a0a843-ad48-7cc3-95af-02c10d664c05","event":{"kind":"output","task_id":"01a0a843-ad48-7cc3-95af-02c10d664c05","chunk":"Read text file `Packages/RunnerControlCore/Sources/GitHubAuth+State+Reducer.swift`.\n1|import Foundation\n2|import Relux\n3|\n4|extension GitHubAuth.State {\n5|    public func reduce(with action: any Relux.Action) async {\n6|        guard let action = action as? GitHubAuth.Action else { return }\n7|        switch action {\n8|        case .restoreStarted(let host):\n9|            connection = .verifyingAccount\n10|            serverHost = host\n11|            syncError = nil\n12|        case .loginStarted(let host):\n13|            connection = .requestingCode\n14|            serverHost = host\n15|            syncError = nil\n16|        case .codeReceived(let userCode, let uri, let expiresIn, let interval):\n17|            connection = .awaitingUser(userCode: userCode, verificationURI: uri, expiresIn: expiresIn, interval: interval)\n18|        case .pollIntervalUpdated(let interval):\n19|            if case .awaitingUser(let userCode, let uri, let expiresIn, _) = connection {\n20|                connection = .awaitingUser(userCode: userCode, verificationURI: uri, expiresIn: expiresIn, interval: interval)\n21|            }\n22|        case .loginCancelled:\n23|            connection = .disconnected\n24|            syncError = nil\n25|        case .accountVerified(let username, let userID, let host):\n26|            self.username = username\n27|            self.userID = userID\n28|            serverHost = host\n29|            connection = .verifyingInstallations(username: username)\n30|        case .installationsLoaded(let installations):\n31|            self.installations = installations\n32|            if selectedInstallationID == nil {\n33|                selectedInstallationID = installations.first?.id\n34|            } else if let selected = selectedInstallationID, !installations.contains(where: { $0.id == selected }) {\n35|                selectedInstallationID = installations.first?.id\n36|            }\n37|        case .repositoriesLoaded(let installationID, let repositories):\n38|            if selectedInstallationID == installationID || selectedInstallationID == nil {\n39|                self.repositories = repositories\n40|            }\n41|        case .connected(let username, let host, let date):\n42|            self.username = username\n43|            serverHost = host\n44|            connection = .connected(username: username, serverHost: host)\n45|            lastSyncAt = date\n46|            syncError = nil\n47|        case .failed(let message, let retry):\n48|            connection = .failed(message: message, retry: retry)\n49|        case .syncFailed(let message):\n50|            syncError = message\n51|        case .syncSucceeded(let date):\n52|            lastSyncAt = date\n53|            syncError = nil\n54|        case .installationSelected(let id):\n55|            selectedInstallationID = id\n56|            repositories = []\n57|        case .repositoriesSelected(let ids):\n58|            selectedRepositoryIDs = ids\n59|        case .loggedOut:\n60|            connection = .disconnected\n61|            username = nil\n62|            userID = nil\n63|            installations = []\n64|            selectedInstallationID = nil\n65|            repositories = []\n66|            selectedRepositoryIDs = []\n67|            syncError = nil\n68|            lastSyncAt = nil\n69|        case .clearSyncError:\n70|            syncError = nil\n71|        }\n72|    }\n73|}","final_result":true}}}
