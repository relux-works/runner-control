9|                    await action { GitHubAuth.Effect.refreshInstallations }\n30|                }\n31|                _ = ticks\n32|            }\n33|        }\n34|    }\n35|\n36|    static func openManagementWindow() {\n37|        NotificationCenter.default.post(name: .openManagementWindow, object: nil)\n38|    }\n39|}\n40|\n41|extension Notification.Name {\n42|    static let openManagementWindow = Notification.Name(\"works.relux.runnercontrol.openManagementWindow\")\n43|}","final_result":true}}}
