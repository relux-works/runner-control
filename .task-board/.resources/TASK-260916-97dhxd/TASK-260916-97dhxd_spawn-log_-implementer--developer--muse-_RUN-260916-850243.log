{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c513","stream":{"kind":"session","id":"01a0a841-0b8e-7df2-8923-843adf19c894"},"sequence":228,"recorded_at":1780531400000451,"record_type":"event","durability":"durable","causation_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","run_stream":{"kind":"run","id":"0a9b0514-6796-4bae-973f-c687f7c4e3df"},"task_stream":{"kind":"task","id":"01a0a841-95e7-74d0-9141-3e023ebff671"},"task_id":"01a0a841-95e7-74d0-9141-3e023ebff671","event":{"kind":"output","task_id":"01a0a841-95e7-74d0-9141-3e023ebff671","chunk":"Read text file `/tmp/RA.swift`.\n1|import Foundation\n2|import Testing\n3|import Relux\n4|@testable import RunnerControlCore\n5|\n6|/// Transport that delays every response so a logout can interleave with an in-flight call.\n7|actor SlowTransport: GitHubHTTPTransport {\n8|    private var queue: [GitHubHTTPResponse]\n9|    private(set) var requests: [GitHubHTTPRequest] = []\n10|    let delayMs: Int\n11|    init(_ responses: [GitHubHTTPResponse], delayMs: Int) { self.queue = responses; self.delayMs = delayMs }\n12|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n13|        requests.append(request)\n14|        try? await Task.sleep(for: .milliseconds(delayMs))\n15|        guard !queue.isEmpty else { throw GitHubTransportError.invalidResponse }\n16|        return queue.removeFirst()\n17|    }\n18|}\n19|\n20|private func attackHarness(transport: any GitHubHTTPTransport, store: GitHubKeychainStore, identities: any GitHubSessionIdentityStoring) async -> (GitHubAuth.Flow, Relux.Testing.Logger) {\n21|    let logger = Relux.Testing.Logger()\n22|    let dispatcher = Relux.Dispatcher(logger: logger)\n23|    let flow = await GitHubAuth.Flow(\n24|        deviceFlow: GitHubDeviceFlow(transport: transport),\n25|        api: GitHubAPIClient(transport: transport),\n26|        refresher: GitHubTokenRefresh(transport: transport, store: store),\n27|        store: store, identityStore: identities,\n28|        configProvider: { _ in testConfig }, sleeper: { _ in }, dispatcher: dispatcher)\n29|    return (flow, logger)\n30|}\n31|\n32|private func names(_ logger: Relux.Testing.Logger) -> [String] {\n33|    logger.actions.compactMap { $0 as? GitHubAuth.Action }.map { String(describing: $0).components(separatedBy: \"(\")[0] }\n34|}\n35|\n36|// RA1: logout while restoreSession is awaiting /user must not revive the session afterwards.\n37|@Test func reviewerLogoutDuringRestoreDoesNotReviveSession() async throws {\n38|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n39|    let identities = InMemoryGitHubSessionIdentityStore(value: GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n40|    try await store.save(GitHubAuth.TokenRecord(accessToken: \"ghu_saved\", refreshToken: \"ghr_saved\", expiresAt: Date().addingTimeInterval(3600)), serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID)\n41|    let transport = SlowTransport([\n42|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n43|        jsonResponse([\"installations\": []]),\n44|    ], delayMs: 300)\n45|    let (flow, logger) = await attackHarness(transport: transport, store: store, identities: identities)\n46|    let restore = Task { _ = await flow.apply(GitHubAuth.Effect.restoreSession) }\n47|    try await Task.sleep(for: .milliseconds(100))\n48|    _ = await flow.apply(GitHubAuth.Effect.logout)\n49|    _ = await restore.value\n50|    try await Task.sleep(for: .milliseconds(200))\n51|    let seq = names(logger)\n52|    print(\"RA1 sequence:\", seq)\n53|    let loggedOutIdx = seq.lastIndex(of: \"loggedOut\") ?? -1\n54|    let afterLogout = Array(seq.suffix(from: loggedOutIdx + 1))\n55|    #expect(!afterLogout.contains(\"connected\"), \"restore revived session after logout: \\(afterLogout)\")\n56|    #expect(!afterLogout.contains(\"accountVerified\"), \"restore verified account after logout: \\(afterLogout)\")\n57|    // Session must be gone: a sync now is a no-op.\n58|    let before = logger.actions.count\n59|    _ = await flow.apply(GitHubAuth.Effect.refreshInstallations)\n60|    try await Task.sleep(for: .milliseconds(100))\n61|    #expect(logger.actions.count == before, \"refresh after logout still had a session: \\(names(logger))\")\n62|    #expect(await identities.load() == nil)\n63|}\n64|\n65|// RA2: logout while refreshInstallations is awaiting /user/installations must not emit sync results afterwards.\n66|@Test func reviewerLogoutDuringRefreshDoesNotEmitSyncAfterLoggedOut() async throws {\n67|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n68|    let identities = InMemoryGitHubSessionIdentityStore()\n69|    let transport = SlowTransport([\n70|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n71|        jsonResponse([\"access_token\": \"ghu_x\", \"refresh_token\": \"ghr_y\", \"expires_in\": 3600]),\n72|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n73|        jsonResponse([\"installations\": []]),\n74|        jsonResponse([\"installations\": [[\"id\": 7, \"account\": [\"login\": \"acme\", \"type\": \"Organization\"]]]]),\n75|    ], delayMs: 150)\n76|    let (flow, logger) = await attackHarness(transport: transport, store: store, identities: identities)\n77|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n78|    let deadline = ContinuousClock.now.advanced(by: .seconds(3))\n79|    while ContinuousClock.now < deadline, !names(logger).contains(\"connected\") { try await Task.sleep(for: .milliseconds(20)) }\n80|    #expect(names(logger).contains(\"connected\"))\n81|    let refresh = Task { _ = await flow.apply(GitHubAuth.Effect.refreshInstallations) }\n82|    try await Task.sleep(for: .milliseconds(50))\n83|    _ = await flow.apply(GitHubAuth.Effect.logout)\n84|    _ = await refresh.value\n85|    try await Task.sleep(for: .milliseconds(100))\n86|    let seq = names(logger)\n87|    print(\"RA2 sequence:\", seq)\n88|    let loggedOutIdx = seq.lastIndex(of: \"loggedOut\") ?? -1\n89|    let afterLogout = Array(seq.suffix(from: loggedOutIdx + 1))\n90|    #expect(afterLogout.isEmpty, \"actions after loggedOut: \\(afterLogout)\")\n91|}\n92|\n93|// RA3: beginLogin while restoreSession is in flight must not have restore clobber the login state.\n94|@Test func reviewerLoginDuringRestoreIsNotClobberedByRestore() async throws {\n95|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n96|    let identities = InMemoryGitHubSessionIdentityStore(value: GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n97|    try await store.save(GitHubAuth.TokenRecord(accessToken: \"ghu_saved\", refreshToken: \"ghr_saved\", expiresAt: Date().addingTimeInterval(3600)), serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID)\n98|    let transport = SlowTransport([\n99|        jsonResponse([\"login\": \"octo\", \"id\": 42]),                       // restore: /user (slow)\n100|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]), // login: device code\n101|        jsonResponse([\"installations\": []]),                             // restore: installations\n102|        jsonResponse([\"error\": \"authorization_pending\"]),\n103|    ], delayMs: 200)\n104|    let (flow, logger) = await attackHarness(transport: transport, store: store, identities: identities)\n105|    let restore = Task { _ = await flow.apply(GitHubAuth.Effect.restoreSession) }\n106|    try await Task.sleep(for: .milliseconds(50))\n107|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n108|    _ = await restore.value\n109|    try await Task.sleep(for: .milliseconds(600))\n110|    let seq = names(logger)\n111|    print(\"RA3 sequence:\", seq)\n112|    let codeIdx = seq.lastIndex(of: \"codeReceived\") ?? -1\n113|    let afterCode = Array(seq.suffix(from: codeIdx + 1)).filter { $0 == \"connected\" || $0 == \"accountVerified\" }\n114|    #expect(afterCode.isEmpty, \"restore emitted \\(afterCode) after login codeReceived\")\n115|    _ = await flow.apply(GitHubAuth.Effect.cancelLogin)\n116|}","final_result":true}}}
