{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c731","stream":{"kind":"session","id":"01a0a841-0b8e-7df2-8923-843adf19c894"},"sequence":499,"recorded_at":1780531400000993,"record_type":"event","durability":"durable","causation_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","run_stream":{"kind":"run","id":"0a9b0514-6796-4bae-973f-c687f7c4e3df"},"task_stream":{"kind":"task","id":"01a0a843-c650-7b70-95ef-70f803eb60ba"},"task_id":"01a0a843-c650-7b70-95ef-70f803eb60ba","event":{"kind":"output","task_id":"01a0a843-c650-7b70-95ef-70f803eb60ba","chunk":"Read text file `Packages/RunnerControlCore/Tests/GitHubTransportTests.swift`.\n1|import Foundation\n2|import Testing\n3|@testable import RunnerControlCore\n4|\n5|// MARK: - Shared fakes\n6|\n7|actor TestTransport: GitHubHTTPTransport {\n8|    private var queue: [GitHubHTTPResponse]\n9|    private(set) var requests: [GitHubHTTPRequest] = []\n10|    init(_ responses: [GitHubHTTPResponse]) { self.queue = responses }\n11|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n12|        requests.append(request)\n13|        guard !queue.isEmpty else { throw GitHubTransportError.invalidResponse }\n14|        return queue.removeFirst()\n15|    }\n16|    func prepend(_ response: GitHubHTTPResponse) { queue.insert(response, at: 0) }\n17|    func append(_ response: GitHubHTTPResponse) { queue.append(response) }\n18|}\n19|\n20|func jsonResponse(_ object: Any, status: Int = 200) -> GitHubHTTPResponse {\n21|    // Static test literals always serialize.\n22|    // swiftlint:disable:next force_try\n23|    let data = try! JSONSerialization.data(withJSONObject: object)\n24|    return GitHubHTTPResponse(status: status, body: data)\n25|}\n26|\n27|let testConfig = GitHubAuth.AppConfig(clientID: \"test-client-id\")\n28|\n29|// MARK: - Config\n30|\n31|@Test func configReportsExactMissingBinding() {\n32|    let bundle = Bundle.main\n33|    // Production bundle has no GitHubAppClientID until coordinator provisions it.\n34|    // Assert the thrown binding names the exact scaffold input.\n35|    let raw = bundle.object(forInfoDictionaryKey: \"GitHubAppClientID\") as? String\n36|    if let raw, !raw.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {\n37|        // Provisioned environment: config must load.\n38|        #expect((try? GitHubAuth.AppConfig.current(bundle: bundle)) != nil)\n39|    } else {\n40|        do {\n41|            _ = try GitHubAuth.AppConfig.current(bundle: bundle)\n42|            Issue.record(\"Expected missingClientID when plist key is absent/empty\")\n43|        } catch let error as GitHubAuth.ConfigError {\n44|            guard case .missingClientID(let binding) = error else {\n45|                Issue.record(\"Wrong config error: \\(error)\"); return\n46|            }\n47|            #expect(binding == GitHubAuth.AppConfig.missingBindingHelp)\n48|            #expect(binding.contains(\"ios-app-manager.json\"))\n49|            #expect(binding.contains(\"GitHubAppClientID\"))\n50|        } catch {\n51|            Issue.record(\"Unexpected error: \\(error)\")\n52|        }\n53|    }\n54|}\n55|\n56|@Test func configAuditRunsThroughCurrentBundle() throws {\n57|    func bundleWithPlist(_ plist: [String: Any]) throws -> Bundle {\n58|        let dir = FileManager.default.temporaryDirectory.appendingPathComponent(\"AuditProbe-\\(UUID().uuidString).bundle\")\n59|        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)\n60|        let data = try PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0)\n61|        try data.write(to: dir.appendingPathComponent(\"Info.plist\"))\n62|        guard let bundle = Bundle(path: dir.path) else { throw GitHubTransportError.invalidResponse }\n63|        return bundle\n64|    }\n65|    let tainted = try bundleWithPlist([\"GitHubAppClientID\": \"pub-id\", \"ClientSecret\": \"shh\"])\n66|    defer { try? FileManager.default.removeItem(at: URL(fileURLWithPath: tainted.bundlePath)) }\n67|    do {\n68|        _ = try GitHubAuth.AppConfig.current(bundle: tainted)\n69|        Issue.record(\"current(bundle:) admitted embedded ClientSecret\")\n70|    } catch let error as GitHubAuth.ConfigError {\n71|        guard case .embeddedSecret(let key) = error, key == \"ClientSecret\" else {\n72|            Issue.record(\"Wrong audit error: \\(error)\"); return\n73|        }\n74|    }\n75|    let clean = try bundleWithPlist([\"GitHubAppClientID\": \"pub-id\"])\n76|    defer { try? FileManager.default.removeItem(at: URL(fileURLWithPath: clean.bundlePath)) }\n77|    #expect(try GitHubAuth.AppConfig.current(bundle: clean).clientID == \"pub-id\")\n78|}\n79|\n80|@Test func enterpriseConfigUsesHostScopedEndpoints() {\n81|    let config = GitHubAuth.AppConfig(clientID: \"pub\", serverHost: \"ghe.example.com\")\n82|    #expect(config.deviceAuthorizationURL.absoluteString == \"https://ghe.example.com/login/device/code\")\n83|    #expect(config.tokenURL.absoluteString == \"https://ghe.example.com/login/oauth/access_token\")\n84|    #expect(config.apiBaseURL.absoluteString == \"https://ghe.example.com/api/v3\")\n85|}\n86|\n87|@Test func auditRejectsEmbeddedSecrets() throws {\n88|    try GitHubAuth.AppConfig.auditNoSecrets(in: [\"GitHubAppClientID\": \"pub\", \"CFBundleIdentifier\": \"x\"])\n89|    for key in [\"ClientSecret\", \"client_secret\", \"AppPrivateKey\", \"app_private_key\", \"GitHubToken\", \"access_token_cache\"] {\n90|        do {\n91|            try GitHubAuth.AppConfig.auditNoSecrets(in: [key: \"value\"])\n92|            Issue.record(\"auditNoSecrets admitted forbidden key '\\(key)'\")\n93|        } catch let error as GitHubAuth.ConfigError {\n94|            guard case .embeddedSecret(let found) = error, found == key else {\n95|                Issue.record(\"Wrong audit error for '\\(key)': \\(error)\"); return\n96|            }\n97|        }\n98|    }\n99|}\n100|\n101|// MARK: - PAT guard (no PAT fallback)\n102|\n103|@Test func patGuardRejectsClassicAndFineGrainedPAT() {\n104|    for pat in [\"ghp_abc123\", \"github_pat_abc123\"] {\n105|        do {\n106|            _ = try GitHubAuth.PATGuard.authorizationHeader(token: pat)\n107|            Issue.record(\"PATGuard admitted PAT '\\(pat)'\")\n108|        } catch let error as GitHubAuth.AuthError {\n109|            #expect(error == .patNotSupported)\n110|        } catch {\n111|            Issue.record(\"Unexpected error for '\\(pat)': \\(error)\")\n112|        }\n113|    }\n114|    #expect((try? GitHubAuth.PATGuard.authorizationHeader(token: \"[REDACTED]\")) == \"Bearer [REDACTED]\")\n115|}\n116|\n117|// MARK: - REST mapper (401/403)\n118|\n119|@Test func restMapperSeparatesUnauthorizedForbiddenSSORateLimit() {\n120|    #expect(GitHubAuth.RESTMapper.map(status: 401, body: Data()) == .unauthorized)\n(more lines below)","final_result":true}}}
