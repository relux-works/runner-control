{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f1","stream":{"kind":"session","id":"01a0a841-0b8e-7df2-8923-843adf19c894"},"sequence":339,"recorded_at":1780531400000673,"record_type":"event","durability":"durable","causation_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","run_stream":{"kind":"run","id":"0a9b0514-6796-4bae-973f-c687f7c4e3df"},"call_id":"call_01a0a841c1d472d3937ca0d5c190bf46","text":"Read text file `Packages/RunnerControlCore/Tests/GitHubAuthFlowTests.swift`.\n1|import Foundation\n2|import Testing\n3|import Relux\n4|@testable import RunnerControlCore\n5|\n6|private func githubHarness(\n7|    transport: any GitHubHTTPTransport,\n8|    store: GitHubKeychainStore? = nil,\n9|    identityStore: (any GitHubSessionIdentityStoring)? = nil,\n10|    sleeper: (@Sendable (UInt64) async throws -> Void)? = nil,\n11|    config: GitHubAuth.AppConfig = testConfig\n12|) async -> (GitHubAuth.Flow, Relux.Testing.Logger, GitHubKeychainStore) {\n13|    let logger = Relux.Testing.Logger()\n14|    let dispatcher = Relux.Dispatcher(logger: logger)\n15|    let credentialStore = store ?? GitHubKeychainStore(backend: InMemoryKeychainBackend())\n16|    let flow = await GitHubAuth.Flow(\n17|        deviceFlow: GitHubDeviceFlow(transport: transport),\n18|        api: GitHubAPIClient(transport: transport),\n19|        refresher: GitHubTokenRefresh(transport: transport, store: credentialStore),\n20|        store: credentialStore,\n21|        identityStore: identityStore ?? InMemoryGitHubSessionIdentityStore(),\n22|        configProvider: { _ in config },\n23|        sleeper: sleeper ?? { _ in },\n24|        dispatcher: dispatcher\n25|    )\n26|    return (flow, logger, credentialStore)\n27|}\n28|\n29|private func waitForLoggedActions(_ logger: Relux.Testing.Logger, count: Int, timeoutNanoseconds: UInt64 = 2_000_000_000) async -> Bool {\n30|    let deadline = ContinuousClock.now.advanced(by: .nanoseconds(Int64(timeoutNanoseconds)))\n31|    while ContinuousClock.now < deadline {\n32|        if logger.actions.count >= count { return true }\n33|        try? await Task.sleep(for: .milliseconds(20))\n34|    }\n35|    return logger.actions.count >= count\n36|}\n37|\n38|private func githubActions(_ logger: Relux.Testing.Logger) -> [GitHubAuth.Action] {\n39|    logger.actions.compactMap { $0 as? GitHubAuth.Action }\n40|}\n41|\n42|// MARK: - Reducer\n43|\n44|@Test @MainActor func githubReducerCoversLoginLifecycleAndIgnoresForeignActions() async {\n45|    let state = GitHubAuth.State()\n46|    let before = state.connection\n47|    await state.reduce(with: ForeignAction())\n48|    #expect(state.connection == before)\n49|    await state.reduce(with: GitHubAuth.Action.loginStarted(serverHost: \"github.com\"))\n50|    guard case .requestingCode = state.connection else { Issue.record(\"Expected requestingCode\"); return }\n51|    let uri = URL(string: \"https://github.com/login/device\")!\n52|    await state.reduce(with: GitHubAuth.Action.codeReceived(userCode: \"ABCD-1234\", verificationURI: uri, expiresIn: 900, interval: 5))\n53|    guard case .awaitingUser(let code, _, _, let interval) = state.connection, code == \"ABCD-1234\", interval == 5 else {\n54|        Issue.record(\"Expected awaitingUser\"); return\n55|    }\n56|    await state.reduce(with: GitHubAuth.Action.pollIntervalUpdated(10))\n57|    guard case .awaitingUser(_, _, _, let updated) = state.connection, updated == 10 else {\n58|        Issue.record(\"Expected interval 10\"); return\n59|    }\n60|    await state.reduce(with: GitHubAuth.Action.accountVerified(username: \"octo\", userID: 42, serverHost: \"github.com\"))\n61|    #expect(state.username == \"octo\")\n62|    await state.reduce(with: GitHubAuth.Action.installationsLoaded([.init(id: 7, account: \"acme\", accountType: \"Organization\")]))\n63|    #expect(state.selectedInstallationID == 7)\n64|    await state.reduce(with: GitHubAuth.Action.repositoriesLoaded(installationID: 7, repositories: [.init(id: 9, fullName: \"acme/app\", isPrivate: true)]))\n65|    #expect(state.repositories.count == 1)\n66|    await state.reduce(with: GitHubAuth.Action.connected(username: \"octo\", serverHost: \"github.com\", syncedAt: Date()))\n67|    guard case .connected = state.connection else { Issue.record(\"Expected connected\"); return }\n68|    await state.reduce(with: GitHubAuth.Action.syncFailed(message: \"stale\"))\n69|    #expect(state.syncError == \"stale\")\n70|    guard case .connected = state.connection else { Issue.record(\"syncFailed must preserve connected\"); return }\n71|    await state.reduce(with: GitHubAuth.Action.installationSelected(7))\n72|    await state.reduce(with: GitHubAuth.Action.repositoriesSelected([9]))\n73|    #expect(state.selectedRepositoryIDs == [9])\n74|    await state.reduce(with: GitHubAuth.Action.failed(message: \"denied\", retry: .newCode))\n75|    guard case .failed(_, let retry) = state.connection, retry == .newCode else { Issue.record(\"Expected failed newCode\"); return }\n76|    await state.reduce(with: GitHubAuth.Action.loggedOut)\n77|    guard case .disconnected = state.connection else { Issue.record(\"Expected disconnected\"); return }\n78|    #expect(state.username == nil)\n79|    await state.cleanup()\n80|    #expect(state.installations.isEmpty)\n81|}\n82|\n83|// MARK: - Flow: success + 401/403 + logout\n84|\n85|@Test func flowLoginSuccessDrivesProductionEffectsToConnected() async throws {\n86|    let transport = TestTransport([\n87|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n88|        jsonResponse([\"access_token\": \"ghu_x\", \"refresh_token\": \"ghr_y\", \"expires_in\": 3600]),\n89|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n90|        jsonResponse([\"installations\": [[\"id\": 7, \"account\": [\"login\": \"acme\", \"type\": \"Organization\"]]]]),\n91|        jsonResponse([\"repositories\": [[\"id\": 9, \"full_name\": \"acme/app\", \"private\": false]]]),\n92|    ])\n93|    let (flow, logger, store) = await githubHarness(transport: transport)\n94|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n95|    #expect(await waitForLoggedActions(logger, count: 6))\n96|    let actions = githubActions(logger)\n97|    guard case .loginStarted = actions[0], case .codeReceived = actions[1] else {\n98|        Issue.record(\"Login did not emit started/code, got \\(actions)\"); return\n99|    }\n100|    #expect(actions.contains { if case .connected(let user, _, _) = $0, user == \"octo\" { true } else { false } })\n101|    #expect(await store.load(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID)?.accessToken == \"ghu_x\")\n102|    // No Runners actions leak from the GitHub flow.\n103|    #expect(logger.actions.allSatisfy { $0 is GitHubAuth.Action })\n104|}\n105|\n106|@Test func flowExpiredCodeFailsWithNewCode() async {\n107|    let transport = TestTransport([\n108|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n109|        jsonResponse([\"error\": \"expired_token\"]),\n110|    ])\n111|    let (flow, logger, _) = await githubHarness(transport: transport)\n112|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n113|    #expect(await waitForLoggedActions(logger, count: 3))\n114|    let actions = githubActions(logger)\n115|    guard case .failed(let message, let retry) = actions.last, retry == .newCode else {\n116|        Issue.record(\"Expected failed newCode, got \\(actions)\"); return\n117|    }\n118|    #expect(message.contains(\"expired\"))\n119|}\n120|\n121|@Test func flowDeniedFailsWithNewCode() async {\n122|    let transport = TestTransport([\n123|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n124|        jsonResponse([\"error\": \"access_denied\"]),\n125|    ])\n126|    let (flow, logger, _) = await githubHarness(transport: transport)\n127|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n128|    #expect(await waitForLoggedActions(logger, count: 3))\n129|    guard case .failed(_, let retry) = githubActions(logger).last, retry == .newCode else {\n130|        Issue.record(\"Expected denied newCode\"); return\n131|    }\n132|}\n133|\n134|final class SleepRecorder: @unchecked Sendable {\n135|    private let lock = NSLock()\n136|    private var values: [UInt64] = []\n137|    func append(_ value: UInt64) { lock.withLock { values.append(value) } }\n138|    var snapshot: [UInt64] { lock.withLock { values } }\n139|}\n140|\n141|@Test func flowSlowDownIncreasesIntervalThenSucceeds() async throws {\n142|    let transport = TestTransport([\n143|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 5]),\n144|        jsonResponse([\"error\": \"slow_down\"]),\n145|        jsonResponse([\"access_token\": \"ghu_x\", \"expires_in\": 3600]),\n146|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n147|        jsonResponse([\"installations\": []]),\n148|    ])\n149|    let recorder = SleepRecorder()\n150|    let (flow, logger, _) = await githubHarness(transport: transport, sleeper: { nanos in\n151|        recorder.append(nanos)\n152|    })\n153|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n154|    #expect(await waitForLoggedActions(logger, count: 5))\n155|    let actions = githubActions(logger)\n156|    guard actions.contains(where: { if case .pollIntervalUpdated(let value) = $0, value == 10 { true } else { false } }) else {\n157|        Issue.record(\"Expected pollIntervalUpdated(10), got \\(actions)\"); return\n158|    }\n159|    let observed = recorder.snapshot\n160|    #expect(observed.count >= 2)\n161|    #expect(observed[0] == 5_000_000_000)\n162|    #expect(observed[1] == 10_000_000_000)\n163|}\n164|\n165|@Test func flowCancellationDestroysCodeAndStopsPoll() async throws {\n166|    // Cancel lands during the first poll sleep, so no poll consumes the queue.\n167|    // Queue order is therefore [code1, code2, ...second-login polls].\n168|    let transport = TestTransport([\n169|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 5]),\n170|        jsonResponse([\"device_code\": \"dev2\", \"user_code\": \"USER-2\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 60]),\n171|        jsonResponse([\"error\": \"authorization_pending\"]),\n172|        jsonResponse([\"error\": \"authorization_pending\"]),\n173|    ])\n174|    let (flow, logger, _) = await githubHarness(transport: transport, sleeper: { _ in\n175|        try await Task.sleep(for: .milliseconds(200))\n176|    })\n177|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n178|    _ = await waitForLoggedActions(logger, count: 2)\n179|    _ = await flow.apply(GitHubAuth.Effect.cancelLogin)\n180|    _ = await waitForLoggedActions(logger, count: 3)\n181|    // Second login must request a fresh code (old device_code destroyed, not reused).\n182|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n183|    #expect(await waitForLoggedActions(logger, count: 5))\n184|    let actions = githubActions(logger)\n185|    #expect(actions.contains { if case .loginCancelled = $0 { true } else { false } })\n186|    let codes = actions.compactMap { action -> String? in if case .codeReceived(let code, _, _, _) = action { code } else { nil } }\n187|    #expect(codes == [\"USER-1\", \"USER-2\"])\n188|    #expect(!actions.contains { if case .connected = $0 { true } else { false } })\n189|    _ = await flow.apply(GitHubAuth.Effect.cancelLogin)\n190|}\n191|\n192|@Test func flowCancelWhileConnectedRestoresConnected() async throws {\n193|    let transport = TestTransport([\n194|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n195|        jsonResponse([\"access_token\": \"ghu_x\", \"expires_in\": 3600]),\n196|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n197|        jsonResponse([\"installations\": []]),\n198|    ])\n199|    let (flow, logger, _) = await githubHarness(transport: transport)\n200|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n201|    #expect(await waitForLoggedActions(logger, count: 5))\n202|    _ = await flow.apply(GitHubAuth.Effect.cancelLogin)\n203|    #expect(await waitForLoggedActions(logger, count: 6))\n204|    guard case .connected(let user, _, _) = githubActions(logger).last, user == \"octo\" else {\n205|        Issue.record(\"Cancel while connected must restore connected, got \\(githubActions(logger))\"); return\n206|    }\n207|}\n208|\n209|@Test func flowLogoutClearsKeychainAndStopsSync() async throws {\n210|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n211|    let transport = TestTransport([\n212|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n213|        jsonResponse([\"access_token\": \"ghu_x\", \"refresh_token\": \"ghr_y\", \"expires_in\": 3600]),\n214|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n215|        jsonResponse([\"installations\": []]),\n216|    ])\n217|    let (flow, logger, credentialStore) = await githubHarness(transport: transport, store: store)\n218|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n219|    #expect(await waitForLoggedActions(logger, count: 5))\n220|    #expect(await credentialStore.load(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID) != nil)\n221|    _ = await flow.apply(GitHubAuth.Effect.logout)\n222|    _ = await waitForLoggedActions(logger, count: 6)\n223|    #expect(githubActions(logger).last.map { if case .loggedOut = $0 { true } else { false } } == true)\n224|    #expect(await credentialStore.load(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID) == nil)\n225|    // Post-logout refresh is a no-op (background ops stopped).\n226|    let before = logger.actions.count\n227|    _ = await flow.apply(GitHubAuth.Effect.refreshInstallations)\n228|    try await Task.sleep(for: .milliseconds(100))\n229|    #expect(logger.actions.count == before)\n230|}\n231|\n232|@Test func flow401DuringRefreshRequiresRelogin() async {\n233|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n234|    let record = GitHubAuth.TokenRecord(accessToken: \"ghu_old\", refreshToken: nil, expiresAt: nil)\n235|    await store.saveForTest(record, userID: 42)\n236|    let transport = TestTransport([\n237|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n238|        jsonResponse([\"access_token\": \"ghu_x\", \"expires_in\": 3600]),\n239|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n240|        jsonResponse([\"installations\": []]),\n241|        GitHubHTTPResponse(status: 401, body: Data()),\n242|    ])\n243|    let (flow, logger, _) = await githubHarness(transport: transport, store: store)\n244|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n245|    #expect(await waitForLoggedActions(logger, count: 5))\n246|    _ = await flow.apply(GitHubAuth.Effect.refreshInstallations)\n247|    #expect(await waitForLoggedActions(logger, count: 6))\n248|    guard case .failed(_, let retry) = githubActions(logger).last, retry == .relogin else {\n249|        Issue.record(\"Expected 401 relogin, got \\(githubActions(logger))\"); return\n250|    }\n251|}\n252|\n253|@Test func flow403DuringRefreshKeepsConnectedWithStaleError() async throws {\n254|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n255|    let transport = TestTransport([\n256|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n257|        jsonResponse([\"access_token\": \"ghu_x\", \"expires_in\": 3600]),\n258|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n259|        jsonResponse([\"installations\": []]),\n260|        GitHubHTTPResponse(status: 403, body: Data(\"forbidden\".utf8)),\n261|    ])\n262|    let (flow, logger, _) = await githubHarness(transport: transport, store: store)\n263|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n264|    #expect(await waitForLoggedActions(logger, count: 5))\n265|    _ = await flow.apply(GitHubAuth.Effect.refreshInstallations)\n266|    #expect(await waitForLoggedActions(logger, count: 6))\n267|    let actions = githubActions(logger)\n268|    guard case .syncFailed = actions.last else {\n269|        Issue.record(\"Expected syncFailed on 403, got \\(actions)\"); return\n270|    }\n271|    // Reducer proof: syncFailed preserves connected (local control unaffected).\n272|    let state = await MainActor.run { GitHubAuth.State() }\n273|    for action in actions { await state.reduce(with: action) }\n274|    let connection = await MainActor.run { state.connection }\n275|    guard case .connected = connection else {\n276|        Issue.record(\"403 must not disconnect\"); return\n277|    }\n278|}\n279|\n280|@Test func flowLoginPhase401DuringInstallationsRequiresRelogin() async {\n281|    let transport = TestTransport([\n282|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n283|        jsonResponse([\"access_token\": \"ghu_x\", \"refresh_token\": \"ghr_y\", \"expires_in\": 3600]),\n284|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n285|        GitHubHTTPResponse(status: 401, body: Data()),\n286|    ])\n287|    let (flow, logger, _) = await githubHarness(transport: transport)\n288|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n289|    #expect(await waitForLoggedActions(logger, count: 4))\n290|    guard case .failed(_, let retry) = githubActions(logger).last, retry == .relogin else {\n291|        Issue.record(\"Expected login-phase 401 relogin, got \\(githubActions(logger))\"); return\n292|    }\n293|}\n294|\n295|@Test func flowMissingClientIDFailsWithExactBinding() async {\n296|    let logger = Relux.Testing.Logger()\n297|    let dispatcher = Relux.Dispatcher(logger: logger)\n298|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n299|    let transport = TestTransport([])\n300|    let flow = await GitHubAuth.Flow(\n301|        deviceFlow: GitHubDeviceFlow(transport: transport),\n302|        api: GitHubAPIClient(transport: transport),\n303|        refresher: GitHubTokenRefresh(transport: transport, store: store),\n304|        store: store,\n305|        identityStore: InMemoryGitHubSessionIdentityStore(),\n306|        configProvider: { _ in throw GitHubAuth.ConfigError.missingClientID(binding: GitHubAuth.AppConfig.missingBindingHelp) },\n307|        sleeper: { _ in },\n308|        dispatcher: dispatcher\n309|    )\n310|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n311|    #expect(await waitForLoggedActions(logger, count: 1))\n312|    guard case .failed(let message, let retry) = githubActions(logger).first, retry == .none else {\n313|        Issue.record(\"Expected missing-binding failure\"); return\n314|    }\n315|    #expect(message.contains(\"ios-app-manager.json\"))\n316|}\n317|\n318|@Test func flowIgnoresForeignEffectsAndSelectsRepositories() async {\n319|    let (flow, logger, _) = await githubHarness(transport: TestTransport([]))\n320|    let result: Relux.ActionResult = await flow.apply(ForeignEffect())\n321|    _ = result\n322|    #expect(logger.actions.isEmpty)\n323|    _ = await flow.apply(GitHubAuth.Effect.selectRepositories([9]))\n324|    #expect(await waitForLoggedActions(logger, count: 1))\n325|    guard case .repositoriesSelected(let ids) = githubActions(logger).first, ids == [9] else {\n326|        Issue.record(\"Expected repositoriesSelected\"); return\n327|    }\n328|}\n329|\n330|@Test @MainActor func githubModuleRegistersStateAndFlow() async {\n331|    let state = GitHubAuth.State()\n332|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n333|    let transport = TestTransport([])\n334|    let dispatcher = Relux.Dispatcher(logger: Relux.Testing.Logger())\n335|    let flow = await GitHubAuth.Flow(\n336|        deviceFlow: GitHubDeviceFlow(transport: transport),\n337|        api: GitHubAPIClient(transport: transport),\n338|        refresher: GitHubTokenRefresh(transport: transport, store: store),\n339|        store: store,\n340|        identityStore: InMemoryGitHubSessionIdentityStore(),\n341|        configProvider: { _ in testConfig },\n342|        sleeper: { _ in },\n343|        dispatcher: dispatcher\n344|    )\n345|    let module = GitHubAuth.Module(state: state, flow: flow)\n346|    #expect(module.states.count == 1)\n347|    #expect(module.sagas.count == 1)\n348|}\n349|\n350|private extension GitHubKeychainStore {\n351|    func saveForTest(_ record: GitHubAuth.TokenRecord, userID: Int64) async {\n352|        try? await save(record, serverHost: \"github.com\", userID: userID, clientID: testConfig.clientID)\n353|    }\n354|}\n355|\n356|// MARK: - Restore (session survives relaunch)\n357|\n358|@Test @MainActor func githubReducerRestoreStartedShowsVerifyingAccount() async {\n359|    let state = GitHubAuth.State()\n360|    await state.reduce(with: GitHubAuth.Action.restoreStarted(serverHost: \"ghe.example.com\"))\n361|    guard case .verifyingAccount = state.connection else {\n362|        Issue.record(\"Expected verifyingAccount, got \\(state.connection)\"); return\n363|    }\n364|    #expect(state.serverHost == \"ghe.example.com\")\n365|}\n366|\n367|@Test func flowLoginPersistsSessionIdentityForLaterRestore() async throws {\n368|    let identities = InMemoryGitHubSessionIdentityStore()\n369|    let transport = TestTransport([\n370|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n371|        jsonResponse([\"access_token\": \"ghu_x\", \"refresh_token\": \"ghr_y\", \"expires_in\": 3600]),\n372|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n373|        jsonResponse([\"installations\": []]),\n374|    ])\n375|    let (flow, logger, _) = await githubHarness(transport: transport, identityStore: identities)\n376|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n377|    #expect(await waitForLoggedActions(logger, count: 6))\n378|    #expect(await identities.load() == GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n379|}\n380|\n381|@Test func flowRestoreSessionConnectsFromPersistedIdentityThenLogoutClearsBoth() async throws {\n382|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n383|    let identities = InMemoryGitHubSessionIdentityStore(value: GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n384|    try await store.save(\n385|        GitHubAuth.TokenRecord(accessToken: \"ghu_saved\", refreshToken: \"ghr_saved\", expiresAt: Date().addingTimeInterval(3600)),\n386|        serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n387|    )\n388|    let transport = TestTransport([\n389|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n390|        jsonResponse([\"installations\": [[\"id\": 7, \"account\": [\"login\": \"acme\", \"type\": \"Organization\"]]]]),\n391|        jsonResponse([\"repositories\": [[\"id\": 9, \"full_name\": \"acme/app\", \"private\": false]]]),\n392|    ])\n393|    let (flow, logger, credentialStore) = await githubHarness(transport: transport, store: store, identityStore: identities)\n394|    _ = await flow.apply(GitHubAuth.Effect.restoreSession)\n395|    #expect(await waitForLoggedActions(logger, count: 5))\n396|    let actions = githubActions(logger)\n397|    guard case .restoreStarted = actions.first else {\n398|        Issue.record(\"Expected restoreStarted first, got \\(actions)\"); return\n399|    }\n400|    #expect(actions.contains { if case .connected(let user, _, _) = $0, user == \"octo\" { true } else { false } })\n401|    // Session is live: a sync now reaches the network instead of no-op.\n402|    await transport.append(jsonResponse([\"installations\": []]))\n403|    _ = await flow.apply(GitHubAuth.Effect.refreshInstallations)\n404|    #expect(await waitForLoggedActions(logger, count: 7))\n405|    // Logout after restore deletes both Keychain tokens and identity.\n406|    _ = await flow.apply(GitHubAuth.Effect.logout)\n407|    #expect(await waitForLoggedActions(logger, count: 8))\n408|    #expect(await credentialStore.load(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID) == nil)\n409|    #expect(await identities.load() == nil)\n410|}\n411|\n412|@Test func flowRestoreSessionWithRevokedTokenRequiresReloginAndClearsStorage() async throws {\n413|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n414|    let identities = InMemoryGitHubSessionIdentityStore(value: GitHubSessionIdentity(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID, username: \"octo\"))\n415|    try await store.save(\n416|        GitHubAuth.TokenRecord(accessToken: \"ghu_revoked\", refreshToken: nil, expiresAt: nil),\n417|        serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n418|    )\n419|    let transport = TestTransport([GitHubHTTPResponse(status: 401, body: Data())])\n420|    let (flow, logger, credentialStore) = await githubHarness(transport: transport, store: store, identityStore: identities)\n421|    _ = await flow.apply(GitHubAuth.Effect.restoreSession)\n422|    #expect(await waitForLoggedActions(logger, count: 2))\n423|    guard case .failed(_, let retry) = githubActions(logger).last, retry == .relogin else {\n424|        Issue.record(\"Expected 401 relogin, got \\(githubActions(logger))\"); return\n425|    }\n426|    #expect(await credentialStore.load(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID) == nil)\n427|    #expect(await identities.load() == nil)\n428|}\n429|\n430|@Test func flowRestoreSessionWithoutIdentityIsNoop() async throws {\n431|    let (flow, logger, _) = await githubHarness(transport: TestTransport([]))\n432|    _ = await flow.apply(GitHubAuth.Effect.restoreSession)\n433|    try await Task.sleep(for: .milliseconds(100))\n434|    #expect(logger.actions.isEmpty)\n435|}\n436|\n437|// MARK: - Refresh through the production Flow path\n438|\n439|private func loginQueue(accessToken: String = \"ghu_old\", refreshToken: String = \"ghr_old\") -> [GitHubHTTPResponse] {\n440|    [\n441|        jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1]),\n442|        jsonResponse([\"access_token\": accessToken, \"refresh_token\": refreshToken, \"expires_in\": 3600]),\n443|        jsonResponse([\"login\": \"octo\", \"id\": 42]),\n444|        jsonResponse([\"installations\": []]),\n445|    ]\n446|}\n447|\n448|@Test func flowRefreshInstallationsRefreshesExpiringTokenViaProductionPath() async throws {\n449|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n450|    let transport = TestTransport(loginQueue())\n451|    let (flow, logger, credentialStore) = await githubHarness(transport: transport, store: store)\n452|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n453|    #expect(await waitForLoggedActions(logger, count: 6))\n454|    // Age the stored token into the 60s refresh window.\n455|    try await credentialStore.save(\n456|        GitHubAuth.TokenRecord(accessToken: \"ghu_old\", refreshToken: \"ghr_old\", expiresAt: Date().addingTimeInterval(30)),\n457|        serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID\n458|    )\n459|    await transport.append(jsonResponse([\"access_token\": \"ghu_new\", \"refresh_token\": \"ghr_new\", \"expires_in\": 3600]))\n460|    await transport.append(jsonResponse([\"installations\": [[\"id\": 7, \"account\": [\"login\": \"acme\", \"type\": \"Organization\"]]]]))\n461|    _ = await flow.apply(GitHubAuth.Effect.refreshInstallations)\n462|    #expect(await waitForLoggedActions(logger, count: 8))\n463|    let tokenPosts = await transport.requests.filter { $0.url == testConfig.tokenURL }\n464|    #expect(tokenPosts.count == 2) // 1 device poll during login + 1 refresh here\n465|    #expect(await credentialStore.load(serverHost: \"github.com\", userID: 42, clientID: testConfig.clientID)?.accessToken == \"ghu_new\")\n466|    #expect(githubActions(logger).contains { if case .syncSucceeded = $0 { true } else { false } })\n467|}\n468|\n469|@Test func flowRefreshInstallationsWithInvalidGrantDuringRefreshRequiresRelogin() async throws {\n470|    let store = GitHubKeychainStore(backend: InMemoryKeychainBackend())\n471|    let transport = TestTransport(loginQueue())\n472|    let (flow, logger, _) = await githubHarness(transport: transport, store: store)\n473|    _ = await flow.apply(GitHubAuth.Effect.beginLogin(serverHost: nil))\n474|    #expect(await waitForLoggedActions(logger, count: 6))\n475|    let expiring = GitHubAuth.TokenRecord(accessToken: \"ghu_old\", refreshToken: \"ghr_bad\", expiresAt: Date().addingTimeInterval(30))\n476|    await store.saveForTest(expiring, userID: 42)\n477|    await transport.append(jsonResponse([\"error\": \"invalid_grant\"]))\n478|    _ = await flow.apply(GitHubAuth.Effect.refreshInstallations)\n479|    #expect(await waitForLoggedActions(logger, count: 7))\n480|    guard case .failed(_, let retry) = githubActions(logger).last, retry == .relogin else {\n481|        Issue.record(\"Expected invalid_grant relogin, got \\(githubActions(logger))\"); return\n482|    }\n483|}\n484|\n485|actor RoutingTransport: GitHubHTTPTransport {\n486|    private(set) var requests: [GitHubHTTPRequest] = []\n487|    func send(_ request: GitHubHTTPRequest) async throws -> GitHubHTTPResponse {\n488|        requests.append(request)\n489|        let path = request.url.path\n490|        if request.method == \"POST\", path.hasSuffix(\"/login/device/code\") {\n491|            return jsonResponse([\"device_code\": \"dev1\", \"user_code\": \"USER-1\", \"verification_uri\": \"https://github.com/login/device\", \"expires_in\": 900, \"interval\": 1])\n492|        }\n493|        if request.method == \"POST\", path.hasSuffix(\"/login/oauth/access_token\") {\n494|            if let body = request.body,\n495|               let obj = try? JSONSerialization.jsonObject(with: body) as? [String: String],\n496|               obj[\"grant_type\"] == \"refresh_token\" {\n497|                return jsonResponse([\"access_token\": \"ghu_new\", \"refresh_token\": \"ghr_new\", \"expires_in\": 3600])\n498|            }\n499|            return jsonResponse([\"access_token\": \"ghu_old\", \"refresh_token\": \"ghr_old\", \"expires_in\": 3600])\n500|        }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
