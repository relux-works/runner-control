{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bb","stream":{"kind":"session","id":"01a0a841-0b8e-7df2-8923-843adf19c894"},"sequence":312,"recorded_at":1780531400000619,"record_type":"event","durability":"durable","causation_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a9b0514-6796-4bae-973f-c687f7c4e3df","run_stream":{"kind":"run","id":"0a9b0514-6796-4bae-973f-c687f7c4e3df"},"task_stream":{"kind":"task","id":"01a0a841-b9bf-7e50-b320-7a51aca75266"},"task_id":"01a0a841-b9bf-7e50-b320-7a51aca75266","event":{"kind":"output","task_id":"01a0a841-b9bf-7e50-b320-7a51aca75266","chunk":"Read text file `Packages/RunnerControlCore/Sources/GitHubSessionIdentityStore.swift`.\n1|import Foundation\n2|\n3|/// Non-secret session identity persisted separately from Keychain tokens.\n4|/// Lets the app find its Keychain record after relaunch without storing secrets.\n5|public struct GitHubSessionIdentity: Sendable, Equatable, Codable {\n6|    public let serverHost: String\n7|    public let userID: Int64\n8|    public let clientID: String\n9|    public let username: String\n10|\n11|    public init(serverHost: String, userID: Int64, clientID: String, username: String) {\n12|        self.serverHost = serverHost\n13|        self.userID = userID\n14|        self.clientID = clientID\n15|        self.username = username\n16|    }\n17|}\n18|\n19|public protocol GitHubSessionIdentityStoring: Sendable {\n20|    func save(_ identity: GitHubSessionIdentity) async\n21|    func load() async -> GitHubSessionIdentity?\n22|    func delete() async\n23|}\n24|\n25|/// Production store: UserDefaults holds only non-secret identity, never tokens.\n26|public actor UserDefaultsGitHubSessionIdentityStore: GitHubSessionIdentityStoring {\n27|    private let defaults: UserDefaults\n28|    private let key: String\n29|\n30|    public init(\n31|        defaults: UserDefaults = .standard,\n32|        key: String = \"works.relux.runnercontrol.github.sessionIdentity.v1\"\n33|    ) {\n34|        self.defaults = defaults\n35|        self.key = key\n36|    }\n37|\n38|    public func save(_ identity: GitHubSessionIdentity) async {\n39|        if let data = try? JSONEncoder().encode(identity) {\n40|            defaults.set(data, forKey: key)\n41|        }\n42|    }\n43|\n44|    public func load() async -> GitHubSessionIdentity? {\n45|        guard let data = defaults.data(forKey: key) else { return nil }\n46|        return try? JSONDecoder().decode(GitHubSessionIdentity.self, from: data)\n47|    }\n48|\n49|    public func delete() async {\n50|        defaults.removeObject(forKey: key)\n51|    }\n52|}\n53|\n54|/// In-memory store for unit tests. Never used in production.\n55|public final class InMemoryGitHubSessionIdentityStore: GitHubSessionIdentityStoring, @unchecked Sendable {\n56|    private let lock = NSLock()\n57|    private var value: GitHubSessionIdentity?\n58|    public init(value: GitHubSessionIdentity? = nil) { self.value = value }\n59|    public func save(_ identity: GitHubSessionIdentity) async {\n60|        lock.withLock { value = identity }\n61|    }\n62|    public func load() async -> GitHubSessionIdentity? {\n63|        lock.withLock { value }\n64|    }\n65|    public func delete() async {\n66|        lock.withLock { value = nil }\n67|    }\n68|}","final_result":true}}}
