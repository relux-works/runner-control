{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c589","stream":{"kind":"session","id":"01a0a856-93ef-7122-8c0d-478bdd3789c8"},"sequence":287,"recorded_at":1780531400000569,"record_type":"event","durability":"durable","causation_id":"78fc2956-83d9-4f46-8d12-655f5d6e9886","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"78fc2956-83d9-4f46-8d12-655f5d6e9886","run_stream":{"kind":"run","id":"78fc2956-83d9-4f46-8d12-655f5d6e9886"},"task_stream":{"kind":"task","id":"01a0a857-cbab-7fc1-8d30-70b7c71abd9e"},"task_id":"01a0a857-cbab-7fc1-8d30-70b7c71abd9e","event":{"kind":"output","task_id":"01a0a857-cbab-7fc1-8d30-70b7c71abd9e","chunk":"{\n  \"chunk_id\": \"exec-12-1\",\n  \"command\": \"task-board worktree checkpoint --help 2>&1 | head -n 60\\necho \\\"====TRANSACTION====\\\"\\ntask-board worktree transaction --help 2>&1 | head -n 40\",\n  \"description\": \"Read checkpoint command help\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Checkpoint an accepted Change Request revision.\\n\\nThe accepted candidate tree becomes one internal commit on the Story branch,\\ncreated under a compare-and-swap on the branch tip. The leaf remains integrating:\\nnothing is landed on trunk, and internal checkpoints only delimit later Task\\ndiffs and make the work recoverable before the final Story squash.\\n\\nA Change Request with repository_delta=empty creates no commit — its tree would\\nequal its parent's — and the leaf likewise remains integrating.\\n\\nOnly the tracked integration run bound to the accepted revision's producer role\\nand archetype may run this command. Reviewers, orchestrators, and other producer\\narchetypes are refused.\\n\\nUsage:\\n  task-board worktree checkpoint <ELEMENT-ID> [flags]\\n\\nFlags:\\n  -h, --help   help for checkpoint\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n====TRANSACTION====\\nThe operator disposition surface for an integration transaction that reached a\\nterminal phase.\\n\\nIt is the ONLY exit from transition_refused and integration_abandoned, and it is\\nforward-only: no command here undoes a landed commit or rewrites trunk.\\n\\nTwo of the three outcomes cannot be obtained by assertion at all. 'resolve\\n--resolution repaired' re-runs the recovery classifier and decides on that, never\\non the operator's claim; 'discharge' recomputes the transaction's own\\npostcondition. Neither --refusal nor the absent-TASK_BOARD_RUN_ID check\\nauthorizes anything — both are caller-supplied guardrails, exactly like\\ncommit_ack and the transition-lease token.\\n\\nUsage:\\n  task-board worktree transaction [command]\\n\\nAvailable Commands:\\n  discharge    Retire an abandoned transaction whose board state has since reached trunk\\n  resolve      Leave transition_refused, by re-verified repair or by explicit abandonment\\n  restore-done Repair a post-landing status regression using recorded transaction and trunk ancestry\\n  show         Print an integration transaction, its refusal and the digest to dispose of it\\n\\nFlags:\\n  -h, --help   help for transaction\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board worktree transaction [command] --help\\\" for more information about a command.\\n\",\n  \"original_output_bytes\": 3270,\n  \"original_output_tokens\": 818,\n  \"truncated\": false\n}","final_result":true}}}
