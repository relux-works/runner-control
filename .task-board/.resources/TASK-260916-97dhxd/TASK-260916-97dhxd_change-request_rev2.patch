+        identityStore: identityStore ?? InMemoryGitHubSessionIdentityStore(),
+        configProvider: { _ in config },
+        sleeper: sleeper ?? { _ in },
+        dispatcher: dispatcher
+    )
+    return (flow, logger, credentialStore)
