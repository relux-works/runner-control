+final class SleepRecorder: @unchecked Sendable {
+    private let lock = NSLock()
+    private var values: [UInt64] = []
+    func append(_ value: UInt64) { lock.withLock { values.append(value) } }
+    var snapshot: [UInt64] { lock.withLock { values } }
+}
